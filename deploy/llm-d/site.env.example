# Template for the private site file that install.sh reads.
#
# Copy it OUTSIDE this repo and fill it in:
#   mkdir -p ~/.config/certus
#   cp deploy/llm-d/site.env.example ~/.config/certus/llm-d-site.env
# or point SITE_ENV at another location. Never commit the filled-in copy. It
# names real infrastructure -- nodes, registry, how many GPUs sit where -- and
# the committed profiles/ are kept free of that on purpose.
#
# Shell syntax, sourced by bash. Use `: "${VAR:=value}"` so that a variable
# already set in the caller's environment still wins for a one-off run.

# Which committed profile matches this cluster's GPUs (profiles/<name>/).
: "${PROFILE:=a30}"

# Aggregated serving: one replica per GPU in the cluster.
: "${AGG_REPLICAS:=1}"

# Prefill/decode (PD=1). Prefill + decode replicas should equal the GPU count.
: "${PD_PREFILL_REPLICAS:=1}"
: "${PD_DECODE_REPLICAS:=1}"
# Space-separated node names. install.sh labels them llm-d.ai/pd-prefill=true /
# llm-d.ai/pd-decode=true, which is what profiles/<name>/pd selects on.
: "${PD_PREFILL_NODES:=gpu-node-a}"
: "${PD_DECODE_NODES:=gpu-node-b}"

# Where publish-image.sh pushed the certus connector image (WITH_CERTUS=1).
# : "${CERTUS_REGISTRY:=registry.example.com}"
# : "${CERTUS_REPO:=my-team-docker-local}"
