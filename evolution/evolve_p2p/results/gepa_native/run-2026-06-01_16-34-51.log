// ============================================================================
// GDRCopy P2P path - optimized with lock-free tracking and buffer pooling
// ============================================================================

/// Tracks GDRCopy mapping state so free functions can perform full cleanup.
#[cfg(feature = "p2p")]
struct GdrMappingState {
    gdr: crate::gdrcopy_ffi::gdr_t,
    mh: crate::gdrcopy_ffi::gdr_mh_t,
    bar_ptr: *mut std::ffi::c_void,
    size: usize,
}

// SAFETY: GDRCopy handles are process-global and not thread-bound.
#[cfg(feature = "p2p")]
unsafe impl Send for GdrMappingState {}
#[cfg(feature = "p2p")]
unsafe impl Sync for GdrMappingState {}

#[cfg(feature = "p2p")]
static GDR_MAPPINGS: std::sync::OnceLock<
    std::sync::Mutex<std::collections::HashMap<usize, GdrMappingState>>,
> = std::sync::OnceLock::new();

#[cfg(feature = "p2p")]
fn gdr_mappings() -> &'static std::sync::Mutex<std::collections::HashMap<usize, GdrMappingState>> {
    GDR_MAPPINGS.get_or_init(|| std::sync::Mutex::new(std::collections::HashMap::with_capacity(256)))
}

/// Free function: unregisters from SPDK, unmaps GDRCopy BAR mapping,
/// unpins the GPU buffer, and closes the GDRCopy handle.
#[cfg(feature = "p2p")]
pub unsafe extern "C" fn spdk_unregister_gdr_unmap_and_close(ptr: *mut std::ffi::c_void) {
    unsafe {
        let state = gdr_mappings()
            .lock()
            .unwrap_or_else(|e| e.into_inner())
            .remove(&(ptr as usize));

        if let Some(s) = state {
            spdk_mem_unregister(s.bar_ptr, s.size);
            crate::gdrcopy_ffi::gdr_unmap(s.gdr, s.mh, s.bar_ptr, s.size);
            crate::gdrcopy_ffi::gdr_unpin_buffer(s.gdr, s.mh);
            crate::gdrcopy_ffi::gdr_close(s.gdr);
        }
    }
}

// ============================================================================
// GDRCopy handle pool - reuse gdr_t handles to avoid open/close overhead
// ============================================================================

#[cfg(feature = "p2p")]
static GDR_HANDLE_POOL: std::sync::OnceLock<
    crossbeam_queue::ArrayQueue<crate::gdrcopy_ffi::gdr_t>,
> = std::sync::OnceLock::new();

#[cfg(feature = "p2p")]
fn gdr_handle_pool() -> &'static crossbeam_queue::ArrayQueue<crate::gdrcopy_ffi::gdr_t> {
    GDR_HANDLE_POOL.get_or_init(|| crossbeam_queue::ArrayQueue::new(64))
}

#[cfg(feature = "p2p")]
fn acquire_gdr_handle() -> Result<crate::gdrcopy_ffi::gdr_t, String> {
    if let Some(gdr) = gdr_handle_pool().pop() {
        return Ok(gdr);
    }
    let gdr = unsafe { crate::gdrcopy_ffi::gdr_open() };
    if gdr.is_null() {
        return Err("gdr_open() failed — is gdrdrv kernel module loaded?".to_string());
    }
    Ok(gdr)
}

#[cfg(feature = "p2p")]
fn release_gdr_handle(gdr: crate::gdrcopy_ffi::gdr_t) {
    // Try to return to pool; if full, close it
    if gdr_handle_pool().push(gdr).is_err() {
        unsafe { crate::gdrcopy_ffi::gdr_close(gdr) };
    }
}

/// Free function for pooled GDR handles: unregisters, unmaps, unpins, returns handle to pool.
#[cfg(feature = "p2p")]
pub unsafe extern "C" fn spdk_unregister_gdr_unmap_and_pool(ptr: *mut std::ffi::c_void) {
    unsafe {
        let state = gdr_mappings()
            .lock()
            .unwrap_or_else(|e| e.into_inner())
            .remove(&(ptr as usize));

        if let Some(s) = state {
            spdk_mem_unregister(s.bar_ptr, s.size);
            crate::gdrcopy_ffi::gdr_unmap(s.gdr, s.mh, s.bar_ptr, s.size);
            crate::gdrcopy_ffi::gdr_unpin_buffer(s.gdr, s.mh);
            release_gdr_handle(s.gdr);
        }
    }
}

/// Create an SPDK `DmaBuffer` backed by a GDRCopy BAR1 mapping of GPU device memory.
///
/// This enables true NVMe→GPU P2P DMA with optimized handle pooling.
/// Uses 2MB aligned buffers for optimal PCIe TLP and NVMe transfer efficiency.
#[cfg(feature = "p2p")]
pub fn create_spdk_dma_buffer_from_gpu_bar(
    dev_ptr: *mut std::ffi::c_void,
    size: usize,
) -> Result<interfaces::DmaBuffer, String> {
    use crate::gdrcopy_ffi::*;

    // Align size up to GPU page boundary (64KB) for GDRCopy requirements.
    let aligned_size = (size + GPU_PAGE_SIZE - 1) & !(GPU_PAGE_SIZE - 1);

    let gdr = acquire_gdr_handle()?;

    // SAFETY: dev_ptr is a valid CUDA device pointer; size is the allocation size.
    let mut mh = gdr_mh_t::default();
    let rc = unsafe {
        gdr_pin_buffer(
            gdr,
            dev_ptr as std::os::raw::c_ulong,
            aligned_size,
            0,
            0,
            &mut mh,
        )
    };
    if rc != 0 {
        release_gdr_handle(gdr);
        return Err(format!("gdr_pin_buffer failed (rc={})", rc));
    }

    // SAFETY: mh is a valid pinned handle from gdr_pin_buffer.
    let mut bar_ptr: *mut std::ffi::c_void = std::ptr::null_mut();
    let rc = unsafe { gdr_map(gdr, mh, &mut bar_ptr, aligned_size) };
    if rc != 0 {
        unsafe {
            gdr_unpin_buffer(gdr, mh);
        }
        release_gdr_handle(gdr);
        return Err(format!("gdr_map failed (rc={})", rc));
    }

    if bar_ptr.is_null() {
        unsafe {
            gdr_unpin_buffer(gdr, mh);
        }
        release_gdr_handle(gdr);
        return Err("gdr_map returned null pointer".to_string());
    }

    // Account for alignment offset
    let offset = (dev_ptr as usize) & (GPU_PAGE_SIZE - 1);
    let effective_bar_ptr = unsafe { (bar_ptr as *mut u8).add(offset) as *mut std::ffi::c_void };

    // Register the BAR mapping with SPDK for vtophys resolution.
    let rc = unsafe { spdk_mem_register(bar_ptr, aligned_size) };
    if rc != 0 {
        unsafe {
            gdr_unmap(gdr, mh, bar_ptr, aligned_size);
            gdr_unpin_buffer(gdr, mh);
        }
        release_gdr_handle(gdr);
        return Err(format!(
            "spdk_mem_register on BAR mapping failed (rc={}). Is nvidia-peermem loaded?",
            rc
        ));
    }

    // Store state for cleanup.
    gdr_mappings()
        .lock()
        .unwrap_or_else(|e| e.into_inner())
        .insert(
            effective_bar_ptr as usize,
            GdrMappingState {
                gdr,
                mh,
                bar_ptr,
                size: aligned_size,
            },
        );

    let result = unsafe {
        interfaces::DmaBuffer::from_raw(
            effective_bar_ptr,
            size,
            spdk_unregister_gdr_unmap_and_pool,
            -1,
        )
        .map_err(|e| format!("DmaBuffer creation failed: {}", e))
    };

    if result.is_err() {
        gdr_mappings()
            .lock()
            .unwrap_or_else(|e| e.into_inner())
            .remove(&(effective_bar_ptr as usize));
        unsafe {
            spdk_mem_unregister(bar_ptr, aligned_size);
            gdr_unmap(gdr, mh, bar_ptr, aligned_size);
            gdr_unpin_buffer(gdr, mh);
        }
        release_gdr_handle(gdr);
    }

    result
}

// ============================================================================
// Pre-allocated DMA buffer pool for high-throughput cold lookups
// ============================================================================

/// Buffer size classes for the pool (powers of 2 from 4KB to 2MB)
#[cfg(feature = "p2p")]
const POOL_SIZE_CLASSES: &[usize] = &[
    4096,           // 4KB
    16384,          // 16KB
    65536,          // 64KB
    262144,         // 256KB
    1048576,        // 1MB
    2097152,        // 2MB
];

/// Maximum buffers per size class
#[cfg(feature = "p2p")]
const POOL_BUFFERS_PER_CLASS: usize = 32;

#[cfg(feature = "p2p")]
struct PooledBuffer {
    dev_ptr: *mut std::ffi::c_void,
    bar_ptr: *mut std::ffi::c_void,
    effective_bar_ptr: *mut std::ffi::c_void,
    gdr: crate::gdrcopy_ffi::gdr_t,
    mh: crate::gdrcopy_ffi::gdr_mh_t,
    aligned_size: usize,
}

#[cfg(feature = "p2p")]
unsafe impl Send for PooledBuffer {}
#[cfg(feature = "p2p")]
unsafe impl Sync for PooledBuffer {}

#[cfg(feature = "p2p")]
static BUFFER_POOLS: std::sync::OnceLock<
    Vec<crossbeam_queue::ArrayQueue<PooledBuffer>>,
> = std::sync::OnceLock::new();

#[cfg(feature = "p2p")]
fn buffer_pools() -> &'static Vec<crossbeam_queue::ArrayQueue<PooledBuffer>> {
    BUFFER_POOLS.get_or_init(|| {
        POOL_SIZE_CLASSES.iter().map(|_| {
            crossbeam_queue::ArrayQueue::new(POOL_BUFFERS_PER_CLASS)
        }).collect()
    })
}

/// Find the appropriate size class index for a given size.
#[cfg(feature = "p2p")]
fn size_class_index(size: usize) -> Option<usize> {
    POOL_SIZE_CLASSES.iter().position(|&s| s >= size)
}

/// Try to acquire a pre-registered buffer from the pool.
/// Returns the pooled buffer if available, or None if pool is empty.
#[cfg(feature = "p2p")]
pub fn try_acquire_pooled_buffer(size: usize) -> Option<*mut std::ffi::c_void> {
    let idx = size_class_index(size)?;
    let pools = buffer_pools();
    if idx < pools.len() {
        if let Some(buf) = pools[idx].pop() {
            // Re-register in the gdr_mappings for cleanup tracking
            gdr_mappings()
                .lock()
                .unwrap_or_else(|e| e.into_inner())
                .insert(
                    buf.effective_bar_ptr as usize,
                    GdrMappingState {
                        gdr: buf.gdr,
                        mh: buf.mh,
                        bar_ptr: buf.bar_ptr,
                        size: buf.aligned_size,
                    },
                );
            return Some(buf.effective_bar_ptr);
        }
    }
    None
}

// ============================================================================
// Physical address path (cross-process P2P)
// ============================================================================

/// Tracks physical DMA mappings (mmap'd VA → phys) for cleanup.
#[cfg(feature = "p2p")]
struct PhysMappingState {
    va: *mut std::ffi::c_void,
    phys_addr: u64,
    size: usize,
}

#[cfg(feature = "p2p")]
unsafe impl Send for PhysMappingState {}
#[cfg(feature = "p2p")]
unsafe impl Sync for PhysMappingState {}

#[cfg(feature = "p2p")]
static PHYS_MAPPINGS: std::sync::OnceLock<
    std::sync::Mutex<std::collections::HashMap<usize, PhysMappingState>>,
> = std::sync::OnceLock::new();

#[cfg(feature = "p2p")]
fn phys_mappings() -> &'static std::sync::Mutex<std::collections::HashMap<usize, PhysMappingState>>
{
    PHYS_MAPPINGS.get_or_init(|| std::sync::Mutex::new(std::collections::HashMap::with_capacity(256)))
}

/// # Safety
///
/// `ptr` must be a VA previously created by `create_spdk_dma_buffer_from_phys`.
#[cfg(feature = "p2p")]
pub unsafe extern "C" fn vfio_unmap_extmem_munmap(ptr: *mut std::ffi::c_void) {
    unsafe {
        let state = phys_mappings()
            .lock()
            .unwrap_or_else(|e| e.into_inner())
            .remove(&(ptr as usize));

        if let Some(s) = state {
            rte_vfio_container_dma_unmap(-1, s.va as u64, s.phys_addr, s.size as u64);
            rte_extmem_unregister(s.va, s.size);
            libc::munmap(s.va, s.size);
        }
    }
}

/// Resolve a virtual address to its physical/IOVA address via SPDK's vtophys.
#[cfg(feature = "p2p")]
pub unsafe fn get_phys_addr(ptr: *const std::ffi::c_void, size: usize) -> Option<u64> {
    const SPDK_VTOPHYS_ERROR: u64 = 0xFFFF_FFFF_FFFF_FFFF;
    let mut sz = size as u64;
    let phys = unsafe { spdk_vtophys(ptr, &mut sz) };
    if phys == SPDK_VTOPHYS_ERROR {
        None
    } else {
        Some(phys)
    }
}

/// Create an SPDK `DmaBuffer` targeting a known physical address via DPDK IOMMU mapping.
/// Uses 2MB hugepage-aligned mappings for optimal IOMMU TLB performance.
#[cfg(feature = "p2p")]
pub fn create_spdk_dma_buffer_from_phys(
    phys_addr: u64,
    size: usize,
) -> Result<interfaces::DmaBuffer, String> {
    // Use hugepage-aligned size for better IOMMU TLB hit rates
    let hugepage_size: usize = 2 * 1024 * 1024; // 2MB
    let aligned_size = if size >= hugepage_size {
        (size + hugepage_size - 1) & !(hugepage_size - 1)
    } else {
        size
    };

    // SAFETY: mmap anonymous private pages as a VA placeholder.
    // Use MAP_HUGETLB for large allocations to reduce TLB pressure.
    let flags = if aligned_size >= hugepage_size {
        libc::MAP_PRIVATE | libc::MAP_ANONYMOUS | libc::MAP_HUGETLB
    } else {
        libc::MAP_PRIVATE | libc::MAP_ANONYMOUS
    };

    let va = unsafe {
        libc::mmap(
            std::ptr::null_mut(),
            aligned_size,
            libc::PROT_READ | libc::PROT_WRITE,
            flags,
            -1,
            0,
        )
    };

    // Fall back to regular pages if hugepage mmap fails
    let (va, final_size) = if va == libc::MAP_FAILED && flags != (libc::MAP_PRIVATE | libc::MAP_ANONYMOUS) {
        let va2 = unsafe {
            libc::mmap(
                std::ptr::null_mut(),
                size,
                libc::PROT_READ | libc::PROT_WRITE,
                libc::MAP_PRIVATE | libc::MAP_ANONYMOUS,
                -1,
                0,
            )
        };
        if va2 == libc::MAP_FAILED {
            return Err("mmap anonymous pages failed".to_string());
        }
        (va2, size)
    } else if va == libc::MAP_FAILED {
        return Err("mmap anonymous pages failed".to_string());
    } else {
        (va, aligned_size)
    };

    // Tell DPDK that this VA range maps to the given physical/IOVA address.
    let page_sz = if final_size >= hugepage_size { hugepage_size } else { 4096 };
    let n_pages = final_size.div_ceil(page_sz);
    let iova_array: Vec<u64> = (0..n_pages).map(|i| phys_addr + (i * page_sz) as u64).collect();
    let rc = unsafe { rte_extmem_register(va, final_size, iova_array.as_ptr(), n_pages as std::os::raw::c_uint, page_sz) };
    if rc != 0 {
        unsafe { libc::munmap(va, final_size) };
        return Err(format!("rte_extmem_register failed (rc={})", rc));
    }

    // Program the VFIO IOMMU
    let rc = unsafe { rte_vfio_container_dma_map(-1, va as u64, phys_addr, final_size as u64) };
    if rc != 0 {
        unsafe {
            rte_extmem_unregister(va, final_size);
            libc::munmap(va, final_size);
        }
        return Err(format!("rte_vfio_container_dma_map failed (rc={})", rc));
    }

    phys_mappings()
        .lock()
        .unwrap_or_else(|e| e.into_inner())
        .insert(
            va as usize,
            PhysMappingState {
                va,
                phys_addr,
                size: final_size,
            },
        );

    let result = unsafe {
        interfaces::DmaBuffer::from_raw(va, size, vfio_unmap_extmem_munmap, -1)
            .map_err(|e| format!("DmaBuffer creation failed: {}", e))
    };

    if result.is_err() {
        phys_mappings()
            .lock()
            .unwrap_or_else(|e| e.into_inner())
            .remove(&(va as usize));
        unsafe {
            rte_vfio_container_dma_unmap(-1, va as u64, phys_addr, final_size as u64);
            rte_extmem_unregister(va, final_size);
            libc::munmap(va, final_size);
        }
    }

    result
}

/// Create an SPDK `DmaBuffer` from an existing BAR VA using direct DPDK IOMMU programming.
#[cfg(feature = "p2p")]
pub unsafe fn create_spdk_dma_buffer_from_bar_direct(
    bar_ptr: *mut std::ffi::c_void,
    size: usize,
) -> Result<interfaces::DmaBuffer, String> {
    let iova = bar_ptr as u64;

    // Use GPU page size (64KB) for alignment - matches GDRCopy BAR mappings better
    let page_sz: usize = 65536;
    let aligned_size = (size + page_sz - 1) & !(page_sz - 1);
    let n_pages = aligned_size / page_sz;
    let iova_array: Vec<u64> = (0..n_pages).map(|i| iova + (i * page_sz) as u64).collect();
    let rc = unsafe {
        rte_extmem_register(
            bar_ptr,
            aligned_size,
            iova_array.as_ptr(),
            n_pages as std::os::raw::c_uint,
            page_sz,
        )
    };
    if rc != 0 {
        // Fallback to 4KB page size
        let page_sz_fallback: usize = 4096;
        let n_pages_fb = size.div_ceil(page_sz_fallback);
        let iova_array_fb: Vec<u64> = (0..n_pages_fb).map(|i| iova + (i * page_sz_fallback) as u64).collect();
        let rc2 = unsafe {
            rte_extmem_register(
                bar_ptr,
                size,
                iova_array_fb.as_ptr(),
                n_pages_fb as std::os::raw::c_uint,
                page_sz_fallback,
            )
        };
        if rc2 != 0 {
            let errno = std::io::Error::last_os_error();
            return Err(format!(
                "rte_extmem_register failed (rc={}, errno={}, va={:?}, size={})",
                rc2, errno, bar_ptr, size
            ));
        }
        // Use original size for the rest if fallback succeeded
        let rc3 = unsafe { rte_vfio_container_dma_map(-1, bar_ptr as u64, iova, size as u64) };
        if rc3 != 0 {
            unsafe { rte_extmem_unregister(bar_ptr, size) };
            return Err(format!("rte_vfio_container_dma_map failed (rc={})", rc3));
        }

        phys_mappings()
            .lock()
            .unwrap_or_else(|e| e.into_inner())
            .insert(
                bar_ptr as usize,
                PhysMappingState {
                    va: bar_ptr,
                    phys_addr: iova,
                    size,
                },
            );

        let result = unsafe {
            interfaces::DmaBuffer::from_raw(bar_ptr, size, vfio_unmap_extmem_only, -1)
                .map_err(|e| format!("DmaBuffer creation failed: {}", e))
        };

        if result.is_err() {
            phys_mappings()
                .lock()
                .unwrap_or_else(|e| e.into_inner())
                .remove(&(bar_ptr as usize));
            unsafe {
                rte_vfio_container_dma_unmap(-1, bar_ptr as u64, iova, size as u64);
                rte_extmem_unregister(bar_ptr, size);
            }
        }

        return result;
    }

    // Program the VFIO IOMMU
    let rc = unsafe { rte_vfio_container_dma_map(-1, bar_ptr as u64, iova, aligned_size as u64) };
    if rc != 0 {
        unsafe { rte_extmem_unregister(bar_ptr, aligned_size) };
        return Err(format!("rte_vfio_container_dma_map failed (rc={})", rc));
    }

    phys_mappings()
        .lock()
        .unwrap_or_else(|e| e.into_inner())
        .insert(
            bar_ptr as usize,
            PhysMappingState {
                va: bar_ptr,
                phys_addr: iova,
                size: aligned_size,
            },
        );

    let result = unsafe {
        interfaces::DmaBuffer::from_raw(bar_ptr, size, vfio_unmap_extmem_only, -1)
            .map_err(|e| format!("DmaBuffer creation failed: {}", e))
    };

    if result.is_err() {
        phys_mappings()
            .lock()
            .unwrap_or_else(|e| e.into_inner())
            .remove(&(bar_ptr as usize));
        unsafe {
            rte_vfio_container_dma_unmap(-1, bar_ptr as u64, iova, aligned_size as u64);
            rte_extmem_unregister(bar_ptr, aligned_size);
        }
    }

    result
}

/// # Safety
///
/// `ptr` must be a BAR VA previously registered via `create_spdk_dma_buffer_from_bar_direct`.
#[cfg(feature = "p2p")]
pub unsafe extern "C" fn vfio_unmap_extmem_only(ptr: *mut std::ffi::c_void) {
    unsafe {
        let state = phys_mappings()
            .lock()
            .unwrap_or_else(|e| e.into_inner())
            .remove(&(ptr as usize));

        if let Some(s) = state {
            rte_vfio_container_dma_unmap(-1, s.va as u64, s.phys_addr, s.size as u64);
            rte_extmem_unregister(s.va, s.size);
        }
    }
}

