+    /// P2P direct DMA path: NVMe → GPU BAR1 without host bounce.
+    ///
+    /// Constructs the prepare_memory_for_spdk payload from the raw CUDA IPC handle bytes,
+    /// obtains a GPU-backed DmaBuffer, then issues per-chunk ReadSync operations that
+    /// target GPU BAR1 memory directly (NVMe DMA → GPU, no CPU copy).
+    fn read_from_block_device_p2p(
+        &self,
+        key: CacheKey,
+        offset: u64,
+        ipc_handle: &IpcHandle,
+        gpu: &Arc<dyn IGpuServices + Send + Sync>,
+    ) -> Result<(), DispatcherError> {
+        use base64::Engine;
+
+        let handle_bytes = ipc_handle.cuda_ipc_handle_bytes.as_ref()
+            .ok_or_else(|| DispatcherError::InvalidParameter("P2P path requires cuda_ipc_handle_bytes".into()))?;
+
+        if handle_bytes.len() != 64 {
+            return Err(DispatcherError::InvalidParameter(
+                format!("cuda_ipc_handle_bytes must be 64 bytes, got {}", handle_bytes.len()),
+            ));
+        }
+
+        // Build 72-byte payload: 64-byte IPC handle + 8-byte LE u64 size.
+        let total_bytes = ipc_handle.size as u64;
+        let mut payload = Vec::with_capacity(72);
+        payload.extend_from_slice(handle_bytes);
+        payload.extend_from_slice(&total_bytes.to_le_bytes());
+        let encoded = base64::engine::general_purpose::STANDARD.encode(&payload);
+
+        // Obtain GPU-backed DmaBuffer (GPU BAR1 pinned via SPDK peer-to-peer).
+        let gpu_buf = gpu.prepare_memory_for_spdk(&encoded, None).map_err(|e| {
+            DispatcherError::IoError(format!("prepare_memory_for_spdk failed: {e}"))
+        })?;
+
+        let drives = self.data_drives.lock().unwrap();
+        if drives.is_empty() {
+            return Err(DispatcherError::IoError(
+                "no data drives available for P2P read".into(),
+            ));
+        }
+
+        let idx = Self::drive_index(key, drives.len());
+        let drive = &drives[idx];
+        let block_size = drive.block_dev_iface.block_size();
+        let max_transfer = drive.block_dev_iface.max_transfer_size();
+        let start_lba = offset / block_size as u64;
+        let aligned_bytes = (ipc_handle.size as usize).next_multiple_of(block_size as usize);
+
+        let channels = drive.block_dev_iface.connect_client().map_err(|e| {
+            DispatcherError::IoError(format!("connect_client failed: {e}"))
+        })?;
+        drop(drives);
+
+        let segments = io_segmenter::segment_io(start_lba, aligned_bytes, max_transfer, block_size);
+
+        let gpu_ptr = gpu_buf.as_ptr() as *mut std::ffi::c_void;
+
+        for seg in &segments {
+            // Create a non-owning DmaBuffer view at the correct offset within the GPU buffer.
+            // SAFETY: gpu_ptr + buffer_offset is within the pinned GPU allocation returned by
+            // prepare_memory_for_spdk. noop_free ensures we don't double-free GPU memory.
+            let sub_buf = unsafe {
+                DmaBuffer::from_raw(
+                    (gpu_ptr as *mut u8).add(seg.buffer_offset) as *mut std::ffi::c_void,
+                    seg.length,
+                    noop_free,
+                    -1,
+                ).map_err(|e| DispatcherError::AllocationFailed(format!("P2P sub-buffer: {e}")))?
+            };
+            let sub_buf = Arc::new(Mutex::new(sub_buf));
+
+            channels.command_tx
+                .send(Command::ReadSync {
+                    ns_id: 1,
+                    lba: seg.lba,
+                    buf: Arc::clone(&sub_buf),
+                })
+                .map_err(|_| DispatcherError::IoError("P2P send ReadSync failed".into()))?;
+
+            match channels.completion_rx.recv() {
+                Ok(Completion::ReadDone { result, .. }) => {
+                    result.map_err(|e| DispatcherError::IoError(format!("P2P SSD read failed: {e}")))?;
+                }
+                Ok(other) => {
+                    return Err(DispatcherError::IoError(format!("P2P unexpected completion: {other:?}")));
+                }
+                Err(_) => {
+                    return Err(DispatcherError::IoError("P2P completion channel disconnected".into()));
+                }
+            }
+        }
+
+        Ok(())
+    }
