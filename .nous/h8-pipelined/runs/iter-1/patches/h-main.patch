@@ -643,6 +854,9 @@ fn main() {
                     TransferMode::Bounce => {
                         handle_bounce(&mut stream, &ctx, cli.chunk_size)
                     }
+                    TransferMode::BouncePipeline => {
+                        handle_bounce_pipeline(&mut stream, &ctx, cli.chunk_size)
+                    }
