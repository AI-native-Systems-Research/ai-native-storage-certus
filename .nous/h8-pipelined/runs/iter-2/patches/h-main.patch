+/// Pipelined bounce v2: pre-allocated cudaHostAlloc buffers (CUDA-native pinned) + CUDA stream.
+///
+/// Double-buffers NVMe reads and H2D copies: while chunk[i]'s cudaMemcpyAsync executes
+/// asynchronously on the GPU DMA engine, the CPU submits the NVMe read for chunk[i+1].
+fn handle_bounce_pipeline_v2(
+    stream: &mut UnixStream,
+    ctx: &ServerContext,
+    chunk_size: usize,
+    pipeline: &PipelineState,
+) -> Result<String, String> {
+    let (ipc_handle_bytes, size) = parse_client_payload(stream)?;
+    let client_dev_ptr = open_ipc_handle(&ipc_handle_bytes)?;
+
+    let num_chunks = (size + chunk_size - 1) / chunk_size;
+    let sectors_per_chunk = chunk_size / ctx.sector_size;
+
+    let ibd = query::<dyn IBlockDevice + Send + Sync>(&*ctx.block_dev)
+        .ok_or("IBlockDevice query failed".to_string())?;
+    let channels = ibd
+        .connect_client()
+        .map_err(|e| format!("connect_client: {e}"))?;
+
+    // Submit first read into buffer[0].
+    channels
+        .command_tx
+        .send(interfaces::Command::ReadAsync {
+            ns_id: ctx.ns_id,
+            lba: 0,
+            buf: Arc::clone(&pipeline.bufs[0]),
+            timeout_ms: 5000,
+        })
+        .map_err(|e| format!("ReadAsync send chunk 0: {e}"))?;
+
+    let mut current = 0usize;
+
+    for chunk_idx in 0..num_chunks {
+        let offset = chunk_idx * chunk_size;
+        let this_chunk = std::cmp::min(chunk_size, size - offset);
+
+        // Wait for NVMe read into bufs[current].
+        match channels.completion_rx.recv() {
+            Ok(interfaces::Completion::ReadDone { result, .. }) => {
+                result.map_err(|e| {
+                    unsafe { cuda_ffi::cudaIpcCloseMemHandle(client_dev_ptr) };
+                    format!("NVMe read chunk #{chunk_idx}: {e}")
+                })?;
+            }
+            Ok(interfaces::Completion::Timeout { handle }) => {
+                unsafe { cuda_ffi::cudaIpcCloseMemHandle(client_dev_ptr) };
+                return Err(format!("NVMe read timeout chunk #{chunk_idx} (handle {handle:?})"));
+            }
+            Ok(other) => {
+                unsafe { cuda_ffi::cudaIpcCloseMemHandle(client_dev_ptr) };
+                return Err(format!("unexpected completion: {other:?}"));
+            }
+            Err(e) => {
+                unsafe { cuda_ffi::cudaIpcCloseMemHandle(client_dev_ptr) };
+                return Err(format!("recv chunk #{chunk_idx}: {e}"));
+            }
+        }
+
+        // Launch async H2D from bufs[current] (CUDA-native pinned → truly async).
+        let err = unsafe {
+            cuda_ffi::cudaMemcpyAsync(
+                (client_dev_ptr as *mut u8).add(offset) as *mut c_void,
+                pipeline.host_ptrs[current] as *const c_void,
+                this_chunk,
+                cuda_ffi::CUDA_MEMCPY_HOST_TO_DEVICE,
+                pipeline.stream,
+            )
+        };
+        if err != cuda_ffi::CUDA_SUCCESS {
+            unsafe { cuda_ffi::cudaIpcCloseMemHandle(client_dev_ptr) };
+            return Err(format!(
+                "cudaMemcpyAsync H2D chunk #{chunk_idx}: {}",
+                cuda_ffi::cuda_error_string(err)
+            ));
+        }
+
+        let next = 1 - current;
+
+        // While GPU H2D is in flight, submit the next NVMe read (if any).
+        if chunk_idx + 1 < num_chunks {
+            channels
+                .command_tx
+                .send(interfaces::Command::ReadAsync {
+                    ns_id: ctx.ns_id,
+                    lba: ((chunk_idx + 1) as u64) * (sectors_per_chunk as u64),
+                    buf: Arc::clone(&pipeline.bufs[next]),
+                    timeout_ms: 5000,
+                })
+                .map_err(|e| {
+                    unsafe { cuda_ffi::cudaIpcCloseMemHandle(client_dev_ptr) };
+                    format!("ReadAsync send chunk {}: {e}", chunk_idx + 1)
+                })?;
+        }
+
+        current = next;
+    }
+
+    // Wait for all async H2D copies to complete.
+    let err = unsafe { cuda_ffi::cudaStreamSynchronize(pipeline.stream) };
+    if err != cuda_ffi::CUDA_SUCCESS {
+        unsafe { cuda_ffi::cudaIpcCloseMemHandle(client_dev_ptr) };
+        return Err(format!(
+            "cudaStreamSynchronize: {}",
+            cuda_ffi::cuda_error_string(err)
+        ));
+    }
+
+    unsafe { cuda_ffi::cudaIpcCloseMemHandle(client_dev_ptr) };
+
+    Ok(format!(
+        "OK {} bytes (bounce-pipeline-v2, {} chunks)",
+        size, num_chunks
+    ))
+}
