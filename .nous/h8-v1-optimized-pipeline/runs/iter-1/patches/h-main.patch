+fn cuda_err_str(err: CudaError) -> String {
+    // SAFETY: cudaGetErrorString returns a static string for any error code.
+    let ptr = unsafe { cudaGetErrorString(err) };
+    if ptr.is_null() {
+        return format!("CUDA error {err}");
+    }
+    // SAFETY: Valid null-terminated C string with static lifetime.
+    unsafe { std::ffi::CStr::from_ptr(ptr) }.to_string_lossy().into_owned()
+}
 
