index bed224c..8ae4a81 100644
--- a/components/dispatcher/src/pipeline.rs
+++ b/components/dispatcher/src/pipeline.rs
@@ -400,6 +400,219 @@ pub unsafe fn pipelined_ssd_to_gpu_zero_copy(
