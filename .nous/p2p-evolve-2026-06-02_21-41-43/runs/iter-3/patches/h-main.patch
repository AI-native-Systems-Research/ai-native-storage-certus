+/// Direct NVMe→GPU pipeline via nvidia-peermem.
+///
+/// Registers the GPU destination pointer with SPDK (`spdk_mem_register`), reads
+/// NVMe directly into GPU memory using a sliding-window pipeline, then unregisters.
+/// No DRAM allocation or H2D copy — a single PCIe traversal.
+///
+/// When `backfill` is `Some(...)`, after each chunk completes the NVMe read into GPU,
+/// a `cudaMemcpyAsync(DeviceToHost)` copies that chunk back to the DRAM pointer for
+/// warm-path caching (h-ablation condition).
+///
+/// # Safety
+///
+/// - `gpu_dst` must be a valid GPU device pointer (e.g. from IPC open) for at least `total_bytes`.
+/// - If `backfill` is provided, the DRAM pointer must be valid for `total_bytes`.
+#[cfg(feature = "p2p")]
+#[allow(clippy::too_many_arguments)]
+pub unsafe fn pipelined_ssd_to_gpu_direct(
+    drive: &dyn IBlockDevice,
+    channels: &ClientChannels,
+    gpu_dst: *mut std::ffi::c_void,
+    start_lba: u64,
+    total_bytes: usize,
+    chunk_size: usize,
+    max_queue_depth: usize,
+    backfill: Option<(*mut u8, GpuStream)>,
+) -> Result<(), DispatcherError> {
+    extern "C" {
+        fn spdk_mem_register(
+            vaddr: *mut std::ffi::c_void,
+            len: usize,
+        ) -> std::os::raw::c_int;
+        fn spdk_mem_unregister(
+            vaddr: *mut std::ffi::c_void,
+            len: usize,
+        ) -> std::os::raw::c_int;
+    }
+
+    // For D2H backfill (h-ablation).
+    #[allow(dead_code)]
+    extern "C" {
+        fn cudaMemcpyAsync(
+            dst: *mut std::ffi::c_void,
+            src: *const std::ffi::c_void,
+            count: usize,
+            kind: std::os::raw::c_int,
+            stream: *mut std::ffi::c_void,
+        ) -> std::os::raw::c_int;
+        fn cudaStreamSynchronize(stream: *mut std::ffi::c_void) -> std::os::raw::c_int;
+    }
+    const CUDA_MEMCPY_DEVICE_TO_HOST: std::os::raw::c_int = 2;
+
+    let block_size = drive.block_size() as usize;
+    let aligned_bytes = total_bytes.next_multiple_of(block_size);
+
+    // Register GPU destination memory with SPDK for NVMe DMA access.
+    let rc = unsafe { spdk_mem_register(gpu_dst, aligned_bytes) };
+    if rc != 0 {
+        return Err(DispatcherError::IoError(format!(
+            "spdk_mem_register on GPU ptr failed (rc={rc}). Is nvidia-peermem loaded?"
+        )));
+    }
+
+    let segments = io_segmenter::segment_io(
+        start_lba,
+        aligned_bytes,
+        chunk_size as u32,
+        block_size as u32,
+    );
+
+    if segments.is_empty() {
+        unsafe { spdk_mem_unregister(gpu_dst, aligned_bytes) };
+        return Ok(());
+    }
+
+    let num_chunks = segments.len();
+
+    // Create DmaBuffer wrappers for each chunk of the GPU destination.
+    let chunk_bufs: Vec<Arc<Mutex<DmaBuffer>>> = match segments
+        .iter()
+        .map(|seg| {
+            let ptr = unsafe { (gpu_dst as *mut u8).add(seg.buffer_offset) as *mut std::ffi::c_void };
+            let buf_size = seg.length.next_multiple_of(block_size);
+            let buf = unsafe { DmaBuffer::from_raw(ptr, buf_size, noop_free, -1) }
+                .map_err(|e| {
+                    DispatcherError::AllocationFailed(format!("DmaBuffer wrap GPU chunk: {e}"))
+                })?;
+            Ok(Arc::new(Mutex::new(buf)))
+        })
+        .collect::<Result<Vec<_>, DispatcherError>>()
+    {
+        Ok(bufs) => bufs,
+        Err(e) => {
+            unsafe { spdk_mem_unregister(gpu_dst, aligned_bytes) };
+            return Err(e);
+        }
+    };
+
+    let max_inflight = max_queue_depth.min(num_chunks);
+    let mut inflight: std::collections::VecDeque<usize> =
+        std::collections::VecDeque::with_capacity(max_inflight);
+
+    // Prime the sliding window.
+    for i in 0..max_inflight {
+        channels
+            .command_tx
+            .send(Command::ReadAsync {
+                ns_id: 1,
+                lba: segments[i].lba,
+                buf: Arc::clone(&chunk_bufs[i]),
+                timeout_ms: READ_TIMEOUT_MS,
+            })
+            .map_err(|e| {
+                unsafe { spdk_mem_unregister(gpu_dst, aligned_bytes) };
+                DispatcherError::IoError(format!("ReadAsync send #{i}: {e}"))
+            })?;
+        inflight.push_back(i);
+    }
+
+    let mut next_to_submit = max_inflight;
+    let mut backfill_count = 0usize;
+
+    // Sliding-window pipeline: NVMe reads land directly in GPU memory.
+    for _completed in 0..num_chunks {
+        let seg_idx = match channels.completion_rx.recv() {
+            Ok(Completion::ReadDone { handle, result }) => {
+                result.map_err(|e| {
+                    unsafe { spdk_mem_unregister(gpu_dst, aligned_bytes) };
+                    DispatcherError::IoError(format!("SSD read (handle {:?}): {e}", handle))
+                })?;
+                inflight.pop_front().unwrap()
+            }
+            Ok(Completion::Timeout { handle }) => {
+                unsafe { spdk_mem_unregister(gpu_dst, aligned_bytes) };
+                return Err(DispatcherError::IoError(format!(
+                    "NVMe read timeout (handle {:?})",
+                    handle
+                )));
+            }
+            Ok(other) => {
+                unsafe { spdk_mem_unregister(gpu_dst, aligned_bytes) };
+                return Err(DispatcherError::IoError(format!(
+                    "unexpected completion: {other:?}"
+                )));
+            }
+            Err(_) => {
+                unsafe { spdk_mem_unregister(gpu_dst, aligned_bytes) };
+                return Err(DispatcherError::IoError(
+                    "completion channel disconnected".into(),
+                ));
+            }
+        };
+
+        // Submit the next read immediately.
+        if next_to_submit < num_chunks {
+            channels
+                .command_tx
+                .send(Command::ReadAsync {
+                    ns_id: 1,
+                    lba: segments[next_to_submit].lba,
+                    buf: Arc::clone(&chunk_bufs[next_to_submit]),
+                    timeout_ms: READ_TIMEOUT_MS,
+                })
+                .map_err(|e| {
+                    unsafe { spdk_mem_unregister(gpu_dst, aligned_bytes) };
+                    DispatcherError::IoError(format!(
+                        "ReadAsync submit #{next_to_submit}: {e}"
+                    ))
+                })?;
+            inflight.push_back(next_to_submit);
+            next_to_submit += 1;
+        }
+
+        // Optionally backfill DRAM (h-ablation): GPU→DRAM copy.
+        if let Some((dram_ptr, stream)) = backfill {
+            let seg = &segments[seg_idx];
+            let copy_len = seg.length.min(total_bytes.saturating_sub(seg.buffer_offset));
+            let gpu_src = (gpu_dst as *mut u8).add(seg.buffer_offset) as *const std::ffi::c_void;
+            let dram_dst = dram_ptr.add(seg.buffer_offset) as *mut std::ffi::c_void;
+
+            unsafe {
+                cudaMemcpyAsync(
+                    dram_dst,
+                    gpu_src,
+                    copy_len,
+                    CUDA_MEMCPY_DEVICE_TO_HOST,
+                    stream.0,
+                );
+            }
+            backfill_count += 1;
+
+            // Periodically sync to bound the GPU copy queue depth.
+            if backfill_count % 16 == 0 {
+                unsafe { cudaStreamSynchronize(stream.0) };
+            }
+        }
+    }
+
+    // Final sync for backfill stream if used.
+    if let Some((_dram_ptr, stream)) = backfill {
+        unsafe { cudaStreamSynchronize(stream.0) };
+    }
+
+    // Unregister GPU memory from SPDK.
+    unsafe { spdk_mem_unregister(gpu_dst, aligned_bytes) };
+
+    // Forget all DmaBuffer wrappers (noop_free — GPU memory owned by IPC handle).
+    for buf in chunk_bufs {
+        std::mem::forget(Arc::try_unwrap(buf).ok());
+    }
+
+    Ok(())
+}
