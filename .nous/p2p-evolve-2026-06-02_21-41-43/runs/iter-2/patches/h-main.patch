+/// P2P ring slot: cudaMalloc'd GPU memory pinned via GDRCopy and mapped to BAR1.
+///
+/// `dev_ptr` is the CUDA device pointer (for cudaMemcpyAsync).
+/// `dma_buf` wraps the BAR1 mapping (for NVMe DMA targeting).
+#[cfg(feature = "p2p")]
+pub struct P2pRingSlot {
+    pub dev_ptr: *mut std::ffi::c_void,
+    pub dma_buf: DmaBuffer,
+}
+
+// SAFETY: dev_ptr is a GPU device pointer (process-global), dma_buf is BAR1-mapped.
+#[cfg(feature = "p2p")]
+unsafe impl Send for P2pRingSlot {}
+#[cfg(feature = "p2p")]
+unsafe impl Sync for P2pRingSlot {}
+
+/// Pre-allocated ring of P2P BAR1-mapped GPU buffers and CUDA streams.
+#[cfg(feature = "p2p")]
+pub struct PipelineRingP2P {
+    pub slots: Vec<P2pRingSlot>,
+    pub streams: [GpuStream; 2],
+    pub chunk_size: usize,
+}
+
+#[cfg(feature = "p2p")]
+impl PipelineRingP2P {
+    /// Allocate P2P ring slots: cudaMalloc + GDRCopy pin + BAR1 map + SPDK register.
+    pub fn new(gpu: &dyn IGpuServices, chunk_size: usize) -> Result<Self, DispatcherError> {
+        let mut slots: Vec<P2pRingSlot> = Vec::with_capacity(PIPELINE_RING_SIZE);
+
+        for i in 0..PIPELINE_RING_SIZE {
+            let mut dev_ptr: *mut std::ffi::c_void = std::ptr::null_mut();
+            let rc = unsafe {
+                gpu_services::cuda_ffi::cudaMalloc(&mut dev_ptr, chunk_size)
+            };
+            if rc != gpu_services::cuda_ffi::CUDA_SUCCESS {
+                // Clean up already-allocated slots.
+                for slot in slots {
+                    unsafe { gpu_services::cuda_ffi::cudaFree(slot.dev_ptr) };
+                }
+                return Err(DispatcherError::AllocationFailed(format!(
+                    "cudaMalloc for P2P ring slot {i}: rc={rc}"
+                )));
+            }
+
+            let dma_buf =
+                gpu_services::dma::create_spdk_dma_buffer_from_gpu_bar(dev_ptr, chunk_size)
+                    .map_err(|e| {
+                        unsafe { gpu_services::cuda_ffi::cudaFree(dev_ptr) };
+                        DispatcherError::AllocationFailed(format!(
+                            "P2P ring slot {i} BAR1 map: {e}"
+                        ))
+                    })?;
+
+            slots.push(P2pRingSlot { dev_ptr, dma_buf });
+        }
+
+        let stream_a = gpu
+            .create_stream()
+            .map_err(|e| DispatcherError::IoError(format!("create_stream failed: {e}")))?;
+        let stream_b = gpu.create_stream().map_err(|e| {
+            let _ = gpu.destroy_stream(stream_a);
+            DispatcherError::IoError(format!("create_stream failed: {e}"))
+        })?;
+
+        Ok(Self {
+            slots,
+            streams: [stream_a, stream_b],
+            chunk_size,
+        })
+    }
+
+    pub fn destroy(self, gpu: &dyn IGpuServices) {
+        let _ = gpu.destroy_stream(self.streams[0]);
+        let _ = gpu.destroy_stream(self.streams[1]);
+        for slot in self.slots {
+            drop(slot.dma_buf);
+            unsafe { gpu_services::cuda_ffi::cudaFree(slot.dev_ptr) };
+        }
+    }
+}
+
+/// Sliding-window P2P pipeline: NVMe reads into GPU BAR1 ring slots, D2D copy to final GPU dest.
+///
+/// Mirrors the sliding-window structure of [`pipelined_ssd_to_gpu_zero_copy`]:
+/// primes a window of NVMe reads, then for each completion issues a D2D copy and
+/// submits the next read. D2D copies at ~1.5 TB/s complete in <0.1µs for 128 KiB,
+/// so ring slot reuse is never blocked.
+///
+/// When `backfill_dram` is true, also issues a D2H copy from the BAR1 slot to
+/// `mem_tier_ptr` for memory-tier cache coherence.
+///
+/// # Safety
+///
+/// - `gpu_dst` must be a valid GPU destination pointer for `total_bytes`.
+/// - If `backfill_dram`, `mem_tier_ptr` must be valid for writes of `total_bytes`.
+#[cfg(feature = "p2p")]
+#[allow(clippy::too_many_arguments)]
+pub unsafe fn pipelined_ssd_to_gpu_p2p(
+    drive: &dyn IBlockDevice,
+    gpu: &dyn IGpuServices,
+    ring: &PipelineRingP2P,
+    channels: &ClientChannels,
+    mem_tier_ptr: *mut u8,
+    gpu_dst: *mut std::ffi::c_void,
+    start_lba: u64,
+    total_bytes: usize,
+    max_queue_depth: usize,
+    backfill_dram: bool,
+) -> Result<(), DispatcherError> {
+    let block_size = drive.block_size() as usize;
+    let chunk_size = ring.chunk_size;
+    let aligned_bytes = total_bytes.next_multiple_of(block_size);
+
+    let segments = io_segmenter::segment_io(
+        start_lba,
+        aligned_bytes,
+        chunk_size as u32,
+        block_size as u32,
+    );
+
+    if segments.is_empty() {
+        return Ok(());
+    }
+
+    let num_chunks = segments.len();
+    let ring_size = ring.slots.len();
+    let streams = &ring.streams;
+
+    // Create noop-free DmaBuffer wrappers pointing to the BAR1 addresses of ring slots.
+    // NVMe will DMA into these. We must NOT free them (the PipelineRingP2P owns the buffers).
+    let slot_bufs: Vec<Arc<Mutex<DmaBuffer>>> = ring
+        .slots
+        .iter()
+        .map(|slot| {
+            let buf = unsafe {
+                DmaBuffer::from_raw(slot.dma_buf.as_ptr(), chunk_size, noop_free, -1)
+            }
+            .map_err(|e| {
+                DispatcherError::AllocationFailed(format!("DmaBuffer wrap P2P slot: {e}"))
+            })?;
+            Ok(Arc::new(Mutex::new(buf)))
+        })
+        .collect::<Result<Vec<_>, DispatcherError>>()?;
+
+    let max_inflight = max_queue_depth.min(num_chunks).min(ring_size);
+
+    let mut inflight: std::collections::VecDeque<usize> =
+        std::collections::VecDeque::with_capacity(max_inflight);
+
+    // Prime the sliding window.
+    for i in 0..max_inflight {
+        let slot_idx = i % ring_size;
+        channels
+            .command_tx
+            .send(Command::ReadAsync {
+                ns_id: 1,
+                lba: segments[i].lba,
+                buf: Arc::clone(&slot_bufs[slot_idx]),
+                timeout_ms: READ_TIMEOUT_MS,
+            })
+            .map_err(|e| DispatcherError::IoError(format!("ReadAsync send #{i}: {e}")))?;
+        inflight.push_back(i);
+    }
+
+    let mut next_to_submit = max_inflight;
+    let mut stream_idx = 0usize;
+
+    for _completed in 0..num_chunks {
+        // Wait for the oldest in-flight read.
+        let chunk_idx = match channels.completion_rx.recv() {
+            Ok(Completion::ReadDone { handle, result }) => {
+                result.map_err(|e| {
+                    DispatcherError::IoError(format!("SSD read (handle {:?}): {e}", handle))
+                })?;
+                inflight.pop_front().unwrap()
+            }
+            Ok(Completion::Timeout { handle }) => {
+                return Err(DispatcherError::IoError(format!(
+                    "NVMe read timeout (handle {:?})",
+                    handle
+                )));
+            }
+            Ok(other) => {
+                return Err(DispatcherError::IoError(format!(
+                    "unexpected completion: {other:?}"
+                )));
+            }
+            Err(_) => {
+                return Err(DispatcherError::IoError(
+                    "completion channel disconnected".into(),
+                ));
+            }
+        };
+
+        let slot_idx = chunk_idx % ring_size;
+        let seg = &segments[chunk_idx];
+        let copy_len = seg.length.min(total_bytes.saturating_sub(seg.buffer_offset));
+        let current_stream = streams[stream_idx % 2];
+
+        // Copy from BAR1 slot to final GPU destination via H2D.
+        // Using BAR1 VA as source (host-visible mapping of GPU memory) ensures
+        // we read the NVMe DMA data directly without GPU L2 cache coherence issues.
+        let dst = unsafe { (gpu_dst as *mut u8).add(seg.buffer_offset) as *mut std::ffi::c_void };
+        let bar_src = unsafe {
+            (ring.slots[slot_idx].dma_buf.as_ptr() as *const u8) as *const std::ffi::c_void
+        };
+        let rc = unsafe {
+            gpu_services::cuda_ffi::cudaMemcpyAsync(
+                dst,
+                bar_src,
+                copy_len,
+                gpu_services::cuda_ffi::CUDA_MEMCPY_HOST_TO_DEVICE,
+                current_stream.0 as gpu_services::cuda_ffi::CudaStream,
+            )
+        };
+        if rc != gpu_services::cuda_ffi::CUDA_SUCCESS {
+            return Err(DispatcherError::IoError(format!(
+                "cudaMemcpyAsync H2D (BAR1→GPU) failed: {}",
+                gpu_services::cuda_ffi::cuda_error_string(rc)
+            )));
+        }
+
+        // Optional DRAM backfill: copy BAR1 slot to memory-tier via CPU memcpy.
+        // BAR1 is host-visible so direct memcpy works and avoids CUDA stream overhead.
+        if backfill_dram && !mem_tier_ptr.is_null() {
+            unsafe {
+                std::ptr::copy_nonoverlapping(
+                    ring.slots[slot_idx].dma_buf.as_ptr() as *const u8,
+                    mem_tier_ptr.add(seg.buffer_offset),
+                    copy_len,
+                );
+            }
+        }
+
+        stream_idx += 1;
+
+        // Submit next read into the same ring slot (just freed by completion).
+        // cudaMemcpyAsync from pageable (BAR1) memory executes synchronously per
+        // CUDA semantics, so the slot data is already copied when we reach here.
+        if next_to_submit < num_chunks {
+            channels
+                .command_tx
+                .send(Command::ReadAsync {
+                    ns_id: 1,
+                    lba: segments[next_to_submit].lba,
+                    buf: Arc::clone(&slot_bufs[slot_idx]),
+                    timeout_ms: READ_TIMEOUT_MS,
+                })
+                .map_err(|e| {
+                    DispatcherError::IoError(format!(
+                        "ReadAsync submit #{next_to_submit}: {e}"
+                    ))
+                })?;
+            inflight.push_back(next_to_submit);
+            next_to_submit += 1;
+        }
+    }
+
+    // Final sync.
+    for s in streams {
+        gpu.stream_synchronize(*s)
+            .map_err(|e| DispatcherError::IoError(format!("final stream_synchronize: {e}")))?;
+    }
+
+    // Forget noop-free DmaBuffer wrappers.
+    for buf in slot_bufs {
+        std::mem::forget(Arc::try_unwrap(buf).ok());
+    }
+
+    Ok(())
+}
