+/// Pre-allocated ring of GPU BAR1 DMA buffers for P2P NVMe→GPU transfers.
+///
+/// Each slot is a `P2pRingSlot` containing:
+/// - A GPU device pointer (from cudaMalloc) used as source for D2D memcpy
+/// - A BAR1-backed DmaBuffer registered with SPDK (NVMe DMA target)
+///
+/// NVMe reads target the BAR1 DMA buffer directly, landing data in GPU VRAM.
+/// A device-to-device memcpy then copies from the staging slot to the final
+/// GPU destination.
+#[cfg(feature = "p2p")]
+pub struct PipelineRingP2P {
+    pub slots: Vec<Arc<Mutex<gpu_services::dma::P2pRingSlot>>>,
+    pub streams: [GpuStream; 2],
+    pub chunk_size: usize,
+}
+
+#[cfg(feature = "p2p")]
+impl PipelineRingP2P {
+    pub fn new(gpu: &dyn IGpuServices, chunk_size: usize, num_slots: usize) -> Result<Self, DispatcherError> {
+        let mut slots = Vec::with_capacity(num_slots);
+        for i in 0..num_slots {
+            match gpu_services::dma::create_p2p_ring_slot(chunk_size) {
+                Ok(slot) => slots.push(Arc::new(Mutex::new(slot))),
+                Err(e) => {
+                    // Clean up already-allocated slots.
+                    for s in slots {
+                        if let Ok(s) = Arc::try_unwrap(s) {
+                            gpu_services::dma::destroy_p2p_ring_slot(s.into_inner().unwrap());
+                        }
+                    }
+                    return Err(DispatcherError::AllocationFailed(format!(
+                        "P2P ring slot {i}: {e}"
+                    )));
+                }
+            }
+        }
+
+        let stream_a = gpu
+            .create_stream()
+            .map_err(|e| DispatcherError::IoError(format!("create_stream failed: {e}")))?;
+        let stream_b = gpu.create_stream().map_err(|e| {
+            let _ = gpu.destroy_stream(stream_a);
+            DispatcherError::IoError(format!("create_stream failed: {e}"))
+        })?;
+
+        Ok(Self {
+            slots,
+            streams: [stream_a, stream_b],
+            chunk_size,
+        })
+    }
+
+    pub fn destroy(self, gpu: &dyn IGpuServices) {
+        let _ = gpu.destroy_stream(self.streams[0]);
+        let _ = gpu.destroy_stream(self.streams[1]);
+        for slot_arc in self.slots {
+            if let Ok(slot) = Arc::try_unwrap(slot_arc) {
+                gpu_services::dma::destroy_p2p_ring_slot(slot.into_inner().unwrap());
+            }
+        }
+    }
+}
+
+/// P2P pipeline: read from SSD directly into GPU BAR1 memory, then D2D copy to final destination.
+///
+/// Uses a batch-based approach: submit reads to all ring slots, wait for all completions,
+/// issue D2D copies, sync streams, then process the next batch. This ensures ring slots
+/// are never reused while D2D copies are still in flight.
+///
+/// # Safety
+///
+/// - `mem_tier_ptr` must be valid for writes of at least `total_bytes` (or null if no backfill).
+/// - `gpu_dst` must be a valid GPU destination pointer for `total_bytes`.
+#[cfg(feature = "p2p")]
+#[allow(clippy::too_many_arguments)]
+pub unsafe fn pipelined_ssd_to_gpu_p2p(
+    drive: &dyn IBlockDevice,
+    gpu: &dyn IGpuServices,
+    ring: &PipelineRingP2P,
+    channels: &ClientChannels,
+    mem_tier_ptr: *mut u8,
+    gpu_dst: *mut std::ffi::c_void,
+    start_lba: u64,
+    total_bytes: usize,
+    _max_queue_depth: usize,
+    backfill_dram: bool,
+) -> Result<(), DispatcherError> {
+    use gpu_services::cuda_ffi;
+
+    let block_size = drive.block_size() as usize;
+    let chunk_size = ring.chunk_size;
+    let aligned_bytes = total_bytes.next_multiple_of(block_size);
+
+    let segments = io_segmenter::segment_io(
+        start_lba,
+        aligned_bytes,
+        chunk_size as u32,
+        block_size as u32,
+    );
+
+    if segments.is_empty() {
+        return Ok(());
+    }
+
+    let num_chunks = segments.len();
+    let ring_size = ring.slots.len().min(num_chunks);
+    let streams = &ring.streams;
+
+    // Create noop-free DmaBuffer wrappers around BAR1 pointers for NVMe read commands.
+    let slot_bufs: Vec<Arc<Mutex<DmaBuffer>>> = ring
+        .slots
+        .iter()
+        .take(ring_size)
+        .map(|slot_arc| {
+            let slot = slot_arc.lock().unwrap();
+            let ptr = slot.dma_buf.as_ptr();
+            let buf = unsafe { DmaBuffer::from_raw(ptr, chunk_size, noop_free, -1) }
+                .map_err(|e| DispatcherError::AllocationFailed(format!("P2P DmaBuffer wrap: {e}")))?;
+            Ok(Arc::new(Mutex::new(buf)))
+        })
+        .collect::<Result<Vec<_>, DispatcherError>>()?;
+
+    // Collect dev_ptrs for D2D copies.
+    let dev_ptrs: Vec<*mut std::ffi::c_void> = ring
+        .slots
+        .iter()
+        .take(ring_size)
+        .map(|slot_arc| slot_arc.lock().unwrap().dev_ptr)
+        .collect();
+
+    // Process in batches of ring_size. Each batch:
+    // 1. Submit reads into ring slots (NVMe DMA → GPU BAR1)
+    // 2. Wait for all completions
+    // 3. Issue D2D copies from BAR1 staging to final gpu_dst
+    // 4. Optionally issue D2H backfill copies
+    // 5. Sync streams before next batch (ensures slots are safe to reuse)
+    let mut chunk_idx = 0;
+
+    while chunk_idx < num_chunks {
+        let batch_end = (chunk_idx + ring_size).min(num_chunks);
+        let batch_len = batch_end - chunk_idx;
+
+        // Submit this batch's reads into ring slots.
+        for i in 0..batch_len {
+            channels
+                .command_tx
+                .send(Command::ReadAsync {
+                    ns_id: 1,
+                    lba: segments[chunk_idx + i].lba,
+                    buf: Arc::clone(&slot_bufs[i]),
+                    timeout_ms: READ_TIMEOUT_MS,
+                })
+                .map_err(|e| {
+                    DispatcherError::IoError(format!("ReadAsync send #{}: {e}", chunk_idx + i))
+                })?;
+        }
+
+        // Wait for all reads in this batch to complete.
+        for _i in 0..batch_len {
+            match channels.completion_rx.recv() {
+                Ok(Completion::ReadDone { handle, result }) => {
+                    result.map_err(|e| {
+                        DispatcherError::IoError(format!(
+                            "SSD read (handle {:?}): {e}",
+                            handle
+                        ))
+                    })?;
+                }
+                Ok(Completion::Timeout { handle }) => {
+                    return Err(DispatcherError::IoError(format!(
+                        "NVMe read timeout (handle {:?})",
+                        handle
+                    )));
+                }
+                Ok(other) => {
+                    return Err(DispatcherError::IoError(format!(
+                        "unexpected completion: {other:?}"
+                    )));
+                }
+                Err(_) => {
+                    return Err(DispatcherError::IoError(
+                        "completion channel disconnected".into(),
+                    ));
+                }
+            }
+        }
+
+        // All reads for this batch landed in GPU BAR1. Issue D2D copies.
+        for i in 0..batch_len {
+            let seg = &segments[chunk_idx + i];
+            let copy_len = seg.length.min(total_bytes.saturating_sub(seg.buffer_offset));
+            let current_stream = streams[i % 2];
+            let src_dev_ptr = dev_ptrs[i];
+            let dst_offset_ptr =
+                (gpu_dst as *mut u8).add(seg.buffer_offset) as *mut std::ffi::c_void;
+
+            let err = cuda_ffi::cudaMemcpyAsync(
+                dst_offset_ptr,
+                src_dev_ptr as *const std::ffi::c_void,
+                copy_len,
+                cuda_ffi::CUDA_MEMCPY_DEVICE_TO_DEVICE,
+                current_stream.0 as cuda_ffi::CudaStream,
+            );
+            if err != cuda_ffi::CUDA_SUCCESS {
+                return Err(DispatcherError::IoError(format!(
+                    "cudaMemcpyAsync D2D (seg {}) failed: {}",
+                    chunk_idx + i,
+                    cuda_ffi::cuda_error_string(err)
+                )));
+            }
+
+            // Backfill DRAM from the GPU staging buffer.
+            if backfill_dram && !mem_tier_ptr.is_null() {
+                let dram_dst = mem_tier_ptr.add(seg.buffer_offset) as *mut std::ffi::c_void;
+                let err = cuda_ffi::cudaMemcpyAsync(
+                    dram_dst,
+                    src_dev_ptr as *const std::ffi::c_void,
+                    copy_len,
+                    cuda_ffi::CUDA_MEMCPY_DEVICE_TO_HOST,
+                    current_stream.0 as cuda_ffi::CudaStream,
+                );
+                if err != cuda_ffi::CUDA_SUCCESS {
+                    return Err(DispatcherError::IoError(format!(
+                        "cudaMemcpyAsync D2H backfill (seg {}) failed: {}",
+                        chunk_idx + i,
+                        cuda_ffi::cuda_error_string(err)
+                    )));
+                }
+            }
+        }
+
+        // Sync both streams before reusing ring slots in the next batch.
+        gpu.stream_synchronize(streams[0])
+            .map_err(|e| DispatcherError::IoError(format!("stream_synchronize failed: {e}")))?;
+        gpu.stream_synchronize(streams[1])
+            .map_err(|e| DispatcherError::IoError(format!("stream_synchronize failed: {e}")))?;
+
+        chunk_idx = batch_end;
+    }
+
+    // Final sync (may be redundant but ensures correctness).
+    for s in streams {
+        gpu.stream_synchronize(*s)
+            .map_err(|e| DispatcherError::IoError(format!("final stream_synchronize: {e}")))?;
+    }
+
+    // Forget noop-free DmaBuffer wrappers (we don't own the BAR1 memory).
+    for buf in slot_bufs {
+        std::mem::forget(Arc::try_unwrap(buf).ok());
+    }
+
+    Ok(())
+}
