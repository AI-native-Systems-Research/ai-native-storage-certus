+/// A P2P ring buffer slot: GPU device pointer + SPDK-registered BAR1 DmaBuffer.
+#[cfg(feature = "p2p")]
+pub struct P2pRingSlot {
+    /// GPU device pointer (from cudaMalloc) — for cudaMemcpy D2D source.
+    pub dev_ptr: *mut std::ffi::c_void,
+    /// BAR1-backed DmaBuffer registered with SPDK — NVMe DMA target.
+    pub dma_buf: interfaces::DmaBuffer,
+}
+
+// SAFETY: The pointers are process-global GPU resources, not thread-bound.
+#[cfg(feature = "p2p")]
+unsafe impl Send for P2pRingSlot {}
+#[cfg(feature = "p2p")]
+unsafe impl Sync for P2pRingSlot {}
+
+/// Allocate a P2P ring buffer slot: cudaMalloc GPU memory, then create an
+/// SPDK-registered BAR1 DmaBuffer backed by that GPU memory.
+///
+/// Returns both the device pointer (for D2D memcpy) and the DmaBuffer
+/// (whose pointer is the BAR1 VA for NVMe DMA targeting).
+#[cfg(feature = "p2p")]
+pub fn create_p2p_ring_slot(size: usize) -> Result<P2pRingSlot, String> {
+    use crate::cuda_ffi;
+    use crate::gdrcopy_ffi::GPU_PAGE_SIZE;
+
+    let aligned_size = (size + GPU_PAGE_SIZE - 1) & !(GPU_PAGE_SIZE - 1);
+
+    let mut dev_ptr: *mut std::ffi::c_void = std::ptr::null_mut();
+    // SAFETY: cudaMalloc allocates device memory.
+    let err = unsafe { cuda_ffi::cudaMalloc(&mut dev_ptr, aligned_size) };
+    if err != cuda_ffi::CUDA_SUCCESS {
+        return Err(format!(
+            "cudaMalloc({} bytes) failed: {}",
+            aligned_size,
+            cuda_ffi::cuda_error_string(err)
+        ));
+    }
+
+    match create_spdk_dma_buffer_from_gpu_bar(dev_ptr, aligned_size) {
+        Ok(dma_buf) => Ok(P2pRingSlot { dev_ptr, dma_buf }),
+        Err(e) => {
+            // SAFETY: dev_ptr was successfully allocated above.
+            unsafe { cuda_ffi::cudaFree(dev_ptr) };
+            Err(format!("create_spdk_dma_buffer_from_gpu_bar failed: {e}"))
+        }
+    }
+}
+
+/// Free a P2P ring slot: the DmaBuffer drop handles BAR1 unmap + SPDK unregister,
+/// then we free the underlying GPU allocation.
+#[cfg(feature = "p2p")]
+pub fn destroy_p2p_ring_slot(slot: P2pRingSlot) {
+    use crate::cuda_ffi;
+
+    let dev_ptr = slot.dev_ptr;
+    // Drop the DmaBuffer first — its free_fn handles GDRCopy cleanup + SPDK unregister.
+    drop(slot.dma_buf);
+    // SAFETY: dev_ptr was allocated with cudaMalloc and is still valid.
+    unsafe { cuda_ffi::cudaFree(dev_ptr) };
+}
