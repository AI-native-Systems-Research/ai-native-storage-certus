+    /// P2P path: read NVMe chunks directly into GPU BAR1 memory, skipping host DRAM.
+    ///
+    /// Calls `prepare_memory_for_spdk` to get an SPDK-registered DmaBuffer backed by
+    /// GPU BAR1, then issues per-segment ReadSync commands targeting sub-views of that
+    /// buffer. No `dma_copy_to_device` is needed — data lands directly on the GPU.
+    fn read_from_block_device_p2p(
+        &self,
+        key: CacheKey,
+        offset: u64,
+        ipc_handle: &IpcHandle,
+        gpu: &Arc<dyn IGpuServices + Send + Sync>,
+    ) -> Result<(), DispatcherError> {
+        use base64::Engine;
+
+        let handle_bytes = ipc_handle
+            .cuda_ipc_handle_bytes
+            .as_ref()
+            .ok_or_else(|| DispatcherError::IoError("P2P path requires cuda_ipc_handle_bytes".into()))?;
+
+        if handle_bytes.len() != 64 {
+            return Err(DispatcherError::IoError(format!(
+                "cuda_ipc_handle_bytes must be 64 bytes, got {}",
+                handle_bytes.len()
+            )));
+        }
+
+        // Build 72-byte payload: 64 bytes CUDA handle + 8 bytes LE u64 size.
+        let total_bytes = ipc_handle.size as usize;
+        let mut payload = [0u8; 72];
+        payload[..64].copy_from_slice(handle_bytes);
+        payload[64..72].copy_from_slice(&(total_bytes as u64).to_le_bytes());
+        let base64_payload = base64::engine::general_purpose::STANDARD.encode(payload);
+
+        // Obtain a GPU-backed DmaBuffer registered with SPDK for P2P DMA.
+        let gpu_buf = gpu
+            .prepare_memory_for_spdk(&base64_payload, None)
+            .map_err(|e| DispatcherError::IoError(format!("prepare_memory_for_spdk failed: {e}")))?;
+
+        let drives = self.data_drives.lock().unwrap();
+        if drives.is_empty() {
+            return Err(DispatcherError::IoError(
+                "no data drives available for block device read".into(),
+            ));
+        }
+
+        let idx = Self::drive_index(key, drives.len());
+        let drive = &drives[idx];
+        let block_size = drive.block_dev_iface.block_size();
+        let max_transfer = drive.block_dev_iface.max_transfer_size();
+        let start_lba = offset / block_size as u64;
+        let aligned_bytes = total_bytes.next_multiple_of(block_size as usize);
+
+        let channels = drive.block_dev_iface.connect_client().map_err(|e| {
+            DispatcherError::IoError(format!("connect_client failed: {e}"))
+        })?;
+
+        drop(drives);
+
+        let segments =
+            io_segmenter::segment_io(start_lba, aligned_bytes, max_transfer, block_size);
+
+        let gpu_base_ptr = gpu_buf.as_ptr() as *mut u8;
+
+        for seg in &segments {
+            // Create a non-owning sub-view of the GPU DmaBuffer at chunk offset.
+            // SAFETY: gpu_base_ptr + seg.buffer_offset is within the registered GPU allocation
+            // (total size = aligned_bytes). The parent gpu_buf outlives all sub-views.
+            // noop_free prevents double-free — gpu_buf owns the memory.
+            unsafe extern "C" fn noop_free(_: *mut std::ffi::c_void) {}
+
+            let chunk_ptr = unsafe { gpu_base_ptr.add(seg.buffer_offset) as *mut std::ffi::c_void };
+            // SAFETY: chunk_ptr points within the SPDK-registered GPU region. noop_free is safe.
+            let seg_buf = unsafe {
+                DmaBuffer::from_raw(chunk_ptr, seg.length, noop_free, -1)
+                    .map_err(|e| DispatcherError::AllocationFailed(format!("GPU sub-view: {e}")))?
+            };
+            let seg_buf = Arc::new(Mutex::new(seg_buf));
+
+            channels
+                .command_tx
+                .send(Command::ReadSync {
+                    ns_id: 1,
+                    lba: seg.lba,
+                    buf: Arc::clone(&seg_buf),
+                })
+                .map_err(|_| DispatcherError::IoError("send ReadSync failed".into()))?;
+
+            match channels.completion_rx.recv() {
+                Ok(Completion::ReadDone { result, .. }) => {
+                    result.map_err(|e| {
+                        DispatcherError::IoError(format!("SSD read (P2P) failed: {e}"))
+                    })?;
+                }
+                Ok(other) => {
+                    return Err(DispatcherError::IoError(format!(
+                        "unexpected completion: {other:?}"
+                    )));
+                }
+                Err(_) => {
+                    return Err(DispatcherError::IoError(
+                        "completion channel disconnected".into(),
+                    ));
+                }
+            }
+        }
+
+        // Data is already on GPU — no dma_copy_to_device needed.
+        Ok(())
+    }
