+    /// Open a CUDA IPC handle from raw 64-byte handle bytes.
+    fn open_cuda_ipc_from_bytes(bytes: &[u8]) -> Result<*mut std::ffi::c_void, String> {
+        if bytes.len() != 64 {
+            return Err(format!("expected 64 bytes, got {}", bytes.len()));
+        }
+        let mut reserved = [0u8; 64];
+        reserved.copy_from_slice(bytes);
+        let cuda_handle = gpu_services::cuda_ffi::cudaIpcMemHandle_t { reserved };
+        let mut dev_ptr: *mut std::ffi::c_void = std::ptr::null_mut();
+        // SAFETY: cuda_handle is a valid IPC handle structure from the client.
+        let err = unsafe {
+            gpu_services::cuda_ffi::cudaIpcOpenMemHandle(
+                &mut dev_ptr,
+                cuda_handle,
+                gpu_services::cuda_ffi::CUDA_IPC_MEM_LAZY_ENABLE_PEER_ACCESS,
+            )
+        };
+        if err != gpu_services::cuda_ffi::CUDA_SUCCESS {
+            return Err(format!(
+                "cudaIpcOpenMemHandle failed: {}",
+                gpu_services::cuda_ffi::cuda_error_string(err)
+            ));
+        }
+        if dev_ptr.is_null() {
+            return Err("cudaIpcOpenMemHandle returned null".into());
+        }
+        Ok(dev_ptr)
+    }
