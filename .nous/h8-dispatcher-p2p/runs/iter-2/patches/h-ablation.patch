+/// Issue sequential (one-at-a-time) NVMe reads via ReadSync for all chunks.
+/// Matches the dispatcher's pipeline.rs pattern: each chunk completes before the next starts.
+fn do_chunked_read_seq(
+    ctx: &ServerContext,
+    dma_bufs: &[Arc<Mutex<interfaces::DmaBuffer>>],
+    base_lba: u64,
+    chunk_size: usize,
+) -> Result<(), String> {
+    let sectors_per_chunk = chunk_size / ctx.sector_size;
+
+    let ibd = query::<dyn IBlockDevice + Send + Sync>(&*ctx.block_dev)
+        .ok_or("IBlockDevice query failed".to_string())?;
+    let channels = ibd
+        .connect_client()
+        .map_err(|e| format!("connect_client: {e}"))?;
+
+    for (i, buf) in dma_bufs.iter().enumerate() {
+        let lba = base_lba + (i as u64 * sectors_per_chunk as u64);
+        channels
+            .command_tx
+            .send(interfaces::Command::ReadSync {
+                ns_id: ctx.ns_id,
+                lba,
+                buf: Arc::clone(buf),
+            })
+            .map_err(|e| format!("ReadSync send chunk #{i}: {e}"))?;
+
+        match channels.completion_rx.recv() {
+            Ok(interfaces::Completion::ReadDone { result, .. }) => {
+                result.map_err(|e| format!("NVMe sync read chunk #{i}: {e}"))?;
+            }
+            Ok(other) => {
+                return Err(format!("unexpected completion chunk #{i}: {other:?}"));
+            }
+            Err(e) => {
+                return Err(format!("recv chunk #{i}: {e}"));
+            }
+        }
+    }
+
+    Ok(())
+}
