+/// Execute the double-buffered async pipeline loop.
+///
+/// Pre-issues ReadAsync for the first chunk, then for each subsequent chunk:
+/// waits for the previous ReadDone, copies to mem-tier, launches cudaMemcpyAsync H2D,
+/// issues ReadAsync for the next chunk, alternating ring buffers.
+unsafe fn run_async_pipeline(
+    channels: &ClientChannels,
+    ring: &[Arc<Mutex<DmaBuffer>>],
+    segments: &[crate::io_segmenter::IoSegment],
+    mem_tier_ptr: *mut u8,
+    gpu_dst: *mut std::ffi::c_void,
+    total_bytes: usize,
+    stream: cuda_ffi::cudaStream_t,
+) -> Result<(), DispatcherError> {
+    let mut cur = 0usize; // current ring buffer index
+
+    // Pre-issue ReadAsync for the first chunk into ring[0].
+    channels
+        .command_tx
+        .send(Command::ReadAsync {
+            ns_id: 1,
+            lba: segments[0].lba,
+            buf: Arc::clone(&ring[cur]),
+            timeout_ms: 5000,
+        })
+        .map_err(|_| DispatcherError::IoError("send ReadAsync failed".into()))?;
+
+    for i in 0..segments.len() {
+        let seg = &segments[i];
+        let next_seg = segments.get(i + 1);
+
+        // Wait for completion of the current chunk read.
+        match channels.completion_rx.recv() {
+            Ok(Completion::ReadDone { result, .. }) => {
+                result.map_err(|e| DispatcherError::IoError(format!("SSD read failed: {e}")))?;
+            }
+            Ok(other) => {
+                return Err(DispatcherError::IoError(format!(
+                    "unexpected completion: {other:?}"
+                )));
+            }
+            Err(_) => {
+                return Err(DispatcherError::IoError(
+                    "completion channel disconnected".into(),
+                ));
+            }
+        }
+
+        // If there is a next chunk, pre-issue its ReadAsync immediately into the other ring buffer.
+        // This overlaps the NVMe read with the memcpy + cudaMemcpyAsync below.
+        let next_buf_idx = 1 - cur;
+        if let Some(ns) = next_seg {
+            let next_buf = if ring.len() > 1 {
+                Arc::clone(&ring[next_buf_idx])
+            } else {
+                // Single-buffer fallback: can't overlap but preserve correctness.
+                Arc::clone(&ring[0])
+            };
+            channels
+                .command_tx
+                .send(Command::ReadAsync {
+                    ns_id: 1,
+                    lba: ns.lba,
+                    buf: next_buf,
+                    timeout_ms: 5000,
+                })
+                .map_err(|_| DispatcherError::IoError("send ReadAsync (prefetch) failed".into()))?;
+        }
+
+        // Copy completed chunk to memory-tier slot (CPU memcpy, cheap).
+        let copy_len = seg.length.min(total_bytes.saturating_sub(seg.buffer_offset));
+        let guard = ring[cur].lock().unwrap();
+        if copy_len > 0 {
+            // SAFETY: mem_tier_ptr + buffer_offset is within the memory-tier slot.
+            unsafe {
+                std::ptr::copy_nonoverlapping(
+                    guard.as_ptr() as *const u8,
+                    mem_tier_ptr.add(seg.buffer_offset),
+                    copy_len,
+                );
+            }
+        }
+
+        // Launch async H2D GPU copy from mem-tier slot.
+        // The NVMe read for the next chunk is already in-flight concurrently.
+        if copy_len > 0 {
+            let gpu_offset = seg.buffer_offset;
+            // SAFETY: gpu_dst + gpu_offset is within the caller's GPU buffer.
+            let dst_ptr = unsafe { (gpu_dst as *mut u8).add(gpu_offset) as *mut std::ffi::c_void };
+            let src_ptr = unsafe { mem_tier_ptr.add(gpu_offset) as *const std::ffi::c_void };
+            let err = unsafe {
+                cuda_ffi::cudaMemcpyAsync(
+                    dst_ptr,
+                    src_ptr,
+                    copy_len,
+                    cuda_ffi::CUDA_MEMCPY_HOST_TO_DEVICE,
+                    stream,
+                )
+            };
+            if err != cuda_ffi::CUDA_SUCCESS {
+                drop(guard);
+                return Err(DispatcherError::IoError(format!(
+                    "cudaMemcpyAsync failed: {}",
+                    cuda_ffi::cuda_error_string(err)
+                )));
+            }
+        }
+
+        drop(guard);
+
+        // Advance ring buffer index for next iteration.
+        if ring.len() > 1 {
+            cur = next_buf_idx;
+        }
+    }
+
+    // Drain all in-flight GPU copies.
+    let err = unsafe { cuda_ffi::cudaStreamSynchronize(stream) };
+    if err != cuda_ffi::CUDA_SUCCESS {
+        return Err(DispatcherError::IoError(format!(
+            "cudaStreamSynchronize failed: {}",
+            cuda_ffi::cuda_error_string(err)
+        )));
+    }
+
+    Ok(())
+}
