+    let result = run_async_pipeline(
+        &channels,
+        &ring,
+        &segments,
+        mem_tier_ptr,
+        gpu_dst,
+        total_bytes,
+        stream,
+    );
+
+    // Always destroy the stream even on error.
+    unsafe { cuda_ffi::cudaStreamDestroy(stream) };
+
+    result
