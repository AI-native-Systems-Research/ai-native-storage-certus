+    let err = unsafe { cuda_ffi::cudaStreamCreate(&mut stream) };
+    if err != cuda_ffi::CUDA_SUCCESS {
+        // Fall back to synchronous path (gpu.dma_copy_to_device) if stream creation fails.
+        return pipelined_ssd_to_gpu_sync(
+            drive, gpu, mem_tier_ptr, gpu_dst, start_lba, total_bytes, numa_node,
+        );
+    }
