+/// Execute the double-buffered pipeline using cudaHostAlloc staging buffers.
+///
+/// NVMe reads directly into staging[cur] (SPDK-registered, natively pinned).
+/// cudaMemcpyAsync from staging[cur] to GPU runs truly asynchronously.
+/// While GPU copy runs, NVMe reads chunk N+1 into staging[1-cur].
+unsafe fn run_cudahost_pipeline(
+    channels: &ClientChannels,
+    staging: &[Arc<Mutex<DmaBuffer>>],
+    segments: &[crate::io_segmenter::IoSegment],
+    mem_tier_ptr: *mut u8,
+    gpu_dst: *mut std::ffi::c_void,
+    total_bytes: usize,
+    stream: cuda_ffi::cudaStream_t,
+) -> Result<(), DispatcherError> {
+    let mut cur = 0usize;
+
+    // Pre-issue ReadAsync for chunk 0 directly into staging[0].
+    // staging[0] is a cudaHostAlloc DmaBuffer — valid NVMe DMA target.
+    channels
+        .command_tx
+        .send(Command::ReadAsync {
+            ns_id: 1,
+            lba: segments[0].lba,
+            buf: Arc::clone(&staging[cur]),
+            timeout_ms: 5000,
+        })
+        .map_err(|_| DispatcherError::IoError("send ReadAsync failed".into()))?;
+
+    for i in 0..segments.len() {
+        let seg = &segments[i];
+        let next_seg = segments.get(i + 1);
+
+        // Wait for NVMe read of current chunk to complete.
+        match channels.completion_rx.recv() {
+            Ok(Completion::ReadDone { result, .. }) => {
+                result.map_err(|e| DispatcherError::IoError(format!("SSD read failed: {e}")))?;
+            }
+            Ok(other) => {
+                return Err(DispatcherError::IoError(format!(
+                    "unexpected completion: {other:?}"
+                )));
+            }
+            Err(_) => {
+                return Err(DispatcherError::IoError(
+                    "completion channel disconnected".into(),
+                ));
+            }
+        }
+
+        let next_idx = 1 - cur;
+
+        // Pre-issue NVMe read for next chunk into staging[next_idx] immediately.
+        // This overlaps NVMe read with the memcpy + cudaMemcpyAsync below.
+        if let Some(ns) = next_seg {
+            channels
+                .command_tx
+                .send(Command::ReadAsync {
+                    ns_id: 1,
+                    lba: ns.lba,
+                    buf: Arc::clone(&staging[next_idx]),
+                    timeout_ms: 5000,
+                })
+                .map_err(|_| DispatcherError::IoError("send ReadAsync (prefetch) failed".into()))?;
+        }
+
+        let copy_len = seg.length.min(total_bytes.saturating_sub(seg.buffer_offset));
+        let guard = staging[cur].lock().unwrap();
+
+        if copy_len > 0 {
+            // CPU memcpy from staging buffer to memory-tier slot.
+            // SAFETY: staging[cur] contains the completed NVMe read data.
+            // mem_tier_ptr + buffer_offset is within the memory-tier slot.
+            unsafe {
+                std::ptr::copy_nonoverlapping(
+                    guard.as_ptr() as *const u8,
+                    mem_tier_ptr.add(seg.buffer_offset),
+                    copy_len,
+                );
+            }
+
+            // cudaMemcpyAsync from natively-pinned staging buffer to GPU device memory.
+            // Because staging is cudaHostAlloc'd (not cudaHostRegister'd), the CUDA DMA
+            // engine performs this truly asynchronously — overlaps with next NVMe read.
+            let dst_ptr = unsafe {
+                (gpu_dst as *mut u8).add(seg.buffer_offset) as *mut std::ffi::c_void
+            };
+            let src_ptr = guard.as_ptr() as *const std::ffi::c_void;
+            let err = unsafe {
+                cuda_ffi::cudaMemcpyAsync(
+                    dst_ptr,
+                    src_ptr,
+                    copy_len,
+                    cuda_ffi::CUDA_MEMCPY_HOST_TO_DEVICE,
+                    stream,
+                )
+            };
+            if err != cuda_ffi::CUDA_SUCCESS {
+                drop(guard);
+                return Err(DispatcherError::IoError(format!(
+                    "cudaMemcpyAsync failed: {}",
+                    cuda_ffi::cuda_error_string(err)
+                )));
+            }
+        }
+
+        drop(guard);
+        cur = next_idx;
+    }
+
+    // Drain all in-flight GPU copies before returning.
+    let err = unsafe { cuda_ffi::cudaStreamSynchronize(stream) };
+    if err != cuda_ffi::CUDA_SUCCESS {
+        return Err(DispatcherError::IoError(format!(
+            "cudaStreamSynchronize failed: {}",
+            cuda_ffi::cuda_error_string(err)
+        )));
+    }
+
+    Ok(())
+}
