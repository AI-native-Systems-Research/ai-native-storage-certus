diff --git a/components/dispatcher/v1/src/pipeline.rs b/components/dispatcher/v1/src/pipeline.rs
index 4462243..a3dfc9d 100644
--- a/components/dispatcher/v1/src/pipeline.rs
+++ b/components/dispatcher/v1/src/pipeline.rs
@@ -122,6 +122,105 @@ pub unsafe fn pipelined_ssd_to_gpu(
     Ok(())
 }
 
+/// Direct P2P path: read NVMe chunks directly into GPU BAR1 memory via prepare_memory_for_spdk.
+///
+/// Registers the client's GPU allocation with SPDK via prepare_memory_for_spdk (which opens
+/// the CUDA IPC handle and pins the GPU BAR1 memory for DMA), then issues NVMe ReadSync
+/// directly into sub-views of that GPU buffer. Data arrives at the client's GPU allocation
+/// without any host bounce buffer or cudaMemcpy H2D.
+///
+/// Memory-tier promotion is intentionally skipped — this path serves the GPU directly
+/// from SSD without caching in host DRAM.
+///
+/// # Safety
+///
+/// - `cuda_ipc_handle_bytes` must be exactly 64 bytes (cudaIpcMemHandle_t.reserved).
+/// - The GPU allocation identified by the IPC handle must be at least `total_bytes`.
+pub unsafe fn p2p_ssd_to_gpu(
+    drive: &dyn IBlockDevice,
+    gpu: &dyn IGpuServices,
+    cuda_ipc_handle_bytes: &[u8],
+    start_lba: u64,
+    total_bytes: usize,
+    numa_node: i32,
+) -> Result<(), DispatcherError> {
+    use base64::Engine as _;
+
+    let block_size = drive.block_size() as usize;
+    let chunk_size = drive.max_transfer_size() as usize;
+    let aligned_bytes = total_bytes.next_multiple_of(block_size);
+
+    // Build 72-byte payload: 64-byte IPC handle + 8-byte LE u64 aligned size.
+    let mut payload = Vec::with_capacity(72);
+    payload.extend_from_slice(cuda_ipc_handle_bytes);
+    payload.extend_from_slice(&(aligned_bytes as u64).to_le_bytes());
+    let encoded = base64::engine::general_purpose::STANDARD.encode(&payload);
+
+    // Register the client's GPU memory with SPDK IOMMU so the NVMe controller can DMA into it.
+    // This returns a DmaBuffer whose pointer is the GPU BAR1 address of the client allocation.
+    let gpu_dma_buf = gpu.prepare_memory_for_spdk(&encoded, None)
+        .map_err(|e| DispatcherError::IoError(format!("prepare_memory_for_spdk failed: {e}")))?;
+
+    let channels: ClientChannels = drive.connect_client().map_err(|e| {
+        DispatcherError::IoError(format!("connect_client failed: {e}"))
+    })?;
+
+    let segments = io_segmenter::segment_io(start_lba, aligned_bytes, chunk_size as u32, block_size as u32);
+
+    for seg in &segments {
+        // Create a non-owning sub-DmaBuffer view into the registered GPU memory at the chunk offset.
+        // SAFETY: gpu_dma_buf covers aligned_bytes registered with SPDK;
+        //         seg.buffer_offset + seg.length <= aligned_bytes.
+        let sub_ptr = unsafe { (gpu_dma_buf.as_ptr() as *mut u8).add(seg.buffer_offset) };
+        let sub_buf = unsafe {
+            DmaBuffer::from_raw(
+                sub_ptr as *mut std::ffi::c_void,
+                seg.length,
+                p2p_noop_free,
+                numa_node,
+            )
+        }
+        .map_err(|e| DispatcherError::AllocationFailed(format!("p2p sub-buffer: {e}")))?;
+
+        let sub_buf_arc = std::sync::Arc::new(std::sync::Mutex::new(sub_buf));
+
+        channels
+            .command_tx
+            .send(Command::ReadSync {
+                ns_id: 1,
+                lba: seg.lba,
+                buf: sub_buf_arc.clone(),
+            })
+            .map_err(|_| DispatcherError::IoError("p2p send ReadSync failed".into()))?;
+
+        match channels.completion_rx.recv() {
+            Ok(Completion::ReadDone { result, .. }) => {
+                result.map_err(|e| {
+                    DispatcherError::IoError(format!("p2p SSD read failed: {e}"))
+                })?;
+            }
+            Ok(other) => {
+                return Err(DispatcherError::IoError(format!(
+                    "p2p unexpected completion: {other:?}"
+                )));
+            }
+            Err(_) => {
+                return Err(DispatcherError::IoError(
+                    "p2p completion channel disconnected".into(),
+                ));
+            }
+        }
+        // sub_buf_arc drops here; p2p_noop_free ensures the parent GPU memory is not freed.
+    }
+
+    // gpu_dma_buf drops here: SPDK unregisters GPU memory + IPC handle closed.
+    // Data is already in the client's GPU allocation (gpu_dma_buf.as_ptr() == client GPU base).
+    Ok(())
+}
+
+// noop_free for sub-buffer DmaBuffer views into parent-owned GPU memory.
+unsafe extern "C" fn p2p_noop_free(_ptr: *mut std::ffi::c_void) {}
+
