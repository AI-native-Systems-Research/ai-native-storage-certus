+/// Pipelined bounce with single channel reuse and synchronous cudaMemcpy.
+/// Isolates async overlap contribution: same structure but blocks on each H2D copy.
+fn handle_bounce_pipelined_sync(
+    stream: &mut UnixStream,
+    ctx: &ServerContext,
+    chunk_size: usize,
+) -> Result<String, String> {
+    let (ipc_handle_bytes, size) = parse_client_payload(stream)?;
+    let client_dev_ptr = open_ipc_handle(&ipc_handle_bytes)?;
+
+    let num_chunks = (size + chunk_size - 1) / chunk_size;
+    let sectors_per_chunk = chunk_size / ctx.sector_size;
+
+    // Double-buffer: 2 host DMA buffers.
+    let buf_a = Arc::new(Mutex::new(
+        interfaces::DmaBuffer::new(chunk_size, ctx.sector_size, None)
+            .map_err(|e| format!("DMA alloc buf_a: {e}"))?,
+    ));
+    let buf_b = Arc::new(Mutex::new(
+        interfaces::DmaBuffer::new(chunk_size, ctx.sector_size, None)
+            .map_err(|e| format!("DMA alloc buf_b: {e}"))?,
+    ));
+
+    // Connect client once — reused for all ReadAsync commands.
+    let ibd = query::<dyn IBlockDevice + Send + Sync>(&*ctx.block_dev)
+        .ok_or("IBlockDevice query failed".to_string())?;
+    let channels = match ibd.connect_client() {
+        Ok(ch) => ch,
+        Err(e) => {
+            unsafe { cuda_ffi::cudaIpcCloseMemHandle(client_dev_ptr) };
+            return Err(format!("connect_client: {e}"));
+        }
+    };
+
+    let bufs = [Arc::clone(&buf_a), Arc::clone(&buf_b)];
+
+    let t_total = std::time::Instant::now();
+    let t_read_start = std::time::Instant::now();
+
+    // Send first ReadAsync (chunk 0 → buf_a).
+    if let Err(e) = channels.command_tx.send(interfaces::Command::ReadAsync {
+        ns_id: ctx.ns_id,
+        lba: 0,
+        buf: Arc::clone(&bufs[0]),
+        timeout_ms: 5000,
+    }) {
+        unsafe { cuda_ffi::cudaIpcCloseMemHandle(client_dev_ptr) };
+        return Err(format!("ReadAsync send chunk 0: {e}"));
+    }
+
+    let mut total_copy_us: u128 = 0;
+    let mut pipeline_err: Option<String> = None;
+
+    for i in 1..=num_chunks {
+        let prev_buf_idx = (i - 1) % 2;
+
+        // Receive completion for chunk[i-1].
+        let recv_result = match channels.completion_rx.recv() {
+            Ok(interfaces::Completion::ReadDone { result, .. }) => {
+                result.map_err(|e| format!("NVMe read chunk {}: {e}", i - 1))
+            }
+            Ok(interfaces::Completion::Timeout { handle }) => {
+                Err(format!("NVMe read timeout chunk {} (handle {:?})", i - 1, handle))
+            }
+            Ok(other) => Err(format!("unexpected completion chunk {}: {other:?}", i - 1)),
+            Err(e) => Err(format!("recv chunk {}: {e}", i - 1)),
+        };
+        if let Err(e) = recv_result {
+            pipeline_err = Some(e);
+            break;
+        }
+
+        // Send ReadAsync for chunk[i] before blocking copy (provides read-ahead).
+        if i < num_chunks {
+            let next_buf_idx = i % 2;
+            let next_lba = (i as u64) * (sectors_per_chunk as u64);
+            if let Err(e) = channels.command_tx.send(interfaces::Command::ReadAsync {
+                ns_id: ctx.ns_id,
+                lba: next_lba,
+                buf: Arc::clone(&bufs[next_buf_idx]),
+                timeout_ms: 5000,
+            }) {
+                pipeline_err = Some(format!("ReadAsync send chunk {i}: {e}"));
+                break;
+            }
+        }
+
+        // Synchronous H2D copy of chunk[i-1] — blocks CPU.
+        let t_copy = std::time::Instant::now();
+        let offset = (i - 1) * chunk_size;
+        let this_chunk = std::cmp::min(chunk_size, size - offset);
+        let src_ptr = {
+            let g = bufs[prev_buf_idx].lock().unwrap();
+            g.as_ptr() as *const c_void
+        };
+        let copy_err = unsafe {
+            cuda_ffi::cudaMemcpy(
+                (client_dev_ptr as *mut u8).add(offset) as *mut c_void,
+                src_ptr,
+                this_chunk,
+                cuda_ffi::CUDA_MEMCPY_HOST_TO_DEVICE,
+            )
+        };
+        total_copy_us += t_copy.elapsed().as_micros();
+
+        if copy_err != cuda_ffi::CUDA_SUCCESS {
+            pipeline_err = Some(format!(
+                "cudaMemcpy chunk {}: {}",
+                i - 1,
+                cuda_ffi::cuda_error_string(copy_err)
+            ));
+            break;
+        }
+    }
+
+    let read_us = t_read_start.elapsed().as_micros();
+
+    unsafe { cuda_ffi::cudaIpcCloseMemHandle(client_dev_ptr) };
+
+    if let Some(e) = pipeline_err {
+        return Err(e);
+    }
+
+    let total_us = t_total.elapsed().as_micros();
+
+    Ok(format!(
+        "OK {} bytes (bounce-pipelined-sync, {} chunks) read_us={} copy_us={} total_us={}",
+        size, num_chunks, read_us, total_copy_us, total_us
+    ))
+}
