+/// Read from SSD directly into a pre-registered GPU DmaBuffer using BatchSubmit + ReadAsync (P2P+parallel path).
+///
+/// Submits all NVMe read commands simultaneously via BatchSubmit, allowing the NVMe
+/// controller to exploit internal flash parallelism at QD=32 for a 4 MiB object.
+/// Then collects all 32 ReadDone completions.
+///
+/// # Safety
+///
+/// - `channels` must be a valid ClientChannels for the NVMe block device.
+/// - `gpu_dma_buf` must be a DmaBuffer registered with SPDK via `prepare_memory_for_spdk`.
+/// - `gpu_dma_buf.len()` must be at least `total_bytes` (aligned up to block size).
+pub unsafe fn p2p_batch_ssd_to_gpu(
+    channels: &ClientChannels,
+    gpu_dma_buf: &DmaBuffer,
+    start_lba: u64,
+    total_bytes: usize,
+    block_size: u32,
+    chunk_size: u32,
+    numa_node: i32,
+) -> Result<(), DispatcherError> {
+    let block_size_usize = block_size as usize;
+    let aligned_bytes = total_bytes.next_multiple_of(block_size_usize);
+
+    let segments = io_segmenter::segment_io(start_lba, aligned_bytes, chunk_size, block_size);
+
+    let base_ptr = gpu_dma_buf.as_ptr() as *mut u8;
+    let n = segments.len();
+
+    // Create sub-buffer views for each segment — one per 128 KiB chunk offset.
+    let mut sub_bufs: Vec<Arc<Mutex<DmaBuffer>>> = Vec::with_capacity(n);
+    for seg in &segments {
+        // SAFETY: base_ptr + seg.buffer_offset is within the SPDK-registered GPU region.
+        let sub_ptr = unsafe { base_ptr.add(seg.buffer_offset) } as *mut std::ffi::c_void;
+        let sub_buf = unsafe {
+            DmaBuffer::from_raw(sub_ptr, seg.length, noop_free_pipeline, numa_node)
+        }
+        .map_err(|e| DispatcherError::AllocationFailed(format!("P2P batch sub-buffer: {e}")))?;
+        sub_bufs.push(Arc::new(Mutex::new(sub_buf)));
+    }
+
+    // Build BatchSubmit with one ReadAsync per segment.
+    let ops: Vec<Command> = segments.iter().zip(sub_bufs.iter()).map(|(seg, buf)| {
+        Command::ReadAsync {
+            ns_id: 1,
+            lba: seg.lba,
+            buf: Arc::clone(buf),
+            timeout_ms: 5000,
+        }
+    }).collect();
+
+    channels
+        .command_tx
+        .send(Command::BatchSubmit { ops })
+        .map_err(|_| DispatcherError::IoError("send BatchSubmit (P2P) failed".into()))?;
+
+    // Collect all N completions.
+    for _ in 0..n {
+        match channels.completion_rx.recv() {
+            Ok(Completion::ReadDone { result, .. }) => {
+                result.map_err(|e| {
+                    DispatcherError::IoError(format!("SSD P2P batch read failed: {e}"))
+                })?;
+            }
+            Ok(other) => {
+                return Err(DispatcherError::IoError(format!(
+                    "unexpected P2P batch completion: {other:?}"
+                )));
+            }
+            Err(_) => {
+                return Err(DispatcherError::IoError(
+                    "P2P batch completion channel disconnected".into(),
+                ));
+            }
+        }
+    }
+
+    // noop_free_pipeline means drop is safe, but forget avoids any drop overhead.
+    for sub_buf in sub_bufs {
+        std::mem::forget(sub_buf);
+    }
+
+    Ok(())
+}
