+/// Read from SSD into ring buffers using BatchSubmit + ReadAsync, then copy to memory-tier and GPU.
+///
+/// Uses up to PIPELINE_RING_SIZE outstanding reads at a time (QD=4), giving NVMe
+/// some parallelism while reusing the existing ring buffer infrastructure.
+///
+/// # Safety
+///
+/// - `mem_tier_ptr` must be valid for writes of at least `total_bytes`.
+/// - `gpu_dst` must be a valid GPU destination pointer for `total_bytes`.
+pub unsafe fn pipelined_batch_ssd_to_gpu(
+    drive: &dyn IBlockDevice,
+    gpu: &dyn IGpuServices,
+    mem_tier_ptr: *mut u8,
+    gpu_dst: *mut std::ffi::c_void,
+    start_lba: u64,
+    total_bytes: usize,
+    numa_node: i32,
+) -> Result<(), DispatcherError> {
+    let block_size = drive.block_size() as usize;
+    let chunk_size = drive.max_transfer_size() as usize;
+    let aligned_bytes = total_bytes.next_multiple_of(block_size);
+
+    let channels: ClientChannels = drive.connect_client().map_err(|e| {
+        DispatcherError::IoError(format!("connect_client failed: {e}"))
+    })?;
+
+    let segments = io_segmenter::segment_io(start_lba, aligned_bytes, chunk_size as u32, block_size as u32);
+
+    // Allocate ring of DMA buffers (same as pipelined_ssd_to_gpu).
+    let ring: Vec<Arc<Mutex<DmaBuffer>>> = (0..PIPELINE_RING_SIZE.min(segments.len()))
+        .map(|_| {
+            DmaBuffer::new(chunk_size, block_size, Some(numa_node))
+                .map(|b| Arc::new(Mutex::new(b)))
+                .map_err(|e| {
+                    DispatcherError::AllocationFailed(format!("batch pipeline ring buffer: {e}"))
+                })
+        })
+        .collect::<Result<Vec<_>, _>>()?;
+
+    let batch_size = ring.len(); // QD = PIPELINE_RING_SIZE (4)
+
+    let mut seg_idx = 0;
+    while seg_idx < segments.len() {
+        let batch_end = (seg_idx + batch_size).min(segments.len());
+        let batch_segs = &segments[seg_idx..batch_end];
+
+        // Submit this batch of reads.
+        let ops: Vec<Command> = batch_segs.iter().enumerate().map(|(i, seg)| {
+            let ring_idx = (seg_idx + i) % ring.len();
+            Command::ReadAsync {
+                ns_id: 1,
+                lba: seg.lba,
+                buf: Arc::clone(&ring[ring_idx]),
+                timeout_ms: 5000,
+            }
+        }).collect();
+
+        channels
+            .command_tx
+            .send(Command::BatchSubmit { ops })
+            .map_err(|_| DispatcherError::IoError("send BatchSubmit (bounce) failed".into()))?;
+
+        // Collect completions and copy each chunk.
+        let mut completed = vec![false; batch_segs.len()];
+        for _ in 0..batch_segs.len() {
+            match channels.completion_rx.recv() {
+                Ok(Completion::ReadDone { result, .. }) => {
+                    result.map_err(|e| {
+                        DispatcherError::IoError(format!("SSD batch read failed: {e}"))
+                    })?;
+                    // Find the next uncompleted slot (completions may arrive out of order,
+                    // but we process them in submission order for copy correctness).
+                    for j in 0..batch_segs.len() {
+                        if !completed[j] {
+                            completed[j] = true;
+                            let seg = &batch_segs[j];
+                            let ring_idx = (seg_idx + j) % ring.len();
+                            let ring_buf = &ring[ring_idx];
+                            let copy_len = seg.length.min(total_bytes.saturating_sub(seg.buffer_offset));
+                            let guard = ring_buf.lock().unwrap();
+                            if copy_len > 0 {
+                                unsafe {
+                                    std::ptr::copy_nonoverlapping(
+                                        guard.as_ptr() as *const u8,
+                                        mem_tier_ptr.add(seg.buffer_offset),
+                                        copy_len,
+                                    );
+                                }
+                            }
+                            let gpu_offset = seg.buffer_offset;
+                            gpu.dma_copy_to_device(
+                                &guard,
+                                unsafe { (gpu_dst as *mut u8).add(gpu_offset) as *mut std::ffi::c_void },
+                                copy_len,
+                            ).map_err(|e| {
+                                DispatcherError::IoError(format!("GPU DMA copy (batch bounce) failed: {e}"))
+                            })?;
+                            drop(guard);
+                            break;
+                        }
+                    }
+                }
+                Ok(other) => {
+                    return Err(DispatcherError::IoError(format!(
+                        "unexpected batch bounce completion: {other:?}"
+                    )));
+                }
+                Err(_) => {
+                    return Err(DispatcherError::IoError(
+                        "batch bounce completion channel disconnected".into(),
+                    ));
+                }
+            }
+        }
+
+        seg_idx = batch_end;
+    }
+
+    Ok(())
+}
