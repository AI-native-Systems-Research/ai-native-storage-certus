+/// No-op free for P2P sub-buffer views — the parent GPU DmaBuffer owns the memory.
+unsafe extern "C" fn noop_free_pipeline(_ptr: *mut std::ffi::c_void) {}
+
+/// Read from SSD directly into a pre-registered GPU DmaBuffer using sequential ReadSync (P2P path).
+///
+/// Unlike `pipelined_ssd_to_gpu`, this does not copy to memory-tier and does not
+/// insert into the dispatch-map. The GPU DmaBuffer is a persistent SPDK-registered
+/// buffer cached across lookups via `IGpuServices::prepare_memory_for_spdk`.
+///
+/// Per-chunk sub-buffer views are created with `noop_free_pipeline` to avoid
+/// unregistering the parent buffer's SPDK IOMMU mapping.
+///
+/// # Safety
+///
+/// - `gpu_dma_buf` must be a DmaBuffer registered with SPDK via `prepare_memory_for_spdk`.
+/// - `gpu_dma_buf.len()` must be at least `total_bytes` (aligned up to block size).
+pub unsafe fn p2p_ssd_to_gpu_persistent(
+    drive: &dyn IBlockDevice,
+    gpu_dma_buf: &DmaBuffer,
+    start_lba: u64,
+    total_bytes: usize,
+    numa_node: i32,
+) -> Result<(), DispatcherError> {
+    let block_size = drive.block_size() as usize;
+    let chunk_size = drive.max_transfer_size() as usize;
+    let aligned_bytes = total_bytes.next_multiple_of(block_size);
+
+    let channels: ClientChannels = drive.connect_client().map_err(|e| {
+        DispatcherError::IoError(format!("connect_client failed: {e}"))
+    })?;
+
+    let segments = io_segmenter::segment_io(start_lba, aligned_bytes, chunk_size as u32, block_size as u32);
+
+    let base_ptr = gpu_dma_buf.as_ptr() as *mut u8;
+
+    for seg in &segments {
+        // Create a sub-buffer view into the GPU DmaBuffer at the segment offset.
+        // noop_free_pipeline prevents unregistering the parent buffer's SPDK IOMMU mapping.
+        // SAFETY: base_ptr + seg.buffer_offset is within the SPDK-registered GPU region.
+        let sub_ptr = unsafe { base_ptr.add(seg.buffer_offset) } as *mut std::ffi::c_void;
+        let sub_buf = unsafe {
+            DmaBuffer::from_raw(sub_ptr, seg.length, noop_free_pipeline, numa_node)
+        }
+        .map_err(|e| DispatcherError::AllocationFailed(format!("P2P sub-buffer view: {e}")))?;
+
+        let sub_buf = Arc::new(Mutex::new(sub_buf));
+
+        channels
+            .command_tx
+            .send(Command::ReadSync {
+                ns_id: 1,
+                lba: seg.lba,
+                buf: Arc::clone(&sub_buf),
+            })
+            .map_err(|_| DispatcherError::IoError("send ReadSync (P2P) failed".into()))?;
+
+        match channels.completion_rx.recv() {
+            Ok(Completion::ReadDone { result, .. }) => {
+                result.map_err(|e| {
+                    DispatcherError::IoError(format!("SSD P2P read failed: {e}"))
+                })?;
+            }
+            Ok(other) => {
+                return Err(DispatcherError::IoError(format!(
+                    "unexpected P2P completion: {other:?}"
+                )));
+            }
+            Err(_) => {
+                return Err(DispatcherError::IoError(
+                    "P2P completion channel disconnected".into(),
+                ));
+            }
+        }
+
+        drop(sub_buf);
+    }
+
+    Ok(())
+}
