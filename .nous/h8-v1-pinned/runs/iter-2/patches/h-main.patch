+        // Create a sub-buffer view into the GPU DMA buffer at the segment offset.
+        // SAFETY: gpu_base + seg.buffer_offset is within the GPU DMA buffer.
+        let sub_ptr = unsafe { gpu_base.add(seg.buffer_offset) } as *mut std::ffi::c_void;
+        let sub_len = seg.length.next_multiple_of(block_size);
+        // SAFETY: sub_ptr is valid for sub_len bytes within the SPDK-registered GPU buffer.
+        let sub_buf = unsafe {
+            DmaBuffer::from_raw(sub_ptr, sub_len, p2p_noop_free, numa_node)
+        }
+        .map_err(|e| DispatcherError::IoError(format!("p2p sub-buffer wrap failed: {e}")))?;
+
+        let sub_arc = Arc::new(Mutex::new(sub_buf));
+
+        channels
+            .command_tx
+            .send(Command::ReadSync {
+                ns_id: 1,
+                lba: seg.lba,
+                buf: Arc::clone(&sub_arc),
+            })
+            .map_err(|_| DispatcherError::IoError("p2p send ReadSync failed".into()))?;
+
+        match channels.completion_rx.recv() {
+            Ok(Completion::ReadDone { result, .. }) => {
+                result.map_err(|e| {
+                    DispatcherError::IoError(format!("p2p SSD read failed: {e}"))
+                })?;
+            }
+            Ok(other) => {
+                return Err(DispatcherError::IoError(format!(
+                    "p2p unexpected completion: {other:?}"
+                )));
+            }
+            Err(_) => {
+                return Err(DispatcherError::IoError(
+                    "p2p completion channel disconnected".into(),
+                ));
+            }
+        }
+
+        // Prevent drop glue from calling free on GPU memory.
+        // SAFETY: sub_arc holds the only reference; the GPU buffer is owned by gpu_dma_buf.
+        let sub = Arc::try_unwrap(sub_arc)
+            .expect("no other Arc refs")
+            .into_inner()
+            .unwrap();
+        std::mem::forget(sub);
+    }
+
+    Ok(())
+}
