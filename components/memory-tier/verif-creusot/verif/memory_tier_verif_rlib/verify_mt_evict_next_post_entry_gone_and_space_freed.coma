let mt_oldest_keys (st: MutBorrow.t t_StateModel) (n: UInt64.t) (return (x: t_Vec_u64_Global)) =
{[@stop_split] [@expl:mt_oldest_keys requires] [%#slib'28] mt_inv st.current}
  any
  [ return (result: t_Vec_u64_Global) ->
  {[@stop_split] [@expl:mt_oldest_keys ensures] ([@stop_split] [@expl:mt_oldest_keys ensures #0] [%#slib'29] refresh_frame st.current st.final)
    /\ ([@stop_split] [@expl:mt_oldest_keys ensures #1] [%#slib'30] st.final.policy.tracked = st.current.policy.tracked)
    /\ ([@stop_split] [@expl:mt_oldest_keys ensures #2] [%#slib'31] mt_inv st.final)
    /\ ([@stop_split] [@expl:mt_oldest_keys ensures #3] [%#slib'32] forall i: int. 0 <= i
          /\ i < Seq.length (view_Vec_u64_Global result)
        -> tracks (view_Vec_tup2_u64_u64_Global st.current.policy.tracked) (Seq.get (view_Vec_u64_Global result) i))
    /\ ([@stop_split] [@expl:mt_oldest_keys ensures #4] [%#slib'33] forall i: int. 0 <= i
          /\ i < Seq.length (view_Vec_u64_Global result)
        -> Seq.get (view_Vec_u64_Global result) i
        = (Seq.get (view_Vec_tup2_u64_u64_Global st.current.policy.tracked) i).f0)
    /\ ([@stop_split] [@expl:mt_oldest_keys ensures #5] [%#slib'34] st.current.initialized
        /\ UInt64.t'int n > 0 /\ Seq.length (view_Vec_tup2_u64_u64_Global st.current.policy.tracked) > 0
      -> Seq.length (view_Vec_u64_Global result) >= 1)
    /\ ([@stop_split] [@expl:mt_oldest_keys ensures #6] [%#slib'35] Seq.length (view_Vec_u64_Global result)
      <= UInt64.t'int n)
    /\ ([@stop_split] [@expl:mt_oldest_keys ensures #7] [%#slib'36] not st.current.initialized
      -> Seq.length (view_Vec_u64_Global result) = 0)
    /\ ([@stop_split] [@expl:mt_oldest_keys ensures #8] [%#slib'37] not st.current.initialized -> st.final = st.current)
    /\ ([@stop_split] [@expl:mt_oldest_keys ensures #9] [%#slib'38] slot_stable (view_Vec_SlotModel_Global st.current.slots) (view_Vec_SlotModel_Global st.final.slots))
    /\ ([@stop_split] [@expl:mt_oldest_keys ensures #10] [%#slib'39] st.current.initialized /\ UInt64.t'int n > 0
      -> Seq.length (view_Vec_u64_Global result)
      = (if UInt64.t'int n < Seq.length (view_Vec_tup2_u64_u64_Global st.current.policy.tracked) then
        UInt64.t'int n
      else
        Seq.length (view_Vec_tup2_u64_u64_Global st.current.policy.tracked)
      ))
    /\ ([@stop_split] [@expl:mt_oldest_keys ensures #11] [%#slib'40] UInt64.t'int n = 0
      -> view_Vec_u64_Global result = (Seq.empty: Seq.seq UInt64.t) /\ st.final = st.current)
    /\ ([@stop_split] [@expl:mt_oldest_keys ensures #12] [%#slib'41] not st.current.initialized
      -> view_Vec_u64_Global result = (Seq.empty: Seq.seq UInt64.t))
    /\ ([@stop_split] [@expl:mt_oldest_keys ensures #13] [%#slib'42] st.current.initialized /\ UInt64.t'int n > 0
    -> st.final.policy.last_pool = st.current.pool_id)}
    (! return {result}) ]

let mt_used (st: t_StateModel) (return (x: UInt64.t)) = {[@stop_split] [@expl:mt_used requires] [%#slib'43] mt_inv st}
  any
  [ return (result: UInt64.t) ->
