    <= UInt64.t'int const_MAX

let policy_candidates (p: MutBorrow.t t_PolicyModel) (pool: UInt64.t) (n: UInt64.t) (return (x: t_Vec_u64_Global)) = any
  [ return (result: t_Vec_u64_Global) ->
  {[@stop_split] [@expl:policy_candidates ensures] ([@stop_split] [@expl:policy_candidates ensures #0] [%#slib'17] p.final.tracked
      = p.current.tracked)
    /\ ([@stop_split] [@expl:policy_candidates ensures #1] [%#slib'18] p.final.next_handle = p.current.next_handle)
    /\ ([@stop_split] [@expl:policy_candidates ensures #2] [%#slib'19] p.final.pools = p.current.pools)
    /\ ([@stop_split] [@expl:policy_candidates ensures #3] [%#slib'20] p.final.last_pool = pool)
    /\ ([@stop_split] [@expl:policy_candidates ensures #4] [%#slib'21] Seq.length (view_Vec_u64_Global result)
      <= UInt64.t'int n)
    /\ ([@stop_split] [@expl:policy_candidates ensures #5] [%#slib'22] forall i: int. 0 <= i
          /\ i < Seq.length (view_Vec_u64_Global result)
        -> tracks (view_Vec_tup2_u64_u64_Global p.current.tracked) (Seq.get (view_Vec_u64_Global result) i))
    /\ ([@stop_split] [@expl:policy_candidates ensures #6] [%#slib'23] forall i: int. 0 <= i
          /\ i < Seq.length (view_Vec_u64_Global result)
        -> Seq.get (view_Vec_u64_Global result) i = (Seq.get (view_Vec_tup2_u64_u64_Global p.current.tracked) i).f0)
    /\ ([@stop_split] [@expl:policy_candidates ensures #7] [%#slib'24] Seq.length (view_Vec_u64_Global result)
    = (if UInt64.t'int n < Seq.length (view_Vec_tup2_u64_u64_Global p.current.tracked) then
      UInt64.t'int n
    else
      Seq.length (view_Vec_tup2_u64_u64_Global p.current.tracked)
    ))}
    (! return {result}) ]

predicate resolve_refmut_PolicyModel [@inline:trivial] (_1: MutBorrow.t t_PolicyModel) = _1.final = _1.current

meta "rewrite_def" predicate resolve_refmut_PolicyModel

let new_u64 (return (x: t_Vec_u64_Global)) = any
  [ return (result: t_Vec_u64_Global) ->
  {[@stop_split] [@expl:new ensures] [%#svec] Seq.length (view_Vec_u64_Global result) = 0}
