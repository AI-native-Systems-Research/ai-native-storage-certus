predicate resolve_refmut_LogSink [@inline:trivial] (_1: MutBorrow.t t_LogSink) = _1.final = _1.current

meta "rewrite_def" predicate resolve_refmut_LogSink

predicate resolve_refmut_MmapLog [@inline:trivial] (_1: MutBorrow.t t_MmapLog) = _1.final = _1.current

