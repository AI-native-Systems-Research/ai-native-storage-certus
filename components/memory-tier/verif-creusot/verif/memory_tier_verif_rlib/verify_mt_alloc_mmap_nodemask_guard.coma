use creusot.int.UInt64
use creusot.int.Int32
use creusot.prelude.MutBorrow
use creusot.int.Int64
use creusot.prelude.Any
use int.Int

type t_LogSink = { lines: UInt64.t }

type t_Option_i32 = None | Some Int32.t

type t_MmapLog = {
  huge_calls: UInt64.t;
  plain_calls: UInt64.t;
  mbind_issued: bool;
  mbind_mask: UInt64.t;
  mbind_maxnode: UInt64.t;
  mbind_node: UInt64.t }

type t_MtError = InvalidSize | NotInitialized | AlreadyExists | PoolFull | KeyNotFound | AllocationFailed | NotEvictable

type t_Result_usize_MtError = Ok UInt64.t | Err t_MtError

constant const_MAX: UInt64.t = (18446744073709551615: UInt64.t)

constant const_MAP_FAILED: UInt64.t = [%#slib'23] (18446744073709551615: UInt64.t)

constant const_C_ULONG_BITS: UInt64.t = [%#slib'24] (64: UInt64.t)

let alloc_mmap_m (pool_size: UInt64.t) (numa: t_Option_i32) (r_huge: UInt64.t) (r_plain: UInt64.t) (rc: Int64.t)
  (ml: MutBorrow.t t_MmapLog) (lg: MutBorrow.t t_LogSink) (connected: bool) (return (x: t_Result_usize_MtError)) =
{[@stop_split] [@expl:alloc_mmap_m requires] [%#slib'10] UInt64.t'int ml.current.huge_calls < UInt64.t'int const_MAX
  /\ UInt64.t'int ml.current.plain_calls < UInt64.t'int const_MAX}
  any
  [ return (result: t_Result_usize_MtError) ->
  {[@stop_split] [@expl:alloc_mmap_m ensures] ([@stop_split] [@expl:alloc_mmap_m ensures #0] [%#slib'11] UInt64.t'int ml.final.huge_calls
      = UInt64.t'int ml.current.huge_calls + 1)
    /\ ([@stop_split] [@expl:alloc_mmap_m ensures #1] [%#slib'12] UInt64.t'int ml.final.plain_calls
      = UInt64.t'int ml.current.plain_calls + (if r_huge = const_MAP_FAILED then 1 else 0))
    /\ ([@stop_split] [@expl:alloc_mmap_m ensures #2] [%#slib'13] r_huge <> const_MAP_FAILED -> result = Ok r_huge)
    /\ ([@stop_split] [@expl:alloc_mmap_m ensures #3] [%#slib'14] r_huge = const_MAP_FAILED
        /\ r_plain <> const_MAP_FAILED -> result = Ok r_plain)
    /\ ([@stop_split] [@expl:alloc_mmap_m ensures #4] [%#slib'15] r_huge = const_MAP_FAILED
        /\ r_plain = const_MAP_FAILED -> result = Err (AllocationFailed))
    /\ ([@stop_split] [@expl:alloc_mmap_m ensures #5] [%#slib'16] match result with
        | Ok p -> p <> const_MAP_FAILED
        | Err e -> e = AllocationFailed
        end)
    /\ ([@stop_split] [@expl:alloc_mmap_m ensures #6] [%#slib'17] match result with
        | Ok _ -> true
        | Err _ -> ml.final.mbind_issued = ml.current.mbind_issued
        /\ ml.final.mbind_mask = ml.current.mbind_mask
        /\ ml.final.mbind_maxnode = ml.current.mbind_maxnode /\ ml.final.mbind_node = ml.current.mbind_node
        end)
    /\ ([@stop_split] [@expl:alloc_mmap_m ensures #7] [%#slib'18] forall n: Int32.t. numa = Some n
          /\ Int32.to_int n >= 0 /\ result <> Err (AllocationFailed)
        -> ml.final.mbind_issued
        /\ UInt64.t'int ml.final.mbind_node = Int32.to_int n
        /\ UInt64.t'int ml.final.mbind_maxnode = Int32.to_int n + 2
        /\ (Int32.to_int n >= UInt64.t'int const_C_ULONG_BITS -> UInt64.t'int ml.final.mbind_mask = 0))
    /\ ([@stop_split] [@expl:alloc_mmap_m ensures #8] [%#slib'19] forall n: Int32.t. numa = None
          \/ numa = Some n /\ Int32.to_int n < 0
        -> ml.final.mbind_issued = ml.current.mbind_issued
        /\ ml.final.mbind_mask = ml.current.mbind_mask
        /\ ml.final.mbind_maxnode = ml.current.mbind_maxnode /\ ml.final.mbind_node = ml.current.mbind_node)
    /\ ([@stop_split] [@expl:alloc_mmap_m ensures #9] [%#slib'20] not connected -> lg.final = lg.current)
    /\ ([@stop_split] [@expl:alloc_mmap_m ensures #10] [%#slib'21] numa = None -> lg.final = lg.current)
    /\ ([@stop_split] [@expl:alloc_mmap_m ensures #11] [%#slib'22] forall n: Int32.t. numa = Some n
        /\ Int32.to_int n < 0 -> lg.final = lg.current)}
