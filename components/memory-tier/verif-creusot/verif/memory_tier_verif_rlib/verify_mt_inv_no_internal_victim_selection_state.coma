    <= UInt64.t'int const_MAX

type t_Vec_u64_Global

type t_Region = { offset'0: UInt64.t; size'0: UInt64.t }

predicate offsets_aligned [#"/home/cornel/fv-runs/j11-memory-tier/components/memory-tier/verif-creusot/src/lib.rs" 72 0 72 46] (r: Seq.seq t_Region) =
  [%#slib'78] forall i: int. 0 <= i /\ i < Seq.length r
    -> ComputerDivision.mod (UInt64.t'int (Seq.get r i).offset'0) 4096 = 0

predicate disjoint_sorted [#"/home/cornel/fv-runs/j11-memory-tier/components/memory-tier/verif-creusot/src/lib.rs" 88 0 88 46] (r: Seq.seq t_Region) =
  [%#slib'79] (forall i: int. 0 <= i /\ i < Seq.length r -> UInt64.t'int (Seq.get r i).size'0 > 0)
  /\ (forall i: int. 0 <= i /\ i + 1 < Seq.length r
    -> UInt64.t'int (Seq.get r i).offset'0 + UInt64.t'int (Seq.get r i).size'0
    <= UInt64.t'int (Seq.get r (i + 1)).offset'0)

predicate disj_all [#"/home/cornel/fv-runs/j11-memory-tier/components/memory-tier/verif-creusot/src/lib.rs" 223 0 223 39] (r: Seq.seq t_Region) =
  [%#slib'80] forall i: int, j: int. 0 <= i /\ i < j /\ j < Seq.length r
    -> UInt64.t'int (Seq.get r i).offset'0 + UInt64.t'int (Seq.get r i).size'0 <= UInt64.t'int (Seq.get r j).offset'0

predicate sorted_by_offset [#"/home/cornel/fv-runs/j11-memory-tier/components/memory-tier/verif-creusot/src/lib.rs" 78 0 78 47] (r: Seq.seq t_Region) =
  [%#slib'81] forall i: int, j: int. 0 <= i /\ i < j /\ j < Seq.length r
    -> UInt64.t'int (Seq.get r i).offset'0 < UInt64.t'int (Seq.get r j).offset'0

predicate no_adj [#"/home/cornel/fv-runs/j11-memory-tier/components/memory-tier/verif-creusot/src/lib.rs" 246 0 246 37] (r: Seq.seq t_Region) =
  [%#slib'82] forall i: int. 0 <= i /\ i + 1 < Seq.length r
    -> UInt64.t'int (Seq.get r i).offset'0 + UInt64.t'int (Seq.get r i).size'0
    < UInt64.t'int (Seq.get r (i + 1)).offset'0

predicate fl_inv [#"/home/cornel/fv-runs/j11-memory-tier/components/memory-tier/verif-creusot/src/lib.rs" 872 0 872 52] (r: Seq.seq t_Region) (capacity'0: int) =
  [%#slib'70] offsets_aligned r
  /\ disjoint_sorted r
  /\ (forall i: int. 0 <= i /\ i < Seq.length r
      -> UInt64.t'int (Seq.get r i).offset'0 + UInt64.t'int (Seq.get r i).size'0 <= capacity'0)
  /\ disj_all r /\ sorted_by_offset r /\ no_adj r

function view_Vec_Region_Global (self: t_Vec_Region_Global) : Seq.seq t_Region

axiom view_Vec_Region_Global_spec:
  forall self: t_Vec_Region_Global [view_Vec_Region_Global self]. [%#svec] Seq.length (view_Vec_Region_Global self)
    <= UInt64.t'int const_MAX

predicate policy_keys_unique [#"/home/cornel/fv-runs/j11-memory-tier/components/memory-tier/verif-creusot/src/lib.rs" 846 0 846 53] (t: Seq.seq tup2_u64_u64) =
  [%#slib'77] forall i: int, j: int. 0 <= i /\ i < j /\ j < Seq.length t -> (Seq.get t i).f0 <> (Seq.get t j).f0

predicate slot_keys_unique [#"/home/cornel/fv-runs/j11-memory-tier/components/memory-tier/verif-creusot/src/lib.rs" 853 0 853 50] (s: Seq.seq t_SlotModel) =
  [%#slib'83] forall i: int, j: int. 0 <= i /\ i < j /\ j < Seq.length s -> (Seq.get s i).key <> (Seq.get s j).key

predicate key_inv [#"/home/cornel/fv-runs/j11-memory-tier/components/memory-tier/verif-creusot/src/lib.rs" 887 0 887 38] (st: t_StateModel) =
