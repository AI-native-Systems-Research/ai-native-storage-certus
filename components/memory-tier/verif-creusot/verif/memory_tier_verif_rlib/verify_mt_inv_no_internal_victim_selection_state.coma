predicate init_inv [#"/home/cornel/fv-runs/j11-memory-tier/components/memory-tier/verif-creusot/src/lib.rs" 909 0 909 39] (st: t_StateModel) =
  [%#slib'72] (st.initialized
    -> ComputerDivision.mod (UInt64.t'int st.pool_base) 4096 = 0
    /\ UInt64.t'int st.pool_base > 0
    /\ UInt64.t'int st.pool_size > 0
    /\ UInt64.t'int st.pool_base + UInt64.t'int st.allocator.capacity <= UInt64.t'int const_MAX
    /\ UInt64.t'int st.allocator.capacity = UInt64.t'int st.pool_size)
  /\ (not st.initialized
  -> Seq.length (view_Vec_SlotModel_Global st.slots) = 0
  /\ Seq.length (view_Vec_tup2_u64_u64_Global st.policy.tracked) = 0)

predicate slot_inv [#"/home/cornel/fv-runs/j11-memory-tier/components/memory-tier/verif-creusot/src/lib.rs" 897 0 897 57] (s: Seq.seq t_SlotModel) (capacity'0: int) =
  [%#slib'73] forall i: int. 0 <= i /\ i < Seq.length s
    -> ComputerDivision.mod (UInt64.t'int (Seq.get s i).offset) 4096 = 0
    /\ UInt64.t'int (Seq.get s i).offset + UInt32.t'int (Seq.get s i).size <= capacity'0

function align_up_l [#"/home/cornel/fv-runs/j11-memory-tier/components/memory-tier/verif-creusot/src/lib.rs" 33 0 33 35] (size'1: int) : int
 = [%#slib'75] (ComputerDivision.div (size'1 - 1) 4096 + 1) * 4096

function slot_sum [#"/home/cornel/fv-runs/j11-memory-tier/components/memory-tier/verif-creusot/src/lib.rs" 930 0 930 41] (s: Seq.seq t_SlotModel) : int

axiom slot_sum_def: forall s: Seq.seq t_SlotModel [slot_sum s]. slot_sum s
    = ([%#slib'85] if Seq.length s <= 0 then
      0
    else
