use seq.Seq
use creusot.int.UInt64
use creusot.prelude.MutBorrow
use creusot.int.UInt32
use int.ComputerDivision
use creusot.prelude.Any
use int.Int

type t_Vec_tup2_u64_u64_Global

type tup2_u64_u64 = { f0: UInt64.t; f1: UInt64.t }

constant const_MAX: UInt64.t = (18446744073709551615: UInt64.t)

function view_Vec_tup2_u64_u64_Global (self: t_Vec_tup2_u64_u64_Global) : Seq.seq tup2_u64_u64

axiom view_Vec_tup2_u64_u64_Global_spec:
  forall self: t_Vec_tup2_u64_u64_Global [view_Vec_tup2_u64_u64_Global self]. [%#svec'0] Seq.length (view_Vec_tup2_u64_u64_Global self)
    <= UInt64.t'int const_MAX

let new_tup2_u64_u64 (return (x: t_Vec_tup2_u64_u64_Global)) = any
