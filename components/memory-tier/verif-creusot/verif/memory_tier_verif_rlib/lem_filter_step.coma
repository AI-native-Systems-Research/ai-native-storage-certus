use creusot.int.UInt64
use seq.Seq
use creusot.int.UInt32
use int.Int

type t_SlotModel = { key: UInt64.t; offset: UInt64.t; size: UInt32.t; handle: UInt64.t }

predicate slot_at [#"/home/cornel/fv-runs/apply-memory-tier-20261007/components/memory-tier/verif-creusot/src/lib.rs" 836 0 836 49] (s: Seq.seq t_SlotModel) (k: UInt64.t) =
  [%#slib'3] exists i: int. 0 <= i /\ i < Seq.length s /\ (Seq.get s i).key = k

function filter_l [#"/home/cornel/fv-runs/apply-memory-tier-20261007/components/memory-tier/verif-creusot/src/lib.rs" 1390 0 1390 60] (ks: Seq.seq UInt64.t) (s: Seq.seq t_SlotModel) : Seq.seq UInt64.t

axiom filter_l_def: forall ks: Seq.seq UInt64.t, s: Seq.seq t_SlotModel [filter_l ks s]. filter_l ks s
    = ([%#slib'2] if Seq.length ks <= 0 then
      Seq.empty: Seq.seq UInt64.t
    else
      if slot_at s (Seq.get ks (Seq.length ks - 1)) then
        Seq.snoc (filter_l (Seq.([..]) ks 0 (Seq.length ks - 1)) s) (Seq.get ks (Seq.length ks - 1))
      else
        filter_l (Seq.([..]) ks 0 (Seq.length ks - 1)) s
    
    )

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant ks : Seq.seq UInt64.t

constant s : Seq.seq t_SlotModel

constant i : int

function lem_filter_step [#"/home/cornel/fv-runs/apply-memory-tier-20261007/components/memory-tier/verif-creusot/src/lib.rs" 1416 0 1416 63] (ks: Seq.seq UInt64.t) (s: Seq.seq t_SlotModel) (i: int) : ()

goal vc_lem_filter_step: ([%#slib] 0 <= i /\ i < Seq.length ks)
  -> Seq.([..]) (Seq.([..]) ks 0 (i + 1)) 0 i = Seq.([..]) ks 0 i
  && ([@stop_split] [@expl:lem_filter_step ensures] [%#slib'0] filter_l (Seq.([..]) ks 0 (i + 1)) s
  = (if slot_at s (Seq.get ks i) then
    Seq.snoc (filter_l (Seq.([..]) ks 0 i) s) (Seq.get ks i)
  else
    filter_l (Seq.([..]) ks 0 i) s
  ))
