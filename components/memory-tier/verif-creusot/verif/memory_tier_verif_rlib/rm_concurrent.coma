let cs_remove (fl: MutBorrow.t t_FreeListModel) (slots'0: MutBorrow.t t_Vec_SlotModel_Global) (key'0: UInt64.t)
  (return (x: t_Result_unit_MtError)) =
{[@stop_split] [@expl:cs_remove requires] [%#slib'14] pool_inv fl.current (view_Vec_SlotModel_Global slots'0.current)}
  any
  [ return (result: t_Result_unit_MtError) ->
  {[@stop_split] [@expl:cs_remove ensures] ([@stop_split] [@expl:cs_remove ensures #0] [%#slib'15] pool_inv fl.final (view_Vec_SlotModel_Global slots'0.final))
    /\ ([@stop_split] [@expl:cs_remove ensures #1] [%#slib'16] fl.final.capacity = fl.current.capacity)
    /\ ([@stop_split] [@expl:cs_remove ensures #2] [%#slib'17] slot_at (view_Vec_SlotModel_Global slots'0.current) key'0
      -> result = Ok ())
    /\ ([@stop_split] [@expl:cs_remove ensures #3] [%#slib'18] not slot_at (view_Vec_SlotModel_Global slots'0.final) key'0)
    /\ ([@stop_split] [@expl:cs_remove ensures #4] [%#slib'19] forall k2: UInt64.t. k2 <> key'0
        -> slot_at (view_Vec_SlotModel_Global slots'0.final) k2
        = slot_at (view_Vec_SlotModel_Global slots'0.current) k2)
    /\ ([@stop_split] [@expl:cs_remove ensures #5] [%#slib'20] forall i: int. 0 <= i
          /\ i < Seq.length (view_Vec_SlotModel_Global slots'0.current)
          /\ (Seq.get (view_Vec_SlotModel_Global slots'0.current) i).key = key'0
        -> some_region_fits (view_Vec_Region_Global fl.final.regions) (align_up_l (UInt32.t'int (Seq.get (view_Vec_SlotModel_Global slots'0.current) i).size)))
    /\ ([@stop_split] [@expl:cs_remove ensures #6] [%#slib'21] result <> Ok ()
    -> view_Vec_SlotModel_Global slots'0.final = view_Vec_SlotModel_Global slots'0.current
    /\ view_Vec_Region_Global fl.final.regions = view_Vec_Region_Global fl.current.regions
    /\ fl.final.used = fl.current.used)}
    (! return {result}) ]

