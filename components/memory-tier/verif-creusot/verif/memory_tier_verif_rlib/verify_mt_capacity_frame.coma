  [ return (result: t_Vec_LkEv_Global) ->
  {[@stop_split] [@expl:lk_peek_or_contains ensures] ([@stop_split] [@expl:lk_peek_or_contains ensures #0] [%#slib'10] no_pool_write (view_Vec_LkEv_Global result)
