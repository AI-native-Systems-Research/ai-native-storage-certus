let verify_mt_capacity_frame [#"/home/cornel/fv-runs/j11-memory-tier/components/memory-tier/verif-creusot/src/lib.rs" 8788 0 8788 81]
  (st: MutBorrow.t t_StateModel) (return (x: tup3_usize_usize_Vec_LkEv_Global)) =
{[@stop_split] [@expl:verify_mt_capacity_frame requires] [%#slib'2] mt_inv st.current}
  (! bb0
  [ bb0 = s0
    [ s0 = mt_capacity [%#slib] {st.current} (fun (_x: UInt64.t) -> [ &c0 <- _x ] s1)
    | s1 = mt_capacity [%#slib'0] {st.current} (fun (_x: UInt64.t) -> [ &c1 <- _x ] s2)
    | s2 = -{resolve_refmut_StateModel st}- s3
    | s3 = lk_peek_or_contains [%#slib'1] {st.current.initialized} (fun (_x: t_Vec_LkEv_Global) -> [ &t <- _x ] s4)
    | s4 = [ &_ret <- { f0'0 = c0; f1'0 = c1; f2'0 = t } ] s5
    | s5 = return {_ret} ] ]
  [ & _ret: tup3_usize_usize_Vec_LkEv_Global = Any.any_l ()
  | & st: MutBorrow.t t_StateModel = st
  | & c0: UInt64.t = Any.any_l ()
  | & c1: UInt64.t = Any.any_l ()
  | & t: t_Vec_LkEv_Global = Any.any_l () ])
  [ return (result: tup3_usize_usize_Vec_LkEv_Global) ->
  {[@stop_split] [@expl:verify_mt_capacity_frame ensures] ([@stop_split] [@expl:verify_mt_capacity_frame ensures #0] [%#slib'3] st.final
      = st.current)
    /\ ([@stop_split] [@expl:verify_mt_capacity_frame ensures #1] [%#slib'4] result.f0'0 = result.f1'0)
    /\ ([@stop_split] [@expl:verify_mt_capacity_frame ensures #2] [%#slib'5] forall i: int. 0 <= i
          /\ i < Seq.length (view_Vec_LkEv_Global result.f2'0)
        -> Seq.get (view_Vec_LkEv_Global result.f2'0) i <> PolicyRefresh
        /\ Seq.get (view_Vec_LkEv_Global result.f2'0) i <> PolicyOther)
    /\ ([@stop_split] [@expl:verify_mt_capacity_frame ensures #3] [%#slib'6] no_pool_write (view_Vec_LkEv_Global result.f2'0))}
    (! return {result}) ]
