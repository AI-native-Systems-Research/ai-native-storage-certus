let mt_peek (st: t_StateModel) (key'0: UInt64.t) (return (x: t_Option_tup2_usize_u32)) =
{[@stop_split] [@expl:mt_peek requires] [%#slib'12] mt_inv st}
  any
  [ return (result: t_Option_tup2_usize_u32) ->
  {[@stop_split] [@expl:mt_peek ensures] ([@stop_split] [@expl:mt_peek ensures #0] [%#slib'13] forall p: UInt64.t, s: UInt32.t. result
          = Some { f0 = p; f1 = s } -> ComputerDivision.mod (UInt64.t'int p) 4096 = 0)
    /\ ([@stop_split] [@expl:mt_peek ensures #1] [%#slib'14] match result with
        | Some _ -> st.initialized
        | None -> true
        end)
    /\ ([@stop_split] [@expl:mt_peek ensures #2] [%#slib'15] st.initialized
        /\ slot_at (view_Vec_SlotModel_Global st.slots) key'0 -> result <> None)
    /\ ([@stop_split] [@expl:mt_peek ensures #3] [%#slib'16] not slot_at (view_Vec_SlotModel_Global st.slots) key'0
      -> result = None)
    /\ ([@stop_split] [@expl:mt_peek ensures #4] [%#slib'17] forall p: UInt64.t, s: UInt32.t. result
        = Some { f0 = p; f1 = s }
      -> (exists i: int. 0 <= i
        /\ i < Seq.length (view_Vec_SlotModel_Global st.slots)
        /\ (Seq.get (view_Vec_SlotModel_Global st.slots) i).key = key'0
        /\ UInt64.t'int p
          = UInt64.t'int st.pool_base + UInt64.t'int (Seq.get (view_Vec_SlotModel_Global st.slots) i).offset
        /\ s = (Seq.get (view_Vec_SlotModel_Global st.slots) i).size))}
    (! return {result}) ]

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let verify_mt_inv_four_kib_alignment [#"/home/cornel/fv-runs/j11-memory-tier/components/memory-tier/verif-creusot/src/lib.rs" 5377 0 5377 88]
  (st: t_StateModel) (k: UInt64.t) (return (x: t_Option_tup2_usize_u32)) =
{[@stop_split] [@expl:verify_mt_inv_four_kib_alignment requires] [%#slib'2] mt_inv st}
  (! bb0
  [ bb0 = s0
    [ s0 = [ &_12 <- [%#slib] lem_ss_aligned (view_Vec_SlotModel_Global st.slots) ] s1
    | s1 = {[@expl:assertion] [%#slib'0] UInt64.t'int st.allocator.used = slot_sum (view_Vec_SlotModel_Global st.slots)}
      s2
    | s2 = mt_peek [%#slib'1] {st} {k} (fun (_x: t_Option_tup2_usize_u32) -> [ &_ret <- _x ] s3)
    | s3 = return {_ret} ] ]
  [ & _ret: t_Option_tup2_usize_u32 = Any.any_l ()
  | & st: t_StateModel = st
