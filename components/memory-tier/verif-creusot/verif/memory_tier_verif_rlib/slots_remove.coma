axiom lem_ss_bound_spec: forall s: Seq.seq t_SlotModel. ([%#slib'65] forall j: int. 0 <= j /\ j < Seq.length s
        -> UInt32.t'int (Seq.get s j).size > 0) -> ([%#slib'66] slot_sum s >= 0)

axiom lem_ss_bound_spec'0: forall s: Seq.seq t_SlotModel. ([%#slib'65] forall j: int. 0 <= j /\ j < Seq.length s
