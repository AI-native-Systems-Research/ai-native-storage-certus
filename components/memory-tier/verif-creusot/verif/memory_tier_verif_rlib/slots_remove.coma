 = [%#slib'83] ()

axiom lem_al_spec: forall x: int. ([%#slib'76] x > 0) -> ([%#slib'77] ComputerDivision.mod (align_up_l x) 4096 = 0)

axiom lem_al_spec'0: forall x: int. ([%#slib'76] x > 0) -> ([%#slib'78] align_up_l x >= x)

axiom lem_al_spec'1: forall x: int. ([%#slib'76] x > 0) -> ([%#slib'79] align_up_l x >= 4096)

axiom lem_al_spec'2: forall x: int. ([%#slib'76] x > 0) -> ([%#slib'80] align_up_l x < x + 4096)

axiom lem_al_spec'3: forall x: int. ([%#slib'76] x > 0)
