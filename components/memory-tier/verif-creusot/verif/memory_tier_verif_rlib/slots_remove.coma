axiom lem_al_spec'4: forall x: int. ([%#slib'76] x > 0)
    -> ([%#slib'82] ComputerDivision.mod x 4096 <> 0 -> align_up_l x > x)

function lem_ss_bound [#"/home/cornel/fv-runs/apply-memory-tier-20261007/components/memory-tier/verif-creusot/src/lib.rs" 967 0 967 38] (s: Seq.seq t_SlotModel) : ()

