  any
  [ return (result: UInt64.t) ->
  {[@stop_split] [@expl:mt_used ensures] ([@stop_split] [@expl:mt_used ensures #0] [%#slib'17] st.initialized
      -> UInt64.t'int result = UInt64.t'int st.allocator.used)
    /\ ([@stop_split] [@expl:mt_used ensures #1] [%#slib'18] not st.initialized -> UInt64.t'int result = 0)}
    (! return {result}) ]

