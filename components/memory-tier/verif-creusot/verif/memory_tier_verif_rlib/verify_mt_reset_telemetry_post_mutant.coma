let mt_capacity (st: t_StateModel) (return (x: UInt64.t)) =
{[@stop_split] [@expl:mt_capacity requires] [%#slib'13] mt_inv st}
  any
  [ return (result: UInt64.t) ->
  {[@stop_split] [@expl:mt_capacity ensures] ([@stop_split] [@expl:mt_capacity ensures #0] [%#slib'14] st.initialized
      -> UInt64.t'int result = UInt64.t'int st.allocator.capacity)
    /\ ([@stop_split] [@expl:mt_capacity ensures #1] [%#slib'15] not st.initialized -> UInt64.t'int result = 0)}
    (! return {result}) ]

