let rx_call (st: MutBorrow.t t_StateModel) (op: UInt8.t) (key: UInt64.t) (size'1: UInt32.t) (connected: bool)
  (return (x: t_RxOutcome)) = {[@stop_split] [@expl:rx_call requires] [%#slib'6] mt_inv st.current
  /\ arith_ok st.current /\ not st.current.poisoned}
  any
  [ return (result: t_RxOutcome) ->
  {[@stop_split] [@expl:rx_call ensures] ([@stop_split] [@expl:rx_call ensures #0] [%#slib'7] mt_inv st.final)
    /\ ([@stop_split] [@expl:rx_call ensures #1] [%#slib'8] not connected
        /\ match result with
          | Panicked -> true
          | _ -> false
          end -> st.final = st.current)
    /\ ([@stop_split] [@expl:rx_call ensures #2] [%#slib'9] not connected /\ st.current.initialized
      -> match result with
        | Panicked -> UInt8.t'int op = 1 /\ UInt32.t'int size'1 > 0
        \/ UInt8.t'int op = 2
        \/ UInt8.t'int op = 4
        \/ UInt8.t'int op = 5
        \/ UInt8.t'int op = 6 /\ UInt32.t'int size'1 > 0
        \/ UInt8.t'int op = 7 \/ UInt8.t'int op = 8 \/ UInt8.t'int op = 14
        | Returned -> not (UInt8.t'int op = 1 /\ UInt32.t'int size'1 > 0
        \/ UInt8.t'int op = 2
        \/ UInt8.t'int op = 4
        \/ UInt8.t'int op = 5
        \/ UInt8.t'int op = 6 /\ UInt32.t'int size'1 > 0
        \/ UInt8.t'int op = 7 \/ UInt8.t'int op = 8 \/ UInt8.t'int op = 14)
        end)
    /\ ([@stop_split] [@expl:rx_call ensures #3] [%#slib'10] not connected /\ UInt8.t'int op = 9
      -> st.final = st.current
      /\ match result with
        | Returned -> true
        | _ -> false
        end)
    /\ ([@stop_split] [@expl:rx_call ensures #4] [%#slib'11] connected
      -> match result with
        | Returned -> true
        | _ -> false
        end)
    /\ ([@stop_split] [@expl:rx_call ensures #5] [%#slib'12] UInt8.t'int op = 3
      \/ UInt8.t'int op >= 10 /\ UInt8.t'int op <> 14 -> st.final = st.current)}
    (! return {result}) ]

