    /\ UInt64.t'int st.allocator.capacity = UInt64.t'int st.pool_size)
  /\ (not st.initialized
  -> Seq.length (view_Vec_SlotModel_Global st.slots) = 0
  /\ Seq.length (view_Vec_tup2_u64_u64_Global st.policy.tracked) = 0)

predicate slot_inv [#"/home/cornel/fv-runs/apply-memory-tier-20261007/components/memory-tier/verif-creusot/src/lib.rs" 897 0 897 57] (s: Seq.seq t_SlotModel) (capacity'0: int) =
