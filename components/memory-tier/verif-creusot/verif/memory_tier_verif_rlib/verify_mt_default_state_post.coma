use creusot.int.UInt64
use seq.Seq
use creusot.int.UInt32
use int.ComputerDivision
use creusot.prelude.MutBorrow
use creusot.prelude.Any
use int.Int

type t_Vec_tup2_u64_u64_Global

type t_PolicyModel = { tracked: t_Vec_tup2_u64_u64_Global; next_handle: UInt64.t; pools: UInt64.t; last_pool: UInt64.t }

type t_Vec_Region_Global

type t_FreeListModel = { regions: t_Vec_Region_Global; capacity: UInt64.t; used: UInt64.t }

type t_Vec_SlotModel_Global

type t_StateModel = {
  pool_base: UInt64.t;
  pool_size: UInt64.t;
  pool_id: UInt64.t;
  allocator: t_FreeListModel;
  slots: t_Vec_SlotModel_Global;
  initialized: bool;
  spdk_allocated: bool;
  poisoned: bool;
  policy: t_PolicyModel }

type tup2_u64_u64 = { f0: UInt64.t; f1: UInt64.t }

constant const_MAX: UInt64.t = (18446744073709551615: UInt64.t)

function view_Vec_tup2_u64_u64_Global (self: t_Vec_tup2_u64_u64_Global) : Seq.seq tup2_u64_u64

axiom view_Vec_tup2_u64_u64_Global_spec:
  forall self: t_Vec_tup2_u64_u64_Global [view_Vec_tup2_u64_u64_Global self]. [%#svec] Seq.length (view_Vec_tup2_u64_u64_Global self)
    <= UInt64.t'int const_MAX

type t_Region = { offset: UInt64.t; size: UInt64.t }

function view_Vec_Region_Global (self: t_Vec_Region_Global) : Seq.seq t_Region

axiom view_Vec_Region_Global_spec:
  forall self: t_Vec_Region_Global [view_Vec_Region_Global self]. [%#svec] Seq.length (view_Vec_Region_Global self)
    <= UInt64.t'int const_MAX

type t_SlotModel = { key'0: UInt64.t; offset'0: UInt64.t; size'0: UInt32.t; handle'0: UInt64.t }

function view_Vec_SlotModel_Global (self: t_Vec_SlotModel_Global) : Seq.seq t_SlotModel

axiom view_Vec_SlotModel_Global_spec:
  forall self: t_Vec_SlotModel_Global [view_Vec_SlotModel_Global self]. [%#svec] Seq.length (view_Vec_SlotModel_Global self)
    <= UInt64.t'int const_MAX

predicate offsets_aligned [#"/home/cornel/fv-runs/apply-memory-tier-20261007/components/memory-tier/verif-creusot/src/lib.rs" 72 0 72 46] (r: Seq.seq t_Region) =
  [%#slib'214] forall i: int. 0 <= i /\ i < Seq.length r
    -> ComputerDivision.mod (UInt64.t'int (Seq.get r i).offset) 4096 = 0

predicate disjoint_sorted [#"/home/cornel/fv-runs/apply-memory-tier-20261007/components/memory-tier/verif-creusot/src/lib.rs" 88 0 88 46] (r: Seq.seq t_Region) =
  [%#slib'215] (forall i: int. 0 <= i /\ i < Seq.length r -> UInt64.t'int (Seq.get r i).size > 0)
  /\ (forall i: int. 0 <= i /\ i + 1 < Seq.length r
    -> UInt64.t'int (Seq.get r i).offset + UInt64.t'int (Seq.get r i).size <= UInt64.t'int (Seq.get r (i + 1)).offset)

predicate disj_all [#"/home/cornel/fv-runs/apply-memory-tier-20261007/components/memory-tier/verif-creusot/src/lib.rs" 223 0 223 39] (r: Seq.seq t_Region) =
  [%#slib'216] forall i: int, j: int. 0 <= i /\ i < j /\ j < Seq.length r
    -> UInt64.t'int (Seq.get r i).offset + UInt64.t'int (Seq.get r i).size <= UInt64.t'int (Seq.get r j).offset

predicate sorted_by_offset [#"/home/cornel/fv-runs/apply-memory-tier-20261007/components/memory-tier/verif-creusot/src/lib.rs" 78 0 78 47] (r: Seq.seq t_Region) =
  [%#slib'217] forall i: int, j: int. 0 <= i /\ i < j /\ j < Seq.length r
    -> UInt64.t'int (Seq.get r i).offset < UInt64.t'int (Seq.get r j).offset

predicate no_adj [#"/home/cornel/fv-runs/apply-memory-tier-20261007/components/memory-tier/verif-creusot/src/lib.rs" 246 0 246 37] (r: Seq.seq t_Region) =
  [%#slib'218] forall i: int. 0 <= i /\ i + 1 < Seq.length r
    -> UInt64.t'int (Seq.get r i).offset + UInt64.t'int (Seq.get r i).size < UInt64.t'int (Seq.get r (i + 1)).offset

predicate fl_inv [#"/home/cornel/fv-runs/apply-memory-tier-20261007/components/memory-tier/verif-creusot/src/lib.rs" 872 0 872 52] (r: Seq.seq t_Region) (capacity'0: int) =
  [%#slib'199] offsets_aligned r
  /\ disjoint_sorted r
  /\ (forall i: int. 0 <= i /\ i < Seq.length r
      -> UInt64.t'int (Seq.get r i).offset + UInt64.t'int (Seq.get r i).size <= capacity'0)
  /\ disj_all r /\ sorted_by_offset r /\ no_adj r

predicate policy_keys_unique [#"/home/cornel/fv-runs/apply-memory-tier-20261007/components/memory-tier/verif-creusot/src/lib.rs" 846 0 846 53] (t: Seq.seq tup2_u64_u64) =
  [%#slib'213] forall i: int, j: int. 0 <= i /\ i < j /\ j < Seq.length t -> (Seq.get t i).f0 <> (Seq.get t j).f0

predicate slot_keys_unique [#"/home/cornel/fv-runs/apply-memory-tier-20261007/components/memory-tier/verif-creusot/src/lib.rs" 853 0 853 50] (s: Seq.seq t_SlotModel) =
  [%#slib'219] forall i: int, j: int. 0 <= i /\ i < j /\ j < Seq.length s -> (Seq.get s i).key'0 <> (Seq.get s j).key'0

predicate slot_at [#"/home/cornel/fv-runs/apply-memory-tier-20261007/components/memory-tier/verif-creusot/src/lib.rs" 836 0 836 49] (s: Seq.seq t_SlotModel) (k: UInt64.t) =
  [%#slib'197] exists i: int. 0 <= i /\ i < Seq.length s /\ (Seq.get s i).key'0 = k

predicate tracks [#"/home/cornel/fv-runs/apply-memory-tier-20261007/components/memory-tier/verif-creusot/src/lib.rs" 841 0 841 49] (t: Seq.seq tup2_u64_u64) (k: UInt64.t) =
  [%#slib'210] exists i: int. 0 <= i /\ i < Seq.length t /\ (Seq.get t i).f0 = k

predicate key_inv [#"/home/cornel/fv-runs/apply-memory-tier-20261007/components/memory-tier/verif-creusot/src/lib.rs" 887 0 887 38] (st: t_StateModel) =
  [%#slib'200] policy_keys_unique (view_Vec_tup2_u64_u64_Global st.policy.tracked)
  /\ slot_keys_unique (view_Vec_SlotModel_Global st.slots)
  /\ (forall k: UInt64.t. slot_at (view_Vec_SlotModel_Global st.slots) k
    = tracks (view_Vec_tup2_u64_u64_Global st.policy.tracked) k)

predicate init_inv [#"/home/cornel/fv-runs/apply-memory-tier-20261007/components/memory-tier/verif-creusot/src/lib.rs" 909 0 909 39] (st: t_StateModel) =
  [%#slib'201] (st.initialized
    -> ComputerDivision.mod (UInt64.t'int st.pool_base) 4096 = 0
    /\ UInt64.t'int st.pool_base > 0
    /\ UInt64.t'int st.pool_size > 0
    /\ UInt64.t'int st.pool_base + UInt64.t'int st.allocator.capacity <= UInt64.t'int const_MAX
    /\ UInt64.t'int st.allocator.capacity = UInt64.t'int st.pool_size)
  /\ (not st.initialized
  -> Seq.length (view_Vec_SlotModel_Global st.slots) = 0
  /\ Seq.length (view_Vec_tup2_u64_u64_Global st.policy.tracked) = 0)

predicate slot_inv [#"/home/cornel/fv-runs/apply-memory-tier-20261007/components/memory-tier/verif-creusot/src/lib.rs" 897 0 897 57] (s: Seq.seq t_SlotModel) (capacity'0: int) =
