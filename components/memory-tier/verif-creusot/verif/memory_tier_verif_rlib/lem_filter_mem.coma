use creusot.int.UInt64
use seq.Seq
use creusot.int.UInt32
use int.Int

type t_SlotModel = { key: UInt64.t; offset: UInt64.t; size: UInt32.t; handle: UInt64.t }

predicate slot_at [#"/home/cornel/fv-runs/j11-memory-tier/components/memory-tier/verif-creusot/src/lib.rs" 836 0 836 49] (s: Seq.seq t_SlotModel) (k: UInt64.t) =
  [%#slib'3] exists i: int. 0 <= i /\ i < Seq.length s /\ (Seq.get s i).key = k

function filter_l [#"/home/cornel/fv-runs/j11-memory-tier/components/memory-tier/verif-creusot/src/lib.rs" 1390 0 1390 60] (ks: Seq.seq UInt64.t) (s: Seq.seq t_SlotModel) : Seq.seq UInt64.t

axiom filter_l_def: forall ks: Seq.seq UInt64.t, s: Seq.seq t_SlotModel [filter_l ks s]. filter_l ks s
    = ([%#slib'2] if Seq.length ks <= 0 then
      Seq.empty: Seq.seq UInt64.t
    else
      if slot_at s (Seq.get ks (Seq.length ks - 1)) then
        Seq.snoc (filter_l (Seq.([..]) ks 0 (Seq.length ks - 1)) s) (Seq.get ks (Seq.length ks - 1))
      else
        filter_l (Seq.([..]) ks 0 (Seq.length ks - 1)) s
    
    )

predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
  [%#swell_founded] self >= 0 /\ self > other

meta "rewrite_def" predicate well_founded_relation_Int

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant ks : Seq.seq UInt64.t

constant s : Seq.seq t_SlotModel

function lem_filter_mem [#"/home/cornel/fv-runs/j11-memory-tier/components/memory-tier/verif-creusot/src/lib.rs" 8593 0 8593 54] (ks: Seq.seq UInt64.t) (s: Seq.seq t_SlotModel) : ()

goal vc_lem_filter_mem: if Seq.length ks <= 0 then
    [@stop_split] [@expl:lem_filter_mem ensures] [%#slib'0] forall k: UInt64.t. (exists i: int. 0 <= i
          /\ i < Seq.length (filter_l ks s) /\ Seq.get (filter_l ks s) i = k)
      = (slot_at s k /\ (exists j: int. 0 <= j /\ j < Seq.length ks /\ Seq.get ks j = k))
  else
    let p = Seq.([..]) ks 0 (Seq.length ks
    - 1) in ([@expl:variant decreases] well_founded_relation_Int ([%#slib] Seq.length ks) ([%#slib] Seq.length p))
    /\ (([@stop_split] [@expl:lem_filter_mem ensures] [%#slib'0] forall k: UInt64.t. (exists i: int. 0 <= i
            /\ i < Seq.length (filter_l p s) /\ Seq.get (filter_l p s) i = k)
        = (slot_at s k /\ (exists j: int. 0 <= j /\ j < Seq.length p /\ Seq.get p j = k)))
    -> (let _ = lem_filter_mem p s in (forall j: int. 0 <= j /\ j < Seq.length p -> Seq.get p j = Seq.get ks j)
    && (forall k: UInt64.t. (exists j: int. 0 <= j /\ j < Seq.length ks /\ Seq.get ks j = k)
        = ((exists j: int. 0 <= j /\ j < Seq.length p /\ Seq.get p j = k) \/ Seq.get ks (Seq.length ks - 1) = k))
    && (let x = Seq.get ks (Seq.length ks - 1) in let f = filter_l p s in if slot_at s x then
      filter_l ks s = Seq.snoc f x
      && (forall i: int. 0 <= i /\ i < Seq.length f -> Seq.get (Seq.snoc f x) i = Seq.get f i)
      && Seq.get (Seq.snoc f x) (Seq.length f) = x
      && (forall k: UInt64.t. (exists i: int. 0 <= i /\ i < Seq.length (Seq.snoc f x) /\ Seq.get (Seq.snoc f x) i = k)
          = ((exists i: int. 0 <= i /\ i < Seq.length f /\ Seq.get f i = k) \/ x = k))
      && ([@stop_split] [@expl:lem_filter_mem ensures] [%#slib'0] forall k: UInt64.t. (exists i: int. 0 <= i
            /\ i < Seq.length (filter_l ks s) /\ Seq.get (filter_l ks s) i = k)
        = (slot_at s k /\ (exists j: int. 0 <= j /\ j < Seq.length ks /\ Seq.get ks j = k)))
    else
      filter_l ks s = f
      && ([@stop_split] [@expl:lem_filter_mem ensures] [%#slib'0] forall k: UInt64.t. (exists i: int. 0 <= i
            /\ i < Seq.length (filter_l ks s) /\ Seq.get (filter_l ks s) i = k)
        = (slot_at s k /\ (exists j: int. 0 <= j /\ j < Seq.length ks /\ Seq.get ks j = k)))
    )))
  
