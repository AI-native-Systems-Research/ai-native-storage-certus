type t_SlotModel = { key: UInt64.t; offset: UInt64.t; size: UInt32.t; handle: UInt64.t }

predicate in_bounds_usize [@inline:trivial] (self: UInt64.t) (seq: Seq.seq t_SlotModel) =
  [%#sslice] UInt64.t'int self < Seq.length seq

meta "rewrite_def" predicate in_bounds_usize

constant const_MAX: UInt64.t = (18446744073709551615: UInt64.t)

function view_Vec_SlotModel_Global (self: t_Vec_SlotModel_Global) : Seq.seq t_SlotModel

axiom view_Vec_SlotModel_Global_spec:
  forall self: t_Vec_SlotModel_Global [view_Vec_SlotModel_Global self]. [%#svec'1] Seq.length (view_Vec_SlotModel_Global self)
    <= UInt64.t'int const_MAX

predicate has_value_usize [@inline:trivial] (self: UInt64.t) (seq: Seq.seq t_SlotModel) (out: t_SlotModel) =
  [%#sslice'0] Seq.get seq (UInt64.t'int self) = out

meta "rewrite_def" predicate has_value_usize

let index_Vec_SlotModel_Global (self_: t_Vec_SlotModel_Global) (ix: UInt64.t) (return (x: t_SlotModel)) =
{[@stop_split] [@expl:index requires] [%#svec] in_bounds_usize ix (view_Vec_SlotModel_Global self_)}
  any
  [ return (result: t_SlotModel) ->
  {[@stop_split] [@expl:index ensures] [%#svec'0] has_value_usize ix (view_Vec_SlotModel_Global self_) result}
    (! return {result}) ]

type t_Region = { offset'0: UInt64.t; size'0: UInt64.t }

