let policy_identify_next_to_evict (p: MutBorrow.t t_PolicyModel) (pool: UInt64.t) (return (x: t_Option_u64)) =
{[@stop_split] [@expl:policy_identify_next_to_evict requires] [%#slib'41] policy_keys_unique (view_Vec_tup2_u64_u64_Global p.current.tracked)}
  any
  [ return (result: t_Option_u64) ->
  {[@stop_split] [@expl:policy_identify_next_to_evict ensures] ([@stop_split] [@expl:policy_identify_next_to_evict ensures #0] [%#slib'42] match result with
        | Some k -> Seq.length (view_Vec_tup2_u64_u64_Global p.current.tracked) > 0
        /\ k = (Seq.get (view_Vec_tup2_u64_u64_Global p.current.tracked) 0).f0
        /\ not tracks (view_Vec_tup2_u64_u64_Global p.final.tracked) k
        | None -> Seq.length (view_Vec_tup2_u64_u64_Global p.current.tracked) = 0
        /\ view_Vec_tup2_u64_u64_Global p.final.tracked = view_Vec_tup2_u64_u64_Global p.current.tracked
        end)
    /\ ([@stop_split] [@expl:policy_identify_next_to_evict ensures #1] [%#slib'43] policy_keys_unique (view_Vec_tup2_u64_u64_Global p.final.tracked))
    /\ ([@stop_split] [@expl:policy_identify_next_to_evict ensures #2] [%#slib'44] forall k: UInt64.t, k2: UInt64.t. result
            = Some k
          /\ k2 <> k
