    /\ ([@stop_split] [@expl:policy_touch_key ensures #2] [%#slib'13] Seq.length (view_Vec_tup2_u64_u64_Global p.final.tracked)
      = Seq.length (view_Vec_tup2_u64_u64_Global p.current.tracked))
