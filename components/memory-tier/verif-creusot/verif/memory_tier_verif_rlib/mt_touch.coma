    /\ ([@stop_split] [@expl:policy_touch_key ensures #4] [%#slib'15] p.final.pools = p.current.pools)
    /\ ([@stop_split] [@expl:policy_touch_key ensures #5] [%#slib'16] p.final.last_pool = pool)
    /\ ([@stop_split] [@expl:policy_touch_key ensures #6] [%#slib'17] view_Vec_tup2_u64_u64_Global p.final.tracked
      = touch_l (view_Vec_tup2_u64_u64_Global p.current.tracked) key'0)
    /\ ([@stop_split] [@expl:policy_touch_key ensures #7] [%#slib'18] tracks (view_Vec_tup2_u64_u64_Global p.current.tracked) key'0
    -> Seq.length (view_Vec_tup2_u64_u64_Global p.final.tracked) > 0
