use creusot.int.UInt64
use creusot.int.UInt32
use seq.Seq
use int.Int

type t_SlotModel = { key: UInt64.t; offset: UInt64.t; size: UInt32.t; handle: UInt64.t }

predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
  [%#swell_founded] self >= 0 /\ self > other

meta "rewrite_def" predicate well_founded_relation_Int

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant s : Seq.seq t_SlotModel

function raw_sum [#"/home/cornel/fv-runs/memory-tier-d14dfb9a/components/memory-tier/verif-creusot/src/lib.rs" 4388 0 4388 40] (s: Seq.seq t_SlotModel) : int

goal vc_raw_sum: if Seq.length s <= 0 then
    true
  else
    [@expl:variant decreases] well_founded_relation_Int ([%#slib] Seq.length s) ([%#slib] Seq.length (Seq.([..]) s 0 (Seq.length s
    - 1)))
  
