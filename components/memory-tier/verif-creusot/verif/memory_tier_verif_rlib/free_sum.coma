let%span slib = "/home/cornel/fv-runs/j11-memory-tier/components/memory-tier/verif-creusot/src/lib.rs" 111 10 111 17
let%span swell_founded = "/home/cornel/fv-runs/j11-memory-tier/components/memory-tier/creusot/creusot-std/src/logic/well_founded.rs" 43 8 43 33

use creusot.int.UInt64
use seq.Seq
use int.Int

type t_Region = { offset: UInt64.t; size: UInt64.t }

predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
  [%#swell_founded] self >= 0 /\ self > other

meta "rewrite_def" predicate well_founded_relation_Int

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant r : Seq.seq t_Region

function free_sum [#"/home/cornel/fv-runs/j11-memory-tier/components/memory-tier/verif-creusot/src/lib.rs" 112 0 112 38] (r: Seq.seq t_Region) : int

goal vc_free_sum: if Seq.length r <= 0 then
    true
  else
    [@expl:variant decreases] well_founded_relation_Int ([%#slib] Seq.length r) ([%#slib] Seq.length (Seq.([..]) r 0 (Seq.length r
    - 1)))
  
