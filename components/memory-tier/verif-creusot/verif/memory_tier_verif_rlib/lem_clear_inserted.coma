use creusot.int.UInt64
use seq.Seq
use int.Int

type t_Region = { offset: UInt64.t; size: UInt64.t }

predicate disj [#"/home/cornel/fv-runs/memory-tier-d14dfb9a/components/memory-tier/verif-creusot/src/lib.rs" 208 0 208 55] (a0: int) (a1: int) (b0: int) (b1: int) =
  [%#slib'4] a1 <= b0 \/ b1 <= a0

predicate clear_of [#"/home/cornel/fv-runs/memory-tier-d14dfb9a/components/memory-tier/verif-creusot/src/lib.rs" 214 0 214 57] (r: Seq.seq t_Region) (x0: int) (x1: int) =
  [%#slib'3] forall j: int. 0 <= j /\ j < Seq.length r
    -> disj x0 x1 (UInt64.t'int (Seq.get r j).offset) (UInt64.t'int (Seq.get r j).offset
    + UInt64.t'int (Seq.get r j).size)

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant r : Seq.seq t_Region

constant fin : Seq.seq t_Region

constant q : int

function lem_clear_inserted [#"/home/cornel/fv-runs/memory-tier-d14dfb9a/components/memory-tier/verif-creusot/src/lib.rs" 290 0 290 67] (r: Seq.seq t_Region) (fin: Seq.seq t_Region) (q: int) : ()

goal vc_lem_clear_inserted: ([%#slib] 0 <= q /\ q <= Seq.length r /\ Seq.length fin = Seq.length r + 1)
  -> ([%#slib'0] forall j: int. 0 <= j /\ j < q -> Seq.get fin j = Seq.get r j)
  -> ([%#slib'1] forall j: int. q < j /\ j < Seq.length fin -> Seq.get fin j = Seq.get r (j - 1))
  -> ([@stop_split] [@expl:lem_clear_inserted ensures] [%#slib'2] forall x0: int, x1: int. clear_of r x0 x1
      /\ disj x0 x1 (UInt64.t'int (Seq.get fin q).offset) (UInt64.t'int (Seq.get fin q).offset
      + UInt64.t'int (Seq.get fin q).size) -> clear_of fin x0 x1)
