let mt_clear (st: MutBorrow.t t_StateModel) (return (x: t_Result_usize_MtError)) =
{[@stop_split] [@expl:mt_clear requires] [%#slib'4] mt_inv st.current}
  any
  [ return (result: t_Result_usize_MtError) ->
  {[@stop_split] [@expl:mt_clear ensures] ([@stop_split] [@expl:mt_clear ensures #0] [%#slib'5] fl_inv (view_Vec_Region_Global st.final.allocator.regions) (UInt64.t'int st.final.allocator.capacity))
    /\ ([@stop_split] [@expl:mt_clear ensures #1] [%#slib'6] key_inv st.final)
    /\ ([@stop_split] [@expl:mt_clear ensures #2] [%#slib'7] init_inv st.final)
    /\ ([@stop_split] [@expl:mt_clear ensures #3] [%#slib'8] slot_inv (view_Vec_SlotModel_Global st.final.slots) (UInt64.t'int st.final.allocator.capacity))
    /\ ([@stop_split] [@expl:mt_clear ensures #4] [%#slib'9] acct_ok st.final)
