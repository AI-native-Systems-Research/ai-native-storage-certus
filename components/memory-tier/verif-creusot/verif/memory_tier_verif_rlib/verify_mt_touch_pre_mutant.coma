type tup2_u64_u64 = { f0: UInt64.t; f1: UInt64.t }

constant const_MAX: UInt64.t = (18446744073709551615: UInt64.t)

function view_Vec_tup2_u64_u64_Global (self: t_Vec_tup2_u64_u64_Global) : Seq.seq tup2_u64_u64

axiom view_Vec_tup2_u64_u64_Global_spec:
  forall self: t_Vec_tup2_u64_u64_Global [view_Vec_tup2_u64_u64_Global self]. [%#svec] Seq.length (view_Vec_tup2_u64_u64_Global self)
    <= UInt64.t'int const_MAX

type t_Region = { offset: UInt64.t; size: UInt64.t }

function view_Vec_Region_Global (self: t_Vec_Region_Global) : Seq.seq t_Region

axiom view_Vec_Region_Global_spec:
  forall self: t_Vec_Region_Global [view_Vec_Region_Global self]. [%#svec] Seq.length (view_Vec_Region_Global self)
    <= UInt64.t'int const_MAX

type t_SlotModel = { key'0: UInt64.t; offset'0: UInt64.t; size'0: UInt32.t; handle'0: UInt64.t }

function view_Vec_SlotModel_Global (self: t_Vec_SlotModel_Global) : Seq.seq t_SlotModel

axiom view_Vec_SlotModel_Global_spec:
  forall self: t_Vec_SlotModel_Global [view_Vec_SlotModel_Global self]. [%#svec] Seq.length (view_Vec_SlotModel_Global self)
    <= UInt64.t'int const_MAX

