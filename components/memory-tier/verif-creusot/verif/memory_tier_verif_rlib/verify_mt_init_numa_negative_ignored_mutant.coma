    /\ ([@stop_split] [@expl:alloc_mmap_m ensures #1] [%#slib'9] UInt64.t'int ml.final.plain_calls
      = UInt64.t'int ml.current.plain_calls + (if r_huge = const_MAP_FAILED then 1 else 0))
    /\ ([@stop_split] [@expl:alloc_mmap_m ensures #2] [%#slib'10] r_huge <> const_MAP_FAILED -> result = Ok r_huge)
    /\ ([@stop_split] [@expl:alloc_mmap_m ensures #3] [%#slib'11] r_huge = const_MAP_FAILED
        /\ r_plain <> const_MAP_FAILED -> result = Ok r_plain)
    /\ ([@stop_split] [@expl:alloc_mmap_m ensures #4] [%#slib'12] r_huge = const_MAP_FAILED
        /\ r_plain = const_MAP_FAILED -> result = Err (AllocationFailed))
    /\ ([@stop_split] [@expl:alloc_mmap_m ensures #5] [%#slib'13] match result with
