    /\ ([@stop_split] [@expl:alloc_mmap_m ensures #8] [%#slib'16] forall n: Int32.t. numa = None
          \/ numa = Some n /\ Int32.to_int n < 0
        -> ml.final.mbind_issued = ml.current.mbind_issued
        /\ ml.final.mbind_mask = ml.current.mbind_mask
        /\ ml.final.mbind_maxnode = ml.current.mbind_maxnode /\ ml.final.mbind_node = ml.current.mbind_node)
    /\ ([@stop_split] [@expl:alloc_mmap_m ensures #9] [%#slib'17] not connected -> lg.final = lg.current)
    /\ ([@stop_split] [@expl:alloc_mmap_m ensures #10] [%#slib'18] numa = None -> lg.final = lg.current)
    /\ ([@stop_split] [@expl:alloc_mmap_m ensures #11] [%#slib'19] forall n: Int32.t. numa = Some n
