  [%#sseq] Seq.(++) (index_Seq_tup2_u64_u64 self { end' = index }) (index_Seq_tup2_u64_u64'0 self { start = index + 1 })

function touch_l [#"/home/cornel/fv-runs/memory-tier-d14dfb9a/components/memory-tier/verif-creusot/src/lib.rs" 1371 0 1371 61] (t: Seq.seq tup2_u64_u64) (k: UInt64.t) : Seq.seq tup2_u64_u64
