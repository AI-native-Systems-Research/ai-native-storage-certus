use creusot.int.UInt64
use creusot.prelude.MutBorrow
use creusot.int.UInt32
use seq.Seq
use int.ComputerDivision
use creusot.prelude.Any
use int.Int

type t_Vec_Region_Global

type t_FreeListModel = { regions: t_Vec_Region_Global; capacity: UInt64.t; used: UInt64.t }

type t_Vec_SlotModel_Global

type t_Vec_tup2_u64_u64_Global

type t_PolicyModel = { tracked: t_Vec_tup2_u64_u64_Global; next_handle: UInt64.t; pools: UInt64.t; last_pool: UInt64.t }

type t_StateModel = {
  pool_base: UInt64.t;
  pool_size: UInt64.t;
  pool_id: UInt64.t;
  allocator: t_FreeListModel;
  slots: t_Vec_SlotModel_Global;
  initialized: bool;
  spdk_allocated: bool;
  poisoned: bool;
  policy: t_PolicyModel }

type t_SlotModel = { key: UInt64.t; offset: UInt64.t; size: UInt32.t; handle: UInt64.t }

type t_Option_SlotModel = None | Some t_SlotModel

predicate slot_keys_unique [#"/home/cornel/fv-runs/apply-memory-tier-20261007/components/memory-tier/verif-creusot/src/lib.rs" 853 0 853 50] (s: Seq.seq t_SlotModel) =
  [%#slib'105] forall i: int, j: int. 0 <= i /\ i < j /\ j < Seq.length s -> (Seq.get s i).key <> (Seq.get s j).key

constant const_MAX: UInt64.t = (18446744073709551615: UInt64.t)

function view_Vec_SlotModel_Global (self: t_Vec_SlotModel_Global) : Seq.seq t_SlotModel

axiom view_Vec_SlotModel_Global_spec:
  forall self: t_Vec_SlotModel_Global [view_Vec_SlotModel_Global self]. [%#svec] Seq.length (view_Vec_SlotModel_Global self)
    <= UInt64.t'int const_MAX

predicate slot_at [#"/home/cornel/fv-runs/apply-memory-tier-20261007/components/memory-tier/verif-creusot/src/lib.rs" 836 0 836 49] (s: Seq.seq t_SlotModel) (k: UInt64.t) =
  [%#slib'101] exists i: int. 0 <= i /\ i < Seq.length s /\ (Seq.get s i).key = k

predicate slot_inv [#"/home/cornel/fv-runs/apply-memory-tier-20261007/components/memory-tier/verif-creusot/src/lib.rs" 897 0 897 57] (s: Seq.seq t_SlotModel) (capacity'0: int) =
  [%#slib'98] forall i: int. 0 <= i /\ i < Seq.length s
    -> ComputerDivision.mod (UInt64.t'int (Seq.get s i).offset) 4096 = 0
    /\ UInt64.t'int (Seq.get s i).offset + UInt32.t'int (Seq.get s i).size <= capacity'0

function align_up_l [#"/home/cornel/fv-runs/apply-memory-tier-20261007/components/memory-tier/verif-creusot/src/lib.rs" 33 0 33 35] (size'0: int) : int
 = [%#slib'72] (ComputerDivision.div (size'0 - 1) 4096 + 1) * 4096

function slot_sum [#"/home/cornel/fv-runs/apply-memory-tier-20261007/components/memory-tier/verif-creusot/src/lib.rs" 930 0 930 41] (s: Seq.seq t_SlotModel) : int

axiom slot_sum_def: forall s: Seq.seq t_SlotModel [slot_sum s]. slot_sum s
    = ([%#slib'107] if Seq.length s <= 0 then
      0
    else
      slot_sum (Seq.([..]) s 0 (Seq.length s - 1)) + align_up_l (UInt32.t'int (Seq.get s (Seq.length s - 1)).size)
    )

predicate slot_stable [#"/home/cornel/fv-runs/apply-memory-tier-20261007/components/memory-tier/verif-creusot/src/lib.rs" 862 0 862 64] (a: Seq.seq t_SlotModel) (b: Seq.seq t_SlotModel) =
  [%#slib'103] forall i: int, j: int. 0 <= i
