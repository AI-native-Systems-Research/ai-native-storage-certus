use creusot.int.UInt64
use seq.Seq
use int.Int

type t_Region = { offset: UInt64.t; size: UInt64.t }

function free_sum [#"/home/cornel/fv-runs/apply-memory-tier-20261007/components/memory-tier/verif-creusot/src/lib.rs" 112 0 112 38] (r: Seq.seq t_Region) : int

axiom free_sum_def: forall r: Seq.seq t_Region [free_sum r]. free_sum r
    = ([%#slib'4] if Seq.length r <= 0 then
      0
    else
      free_sum (Seq.([..]) r 0 (Seq.length r - 1)) + UInt64.t'int (Seq.get r (Seq.length r - 1)).size
    )

predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
  [%#swell_founded] self >= 0 /\ self > other

meta "rewrite_def" predicate well_founded_relation_Int

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant r : Seq.seq t_Region

function lem_fs_bound [#"/home/cornel/fv-runs/apply-memory-tier-20261007/components/memory-tier/verif-creusot/src/lib.rs" 200 0 200 35] (r: Seq.seq t_Region) : ()

goal vc_lem_fs_bound: ([%#slib'0] forall j: int. 0 <= j /\ j < Seq.length r -> UInt64.t'int (Seq.get r j).size > 0)
  -> (if Seq.length r <= 0 then
    [@stop_split] [@expl:lem_fs_bound ensures] ([@stop_split] [@expl:lem_fs_bound ensures #0] [%#slib'1] free_sum r
      >= 0)
    /\ ([@stop_split] [@expl:lem_fs_bound ensures #1] [%#slib'2] forall j: int. 0 <= j /\ j < Seq.length r
      -> UInt64.t'int (Seq.get r j).size <= free_sum r)
  else
    (([@stop_split] [@expl:lem_fs_bound requires] [%#slib'0] forall j: int. 0 <= j
            /\ j < Seq.length (Seq.([..]) r 0 (Seq.length r - 1))
          -> UInt64.t'int (Seq.get (Seq.([..]) r 0 (Seq.length r - 1)) j).size > 0)
      /\ ([@expl:variant decreases] well_founded_relation_Int ([%#slib] Seq.length r) ([%#slib] Seq.length (Seq.([..]) r 0 (Seq.length r
      - 1)))))
    /\ (([@stop_split] [@expl:lem_fs_bound ensures] ([@stop_split] [@expl:lem_fs_bound ensures #0] [%#slib'1] free_sum (Seq.([..]) r 0 (Seq.length r
          - 1))
        >= 0)
      /\ ([@stop_split] [@expl:lem_fs_bound ensures #1] [%#slib'2] forall j: int. 0 <= j
          /\ j < Seq.length (Seq.([..]) r 0 (Seq.length r - 1))
        -> UInt64.t'int (Seq.get (Seq.([..]) r 0 (Seq.length r - 1)) j).size
        <= free_sum (Seq.([..]) r 0 (Seq.length r - 1))))
    -> ([@stop_split] [@expl:lem_fs_bound ensures] ([@stop_split] [@expl:lem_fs_bound ensures #0] [%#slib'1] free_sum r
      >= 0)
    /\ ([@stop_split] [@expl:lem_fs_bound ensures #1] [%#slib'2] forall j: int. 0 <= j /\ j < Seq.length r
      -> UInt64.t'int (Seq.get r j).size <= free_sum r)))
  )
