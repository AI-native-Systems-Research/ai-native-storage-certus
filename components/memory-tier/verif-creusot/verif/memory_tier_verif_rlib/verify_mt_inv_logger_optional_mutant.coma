constant const_MAX'0: UInt64.t = (18446744073709551615: UInt64.t)

let init_logged (st: MutBorrow.t t_StateModel) (pool_size'0: UInt64.t) (a: t_Option_usize) (lg: MutBorrow.t t_LogSink)
  (connected: bool) (return (x: t_Result_unit_MtError)) =
{[@stop_split] [@expl:init_logged requires] ([@stop_split] [@expl:init_logged requires #0] [%#slib'10] mt_inv st.current)
  /\ ([@stop_split] [@expl:init_logged requires #1] [%#slib'11] not st.current.initialized)
  /\ ([@stop_split] [@expl:init_logged requires #2] [%#slib'12] UInt64.t'int st.current.policy.pools
    < UInt64.t'int const_MAX'0)
  /\ ([@stop_split] [@expl:init_logged requires #3] [%#slib'13] UInt64.t'int pool_size'0 > 0
    /\ UInt64.t'int pool_size'0 + 4096 <= UInt64.t'int const_MAX)
  /\ ([@stop_split] [@expl:init_logged requires #4] [%#slib'14] forall b: UInt64.t. a = Some b
    -> ComputerDivision.mod (UInt64.t'int b) 4096 = 0
    /\ UInt64.t'int b > 0 /\ UInt64.t'int b + UInt64.t'int pool_size'0 <= UInt64.t'int const_MAX)}
  any
  [ return (result: t_Result_unit_MtError) ->
  {[@stop_split] [@expl:init_logged ensures] ([@stop_split] [@expl:init_logged ensures #0] [%#slib'15] a = None
      -> result = Err (AllocationFailed) /\ st.final = st.current /\ lg.final = lg.current)
    /\ ([@stop_split] [@expl:init_logged ensures #1] [%#slib'16] forall b: UInt64.t. a = Some b
        -> result = Ok ()
        /\ st.final.pool_base = b
