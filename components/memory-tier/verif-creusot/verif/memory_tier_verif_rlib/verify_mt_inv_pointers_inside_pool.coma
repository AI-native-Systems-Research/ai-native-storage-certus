use creusot.prelude.MutBorrow
use creusot.int.UInt64
use creusot.slice.Slice64
use creusot.int.UInt8
use creusot.int.UInt32
use seq.Seq
use int.ComputerDivision
use creusot.prelude.Any
use int.Int

type t_Vec_Region_Global

type t_FreeListModel = { regions: t_Vec_Region_Global; capacity: UInt64.t; used: UInt64.t }

type t_Vec_SlotModel_Global

type t_Vec_tup2_u64_u64_Global

type t_PolicyModel = { tracked: t_Vec_tup2_u64_u64_Global; next_handle: UInt64.t; pools: UInt64.t; last_pool: UInt64.t }

type t_StateModel = {
  pool_base: UInt64.t;
  pool_size: UInt64.t;
  pool_id: UInt64.t;
  allocator: t_FreeListModel;
  slots: t_Vec_SlotModel_Global;
  initialized: bool;
  spdk_allocated: bool;
  poisoned: bool;
  policy: t_PolicyModel }

