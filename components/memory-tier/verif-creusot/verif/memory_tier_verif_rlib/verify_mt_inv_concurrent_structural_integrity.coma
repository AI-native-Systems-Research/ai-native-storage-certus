axiom slot_sum_def: forall s: Seq.seq t_SlotModel [slot_sum s]. slot_sum s
    = ([%#slib'58] if Seq.length s <= 0 then
      0
    else
      slot_sum (Seq.([..]) s 0 (Seq.length s - 1)) + align_up_l (UInt32.t'int (Seq.get s (Seq.length s - 1)).size)
    )

function free_sum [#"/home/cornel/fv-runs/j11-memory-tier/components/memory-tier/verif-creusot/src/lib.rs" 112 0 112 38] (r: Seq.seq t_Region) : int

axiom free_sum_def: forall r: Seq.seq t_Region [free_sum r]. free_sum r
    = ([%#slib'55] if Seq.length r <= 0 then
