function align_up_l [#"/home/cornel/fv-runs/j11-memory-tier/components/memory-tier/verif-creusot/src/lib.rs" 33 0 33 35] (size'1: int) : int
 = [%#slib'64] (ComputerDivision.div (size'1 - 1) 4096 + 1) * 4096

