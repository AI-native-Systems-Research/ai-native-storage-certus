let mt_contains [#"/home/cornel/fv-runs/j11-memory-tier/components/memory-tier/verif-creusot/src/lib.rs" 2222 0 2222 53]
  (st: t_StateModel) (key'0: UInt64.t) (return (x: bool)) =
{[@stop_split] [@expl:mt_contains requires] [%#slib'1] mt_inv st}
  (! bb0
  [ bb0 = any [ br0 -> {st.initialized = false} (! bb1) | br1 -> {st.initialized} (! bb2) ]
  | bb2 = s0
    [ s0 = [ &_12 <- st.slots ] s1
    | s1 = slots_contains [%#slib] {_12} {key'0} (fun (_x: bool) -> [ &_ret <- _x ] s2)
    | s2 = return {_ret} ]
  | bb1 = s0 [ s0 = [ &_ret <- [%#slib'0] false ] s1 | s1 = return {_ret} ] ]
  [ & _ret: bool = Any.any_l ()
  | & st: t_StateModel = st
  | & key'0: UInt64.t = key'0
  | & _12: t_Vec_SlotModel_Global = Any.any_l () ])
  [ return (result: bool) -> {[@stop_split] [@expl:mt_contains ensures] [%#slib'2] result
    = (st.initialized /\ slot_at (view_Vec_SlotModel_Global st.slots) key'0)}
    (! return {result}) ]
