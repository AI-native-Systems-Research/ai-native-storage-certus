use int.ComputerDivision
use creusot.int.UInt64
use seq.Seq
use creusot.prelude.MutBorrow
use creusot.int.UInt32
use creusot.prelude.Any
use int.Int

function align_up_l [#"/home/cornel/fv-runs/j11-memory-tier/components/memory-tier/verif-creusot/src/lib.rs" 33 0 33 35] (size: int) : int
 = [%#slib'85] (ComputerDivision.div (size - 1) 4096 + 1) * 4096

function lem_al [#"/home/cornel/fv-runs/j11-memory-tier/components/memory-tier/verif-creusot/src/lib.rs" 959 0 959 21] (x: int) : ()
 = [%#slib'24] ()

axiom lem_al_spec: forall x: int. ([%#slib'17] x > 0) -> ([%#slib'18] ComputerDivision.mod (align_up_l x) 4096 = 0)

axiom lem_al_spec'0: forall x: int. ([%#slib'17] x > 0) -> ([%#slib'19] align_up_l x >= x)

axiom lem_al_spec'1: forall x: int. ([%#slib'17] x > 0) -> ([%#slib'20] align_up_l x >= 4096)

axiom lem_al_spec'2: forall x: int. ([%#slib'17] x > 0) -> ([%#slib'21] align_up_l x < x + 4096)

axiom lem_al_spec'3: forall x: int. ([%#slib'17] x > 0)
    -> ([%#slib'22] ComputerDivision.mod x 4096 = 0 -> align_up_l x = x)

axiom lem_al_spec'4: forall x: int. ([%#slib'17] x > 0)
    -> ([%#slib'23] ComputerDivision.mod x 4096 <> 0 -> align_up_l x > x)

type t_Vec_Region_Global

type t_FreeListModel = { regions: t_Vec_Region_Global; capacity: UInt64.t; used: UInt64.t }

type t_Region = { offset: UInt64.t; size: UInt64.t }

constant const_MAX: UInt64.t = (18446744073709551615: UInt64.t)

function view_Vec_Region_Global (self: t_Vec_Region_Global) : Seq.seq t_Region

axiom view_Vec_Region_Global_spec:
  forall self: t_Vec_Region_Global [view_Vec_Region_Global self]. [%#svec] Seq.length (view_Vec_Region_Global self)
    <= UInt64.t'int const_MAX

function free_sum [#"/home/cornel/fv-runs/j11-memory-tier/components/memory-tier/verif-creusot/src/lib.rs" 112 0 112 38] (r: Seq.seq t_Region) : int

axiom free_sum_def: forall r: Seq.seq t_Region [free_sum r]. free_sum r
    = ([%#slib'87] if Seq.length r <= 0 then
      0
    else
      free_sum (Seq.([..]) r 0 (Seq.length r - 1)) + UInt64.t'int (Seq.get r (Seq.length r - 1)).size
    )

predicate offsets_aligned [#"/home/cornel/fv-runs/j11-memory-tier/components/memory-tier/verif-creusot/src/lib.rs" 72 0 72 46] (r: Seq.seq t_Region) =
  [%#slib'88] forall i: int. 0 <= i /\ i < Seq.length r
    -> ComputerDivision.mod (UInt64.t'int (Seq.get r i).offset) 4096 = 0

predicate sorted_by_offset [#"/home/cornel/fv-runs/j11-memory-tier/components/memory-tier/verif-creusot/src/lib.rs" 78 0 78 47] (r: Seq.seq t_Region) =
  [%#slib'89] forall i: int, j: int. 0 <= i /\ i < j /\ j < Seq.length r
    -> UInt64.t'int (Seq.get r i).offset < UInt64.t'int (Seq.get r j).offset

predicate disjoint_sorted [#"/home/cornel/fv-runs/j11-memory-tier/components/memory-tier/verif-creusot/src/lib.rs" 88 0 88 46] (r: Seq.seq t_Region) =
  [%#slib'90] (forall i: int. 0 <= i /\ i < Seq.length r -> UInt64.t'int (Seq.get r i).size > 0)
  /\ (forall i: int. 0 <= i /\ i + 1 < Seq.length r
    -> UInt64.t'int (Seq.get r i).offset + UInt64.t'int (Seq.get r i).size <= UInt64.t'int (Seq.get r (i + 1)).offset)

predicate no_adj [#"/home/cornel/fv-runs/j11-memory-tier/components/memory-tier/verif-creusot/src/lib.rs" 246 0 246 37] (r: Seq.seq t_Region) =
  [%#slib'91] forall i: int. 0 <= i /\ i + 1 < Seq.length r
    -> UInt64.t'int (Seq.get r i).offset + UInt64.t'int (Seq.get r i).size < UInt64.t'int (Seq.get r (i + 1)).offset

predicate disj_all [#"/home/cornel/fv-runs/j11-memory-tier/components/memory-tier/verif-creusot/src/lib.rs" 223 0 223 39] (r: Seq.seq t_Region) =
  [%#slib'101] forall i: int, j: int. 0 <= i /\ i < j /\ j < Seq.length r
    -> UInt64.t'int (Seq.get r i).offset + UInt64.t'int (Seq.get r i).size <= UInt64.t'int (Seq.get r j).offset

predicate fl_inv [#"/home/cornel/fv-runs/j11-memory-tier/components/memory-tier/verif-creusot/src/lib.rs" 872 0 872 52] (r: Seq.seq t_Region) (capacity'0: int) =
  [%#slib'92] offsets_aligned r
  /\ disjoint_sorted r
  /\ (forall i: int. 0 <= i /\ i < Seq.length r
      -> UInt64.t'int (Seq.get r i).offset + UInt64.t'int (Seq.get r i).size <= capacity'0)
  /\ disj_all r /\ sorted_by_offset r /\ no_adj r

let fl_new (capacity'0: UInt64.t) (return (x: t_FreeListModel)) = any
  [ return (result: t_FreeListModel) ->
  {[@stop_split] [@expl:fl_new ensures] ([@stop_split] [@expl:fl_new ensures #0] [%#slib'25] UInt64.t'int result.capacity
      = UInt64.t'int capacity'0)
    /\ ([@stop_split] [@expl:fl_new ensures #1] [%#slib'26] UInt64.t'int result.used = 0)
    /\ ([@stop_split] [@expl:fl_new ensures #2] [%#slib'27] UInt64.t'int capacity'0 > 0
      -> Seq.length (view_Vec_Region_Global result.regions) = 1)
    /\ ([@stop_split] [@expl:fl_new ensures #3] [%#slib'28] UInt64.t'int capacity'0 > 0
      -> UInt64.t'int (Seq.get (view_Vec_Region_Global result.regions) 0).offset = 0)
    /\ ([@stop_split] [@expl:fl_new ensures #4] [%#slib'29] UInt64.t'int capacity'0 > 0
      -> UInt64.t'int (Seq.get (view_Vec_Region_Global result.regions) 0).size = UInt64.t'int capacity'0)
    /\ ([@stop_split] [@expl:fl_new ensures #5] [%#slib'30] UInt64.t'int capacity'0 = 0
      -> Seq.length (view_Vec_Region_Global result.regions) = 0)
    /\ ([@stop_split] [@expl:fl_new ensures #6] [%#slib'31] free_sum (view_Vec_Region_Global result.regions)
      = UInt64.t'int capacity'0)
    /\ ([@stop_split] [@expl:fl_new ensures #7] [%#slib'32] offsets_aligned (view_Vec_Region_Global result.regions))
    /\ ([@stop_split] [@expl:fl_new ensures #8] [%#slib'33] sorted_by_offset (view_Vec_Region_Global result.regions))
    /\ ([@stop_split] [@expl:fl_new ensures #9] [%#slib'34] disjoint_sorted (view_Vec_Region_Global result.regions))
    /\ ([@stop_split] [@expl:fl_new ensures #10] [%#slib'35] no_adj (view_Vec_Region_Global result.regions))
    /\ ([@stop_split] [@expl:fl_new ensures #11] [%#slib'36] fl_inv (view_Vec_Region_Global result.regions) (UInt64.t'int result.capacity))}
