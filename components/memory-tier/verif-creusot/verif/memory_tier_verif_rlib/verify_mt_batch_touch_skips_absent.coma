let mt_batch_touch (st: MutBorrow.t t_StateModel) (keys: Slice64.slice UInt64.t) (return (x: ())) =
{[@stop_split] [@expl:mt_batch_touch requires] [%#slib'25] mt_inv st.current}
  any
  [ return (result: ()) ->
  {[@stop_split] [@expl:mt_batch_touch ensures] ([@stop_split] [@expl:mt_batch_touch ensures #0] [%#slib'26] refresh_frame st.current st.final)
    /\ ([@stop_split] [@expl:mt_batch_touch ensures #1] [%#slib'27] fl_inv (view_Vec_Region_Global st.final.allocator.regions) (UInt64.t'int st.final.allocator.capacity))
    /\ ([@stop_split] [@expl:mt_batch_touch ensures #2] [%#slib'28] key_inv st.final)
    /\ ([@stop_split] [@expl:mt_batch_touch ensures #3] [%#slib'29] init_inv st.final)
    /\ ([@stop_split] [@expl:mt_batch_touch ensures #4] [%#slib'30] slot_inv (view_Vec_SlotModel_Global st.final.slots) (UInt64.t'int st.final.allocator.capacity))
    /\ ([@stop_split] [@expl:mt_batch_touch ensures #5] [%#slib'31] acct_ok st.final)
    /\ ([@stop_split] [@expl:mt_batch_touch ensures #6] [%#slib'32] mt_inv st.final)
    /\ ([@stop_split] [@expl:mt_batch_touch ensures #7] [%#slib'33] not st.current.initialized -> st.final = st.current)
    /\ ([@stop_split] [@expl:mt_batch_touch ensures #8] [%#slib'34] slot_stable (view_Vec_SlotModel_Global st.current.slots) (view_Vec_SlotModel_Global st.final.slots))
    /\ ([@stop_split] [@expl:mt_batch_touch ensures #9] [%#slib'35] st.current.initialized
      -> view_Vec_tup2_u64_u64_Global st.final.policy.tracked
      = touch_all_l (view_Vec_tup2_u64_u64_Global st.current.policy.tracked) (filter_l (Slice64.view keys) (view_Vec_SlotModel_Global st.current.slots)))
    /\ ([@stop_split] [@expl:mt_batch_touch ensures #10] [%#slib'36] Seq.length (Slice64.view keys) = 0
    -> st.final = st.current)}
    (! return {result}) ]

