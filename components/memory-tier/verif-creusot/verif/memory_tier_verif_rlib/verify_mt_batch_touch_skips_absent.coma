type t_SlotModel = { key: UInt64.t; offset: UInt64.t; size: UInt32.t; handle: UInt64.t }

predicate slot_at [#"/home/cornel/fv-runs/apply-memory-tier-20261007/components/memory-tier/verif-creusot/src/lib.rs" 836 0 836 49] (s: Seq.seq t_SlotModel) (k: UInt64.t) =
  [%#slib'42] exists i: int. 0 <= i /\ i < Seq.length s /\ (Seq.get s i).key = k

function filter_l [#"/home/cornel/fv-runs/apply-memory-tier-20261007/components/memory-tier/verif-creusot/src/lib.rs" 1390 0 1390 60] (ks: Seq.seq UInt64.t) (s: Seq.seq t_SlotModel) : Seq.seq UInt64.t

axiom filter_l_def: forall ks: Seq.seq UInt64.t, s: Seq.seq t_SlotModel [filter_l ks s]. filter_l ks s
    = ([%#slib'24] if Seq.length ks <= 0 then
      Seq.empty: Seq.seq UInt64.t
    else
      if slot_at s (Seq.get ks (Seq.length ks - 1)) then
        Seq.snoc (filter_l (Seq.([..]) ks 0 (Seq.length ks - 1)) s) (Seq.get ks (Seq.length ks - 1))
      else
        filter_l (Seq.([..]) ks 0 (Seq.length ks - 1)) s
    
    )

function lem_filter_mem [#"/home/cornel/fv-runs/apply-memory-tier-20261007/components/memory-tier/verif-creusot/src/lib.rs" 8323 0 8323 54] (ks: Seq.seq UInt64.t) (s: Seq.seq t_SlotModel) : ()

axiom lem_filter_mem_def: forall ks: Seq.seq UInt64.t, s: Seq.seq t_SlotModel [lem_filter_mem ks s]. lem_filter_mem ks s
    = ([%#slib'19] if Seq.length ks <= 0 then
      ()
    else
      let p = Seq.([..]) ks 0 (Seq.length ks - 1) in let _ = lem_filter_mem p s in let x = Seq.get ks (Seq.length ks
      - 1) in let f = filter_l p s in if slot_at s x then () else ()
    )

axiom lem_filter_mem_spec:
  forall ks: Seq.seq UInt64.t, s: Seq.seq t_SlotModel. [%#slib'18] forall k: UInt64.t. (exists i: int. 0 <= i
          /\ i < Seq.length (filter_l ks s) /\ Seq.get (filter_l ks s) i = k)
      = (slot_at s k /\ (exists j: int. 0 <= j /\ j < Seq.length ks /\ Seq.get ks j = k))

type t_Vec_SlotModel_Global

constant const_MAX: UInt64.t = (18446744073709551615: UInt64.t)

function view_Vec_SlotModel_Global (self: t_Vec_SlotModel_Global) : Seq.seq t_SlotModel

axiom view_Vec_SlotModel_Global_spec:
  forall self: t_Vec_SlotModel_Global [view_Vec_SlotModel_Global self]. [%#svec] Seq.length (view_Vec_SlotModel_Global self)
    <= UInt64.t'int const_MAX

type t_Vec_Region_Global

type t_FreeListModel = { regions: t_Vec_Region_Global; capacity: UInt64.t; used: UInt64.t }

type t_Vec_tup2_u64_u64_Global

type t_PolicyModel = { tracked: t_Vec_tup2_u64_u64_Global; next_handle: UInt64.t; pools: UInt64.t; last_pool: UInt64.t }

type t_StateModel = {
  pool_base: UInt64.t;
  pool_size: UInt64.t;
  pool_id: UInt64.t;
  allocator: t_FreeListModel;
  slots: t_Vec_SlotModel_Global;
