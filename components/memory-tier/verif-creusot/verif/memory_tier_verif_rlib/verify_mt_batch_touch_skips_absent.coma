  spdk_allocated: bool;
  poisoned: bool;
  policy: t_PolicyModel }

function lem_filter_idem [#"/home/cornel/fv-runs/apply-memory-tier-20261007/components/memory-tier/verif-creusot/src/lib.rs" 8352 0 8352 55] (ks: Seq.seq UInt64.t) (s: Seq.seq t_SlotModel) : ()

axiom lem_filter_idem_def:
  forall ks: Seq.seq UInt64.t, s: Seq.seq t_SlotModel [lem_filter_idem ks s]. lem_filter_idem ks s
    = ([%#slib'22] if Seq.length ks <= 0 then
      ()
    else
      let p = Seq.([..]) ks 0 (Seq.length ks - 1) in let x = Seq.get ks (Seq.length ks
      - 1) in let _ = lem_filter_idem p s in if slot_at s x then () else ()
    )

axiom lem_filter_idem_spec: forall ks: Seq.seq UInt64.t, s: Seq.seq t_SlotModel. [%#slib'21] filter_l (filter_l ks s) s
    = filter_l ks s

type t_Region = { offset'0: UInt64.t; size'0: UInt64.t }

predicate offsets_aligned [#"/home/cornel/fv-runs/apply-memory-tier-20261007/components/memory-tier/verif-creusot/src/lib.rs" 72 0 72 46] (r: Seq.seq t_Region) =
  [%#slib'53] forall i: int. 0 <= i /\ i < Seq.length r
    -> ComputerDivision.mod (UInt64.t'int (Seq.get r i).offset'0) 4096 = 0

predicate disjoint_sorted [#"/home/cornel/fv-runs/apply-memory-tier-20261007/components/memory-tier/verif-creusot/src/lib.rs" 88 0 88 46] (r: Seq.seq t_Region) =
  [%#slib'54] (forall i: int. 0 <= i /\ i < Seq.length r -> UInt64.t'int (Seq.get r i).size'0 > 0)
  /\ (forall i: int. 0 <= i /\ i + 1 < Seq.length r
    -> UInt64.t'int (Seq.get r i).offset'0 + UInt64.t'int (Seq.get r i).size'0
    <= UInt64.t'int (Seq.get r (i + 1)).offset'0)

predicate disj_all [#"/home/cornel/fv-runs/apply-memory-tier-20261007/components/memory-tier/verif-creusot/src/lib.rs" 223 0 223 39] (r: Seq.seq t_Region) =
  [%#slib'55] forall i: int, j: int. 0 <= i /\ i < j /\ j < Seq.length r
    -> UInt64.t'int (Seq.get r i).offset'0 + UInt64.t'int (Seq.get r i).size'0 <= UInt64.t'int (Seq.get r j).offset'0

predicate sorted_by_offset [#"/home/cornel/fv-runs/apply-memory-tier-20261007/components/memory-tier/verif-creusot/src/lib.rs" 78 0 78 47] (r: Seq.seq t_Region) =
  [%#slib'56] forall i: int, j: int. 0 <= i /\ i < j /\ j < Seq.length r
    -> UInt64.t'int (Seq.get r i).offset'0 < UInt64.t'int (Seq.get r j).offset'0

predicate no_adj [#"/home/cornel/fv-runs/apply-memory-tier-20261007/components/memory-tier/verif-creusot/src/lib.rs" 246 0 246 37] (r: Seq.seq t_Region) =
  [%#slib'57] forall i: int. 0 <= i /\ i + 1 < Seq.length r
    -> UInt64.t'int (Seq.get r i).offset'0 + UInt64.t'int (Seq.get r i).size'0
    < UInt64.t'int (Seq.get r (i + 1)).offset'0

predicate fl_inv [#"/home/cornel/fv-runs/apply-memory-tier-20261007/components/memory-tier/verif-creusot/src/lib.rs" 872 0 872 52] (r: Seq.seq t_Region) (capacity'0: int) =
  [%#slib'44] offsets_aligned r
  /\ disjoint_sorted r
  /\ (forall i: int. 0 <= i /\ i < Seq.length r
      -> UInt64.t'int (Seq.get r i).offset'0 + UInt64.t'int (Seq.get r i).size'0 <= capacity'0)
  /\ disj_all r /\ sorted_by_offset r /\ no_adj r

