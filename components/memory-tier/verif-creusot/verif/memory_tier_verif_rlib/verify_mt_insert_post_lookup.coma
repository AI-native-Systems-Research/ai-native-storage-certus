    <= UInt64.t'int (Seq.get r (i + 1)).offset'0)

predicate disj_all [#"/home/cornel/fv-runs/apply-memory-tier-20261007/components/memory-tier/verif-creusot/src/lib.rs" 223 0 223 39] (r: Seq.seq t_Region) =
  [%#slib'87] forall i: int, j: int. 0 <= i /\ i < j /\ j < Seq.length r
    -> UInt64.t'int (Seq.get r i).offset'0 + UInt64.t'int (Seq.get r i).size'0 <= UInt64.t'int (Seq.get r j).offset'0

predicate sorted_by_offset [#"/home/cornel/fv-runs/apply-memory-tier-20261007/components/memory-tier/verif-creusot/src/lib.rs" 78 0 78 47] (r: Seq.seq t_Region) =
  [%#slib'88] forall i: int, j: int. 0 <= i /\ i < j /\ j < Seq.length r
