let index_Vec_SlotModel_Global (self_: t_Vec_SlotModel_Global) (ix: UInt64.t) (return (x: t_SlotModel)) =
{[@stop_split] [@expl:index requires] [%#svec] in_bounds_usize ix (view_Vec_SlotModel_Global self_)}
