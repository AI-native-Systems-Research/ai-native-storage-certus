let mt_oldest_keys (st: MutBorrow.t t_StateModel) (n: UInt64.t) (return (x: t_Vec_u64_Global)) =
{[@stop_split] [@expl:mt_oldest_keys requires] [%#slib'4] mt_inv st.current}
  any
  [ return (result: t_Vec_u64_Global) ->
  {[@stop_split] [@expl:mt_oldest_keys ensures] ([@stop_split] [@expl:mt_oldest_keys ensures #0] [%#slib'5] refresh_frame st.current st.final)
    /\ ([@stop_split] [@expl:mt_oldest_keys ensures #1] [%#slib'6] st.final.policy.tracked = st.current.policy.tracked)
