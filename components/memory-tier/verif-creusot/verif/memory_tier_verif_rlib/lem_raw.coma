use creusot.int.UInt64
use creusot.int.UInt32
use seq.Seq
use int.ComputerDivision
use int.Int

type t_SlotModel = { key: UInt64.t; offset: UInt64.t; size: UInt32.t; handle: UInt64.t }

function raw_sum [#"/home/cornel/fv-runs/j11-memory-tier/components/memory-tier/verif-creusot/src/lib.rs" 4590 0 4590 40] (s: Seq.seq t_SlotModel) : int

axiom raw_sum_def: forall s: Seq.seq t_SlotModel [raw_sum s]. raw_sum s
    = ([%#slib'12] if Seq.length s <= 0 then
      0
    else
      raw_sum (Seq.([..]) s 0 (Seq.length s - 1)) + UInt32.t'int (Seq.get s (Seq.length s - 1)).size
    )

function align_up_l [#"/home/cornel/fv-runs/j11-memory-tier/components/memory-tier/verif-creusot/src/lib.rs" 33 0 33 35] (size'0: int) : int
 = [%#slib'16] (ComputerDivision.div (size'0 - 1) 4096 + 1) * 4096

function slot_sum [#"/home/cornel/fv-runs/j11-memory-tier/components/memory-tier/verif-creusot/src/lib.rs" 930 0 930 41] (s: Seq.seq t_SlotModel) : int

axiom slot_sum_def: forall s: Seq.seq t_SlotModel [slot_sum s]. slot_sum s
    = ([%#slib'14] if Seq.length s <= 0 then
      0
    else
      slot_sum (Seq.([..]) s 0 (Seq.length s - 1)) + align_up_l (UInt32.t'int (Seq.get s (Seq.length s - 1)).size)
    )

function lem_al [#"/home/cornel/fv-runs/j11-memory-tier/components/memory-tier/verif-creusot/src/lib.rs" 959 0 959 21] (x: int) : ()
 = [%#slib'15] ()

axiom lem_al_spec: forall x: int. ([%#slib'4] x > 0) -> ([%#slib'5] ComputerDivision.mod (align_up_l x) 4096 = 0)

axiom lem_al_spec'0: forall x: int. ([%#slib'4] x > 0) -> ([%#slib'6] align_up_l x >= x)

axiom lem_al_spec'1: forall x: int. ([%#slib'4] x > 0) -> ([%#slib'7] align_up_l x >= 4096)

axiom lem_al_spec'2: forall x: int. ([%#slib'4] x > 0) -> ([%#slib'8] align_up_l x < x + 4096)

axiom lem_al_spec'3: forall x: int. ([%#slib'4] x > 0)
    -> ([%#slib'9] ComputerDivision.mod x 4096 = 0 -> align_up_l x = x)

axiom lem_al_spec'4: forall x: int. ([%#slib'4] x > 0)
    -> ([%#slib'10] ComputerDivision.mod x 4096 <> 0 -> align_up_l x > x)

predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
  [%#swell_founded] self >= 0 /\ self > other

meta "rewrite_def" predicate well_founded_relation_Int

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

