let panic_while_holding (st: MutBorrow.t t_StateModel) (return (x: ())) = any
  [ return (result: ()) ->
  {[@stop_split] [@expl:panic_while_holding ensures] ([@stop_split] [@expl:panic_while_holding ensures #0] [%#slib'13] st.final.poisoned)
    /\ ([@stop_split] [@expl:panic_while_holding ensures #1] [%#slib'14] st.final.initialized = st.current.initialized)
    /\ ([@stop_split] [@expl:panic_while_holding ensures #2] [%#slib'15] st.final.pool_base = st.current.pool_base)
    /\ ([@stop_split] [@expl:panic_while_holding ensures #3] [%#slib'16] st.final.pool_size = st.current.pool_size)}
    (! return {result}) ]

let len_u8 (self_: Slice64.slice UInt8.t) (return (x: UInt64.t)) = any
  [ return (result: UInt64.t) -> {[@stop_split] [@expl:len ensures] [%#sslice] Seq.length (Slice64.view self_)
    = UInt64.t'int result}
    (! return {result}) ]

