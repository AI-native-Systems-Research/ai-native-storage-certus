    /\ ([@stop_split] [@expl:alloc_mmap_m ensures #2] [%#slib'21] r_huge <> const_MAP_FAILED -> result = Ok r_huge)
    /\ ([@stop_split] [@expl:alloc_mmap_m ensures #3] [%#slib'22] r_huge = const_MAP_FAILED
        /\ r_plain <> const_MAP_FAILED -> result = Ok r_plain)
    /\ ([@stop_split] [@expl:alloc_mmap_m ensures #4] [%#slib'23] r_huge = const_MAP_FAILED
        /\ r_plain = const_MAP_FAILED -> result = Err (AllocationFailed))
    /\ ([@stop_split] [@expl:alloc_mmap_m ensures #5] [%#slib'24] match result with
        | Ok p -> p <> const_MAP_FAILED
        | Err e -> e = AllocationFailed
        end)
    /\ ([@stop_split] [@expl:alloc_mmap_m ensures #6] [%#slib'25] match result with
        | Ok _ -> true
        | Err _ -> ml.final.mbind_issued = ml.current.mbind_issued
        /\ ml.final.mbind_mask = ml.current.mbind_mask
        /\ ml.final.mbind_maxnode = ml.current.mbind_maxnode /\ ml.final.mbind_node = ml.current.mbind_node
