        /\ (Int32.to_int n >= UInt64.t'int const_C_ULONG_BITS -> UInt64.t'int ml.final.mbind_mask = 0))
    /\ ([@stop_split] [@expl:alloc_mmap_m ensures #8] [%#slib'27] forall n: Int32.t. numa = None
          \/ numa = Some n /\ Int32.to_int n < 0
        -> ml.final.mbind_issued = ml.current.mbind_issued
        /\ ml.final.mbind_mask = ml.current.mbind_mask
        /\ ml.final.mbind_maxnode = ml.current.mbind_maxnode /\ ml.final.mbind_node = ml.current.mbind_node)
    /\ ([@stop_split] [@expl:alloc_mmap_m ensures #9] [%#slib'28] not connected -> lg.final = lg.current)
    /\ ([@stop_split] [@expl:alloc_mmap_m ensures #10] [%#slib'29] numa = None -> lg.final = lg.current)
    /\ ([@stop_split] [@expl:alloc_mmap_m ensures #11] [%#slib'30] forall n: Int32.t. numa = Some n
        /\ Int32.to_int n < 0 -> lg.final = lg.current)}
    (! return {result}) ]

