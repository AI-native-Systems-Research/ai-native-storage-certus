predicate refresh_frame [#"/home/cornel/fv-runs/apply-memory-tier-20261007/components/memory-tier/verif-creusot/src/lib.rs" 1822 0 1822 58] (a: t_StateModel) (b: t_StateModel) =
  [%#slib'24] view_Vec_SlotModel_Global b.slots = view_Vec_SlotModel_Global a.slots
  /\ view_Vec_Region_Global b.allocator.regions = view_Vec_Region_Global a.allocator.regions
  /\ b.allocator.used = a.allocator.used
  /\ b.allocator.capacity = a.allocator.capacity
  /\ b.initialized = a.initialized
