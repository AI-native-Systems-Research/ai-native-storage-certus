let mt_used (st: t_StateModel) (return (x: UInt64.t)) = {[@stop_split] [@expl:mt_used requires] [%#slib'11] mt_inv st}
  any
  [ return (result: UInt64.t) ->
  {[@stop_split] [@expl:mt_used ensures] ([@stop_split] [@expl:mt_used ensures #0] [%#slib'12] st.initialized
      -> UInt64.t'int result = UInt64.t'int st.allocator.used)
    /\ ([@stop_split] [@expl:mt_used ensures #1] [%#slib'13] not st.initialized -> UInt64.t'int result = 0)}
    (! return {result}) ]

let mt_capacity (st: t_StateModel) (return (x: UInt64.t)) =
{[@stop_split] [@expl:mt_capacity requires] [%#slib'14] mt_inv st}
  any
  [ return (result: UInt64.t) ->
  {[@stop_split] [@expl:mt_capacity ensures] ([@stop_split] [@expl:mt_capacity ensures #0] [%#slib'15] st.initialized
      -> UInt64.t'int result = UInt64.t'int st.allocator.capacity)
    /\ ([@stop_split] [@expl:mt_capacity ensures #1] [%#slib'16] not st.initialized -> UInt64.t'int result = 0)}
    (! return {result}) ]

type tup2_usize_u32 = { f0'0: UInt64.t; f1'0: UInt32.t }

type t_Option_tup2_usize_u32 = None | Some tup2_usize_u32

let mt_peek (st: t_StateModel) (key: UInt64.t) (return (x: t_Option_tup2_usize_u32)) =
{[@stop_split] [@expl:mt_peek requires] [%#slib'17] mt_inv st}
  any
  [ return (result: t_Option_tup2_usize_u32) ->
  {[@stop_split] [@expl:mt_peek ensures] ([@stop_split] [@expl:mt_peek ensures #0] [%#slib'18] forall p: UInt64.t, s: UInt32.t. result
          = Some { f0'0 = p; f1'0 = s } -> ComputerDivision.mod (UInt64.t'int p) 4096 = 0)
    /\ ([@stop_split] [@expl:mt_peek ensures #1] [%#slib'19] match result with
        | Some _ -> st.initialized
        | None -> true
        end)
    /\ ([@stop_split] [@expl:mt_peek ensures #2] [%#slib'20] st.initialized
        /\ slot_at (view_Vec_SlotModel_Global st.slots) key -> result <> None)
