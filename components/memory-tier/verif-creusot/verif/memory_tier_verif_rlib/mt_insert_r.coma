use creusot.int.UInt64
use creusot.int.UInt32
use seq.Seq
use creusot.prelude.MutBorrow
use int.ComputerDivision
use creusot.prelude.Any
use int.Int

type t_Vec_Region_Global

type t_FreeListModel = { regions: t_Vec_Region_Global; capacity: UInt64.t; used: UInt64.t }

type t_Vec_SlotModel_Global

type t_Vec_tup2_u64_u64_Global

type t_PolicyModel = { tracked: t_Vec_tup2_u64_u64_Global; next_handle: UInt64.t; pools: UInt64.t; last_pool: UInt64.t }

type t_StateModel = {
  pool_base: UInt64.t;
  pool_size: UInt64.t;
  pool_id: UInt64.t;
  allocator: t_FreeListModel;
  slots: t_Vec_SlotModel_Global;
  initialized: bool;
  spdk_allocated: bool;
  poisoned: bool;
  policy: t_PolicyModel }

type t_SlotModel = { key: UInt64.t; offset: UInt64.t; size: UInt32.t; handle: UInt64.t }

predicate slot_at [#"/home/cornel/fv-runs/j11-memory-tier/components/memory-tier/verif-creusot/src/lib.rs" 836 0 836 49] (s: Seq.seq t_SlotModel) (k: UInt64.t) =
  [%#slib'83] exists i: int. 0 <= i /\ i < Seq.length s /\ (Seq.get s i).key = k

constant const_MAX: UInt64.t = (18446744073709551615: UInt64.t)

function view_Vec_SlotModel_Global (self: t_Vec_SlotModel_Global) : Seq.seq t_SlotModel

axiom view_Vec_SlotModel_Global_spec:
  forall self: t_Vec_SlotModel_Global [view_Vec_SlotModel_Global self]. [%#svec] Seq.length (view_Vec_SlotModel_Global self)
    <= UInt64.t'int const_MAX

let slots_contains (s: t_Vec_SlotModel_Global) (k: UInt64.t) (return (x: bool)) = any
  [ return (result: bool) -> {[@stop_split] [@expl:slots_contains ensures] [%#slib'12] result
    = slot_at (view_Vec_SlotModel_Global s) k}
    (! return {result}) ]

predicate resolve_refmut_StateModel [@inline:trivial] (_1: MutBorrow.t t_StateModel) = _1.final = _1.current

meta "rewrite_def" predicate resolve_refmut_StateModel

type t_MtError = InvalidSize | NotInitialized | AlreadyExists | PoolFull | KeyNotFound | AllocationFailed | NotEvictable

type t_Result_usize_MtError = Ok UInt64.t | Err t_MtError

type t_InsOutcome = Done t_Result_usize_MtError | Panicked

type tup2_u64_u64 = { f0: UInt64.t; f1: UInt64.t }

predicate tracks [#"/home/cornel/fv-runs/j11-memory-tier/components/memory-tier/verif-creusot/src/lib.rs" 841 0 841 49] (t: Seq.seq tup2_u64_u64) (k: UInt64.t) =
  [%#slib'13] exists i: int. 0 <= i /\ i < Seq.length t /\ (Seq.get t i).f0 = k

function view_Vec_tup2_u64_u64_Global (self: t_Vec_tup2_u64_u64_Global) : Seq.seq tup2_u64_u64

axiom view_Vec_tup2_u64_u64_Global_spec:
  forall self: t_Vec_tup2_u64_u64_Global [view_Vec_tup2_u64_u64_Global self]. [%#svec] Seq.length (view_Vec_tup2_u64_u64_Global self)
    <= UInt64.t'int const_MAX

type t_Option_usize = None | Some UInt64.t

type t_Region = { offset'0: UInt64.t; size'0: UInt64.t }

predicate offsets_aligned [#"/home/cornel/fv-runs/j11-memory-tier/components/memory-tier/verif-creusot/src/lib.rs" 72 0 72 46] (r: Seq.seq t_Region) =
  [%#slib'90] forall i: int. 0 <= i /\ i < Seq.length r
    -> ComputerDivision.mod (UInt64.t'int (Seq.get r i).offset'0) 4096 = 0

predicate disjoint_sorted [#"/home/cornel/fv-runs/j11-memory-tier/components/memory-tier/verif-creusot/src/lib.rs" 88 0 88 46] (r: Seq.seq t_Region) =
  [%#slib'91] (forall i: int. 0 <= i /\ i < Seq.length r -> UInt64.t'int (Seq.get r i).size'0 > 0)
  /\ (forall i: int. 0 <= i /\ i + 1 < Seq.length r
    -> UInt64.t'int (Seq.get r i).offset'0 + UInt64.t'int (Seq.get r i).size'0
    <= UInt64.t'int (Seq.get r (i + 1)).offset'0)

predicate disj_all [#"/home/cornel/fv-runs/j11-memory-tier/components/memory-tier/verif-creusot/src/lib.rs" 223 0 223 39] (r: Seq.seq t_Region) =
  [%#slib'102] forall i: int, j: int. 0 <= i /\ i < j /\ j < Seq.length r
    -> UInt64.t'int (Seq.get r i).offset'0 + UInt64.t'int (Seq.get r i).size'0 <= UInt64.t'int (Seq.get r j).offset'0

predicate sorted_by_offset [#"/home/cornel/fv-runs/j11-memory-tier/components/memory-tier/verif-creusot/src/lib.rs" 78 0 78 47] (r: Seq.seq t_Region) =
  [%#slib'103] forall i: int, j: int. 0 <= i /\ i < j /\ j < Seq.length r
    -> UInt64.t'int (Seq.get r i).offset'0 < UInt64.t'int (Seq.get r j).offset'0

predicate no_adj [#"/home/cornel/fv-runs/j11-memory-tier/components/memory-tier/verif-creusot/src/lib.rs" 246 0 246 37] (r: Seq.seq t_Region) =
  [%#slib'104] forall i: int. 0 <= i /\ i + 1 < Seq.length r
