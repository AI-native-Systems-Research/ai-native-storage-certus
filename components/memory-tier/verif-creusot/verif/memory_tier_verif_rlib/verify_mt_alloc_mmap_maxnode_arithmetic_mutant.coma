type t_LogSink = { lines: UInt64.t }

type t_MmapLog = {
  huge_calls: UInt64.t;
  plain_calls: UInt64.t;
  mbind_issued: bool;
  mbind_mask: UInt64.t;
  mbind_maxnode: UInt64.t;
  mbind_node: UInt64.t }

type t_Option_i32 = None | Some Int32.t

type t_MtError = InvalidSize | NotInitialized | AlreadyExists | PoolFull | KeyNotFound | AllocationFailed | NotEvictable

type t_Result_usize_MtError = Ok UInt64.t | Err t_MtError

constant const_MAX: UInt64.t = (18446744073709551615: UInt64.t)

constant const_MAP_FAILED: UInt64.t = [%#slib'20] (18446744073709551615: UInt64.t)

constant const_C_ULONG_BITS: UInt64.t = [%#slib'21] (64: UInt64.t)

let alloc_mmap_m (pool_size: UInt64.t) (numa: t_Option_i32) (r_huge: UInt64.t) (r_plain: UInt64.t) (rc: Int64.t)
