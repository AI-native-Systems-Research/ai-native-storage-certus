let mt_capacity (st: t_StateModel) (return (x: UInt64.t)) =
{[@stop_split] [@expl:mt_capacity requires] [%#slib'3] mt_inv st}
  any
  [ return (result: UInt64.t) ->
  {[@stop_split] [@expl:mt_capacity ensures] ([@stop_split] [@expl:mt_capacity ensures #0] [%#slib'4] st.initialized
      -> UInt64.t'int result = UInt64.t'int st.allocator.capacity)
    /\ ([@stop_split] [@expl:mt_capacity ensures #1] [%#slib'5] not st.initialized -> UInt64.t'int result = 0)}
    (! return {result}) ]

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let verify_mt_capacity_err_not_initialized [#"/home/cornel/fv-runs/j11-memory-tier/components/memory-tier/verif-creusot/src/lib.rs" 8762 0 8762 71]
  (st: t_StateModel) (return (x: UInt64.t)) =
{[@stop_split] [@expl:verify_mt_capacity_err_not_initialized requires] [%#slib'0] mt_inv st}
  (! bb0
  [ bb0 = s0 [ s0 = mt_capacity [%#slib] {st} (fun (_x: UInt64.t) -> [ &_ret <- _x ] s1) | s1 = return {_ret} ] ]
  [ & _ret: UInt64.t = Any.any_l () | & st: t_StateModel = st ])
  [ return (result: UInt64.t) ->
  {[@stop_split] [@expl:verify_mt_capacity_err_not_initialized ensures] ([@stop_split] [@expl:verify_mt_capacity_err_not_initialized ensures #0] [%#slib'1] not st.initialized
      -> UInt64.t'int result = 0)
    /\ ([@stop_split] [@expl:verify_mt_capacity_err_not_initialized ensures #1] [%#slib'2] UInt64.t'int result = 0
    -> not st.initialized)}
    (! return {result}) ]
