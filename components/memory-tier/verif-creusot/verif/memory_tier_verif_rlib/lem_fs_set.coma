use creusot.int.UInt64
use seq.Seq
use int.Int

type t_Region = { offset: UInt64.t; size: UInt64.t }

function free_sum [#"/home/cornel/fv-runs/apply-memory-tier-20261007/components/memory-tier/verif-creusot/src/lib.rs" 112 0 112 38] (r: Seq.seq t_Region) : int

axiom free_sum_def: forall r: Seq.seq t_Region [free_sum r]. free_sum r
    = ([%#slib'4] if Seq.length r <= 0 then
      0
    else
      free_sum (Seq.([..]) r 0 (Seq.length r - 1)) + UInt64.t'int (Seq.get r (Seq.length r - 1)).size
    )

function lem_fs_concat [#"/home/cornel/fv-runs/apply-memory-tier-20261007/components/memory-tier/verif-creusot/src/lib.rs" 123 0 123 52] (a: Seq.seq t_Region) (b: Seq.seq t_Region) : ()

axiom lem_fs_concat_def: forall a: Seq.seq t_Region, b: Seq.seq t_Region [lem_fs_concat a b]. lem_fs_concat a b
    = ([%#slib'8] if Seq.length b <= 0 then () else lem_fs_concat a (Seq.([..]) b 0 (Seq.length b - 1)))

axiom lem_fs_concat_spec: forall a: Seq.seq t_Region, b: Seq.seq t_Region. [%#slib'7] free_sum (Seq.(++) a b)
    = free_sum a + free_sum b

function lem_fs_split [#"/home/cornel/fv-runs/apply-memory-tier-20261007/components/memory-tier/verif-creusot/src/lib.rs" 139 0 139 43] (r: Seq.seq t_Region) (i: int) : ()
 = [%#slib'5] let _ = lem_fs_concat (Seq.singleton (Seq.get r i)) (Seq.([..]) r (i
  + 1) (Seq.length r)) in let _ = lem_fs_concat (Seq.([..]) r 0 i) (Seq.(++) (Seq.singleton (Seq.get r i)) (Seq.([..]) r (i
  + 1) (Seq.length r))) in ()

axiom lem_fs_split_spec: forall r: Seq.seq t_Region, i: int. ([%#slib'1] 0 <= i /\ i < Seq.length r)
    -> ([%#slib'2] free_sum r
    = free_sum (Seq.([..]) r 0 i) + UInt64.t'int (Seq.get r i).size + free_sum (Seq.([..]) r (i + 1) (Seq.length r)))

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant r : Seq.seq t_Region

constant i : int

constant x : t_Region

function lem_fs_set [#"/home/cornel/fv-runs/apply-memory-tier-20261007/components/memory-tier/verif-creusot/src/lib.rs" 165 0 165 52] (r: Seq.seq t_Region) (i: int) (x: t_Region) : ()

goal vc_lem_fs_set: ([%#slib] 0 <= i /\ i < Seq.length r)
  -> ([@stop_split] [@expl:lem_fs_split requires] [%#slib'1] 0 <= i /\ i < Seq.length r)
  /\ (([@stop_split] [@expl:lem_fs_split ensures] [%#slib'2] free_sum r
    = free_sum (Seq.([..]) r 0 i) + UInt64.t'int (Seq.get r i).size + free_sum (Seq.([..]) r (i + 1) (Seq.length r)))
  -> (let _ = lem_fs_split r i in ([@stop_split] [@expl:lem_fs_split requires] [%#slib'1] 0 <= i
    /\ i < Seq.length (Seq.set r i x))
  /\ (([@stop_split] [@expl:lem_fs_split ensures] [%#slib'2] free_sum (Seq.set r i x)
    = free_sum (Seq.([..]) (Seq.set r i x) 0 i) + UInt64.t'int (Seq.get (Seq.set r i x) i).size
    + free_sum (Seq.([..]) (Seq.set r i x) (i + 1) (Seq.length (Seq.set r i x))))
  -> (let _ = lem_fs_split (Seq.set r i x) i in Seq.([..]) (Seq.set r i x) 0 i = Seq.([..]) r 0 i
  && Seq.([..]) (Seq.set r i x) (i + 1) (Seq.length r) = Seq.([..]) r (i + 1) (Seq.length r)
  && ([@stop_split] [@expl:lem_fs_set ensures] [%#slib'0] free_sum (Seq.set r i x)
  = free_sum r - UInt64.t'int (Seq.get r i).size + UInt64.t'int x.size)))))
