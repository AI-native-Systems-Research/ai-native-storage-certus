use creusot.int.UInt64
use seq.Seq
use int.Int

type tup2_u64_u64 = { f0: UInt64.t; f1: UInt64.t }

function first_idx [#"/home/cornel/fv-runs/memory-tier-d14dfb9a/components/memory-tier/verif-creusot/src/lib.rs" 1335 0 1335 51] (t: Seq.seq tup2_u64_u64) (k: UInt64.t) : int

axiom first_idx_def: forall t: Seq.seq tup2_u64_u64, k: UInt64.t [first_idx t k]. first_idx t k
    = ([%#slib'5] if Seq.length t <= 0 then
      0
    else
      if (Seq.get t 0).f0 = k then 0 else 1 + first_idx (Seq.([..]) t 1 (Seq.length t)) k
    )

predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
  [%#swell_founded] self >= 0 /\ self > other

meta "rewrite_def" predicate well_founded_relation_Int

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant t : Seq.seq tup2_u64_u64

constant k : UInt64.t

constant i : int

function lem_fi [#"/home/cornel/fv-runs/memory-tier-d14dfb9a/components/memory-tier/verif-creusot/src/lib.rs" 1350 0 1350 49] (t: Seq.seq tup2_u64_u64) (k: UInt64.t) (i: int) : ()

goal vc_lem_fi: ([%#slib'0] 0 <= i /\ i <= Seq.length t)
  -> ([%#slib'1] forall j: int. 0 <= j /\ j < i -> (Seq.get t j).f0 <> k)
  -> ([%#slib'2] i < Seq.length t -> (Seq.get t i).f0 = k)
  -> (if Seq.length t <= 0 then
    [@stop_split] [@expl:lem_fi ensures] [%#slib'3] first_idx t k = i
  else
    if i = 0 then
      [@stop_split] [@expl:lem_fi ensures] [%#slib'3] first_idx t k = i
    else
      (forall j: int. 0 <= j /\ j < Seq.length t - 1 -> Seq.get (Seq.([..]) t 1 (Seq.length t)) j = Seq.get t (j + 1))
      && (([@stop_split] [@expl:lem_fi requires] ([@stop_split] [@expl:lem_fi requires #0] [%#slib'0] 0 <= i - 1
            /\ i - 1 <= Seq.length (Seq.([..]) t 1 (Seq.length t)))
          /\ ([@stop_split] [@expl:lem_fi requires #1] [%#slib'1] forall j: int. 0 <= j /\ j < i - 1
              -> (Seq.get (Seq.([..]) t 1 (Seq.length t)) j).f0 <> k)
          /\ ([@stop_split] [@expl:lem_fi requires #2] [%#slib'2] i - 1 < Seq.length (Seq.([..]) t 1 (Seq.length t))
          -> (Seq.get (Seq.([..]) t 1 (Seq.length t)) (i - 1)).f0 = k))
        /\ ([@expl:variant decreases] well_founded_relation_Int ([%#slib] Seq.length t) ([%#slib] Seq.length (Seq.([..]) t 1 (Seq.length t)))))
      /\ (([@stop_split] [@expl:lem_fi ensures] [%#slib'3] first_idx (Seq.([..]) t 1 (Seq.length t)) k = i - 1)
      -> ([@stop_split] [@expl:lem_fi ensures] [%#slib'3] first_idx t k = i))
  
  )
