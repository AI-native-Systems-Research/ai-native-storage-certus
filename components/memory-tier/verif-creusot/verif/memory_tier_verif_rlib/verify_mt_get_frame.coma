 = [%#slib'64] (ComputerDivision.div (size'1 - 1) 4096 + 1) * 4096

function slot_sum [#"/home/cornel/fv-runs/j11-memory-tier/components/memory-tier/verif-creusot/src/lib.rs" 930 0 930 41] (s: Seq.seq t_SlotModel) : int

axiom slot_sum_def: forall s: Seq.seq t_SlotModel [slot_sum s]. slot_sum s
    = ([%#slib'56] if Seq.length s <= 0 then
      0
    else
      slot_sum (Seq.([..]) s 0 (Seq.length s - 1)) + align_up_l (UInt32.t'int (Seq.get s (Seq.length s - 1)).size'0)
    )

function free_sum [#"/home/cornel/fv-runs/j11-memory-tier/components/memory-tier/verif-creusot/src/lib.rs" 112 0 112 38] (r: Seq.seq t_Region) : int

