let mt_evict_next_tel (st: MutBorrow.t t_StateModel) (tel: MutBorrow.t t_TelemetryModel) (return (x: t_Option_u64)) =
{[@stop_split] [@expl:mt_evict_next_tel requires] [%#slib'3] mt_inv st.current}
  any
  [ return (result: t_Option_u64) ->
  {[@stop_split] [@expl:mt_evict_next_tel ensures] ([@stop_split] [@expl:mt_evict_next_tel ensures #0] [%#slib'4] match result with
        | Some _ -> UInt64.t'int tel.final.evictions = fetch_l (UInt64.t'int tel.current.evictions)
        | None -> tel.final = tel.current
        end)
    /\ ([@stop_split] [@expl:mt_evict_next_tel ensures #1] [%#slib'5] match result with
        | Some k -> st.current.initialized
        /\ Seq.length (view_Vec_tup2_u64_u64_Global st.current.policy.tracked) > 0
        /\ k = (Seq.get (view_Vec_tup2_u64_u64_Global st.current.policy.tracked) 0).f0
        /\ slot_at (view_Vec_SlotModel_Global st.current.slots) k
        /\ not slot_at (view_Vec_SlotModel_Global st.final.slots) k
        | None -> view_Vec_SlotModel_Global st.final.slots = view_Vec_SlotModel_Global st.current.slots
        end)
    /\ ([@stop_split] [@expl:mt_evict_next_tel ensures #2] [%#slib'6] st.current.initialized
        /\ Seq.length (view_Vec_tup2_u64_u64_Global st.current.policy.tracked) > 0 -> result <> None)
    /\ ([@stop_split] [@expl:mt_evict_next_tel ensures #3] [%#slib'7] forall k2: UInt64.t. result <> Some k2
        -> slot_at (view_Vec_SlotModel_Global st.final.slots) k2
        = slot_at (view_Vec_SlotModel_Global st.current.slots) k2)
    /\ ([@stop_split] [@expl:mt_evict_next_tel ensures #4] [%#slib'8] tel.final.write_lock_contentions
      = tel.current.write_lock_contentions
    /\ tel.final.read_lock_contentions = tel.current.read_lock_contentions)}
    (! return {result}) ]

