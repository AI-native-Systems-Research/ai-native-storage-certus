    | s1 = MutBorrow.borrow_final <t_TelemetryModel> {tel.current} {MutBorrow.get_id tel}
        (fun (_bor: MutBorrow.t t_TelemetryModel) -> [ &_11 <- _bor ] [ &tel <- { tel with current = _bor.final } ] s2)
    | s2 = mt_evict_next_tel [%#slib] {_10} {_11} (fun (_x: t_Option_u64) -> [ &_ret <- _x ] s3)
    | s3 = -{resolve_refmut_TelemetryModel tel}- s4
    | s4 = -{resolve_refmut_StateModel st}- s5
    | s5 = return {_ret} ] ]
  [ & _ret: t_Option_u64 = Any.any_l ()
  | & st: MutBorrow.t t_StateModel = st
  | & tel: MutBorrow.t t_TelemetryModel = tel
  | & _10: MutBorrow.t t_StateModel = Any.any_l ()
  | & _11: MutBorrow.t t_TelemetryModel = Any.any_l () ])
  [ return (result: t_Option_u64) ->
  {[@stop_split] [@expl:witness_mt_telemetry_eviction_count_sequential ensures] ([@stop_split] [@expl:witness_mt_telemetry_eviction_count_sequential ensures #0] [%#slib'1] match result with
        | Some k -> UInt64.t'int tel.final.evictions = fetch_l (UInt64.t'int tel.current.evictions)
        /\ slot_at (view_Vec_SlotModel_Global st.current.slots) k
        /\ not slot_at (view_Vec_SlotModel_Global st.final.slots) k
        | None -> tel.final = tel.current
        /\ view_Vec_SlotModel_Global st.final.slots = view_Vec_SlotModel_Global st.current.slots
        end)
    /\ ([@stop_split] [@expl:witness_mt_telemetry_eviction_count_sequential ensures #1] [%#slib'2] forall k2: UInt64.t. result
        <> Some k2
      -> slot_at (view_Vec_SlotModel_Global st.final.slots) k2
      = slot_at (view_Vec_SlotModel_Global st.current.slots) k2)}
    (! return {result}) ]
