let mt_default (p: t_PolicyModel) (return (x: t_StateModel)) =
{[@stop_split] [@expl:mt_default requires] [%#slib'4] Seq.length (view_Vec_tup2_u64_u64_Global p.tracked) = 0}
  any
  [ return (result: t_StateModel) ->
  {[@stop_split] [@expl:mt_default ensures] ([@stop_split] [@expl:mt_default ensures #0] [%#slib'5] UInt64.t'int result.pool_base
        = 0
      /\ UInt64.t'int result.pool_size = 0 /\ UInt64.t'int result.pool_id = 0)
    /\ ([@stop_split] [@expl:mt_default ensures #1] [%#slib'6] not result.initialized
      /\ not result.spdk_allocated /\ not result.poisoned)
    /\ ([@stop_split] [@expl:mt_default ensures #2] [%#slib'7] UInt64.t'int result.allocator.capacity = 0
      /\ UInt64.t'int result.allocator.used = 0)
    /\ ([@stop_split] [@expl:mt_default ensures #3] [%#slib'8] Seq.length (view_Vec_Region_Global result.allocator.regions)
        = 0
      /\ Seq.length (view_Vec_SlotModel_Global result.slots) = 0)
