predicate key_inv [#"/home/cornel/fv-runs/apply-memory-tier-20261007/components/memory-tier/verif-creusot/src/lib.rs" 887 0 887 38] (st: t_StateModel) =
  [%#slib'31] policy_keys_unique (view_Vec_tup2_u64_u64_Global st.policy.tracked)
  /\ slot_keys_unique (view_Vec_SlotModel_Global st.slots)
  /\ (forall k: UInt64.t. slot_at (view_Vec_SlotModel_Global st.slots) k
