let mt_drop (st: MutBorrow.t t_StateModel) (spdk_build: bool) (env_active: bool) (rl: MutBorrow.t t_ReleaseLog)
  (return (x: ())) = {[@stop_split] [@expl:mt_drop requires] [%#slib'7] UInt64.t'int rl.current.munmaps
    < UInt64.t'int const_MAX'0
  /\ UInt64.t'int rl.current.spdk_frees < UInt64.t'int const_MAX'0}
  any
  [ return (result: ()) ->
  {[@stop_split] [@expl:mt_drop ensures] ([@stop_split] [@expl:mt_drop ensures #0] [%#slib'8] UInt64.t'int st.final.pool_base
      = 0)
    /\ ([@stop_split] [@expl:mt_drop ensures #1] [%#slib'9] UInt64.t'int st.current.pool_base = 0
      -> rl.final = rl.current)
    /\ ([@stop_split] [@expl:mt_drop ensures #2] [%#slib'10] UInt64.t'int st.current.pool_base <> 0
        /\ not (spdk_build /\ st.current.spdk_allocated)
      -> UInt64.t'int rl.final.munmaps = UInt64.t'int rl.current.munmaps + 1
      /\ rl.final.spdk_frees = rl.current.spdk_frees
      /\ rl.final.last_base = st.current.pool_base /\ rl.final.last_len = st.current.pool_size)
    /\ ([@stop_split] [@expl:mt_drop ensures #3] [%#slib'11] UInt64.t'int st.current.pool_base <> 0
        /\ spdk_build /\ st.current.spdk_allocated /\ env_active
      -> UInt64.t'int rl.final.spdk_frees = UInt64.t'int rl.current.spdk_frees + 1
      /\ rl.final.munmaps = rl.current.munmaps /\ rl.final.last_base = st.current.pool_base)
    /\ ([@stop_split] [@expl:mt_drop ensures #4] [%#slib'12] spdk_build /\ st.current.spdk_allocated /\ not env_active
      -> rl.final = rl.current)
    /\ ([@stop_split] [@expl:mt_drop ensures #5] [%#slib'13] st.final.pool_size = st.current.pool_size
      /\ st.final.pool_id = st.current.pool_id
      /\ view_Vec_Region_Global st.final.allocator.regions = view_Vec_Region_Global st.current.allocator.regions
      /\ st.final.allocator.capacity = st.current.allocator.capacity
      /\ st.final.allocator.used = st.current.allocator.used
      /\ view_Vec_SlotModel_Global st.final.slots = view_Vec_SlotModel_Global st.current.slots
      /\ st.final.initialized = st.current.initialized
      /\ st.final.spdk_allocated = st.current.spdk_allocated /\ st.final.poisoned = st.current.poisoned)
    /\ ([@stop_split] [@expl:mt_drop ensures #6] [%#slib'14] view_Vec_tup2_u64_u64_Global st.final.policy.tracked
      = view_Vec_tup2_u64_u64_Global st.current.policy.tracked
    /\ st.final.policy.next_handle = st.current.policy.next_handle
    /\ st.final.policy.pools = st.current.policy.pools /\ st.final.policy.last_pool = st.current.policy.last_pool)}
    (! return {result}) ]

