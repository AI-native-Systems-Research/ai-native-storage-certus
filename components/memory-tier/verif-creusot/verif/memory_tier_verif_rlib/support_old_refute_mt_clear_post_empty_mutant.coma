use int.Int

function align_up_l [#"/home/cornel/fv-runs/j11-memory-tier/components/memory-tier/verif-creusot/src/lib.rs" 33 0 33 35] (size: int) : int
 = [%#slib'107] (ComputerDivision.div (size - 1) 4096 + 1) * 4096

function lem_al [#"/home/cornel/fv-runs/j11-memory-tier/components/memory-tier/verif-creusot/src/lib.rs" 959 0 959 21] (x: int) : ()
 = [%#slib'17] ()

axiom lem_al_spec: forall x: int. ([%#slib'10] x > 0) -> ([%#slib'11] ComputerDivision.mod (align_up_l x) 4096 = 0)

axiom lem_al_spec'0: forall x: int. ([%#slib'10] x > 0) -> ([%#slib'12] align_up_l x >= x)

axiom lem_al_spec'1: forall x: int. ([%#slib'10] x > 0) -> ([%#slib'13] align_up_l x >= 4096)

axiom lem_al_spec'2: forall x: int. ([%#slib'10] x > 0) -> ([%#slib'14] align_up_l x < x + 4096)

axiom lem_al_spec'3: forall x: int. ([%#slib'10] x > 0)
    -> ([%#slib'15] ComputerDivision.mod x 4096 = 0 -> align_up_l x = x)

axiom lem_al_spec'4: forall x: int. ([%#slib'10] x > 0)
    -> ([%#slib'16] ComputerDivision.mod x 4096 <> 0 -> align_up_l x > x)

type t_Vec_Region_Global

type t_FreeListModel = { regions: t_Vec_Region_Global; capacity: UInt64.t; used: UInt64.t }

type t_Vec_SlotModel_Global

type t_Vec_tup2_u64_u64_Global

