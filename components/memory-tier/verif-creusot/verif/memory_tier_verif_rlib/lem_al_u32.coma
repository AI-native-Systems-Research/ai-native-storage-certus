use int.ComputerDivision
use int.Int

function align_up_l [#"/home/cornel/fv-runs/j11-memory-tier/components/memory-tier/verif-creusot/src/lib.rs" 33 0 33 35] (size: int) : int
 = [%#slib'8] (ComputerDivision.div (size - 1) 4096 + 1) * 4096

function lem_al [#"/home/cornel/fv-runs/j11-memory-tier/components/memory-tier/verif-creusot/src/lib.rs" 959 0 959 21] (x: int) : ()
 = [%#slib'9] ()

axiom lem_al_spec: forall x: int. ([%#slib'1] x > 0) -> ([%#slib'2] ComputerDivision.mod (align_up_l x) 4096 = 0)

axiom lem_al_spec'0: forall x: int. ([%#slib'1] x > 0) -> ([%#slib'3] align_up_l x >= x)

axiom lem_al_spec'1: forall x: int. ([%#slib'1] x > 0) -> ([%#slib'4] align_up_l x >= 4096)

axiom lem_al_spec'2: forall x: int. ([%#slib'1] x > 0) -> ([%#slib'5] align_up_l x < x + 4096)

axiom lem_al_spec'3: forall x: int. ([%#slib'1] x > 0)
