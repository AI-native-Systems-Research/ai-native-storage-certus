    /\ ([@stop_split] [@expl:alloc_mmap_m ensures #2] [%#slib'12] r_huge <> const_MAP_FAILED -> result = Ok r_huge)
    /\ ([@stop_split] [@expl:alloc_mmap_m ensures #3] [%#slib'13] r_huge = const_MAP_FAILED
        /\ r_plain <> const_MAP_FAILED -> result = Ok r_plain)
    /\ ([@stop_split] [@expl:alloc_mmap_m ensures #4] [%#slib'14] r_huge = const_MAP_FAILED
