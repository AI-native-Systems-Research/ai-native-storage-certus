{[@stop_split] [@expl:alloc_mmap_m requires] [%#slib'9] UInt64.t'int ml.current.huge_calls < UInt64.t'int const_MAX
  /\ UInt64.t'int ml.current.plain_calls < UInt64.t'int const_MAX}
  any
  [ return (result: t_Result_usize_MtError) ->
  {[@stop_split] [@expl:alloc_mmap_m ensures] ([@stop_split] [@expl:alloc_mmap_m ensures #0] [%#slib'10] UInt64.t'int ml.final.huge_calls
      = UInt64.t'int ml.current.huge_calls + 1)
    /\ ([@stop_split] [@expl:alloc_mmap_m ensures #1] [%#slib'11] UInt64.t'int ml.final.plain_calls
      = UInt64.t'int ml.current.plain_calls + (if r_huge = const_MAP_FAILED then 1 else 0))
    /\ ([@stop_split] [@expl:alloc_mmap_m ensures #2] [%#slib'12] r_huge <> const_MAP_FAILED -> result = Ok r_huge)
    /\ ([@stop_split] [@expl:alloc_mmap_m ensures #3] [%#slib'13] r_huge = const_MAP_FAILED
        /\ r_plain <> const_MAP_FAILED -> result = Ok r_plain)
    /\ ([@stop_split] [@expl:alloc_mmap_m ensures #4] [%#slib'14] r_huge = const_MAP_FAILED
        /\ r_plain = const_MAP_FAILED -> result = Err (AllocationFailed))
    /\ ([@stop_split] [@expl:alloc_mmap_m ensures #5] [%#slib'15] match result with
        | Ok p -> p <> const_MAP_FAILED
        | Err e -> e = AllocationFailed
        end)
    /\ ([@stop_split] [@expl:alloc_mmap_m ensures #6] [%#slib'16] match result with
        | Ok _ -> true
        | Err _ -> ml.final.mbind_issued = ml.current.mbind_issued
        /\ ml.final.mbind_mask = ml.current.mbind_mask
        /\ ml.final.mbind_maxnode = ml.current.mbind_maxnode /\ ml.final.mbind_node = ml.current.mbind_node
        end)
    /\ ([@stop_split] [@expl:alloc_mmap_m ensures #7] [%#slib'17] forall n: Int32.t. numa = Some n
          /\ Int32.to_int n >= 0 /\ result <> Err (AllocationFailed)
        -> ml.final.mbind_issued
        /\ UInt64.t'int ml.final.mbind_node = Int32.to_int n
        /\ UInt64.t'int ml.final.mbind_maxnode = Int32.to_int n + 2
        /\ (Int32.to_int n >= UInt64.t'int const_C_ULONG_BITS -> UInt64.t'int ml.final.mbind_mask = 0))
    /\ ([@stop_split] [@expl:alloc_mmap_m ensures #8] [%#slib'18] forall n: Int32.t. numa = None
          \/ numa = Some n /\ Int32.to_int n < 0
        -> ml.final.mbind_issued = ml.current.mbind_issued
        /\ ml.final.mbind_mask = ml.current.mbind_mask
        /\ ml.final.mbind_maxnode = ml.current.mbind_maxnode /\ ml.final.mbind_node = ml.current.mbind_node)
    /\ ([@stop_split] [@expl:alloc_mmap_m ensures #9] [%#slib'19] not connected -> lg.final = lg.current)
    /\ ([@stop_split] [@expl:alloc_mmap_m ensures #10] [%#slib'20] numa = None -> lg.final = lg.current)
    /\ ([@stop_split] [@expl:alloc_mmap_m ensures #11] [%#slib'21] forall n: Int32.t. numa = Some n
        /\ Int32.to_int n < 0 -> lg.final = lg.current)}
    (! return {result}) ]

