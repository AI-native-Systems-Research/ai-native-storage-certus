let cs_insert (fl: MutBorrow.t t_FreeListModel) (slots'0: MutBorrow.t t_Vec_SlotModel_Global) (key'0: UInt64.t)
  (size'1: UInt32.t) (handle'0: UInt64.t) (return (x: t_Result_usize_MtError)) =
{[@stop_split] [@expl:cs_insert requires] [%#slib'13] pool_inv fl.current (view_Vec_SlotModel_Global slots'0.current)}
  any
  [ return (result: t_Result_usize_MtError) ->
  {[@stop_split] [@expl:cs_insert ensures] ([@stop_split] [@expl:cs_insert ensures #0] [%#slib'14] pool_inv fl.final (view_Vec_SlotModel_Global slots'0.final))
    /\ ([@stop_split] [@expl:cs_insert ensures #1] [%#slib'15] fl.final.capacity = fl.current.capacity)
    /\ ([@stop_split] [@expl:cs_insert ensures #2] [%#slib'16] UInt32.t'int size'1 > 0
        /\ not slot_at (view_Vec_SlotModel_Global slots'0.current) key'0
        /\ some_region_fits (view_Vec_Region_Global fl.current.regions) (align_up_l (UInt32.t'int size'1))
      -> match result with
