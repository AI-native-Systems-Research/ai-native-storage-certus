    /\ ([@stop_split] [@expl:cs_insert ensures #3] [%#slib'17] match result with
        | Ok _ -> slot_at (view_Vec_SlotModel_Global slots'0.final) key'0
        | Err _ -> view_Vec_SlotModel_Global slots'0.final = view_Vec_SlotModel_Global slots'0.current
        end)
    /\ ([@stop_split] [@expl:cs_insert ensures #4] [%#slib'18] forall k2: UInt64.t. k2 <> key'0
      -> slot_at (view_Vec_SlotModel_Global slots'0.final) k2 = slot_at (view_Vec_SlotModel_Global slots'0.current) k2)}
    (! return {result}) ]

