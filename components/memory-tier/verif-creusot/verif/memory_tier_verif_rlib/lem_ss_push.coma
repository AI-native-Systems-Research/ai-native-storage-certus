let%span slib'0 = "/home/cornel/fv-runs/apply-memory-tier-20261007/components/memory-tier/verif-creusot/src/lib.rs" 929 10 929 17
let%span slib'1 = "/home/cornel/fv-runs/apply-memory-tier-20261007/components/memory-tier/verif-creusot/src/lib.rs" 932 8 933 91
let%span slib'2 = "/home/cornel/fv-runs/apply-memory-tier-20261007/components/memory-tier/verif-creusot/src/lib.rs" 34 16 34 46

use creusot.int.UInt64
use creusot.int.UInt32
use seq.Seq
use int.ComputerDivision
use int.Int

type t_SlotModel = { key: UInt64.t; offset: UInt64.t; size: UInt32.t; handle: UInt64.t }

function align_up_l [#"/home/cornel/fv-runs/apply-memory-tier-20261007/components/memory-tier/verif-creusot/src/lib.rs" 33 0 33 35] (size'0: int) : int
 = [%#slib'2] (ComputerDivision.div (size'0 - 1) 4096 + 1) * 4096

function slot_sum [#"/home/cornel/fv-runs/apply-memory-tier-20261007/components/memory-tier/verif-creusot/src/lib.rs" 930 0 930 41] (s: Seq.seq t_SlotModel) : int

axiom slot_sum_def: forall s: Seq.seq t_SlotModel [slot_sum s]. slot_sum s
    = ([%#slib'1] if Seq.length s <= 0 then
      0
    else
      slot_sum (Seq.([..]) s 0 (Seq.length s - 1)) + align_up_l (UInt32.t'int (Seq.get s (Seq.length s - 1)).size)
    )

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant s : Seq.seq t_SlotModel

constant e : t_SlotModel

function lem_ss_push [#"/home/cornel/fv-runs/apply-memory-tier-20261007/components/memory-tier/verif-creusot/src/lib.rs" 939 0 939 51] (s: Seq.seq t_SlotModel) (e: t_SlotModel) : ()

goal vc_lem_ss_push: Seq.([..]) (Seq.snoc s e) 0 (Seq.length s) = s
  && ([@stop_split] [@expl:lem_ss_push ensures] [%#slib] slot_sum (Seq.snoc s e)
  = slot_sum s + align_up_l (UInt32.t'int e.size))
