let slots_remove (s: MutBorrow.t t_Vec_SlotModel_Global) (k: UInt64.t) (return (x: t_Option_SlotModel)) =
{[@stop_split] [@expl:slots_remove requires] [%#slib'11] slot_keys_unique (view_Vec_SlotModel_Global s.current)}
  any
  [ return (result: t_Option_SlotModel) ->
  {[@stop_split] [@expl:slots_remove ensures] ([@stop_split] [@expl:slots_remove ensures #0] [%#slib'12] slot_keys_unique (view_Vec_SlotModel_Global s.final))
    /\ ([@stop_split] [@expl:slots_remove ensures #1] [%#slib'13] not slot_at (view_Vec_SlotModel_Global s.final) k)
    /\ ([@stop_split] [@expl:slots_remove ensures #2] [%#slib'14] forall k2: UInt64.t. k2 <> k
        -> slot_at (view_Vec_SlotModel_Global s.final) k2 = slot_at (view_Vec_SlotModel_Global s.current) k2)
    /\ ([@stop_split] [@expl:slots_remove ensures #3] [%#slib'15] match result with
        | Some sl -> sl.key = k /\ slot_at (view_Vec_SlotModel_Global s.current) k
        | None -> not slot_at (view_Vec_SlotModel_Global s.current) k
        end)
    /\ ([@stop_split] [@expl:slots_remove ensures #4] [%#slib'16] forall cap: int. slot_inv (view_Vec_SlotModel_Global s.current) cap
        -> slot_inv (view_Vec_SlotModel_Global s.final) cap)
    /\ ([@stop_split] [@expl:slots_remove ensures #5] [%#slib'17] forall cap: int, sl: t_SlotModel. slot_inv (view_Vec_SlotModel_Global s.current) cap
          /\ result = Some sl
        -> ComputerDivision.mod (UInt64.t'int sl.offset) 4096 = 0
        /\ UInt64.t'int sl.offset + UInt32.t'int sl.size <= cap)
    /\ ([@stop_split] [@expl:slots_remove ensures #6] [%#slib'18] slot_sum (view_Vec_SlotModel_Global s.final)
      = slot_sum (view_Vec_SlotModel_Global s.current)
      - match result with
        | Some sl -> align_up_l (UInt32.t'int sl.size)
        | None -> 0
        end)
    /\ ([@stop_split] [@expl:slots_remove ensures #7] [%#slib'19] forall j: int. 0 <= j
          /\ j < Seq.length (view_Vec_SlotModel_Global s.final)
        -> (exists i: int. 0 <= i
          /\ i < Seq.length (view_Vec_SlotModel_Global s.current)
          /\ Seq.get (view_Vec_SlotModel_Global s.current) i = Seq.get (view_Vec_SlotModel_Global s.final) j
          /\ (Seq.get (view_Vec_SlotModel_Global s.final) j).key <> k))
    /\ ([@stop_split] [@expl:slots_remove ensures #8] [%#slib'20] forall sl: t_SlotModel. result = Some sl
        -> (exists i: int. 0 <= i
          /\ i < Seq.length (view_Vec_SlotModel_Global s.current)
          /\ Seq.get (view_Vec_SlotModel_Global s.current) i = sl))
    /\ ([@stop_split] [@expl:slots_remove ensures #9] [%#slib'21] result = None
      -> view_Vec_SlotModel_Global s.final = view_Vec_SlotModel_Global s.current)
    /\ ([@stop_split] [@expl:slots_remove ensures #10] [%#slib'22] slot_stable (view_Vec_SlotModel_Global s.current) (view_Vec_SlotModel_Global s.final))
    /\ ([@stop_split] [@expl:slots_remove ensures #11] [%#slib'23] forall cap: int. slot_ivl_ok (view_Vec_SlotModel_Global s.current) cap
        -> slot_ivl_ok (view_Vec_SlotModel_Global s.final) cap)
    /\ ([@stop_split] [@expl:slots_remove ensures #12] [%#slib'24] forall cap: int, sl: t_SlotModel. slot_ivl_ok (view_Vec_SlotModel_Global s.current) cap
          /\ result = Some sl -> UInt32.t'int sl.size > 0 /\ sl_end sl <= cap)
    /\ ([@stop_split] [@expl:slots_remove ensures #13] [%#slib'25] slots_disj (view_Vec_SlotModel_Global s.current)
