let%span slib'0 = "/home/cornel/mt-creusot/components/memory-tier/verif/src/lib.rs" 261 10 261 24
let%span slib'1 = "/home/cornel/mt-creusot/components/memory-tier/verif/src/lib.rs" 262 10 262 33

use creusot.int.UInt64
use creusot.prelude.Any

type tup2_usize_usize = { f0: UInt64.t; f1: UInt64.t }

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let clear_reset [#"/home/cornel/mt-creusot/components/memory-tier/verif/src/lib.rs" 263 0 263 54] (pool_size: UInt64.t)
  (return (x: tup2_usize_usize)) = (! bb0
  [ bb0 = s0
    [ s0 = [ &new_used <- [%#slib] (0: UInt64.t) ] s1
    | s1 = [ &new_capacity <- pool_size ] s2
    | s2 = [ &_ret <- { f0 = new_used; f1 = new_capacity } ] s3
    | s3 = return {_ret} ] ]
  [ & _ret: tup2_usize_usize = Any.any_l ()
  | & pool_size: UInt64.t = pool_size
  | & new_used: UInt64.t = Any.any_l ()
  | & new_capacity: UInt64.t = Any.any_l () ])
  [ return (result: tup2_usize_usize) ->
  {[@stop_split] [@expl:clear_reset ensures] ([@stop_split] [@expl:clear_reset ensures #0] [%#slib'0] UInt64.t'int result.f0
      = 0)
    /\ ([@stop_split] [@expl:clear_reset ensures #1] [%#slib'1] UInt64.t'int result.f1 = UInt64.t'int pool_size)}
    (! return {result}) ]
