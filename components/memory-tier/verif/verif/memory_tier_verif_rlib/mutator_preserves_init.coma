use creusot.int.UInt64
use creusot.prelude.Any

type t_TierState = { initialized: bool; capacity: UInt64.t; used: UInt64.t; spdk_allocated: bool }

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let mutator_preserves_init [#"/home/cornel/mt-creusot-rerun/components/memory-tier/verif/src/lib.rs" 345 0 345 77]
  (state: t_TierState) (new_used: UInt64.t) (return (x: t_TierState)) = (! bb0
  [ bb0 = s0
    [ s0 = [ &_ret <- { initialized = state.initialized;
                        capacity = state.capacity;
                        used = new_used;
                        spdk_allocated = state.spdk_allocated } ] s1
    | s1 = return {_ret} ] ]
  [ & _ret: t_TierState = Any.any_l () | & state: t_TierState = state | & new_used: UInt64.t = new_used ])
  [ return (result: t_TierState) -> (! return {result}) ]
