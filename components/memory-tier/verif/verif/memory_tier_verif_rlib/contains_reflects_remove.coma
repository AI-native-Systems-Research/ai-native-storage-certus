use creusot.int.UInt64
use creusot.int.UInt32
use map.Map
use int.Int

type t_FMap_u64_SlotMirror

type t_SlotMirror = { offset: UInt64.t; size: UInt32.t }

type t_Option_SlotMirror = None | Some t_SlotMirror

function to_mapping_u64 (self: t_FMap_u64_SlotMirror) : Map.map UInt64.t t_Option_SlotMirror

function get_u64 [@inline:trivial] (self: t_FMap_u64_SlotMirror) (k: UInt64.t) : t_Option_SlotMirror =
  [%#sfmap'2] Map.get (to_mapping_u64 self) k

meta "rewrite_def" function get_u64

predicate contains_u64 [@inline:trivial] (self: t_FMap_u64_SlotMirror) (k: UInt64.t) = [%#sfmap] get_u64 self k <> None

meta "rewrite_def" predicate contains_u64

function len_u64 (self: t_FMap_u64_SlotMirror) : int

axiom len_u64_spec: forall self: t_FMap_u64_SlotMirror [len_u64 self]. [%#sfmap'3] len_u64 self >= 0

function remove_u64 (self: t_FMap_u64_SlotMirror) (k: UInt64.t) : t_FMap_u64_SlotMirror

axiom remove_u64_spec:
  forall self: t_FMap_u64_SlotMirror, k: UInt64.t [remove_u64 self k]. [%#sfmap'0] to_mapping_u64 (remove_u64 self k)
    = Map.set (to_mapping_u64 self) k (None)

axiom remove_u64_spec'0:
  forall self: t_FMap_u64_SlotMirror, k: UInt64.t [remove_u64 self k]. [%#sfmap'1] len_u64 (remove_u64 self k)
