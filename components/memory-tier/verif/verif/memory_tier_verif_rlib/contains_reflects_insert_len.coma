use creusot.int.UInt64
use creusot.int.UInt32
use map.Map
use int.Int

type t_FMap_u64_SlotMirror

type t_SlotMirror = { offset: UInt64.t; size: UInt32.t }

type t_Option_SlotMirror = None | Some t_SlotMirror

function to_mapping_u64 (self: t_FMap_u64_SlotMirror) : Map.map UInt64.t t_Option_SlotMirror

function get_u64 [@inline:trivial] (self: t_FMap_u64_SlotMirror) (k: UInt64.t) : t_Option_SlotMirror =
  [%#sfmap'3] Map.get (to_mapping_u64 self) k

meta "rewrite_def" function get_u64

predicate contains_u64 [@inline:trivial] (self: t_FMap_u64_SlotMirror) (k: UInt64.t) = [%#sfmap] get_u64 self k <> None

meta "rewrite_def" predicate contains_u64

function len_u64 (self: t_FMap_u64_SlotMirror) : int

axiom len_u64_spec: forall self: t_FMap_u64_SlotMirror [len_u64 self]. [%#sfmap'0] len_u64 self >= 0

function insert_u64 (self: t_FMap_u64_SlotMirror) (k: UInt64.t) (v: t_SlotMirror) : t_FMap_u64_SlotMirror

axiom insert_u64_spec:
  forall self: t_FMap_u64_SlotMirror, k: UInt64.t, v: t_SlotMirror [insert_u64 self k v]. [%#sfmap'1] to_mapping_u64 (insert_u64 self k v)
    = Map.set (to_mapping_u64 self) k (Some v)

axiom insert_u64_spec'0:
  forall self: t_FMap_u64_SlotMirror, k: UInt64.t, v: t_SlotMirror [insert_u64 self k v]. [%#sfmap'2] len_u64 (insert_u64 self k v)
    = (if contains_u64 self k then len_u64 self else len_u64 self + 1)

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

