constant k : UInt64.t

constant v : t_SlotMirror

function contains_reflects_insert_len [#"/home/cornel/mt-creusot/components/memory-tier/verif/src/lib.rs" 638 0 638 84] (m: t_FMap_u64_SlotMirror) (k: UInt64.t) (v: t_SlotMirror) : ()

goal vc_contains_reflects_insert_len:
  [@stop_split] [@expl:contains_reflects_insert_len ensures] ([@stop_split] [@expl:contains_reflects_insert_len ensures #0] [%#slib] not contains_u64 m k
