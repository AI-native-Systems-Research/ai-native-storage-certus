use creusot.int.UInt64
use int.ComputerDivision
use creusot.prelude.Any
use int.Int

constant const_MAX: UInt64.t = (18446744073709551615: UInt64.t)

let align_up (size: UInt64.t) (return (x: UInt64.t)) =
{[@stop_split] [@expl:align_up requires] ([@stop_split] [@expl:align_up requires #0] [%#slib'5] UInt64.t'int size > 0)
  /\ ([@stop_split] [@expl:align_up requires #1] [%#slib'6] UInt64.t'int size + 4095 <= UInt64.t'int const_MAX)}
  any
  [ return (result: UInt64.t) ->
  {[@stop_split] [@expl:align_up ensures] ([@stop_split] [@expl:align_up ensures #0] [%#slib'7] ComputerDivision.mod (UInt64.t'int result) 4096
      = 0)
    /\ ([@stop_split] [@expl:align_up ensures #1] [%#slib'8] UInt64.t'int result >= UInt64.t'int size)
    /\ ([@stop_split] [@expl:align_up ensures #2] [%#slib'9] UInt64.t'int result > 0)
    /\ ([@stop_split] [@expl:align_up ensures #3] [%#slib'10] UInt64.t'int result < UInt64.t'int size + 4096)}
    (! return {result}) ]

type tup2_usize_usize = { f0: UInt64.t; f1: UInt64.t }

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let align_up_idempotent [#"/home/cornel/mt-creusot-rerun/components/memory-tier/verif/src/lib.rs" 249 0 249 57]
  (size: UInt64.t) (return (x: tup2_usize_usize)) =
{[@stop_split] [@expl:align_up_idempotent requires] ([@stop_split] [@expl:align_up_idempotent requires #0] [%#slib'1] UInt64.t'int size
    > 0)
  /\ ([@stop_split] [@expl:align_up_idempotent requires #1] [%#slib'2] UInt64.t'int size + 8191
  <= UInt64.t'int const_MAX)}
  (! bb0
  [ bb0 = s0
    [ s0 = align_up [%#slib] {size} (fun (_x: UInt64.t) -> [ &once <- _x ] s1)
    | s1 = align_up [%#slib'0] {once} (fun (_x: UInt64.t) -> [ &twice <- _x ] s2)
    | s2 = [ &_ret <- { f0 = once; f1 = twice } ] s3
    | s3 = return {_ret} ] ]
  [ & _ret: tup2_usize_usize = Any.any_l ()
  | & size: UInt64.t = size
  | & once: UInt64.t = Any.any_l ()
  | & twice: UInt64.t = Any.any_l () ])
  [ return (result: tup2_usize_usize) ->
  {[@stop_split] [@expl:align_up_idempotent ensures] ([@stop_split] [@expl:align_up_idempotent ensures #0] [%#slib'3] ComputerDivision.mod (UInt64.t'int result.f0) 4096
      = 0)
    /\ ([@stop_split] [@expl:align_up_idempotent ensures #1] [%#slib'4] UInt64.t'int result.f1
    = UInt64.t'int result.f0)}
    (! return {result}) ]
