    | s1 = align_up [%#slib'0] {once} (fun (_x: UInt64.t) -> [ &twice <- _x ] s2)
    | s2 = [ &_ret <- { f0 = once; f1 = twice } ] s3
    | s3 = return {_ret} ] ]
  [ & _ret: tup2_usize_usize = Any.any_l ()
  | & size: UInt64.t = size
  | & once: UInt64.t = Any.any_l ()
  | & twice: UInt64.t = Any.any_l () ]) [ return (result: tup2_usize_usize) -> (! return {result}) ]
