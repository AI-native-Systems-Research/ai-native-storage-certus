let dm_try_evict_to_block (d: MutBorrow.t t_Dm) (key: UInt64.t) (return (x: t_Result_unit_DmError)) =
{[@stop_split] [@expl:dm_try_evict_to_block 'd' type invariant] [%#score] inv_refmut_Dm d}
  any
  [ return (result: t_Result_unit_DmError) ->
  {[@stop_split] [@expl:dm_try_evict_to_block ensures] ([@stop_split] [@expl:dm_try_evict_to_block ensures #0] [%#score'0] not has d.current key
      -> result = Err (KeyNotFound key) /\ same_map d.final d.current)
    /\ ([@stop_split] [@expl:dm_try_evict_to_block ensures #1] [%#score'1] has d.current key
        /\ not evictable (ent d.current key) -> result = Err (InvalidState) /\ same_map d.final d.current)
    /\ ([@stop_split] [@expl:dm_try_evict_to_block ensures #2] [%#score'2] has d.current key
        /\ evictable (ent d.current key)
      -> result = Ok ()
      /\ has d.final key
      /\ others_same d.final d.current key
      /\ Some'4 ((ent d.final key).location)
        = map_Option_u64 (ssd_of (ent d.current key).location) (fun (o: UInt64.t) -> BlockDevice o)
      /\ keep_but_loc (ent d.final key) (ent d.current key))
    /\ ([@stop_split] [@expl:dm_try_evict_to_block ensures #3] [%#score'3] rest_same d.current d.final)
    /\ ([@stop_split] [@expl:dm_try_evict_to_block ensures #4] [%#score'4] wf d.current -> wf_entries d.final)
    /\ ([@stop_split] [@expl:dm_try_evict_to_block ensures #5] [%#score'5] wf d.current -> wf_pool d.final)
    /\ ([@stop_split] [@expl:dm_try_evict_to_block ensures #6] [%#score'6] wf d.current -> wf_fwd d.final)
    /\ ([@stop_split] [@expl:dm_try_evict_to_block ensures #7] [%#score'7] wf d.current -> wf_back d.final)}
    (! return {result}) ]

