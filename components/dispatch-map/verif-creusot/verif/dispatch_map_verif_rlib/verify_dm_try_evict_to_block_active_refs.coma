          [ &_8 <- _bor ] -{inv_Dm _bor.final}-
          [ &d <- { d with current = _bor.final } ] s1) [ _ck -> (! {[@expl:type invariant] inv_Dm d.current} any) ]
    | s1 = dm_try_evict_to_block [%#sdrivers] {_8} {key} (fun (_x: t_Result_unit_DmError) -> [ &_ret <- _x ] s2)
    | s2 = s3 [ _ck -> (! {[@expl:type invariant] inv_refmut_Dm d} any) ]
    | s3 = -{resolve_refmut_Dm d}- s4
    | s4 = return {_ret} ] ]
  [ & _ret: t_Result_unit_DmError = Any.any_l ()
  | & d: MutBorrow.t t_Dm = d
  | & key: UInt64.t = key
  | & _8: MutBorrow.t t_Dm = Any.any_l () ])
  [ return (result: t_Result_unit_DmError) ->
  {[@stop_split] [@expl:verify_dm_try_evict_to_block_active_refs ensures] [%#sdrivers'2] result = Err (InvalidState)
    /\ same_map d.final d.current}
    (! return {result}) ]
