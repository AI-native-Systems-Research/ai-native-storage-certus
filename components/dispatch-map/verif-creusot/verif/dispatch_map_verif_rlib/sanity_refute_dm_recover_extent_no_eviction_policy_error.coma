let dm_recover_extent (d: MutBorrow.t t_Dm) (key: UInt64.t) (offset: UInt64.t) (size_blocks'0: UInt32.t)
  (return (x: t_Out_Result_unit_DmError)) =
{[@stop_split] [@expl:dm_recover_extent 'd' type invariant] [%#score] inv_refmut_Dm d}
  any
  [ return (result: t_Out_Result_unit_DmError) ->
  {[@stop_split] [@expl:dm_recover_extent ensures] ([@stop_split] [@expl:dm_recover_extent ensures #0] [%#score'0] d.current.ep
        = None'0 -> result = Panic)
    /\ ([@stop_split] [@expl:dm_recover_extent ensures #1] [%#score'1] wf d.current /\ d.current.ep <> None'0
      -> result <> Panic)
    /\ ([@stop_split] [@expl:dm_recover_extent ensures #2] [%#score'2] result <> Panic /\ d.current.pool_id <> None
      -> npools'0 d.final = npools'0 d.current)
    /\ ([@stop_split] [@expl:dm_recover_extent ensures #3] [%#score'3] result <> Panic
      -> (forall h: t_Handle. contains_Handle (trk d.final) h /\ not contains_Handle (trk d.current) h
        -> Some ((lookup_Handle (trk d.final) h).f0'0) = d.final.pool_id))
    /\ ([@stop_split] [@expl:dm_recover_extent ensures #4] [%#score'4] result <> Panic
      -> (forall h: t_Handle. contains_Handle (trk d.current) h
        -> get_Handle (trk d.final) h = get_Handle (trk d.current) h))
    /\ ([@stop_split] [@expl:dm_recover_extent ensures #5] [%#score'5] result <> Panic
      -> d.final.em = d.current.em /\ d.final.cv = d.current.cv)
    /\ ([@stop_split] [@expl:dm_recover_extent ensures #6] [%#score'6] result <> Panic
      -> match d.current.pool_id with
        | Some p -> d.final.pool_id = Some p
        | None -> true
        end)
    /\ ([@stop_split] [@expl:dm_recover_extent ensures #7] [%#score'7] has d.current key /\ result <> Panic
      -> result = Ret (Err (AlreadyExists key)) /\ same_map d.final d.current /\ trk d.final = trk d.current)
    /\ ([@stop_split] [@expl:dm_recover_extent ensures #8] [%#score'8] match result with
        | Ret (Ok ()) -> not has d.current key
        /\ has d.final key
        /\ others_same d.final d.current key
        /\ (ent d.final key).location = BlockDevice offset
        /\ (ent d.final key).size_blocks = size_blocks'0
        /\ UInt32.t'int (ent d.final key).read_ref = 0
        /\ UInt32.t'int (ent d.final key).write_ref = 0
        /\ UInt32.t'int (ent d.final key).checksum = 0
        /\ d.final.pool_id <> None
        /\ Some'4 (lookup_Handle (trk d.final) (ent d.final key).eviction_handle)
          = map_Option_u32 d.final.pool_id (fun (p: UInt32.t) -> { f0'0 = p; f1'0 = key })
        /\ contains_Handle (trk d.final) (ent d.final key).eviction_handle
        | Ret (Err e) -> same_map d.final d.current /\ trk d.final = trk d.current /\ e = AlreadyExists key
        | Panic -> true
        end)
    /\ ([@stop_split] [@expl:dm_recover_extent ensures #9] [%#score'9] wf d.current
        /\ a_fr023 size_blocks'0 /\ result <> Panic -> wf_entries d.final)
    /\ ([@stop_split] [@expl:dm_recover_extent ensures #10] [%#score'10] wf d.current
        /\ a_fr023 size_blocks'0 /\ result <> Panic -> wf_pool d.final)
    /\ ([@stop_split] [@expl:dm_recover_extent ensures #11] [%#score'11] wf d.current
        /\ a_fr023 size_blocks'0 /\ result <> Panic -> wf_fwd d.final)
    /\ ([@stop_split] [@expl:dm_recover_extent ensures #12] [%#score'12] wf d.current
        /\ a_fr023 size_blocks'0 /\ result <> Panic -> wf_back d.final)
    /\ ([@stop_split] [@expl:dm_recover_extent ensures #13] [%#score'13] result = Panic -> d.final = d.current)}
    (! return {result}) ]

