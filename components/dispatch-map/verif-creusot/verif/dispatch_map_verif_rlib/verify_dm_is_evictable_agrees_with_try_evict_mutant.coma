    /\ ([@stop_split] [@expl:dm_try_evict_to_block ensures #5] [%#score'8] wf d.current -> wf_pool d.final)
    /\ ([@stop_split] [@expl:dm_try_evict_to_block ensures #6] [%#score'9] wf d.current -> wf_fwd d.final)
    /\ ([@stop_split] [@expl:dm_try_evict_to_block ensures #7] [%#score'10] wf d.current -> wf_back d.final)}
    (! return {result}) ]

