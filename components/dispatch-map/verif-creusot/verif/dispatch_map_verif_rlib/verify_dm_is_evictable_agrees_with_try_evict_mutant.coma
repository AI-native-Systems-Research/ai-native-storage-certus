{[@stop_split] [@expl:dm_try_evict_to_block 'd' type invariant] [%#score'2] inv_refmut_Dm d}
  any
  [ return (result: t_Result_unit_DmError) ->
  {[@stop_split] [@expl:dm_try_evict_to_block ensures] ([@stop_split] [@expl:dm_try_evict_to_block ensures #0] [%#score'3] not has d.current key
      -> result = Err (KeyNotFound key) /\ same_map d.final d.current)
    /\ ([@stop_split] [@expl:dm_try_evict_to_block ensures #1] [%#score'4] has d.current key
        /\ not evictable (ent d.current key) -> result = Err (InvalidState) /\ same_map d.final d.current)
    /\ ([@stop_split] [@expl:dm_try_evict_to_block ensures #2] [%#score'5] has d.current key
        /\ evictable (ent d.current key)
