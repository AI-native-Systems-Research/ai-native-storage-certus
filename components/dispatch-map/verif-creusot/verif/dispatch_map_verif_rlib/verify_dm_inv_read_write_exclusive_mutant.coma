  [%#score'194] contains_u64 (view_Entries d.entries) k

predicate index_Mapping_Entry_bool [@inline:trivial] (self: Map.map t_Entry bool) (a: t_Entry) =
  [%#smapping] Map.get self a

meta "rewrite_def" predicate index_Mapping_Entry_bool

function such_that_Entry (p: Map.map t_Entry bool) : t_Entry

axiom such_that_Entry_spec:
  forall p: Map.map t_Entry bool [such_that_Entry p]. ([%#slogic] exists x: t_Entry. index_Mapping_Entry_bool p x)
    -> ([%#slogic'0] index_Mapping_Entry_bool p (such_that_Entry p))

function unwrap_Option_Entry (self: t_Option_Entry) : t_Entry = [%#soption'1] match self with
    | Some'3 x -> x
    | None'3 -> such_that_Entry (fun (__0: t_Entry) -> true)
    end

function lookup_u64 [@inline:trivial] (self: t_FMap_u64_Entry) (k: UInt64.t) : t_Entry =
  [%#sfmap'0] unwrap_Option_Entry (get_u64 self k)

meta "rewrite_def" function lookup_u64

function ent [#"/home/cornel/cv-dispatch-map-20261005/components/dispatch-map/verif-creusot/src/core.rs" 255 0 255 34] (d: t_Dm) (k: UInt64.t) : t_Entry
 = [%#score'195] lookup_u64 (view_Entries d.entries) k

let dm_get_checksum (d: MutBorrow.t t_Dm) (key: UInt64.t) (return (x: t_Option_u32)) =
{[@stop_split] [@expl:dm_get_checksum 'd' type invariant] [%#score] inv_refmut_Dm d}
  any
  [ return (result: t_Option_u32) ->
  {[@stop_split] [@expl:dm_get_checksum ensures] ([@stop_split] [@expl:dm_get_checksum ensures #0] [%#score'0] not has d.current key
      -> result = None)
    /\ ([@stop_split] [@expl:dm_get_checksum ensures #1] [%#score'1] has d.current key
        /\ UInt32.t'int (ent d.current key).checksum = 0 -> result = None)
    /\ ([@stop_split] [@expl:dm_get_checksum ensures #2] [%#score'2] has d.current key
        /\ UInt32.t'int (ent d.current key).checksum <> 0 -> result = Some ((ent d.current key).checksum))
    /\ ([@stop_split] [@expl:dm_get_checksum ensures #3] [%#score'3] d.final = d.current)}
    (! return {result}) ]

predicate resolve_refmut_Dm [@inline:trivial] (_1: MutBorrow.t t_Dm) = _1.final = _1.current

meta "rewrite_def" predicate resolve_refmut_Dm

