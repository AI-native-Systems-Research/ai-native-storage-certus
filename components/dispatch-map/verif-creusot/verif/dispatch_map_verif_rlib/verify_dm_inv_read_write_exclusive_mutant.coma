  | GetChecksum UInt64.t

let elim_GetChecksum (_x: t_Op) (return (f0: UInt64.t)) = any
  [ _k (f0: UInt64.t) -> {GetChecksum f0 = _x} (! return {f0})
  | _chk -> (! {[@expl:elim GetChecksum] match _x with
      | GetChecksum _ -> true
      | _ -> false
      end}
    any) ]

