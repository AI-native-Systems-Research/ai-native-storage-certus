  [ return (result: t_Option_u32) ->
  {[@stop_split] [@expl:dm_get_checksum ensures] ([@stop_split] [@expl:dm_get_checksum ensures #0] [%#score'0] not has d.current key
      -> result = None)
    /\ ([@stop_split] [@expl:dm_get_checksum ensures #1] [%#score'1] has d.current key
        /\ UInt32.t'int (ent d.current key).checksum = 0 -> result = None)
    /\ ([@stop_split] [@expl:dm_get_checksum ensures #2] [%#score'2] has d.current key
        /\ UInt32.t'int (ent d.current key).checksum <> 0 -> result = Some ((ent d.current key).checksum))
    /\ ([@stop_split] [@expl:dm_get_checksum ensures #3] [%#score'3] d.final = d.current)}
    (! return {result}) ]

