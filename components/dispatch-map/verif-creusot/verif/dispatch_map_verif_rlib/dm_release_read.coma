    | s2 = MutBorrow.borrow_final <t_Cv> {d.current.cv} {MutBorrow.inherit_id (MutBorrow.get_id d) 4}
        (fun (_bor: MutBorrow.t t_Cv) ->
          [ &_37 <- _bor ] [ &d <- { d with current = { d.current with cv = _bor.final } } ] s3)
    | s3 = notify_all [%#score'3] {_37} (fun (_x: ()) -> [ &_36 <- _x ] s4)
    | s4 = s5 [ _ck -> (! {[@expl:type invariant] inv_refmut_Dm d} any) ]
    | s5 = -{resolve_refmut_Dm d}- s6
    | s6 = [ &_ret <- Ok _38 ] s7
    | s7 = return {_ret} ]
  | bb4 = s0
    [ s0 = s1 [ _ck -> (! {[@expl:type invariant] inv_refmut_Dm d} any) ]
    | s1 = -{resolve_refmut_Dm d}- s2
    | s2 = [ &_28 <- KeyNotFound key ] s3
    | s3 = [ &_ret <- Err _28 ] s4
    | s4 = return {_ret} ] ]
  [ & _ret: t_Result_unit_DmError = Any.any_l ()
  | & d: MutBorrow.t t_Dm = d
  | & key: UInt64.t = key
  | & entry: MutBorrow.t t_Entry = Any.any_l ()
  | & _21: t_Option_refmut_Entry = Any.any_l ()
  | & _22: MutBorrow.t t_Entries = Any.any_l ()
  | & _24: UInt64.t = Any.any_l ()
  | & e: MutBorrow.t t_Entry = Any.any_l ()
  | & _28: t_DmError = Any.any_l ()
  | & _31: bool = Any.any_l ()
  | & _34: t_DmError = Any.any_l ()
  | & _36: () = Any.any_l ()
  | & _37: MutBorrow.t t_Cv = Any.any_l ()
  | & _38: () = Any.any_l () ])
  [ return (result: t_Result_unit_DmError) ->
  {[@stop_split] [@expl:dm_release_read ensures] ([@stop_split] [@expl:dm_release_read ensures #0] [%#score'5] not has d.current key
      -> result = Err (KeyNotFound key) /\ same_map d.final d.current /\ rest_same d.current d.final)
    /\ ([@stop_split] [@expl:dm_release_read ensures #1] [%#score'6] has d.current key
        /\ UInt32.t'int (ent d.current key).read_ref = 0
      -> result = Err (RefCountUnderflow key) /\ same_map d.final d.current /\ rest_same d.current d.final)
    /\ ([@stop_split] [@expl:dm_release_read ensures #2] [%#score'7] has d.current key
        /\ UInt32.t'int (ent d.current key).read_ref > 0
      -> result = Ok ()
      /\ rest_notified d.current d.final
      /\ has d.final key
      /\ UInt32.t'int (ent d.final key).read_ref = UInt32.t'int (ent d.current key).read_ref - 1
      /\ (ent d.final key).write_ref = (ent d.current key).write_ref
      /\ (ent d.final key).reuse_count = (ent d.current key).reuse_count
      /\ keep_meta (ent d.final key) (ent d.current key) /\ others_same d.final d.current key)
    /\ ([@stop_split] [@expl:dm_release_read ensures #3] [%#score'8] wf d.current -> wf_entries d.final)
    /\ ([@stop_split] [@expl:dm_release_read ensures #4] [%#score'9] wf d.current -> wf_pool d.final)
    /\ ([@stop_split] [@expl:dm_release_read ensures #5] [%#score'10] wf d.current -> wf_fwd d.final)
    /\ ([@stop_split] [@expl:dm_release_read ensures #6] [%#score'11] wf d.current -> wf_back d.final)}
    (! return {result}) ]
