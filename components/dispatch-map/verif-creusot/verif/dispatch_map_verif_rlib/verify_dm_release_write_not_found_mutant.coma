let dm_release_write (d: MutBorrow.t t_Dm) (key: UInt64.t) (return (x: t_Result_unit_DmError)) =
{[@stop_split] [@expl:dm_release_write 'd' type invariant] [%#score] inv_refmut_Dm d}
  any
  [ return (result: t_Result_unit_DmError) ->
  {[@stop_split] [@expl:dm_release_write ensures] ([@stop_split] [@expl:dm_release_write ensures #0] [%#score'0] not has d.current key
      -> result = Err (KeyNotFound key) /\ same_map d.final d.current /\ rest_same d.current d.final)
    /\ ([@stop_split] [@expl:dm_release_write ensures #1] [%#score'1] has d.current key
        /\ UInt32.t'int (ent d.current key).write_ref = 0
      -> result = Err (RefCountUnderflow key) /\ same_map d.final d.current /\ rest_same d.current d.final)
    /\ ([@stop_split] [@expl:dm_release_write ensures #2] [%#score'2] has d.current key
        /\ UInt32.t'int (ent d.current key).write_ref <> 0
      -> result = Ok ()
      /\ rest_notified d.current d.final
      /\ has d.final key
      /\ UInt32.t'int (ent d.final key).write_ref = 0
      /\ (ent d.final key).read_ref = (ent d.current key).read_ref
      /\ (ent d.final key).reuse_count = (ent d.current key).reuse_count
      /\ keep_meta (ent d.final key) (ent d.current key) /\ others_same d.final d.current key)
    /\ ([@stop_split] [@expl:dm_release_write ensures #3] [%#score'3] wf d.current -> wf_entries d.final)
    /\ ([@stop_split] [@expl:dm_release_write ensures #4] [%#score'4] wf d.current -> wf_pool d.final)
    /\ ([@stop_split] [@expl:dm_release_write ensures #5] [%#score'5] wf d.current -> wf_fwd d.final)
    /\ ([@stop_split] [@expl:dm_release_write ensures #6] [%#score'6] wf d.current -> wf_back d.final)}
    (! return {result}) ]

