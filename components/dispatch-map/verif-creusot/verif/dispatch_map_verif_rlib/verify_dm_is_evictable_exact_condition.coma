let dm_is_evictable (d: MutBorrow.t t_Dm) (key: UInt64.t) (return (x: bool)) =
{[@stop_split] [@expl:dm_is_evictable 'd' type invariant] [%#score] inv_refmut_Dm d}
  any
  [ return (result: bool) ->
  {[@stop_split] [@expl:dm_is_evictable ensures] ([@stop_split] [@expl:dm_is_evictable ensures #0] [%#score'0] result
      = (has d.current key /\ evictable (ent d.current key)))
    /\ ([@stop_split] [@expl:dm_is_evictable ensures #1] [%#score'1] d.final = d.current)}
    (! return {result}) ]

