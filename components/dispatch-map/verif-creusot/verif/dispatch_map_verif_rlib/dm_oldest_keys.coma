        | Panic -> false
        end)
    /\ ([@stop_split] [@expl:get_pool_id ensures #5] [%#score'21] match result with
        | Ret p -> d.final.pool_id = Some p
        | Panic -> d.final = d.current
        end)
    /\ ([@stop_split] [@expl:get_pool_id ensures #6] [%#score'22] wf d.current -> wf_entries d.final)
    /\ ([@stop_split] [@expl:get_pool_id ensures #7] [%#score'23] wf d.current -> wf_pool d.final)
    /\ ([@stop_split] [@expl:get_pool_id ensures #8] [%#score'24] wf d.current -> wf_fwd d.final)
    /\ ([@stop_split] [@expl:get_pool_id ensures #9] [%#score'25] wf d.current -> wf_back d.final)}
