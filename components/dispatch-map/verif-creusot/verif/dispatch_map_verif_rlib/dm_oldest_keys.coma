        = d.current.entries
      /\ d.final.em = d.current.em /\ d.final.cv = d.current.cv)
    /\ ([@stop_split] [@expl:get_pool_id ensures #1] [%#score'17] trk d.final = trk d.current
      /\ npools'0 d.current <= npools'0 d.final /\ (d.final.ep = None'0) = (d.current.ep = None'0))
    /\ ([@stop_split] [@expl:get_pool_id ensures #2] [%#score'18] match d.current.pool_id with
        | Some p -> result = Ret p /\ d.final = d.current
        | None -> true
        end)
    /\ ([@stop_split] [@expl:get_pool_id ensures #3] [%#score'19] d.current.pool_id = None /\ d.current.ep = None'0
      -> result = Panic /\ d.final = d.current)
    /\ ([@stop_split] [@expl:get_pool_id ensures #4] [%#score'20] d.current.pool_id = None /\ d.current.ep <> None'0
      -> match result with
