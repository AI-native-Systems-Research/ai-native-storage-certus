    /\ ([@stop_split] [@expl:get_pool_id ensures #6] [%#score'7] wf d.current -> wf_entries d.final)
    /\ ([@stop_split] [@expl:get_pool_id ensures #7] [%#score'8] wf d.current -> wf_pool d.final)
    /\ ([@stop_split] [@expl:get_pool_id ensures #8] [%#score'9] wf d.current -> wf_fwd d.final)
    /\ ([@stop_split] [@expl:get_pool_id ensures #9] [%#score'10] wf d.current -> wf_back d.final)}
    (! return {result}) ]
