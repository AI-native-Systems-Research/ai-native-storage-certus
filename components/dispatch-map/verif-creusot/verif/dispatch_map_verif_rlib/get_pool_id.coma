    /\ ([@stop_split] [@expl:get_pool_id ensures #3] [%#score'4] match d.current.pool_id'0 with
        | Some p -> result = Ret p /\ d.final = d.current
        | None -> true
        end)
    /\ ([@stop_split] [@expl:get_pool_id ensures #4] [%#score'5] d.current.pool_id'0 = None /\ d.current.ep'0 = None'0
      -> result = Panic /\ d.final = d.current)
    /\ ([@stop_split] [@expl:get_pool_id ensures #5] [%#score'6] d.current.pool_id'0 = None /\ d.current.ep'0 <> None'0
      -> match result with
        | Ret p -> d.final.pool_id'0 = Some p /\ UInt32.t'int p < npools'0 d.final /\ pool_fresh d.current p
        | Panic -> false
        end)
    /\ ([@stop_split] [@expl:get_pool_id ensures #6] [%#score'7] match result with
        | Ret p -> d.final.pool_id'0 = Some p
        | Panic -> d.final = d.current
        end)
    /\ ([@stop_split] [@expl:get_pool_id ensures #7] [%#score'8] wf d.current -> wf_entries d.final)
    /\ ([@stop_split] [@expl:get_pool_id ensures #8] [%#score'9] wf d.current -> wf_pool d.final)
    /\ ([@stop_split] [@expl:get_pool_id ensures #9] [%#score'10] wf d.current -> wf_fwd d.final)
    /\ ([@stop_split] [@expl:get_pool_id ensures #10] [%#score'11] wf d.current -> wf_back d.final)}
    (! return {result}) ]
