let dm_oldest_keys (d: MutBorrow.t t_Dm) (n: UInt64.t) (return (x: t_Out_Vec_u64_Global)) =
{[@stop_split] [@expl:dm_oldest_keys 'd' type invariant] [%#score] inv_refmut_Dm d}
  any
  [ return (result: t_Out_Vec_u64_Global) ->
  {[@stop_split] [@expl:dm_oldest_keys ensures] ([@stop_split] [@expl:dm_oldest_keys ensures #0] [%#score'0] same_map d.final d.current
      /\ d.final.em'0 = d.current.em'0 /\ d.final.cv'0 = d.current.cv'0 /\ trk d.final = trk d.current)
    /\ ([@stop_split] [@expl:dm_oldest_keys ensures #1] [%#score'1] match d.current.pool_id'0 with
        | Some p -> d.final.pool_id'0 = Some p
        | None -> true
        end)
    /\ ([@stop_split] [@expl:dm_oldest_keys ensures #2] [%#score'2] d.current.pool_id'0 = None
        /\ d.current.ep'0 = None'0 -> result = Panic)
    /\ ([@stop_split] [@expl:dm_oldest_keys ensures #3] [%#score'3] d.current.pool_id'0 <> None
      -> npools'0 d.final = npools'0 d.current)
    /\ ([@stop_split] [@expl:dm_oldest_keys ensures #4] [%#score'4] d.current.pool_id'0 <> None
        /\ d.current.ep'0 = None'0
      -> match result with
        | Ret v -> Seq.length (view_Vec_u64_Global v) = 0
        | Panic -> false
        end)
    /\ ([@stop_split] [@expl:dm_oldest_keys ensures #5] [%#score'5] d.current.ep'0 <> None'0 -> result <> Panic)
    /\ ([@stop_split] [@expl:dm_oldest_keys ensures #6] [%#score'6] match result with
        | Ret v -> Seq.length (view_Vec_u64_Global v) <= UInt64.t'int n
        /\ (forall i: int. 0 <= i /\ i < Seq.length (view_Vec_u64_Global v)
          -> (exists h: t_Handle. Some'4 (lookup_Handle (trk d.final) h)
              = map_Option_u32 d.final.pool_id'0 (fun (p: UInt32.t) -> { f0'0 = p;
                                                                         f1'0 = Seq.get (view_Vec_u64_Global v) i })
            /\ contains_Handle (trk d.final) h))
        | Panic -> true
        end)
    /\ ([@stop_split] [@expl:dm_oldest_keys ensures #7] [%#score'7] wf d.current -> wf_entries d.final)
    /\ ([@stop_split] [@expl:dm_oldest_keys ensures #8] [%#score'8] wf d.current -> wf_pool d.final)
    /\ ([@stop_split] [@expl:dm_oldest_keys ensures #9] [%#score'9] wf d.current -> wf_fwd d.final)
    /\ ([@stop_split] [@expl:dm_oldest_keys ensures #10] [%#score'10] wf d.current -> wf_back d.final)
    /\ ([@stop_split] [@expl:dm_oldest_keys ensures #11] [%#score'11] result = Panic -> d.final = d.current)
    /\ ([@stop_split] [@expl:dm_oldest_keys ensures #12] [%#score'12] uses'0 d.final = uses'0 d.current
      /\ (d.final.ep'0 = None'0) = (d.current.ep'0 = None'0))
    /\ ([@stop_split] [@expl:dm_oldest_keys ensures #13] [%#score'13] match result with
      | Ret v -> match d.final.ep'0 with
        | Some'0 e -> match d.final.pool_id'0 with
          | Some p -> view_Vec_u64_Global v = cands e p n
          | None -> false
          end
        | None'0 -> Seq.length (view_Vec_u64_Global v) = 0
        end
      | Panic -> true
