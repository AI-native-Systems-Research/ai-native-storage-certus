use int.ComputerDivision
use map.Const
use creusot.prelude.Any
use int.Int

type t_Op =
  | Initialize
  | Lookup UInt64.t
  | ConvertToStorage UInt64.t UInt64.t
  | TakeRead UInt64.t
  | TakeWrite UInt64.t
  | ReleaseRead UInt64.t
  | ReleaseWrite UInt64.t
  | Downgrade UInt64.t
  | Remove UInt64.t
  | Touch UInt64.t
  | EntrySize UInt64.t
  | OldestKeys UInt64.t
  | CreateMt UInt64.t Opaque.ptr UInt32.t
  | ConvertMtToBlock UInt64.t
  | Promote UInt64.t Opaque.ptr UInt32.t
  | IsEvictable UInt64.t
  | TryEvict UInt64.t
  | RecoverExtent UInt64.t UInt64.t UInt32.t
  | SetChecksum UInt64.t UInt32.t
  | GetChecksum UInt64.t

let elim_GetChecksum (_x: t_Op) (return (f0: UInt64.t)) = any
  [ _k (f0: UInt64.t) -> {GetChecksum f0 = _x} (! return {f0})
  | _chk -> (! {[@expl:elim GetChecksum] match _x with
      | GetChecksum _ -> true
      | _ -> false
      end}
    any) ]

type t_HashMap_u64_Entry_RandomState_Global

predicate inv_HashMap_u64_Entry_RandomState_Global (_1: t_HashMap_u64_Entry_RandomState_Global)

type t_Entries = { f0: t_HashMap_u64_Entry_RandomState_Global }

predicate inv_Entries (_1: t_Entries)

axiom inv_axiom [@rewrite]: forall x: t_Entries [inv_Entries x]. inv_Entries x
    = inv_HashMap_u64_Entry_RandomState_Global x.f0

type t_Option_u32 = None | Some UInt32.t

type t_FMap_Handle_tup2_u32_u64

type t_Handle = { pool_id: UInt32.t; index: UInt32.t }

type t_Ep = { npools: int; tracked: t_FMap_Handle_tup2_u32_u64; uses: Seq.seq t_Handle }

type t_Option_Ep = None'0 | Some'0 t_Ep

type t_Vec_Extent_Global

type t_Em = { extents: t_Vec_Extent_Global }

type t_Option_Em = None'1 | Some'1 t_Em

type t_Cv = { epoch: int }

type t_Dm = { entries'0: t_Entries; pool_id'0: t_Option_u32; ep'0: t_Option_Ep; em'0: t_Option_Em; cv'0: t_Cv }

predicate inv_Dm (_1: t_Dm)

axiom inv_axiom'0 [@rewrite]: forall x: t_Dm [inv_Dm x]. inv_Dm x = inv_Entries x.entries'0

predicate invariant_refmut_Dm [@inline:trivial] (self: MutBorrow.t t_Dm) =
  [%#sinvariant] inv_Dm self.current /\ inv_Dm self.final

meta "rewrite_def" predicate invariant_refmut_Dm

predicate inv_refmut_Dm [@inline:trivial] (_1: MutBorrow.t t_Dm) = invariant_refmut_Dm _1

meta "rewrite_def" predicate inv_refmut_Dm

type t_FMap_u64_Entry

type t_Option_u64 = None'2 | Some'2 UInt64.t

type t_Location = BlockDevice UInt64.t | MemoryTier Opaque.ptr UInt32.t t_Option_u64

type t_Entry = {
  location: t_Location;
  size_blocks: UInt32.t;
  read_ref: UInt32.t;
  write_ref: UInt32.t;
  eviction_handle: t_Handle;
  reuse_count: UInt32.t;
  checksum: UInt32.t }

type t_Option_Entry = None'3 | Some'3 t_Entry

function to_mapping_u64 (self: t_FMap_u64_Entry) : Map.map UInt64.t t_Option_Entry

function get_u64 [@inline:trivial] (self: t_FMap_u64_Entry) (k: UInt64.t) : t_Option_Entry =
  [%#sfmap'1] Map.get (to_mapping_u64 self) k

meta "rewrite_def" function get_u64

predicate contains_u64 [@inline:trivial] (self: t_FMap_u64_Entry) (k: UInt64.t) = [%#sfmap] get_u64 self k <> None'3

meta "rewrite_def" predicate contains_u64

function view_Entries [#"/home/cornel/cv-dispatch-map-20261005/components/dispatch-map/verif-creusot/src/core.rs" 94 4 94 37] (self: t_Entries) : t_FMap_u64_Entry

predicate has [#"/home/cornel/cv-dispatch-map-20261005/components/dispatch-map/verif-creusot/src/core.rs" 268 0 268 33] (d: t_Dm) (k: UInt64.t) =
  [%#score'204] contains_u64 (view_Entries d.entries'0) k

predicate index_Mapping_Entry_bool [@inline:trivial] (self: Map.map t_Entry bool) (a: t_Entry) =
  [%#smapping] Map.get self a

meta "rewrite_def" predicate index_Mapping_Entry_bool

function such_that_Entry (p: Map.map t_Entry bool) : t_Entry

axiom such_that_Entry_spec:
  forall p: Map.map t_Entry bool [such_that_Entry p]. ([%#slogic] exists x: t_Entry. index_Mapping_Entry_bool p x)
    -> ([%#slogic'0] index_Mapping_Entry_bool p (such_that_Entry p))

function unwrap_Option_Entry (self: t_Option_Entry) : t_Entry = [%#soption'1] match self with
