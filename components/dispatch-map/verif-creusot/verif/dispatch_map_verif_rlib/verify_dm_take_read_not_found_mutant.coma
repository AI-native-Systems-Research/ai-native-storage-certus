    /\ ([@stop_split] [@expl:dm_take_read ensures #2] [%#score'2] wf d.current -> wf_entries d.final)
    /\ ([@stop_split] [@expl:dm_take_read ensures #3] [%#score'3] wf d.current -> wf_pool d.final)
    /\ ([@stop_split] [@expl:dm_take_read ensures #4] [%#score'4] wf d.current -> wf_fwd d.final)
    /\ ([@stop_split] [@expl:dm_take_read ensures #5] [%#score'5] wf d.current -> wf_back d.final)
    /\ ([@stop_split] [@expl:dm_take_read ensures #6] [%#score'6] rest_same result.f1'0 d.final)
    /\ ([@stop_split] [@expl:dm_take_read ensures #7] [%#score'7] not pred_holds result.f1'0 key (NoWriter)
