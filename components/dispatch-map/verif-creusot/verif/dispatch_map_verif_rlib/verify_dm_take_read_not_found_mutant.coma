    | s1 = dm_take_read [%#sdrivers] {_7} {key} (fun (_x: tup2_Result_unit_DmError_Snapshot_Dm) -> [ &_ret <- _x ] s2)
    | s2 = s3 [ _ck -> (! {[@expl:type invariant] inv_refmut_Dm d} any) ]
    | s3 = -{resolve_refmut_Dm d}- s4
    | s4 = return {_ret} ] ]
  [ & _ret: tup2_Result_unit_DmError_Snapshot_Dm = Any.any_l ()
  | & d: MutBorrow.t t_Dm = d
  | & key: UInt64.t = key
  | & _7: MutBorrow.t t_Dm = Any.any_l () ])
  [ return (result: tup2_Result_unit_DmError_Snapshot_Dm) ->
  {[@stop_split] [@expl:verify_dm_take_read_not_found__mutant ensures] [%#sdrivers'2] result.f0'0 = Ok ()}
    (! return {result}) ]
