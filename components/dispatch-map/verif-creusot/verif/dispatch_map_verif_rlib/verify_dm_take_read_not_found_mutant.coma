    /\ ([@stop_split] [@expl:dm_take_read ensures #10] [%#score'10] pred_holds result.f1'0 key (NoWriter)
      /\ has result.f1'0 key /\ UInt32.t'int (ent result.f1'0 key).read_ref < UInt32.t'int const_MAX
