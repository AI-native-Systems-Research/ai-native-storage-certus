use creusot.int.UInt32
use creusot.int.UInt64
use creusot.prelude.MutBorrow
use creusot.prelude.Any

type t_Option_u64 = None | Some UInt64.t

type t_Location = Staging UInt64.t | BlockDevice UInt64.t | MemoryTier UInt64.t UInt32.t t_Option_u64

type t_DispatchEntry = {
  location: t_Location;
  size_blocks: UInt32.t;
  read_ref: UInt32.t;
  write_ref: UInt32.t;
  tsc: UInt64.t }

type t_Ordering = Less | Equal | Greater

function cmp_log_u32 (self: UInt32.t) (o: UInt32.t) : t_Ordering = [%#sord'12] if UInt32.lt self o then
    Less
  else
    if self = o then Equal else Greater


function eq_cmp_u32 (x: UInt32.t) (y: UInt32.t) : ()

axiom eq_cmp_u32_spec: forall x: UInt32.t, y: UInt32.t. [%#sord'11] (x = y) = (cmp_log_u32 x y = Equal)

function antisym2_u32 (x: UInt32.t) (y: UInt32.t) : ()

axiom antisym2_u32_spec: forall x: UInt32.t, y: UInt32.t. ([%#sord'9] cmp_log_u32 x y = Greater)
    -> ([%#sord'10] cmp_log_u32 y x = Less)

function antisym1_u32 (x: UInt32.t) (y: UInt32.t) : ()

axiom antisym1_u32_spec: forall x: UInt32.t, y: UInt32.t. ([%#sord'7] cmp_log_u32 x y = Less)
    -> ([%#sord'8] cmp_log_u32 y x = Greater)

function trans_u32 (x: UInt32.t) (y: UInt32.t) (z: UInt32.t) (o: t_Ordering) : ()

axiom trans_u32_spec: forall x: UInt32.t, y: UInt32.t, z: UInt32.t, o: t_Ordering. ([%#sord'4] cmp_log_u32 x y = o)
    -> ([%#sord'5] cmp_log_u32 y z = o) -> ([%#sord'6] cmp_log_u32 x z = o)

function refl_u32 (x: UInt32.t) : ()

axiom refl_u32_spec: forall x: UInt32.t. [%#sord'3] cmp_log_u32 x x = Equal

function cmp_gt_log_u32 (x: UInt32.t) (y: UInt32.t) : ()

axiom cmp_gt_log_u32_spec: forall x: UInt32.t, y: UInt32.t. [%#sord'2] UInt32.gt x y = (cmp_log_u32 x y = Greater)

function cmp_ge_log_u32 (x: UInt32.t) (y: UInt32.t) : ()

axiom cmp_ge_log_u32_spec: forall x: UInt32.t, y: UInt32.t. [%#sord'1] UInt32.ge x y = (cmp_log_u32 x y <> Less)

function cmp_lt_log_u32 (x: UInt32.t) (y: UInt32.t) : ()

axiom cmp_lt_log_u32_spec: forall x: UInt32.t, y: UInt32.t. [%#sord'0] UInt32.lt x y = (cmp_log_u32 x y = Less)

function cmp_le_log_u32 (x: UInt32.t) (y: UInt32.t) : ()

axiom cmp_le_log_u32_spec: forall x: UInt32.t, y: UInt32.t. [%#sord] UInt32.le x y = (cmp_log_u32 x y <> Greater)

predicate inv_write_binary [#"/home/cornel/ai-native-storage-certus/components/dispatch-map/verif/src/lib.rs" 46 0 46 50] (e: t_DispatchEntry) =
  [%#slib'26] e.write_ref = (0: UInt32.t) \/ e.write_ref = (1: UInt32.t)

let create_staging (size: UInt32.t) (buffer_handle: UInt64.t) (tsc'0: UInt64.t) (return (x: t_DispatchEntry)) =
{[@stop_split] [@expl:create_staging requires] [%#slib'8] UInt32.gt size (0: UInt32.t)}
  any
  [ return (result: t_DispatchEntry) ->
  {[@stop_split] [@expl:create_staging ensures] ([@stop_split] [@expl:create_staging ensures #0] [%#slib'9] result.write_ref
      = (1: UInt32.t))
    /\ ([@stop_split] [@expl:create_staging ensures #1] [%#slib'10] result.read_ref = (0: UInt32.t))
    /\ ([@stop_split] [@expl:create_staging ensures #2] [%#slib'11] result.size_blocks = size)
    /\ ([@stop_split] [@expl:create_staging ensures #3] [%#slib'12] inv_write_binary result)}
    (! return {result}) ]

type t_DispatchMapError =
  | InvalidSize
  | AlreadyExists
  | KeyNotFound
  | Timeout
  | RefCountOverflow
  | RefCountUnderflow
  | NoWriteReference
  | ActiveReferences
  | InvalidState
  | AllocationFailed
  | NotInitialized

type t_Result_unit_DispatchMapError = Ok () | Err t_DispatchMapError

let release_write (entry: MutBorrow.t t_DispatchEntry) (return (x: t_Result_unit_DispatchMapError)) =
{[@stop_split] [@expl:release_write requires] ([@stop_split] [@expl:release_write requires #0] [%#slib'13] inv_write_binary entry.current)
  /\ ([@stop_split] [@expl:release_write requires #1] [%#slib'14] UInt32.gt entry.current.write_ref (0: UInt32.t))}
  any
  [ return (result: t_Result_unit_DispatchMapError) ->
  {[@stop_split] [@expl:release_write ensures] ([@stop_split] [@expl:release_write ensures #0] [%#slib'15] entry.final.write_ref
      = (0: UInt32.t))
    /\ ([@stop_split] [@expl:release_write ensures #1] [%#slib'16] entry.final.read_ref = entry.current.read_ref)
    /\ ([@stop_split] [@expl:release_write ensures #2] [%#slib'17] inv_write_binary entry.final)}
    (! return {result}) ]

predicate resolve_refmut_DispatchEntry [@inline:trivial] (_1: MutBorrow.t t_DispatchEntry) = _1.final = _1.current

meta "rewrite_def" predicate resolve_refmut_DispatchEntry

let take_write (entry: MutBorrow.t t_DispatchEntry) (return (x: t_Result_unit_DispatchMapError)) =
{[@stop_split] [@expl:take_write requires] ([@stop_split] [@expl:take_write requires #0] [%#slib'18] entry.current.read_ref
    = (0: UInt32.t))
  /\ ([@stop_split] [@expl:take_write requires #1] [%#slib'19] entry.current.write_ref = (0: UInt32.t))}
  any
  [ return (result: t_Result_unit_DispatchMapError) ->
  {[@stop_split] [@expl:take_write ensures] ([@stop_split] [@expl:take_write ensures #0] [%#slib'20] entry.final.write_ref
      = (1: UInt32.t))
    /\ ([@stop_split] [@expl:take_write ensures #1] [%#slib'21] entry.final.read_ref = (0: UInt32.t))
    /\ ([@stop_split] [@expl:take_write ensures #2] [%#slib'22] inv_write_binary entry.final)}
    (! return {result}) ]

let convert_to_storage (entry: MutBorrow.t t_DispatchEntry) (new_offset: UInt64.t)
  (return (x: t_Result_unit_DispatchMapError)) =
{[@stop_split] [@expl:convert_to_storage requires] [%#slib'23] inv_write_binary entry.current}
  any
  [ return (result: t_Result_unit_DispatchMapError) ->
  {[@stop_split] [@expl:convert_to_storage ensures] ([@stop_split] [@expl:convert_to_storage ensures #0] [%#slib'24] inv_write_binary entry.final)
    /\ ([@stop_split] [@expl:convert_to_storage ensures #1] [%#slib'25] match result with
      | Ok () -> entry.final.write_ref = entry.current.write_ref
      /\ (entry.current.read_ref = (0: UInt32.t) -> entry.final.read_ref = (0: UInt32.t))
      /\ (UInt32.gt entry.current.read_ref (0: UInt32.t)
      -> entry.final.read_ref = UInt32.sub entry.current.read_ref (1: UInt32.t))
      | Err _ -> entry.final.write_ref = entry.current.write_ref /\ entry.final.read_ref = entry.current.read_ref
      end)}
    (! return {result}) ]

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

