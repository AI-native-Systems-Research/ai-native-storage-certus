  | KeyNotFound
  | Timeout
  | RefCountOverflow
  | RefCountUnderflow
  | NoWriteReference
  | ActiveReferences
  | InvalidState
  | AllocationFailed
  | NotInitialized

type t_Result_unit_DispatchMapError = Ok () | Err t_DispatchMapError

