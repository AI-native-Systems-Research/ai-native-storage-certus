let elim_MemoryTier (_x: t_Location) (return (mem_handle: UInt64.t) (size: UInt32.t) (ssd_offset: t_Option_u64)) = any
  [ _k (mem_handle: UInt64.t) (size: UInt32.t) (ssd_offset: t_Option_u64) -> {MemoryTier mem_handle size ssd_offset
    = _x}
    (! return {mem_handle} {size} {ssd_offset})
  | _chk -> (! {[@expl:elim MemoryTier] match _x with
      | MemoryTier _ _ _ -> true
      | _ -> false
      end}
    any) ]

let elim_Some (_x: t_Option_u64) (return (f0: UInt64.t)) = any
  [ _k (f0: UInt64.t) -> {Some f0 = _x} (! return {f0})
  | _chk -> (! {[@expl:elim Some] match _x with
      | Some _ -> true
      | _ -> false
      end}
    any) ]

