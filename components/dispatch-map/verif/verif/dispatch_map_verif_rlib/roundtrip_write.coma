type t_Option_u64 = None | Some UInt64.t

type t_Location = Staging UInt64.t | BlockDevice UInt64.t | MemoryTier UInt64.t UInt32.t t_Option_u64

type t_DispatchEntry = {
  location: t_Location;
  size_blocks: UInt32.t;
  read_ref: UInt32.t;
  write_ref: UInt32.t;
  tsc: UInt64.t }

type t_DispatchMapError =
  | InvalidSize
  | AlreadyExists
  | KeyNotFound
  | Timeout
  | RefCountOverflow
  | RefCountUnderflow
  | NoWriteReference
  | ActiveReferences
  | InvalidState
  | AllocationFailed
  | NotInitialized

type t_Result_unit_DispatchMapError = Ok () | Err t_DispatchMapError

predicate inv_write_binary [#"/home/cornel/ai-native-storage-certus/components/dispatch-map/verif/src/lib.rs" 46 0 46 50] (e: t_DispatchEntry) =
  [%#slib'17] e.write_ref = (0: UInt32.t) \/ e.write_ref = (1: UInt32.t)

let take_write (entry: MutBorrow.t t_DispatchEntry) (return (x: t_Result_unit_DispatchMapError)) =
