type t_Option_u64 = None | Some UInt64.t

type t_Location = Staging UInt64.t | BlockDevice UInt64.t | MemoryTier UInt64.t UInt32.t t_Option_u64

type t_DispatchEntry = {
  location: t_Location;
  size_blocks: UInt32.t;
  read_ref: UInt32.t;
  write_ref: UInt32.t;
  tsc: UInt64.t }

predicate resolve_refmut_DispatchEntry [@inline:trivial] (_1: MutBorrow.t t_DispatchEntry) = _1.final = _1.current

meta "rewrite_def" predicate resolve_refmut_DispatchEntry

type t_DispatchMapError =
  | InvalidSize
  | AlreadyExists
  | KeyNotFound
  | Timeout
  | RefCountOverflow
  | RefCountUnderflow
  | NoWriteReference
  | ActiveReferences
  | InvalidState

type t_Result_unit_DispatchMapError = Ok () | Err t_DispatchMapError

type t_Option_u32 = None'0 | Some'0 UInt32.t

constant const_MIN: UInt32.t = (0: UInt32.t)

constant const_MAX: UInt32.t = (4294967295: UInt32.t)

let checked_add (self_: UInt32.t) (rhs: UInt32.t) (return (x: t_Option_u32)) = any
  [ return (result: t_Option_u32) ->
  {[@stop_split] [@expl:checked_add ensures] ([@stop_split] [@expl:checked_add ensures #0] [%#snum] (result = None'0)
      = (UInt32.t'int self_ + UInt32.t'int rhs < UInt32.t'int const_MIN
      \/ UInt32.t'int self_ + UInt32.t'int rhs > UInt32.t'int const_MAX))
    /\ ([@stop_split] [@expl:checked_add ensures #1] [%#snum'0] forall r: UInt32.t. result = Some'0 r
      -> UInt32.t'int r = UInt32.t'int self_ + UInt32.t'int rhs)}
    (! return {result}) ]

let elim_Some (_x: t_Option_u32) (return (f0: UInt32.t)) = any
  [ _k (f0: UInt32.t) -> {Some'0 f0 = _x} (! return {f0})
  | _chk -> (! {[@expl:elim Some] match _x with
      | Some'0 _ -> true
      | _ -> false
      end}
    any) ]

