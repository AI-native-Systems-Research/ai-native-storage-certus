    /\ ([@stop_split] [@expl:take_read ensures #1] [%#slib'13] entry.final.write_ref = (0: UInt32.t))
    /\ ([@stop_split] [@expl:take_read ensures #2] [%#slib'14] inv_write_binary entry.final)}
