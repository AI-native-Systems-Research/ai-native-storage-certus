    /\ ([@stop_split] [@expl:release_read ensures #1] [%#slib'18] entry.final.write_ref = entry.current.write_ref)
    /\ ([@stop_split] [@expl:release_read ensures #2] [%#slib'19] inv_write_binary entry.final)}
    (! return {result}) ]

