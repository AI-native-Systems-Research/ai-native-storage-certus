use creusot.int.UInt8
use creusot.prelude.Any

type t_RdmaStatusCode = Success | UnableToConnect | KeyNoLongerAvailable

type t_Option_RdmaStatusCode = None | Some t_RdmaStatusCode

type t_Ordering = Less | Equal | Greater

function cmp_log_u8 (self: UInt8.t) (o: UInt8.t) : t_Ordering = [%#sord'12] if UInt8.lt self o then
    Less
  else
    if self = o then Equal else Greater


function eq_cmp_u8 (x: UInt8.t) (y: UInt8.t) : ()

axiom eq_cmp_u8_spec: forall x: UInt8.t, y: UInt8.t. [%#sord'11] (x = y) = (cmp_log_u8 x y = Equal)

function antisym2_u8 (x: UInt8.t) (y: UInt8.t) : ()

axiom antisym2_u8_spec: forall x: UInt8.t, y: UInt8.t. ([%#sord'9] cmp_log_u8 x y = Greater)
    -> ([%#sord'10] cmp_log_u8 y x = Less)

function antisym1_u8 (x: UInt8.t) (y: UInt8.t) : ()

axiom antisym1_u8_spec: forall x: UInt8.t, y: UInt8.t. ([%#sord'7] cmp_log_u8 x y = Less)
    -> ([%#sord'8] cmp_log_u8 y x = Greater)

function trans_u8 (x: UInt8.t) (y: UInt8.t) (z: UInt8.t) (o: t_Ordering) : ()

axiom trans_u8_spec: forall x: UInt8.t, y: UInt8.t, z: UInt8.t, o: t_Ordering. ([%#sord'4] cmp_log_u8 x y = o)
    -> ([%#sord'5] cmp_log_u8 y z = o) -> ([%#sord'6] cmp_log_u8 x z = o)

function refl_u8 (x: UInt8.t) : ()

axiom refl_u8_spec: forall x: UInt8.t. [%#sord'3] cmp_log_u8 x x = Equal

function cmp_gt_log_u8 (x: UInt8.t) (y: UInt8.t) : ()

axiom cmp_gt_log_u8_spec: forall x: UInt8.t, y: UInt8.t. [%#sord'2] UInt8.gt x y = (cmp_log_u8 x y = Greater)

function cmp_ge_log_u8 (x: UInt8.t) (y: UInt8.t) : ()

axiom cmp_ge_log_u8_spec: forall x: UInt8.t, y: UInt8.t. [%#sord'1] UInt8.ge x y = (cmp_log_u8 x y <> Less)

function cmp_lt_log_u8 (x: UInt8.t) (y: UInt8.t) : ()

axiom cmp_lt_log_u8_spec: forall x: UInt8.t, y: UInt8.t. [%#sord'0] UInt8.lt x y = (cmp_log_u8 x y = Less)

function cmp_le_log_u8 (x: UInt8.t) (y: UInt8.t) : ()

axiom cmp_le_log_u8_spec: forall x: UInt8.t, y: UInt8.t. [%#sord] UInt8.le x y = (cmp_log_u8 x y <> Greater)

