use creusot.int.UInt64
use creusot.int.UInt8
use creusot.int.UInt32
use seq.Seq
use int.ComputerDivision
use creusot.prelude.MutBorrow
use bv.Pow2int
use map.Map
use creusot.prelude.Any
use int.Int

type t_RdOut = DevErr | Bad | Good UInt64.t

type t_Superblock = {
  magic: UInt64.t;
  version: UInt32.t;
  data_disk_size: UInt64.t;
  sector_size: UInt32.t;
  slab_size: UInt64.t;
  max_extent_size: UInt32.t;
  region_count: UInt32.t;
  checkpoint_seq: UInt64.t;
  active_copy: UInt8.t;
  checkpoint_region_offset: UInt64.t;
  checkpoint_region_size: UInt64.t;
  instance_id: UInt64.t;
  metadata_disk_ns_id: UInt32.t;
  data_start_offset: UInt64.t }

type t_Recovered = Empty | Copy UInt8.t

type t_EmError = CorruptMetadata | IoError | NotInitialized | OffsetNotFound UInt64.t | OutOfSpace

type t_Result_Recovered_EmError = Ok t_Recovered | Err t_EmError

let recover_rd (sb_seq: UInt64.t) (active: UInt8.t) (act: t_RdOut) (inact: t_RdOut)
  (return (x: t_Result_Recovered_EmError)) = {[@stop_split] [@expl:recover_rd requires] [%#sb3] UInt8.t'int active <= 1}
  any
  [ return (result: t_Result_Recovered_EmError) ->
  {[@stop_split] [@expl:recover_rd ensures] ([@stop_split] [@expl:recover_rd ensures #0] [%#sb3'0] UInt64.t'int sb_seq
        = 0 -> result = Ok (Empty))
    /\ ([@stop_split] [@expl:recover_rd ensures #1] [%#sb3'1] UInt64.t'int sb_seq > 0 /\ act = Good sb_seq
      -> result = Ok (Copy active))
    /\ ([@stop_split] [@expl:recover_rd ensures #2] [%#sb3'2] forall q: UInt64.t. UInt64.t'int sb_seq > 1
          /\ UInt64.t'int q = UInt64.t'int sb_seq - 1 /\ act <> Good sb_seq /\ inact = Good q
        -> result = Ok (Copy (if UInt8.t'int active = 0 then (1: UInt8.t) else (0: UInt8.t))))
    /\ ([@stop_split] [@expl:recover_rd ensures #3] [%#sb3'3] UInt64.t'int sb_seq > 0
      /\ act <> Good sb_seq
      /\ (UInt64.t'int sb_seq = 1 \/ (forall q: UInt64.t. UInt64.t'int q = UInt64.t'int sb_seq - 1 -> inact <> Good q))
    -> result = Err (CorruptMetadata))}
    (! return {result}) ]

type t_Vec_Vec_SlabDescriptor_Global_Global

type t_Vec_SlabDescriptor_Global

constant const_MAX: UInt64.t = (18446744073709551615: UInt64.t)

function view_Vec_Vec_SlabDescriptor_Global_Global (self: t_Vec_Vec_SlabDescriptor_Global_Global) : Seq.seq t_Vec_SlabDescriptor_Global

axiom view_Vec_Vec_SlabDescriptor_Global_Global_spec:
  forall self: t_Vec_Vec_SlabDescriptor_Global_Global [view_Vec_Vec_SlabDescriptor_Global_Global self]. [%#svec] Seq.length (view_Vec_Vec_SlabDescriptor_Global_Global self)
    <= UInt64.t'int const_MAX

type t_Vec_u64_Global

type t_SlabDescriptor = {
  start_offset'0: UInt64.t;
  slab_size'0: UInt64.t;
  element_size'0: UInt32.t;
  keys'0: t_Vec_u64_Global }

function view_Vec_SlabDescriptor_Global (self: t_Vec_SlabDescriptor_Global) : Seq.seq t_SlabDescriptor

axiom view_Vec_SlabDescriptor_Global_spec:
  forall self: t_Vec_SlabDescriptor_Global [view_Vec_SlabDescriptor_Global self]. [%#svec] Seq.length (view_Vec_SlabDescriptor_Global self)
    <= UInt64.t'int const_MAX

let empty_regions (n: UInt64.t) (return (x: t_Vec_Vec_SlabDescriptor_Global_Global)) = any
  [ return (result: t_Vec_Vec_SlabDescriptor_Global_Global) ->
