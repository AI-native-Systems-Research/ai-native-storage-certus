type t_Co = { completed_seq: UInt64.t; in_progress: bool }

type t_Vec_Th_Global

type t_CoSys = { co: t_Co; ts: t_Vec_Th_Global }

type t_Th = Idle | Waiting UInt64.t | Running UInt64.t

constant const_MAX: UInt64.t = (18446744073709551615: UInt64.t)

function view_Vec_Th_Global (self: t_Vec_Th_Global) : Seq.seq t_Th

axiom view_Vec_Th_Global_spec:
  forall self: t_Vec_Th_Global [view_Vec_Th_Global self]. [%#svec'0] Seq.length (view_Vec_Th_Global self)
    <= UInt64.t'int const_MAX

predicate is_run [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/b4.rs" 138 0 138 28] (t: t_Th) =
  [%#sb4'1] match t with
    | Running _ -> true
    | _ -> false
    end

predicate co_run_flag [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/b4.rs" 149 0 149 36] (s: t_CoSys) =
  [%#sb4'2] forall i: int. 0 <= i
      /\ i < Seq.length (view_Vec_Th_Global s.ts) /\ is_run (Seq.get (view_Vec_Th_Global s.ts) i) -> s.co.in_progress

predicate co_single [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/b4.rs" 155 0 155 34] (s: t_CoSys) =
  [%#sb4] forall i: int, j: int. 0 <= i
      /\ i < Seq.length (view_Vec_Th_Global s.ts)
      /\ 0 <= j
      /\ j < Seq.length (view_Vec_Th_Global s.ts)
      /\ is_run (Seq.get (view_Vec_Th_Global s.ts) i) /\ is_run (Seq.get (view_Vec_Th_Global s.ts) j) -> i = j

function th_need [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/b4.rs" 143 0 143 28] (t: t_Th) : int
 = [%#sb4'4] match t with
    | Running n -> UInt64.t'int n
    | Waiting n -> UInt64.t'int n
    | Idle -> 0
    end

predicate co_bound [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/b4.rs" 165 0 165 33] (s: t_CoSys) =
  [%#sb4'3] forall i: int. 0 <= i /\ i < Seq.length (view_Vec_Th_Global s.ts)
    -> th_need (Seq.get (view_Vec_Th_Global s.ts) i) <= UInt64.t'int s.co.completed_seq + 2
    /\ (is_run (Seq.get (view_Vec_Th_Global s.ts) i)
    -> UInt64.t'int s.co.completed_seq < th_need (Seq.get (view_Vec_Th_Global s.ts) i))

predicate co_inv [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/b4.rs" 173 0 173 31] (s: t_CoSys) =
