constant const_WS_K1: UInt64.t = [%#sbatch4'5] (51: UInt64.t)

let wst_race (return (x: tup3_Result_unit_EmError_Superblock_Result_tup2_Superblock_Snapshot_Seq_RegionState_EmError)) =
any
  [ return (result: tup3_Result_unit_EmError_Superblock_Result_tup2_Superblock_Snapshot_Seq_RegionState_EmError) ->
  {[@stop_split] [@expl:wst_race ensures] ([@stop_split] [@expl:wst_race ensures #0] [%#sbatch4'2] result.f0'0 = Ok ())
    /\ ([@stop_split] [@expl:wst_race ensures #1] [%#sbatch4'3] UInt64.t'int result.f1'0.instance_id = 2
      /\ UInt64.t'int result.f1'0.checkpoint_seq = 0)
    /\ ([@stop_split] [@expl:wst_race ensures #2] [%#sbatch4'4] match result.f2'0 with
      | Ok'0 {f0 = sb; f1 = img} -> UInt64.t'int sb.instance_id = 1
      /\ img_lists img { key = const_WS_K1; size = (4: UInt32.t); offset = (0: UInt64.t) }
      | Err'0 _ -> false
      end)}
    (! return {result}) ]

