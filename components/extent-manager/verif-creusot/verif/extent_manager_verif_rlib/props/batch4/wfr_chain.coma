use creusot.int.UInt64
use creusot.int.UInt32
use int.ComputerDivision
use seq.Seq
use bv.Pow2int
use map.Map
use creusot.prelude.MutBorrow
use creusot.int.UInt8
use creusot.prelude.Any
use int.Int

type t_BTreeMap_u64_Slab_Global

type t_SlabMap = { inner: t_BTreeMap_u64_Slab_Global }

type t_HashMap_u32_Vec_u64_Global_RandomState_Global

type t_SizeClassManager = { map: t_HashMap_u32_Vec_u64_Global_RandomState_Global }

type t_Vec_Vec_u64_Global_Global

type t_BuddyAllocator = {
  base_offset: UInt64.t;
  total_usable_size: UInt64.t;
  sector_size: UInt32.t;
  max_order: UInt64.t;
  free_lists: t_Vec_Vec_u64_Global_Global }

type t_Option_u64 = None | Some UInt64.t

type t_FormatParams = {
  data_disk_size'0: UInt64.t;
  slab_size'0: UInt64.t;
  max_extent_size'0: UInt32.t;
  sector_size'0: UInt32.t;
  region_count'0: UInt32.t;
  metadata_alignment'0: UInt64.t;
  instance_id'0: t_Option_u64;
  metadata_disk_ns_id'0: UInt32.t;
  metadata_region_size'0: UInt64.t }

type t_Vec_tup2_u64_usize_Global

type t_RegionState = {
  slabs: t_SlabMap;
  size_classes: t_SizeClassManager;
  buddy: t_BuddyAllocator;
  dirty: bool;
  format_params: t_FormatParams;
  pending_frees: t_Vec_tup2_u64_usize_Global }

predicate inv_BTreeMap_u64_Slab_Global (_1: t_BTreeMap_u64_Slab_Global)

predicate inv_SlabMap (_1: t_SlabMap)

axiom inv_axiom [@rewrite]: forall x: t_SlabMap [inv_SlabMap x]. inv_SlabMap x = inv_BTreeMap_u64_Slab_Global x.inner

predicate inv_HashMap_u32_Vec_u64_Global_RandomState_Global (_1: t_HashMap_u32_Vec_u64_Global_RandomState_Global)

predicate inv_SizeClassManager (_1: t_SizeClassManager)

axiom inv_axiom'0 [@rewrite]: forall x: t_SizeClassManager [inv_SizeClassManager x]. inv_SizeClassManager x
    = inv_HashMap_u32_Vec_u64_Global_RandomState_Global x.map

predicate inv_RegionState (_1: t_RegionState)

axiom inv_axiom'1 [@rewrite]: forall x: t_RegionState [inv_RegionState x]. inv_RegionState x
    = (inv_SlabMap x.slabs /\ inv_SizeClassManager x.size_classes)

constant const_MAX: UInt64.t = (18446744073709551615: UInt64.t)

predicate rg_params [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/region.rs" 121 0 121 40] (r: t_RegionState) =
  [%#sregion'52] r.format_params.sector_size'0 = r.buddy.sector_size
  /\ UInt32.t'int r.format_params.sector_size'0 > 0
  /\ UInt64.t'int r.format_params.slab_size'0 > 0
  /\ ComputerDivision.mod (UInt64.t'int r.format_params.slab_size'0) (UInt32.t'int r.format_params.sector_size'0) = 0
  /\ UInt64.t'int r.format_params.slab_size'0 + UInt32.t'int r.format_params.sector_size'0 <= UInt64.t'int const_MAX

type t_Vec_u64_Global

constant const_MAX'0: UInt64.t = (18446744073709551615: UInt64.t)

function view_Vec_Vec_u64_Global_Global (self: t_Vec_Vec_u64_Global_Global) : Seq.seq t_Vec_u64_Global

axiom view_Vec_Vec_u64_Global_Global_spec:
  forall self: t_Vec_Vec_u64_Global_Global [view_Vec_Vec_u64_Global_Global self]. [%#svec] Seq.length (view_Vec_Vec_u64_Global_Global self)
    <= UInt64.t'int const_MAX'0

function span [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/buddy.rs" 32 0 32 35] (ss: int) (o: int) : int
 = [%#sbuddy'5] Pow2int.pow2 o * ss

predicate bd_shape [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/buddy.rs" 401 0 401 42] (b: t_BuddyAllocator) =
  [%#sbuddy'16] UInt32.t'int b.sector_size > 0
  /\ UInt64.t'int b.max_order < 64
  /\ Seq.length (view_Vec_Vec_u64_Global_Global b.free_lists) = UInt64.t'int b.max_order + 1
  /\ UInt64.t'int b.base_offset + UInt64.t'int b.total_usable_size <= UInt64.t'int const_MAX
  /\ (UInt64.t'int b.max_order = 0
  \/ span (UInt32.t'int b.sector_size) (UInt64.t'int b.max_order) <= UInt64.t'int b.total_usable_size)

function view_Vec_u64_Global (self: t_Vec_u64_Global) : Seq.seq UInt64.t

axiom view_Vec_u64_Global_spec:
  forall self: t_Vec_u64_Global [view_Vec_u64_Global self]. [%#svec] Seq.length (view_Vec_u64_Global self)
    <= UInt64.t'int const_MAX'0

predicate bd_aligned [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/buddy.rs" 414 0 414 44] (b: t_BuddyAllocator) =
  [%#sbuddy'17] forall o: int, k: int. 0 <= o
