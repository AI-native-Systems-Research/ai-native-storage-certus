let wc_fp (slab: UInt64.t) (disk: UInt64.t) (return (x: t_FormatParams)) =
{[@stop_split] [@expl:wc_fp requires] [%#sbatch2] ComputerDivision.mod (UInt64.t'int slab) 4 = 0
  /\ UInt64.t'int slab > 0}
  any
  [ return (result: t_FormatParams) ->
  {[@stop_split] [@expl:wc_fp ensures] ([@stop_split] [@expl:wc_fp ensures #0] [%#sbatch2'0] UInt32.t'int result.sector_size
        = 4
      /\ result.slab_size = slab /\ result.data_disk_size = disk)
    /\ ([@stop_split] [@expl:wc_fp ensures #1] [%#sbatch2'1] UInt32.t'int result.region_count = 1
      /\ UInt32.t'int result.max_extent_size = 4)
    /\ ([@stop_split] [@expl:wc_fp ensures #2] [%#sbatch2'2] result = wc_fp_l slab disk)}
    (! return {result}) ]

