    | Running n -> UInt64.t'int n
    | Waiting n -> UInt64.t'int n
    | Idle -> 0
    end

predicate co_bound [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/b4.rs" 165 0 165 33] (s: t_CoSys) =
