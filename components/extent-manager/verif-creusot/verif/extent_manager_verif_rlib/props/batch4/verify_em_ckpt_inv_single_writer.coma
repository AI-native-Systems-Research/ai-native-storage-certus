type t_Th = Idle | Waiting UInt64.t | Running UInt64.t

constant const_MAX: UInt64.t = (18446744073709551615: UInt64.t)

function view_Vec_Th_Global (self: t_Vec_Th_Global) : Seq.seq t_Th

axiom view_Vec_Th_Global_spec:
  forall self: t_Vec_Th_Global [view_Vec_Th_Global self]. [%#svec'0] Seq.length (view_Vec_Th_Global self)
    <= UInt64.t'int const_MAX

