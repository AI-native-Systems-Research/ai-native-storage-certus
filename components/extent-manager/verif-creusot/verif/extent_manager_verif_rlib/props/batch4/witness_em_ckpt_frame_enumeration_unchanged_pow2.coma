use creusot.int.UInt64
use creusot.int.UInt32
use seq.Seq
use bv.Pow2int
use int.ComputerDivision
use map.Map
use creusot.prelude.MutBorrow
use creusot.int.UInt8
use creusot.prelude.Any
use int.Int

type t_Option_u64 = None | Some UInt64.t

type t_FormatParams = {
  data_disk_size: UInt64.t;
  slab_size: UInt64.t;
  max_extent_size: UInt32.t;
  sector_size: UInt32.t;
  region_count: UInt32.t;
  metadata_alignment: UInt64.t;
  instance_id: t_Option_u64;
  metadata_disk_ns_id: UInt32.t;
  metadata_region_size: UInt64.t }

let w2p_fp (return (x: t_FormatParams)) = any
  [ return (result: t_FormatParams) ->
  {[@stop_split] [@expl:w2p_fp ensures] [%#sbatch2] UInt64.t'int result.data_disk_size = 16
    /\ UInt64.t'int result.slab_size = 8 /\ UInt32.t'int result.sector_size = 4 /\ UInt32.t'int result.region_count = 1}
    (! return {result}) ]

type t_Vec_SlabDescriptor_Global

type t_Vec_u64_Global

type t_SlabDescriptor = {
  start_offset'0: UInt64.t;
  slab_size'0: UInt64.t;
  element_size'0: UInt32.t;
  keys'0: t_Vec_u64_Global }

constant const_MAX: UInt64.t = (18446744073709551615: UInt64.t)

function view_Vec_SlabDescriptor_Global (self: t_Vec_SlabDescriptor_Global) : Seq.seq t_SlabDescriptor

axiom view_Vec_SlabDescriptor_Global_spec:
  forall self: t_Vec_SlabDescriptor_Global [view_Vec_SlabDescriptor_Global self]. [%#svec] Seq.length (view_Vec_SlabDescriptor_Global self)
    <= UInt64.t'int const_MAX

function view_Vec_u64_Global (self: t_Vec_u64_Global) : Seq.seq UInt64.t

axiom view_Vec_u64_Global_spec:
  forall self: t_Vec_u64_Global [view_Vec_u64_Global self]. [%#svec] Seq.length (view_Vec_u64_Global self)
    <= UInt64.t'int const_MAX

constant const_WP_K3: UInt64.t = [%#sbatch2'4] (3: UInt64.t)

constant const_FREE_KEY: UInt64.t = [%#sslab'0] (18446744073709551615: UInt64.t)

let w2p_descs (return (x: t_Vec_SlabDescriptor_Global)) = any
  [ return (result: t_Vec_SlabDescriptor_Global) ->
  {[@stop_split] [@expl:w2p_descs ensures] ([@stop_split] [@expl:w2p_descs ensures #0] [%#sbatch2'0] Seq.length (view_Vec_SlabDescriptor_Global result)
      = 1)
    /\ ([@stop_split] [@expl:w2p_descs ensures #1] [%#sbatch2'1] UInt64.t'int (Seq.get (view_Vec_SlabDescriptor_Global result) 0).start_offset'0
        = 8
      /\ UInt64.t'int (Seq.get (view_Vec_SlabDescriptor_Global result) 0).slab_size'0 = 8
      /\ UInt32.t'int (Seq.get (view_Vec_SlabDescriptor_Global result) 0).element_size'0 = 4)
    /\ ([@stop_split] [@expl:w2p_descs ensures #2] [%#sbatch2'2] Seq.length (view_Vec_u64_Global (Seq.get (view_Vec_SlabDescriptor_Global result) 0).keys'0)
      = 2
    /\ Seq.get (view_Vec_u64_Global (Seq.get (view_Vec_SlabDescriptor_Global result) 0).keys'0) 0 = const_WP_K3
    /\ Seq.get (view_Vec_u64_Global (Seq.get (view_Vec_SlabDescriptor_Global result) 0).keys'0) 1 = const_FREE_KEY)}
    (! return {result}) ]

let fact_mask_pow2 (return (x: ())) = any
  [ return (result: ()) ->
  {[@stop_split] [@expl:fact_mask_pow2 ensures] [%#sbatch2'3] UInt64.bw_and (4: UInt64.t) (UInt64.bw_not (UInt64.sub (8: UInt64.t) (1: UInt64.t)))
      = (0: UInt64.t)
    /\ UInt64.bw_and (8: UInt64.t) (UInt64.bw_not (UInt64.sub (16: UInt64.t) (1: UInt64.t))) = (0: UInt64.t)
    /\ UInt64.bw_and (16: UInt64.t) (UInt64.bw_not (UInt64.sub (32: UInt64.t) (1: UInt64.t))) = (0: UInt64.t)}
