let remove_extent8 (self: MutBorrow.t t_ExtentManager) (offset: UInt64.t) (return (x: t_Result_unit_EmError)) =
{[@stop_split] [@expl:remove_extent8 requires] ([@stop_split] [@expl:remove_extent8 'self' type invariant] [%#sb8] inv_refmut_ExtentManager self)
  /\ ([@stop_split] [@expl:remove_extent8 requires #0] [%#sb8'0] em_regions_wf self.current
    /\ em_regions_ok self.current)
  /\ ([@stop_split] [@expl:remove_extent8 requires #1] [%#sb8'1] rm_safe8 self.current)}
  any
  [ return (result: t_Result_unit_EmError) ->
  {[@stop_split] [@expl:remove_extent8 ensures] ([@stop_split] [@expl:remove_extent8 ensures #0] [%#sb8'2] match result with
        | Err _ -> unch8 self.current self.final
        | Ok () -> rm_ok8 self.current self.final offset
        end)
    /\ ([@stop_split] [@expl:remove_extent8 ensures #1] [%#sb8'3] match result with
        | Err e -> e = NotInitialized \/ e = OffsetNotFound offset
        | Ok () -> true
        end)
    /\ ([@stop_split] [@expl:remove_extent8 ensures #2] [%#sb8'4] self.current.regions = None'0
      -> result = Err (NotInitialized))
    /\ ([@stop_split] [@expl:remove_extent8 ensures #3] [%#sb8'5] self.current.shared = None'1
      -> result = Err (NotInitialized))
    /\ ([@stop_split] [@expl:remove_extent8 ensures #4] [%#sb8'6] rb_zero8 self.current
      -> result = Err (NotInitialized))
    /\ ([@stop_split] [@expl:remove_extent8 ensures #5] [%#sb8'7] rb_pos8 self.current
    -> match result with
      | Err e -> e = OffsetNotFound offset
      | Ok () -> true
      end)}
    (! return {result}) ]

