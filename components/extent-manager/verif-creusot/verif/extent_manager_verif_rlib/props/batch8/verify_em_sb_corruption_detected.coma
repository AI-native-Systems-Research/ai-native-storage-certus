use creusot.int.UInt64
use creusot.int.UInt32
use creusot.int.UInt8
use seq.Seq
use creusot.prelude.Any
use int.Int

type t_Vec_u8_Global

type t_Superblock = {
  magic: UInt64.t;
  version: UInt32.t;
  data_disk_size: UInt64.t;
  sector_size: UInt32.t;
  slab_size: UInt64.t;
  max_extent_size: UInt32.t;
  region_count: UInt32.t;
  checkpoint_seq: UInt64.t;
  active_copy: UInt8.t;
  checkpoint_region_offset: UInt64.t;
  checkpoint_region_size: UInt64.t;
  instance_id: UInt64.t;
  metadata_disk_ns_id: UInt32.t;
  data_start_offset: UInt64.t }

type t_EmError = CorruptMetadata | IoError | NotInitialized | OffsetNotFound UInt64.t | OutOfSpace

type t_Result_Superblock_EmError = Ok t_Superblock | Err t_EmError

function dec64 [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/b4.rs" 282 0 282 31] (b: Seq.seq UInt8.t) : UInt64.t

function d64 [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/b7.rs" 40 0 40 37] (b: Seq.seq UInt8.t) (p: int) : UInt64.t
 = [%#sb7'1] dec64 (Seq.([..]) b p (p + 8))

constant const_SUPERBLOCK_MAGIC: UInt64.t = [%#sparams] (4847371096096462388: UInt64.t)

function dec32 [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/b4.rs" 288 0 288 31] (b: Seq.seq UInt8.t) : UInt32.t

function d32 [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/b7.rs" 46 0 46 37] (b: Seq.seq UInt8.t) (p: int) : UInt32.t
 = [%#sb7'2] dec32 (Seq.([..]) b p (p + 4))

function crc32 [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/sbbytes.rs" 29 0 29 31] (s: Seq.seq UInt8.t) : UInt32.t

predicate sb_ok7 [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/b7.rs" 52 0 52 33] (b: Seq.seq UInt8.t) =
  [%#sb7'3] Seq.length b >= 4096 /\ d64 b 0 = const_SUPERBLOCK_MAGIC /\ d32 b 92 = crc32 (Seq.([..]) b 0 92)

constant const_MAX: UInt64.t = (18446744073709551615: UInt64.t)

function view_Vec_u8_Global (self: t_Vec_u8_Global) : Seq.seq UInt8.t

axiom view_Vec_u8_Global_spec:
  forall self: t_Vec_u8_Global [view_Vec_u8_Global self]. [%#svec] Seq.length (view_Vec_u8_Global self)
    <= UInt64.t'int const_MAX

function sb_of [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/b7.rs" 58 0 58 38] (b: Seq.seq UInt8.t) : t_Superblock
 = [%#sb7'4] { magic = d64 b 0;
               version = d32 b 8;
               data_disk_size = d64 b 12;
               sector_size = d32 b 20;
               slab_size = d64 b 24;
               max_extent_size = d32 b 32;
               region_count = d32 b 36;
               checkpoint_seq = d64 b 40;
               active_copy = Seq.get b 48;
               checkpoint_region_offset = d64 b 56;
               checkpoint_region_size = d64 b 64;
               instance_id = d64 b 72;
               metadata_disk_ns_id = d32 b 80;
               data_start_offset = d64 b 84 }

function le64 [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/sbbytes.rs" 17 0 17 33] (v: UInt64.t) (k: int) : UInt8.t

predicate has64 [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/sbbytes.rs" 113 0 113 50] (s: Seq.seq UInt8.t) (pos: int) (v: UInt64.t) =
  [%#ssbbytes'0] forall k: int. 0 <= k /\ k < 8 -> Seq.get s (pos + k) = le64 v k

function le32 [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/sbbytes.rs" 23 0 23 33] (v: UInt32.t) (k: int) : UInt8.t

predicate has32 [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/sbbytes.rs" 119 0 119 50] (s: Seq.seq UInt8.t) (pos: int) (v: UInt32.t) =
  [%#ssbbytes'1] forall k: int. 0 <= k /\ k < 4 -> Seq.get s (pos + k) = le32 v k

predicate sb_layout [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/sbbytes.rs" 126 0 126 52] (s: Seq.seq UInt8.t) (sb: t_Superblock) =
  [%#ssbbytes] Seq.length s = 4096
  /\ has64 s 0 sb.magic
  /\ has32 s 8 sb.version
  /\ has64 s 12 sb.data_disk_size
  /\ has32 s 20 sb.sector_size
  /\ has64 s 24 sb.slab_size
  /\ has32 s 32 sb.max_extent_size
  /\ has32 s 36 sb.region_count
  /\ has64 s 40 sb.checkpoint_seq
  /\ Seq.get s 48 = sb.active_copy
  /\ (forall q: int. 49 <= q /\ q < 56 -> Seq.get s q = (0: UInt8.t))
  /\ has64 s 56 sb.checkpoint_region_offset
  /\ has64 s 64 sb.checkpoint_region_size
  /\ has64 s 72 sb.instance_id
  /\ has32 s 80 sb.metadata_disk_ns_id
  /\ has64 s 84 sb.data_start_offset
  /\ has32 s 92 (crc32 (Seq.([..]) s 0 92)) /\ (forall q: int. 96 <= q /\ q < 4096 -> Seq.get s q = (0: UInt8.t))

let deserialize7 (buf: t_Vec_u8_Global) (return (x: t_Result_Superblock_EmError)) = any
  [ return (result: t_Result_Superblock_EmError) ->
  {[@stop_split] [@expl:deserialize7 ensures] ([@stop_split] [@expl:deserialize7 ensures #0] [%#sb7] match result with
        | Ok sb -> sb_ok7 (view_Vec_u8_Global buf) /\ sb = sb_of (view_Vec_u8_Global buf)
        | Err e -> not sb_ok7 (view_Vec_u8_Global buf) /\ e = CorruptMetadata
        end)
    /\ ([@stop_split] [@expl:deserialize7 ensures #1] [%#sb7'0] forall sb: t_Superblock. sb_layout (view_Vec_u8_Global buf) sb
        /\ sb.magic = const_SUPERBLOCK_MAGIC -> result = Ok sb)}
    (! return {result}) ]

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let verify_em_sb_corruption_detected [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/props/batch8.rs" 166 0 166 85]
  (buf: t_Vec_u8_Global) (return (x: t_Result_Superblock_EmError)) = (! bb0
  [ bb0 = s0
    [ s0 = deserialize7 [%#sbatch8] {buf} (fun (_x: t_Result_Superblock_EmError) -> [ &_ret <- _x ] s1)
    | s1 = return {_ret} ] ] [ & _ret: t_Result_Superblock_EmError = Any.any_l () | & buf: t_Vec_u8_Global = buf ])
  [ return (result: t_Result_Superblock_EmError) ->
  {[@stop_split] [@expl:verify_em_sb_corruption_detected ensures] ([@stop_split] [@expl:verify_em_sb_corruption_detected ensures #0] [%#sbatch8'0] Seq.length (view_Vec_u8_Global buf)
        < 4096 -> result = Err (CorruptMetadata))
    /\ ([@stop_split] [@expl:verify_em_sb_corruption_detected ensures #1] [%#sbatch8'1] Seq.length (view_Vec_u8_Global buf)
          >= 4096
        /\ d64 (view_Vec_u8_Global buf) 0 <> const_SUPERBLOCK_MAGIC -> result = Err (CorruptMetadata))
    /\ ([@stop_split] [@expl:verify_em_sb_corruption_detected ensures #2] [%#sbatch8'2] Seq.length (view_Vec_u8_Global buf)
          >= 4096
        /\ d32 (view_Vec_u8_Global buf) 92 <> crc32 (Seq.([..]) (view_Vec_u8_Global buf) 0 92)
      -> result = Err (CorruptMetadata))
    /\ ([@stop_split] [@expl:verify_em_sb_corruption_detected ensures #3] [%#sbatch8'3] forall o: Seq.seq UInt8.t. sb_ok7 o
          /\ Seq.length (view_Vec_u8_Global buf) >= 4096
          /\ d32 (view_Vec_u8_Global buf) 92 = d32 o 92
          /\ crc32 (Seq.([..]) (view_Vec_u8_Global buf) 0 92) <> crc32 (Seq.([..]) o 0 92)
        -> result = Err (CorruptMetadata))
    /\ ([@stop_split] [@expl:verify_em_sb_corruption_detected ensures #4] [%#sbatch8'4] match result with
      | Ok _ -> sb_ok7 (view_Vec_u8_Global buf)
      | Err e -> e = CorruptMetadata
      end)}
    (! return {result}) ]
