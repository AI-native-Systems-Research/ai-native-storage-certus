  [%#sbitmap'0] bm_wf bm /\ bm_count_ok bm

predicate slab_inv [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/slab.rs" 70 0 70 32] (s: t_Slab) =
  [%#sslab'5] slab_geom s /\ slab_keys_len s /\ slab_rover s /\ bm_inv s.bitmap

function slot_off [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/slab.rs" 84 0 84 39] (s: t_Slab) (i: int) : int
 = [%#sslab'6] UInt64.t'int s.start_offset + i * UInt32.t'int s.element_size

let alloc_slot (self: MutBorrow.t t_Slab) (return (x: t_Option_tup2_usize_u64)) =
{[@stop_split] [@expl:alloc_slot requires] [%#sslab] slab_inv self.current}
  any
  [ return (result: t_Option_tup2_usize_u64) ->
  {[@stop_split] [@expl:alloc_slot ensures] ([@stop_split] [@expl:alloc_slot ensures #0] [%#sslab'0] slab_inv self.final)
    /\ ([@stop_split] [@expl:alloc_slot ensures #1] [%#sslab'1] self.final.start_offset = self.current.start_offset
      /\ self.final.slab_size = self.current.slab_size)
    /\ ([@stop_split] [@expl:alloc_slot ensures #2] [%#sslab'2] self.final.element_size = self.current.element_size
      /\ self.final.keys = self.current.keys)
    /\ ([@stop_split] [@expl:alloc_slot ensures #3] [%#sslab'3] self.final.bitmap.num_slots
      = self.current.bitmap.num_slots)
    /\ ([@stop_split] [@expl:alloc_slot ensures #4] [%#sslab'4] match result with
      | Some {f0 = idx; f1 = off} -> UInt64.t'int idx < UInt32.t'int self.current.bitmap.num_slots
      /\ not slot_bit self.current.bitmap (UInt64.t'int idx)
      /\ slot_bit self.final.bitmap (UInt64.t'int idx)
      /\ (UInt64.t'int self.current.rover <= UInt64.t'int idx
        -> (forall j: int. UInt64.t'int self.current.rover <= j /\ j < UInt64.t'int idx
          -> slot_bit self.current.bitmap j))
      /\ UInt64.t'int off = slot_off self.current (UInt64.t'int idx)
      /\ UInt64.t'int self.final.rover
        = ComputerDivision.mod (UInt64.t'int idx + 1) (UInt32.t'int self.current.bitmap.num_slots)
      /\ UInt32.t'int self.final.bitmap.allocated_count = UInt32.t'int self.current.bitmap.allocated_count + 1
      /\ (forall j: int. 0 <= j /\ j < UInt32.t'int self.current.bitmap.num_slots /\ j <> UInt64.t'int idx
        -> slot_bit self.final.bitmap j = slot_bit self.current.bitmap j)
      | None -> self.final = self.current
      /\ (forall j: int. 0 <= j /\ j < UInt32.t'int self.current.bitmap.num_slots -> slot_bit self.current.bitmap j)
      end)}
    (! return {result}) ]

predicate resolve_refmut_Slab [@inline:trivial] (_1: MutBorrow.t t_Slab) = _1.final = _1.current

meta "rewrite_def" predicate resolve_refmut_Slab

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let witness_em_slab_rover_in_range_intended [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/props/batch8.rs" 132 0 132 84]
  (s: MutBorrow.t t_Slab) (return (x: t_Option_tup2_usize_u64)) =
{[@stop_split] [@expl:witness_em_slab_rover_in_range_intended requires] [%#sbatch8'0] slab_inv s.current}
  (! bb0
  [ bb0 = s0
    [ s0 = MutBorrow.borrow_final <t_Slab> {s.current} {MutBorrow.get_id s}
        (fun (_bor: MutBorrow.t t_Slab) -> [ &_8 <- _bor ] [ &s <- { s with current = _bor.final } ] s1)
    | s1 = alloc_slot [%#sbatch8] {_8} (fun (_x: t_Option_tup2_usize_u64) -> [ &_ret <- _x ] s2)
    | s2 = -{resolve_refmut_Slab s}- s3
    | s3 = return {_ret} ] ]
  [ & _ret: t_Option_tup2_usize_u64 = Any.any_l ()
  | & s: MutBorrow.t t_Slab = s
  | & _8: MutBorrow.t t_Slab = Any.any_l () ])
  [ return (result: t_Option_tup2_usize_u64) ->
  {[@stop_split] [@expl:witness_em_slab_rover_in_range_intended ensures] ([@stop_split] [@expl:witness_em_slab_rover_in_range_intended ensures #0] [%#sbatch8'1] UInt32.t'int s.current.bitmap.num_slots
        >= 1
      -> UInt64.t'int s.current.rover < UInt32.t'int s.current.bitmap.num_slots
      /\ UInt64.t'int s.final.rover < UInt32.t'int s.final.bitmap.num_slots)
    /\ ([@stop_split] [@expl:witness_em_slab_rover_in_range_intended ensures #1] [%#sbatch8'2] UInt32.t'int s.current.bitmap.num_slots
      = 0 -> result = None)}
    (! return {result}) ]
