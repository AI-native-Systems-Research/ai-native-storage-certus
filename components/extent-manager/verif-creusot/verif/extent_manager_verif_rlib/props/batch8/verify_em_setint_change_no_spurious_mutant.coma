use creusot.int.UInt64
use creusot.prelude.MutBorrow
use creusot.prelude.Any
use int.Int

type t_Option_u64 = None | Some UInt64.t

type t_TPh = Top | Wait int | WaitInf | Woken bool | Work | Exited

type t_TSys = { interval: t_Option_u64; now: int; ph: t_TPh; shutdown: bool; ckpts: UInt64.t }

let set_interval (self: MutBorrow.t t_TSys) (iv: t_Option_u64) (return (x: ())) = any
  [ return (result: ()) ->
  {[@stop_split] [@expl:set_interval ensures] ([@stop_split] [@expl:set_interval ensures #0] [%#sb5] self.final.interval
        = iv
      /\ self.final.now = self.current.now)
    /\ ([@stop_split] [@expl:set_interval ensures #1] [%#sb5'0] self.final.shutdown = self.current.shutdown
      /\ self.final.ckpts = self.current.ckpts)
    /\ ([@stop_split] [@expl:set_interval ensures #2] [%#sb5'1] self.final.ph
    = match self.current.ph with
      | Wait _ -> Woken false
      | WaitInf -> Woken false
      | p -> p
      end)}
    (! return {result}) ]

let relock (self: MutBorrow.t t_TSys) (return (x: ())) =
{[@stop_split] [@expl:relock requires] [%#sb5'2] match self.current.ph with
    | Woken _ -> true
    | _ -> false
    end}
  any
  [ return (result: ()) ->
  {[@stop_split] [@expl:relock ensures] ([@stop_split] [@expl:relock ensures #0] [%#sb5'3] self.final.interval
        = self.current.interval
      /\ self.final.now = self.current.now)
    /\ ([@stop_split] [@expl:relock ensures #1] [%#sb5'4] self.final.shutdown = self.current.shutdown
      /\ self.final.ckpts = self.current.ckpts)
    /\ ([@stop_split] [@expl:relock ensures #2] [%#sb5'5] self.final.ph
    = (if self.current.shutdown then
      Exited
    else
      match self.current.ph with
        | Woken t -> if t then Work else Top
        | p -> p
        end
    ))}
    (! return {result}) ]

let th_enter (self: MutBorrow.t t_TSys) (return (x: ())) =
{[@stop_split] [@expl:th_enter requires] [%#sb5'6] self.current.ph = Top}
  any
  [ return (result: ()) ->
  {[@stop_split] [@expl:th_enter ensures] ([@stop_split] [@expl:th_enter ensures #0] [%#sb5'7] self.final.interval
        = self.current.interval
      /\ self.final.now = self.current.now)
    /\ ([@stop_split] [@expl:th_enter ensures #1] [%#sb5'8] self.final.shutdown = self.current.shutdown
      /\ self.final.ckpts = self.current.ckpts)
    /\ ([@stop_split] [@expl:th_enter ensures #2] [%#sb5'9] self.current.shutdown -> self.final.ph = Exited)
    /\ ([@stop_split] [@expl:th_enter ensures #3] [%#sb5'10] not self.current.shutdown
    -> match self.current.interval with
      | Some d -> match self.final.ph with
        | Wait dl -> dl = self.current.now + UInt64.t'int d
        | _ -> false
        end
      | None -> self.final.ph = WaitInf
      end)}
    (! return {result}) ]

predicate resolve_refmut_TSys [@inline:trivial] (_1: MutBorrow.t t_TSys) = _1.final = _1.current

meta "rewrite_def" predicate resolve_refmut_TSys

