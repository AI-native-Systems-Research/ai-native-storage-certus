use creusot.int.UInt32
use creusot.int.UInt64
use seq.Seq
use int.ComputerDivision
use creusot.prelude.Any
use int.Int

type t_Vec_u64_Global

type t_AllocationBitmap = { words: t_Vec_u64_Global; num_slots: UInt32.t; allocated_count: UInt32.t }

type t_Option_usize = None | Some UInt64.t

constant const_MAX: UInt64.t = (18446744073709551615: UInt64.t)

function view_Vec_u64_Global (self: t_Vec_u64_Global) : Seq.seq UInt64.t

axiom view_Vec_u64_Global_spec:
  forall self: t_Vec_u64_Global [view_Vec_u64_Global self]. [%#svec] Seq.length (view_Vec_u64_Global self)
    <= UInt64.t'int const_MAX

predicate bm_wf [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/bitmap.rs" 27 0 27 42] (bm: t_AllocationBitmap) =
  [%#sbitmap'2] Seq.length (view_Vec_u64_Global bm.words) = ComputerDivision.div (UInt32.t'int bm.num_slots + 63) 64

predicate slot_bit [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/bitmap.rs" 33 0 33 53] (bm: t_AllocationBitmap) (i: int) =
  [%#sbitmap'3] UInt64.nth (Seq.get (view_Vec_u64_Global bm.words) (ComputerDivision.div i 64)) (ComputerDivision.mod i 64)

let find_free_from (self: t_AllocationBitmap) (start: UInt64.t) (return (x: t_Option_usize)) =
{[@stop_split] [@expl:find_free_from requires] ([@stop_split] [@expl:find_free_from requires #0] [%#sbitmap] bm_wf self)
  /\ ([@stop_split] [@expl:find_free_from requires #1] [%#sbitmap'0] UInt32.t'int self.num_slots = 0
  \/ UInt64.t'int start < UInt32.t'int self.num_slots)}
  any
  [ return (result: t_Option_usize) -> {[@stop_split] [@expl:find_free_from ensures] [%#sbitmap'1] match result with
      | Some i -> UInt64.t'int i < UInt32.t'int self.num_slots
      /\ not slot_bit self (UInt64.t'int i)
      /\ (UInt64.t'int start <= UInt64.t'int i
      -> (forall j: int. UInt64.t'int start <= j /\ j < UInt64.t'int i -> slot_bit self j))
      | None -> forall j: int. 0 <= j /\ j < UInt32.t'int self.num_slots -> slot_bit self j
      end}
    (! return {result}) ]

