      used_sum arena'0 rv (n - 1) + rg_used (Seq.get arena'0 (UInt64.t'int (Seq.get rv (n - 1))))
    )

let used_bytes (self: t_ExtentManager) (return (x: UInt64.t)) =
{[@stop_split] [@expl:used_bytes requires] ([@stop_split] [@expl:used_bytes 'self' type invariant] [%#sb4] inv_ref_ExtentManager self)
  /\ ([@stop_split] [@expl:used_bytes requires #0] [%#sb4'0] em_regions_wf self)
