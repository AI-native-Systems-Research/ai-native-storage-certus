    | Some rv -> used_terms_ok (view_Vec_RegionState_Global self.arena) (view_Vec_usize_Global rv)
    /\ used_sum (view_Vec_RegionState_Global self.arena) (view_Vec_usize_Global rv) (Seq.length (view_Vec_usize_Global rv))
    <= UInt64.t'int const_MAX'0
    | None -> true
    end)}
  any
  [ return (result: UInt64.t) -> {[@stop_split] [@expl:used_bytes ensures] [%#sb4'2] match self.regions with
      | Some rv -> UInt64.t'int result
      = used_sum (view_Vec_RegionState_Global self.arena) (view_Vec_usize_Global rv) (Seq.length (view_Vec_usize_Global rv))
      | None -> UInt64.t'int result = 0
      end}
    (! return {result}) ]

