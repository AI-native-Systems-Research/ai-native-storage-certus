use creusot.int.UInt64
use creusot.prelude.Any

type t_CompF = FlushDone bool | Error | Other

type t_Option_CompF = None | Some t_CompF

type t_EmError = CorruptMetadata | IoError | NotInitialized | OffsetNotFound UInt64.t | OutOfSpace

type t_Result_unit_EmError = Ok () | Err t_EmError

let flush8 (send_ok: bool) (recv: t_Option_CompF) (return (x: t_Result_unit_EmError)) = any
  [ return (result: t_Result_unit_EmError) -> {[@stop_split] [@expl:flush8 ensures] [%#sb8] match result with
      | Ok () -> send_ok /\ recv = Some (FlushDone true)
      | Err e -> e = IoError /\ not (send_ok /\ recv = Some (FlushDone true))
      end}
    (! return {result}) ]

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

