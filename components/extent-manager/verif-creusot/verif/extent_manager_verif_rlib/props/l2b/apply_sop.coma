let set_key (self: MutBorrow.t t_Slab) (slot_index: UInt64.t) (key: UInt64.t) (return (x: ())) =
{[@stop_split] [@expl:set_key requires] [%#sslab] UInt64.t'int slot_index
  < Seq.length (view_Vec_u64_Global self.current.keys)}
  any
  [ return (result: ()) ->
  {[@stop_split] [@expl:set_key ensures] ([@stop_split] [@expl:set_key ensures #0] [%#sslab'0] view_Vec_u64_Global self.final.keys
      = Seq.set (view_Vec_u64_Global self.current.keys) (UInt64.t'int slot_index) key)
    /\ ([@stop_split] [@expl:set_key ensures #1] [%#sslab'1] self.final.bitmap = self.current.bitmap
      /\ self.final.rover = self.current.rover)
    /\ ([@stop_split] [@expl:set_key ensures #2] [%#sslab'2] self.final.start_offset = self.current.start_offset
      /\ self.final.slab_size = self.current.slab_size)
    /\ ([@stop_split] [@expl:set_key ensures #3] [%#sslab'3] self.final.element_size = self.current.element_size)
    /\ ([@stop_split] [@expl:set_key ensures #4] [%#sslab'4] slab_inv self.current -> slab_inv self.final)
    /\ ([@stop_split] [@expl:set_key ensures #5] [%#sslab'5] slab_keys_len self.current
      /\ key_alloc self.current /\ (key = const_FREE_KEY \/ slot_bit self.current.bitmap (UInt64.t'int slot_index))
    -> key_alloc self.final)}
    (! return {result}) ]

predicate resolve_refmut_Slab [@inline:trivial] (_1: MutBorrow.t t_Slab) = _1.final = _1.current

meta "rewrite_def" predicate resolve_refmut_Slab

let elim_Free (_x: t_SOp) (return (f0: UInt64.t)) = any
  [ _k (f0: UInt64.t) -> {Free f0 = _x} (! return {f0})
  | _chk -> (! {[@expl:elim Free] match _x with
      | Free _ -> true
      | _ -> false
      end}
    any) ]

let is_set (self: t_AllocationBitmap) (idx: UInt64.t) (return (x: bool)) =
{[@stop_split] [@expl:is_set requires] ([@stop_split] [@expl:is_set requires #0] [%#sbitmap] bm_wf self)
  /\ ([@stop_split] [@expl:is_set requires #1] [%#sbitmap'0] UInt64.t'int idx < UInt32.t'int self.num_slots)}
  any
  [ return (result: bool) -> {[@stop_split] [@expl:is_set ensures] [%#sbitmap'1] result
    = slot_bit self (UInt64.t'int idx)}
    (! return {result}) ]

let free_slot (self: MutBorrow.t t_Slab) (slot_index: UInt64.t) (return (x: ())) =
{[@stop_split] [@expl:free_slot requires] ([@stop_split] [@expl:free_slot requires #0] [%#sslab'6] slab_inv self.current)
  /\ ([@stop_split] [@expl:free_slot requires #1] [%#sslab'7] UInt64.t'int slot_index
    < UInt32.t'int self.current.bitmap.num_slots)
  /\ ([@stop_split] [@expl:free_slot requires #2] [%#sslab'8] slot_bit self.current.bitmap (UInt64.t'int slot_index))}
  any
  [ return (result: ()) ->
  {[@stop_split] [@expl:free_slot ensures] ([@stop_split] [@expl:free_slot ensures #0] [%#sslab'9] slab_inv self.final)
    /\ ([@stop_split] [@expl:free_slot ensures #1] [%#sslab'10] self.final.start_offset = self.current.start_offset
      /\ self.final.slab_size = self.current.slab_size)
    /\ ([@stop_split] [@expl:free_slot ensures #2] [%#sslab'11] self.final.element_size = self.current.element_size
      /\ self.final.rover = self.current.rover)
    /\ ([@stop_split] [@expl:free_slot ensures #3] [%#sslab'12] self.final.bitmap.num_slots
      = self.current.bitmap.num_slots)
    /\ ([@stop_split] [@expl:free_slot ensures #4] [%#sslab'13] not slot_bit self.final.bitmap (UInt64.t'int slot_index))
    /\ ([@stop_split] [@expl:free_slot ensures #5] [%#sslab'14] view_Vec_u64_Global self.final.keys
      = Seq.set (view_Vec_u64_Global self.current.keys) (UInt64.t'int slot_index) const_FREE_KEY)
    /\ ([@stop_split] [@expl:free_slot ensures #6] [%#sslab'15] UInt32.t'int self.final.bitmap.allocated_count
      = UInt32.t'int self.current.bitmap.allocated_count - 1)
    /\ ([@stop_split] [@expl:free_slot ensures #7] [%#sslab'16] forall j: int. 0 <= j
