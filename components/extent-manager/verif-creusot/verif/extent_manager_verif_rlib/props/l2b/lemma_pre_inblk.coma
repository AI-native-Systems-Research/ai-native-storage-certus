goal vc_lemma_pre_inblk: ([%#sl2b] p2 (UInt32.t'int fp.sector_size'0)
    /\ starts_distinct ds /\ rb1 bpre b0 ds i base size fp)
  -> ([%#sl2b'0] 0 <= i /\ i < Seq.length ds)
  -> ([%#sl2b'1] forall p: int. 0 <= p /\ p < Seq.length ds -> dgeo (Seq.get ds p) base size fp)
  -> ([%#sl2b'2] UInt32.t'int fp.sector_size'0 > 0 /\ UInt64.t'int fp.slab_size'0 > 0)
  -> ([@stop_split] [@expl:lemma_ord_ge requires] [%#sbuddy] 0
      <= ComputerDivision.div (UInt64.t'int fp.slab_size'0) (UInt32.t'int fp.sector_size'0)
    /\ ComputerDivision.div (UInt64.t'int fp.slab_size'0) (UInt32.t'int fp.sector_size'0) <= 18446744073709551616)
  /\ (([@stop_split] [@expl:lemma_ord_ge ensures] ([@stop_split] [@expl:lemma_ord_ge ensures #0] [%#sbuddy'0] Pow2int.pow2 (ord (ComputerDivision.div (UInt64.t'int fp.slab_size'0) (UInt32.t'int fp.sector_size'0)))
      >= ComputerDivision.div (UInt64.t'int fp.slab_size'0) (UInt32.t'int fp.sector_size'0))
    /\ ([@stop_split] [@expl:lemma_ord_ge ensures #1] [%#sbuddy'1] 0
      <= ord (ComputerDivision.div (UInt64.t'int fp.slab_size'0) (UInt32.t'int fp.sector_size'0))
    /\ ord (ComputerDivision.div (UInt64.t'int fp.slab_size'0) (UInt32.t'int fp.sector_size'0)) <= 64))
  -> (let _ = lemma_ord_ge (ComputerDivision.div (UInt64.t'int fp.slab_size'0) (UInt32.t'int fp.sector_size'0)) in ([@stop_split] [@expl:lemma_span_pos requires] [%#sbuddy'2] UInt32.t'int fp.sector_size'0
      > 0
    /\ 0 <= ord (ComputerDivision.div (UInt64.t'int fp.slab_size'0) (UInt32.t'int fp.sector_size'0)))
  /\ (([@stop_split] [@expl:lemma_span_pos ensures] ([@stop_split] [@expl:lemma_span_pos ensures #0] [%#sbuddy'3] span (UInt32.t'int fp.sector_size'0) (ord (ComputerDivision.div (UInt64.t'int fp.slab_size'0) (UInt32.t'int fp.sector_size'0)))
      >= UInt32.t'int fp.sector_size'0)
    /\ ([@stop_split] [@expl:lemma_span_pos ensures #1] [%#sbuddy'4] span (UInt32.t'int fp.sector_size'0) (ord (ComputerDivision.div (UInt64.t'int fp.slab_size'0) (UInt32.t'int fp.sector_size'0)))
    > 0))
  -> (let _ = lemma_span_pos (UInt32.t'int fp.sector_size'0) (ord (ComputerDivision.div (UInt64.t'int fp.slab_size'0) (UInt32.t'int fp.sector_size'0))) in (forall p: int. 0
          <= p
        /\ p < i -> (Seq.get ds p).start_offset <> (Seq.get ds i).start_offset)
  && (forall p: int. if 0 <= p then
        if p < i then
          if UInt64.t'int (Seq.get ds i).start_offset - base < UInt64.t'int (Seq.get ds p).start_offset - base then
            ([@stop_split] [@expl:lemma_aligned_disj2 requires] [%#sl2] dsk fp > 0
              /\ UInt64.t'int (Seq.get ds i).start_offset - base >= 0
              /\ UInt64.t'int (Seq.get ds p).start_offset - base >= 0
