goal vc_lemma_used_zero: ([%#sl2b'0] 0 <= k /\ k <= Seq.length rv)
  -> ([%#sl2b'1] forall i: int. 0 <= i /\ i < Seq.length rv
      -> rg_used (Seq.get arena (UInt64.t'int (Seq.get rv i))) = 0)
  -> (if k > 0 then
    (([@stop_split] [@expl:lemma_used_zero requires] ([@stop_split] [@expl:lemma_used_zero requires #0] [%#sl2b'0] 0
            <= k - 1
          /\ k - 1 <= Seq.length rv)
        /\ ([@stop_split] [@expl:lemma_used_zero requires #1] [%#sl2b'1] forall i: int. 0 <= i /\ i < Seq.length rv
          -> rg_used (Seq.get arena (UInt64.t'int (Seq.get rv i))) = 0))
      /\ ([@expl:variant decreases] well_founded_relation_Int ([%#sl2b] k) ([%#sl2b] k - 1)))
    /\ (([@stop_split] [@expl:lemma_used_zero ensures] [%#sl2b'2] used_sum arena rv (k - 1) = 0)
    -> ([@stop_split] [@expl:lemma_used_zero ensures] [%#sl2b'2] used_sum arena rv k = 0))
  else
