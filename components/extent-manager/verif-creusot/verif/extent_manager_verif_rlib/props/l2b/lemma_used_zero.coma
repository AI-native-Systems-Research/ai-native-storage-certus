axiom used_sum_def:
  forall arena: Seq.seq t_RegionState, rv: Seq.seq UInt64.t, n: int [used_sum arena rv n]. used_sum arena rv n
    = ([%#sb4'1] if n <= 0 then
      0
    else
      used_sum arena rv (n - 1) + rg_used (Seq.get arena (UInt64.t'int (Seq.get rv (n - 1))))
    )

