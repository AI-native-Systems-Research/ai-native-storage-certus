use int.ComputerDivision
use int.Int

function align_l [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/region.rs" 230 0 230 41] (size: int) (ss: int) : int
 = [%#sregion] ComputerDivision.div (size + ss - 1) ss * ss

function lemma_divmod [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/buddy.rs" 184 0 184 35] (x: int) (m: int) : ()

axiom lemma_divmod_spec: forall x: int, m: int. ([%#sbuddy] m > 0 /\ x >= 0)
    -> ([%#sbuddy'0] x = m * ComputerDivision.div x m + ComputerDivision.mod x m)

axiom lemma_divmod_spec'0: forall x: int, m: int. ([%#sbuddy] m > 0 /\ x >= 0)
    -> ([%#sbuddy'1] 0 <= ComputerDivision.mod x m /\ ComputerDivision.mod x m < m)

axiom lemma_divmod_spec'1: forall x: int, m: int. ([%#sbuddy] m > 0 /\ x >= 0)
    -> ([%#sbuddy'2] ComputerDivision.div x m >= 0)

function lemma_mul_mod0 [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/buddy.rs" 170 0 170 37] (m: int) (k: int) : ()

axiom lemma_mul_mod0_spec: forall m: int, k: int. ([%#sbuddy'3] m > 0 /\ k >= 0)
    -> ([%#sbuddy'4] ComputerDivision.mod (m * k) m = 0)

axiom lemma_mul_mod0_spec'0: forall m: int, k: int. ([%#sbuddy'3] m > 0 /\ k >= 0)
    -> ([%#sbuddy'5] ComputerDivision.div (m * k) m = k)

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant size : int

constant ss : int

function lemma_align_mult [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/props/l2b.rs" 723 0 723 43] (size: int) (ss: int) : ()

goal vc_lemma_align_mult: ([%#sl2b] ss > 0 /\ size >= 0)
  -> ([@stop_split] [@expl:lemma_divmod requires] [%#sbuddy] ss > 0 /\ size + ss - 1 >= 0)
  /\ (([@stop_split] [@expl:lemma_divmod ensures] ([@stop_split] [@expl:lemma_divmod ensures #0] [%#sbuddy'0] size + ss
        - 1
      = ss * ComputerDivision.div (size + ss - 1) ss + ComputerDivision.mod (size + ss - 1) ss)
    /\ ([@stop_split] [@expl:lemma_divmod ensures #1] [%#sbuddy'1] 0 <= ComputerDivision.mod (size + ss - 1) ss
      /\ ComputerDivision.mod (size + ss - 1) ss < ss)
    /\ ([@stop_split] [@expl:lemma_divmod ensures #2] [%#sbuddy'2] ComputerDivision.div (size + ss - 1) ss >= 0))
  -> (let _ = lemma_divmod (size + ss - 1) ss in ([@stop_split] [@expl:lemma_mul_mod0 requires] [%#sbuddy'3] ss > 0
    /\ ComputerDivision.div (size + ss - 1) ss >= 0)
  /\ (([@stop_split] [@expl:lemma_mul_mod0 ensures] ([@stop_split] [@expl:lemma_mul_mod0 ensures #0] [%#sbuddy'4] ComputerDivision.mod (ss
        * ComputerDivision.div (size + ss - 1) ss) ss
      = 0)
    /\ ([@stop_split] [@expl:lemma_mul_mod0 ensures #1] [%#sbuddy'5] ComputerDivision.div (ss
      * ComputerDivision.div (size + ss - 1) ss) ss
    = ComputerDivision.div (size + ss - 1) ss))
  -> ([@stop_split] [@expl:lemma_align_mult ensures] [%#sl2b'0] ComputerDivision.mod (align_l size ss) ss = 0
  /\ align_l size ss >= 0))))
