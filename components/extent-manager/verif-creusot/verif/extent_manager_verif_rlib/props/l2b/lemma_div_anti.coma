use int.ComputerDivision
use int.Int

function lemma_divmod [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/buddy.rs" 184 0 184 35] (x: int) (m: int) : ()

axiom lemma_divmod_spec: forall x: int, m: int. ([%#sbuddy] m > 0 /\ x >= 0)
    -> ([%#sbuddy'0] x = m * ComputerDivision.div x m + ComputerDivision.mod x m)

axiom lemma_divmod_spec'0: forall x: int, m: int. ([%#sbuddy] m > 0 /\ x >= 0)
    -> ([%#sbuddy'1] 0 <= ComputerDivision.mod x m /\ ComputerDivision.mod x m < m)

axiom lemma_divmod_spec'1: forall x: int, m: int. ([%#sbuddy] m > 0 /\ x >= 0)
    -> ([%#sbuddy'2] ComputerDivision.div x m >= 0)

function lemma_mul_le [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/buddy.rs" 156 0 156 43] (a: int) (b: int) (c: int) : ()

axiom lemma_mul_le_spec: forall a: int, b: int, c: int. ([%#sbuddy'3] 0 <= a /\ a <= b /\ 0 <= c)
    -> ([%#sbuddy'4] a * c <= b * c)

function lemma_mul_mod0 [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/buddy.rs" 170 0 170 37] (m: int) (k: int) : ()

axiom lemma_mul_mod0_spec: forall m: int, k: int. ([%#sbuddy'5] m > 0 /\ k >= 0)
    -> ([%#sbuddy'6] ComputerDivision.mod (m * k) m = 0)

axiom lemma_mul_mod0_spec'0: forall m: int, k: int. ([%#sbuddy'5] m > 0 /\ k >= 0)
    -> ([%#sbuddy'7] ComputerDivision.div (m * k) m = k)

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant x : int

constant a : int

constant b : int

function lemma_div_anti [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/props/l2b.rs" 494 0 494 45] (x: int) (a: int) (b: int) : ()

goal vc_lemma_div_anti: ([%#sl2b] 0 < a /\ a <= b /\ x >= 0)
  -> ([@stop_split] [@expl:lemma_divmod requires] [%#sbuddy] a > 0 /\ x >= 0)
  /\ (([@stop_split] [@expl:lemma_divmod ensures] ([@stop_split] [@expl:lemma_divmod ensures #0] [%#sbuddy'0] x
      = a * ComputerDivision.div x a + ComputerDivision.mod x a)
    /\ ([@stop_split] [@expl:lemma_divmod ensures #1] [%#sbuddy'1] 0 <= ComputerDivision.mod x a
      /\ ComputerDivision.mod x a < a)
    /\ ([@stop_split] [@expl:lemma_divmod ensures #2] [%#sbuddy'2] ComputerDivision.div x a >= 0))
  -> (let _ = lemma_divmod x a in ([@stop_split] [@expl:lemma_divmod requires] [%#sbuddy] b > 0 /\ x >= 0)
  /\ (([@stop_split] [@expl:lemma_divmod ensures] ([@stop_split] [@expl:lemma_divmod ensures #0] [%#sbuddy'0] x
      = b * ComputerDivision.div x b + ComputerDivision.mod x b)
    /\ ([@stop_split] [@expl:lemma_divmod ensures #1] [%#sbuddy'1] 0 <= ComputerDivision.mod x b
      /\ ComputerDivision.mod x b < b)
    /\ ([@stop_split] [@expl:lemma_divmod ensures #2] [%#sbuddy'2] ComputerDivision.div x b >= 0))
  -> (let _ = lemma_divmod x b in ([@stop_split] [@expl:lemma_mul_le requires] [%#sbuddy'3] 0 <= a
    /\ a <= b /\ 0 <= ComputerDivision.div x b)
  /\ (([@stop_split] [@expl:lemma_mul_le ensures] [%#sbuddy'4] a * ComputerDivision.div x b
    <= b * ComputerDivision.div x b)
  -> (let _ = lemma_mul_le a b (ComputerDivision.div x b) in ComputerDivision.div x b * a <= x
  && ([@stop_split] [@expl:lemma_divmod requires] [%#sbuddy] a > 0 /\ ComputerDivision.div x b * a >= 0)
  /\ (([@stop_split] [@expl:lemma_divmod ensures] ([@stop_split] [@expl:lemma_divmod ensures #0] [%#sbuddy'0] ComputerDivision.div x b
        * a
      = a * ComputerDivision.div (ComputerDivision.div x b * a) a
      + ComputerDivision.mod (ComputerDivision.div x b * a) a)
    /\ ([@stop_split] [@expl:lemma_divmod ensures #1] [%#sbuddy'1] 0
        <= ComputerDivision.mod (ComputerDivision.div x b * a) a
      /\ ComputerDivision.mod (ComputerDivision.div x b * a) a < a)
    /\ ([@stop_split] [@expl:lemma_divmod ensures #2] [%#sbuddy'2] ComputerDivision.div (ComputerDivision.div x b * a) a
    >= 0))
  -> (let _ = lemma_divmod (ComputerDivision.div x b
  * a) a in ([@stop_split] [@expl:lemma_mul_mod0 requires] [%#sbuddy'5] a > 0 /\ ComputerDivision.div x b >= 0)
  /\ (([@stop_split] [@expl:lemma_mul_mod0 ensures] ([@stop_split] [@expl:lemma_mul_mod0 ensures #0] [%#sbuddy'6] ComputerDivision.mod (a
        * ComputerDivision.div x b) a
      = 0)
    /\ ([@stop_split] [@expl:lemma_mul_mod0 ensures #1] [%#sbuddy'7] ComputerDivision.div (a
      * ComputerDivision.div x b) a
    = ComputerDivision.div x b))
  -> ([@stop_split] [@expl:lemma_div_anti ensures] [%#sl2b'0] ComputerDivision.div x b
  <= ComputerDivision.div x a))))))))))
