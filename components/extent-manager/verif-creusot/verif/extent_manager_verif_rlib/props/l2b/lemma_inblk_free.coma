constant fl : Seq.seq t_Vec_u64_Global

constant ss : int

constant kk : int

constant t : int

function lemma_inblk_free [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/props/l2b.rs" 914 0 914 68] (fl: Seq.seq t_Vec_u64_Global) (ss: int) (kk: int) (t: int) : ()

goal vc_lemma_inblk_free: ([%#sl2b] inblk fl ss kk t)
  -> ([@stop_split] [@expl:lemma_inblk_free ensures] [%#sl2b'0] forall z: int. t <= z /\ z < t + span ss kk
