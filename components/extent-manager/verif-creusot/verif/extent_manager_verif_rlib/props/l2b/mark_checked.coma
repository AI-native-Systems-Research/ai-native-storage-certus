        /\ (forall sk: int, sp: UInt64.t, x: UInt64.t. ord (ComputerDivision.div (UInt64.t'int size) (UInt32.t'int self.current.sector_size))
              < sk
            /\ sk <= UInt64.t'int self.current.max_order
            /\ UInt64.t'int sp = span (UInt32.t'int self.current.sector_size) sk
