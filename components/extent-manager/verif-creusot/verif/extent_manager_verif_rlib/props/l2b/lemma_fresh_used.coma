predicate fresh_rg [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/component.rs" 681 0 681 78] (r: t_RegionState) (base: int) (size: int) (p: t_FormatParams) =
