  /\ UInt64.t'int r.buddy.base_offset = base
  /\ UInt64.t'int r.buddy.total_usable_size = size
  /\ r.buddy.sector_size = p.sector_size'0
  /\ view_SlabMap r.slabs = empty_Int
  /\ (forall e: int. sc_get r.size_classes e = (Seq.empty: Seq.seq UInt64.t))
  /\ not r.dirty
  /\ Seq.length (view_Vec_tup2_u64_usize_Global r.pending_frees) = 0
  /\ (forall m: int. 0 <= m /\ Pow2int.pow2 m = ComputerDivision.div size (UInt32.t'int p.sector_size'0)
      -> UInt64.t'int r.buddy.max_order = m
      /\ view_Vec_u64_Global (Seq.get (view_Vec_Vec_u64_Global_Global r.buddy.free_lists) m)
        = Seq.singleton (0: UInt64.t)
      /\ (forall o: int. 0 <= o /\ o < m
        -> Seq.length (view_Vec_u64_Global (Seq.get (view_Vec_Vec_u64_Global_Global r.buddy.free_lists) o)) = 0))
  /\ tf (view_Vec_Vec_u64_Global_Global r.buddy.free_lists) (UInt32.t'int p.sector_size'0) (Seq.length (view_Vec_Vec_u64_Global_Global r.buddy.free_lists))
  = ComputerDivision.div size (UInt32.t'int p.sector_size'0) * UInt32.t'int p.sector_size'0

