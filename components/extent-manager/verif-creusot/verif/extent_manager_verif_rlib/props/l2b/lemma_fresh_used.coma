function lemma_divmod [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/buddy.rs" 184 0 184 35] (x: int) (m: int) : ()

axiom lemma_divmod_spec: forall x: int, m: int. ([%#sbuddy] m > 0 /\ x >= 0)
    -> ([%#sbuddy'0] x = m * ComputerDivision.div x m + ComputerDivision.mod x m)

axiom lemma_divmod_spec'0: forall x: int, m: int. ([%#sbuddy] m > 0 /\ x >= 0)
    -> ([%#sbuddy'1] 0 <= ComputerDivision.mod x m /\ ComputerDivision.mod x m < m)

axiom lemma_divmod_spec'1: forall x: int, m: int. ([%#sbuddy] m > 0 /\ x >= 0)
    -> ([%#sbuddy'2] ComputerDivision.div x m >= 0)

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant r : t_RegionState

constant base : int

constant size : int

constant p : t_FormatParams

function lemma_fresh_used [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/props/l2b.rs" 307 0 307 78] (r: t_RegionState) (base: int) (size: int) (p: t_FormatParams) : ()

goal vc_lemma_fresh_used: ([%#sl2b] fresh_rg r base size p
    /\ UInt32.t'int p.sector_size'0 > 0 /\ size >= 0 /\ ComputerDivision.mod size (UInt32.t'int p.sector_size'0) = 0)
  -> ([@stop_split] [@expl:lemma_divmod requires] [%#sbuddy] UInt32.t'int p.sector_size'0 > 0 /\ size >= 0)
  /\ (([@stop_split] [@expl:lemma_divmod ensures] ([@stop_split] [@expl:lemma_divmod ensures #0] [%#sbuddy'0] size
      = UInt32.t'int p.sector_size'0 * ComputerDivision.div size (UInt32.t'int p.sector_size'0)
      + ComputerDivision.mod size (UInt32.t'int p.sector_size'0))
    /\ ([@stop_split] [@expl:lemma_divmod ensures #1] [%#sbuddy'1] 0
        <= ComputerDivision.mod size (UInt32.t'int p.sector_size'0)
      /\ ComputerDivision.mod size (UInt32.t'int p.sector_size'0) < UInt32.t'int p.sector_size'0)
    /\ ([@stop_split] [@expl:lemma_divmod ensures #2] [%#sbuddy'2] ComputerDivision.div size (UInt32.t'int p.sector_size'0)
    >= 0)) -> ([@stop_split] [@expl:lemma_fresh_used ensures] [%#sl2b'0] rg_used r = 0))
