  -> (let _ = lemma_span_pos (UInt32.t'int fp.sector_size'0) (ord (ComputerDivision.div (UInt64.t'int fp.slab_size'0) (UInt32.t'int fp.sector_size'0))) in ([@stop_split] [@expl:lemma_pow2 requires] [%#sbuddy'5] 0
    <= ord (ComputerDivision.div (UInt64.t'int fp.slab_size'0) (UInt32.t'int fp.sector_size'0)))
  /\ (([@stop_split] [@expl:lemma_pow2 ensures] ([@stop_split] [@expl:lemma_pow2 ensures #0] [%#sbuddy'6] Pow2int.pow2 (ord (ComputerDivision.div (UInt64.t'int fp.slab_size'0) (UInt32.t'int fp.sector_size'0)))
      >= 1)
    /\ ([@stop_split] [@expl:lemma_pow2 ensures #1] [%#sbuddy'7] Pow2int.pow2 (ord (ComputerDivision.div (UInt64.t'int fp.slab_size'0) (UInt32.t'int fp.sector_size'0))
