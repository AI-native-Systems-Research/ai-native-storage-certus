use creusot.prelude.MutBorrow
use creusot.int.UInt64
use creusot.int.UInt32
use seq.Seq
use creusot.int.UInt8
use bv.Pow2int
use int.ComputerDivision
use map.Map
use creusot.prelude.Any
use int.Int

type t_Vec_RegionState_Global

type t_BTreeMap_u64_Slab_Global

type t_SlabMap = { inner: t_BTreeMap_u64_Slab_Global }

type t_HashMap_u32_Vec_u64_Global_RandomState_Global

type t_SizeClassManager = { map: t_HashMap_u32_Vec_u64_Global_RandomState_Global }

type t_Vec_Vec_u64_Global_Global

type t_BuddyAllocator = {
  base_offset: UInt64.t;
  total_usable_size: UInt64.t;
  sector_size: UInt32.t;
  max_order: UInt64.t;
  free_lists: t_Vec_Vec_u64_Global_Global }

type t_Option_u64 = None | Some UInt64.t

type t_FormatParams = {
  data_disk_size'0: UInt64.t;
  slab_size'0: UInt64.t;
  max_extent_size'0: UInt32.t;
  sector_size'0: UInt32.t;
  region_count'0: UInt32.t;
  metadata_alignment'0: UInt64.t;
  instance_id'0: t_Option_u64;
  metadata_disk_ns_id'0: UInt32.t;
  metadata_region_size'0: UInt64.t }

type t_Vec_tup2_u64_usize_Global

type t_RegionState = {
  slabs: t_SlabMap;
  size_classes: t_SizeClassManager;
  buddy: t_BuddyAllocator;
  dirty: bool;
  format_params: t_FormatParams;
  pending_frees: t_Vec_tup2_u64_usize_Global }

predicate inv_BTreeMap_u64_Slab_Global (_1: t_BTreeMap_u64_Slab_Global)

predicate inv_SlabMap (_1: t_SlabMap)

axiom inv_axiom [@rewrite]: forall x: t_SlabMap [inv_SlabMap x]. inv_SlabMap x = inv_BTreeMap_u64_Slab_Global x.inner

predicate inv_HashMap_u32_Vec_u64_Global_RandomState_Global (_1: t_HashMap_u32_Vec_u64_Global_RandomState_Global)

predicate inv_SizeClassManager (_1: t_SizeClassManager)

axiom inv_axiom'0 [@rewrite]: forall x: t_SizeClassManager [inv_SizeClassManager x]. inv_SizeClassManager x
    = inv_HashMap_u32_Vec_u64_Global_RandomState_Global x.map

predicate inv_RegionState (_1: t_RegionState)

axiom inv_axiom'1 [@rewrite]: forall x: t_RegionState [inv_RegionState x]. inv_RegionState x
    = (inv_SlabMap x.slabs /\ inv_SizeClassManager x.size_classes)

predicate invariant_ref_RegionState [@inline:trivial] (self: t_RegionState) = [%#sinvariant'0] inv_RegionState self

meta "rewrite_def" predicate invariant_ref_RegionState

predicate inv_ref_RegionState [@inline:trivial] (_1: t_RegionState) = invariant_ref_RegionState _1

meta "rewrite_def" predicate inv_ref_RegionState

predicate invariant_Seq_RegionState [@inline:trivial] (self: Seq.seq t_RegionState) =
  [%#sseq] forall i: int. 0 <= i /\ i < Seq.length self -> inv_ref_RegionState (Seq.get self i)

meta "rewrite_def" predicate invariant_Seq_RegionState

predicate inv_Seq_RegionState [@inline:trivial] (_1: Seq.seq t_RegionState) = invariant_Seq_RegionState _1

meta "rewrite_def" predicate inv_Seq_RegionState

constant const_MAX: UInt64.t = (18446744073709551615: UInt64.t)

function view_Vec_RegionState_Global (self: t_Vec_RegionState_Global) : Seq.seq t_RegionState

axiom view_Vec_RegionState_Global_spec:
  forall self: t_Vec_RegionState_Global [view_Vec_RegionState_Global self]. [%#svec] Seq.length (view_Vec_RegionState_Global self)
    <= UInt64.t'int const_MAX

predicate invariant_Vec_RegionState_Global (self: t_Vec_RegionState_Global) =
  [%#svec'0] inv_Seq_RegionState (view_Vec_RegionState_Global self)

predicate inv_Vec_RegionState_Global (_1: t_Vec_RegionState_Global)

axiom inv_axiom'2: forall x: t_Vec_RegionState_Global [inv_Vec_RegionState_Global x]. inv_Vec_RegionState_Global x
    -> invariant_Vec_RegionState_Global x

type t_Vec_usize_Global

type t_Option_Vec_usize_Global = None'0 | Some'0 t_Vec_usize_Global

type t_Superblock = {
  magic'1: UInt64.t;
  version'1: UInt32.t;
