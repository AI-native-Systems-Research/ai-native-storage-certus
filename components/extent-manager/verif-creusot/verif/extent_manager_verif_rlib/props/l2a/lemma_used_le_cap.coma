constant n : int

function lemma_used_le_cap [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/props/l2a.rs" 1914 0 1914 73] (arena: Seq.seq t_RegionState) (rv: Seq.seq UInt64.t) (n: int) : ()

goal vc_lemma_used_le_cap: ([%#sl2a'0] 0 <= n /\ n <= Seq.length rv)
  -> ([%#sl2a'1] forall i: int. 0 <= i /\ i < Seq.length rv
      -> 0 <= rg_used (Seq.get arena (UInt64.t'int (Seq.get rv i)))
      /\ rg_used (Seq.get arena (UInt64.t'int (Seq.get rv i)))
      <= UInt64.t'int (Seq.get arena (UInt64.t'int (Seq.get rv i))).buddy.total_usable_size)
  -> (if n > 0 then
    (([@stop_split] [@expl:lemma_used_le_cap requires] ([@stop_split] [@expl:lemma_used_le_cap requires #0] [%#sl2a'0] 0
            <= n - 1
          /\ n - 1 <= Seq.length rv)
        /\ ([@stop_split] [@expl:lemma_used_le_cap requires #1] [%#sl2a'1] forall i: int. 0 <= i /\ i < Seq.length rv
          -> 0 <= rg_used (Seq.get arena (UInt64.t'int (Seq.get rv i)))
          /\ rg_used (Seq.get arena (UInt64.t'int (Seq.get rv i)))
          <= UInt64.t'int (Seq.get arena (UInt64.t'int (Seq.get rv i))).buddy.total_usable_size))
      /\ ([@expl:variant decreases] well_founded_relation_Int ([%#sl2a] n) ([%#sl2a] n - 1)))
    /\ (([@stop_split] [@expl:lemma_used_le_cap ensures] [%#sl2a'2] 0 <= used_sum arena rv (n - 1)
      /\ used_sum arena rv (n - 1) <= cap_sum arena rv (n - 1))
    -> ([@stop_split] [@expl:lemma_used_le_cap ensures] [%#sl2a'2] 0 <= used_sum arena rv n
    /\ used_sum arena rv n <= cap_sum arena rv n))
  else
    [@stop_split] [@expl:lemma_used_le_cap ensures] [%#sl2a'2] 0 <= used_sum arena rv n
    /\ used_sum arena rv n <= cap_sum arena rv n
  )
