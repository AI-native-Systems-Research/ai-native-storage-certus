use creusot.int.UInt64BW
use creusot.prelude.Any
use int.Int

type t_Ordering = Less | Equal | Greater

function cmp_log_usize (self: UInt64BW.t) (o: UInt64BW.t) : t_Ordering = [%#sord'12] if UInt64BW.lt self o then
    Less
  else
    if self = o then Equal else Greater


function eq_cmp_usize (x: UInt64BW.t) (y: UInt64BW.t) : ()

axiom eq_cmp_usize_spec: forall x: UInt64BW.t, y: UInt64BW.t. [%#sord'11] (x = y) = (cmp_log_usize x y = Equal)

function antisym2_usize (x: UInt64BW.t) (y: UInt64BW.t) : ()

axiom antisym2_usize_spec: forall x: UInt64BW.t, y: UInt64BW.t. ([%#sord'9] cmp_log_usize x y = Greater)
    -> ([%#sord'10] cmp_log_usize y x = Less)

function antisym1_usize (x: UInt64BW.t) (y: UInt64BW.t) : ()

axiom antisym1_usize_spec: forall x: UInt64BW.t, y: UInt64BW.t. ([%#sord'7] cmp_log_usize x y = Less)
    -> ([%#sord'8] cmp_log_usize y x = Greater)

function trans_usize (x: UInt64BW.t) (y: UInt64BW.t) (z: UInt64BW.t) (o: t_Ordering) : ()

axiom trans_usize_spec: forall x: UInt64BW.t, y: UInt64BW.t, z: UInt64BW.t, o: t_Ordering. ([%#sord'4] cmp_log_usize x y
      = o) -> ([%#sord'5] cmp_log_usize y z = o) -> ([%#sord'6] cmp_log_usize x z = o)

function refl_usize (x: UInt64BW.t) : ()

axiom refl_usize_spec: forall x: UInt64BW.t. [%#sord'3] cmp_log_usize x x = Equal

function cmp_gt_log_usize (x: UInt64BW.t) (y: UInt64BW.t) : ()

axiom cmp_gt_log_usize_spec: forall x: UInt64BW.t, y: UInt64BW.t. [%#sord'2] UInt64BW.gt x y
    = (cmp_log_usize x y = Greater)

function cmp_ge_log_usize (x: UInt64BW.t) (y: UInt64BW.t) : ()

axiom cmp_ge_log_usize_spec: forall x: UInt64BW.t, y: UInt64BW.t. [%#sord'1] UInt64BW.ge x y
    = (cmp_log_usize x y <> Less)

function cmp_lt_log_usize (x: UInt64BW.t) (y: UInt64BW.t) : ()

axiom cmp_lt_log_usize_spec: forall x: UInt64BW.t, y: UInt64BW.t. [%#sord'0] UInt64BW.lt x y
    = (cmp_log_usize x y = Less)

function cmp_le_log_usize (x: UInt64BW.t) (y: UInt64BW.t) : ()

axiom cmp_le_log_usize_spec: forall x: UInt64BW.t, y: UInt64BW.t. [%#sord] UInt64BW.le x y
    = (cmp_log_usize x y <> Greater)

constant const_MAX: UInt64BW.t = (18446744073709551615: UInt64BW.t)

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let bf_mul_us [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/props/l2a.rs" 2293 0 2293 55]
