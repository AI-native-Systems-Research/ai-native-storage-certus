function lemma_no_overlap [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/props/l2a.rs" 636 0 636 39] (r: t_RegionState) : ()

goal vc_lemma_no_overlap: ([%#sl2a] rg_inv r)
  -> (forall t1: int, j1: int, t2: int, j2: int. if slot_live r t1 j1 then
        if slot_live r t2 j2 then
          if t1 <> t2 then
            ([@stop_split] [@expl:lemma_slot_in_block requires] [%#sl2a'1] rg_inv r /\ slot_live r t1 j1)
            /\ (([@stop_split] [@expl:lemma_slot_in_block ensures] ([@stop_split] [@expl:lemma_slot_in_block ensures #0] [%#sl2a'2] t1
                <= slot_off (lookup_Int (view_SlabMap r.slabs) t1) j1)
              /\ ([@stop_split] [@expl:lemma_slot_in_block ensures #1] [%#sl2a'3] slot_off (lookup_Int (view_SlabMap r.slabs) t1) j1
                  + UInt32.t'int (lookup_Int (view_SlabMap r.slabs) t1).element_size
                <= t1 + sk r)
              /\ ([@stop_split] [@expl:lemma_slot_in_block ensures #2] [%#sl2a'4] slot_off (lookup_Int (view_SlabMap r.slabs) t1) j1
                + UInt32.t'int (lookup_Int (view_SlabMap r.slabs) t1).element_size
              <= t1 + UInt64.t'int (lookup_Int (view_SlabMap r.slabs) t1).slab_size))
            -> (let _ = lemma_slot_in_block r t1 j1 in ([@stop_split] [@expl:lemma_slot_in_block requires] [%#sl2a'1] rg_inv r
              /\ slot_live r t2 j2)
            /\ (([@stop_split] [@expl:lemma_slot_in_block ensures] ([@stop_split] [@expl:lemma_slot_in_block ensures #0] [%#sl2a'2] t2
                <= slot_off (lookup_Int (view_SlabMap r.slabs) t2) j2)
              /\ ([@stop_split] [@expl:lemma_slot_in_block ensures #1] [%#sl2a'3] slot_off (lookup_Int (view_SlabMap r.slabs) t2) j2
                  + UInt32.t'int (lookup_Int (view_SlabMap r.slabs) t2).element_size
                <= t2 + sk r)
              /\ ([@stop_split] [@expl:lemma_slot_in_block ensures #2] [%#sl2a'4] slot_off (lookup_Int (view_SlabMap r.slabs) t2) j2
                + UInt32.t'int (lookup_Int (view_SlabMap r.slabs) t2).element_size
              <= t2 + UInt64.t'int (lookup_Int (view_SlabMap r.slabs) t2).slab_size))
            -> (let _ = lemma_slot_in_block r t2 j2 in ([@stop_split] [@expl:lemma_slab_blocks_disj requires] [%#sl2r] rg_inv r
              /\ contains_Int (view_SlabMap r.slabs) t1 /\ contains_Int (view_SlabMap r.slabs) t2 /\ t1 <> t2)
            /\ (([@stop_split] [@expl:lemma_slab_blocks_disj ensures] [%#sl2r'0] disj (t1
              - UInt64.t'int r.buddy.base_offset) (sk r) (t2 - UInt64.t'int r.buddy.base_offset) (sk r))
            -> (let _ = lemma_slab_blocks_disj r t1 t2 in true))))))
          else
            true
        
        else
          true
      
      else
        true
    )
  /\ (forall t1: int, j1: int, t2: int, j2: int. slot_live r t1 j1 /\ slot_live r t2 j2 /\ t1 <> t2
      -> (let _ = lemma_slot_in_block r t1 j1 in let _ = lemma_slot_in_block r t2 j2 in let _ = lemma_slab_blocks_disj r t1 t2 in disj (slot_off (lookup_Int (view_SlabMap r.slabs) t1) j1) (UInt32.t'int (lookup_Int (view_SlabMap r.slabs) t1).element_size) (slot_off (lookup_Int (view_SlabMap r.slabs) t2) j2) (UInt32.t'int (lookup_Int (view_SlabMap r.slabs) t2).element_size)))
  && (forall t: int, j1: int, j2: int. if slot_live r t j1 then
        if slot_live r t j2 then
          if j1 < j2 then
            slab_inv (lookup_Int (view_SlabMap r.slabs) t)
            && ([@stop_split] [@expl:lemma_slots_disjoint requires] ([@stop_split] [@expl:lemma_slots_disjoint requires #0] [%#sslab] slab_geom (lookup_Int (view_SlabMap r.slabs) t))
              /\ ([@stop_split] [@expl:lemma_slots_disjoint requires #1] [%#sslab'0] 0 <= j1 /\ j1 < j2))
            /\ (([@stop_split] [@expl:lemma_slots_disjoint ensures] [%#sslab'1] slot_off (lookup_Int (view_SlabMap r.slabs) t) j1
                + UInt32.t'int (lookup_Int (view_SlabMap r.slabs) t).element_size
              <= slot_off (lookup_Int (view_SlabMap r.slabs) t) j2)
            -> (let _ = lemma_slots_disjoint (lookup_Int (view_SlabMap r.slabs) t) j1 j2 in true))
          else
            true
        
        else
          true
      
      else
        true
    )
  /\ (forall t: int, j1: int, j2: int. slot_live r t j1 /\ slot_live r t j2 /\ j1 < j2
      -> (let _ = lemma_slots_disjoint (lookup_Int (view_SlabMap r.slabs) t) j1 j2 in disj (slot_off (lookup_Int (view_SlabMap r.slabs) t) j1) (UInt32.t'int (lookup_Int (view_SlabMap r.slabs) t).element_size) (slot_off (lookup_Int (view_SlabMap r.slabs) t) j2) (UInt32.t'int (lookup_Int (view_SlabMap r.slabs) t).element_size)))
  && ([@stop_split] [@expl:lemma_no_overlap ensures] [%#sl2a'0] no_overlap r)
