meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant a : t_RegionState

constant b : t_RegionState

constant es : int

function lemma_sc_ok_sub [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/props/l2a.rs" 151 0 151 63] (a: t_RegionState) (b: t_RegionState) (es: int) : ()

goal vc_lemma_sc_ok_sub: ([%#sl2a] sc_ok a /\ sc_sub a.size_classes b.size_classes es (- 1))
  -> ([%#sl2a'0] forall k: int. contains_Int (view_SlabMap a.slabs) k
      -> contains_Int (view_SlabMap b.slabs) k
      /\ (lookup_Int (view_SlabMap b.slabs) k).element_size = (lookup_Int (view_SlabMap a.slabs) k).element_size)
  -> (forall e: int, p: int. if 0 <= p then
        if p < Seq.length (sc_get b.size_classes e) then
          ([@stop_split] [@expl:lemma_sc_sub_at requires] [%#sl2r] sc_sub a.size_classes b.size_classes es (- 1)
            /\ 0 <= p /\ p < Seq.length (sc_get b.size_classes e))
          /\ (([@stop_split] [@expl:lemma_sc_sub_at ensures] [%#sl2r'0] listed (sc_get a.size_classes e) (UInt64.t'int (Seq.get (sc_get b.size_classes e) p))
            \/ e = es /\ UInt64.t'int (Seq.get (sc_get b.size_classes e) p) = - 1)
          -> (let _ = lemma_sc_sub_at a.size_classes b.size_classes es (- 1) e p in true))
        else
          true
      
      else
        true
    )
  /\ (forall e: int, p: int. 0 <= p /\ p < Seq.length (sc_get b.size_classes e)
      -> (let _ = lemma_sc_sub_at a.size_classes b.size_classes es (- 1) e p in listed (sc_get a.size_classes e) (UInt64.t'int (Seq.get (sc_get b.size_classes e) p))))
  && (forall e: int, v: int. listed (sc_get a.size_classes e) v
      -> contains_Int (view_SlabMap a.slabs) v /\ UInt32.t'int (lookup_Int (view_SlabMap a.slabs) v).element_size = e)
  && ([@stop_split] [@expl:lemma_sc_ok_sub ensures] [%#sl2a'1] sc_ok b)
