  [%#sl2r] contains_Int (view_SlabMap r.slabs) t
  /\ 0 <= j
  /\ j < UInt32.t'int (lookup_Int (view_SlabMap r.slabs) t).bitmap.num_slots
  /\ slot_bit (lookup_Int (view_SlabMap r.slabs) t).bitmap j

predicate disj [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/l2.rs" 32 0 32 55] (x1: int) (l1: int) (x2: int) (l2: int) =
  [%#sl2] x1 + l1 <= x2 \/ x2 + l2 <= x1

function slot_off [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/slab.rs" 84 0 84 39] (s: t_Slab) (i: int) : int
 = [%#sslab] UInt64.t'int s.start_offset + i * UInt32.t'int s.element_size

predicate no_overlap [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/props/l2a.rs" 611 0 611 41] (r: t_RegionState) =
  [%#sl2a'1] forall t1: int, j1: int, t2: int, j2: int. slot_live r t1 j1 /\ slot_live r t2 j2 /\ (t1 <> t2 \/ j1 <> j2)
    -> disj (slot_off (lookup_Int (view_SlabMap r.slabs) t1) j1) (UInt32.t'int (lookup_Int (view_SlabMap r.slabs) t1).element_size) (slot_off (lookup_Int (view_SlabMap r.slabs) t2) j2) (UInt32.t'int (lookup_Int (view_SlabMap r.slabs) t2).element_size)

predicate keep_slot [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/l2r.rs" 283 0 283 72] (a: t_RegionState) (b: t_RegionState) (t: int) (j: int) =
  [%#sl2r'0] slot_live b t j
  /\ Seq.get (view_Vec_u64_Global (lookup_Int (view_SlabMap b.slabs) t).keys) j
    = Seq.get (view_Vec_u64_Global (lookup_Int (view_SlabMap a.slabs) t).keys) j
  /\ (lookup_Int (view_SlabMap b.slabs) t).start_offset = (lookup_Int (view_SlabMap a.slabs) t).start_offset
  /\ (lookup_Int (view_SlabMap b.slabs) t).element_size = (lookup_Int (view_SlabMap a.slabs) t).element_size
  /\ (lookup_Int (view_SlabMap b.slabs) t).slab_size = (lookup_Int (view_SlabMap a.slabs) t).slab_size
  /\ (lookup_Int (view_SlabMap b.slabs) t).bitmap.num_slots = (lookup_Int (view_SlabMap a.slabs) t).bitmap.num_slots

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant a : t_RegionState

constant b : t_RegionState

constant s : int

constant i : int

constant t : int

constant k : int

function lemma_new_disj [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/props/l2a.rs" 1146 0 1146 85] (a: t_RegionState) (b: t_RegionState) (s: int) (i: int) (t: int) (k: int) : ()

goal vc_lemma_new_disj: ([%#sl2a] no_overlap b
    /\ slot_live b s i /\ not slot_live a s i /\ slot_live a t k /\ keep_slot a b t k)
  -> (if s <> t then
    slot_off (lookup_Int (view_SlabMap b.slabs) t) k = slot_off (lookup_Int (view_SlabMap a.slabs) t) k
    && ([@stop_split] [@expl:lemma_new_disj ensures] [%#sl2a'0] disj (slot_off (lookup_Int (view_SlabMap b.slabs) s) i) (UInt32.t'int (lookup_Int (view_SlabMap b.slabs) s).element_size) (slot_off (lookup_Int (view_SlabMap a.slabs) t) k) (UInt32.t'int (lookup_Int (view_SlabMap a.slabs) t).element_size))
  else
    i <> k
    && slot_off (lookup_Int (view_SlabMap b.slabs) t) k = slot_off (lookup_Int (view_SlabMap a.slabs) t) k
    && ([@stop_split] [@expl:lemma_new_disj ensures] [%#sl2a'0] disj (slot_off (lookup_Int (view_SlabMap b.slabs) s) i) (UInt32.t'int (lookup_Int (view_SlabMap b.slabs) s).element_size) (slot_off (lookup_Int (view_SlabMap a.slabs) t) k) (UInt32.t'int (lookup_Int (view_SlabMap a.slabs) t).element_size))
  )
