constant b : t_RegionState

constant ps : Seq.seq tup2_u64_usize

function lemma_pv_keep [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/props/l2a.rs" 142 0 142 75] (a: t_RegionState) (b: t_RegionState) (ps: Seq.seq tup2_u64_usize) : ()

