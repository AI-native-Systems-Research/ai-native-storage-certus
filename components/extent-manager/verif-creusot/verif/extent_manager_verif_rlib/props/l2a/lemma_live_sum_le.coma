  forall p: Map.map t_Slab bool [such_that_Slab p]. ([%#slogic] exists x: t_Slab. index_Mapping_Slab_bool p x)
    -> ([%#slogic'0] index_Mapping_Slab_bool p (such_that_Slab p))

function unwrap_Option_Slab (self: t_Option_Slab) : t_Slab = [%#soption'0] match self with
    | Some'0 x -> x
    | None'0 -> such_that_Slab (fun (__0: t_Slab) -> true)
    end

function lookup_Int [@inline:trivial] (self: t_FMap_Int_Slab) (k: int) : t_Slab =
  [%#sfmap'0] unwrap_Option_Slab (get_Int self k)

meta "rewrite_def" function lookup_Int

predicate rg_slabs [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/region.rs" 165 0 165 39] (r: t_RegionState) =
  [%#sregion'6] forall k: int. contains_Int (view_SlabMap r.slabs) k
    -> slab_ok r (lookup_Int (view_SlabMap r.slabs) k)
    /\ UInt64.t'int (lookup_Int (view_SlabMap r.slabs) k).start_offset = k

predicate rg_inv [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/region.rs" 173 0 173 37] (r: t_RegionState) =
  [%#sregion'1] rg_params r /\ rg_buddy r /\ rg_slabs r

function live_sum [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/props/l2a.rs" 2011 0 2011 60] (r: t_RegionState) (ks: Seq.seq int) (n: int) : int

axiom live_sum_def: forall r: t_RegionState, ks: Seq.seq int, n: int [live_sum r ks n]. live_sum r ks n
    = ([%#sl2a'3] if n <= 0 then
      0
    else
      live_sum r ks (n - 1)
      + UInt32.t'int (lookup_Int (view_SlabMap r.slabs) (Seq.get ks (n - 1))).bitmap.allocated_count
      * UInt32.t'int (lookup_Int (view_SlabMap r.slabs) (Seq.get ks (n - 1))).element_size
    )

function sk [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/l2r.rs" 16 0 16 32] (r: t_RegionState) : int
 = [%#sl2r] span (UInt32.t'int r.buddy.sector_size) (slab_k r)

predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
  [%#swell_founded] self >= 0 /\ self > other

meta "rewrite_def" predicate well_founded_relation_Int

function lemma_cnt_bounds [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/bitmap.rs" 77 0 77 52] (a: t_AllocationBitmap) (n: int) : ()

axiom lemma_cnt_bounds_spec: forall a: t_AllocationBitmap, n: int. ([%#sbitmap] 0 <= n)
    -> ([%#sbitmap'0] 0 <= cnt a n /\ cnt a n <= n)

function lemma_slots_fit [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/slab.rs" 93 0 93 31] (s: t_Slab) : ()

axiom lemma_slots_fit_spec: forall s: t_Slab. ([%#sslab] slab_geom s)
    -> ([%#sslab'0] UInt32.t'int s.bitmap.num_slots
    <= ComputerDivision.div (UInt64.t'int s.slab_size) (UInt32.t'int s.element_size))

axiom lemma_slots_fit_spec'0: forall s: t_Slab. ([%#sslab] slab_geom s)
    -> ([%#sslab'1] UInt32.t'int s.bitmap.num_slots * UInt32.t'int s.element_size <= UInt64.t'int s.slab_size)

function lemma_slab_fits [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/region.rs" 1159 0 1159 38] (r: t_RegionState) : ()

