        /\ UInt32.t'int s.bitmap.allocated_count <= UInt32.t'int s.bitmap.num_slots /\ 0 <= UInt32.t'int s.element_size)
      /\ (([@stop_split] [@expl:lemma_mul_le ensures] [%#sbuddy'0] UInt32.t'int s.bitmap.allocated_count
