function lemma_live_sum_le [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/props/l2a.rs" 2048 0 2048 62] (r: t_RegionState) (ks: Seq.seq int) (n: int) : ()

goal vc_lemma_live_sum_le: ([%#sl2a'0] rg_inv r
