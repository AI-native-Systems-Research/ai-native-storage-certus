        <= UInt32.t'int s.bitmap.num_slots * UInt32.t'int s.element_size)
      -> (let _ = lemma_mul_le (UInt32.t'int s.bitmap.allocated_count) (UInt32.t'int s.bitmap.num_slots) (UInt32.t'int s.element_size) in ([@stop_split] [@expl:lemma_mul_le requires] [%#sbuddy] 0
          <= 0
        /\ 0 <= UInt32.t'int s.bitmap.allocated_count /\ 0 <= UInt32.t'int s.element_size)
      /\ (([@stop_split] [@expl:lemma_mul_le ensures] [%#sbuddy'0] 0 * UInt32.t'int s.element_size
        <= UInt32.t'int s.bitmap.allocated_count * UInt32.t'int s.element_size)
      -> (let _ = lemma_mul_le 0 (UInt32.t'int s.bitmap.allocated_count) (UInt32.t'int s.element_size) in UInt32.t'int s.bitmap.allocated_count
          * UInt32.t'int s.element_size
        <= sk r
