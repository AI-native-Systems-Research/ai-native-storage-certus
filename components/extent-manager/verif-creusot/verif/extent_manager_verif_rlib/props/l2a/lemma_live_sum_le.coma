        <= UInt64.t'int s.slab_size))
      -> (let _ = lemma_slots_fit s in ([@stop_split] [@expl:lemma_slab_fits requires] [%#sregion] rg_params r)
      /\ (([@stop_split] [@expl:lemma_slab_fits ensures] [%#sregion'0] UInt64.t'int r.format_params.slab_size'0
        <= span (UInt32.t'int r.buddy.sector_size) (slab_k r))
      -> (let _ = lemma_slab_fits r in ([@stop_split] [@expl:lemma_mul_le requires] [%#sbuddy] 0
