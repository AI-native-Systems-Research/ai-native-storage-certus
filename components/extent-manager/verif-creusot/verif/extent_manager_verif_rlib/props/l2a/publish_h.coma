  forall a: t_RegionState, b: t_RegionState, s: UInt64.t, i: UInt64.t, key: UInt64.t, hs: Seq.seq tup2_u64_usize, hs2: Seq.seq tup2_u64_usize, j: int. ([%#sl2a'42] lg a hs
