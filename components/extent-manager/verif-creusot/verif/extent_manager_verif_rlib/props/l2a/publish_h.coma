let publish_slot (self: MutBorrow.t t_RegionState) (slab_start: UInt64.t) (slot_idx: UInt64.t) (key: UInt64.t)
  (return (x: ())) =
{[@stop_split] [@expl:publish_slot requires] ([@stop_split] [@expl:publish_slot 'self' type invariant] [%#sregion'11] inv_refmut_RegionState self)
  /\ ([@stop_split] [@expl:publish_slot requires #0] [%#sregion'12] rg_inv self.current)
  /\ ([@stop_split] [@expl:publish_slot requires #1] [%#sregion'13] match get_Int (view_SlabMap self.current.slabs) (UInt64.t'int slab_start) with
    | Some'0 sl -> UInt64.t'int slot_idx < Seq.length (view_Vec_u64_Global sl.keys)
    | None'0 -> true
    end)}
  any
  [ return (result: ()) ->
  {[@stop_split] [@expl:publish_slot ensures] ([@stop_split] [@expl:publish_slot ensures #0] [%#sregion'14] rg_inv self.final)
    /\ ([@stop_split] [@expl:publish_slot ensures #1] [%#sregion'15] rg_frame self.current self.final)
    /\ ([@stop_split] [@expl:publish_slot ensures #2] [%#sregion'16] self.final.buddy = self.current.buddy
      /\ self.final.pending_frees = self.current.pending_frees)
    /\ ([@stop_split] [@expl:publish_slot ensures #3] [%#sregion'17] self.final.size_classes = self.current.size_classes
      /\ self.final.dirty = true)
    /\ ([@stop_split] [@expl:publish_slot ensures #4] [%#sregion'18] get_Int (view_SlabMap self.current.slabs) (UInt64.t'int slab_start)
        = None'0 -> self.final.slabs = self.current.slabs)
    /\ ([@stop_split] [@expl:publish_slot ensures #5] [%#sregion'19] forall sl: t_Slab. get_Int (view_SlabMap self.current.slabs) (UInt64.t'int slab_start)
          = Some'0 sl
        -> view_SlabMap self.final.slabs
          = insert_Int (view_SlabMap self.current.slabs) (UInt64.t'int slab_start) (lookup_Int (view_SlabMap self.final.slabs) (UInt64.t'int slab_start))
        /\ view_Vec_u64_Global (lookup_Int (view_SlabMap self.final.slabs) (UInt64.t'int slab_start)).keys
          = Seq.set (view_Vec_u64_Global sl.keys) (UInt64.t'int slot_idx) key
        /\ (lookup_Int (view_SlabMap self.final.slabs) (UInt64.t'int slab_start)).bitmap = sl.bitmap
        /\ (lookup_Int (view_SlabMap self.final.slabs) (UInt64.t'int slab_start)).element_size = sl.element_size
        /\ (lookup_Int (view_SlabMap self.final.slabs) (UInt64.t'int slab_start)).start_offset = sl.start_offset
        /\ (lookup_Int (view_SlabMap self.final.slabs) (UInt64.t'int slab_start)).slab_size = sl.slab_size)
    /\ ([@stop_split] [@expl:publish_slot ensures #6] [%#sregion'20] nonfull_listed self.current
    -> nonfull_listed self.final)}
    (! return {result}) ]

