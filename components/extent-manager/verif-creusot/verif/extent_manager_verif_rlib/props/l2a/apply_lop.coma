  /\ ([@stop_split] [@expl:flush_pending_frees requires #1] [%#sregion'1] pending_ok self.current)}
  any
  [ return (result: ()) ->
  {[@stop_split] [@expl:flush_pending_frees ensures] ([@stop_split] [@expl:flush_pending_frees ensures #0] [%#sregion'2] rg_inv self.final)
    /\ ([@stop_split] [@expl:flush_pending_frees ensures #1] [%#sregion'3] rg_frame self.current self.final)
    /\ ([@stop_split] [@expl:flush_pending_frees ensures #2] [%#sregion'4] Seq.length (view_Vec_tup2_u64_usize_Global self.final.pending_frees)
        = 0
      /\ self.final.dirty = self.current.dirty)
    /\ ([@stop_split] [@expl:flush_pending_frees ensures #3] [%#sregion'5] Seq.length (view_Vec_tup2_u64_usize_Global self.current.pending_frees)
        = 0 -> self.final = self.current)
    /\ ([@stop_split] [@expl:flush_pending_frees ensures #4] [%#sregion'6] forall s: UInt64.t, i: UInt64.t. view_Vec_tup2_u64_usize_Global self.current.pending_frees
          = Seq.singleton { f0 = s; f1 = i }
        -> free_case self.current self.final s i (lookup_Int (view_SlabMap self.current.slabs) (UInt64.t'int s)))
    /\ ([@stop_split] [@expl:flush_pending_frees ensures #5] [%#sregion'7] nonfull_listed self.current
      -> nonfull_listed self.final)
    /\ ([@stop_split] [@expl:flush_pending_frees ensures #6] [%#sregion'8] forall s: UInt64.t, i: UInt64.t. view_Vec_tup2_u64_usize_Global self.current.pending_frees
          = Seq.singleton { f0 = s; f1 = i } -> flush1_tf self.current self.final s)
    /\ ([@stop_split] [@expl:flush_pending_frees ensures #7] [%#sregion'9] flushed_all self.current self.final)
    /\ ([@stop_split] [@expl:flush_pending_frees ensures #8] [%#sregion'10] slabs_shrunk self.current self.final)
    /\ ([@stop_split] [@expl:flush_pending_frees ensures #9] [%#sregion'11] fl_spec self.current self.final)}
    (! return {result}) ]

