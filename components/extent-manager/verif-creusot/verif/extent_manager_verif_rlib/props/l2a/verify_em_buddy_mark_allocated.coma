let mark_allocated (self: MutBorrow.t t_BuddyAllocator) (abs_offset: UInt64.t) (size: UInt64.t) (return (x: ())) =
{[@stop_split] [@expl:mark_allocated requires] ([@stop_split] [@expl:mark_allocated requires #0] [%#sbuddy] bd_inv self.current)
  /\ ([@stop_split] [@expl:mark_allocated requires #1] [%#sbuddy'0] UInt64.t'int abs_offset
    >= UInt64.t'int self.current.base_offset)
  /\ ([@stop_split] [@expl:mark_allocated requires #2] [%#sbuddy'1] ord (ComputerDivision.div (UInt64.t'int size) (UInt32.t'int self.current.sector_size))
  <= UInt64.t'int self.current.max_order)}
  any
  [ return (result: ()) ->
  {[@stop_split] [@expl:mark_allocated ensures] ([@stop_split] [@expl:mark_allocated ensures #0] [%#sbuddy'2] bd_shape self.final)
    /\ ([@stop_split] [@expl:mark_allocated ensures #1] [%#sbuddy'3] bd_aligned self.final)
    /\ ([@stop_split] [@expl:mark_allocated ensures #2] [%#sbuddy'4] bd_inside self.final)
    /\ ([@stop_split] [@expl:mark_allocated ensures #3] [%#sbuddy'5] bd_inv self.final)
    /\ ([@stop_split] [@expl:mark_allocated ensures #4] [%#sbuddy'6] self.final.base_offset = self.current.base_offset
      /\ self.final.total_usable_size = self.current.total_usable_size)
    /\ ([@stop_split] [@expl:mark_allocated ensures #5] [%#sbuddy'7] self.final.sector_size = self.current.sector_size
      /\ self.final.max_order = self.current.max_order)
    /\ ([@stop_split] [@expl:mark_allocated ensures #6] [%#sbuddy'8] Seq.length (view_Vec_Vec_u64_Global_Global self.final.free_lists)
      = Seq.length (view_Vec_Vec_u64_Global_Global self.current.free_lists))
    /\ ([@stop_split] [@expl:mark_allocated ensures #7] [%#sbuddy'9] (forall q: int. 0 <= q
              /\ q
              < Seq.length (view_Vec_u64_Global (Seq.get (view_Vec_Vec_u64_Global_Global self.current.free_lists) (ord (ComputerDivision.div (UInt64.t'int size) (UInt32.t'int self.current.sector_size)))))
            -> UInt64.t'int (Seq.get (view_Vec_u64_Global (Seq.get (view_Vec_Vec_u64_Global_Global self.current.free_lists) (ord (ComputerDivision.div (UInt64.t'int size) (UInt32.t'int self.current.sector_size))))) q)
            <> UInt64.t'int abs_offset - UInt64.t'int self.current.base_offset)
        /\ (forall sk: int, sp: UInt64.t, x: UInt64.t. ord (ComputerDivision.div (UInt64.t'int size) (UInt32.t'int self.current.sector_size))
              < sk
            /\ sk <= UInt64.t'int self.current.max_order
            /\ UInt64.t'int sp = span (UInt32.t'int self.current.sector_size) sk
            /\ UInt64.t'int x = UInt64.t'int abs_offset - UInt64.t'int self.current.base_offset
          -> (forall q: int. 0 <= q
              /\ q
              < Seq.length (view_Vec_u64_Global (Seq.get (view_Vec_Vec_u64_Global_Global self.current.free_lists) sk))
            -> Seq.get (view_Vec_u64_Global (Seq.get (view_Vec_Vec_u64_Global_Global self.current.free_lists) sk)) q
            <> UInt64.bw_and x (UInt64.bw_not (UInt64.sub sp (1: UInt64.t))))) -> self.final = self.current)
