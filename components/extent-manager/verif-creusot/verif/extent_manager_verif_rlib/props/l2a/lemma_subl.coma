let%span sl2a = "/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/props/l2a.rs" 120 11 120 98
let%span sl2a'0 = "/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/props/l2a.rs" 121 10 121 23
let%span sl2a'1 = "/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/props/l2a.rs" 114 8 115 95

use creusot.int.UInt64
use seq.Seq
use int.Int

type tup2_u64_usize = { f0: UInt64.t; f1: UInt64.t }

predicate subl [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/props/l2a.rs" 112 0 112 71] (y: Seq.seq tup2_u64_usize) (x: Seq.seq tup2_u64_usize) (j: int) =
  [%#sl2a'1] 0 <= j
  /\ j < Seq.length x
  /\ Seq.length y = Seq.length x - 1
  /\ (forall p: int. 0 <= p /\ p < Seq.length y -> Seq.get y p = (if p < j then Seq.get x p else Seq.get x (p + 1)))

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant y : Seq.seq tup2_u64_usize

constant x : Seq.seq tup2_u64_usize

constant j : int

function lemma_subl [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/props/l2a.rs" 122 0 122 69] (y: Seq.seq tup2_u64_usize) (x: Seq.seq tup2_u64_usize) (j: int) : ()

goal vc_lemma_subl: ([%#sl2a] 0 <= j
    /\ j < Seq.length x /\ y = Seq.(++) (Seq.([..]) x 0 j) (Seq.([..]) x (j + 1) (Seq.length x)))
  -> ([@stop_split] [@expl:lemma_subl ensures] [%#sl2a'0] subl y x j)
