        -> Seq.length (view_Vec_u64_Global (Seq.get (view_Vec_Vec_u64_Global_Global result.free_lists'0) o)) = 0))
    /\ ([@stop_split] [@expl:new ensures #9] [%#sbuddy'10] ComputerDivision.div (UInt64.t'int total_usable_size) (UInt32.t'int sector_size'1)
        >= 1
      -> Pow2int.pow2 (UInt64.t'int result.max_order'0)
