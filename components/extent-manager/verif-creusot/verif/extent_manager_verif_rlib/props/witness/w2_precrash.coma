      < Pow2int.pow2 (UInt64.t'int result.max_order'0 + 1))
    /\ ([@stop_split] [@expl:new ensures #7] [%#sbuddy'8] forall m: int. 0 <= m
          /\ Pow2int.pow2 m = ComputerDivision.div (UInt64.t'int total_usable_size) (UInt32.t'int sector_size'1)
        -> UInt64.t'int result.max_order'0 = m
        /\ view_Vec_u64_Global (Seq.get (view_Vec_Vec_u64_Global_Global result.free_lists'0) m)
