    /\ ([@stop_split] [@expl:new ensures #10] [%#sbuddy'11] tf (view_Vec_Vec_u64_Global_Global result.free_lists'0) (UInt32.t'int sector_size'1) (Seq.length (view_Vec_Vec_u64_Global_Global result.free_lists'0))
