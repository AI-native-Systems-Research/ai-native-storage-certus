    /\ ([@stop_split] [@expl:new ensures #8] [%#sbuddy'9] Pow2int.pow2 (UInt64.t'int result.max_order'0)
        = ComputerDivision.div (UInt64.t'int total_usable_size) (UInt32.t'int sector_size'1)
      -> view_Vec_u64_Global (Seq.get (view_Vec_Vec_u64_Global_Global result.free_lists'0) (UInt64.t'int result.max_order'0))
        = Seq.singleton (0: UInt64.t)
