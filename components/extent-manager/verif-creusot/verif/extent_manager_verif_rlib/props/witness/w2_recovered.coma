let rebuild_region (base: UInt64.t) (size: UInt64.t) (fp: t_FormatParams) (descs: t_Vec_SlabDescriptor_Global)
  (return (x: t_RegionState)) =
{[@stop_split] [@expl:rebuild_region requires] ([@stop_split] [@expl:rebuild_region requires #0] [%#sregion'1] UInt32.t'int fp.sector_size
      > 0
    /\ UInt64.t'int fp.slab_size > 0
    /\ ComputerDivision.mod (UInt64.t'int fp.slab_size) (UInt32.t'int fp.sector_size) = 0)
  /\ ([@stop_split] [@expl:rebuild_region requires #1] [%#sregion'2] UInt64.t'int fp.slab_size
      + UInt32.t'int fp.sector_size
    <= UInt64.t'int const_MAX'0)
  /\ ([@stop_split] [@expl:rebuild_region requires #2] [%#sregion'3] UInt64.t'int base + UInt64.t'int size
    <= UInt64.t'int const_MAX'0)
  /\ ([@stop_split] [@expl:rebuild_region requires #3] [%#sregion'4] 2 * UInt64.t'int size + UInt32.t'int fp.sector_size
    <= UInt64.t'int const_MAX'0)
  /\ ([@stop_split] [@expl:rebuild_region requires #4] [%#sregion'5] forall p: int. 0 <= p
      /\ p < Seq.length (view_Vec_SlabDescriptor_Global descs)
    -> desc_ok (Seq.get (view_Vec_SlabDescriptor_Global descs) p) (UInt64.t'int base) (UInt64.t'int size) fp)}
  any
  [ return (result: t_RegionState) ->
  {[@stop_split] [@expl:rebuild_region ensures] ([@stop_split] [@expl:rebuild_region result type invariant] [%#sregion'6] inv_RegionState result)
    /\ ([@stop_split] [@expl:rebuild_region ensures #0] [%#sregion'7] rg_inv result)
    /\ ([@stop_split] [@expl:rebuild_region ensures #1] [%#sregion'8] result.format_params = fp
      /\ result.dirty = false /\ Seq.length (view_Vec_tup2_u64_usize_Global result.pending_frees) = 0)
    /\ ([@stop_split] [@expl:rebuild_region ensures #2] [%#sregion'9] result.buddy.base_offset'0 = base
      /\ result.buddy.total_usable_size'0 = size)
    /\ ([@stop_split] [@expl:rebuild_region ensures #3] [%#sregion'10] result.buddy.sector_size'0 = fp.sector_size)
    /\ ([@stop_split] [@expl:rebuild_region ensures #4] [%#sregion'11] Seq.length (view_Vec_SlabDescriptor_Global descs)
        = 1
      -> rebuilt_one result (Seq.get (view_Vec_SlabDescriptor_Global descs) 0) (UInt64.t'int base) (UInt64.t'int size) fp)
    /\ ([@stop_split] [@expl:rebuild_region ensures #5] [%#sregion'12] nonfull_listed result)
    /\ ([@stop_split] [@expl:rebuild_region ensures #6] [%#sregion'13] Seq.length (view_Vec_SlabDescriptor_Global descs)
        = 1
      -> rebuilt_hit result (Seq.get (view_Vec_SlabDescriptor_Global descs) 0) (UInt64.t'int base) (UInt64.t'int size) fp)
    /\ ([@stop_split] [@expl:rebuild_region ensures #7] [%#sregion'14] starts_distinct (view_Vec_SlabDescriptor_Global descs)
      -> rebuilt_all result (view_Vec_SlabDescriptor_Global descs))
    /\ ([@stop_split] [@expl:rebuild_region ensures #8] [%#sregion'15] p2 (UInt32.t'int fp.sector_size)
      /\ starts_distinct (view_Vec_SlabDescriptor_Global descs) -> rg_good_o result)}
    (! return {result}) ]

