  {[@stop_split] [@expl:work ensures] ([@stop_split] [@expl:work ensures #0] [%#sb5'19] UInt64.t'int self.final.ckpts
        = UInt64.t'int self.current.ckpts + 1
      /\ self.final.ph = Top)
    /\ ([@stop_split] [@expl:work ensures #1] [%#sb5'20] self.final.interval = self.current.interval
    /\ self.final.now = self.current.now /\ self.final.shutdown = self.current.shutdown)}
