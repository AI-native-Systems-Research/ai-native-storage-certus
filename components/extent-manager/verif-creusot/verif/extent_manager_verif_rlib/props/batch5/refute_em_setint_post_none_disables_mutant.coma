constant const_MAX: UInt64.t = (18446744073709551615: UInt64.t)

let work (self: MutBorrow.t t_TSys) (return (x: ())) = {[@stop_split] [@expl:work requires] [%#sb5'18] self.current.ph
    = Work
  /\ UInt64.t'int self.current.ckpts < UInt64.t'int const_MAX}
  any
