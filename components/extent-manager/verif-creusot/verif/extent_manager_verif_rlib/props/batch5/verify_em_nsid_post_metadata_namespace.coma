let read_blocks (self: t_Client) (dev'0: MutBorrow.t t_BDev) (lba: UInt64.t) (num_bytes: UInt64.t)
  (return (x: t_Result_Vec_u8_Global_EmError)) =
{[@stop_split] [@expl:read_blocks requires] ([@stop_split] [@expl:read_blocks requires #0] [%#sblockio'1] UInt32.t'int self.sector_size'3
    > 0)
  /\ ([@stop_split] [@expl:read_blocks requires #1] [%#sblockio'2] UInt64.t'int num_bytes
      + UInt32.t'int self.sector_size'3
    <= UInt64.t'int const_MAX)
  /\ ([@stop_split] [@expl:read_blocks requires #2] [%#sblockio'3] UInt64.t'int self.base_lba'3 + UInt64.t'int lba
    + ComputerDivision.div (UInt64.t'int num_bytes + UInt32.t'int self.sector_size'3
    - 1) (UInt32.t'int self.sector_size'3)
  <= UInt64.t'int const_MAX'0)}
  any
  [ return (result: t_Result_Vec_u8_Global_EmError) ->
  {[@stop_split] [@expl:read_blocks ensures] ([@stop_split] [@expl:read_blocks ensures #0] [%#sblockio'4] forall p: int. 0
            <= p
          /\ p < Seq.length dev'0.current.log -> Seq.get dev'0.final.log p = Seq.get dev'0.current.log p)
    /\ ([@stop_split] [@expl:read_blocks ensures #1] [%#sblockio'5] Seq.length dev'0.current.log
      <= Seq.length dev'0.final.log)
    /\ ([@stop_split] [@expl:read_blocks ensures #2] [%#sblockio'6] forall p: int. Seq.length dev'0.current.log <= p
          /\ p < Seq.length dev'0.final.log
        -> Seq.get dev'0.final.log p
        = { f0'0 = UInt32.t'int self.ns_id'3;
            f1'0 = UInt64.t'int self.base_lba'3 + UInt64.t'int lba + (p - Seq.length dev'0.current.log) })
    /\ ([@stop_split] [@expl:read_blocks ensures #3] [%#sblockio'7] dev'0.final.store = dev'0.current.store)
    /\ ([@stop_split] [@expl:read_blocks ensures #4] [%#sblockio'8] match result with
      | Ok v -> Seq.length (view_Vec_u8_Global v) = UInt64.t'int num_bytes
      /\ (forall q: int. 0 <= q /\ q < UInt64.t'int num_bytes
        -> match get_tup2_Int_Int dev'0.current.store { f0'0 = UInt32.t'int self.ns_id'3;
                                                        f1'0 = UInt64.t'int self.base_lba'3 + UInt64.t'int lba
                                                        + ComputerDivision.div q (UInt32.t'int self.sector_size'3) } with
          | Some'5 blk -> Seq.get (view_Vec_u8_Global v) q
          = Seq.get blk (ComputerDivision.mod q (UInt32.t'int self.sector_size'3))
          | None'5 -> true
          end)
      | Err e -> e = IoError
      end)}
    (! return {result}) ]

