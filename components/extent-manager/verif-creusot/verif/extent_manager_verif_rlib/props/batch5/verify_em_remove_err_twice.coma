    /\ ([@stop_split] [@expl:remove_extent_by_offset ensures #4] [%#sregion'6] forall s: UInt64.t, i: UInt64.t. rm_case self.current offset s i
        -> rm_post self.current self.final s i /\ result = Ok ())
