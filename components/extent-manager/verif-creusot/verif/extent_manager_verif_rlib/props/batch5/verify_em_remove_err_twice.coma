let remove_extent_by_offset (self: MutBorrow.t t_RegionState) (offset: UInt64.t) (return (x: t_Result_unit_EmError)) =
{[@stop_split] [@expl:remove_extent_by_offset requires] ([@stop_split] [@expl:remove_extent_by_offset 'self' type invariant] [%#sregion'0] inv_refmut_RegionState self)
  /\ ([@stop_split] [@expl:remove_extent_by_offset requires] [%#sregion'1] rg_inv self.current)}
  any
  [ return (result: t_Result_unit_EmError) ->
  {[@stop_split] [@expl:remove_extent_by_offset ensures] ([@stop_split] [@expl:remove_extent_by_offset ensures #0] [%#sregion'2] rg_inv self.final)
    /\ ([@stop_split] [@expl:remove_extent_by_offset ensures #1] [%#sregion'3] rg_frame self.current self.final)
    /\ ([@stop_split] [@expl:remove_extent_by_offset ensures #2] [%#sregion'4] self.final.buddy = self.current.buddy
      /\ self.final.size_classes = self.current.size_classes)
    /\ ([@stop_split] [@expl:remove_extent_by_offset ensures #3] [%#sregion'5] match result with
        | Ok () -> self.final.dirty = true
        /\ Seq.length (view_Vec_tup2_u64_usize_Global self.final.pending_frees)
        = Seq.length (view_Vec_tup2_u64_usize_Global self.current.pending_frees) + 1
        | Err _ -> self.final = self.current
