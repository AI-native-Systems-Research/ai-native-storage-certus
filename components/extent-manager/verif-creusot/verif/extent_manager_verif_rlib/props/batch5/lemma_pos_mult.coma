use int.ComputerDivision
use int.Int

function lemma_divmod [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/buddy.rs" 184 0 184 35] (x: int) (m: int) : ()

axiom lemma_divmod_spec: forall x: int, m: int. ([%#sbuddy] m > 0 /\ x >= 0)
    -> ([%#sbuddy'0] x = m * ComputerDivision.div x m + ComputerDivision.mod x m)

axiom lemma_divmod_spec'0: forall x: int, m: int. ([%#sbuddy] m > 0 /\ x >= 0)
    -> ([%#sbuddy'1] 0 <= ComputerDivision.mod x m /\ ComputerDivision.mod x m < m)

axiom lemma_divmod_spec'1: forall x: int, m: int. ([%#sbuddy] m > 0 /\ x >= 0)
    -> ([%#sbuddy'2] ComputerDivision.div x m >= 0)

function lemma_mul_le [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/buddy.rs" 156 0 156 43] (a: int) (b: int) (c: int) : ()

axiom lemma_mul_le_spec: forall a: int, b: int, c: int. ([%#sbuddy'3] 0 <= a /\ a <= b /\ 0 <= c)
    -> ([%#sbuddy'4] a * c <= b * c)

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant d : int

constant m : int

function lemma_pos_mult [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/props/batch5.rs" 33 0 33 37] (d: int) (m: int) : ()

goal vc_lemma_pos_mult: ([%#sbatch5] m > 0 /\ d > 0 /\ ComputerDivision.mod d m = 0)
  -> ([@stop_split] [@expl:lemma_divmod requires] [%#sbuddy] m > 0 /\ d >= 0)
  /\ (([@stop_split] [@expl:lemma_divmod ensures] ([@stop_split] [@expl:lemma_divmod ensures #0] [%#sbuddy'0] d
      = m * ComputerDivision.div d m + ComputerDivision.mod d m)
    /\ ([@stop_split] [@expl:lemma_divmod ensures #1] [%#sbuddy'1] 0 <= ComputerDivision.mod d m
      /\ ComputerDivision.mod d m < m)
    /\ ([@stop_split] [@expl:lemma_divmod ensures #2] [%#sbuddy'2] ComputerDivision.div d m >= 0))
  -> (let _ = lemma_divmod d m in ([@stop_split] [@expl:lemma_mul_le requires] [%#sbuddy'3] 0 <= 1
    /\ 1 <= ComputerDivision.div d m /\ 0 <= m)
  /\ (([@stop_split] [@expl:lemma_mul_le ensures] [%#sbuddy'4] 1 * m <= ComputerDivision.div d m * m)
  -> ([@stop_split] [@expl:lemma_pos_mult ensures] [%#sbatch5'0] d >= m))))
