        /\ ([@stop_split] [@expl:lemma_no_shared_slot requires #1] [%#sbatch5'5] 0 <= UInt64.t'int i
          /\ UInt64.t'int i < UInt32.t'int (lookup_Int (view_SlabMap a.slabs) (UInt64.t'int s)).bitmap.num_slots
          /\ 0 <= UInt64.t'int i2
          /\ UInt64.t'int i2 < UInt32.t'int (lookup_Int (view_SlabMap a.slabs) (UInt64.t'int s2)).bitmap.num_slots)
        /\ ([@stop_split] [@expl:lemma_no_shared_slot requires #2] [%#sbatch5'6] slot_off (lookup_Int (view_SlabMap a.slabs) (UInt64.t'int s)) (UInt64.t'int i)
        = slot_off (lookup_Int (view_SlabMap a.slabs) (UInt64.t'int s2)) (UInt64.t'int i2)))
      /\ (([@stop_split] [@expl:lemma_no_shared_slot ensures] [%#sbatch5'7] UInt64.t'int s = UInt64.t'int s2)
      -> (let _ = lemma_no_shared_slot a (UInt64.t'int s) (UInt64.t'int i) (UInt64.t'int s2) (UInt64.t'int i2) in s2 = s
      && UInt32.t'int (lookup_Int (view_SlabMap a.slabs) (UInt64.t'int s)).element_size > 0
