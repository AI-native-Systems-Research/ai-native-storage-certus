    = (lookup_Int (view_SlabMap a.slabs) (UInt64.t'int s2)).element_size then
      (lookup_Int (view_SlabMap c.slabs) (UInt64.t'int s2)).bitmap.num_slots
        = (lookup_Int (view_SlabMap a.slabs) (UInt64.t'int s2)).bitmap.num_slots
      && slot_off (lookup_Int (view_SlabMap a.slabs) (UInt64.t'int s2)) (UInt64.t'int i2) = UInt64.t'int off
      && ([@stop_split] [@expl:lemma_no_shared_slot requires] ([@stop_split] [@expl:lemma_no_shared_slot requires #0] [%#sbatch5'4] rg_inv a
          /\ contains_Int (view_SlabMap a.slabs) (UInt64.t'int s)
