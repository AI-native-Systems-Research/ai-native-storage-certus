    /\ ([@stop_split] [@expl:new ensures #6] [%#sparams'5] result.instance_id = instance_id'0
      /\ result.metadata_disk_ns_id = metadata_disk_ns_id'0)
    /\ ([@stop_split] [@expl:new ensures #7] [%#sparams'6] result.data_start_offset = data_start_offset'0)}
    (! return {result}) ]

