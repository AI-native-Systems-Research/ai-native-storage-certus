use creusot.int.UInt64
use creusot.prelude.MutBorrow
use creusot.prelude.Any
use int.Int

type t_Option_u64 = None | Some UInt64.t

type t_TPh = Top | Wait int | WaitInf | Woken bool | Work | Exited

type t_TSys = { interval: t_Option_u64; now: int; ph: t_TPh; shutdown: bool; ckpts: UInt64.t }

let th_enter (self: MutBorrow.t t_TSys) (return (x: ())) =
{[@stop_split] [@expl:th_enter requires] [%#sb5] self.current.ph = Top}
  any
  [ return (result: ()) ->
  {[@stop_split] [@expl:th_enter ensures] ([@stop_split] [@expl:th_enter ensures #0] [%#sb5'0] self.final.interval
        = self.current.interval
      /\ self.final.now = self.current.now)
    /\ ([@stop_split] [@expl:th_enter ensures #1] [%#sb5'1] self.final.shutdown = self.current.shutdown
      /\ self.final.ckpts = self.current.ckpts)
    /\ ([@stop_split] [@expl:th_enter ensures #2] [%#sb5'2] self.current.shutdown -> self.final.ph = Exited)
    /\ ([@stop_split] [@expl:th_enter ensures #3] [%#sb5'3] not self.current.shutdown
    -> match self.current.interval with
      | Some d -> match self.final.ph with
        | Wait dl -> dl = self.current.now + UInt64.t'int d
        | _ -> false
        end
      | None -> self.final.ph = WaitInf
      end)}
    (! return {result}) ]

let tick (self: MutBorrow.t t_TSys) (dt: UInt64.t) (return (x: ())) = any
  [ return (result: ()) ->
  {[@stop_split] [@expl:tick ensures] ([@stop_split] [@expl:tick ensures #0] [%#sb5'4] self.final.now
      = self.current.now + UInt64.t'int dt)
    /\ ([@stop_split] [@expl:tick ensures #1] [%#sb5'5] self.final.interval = self.current.interval
      /\ self.final.ph = self.current.ph)
    /\ ([@stop_split] [@expl:tick ensures #2] [%#sb5'6] self.final.shutdown = self.current.shutdown
    /\ self.final.ckpts = self.current.ckpts)}
    (! return {result}) ]

let spurious (self: MutBorrow.t t_TSys) (return (x: ())) =
{[@stop_split] [@expl:spurious requires] [%#sb5'7] match self.current.ph with
    | Wait _ -> true
    | WaitInf -> true
    | _ -> false
    end}
  any
  [ return (result: ()) ->
  {[@stop_split] [@expl:spurious ensures] ([@stop_split] [@expl:spurious ensures #0] [%#sb5'8] self.final.ph
      = Woken false)
    /\ ([@stop_split] [@expl:spurious ensures #1] [%#sb5'9] self.final.interval = self.current.interval
      /\ self.final.now = self.current.now)
    /\ ([@stop_split] [@expl:spurious ensures #2] [%#sb5'10] self.final.shutdown = self.current.shutdown
    /\ self.final.ckpts = self.current.ckpts)}
    (! return {result}) ]

let relock (self: MutBorrow.t t_TSys) (return (x: ())) =
{[@stop_split] [@expl:relock requires] [%#sb5'11] match self.current.ph with
    | Woken _ -> true
    | _ -> false
    end}
  any
  [ return (result: ()) ->
  {[@stop_split] [@expl:relock ensures] ([@stop_split] [@expl:relock ensures #0] [%#sb5'12] self.final.interval
        = self.current.interval
      /\ self.final.now = self.current.now)
    /\ ([@stop_split] [@expl:relock ensures #1] [%#sb5'13] self.final.shutdown = self.current.shutdown
      /\ self.final.ckpts = self.current.ckpts)
    /\ ([@stop_split] [@expl:relock ensures #2] [%#sb5'14] self.final.ph
    = (if self.current.shutdown then
      Exited
    else
      match self.current.ph with
        | Woken t -> if t then Work else Top
        | p -> p
        end
    ))}
    (! return {result}) ]

type tup2_TSys_TSys = { f0: t_TSys; f1: t_TSys }

