  pending_frees: t_Vec_tup2_u64_usize_Global }

function rsize [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/component.rs" 398 0 398 48] (usable: int) (n: int) (i: int) : int
 = [%#scomponent] if i < n - 1 then ComputerDivision.div usable n else usable - (n - 1) * ComputerDivision.div usable n

function cap_sum [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/component.rs" 180 0 180 70] (arena: Seq.seq t_RegionState) (rv: Seq.seq UInt64.t) (n: int) : int

axiom cap_sum_def:
  forall arena: Seq.seq t_RegionState, rv: Seq.seq UInt64.t, n: int [cap_sum arena rv n]. cap_sum arena rv n
    = ([%#scomponent'1] if n <= 0 then
      0
    else
      cap_sum arena rv (n - 1)
      + UInt64.t'int (Seq.get arena (UInt64.t'int (Seq.get rv (n - 1)))).buddy.total_usable_size
    )

function lemma_cap_part [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/props/l3start.rs" 209 0 209 91] (arena: Seq.seq t_RegionState) (rv: Seq.seq UInt64.t) (n: int) (usable: int) (k: int) : ()

axiom lemma_cap_part_def:
  forall arena: Seq.seq t_RegionState, rv: Seq.seq UInt64.t, n: int, usable: int, k: int [lemma_cap_part arena rv n usable k]. ([%#sl3start'2] 0
        <= k
      /\ k <= Seq.length rv /\ Seq.length rv = n /\ n > 0 /\ usable >= 0)
    -> ([%#sl3start'3] forall i: int. 0 <= i /\ i < Seq.length rv
        -> UInt64.t'int (Seq.get arena (UInt64.t'int (Seq.get rv i))).buddy.total_usable_size = rsize usable n i)
    -> lemma_cap_part arena rv n usable k
    = ([%#sl3start'7] if k > 0 then lemma_cap_part arena rv n usable (k - 1) else ())

axiom lemma_cap_part_spec:
  forall arena: Seq.seq t_RegionState, rv: Seq.seq UInt64.t, n: int, usable: int, k: int. ([%#sl3start'2] 0 <= k
      /\ k <= Seq.length rv /\ Seq.length rv = n /\ n > 0 /\ usable >= 0)
    -> ([%#sl3start'3] forall i: int. 0 <= i /\ i < Seq.length rv
        -> UInt64.t'int (Seq.get arena (UInt64.t'int (Seq.get rv i))).buddy.total_usable_size = rsize usable n i)
    -> ([%#sl3start'4] k < n -> cap_sum arena rv k = k * ComputerDivision.div usable n)

axiom lemma_cap_part_spec'0:
  forall arena: Seq.seq t_RegionState, rv: Seq.seq UInt64.t, n: int, usable: int, k: int. ([%#sl3start'2] 0 <= k
      /\ k <= Seq.length rv /\ Seq.length rv = n /\ n > 0 /\ usable >= 0)
    -> ([%#sl3start'3] forall i: int. 0 <= i /\ i < Seq.length rv
        -> UInt64.t'int (Seq.get arena (UInt64.t'int (Seq.get rv i))).buddy.total_usable_size = rsize usable n i)
    -> ([%#sl3start'5] k = n -> cap_sum arena rv k = usable)

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

