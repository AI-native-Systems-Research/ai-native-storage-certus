goal vc_lemma_cap_full: ([%#sl3start] Seq.length rv = n /\ n > 0 /\ usable >= 0)
  -> ([%#sl3start'0] forall i: int. 0 <= i /\ i < Seq.length rv
      -> UInt64.t'int (Seq.get arena (UInt64.t'int (Seq.get rv i))).buddy.total_usable_size = rsize usable n i)
  -> ([@stop_split] [@expl:lemma_cap_part requires] ([@stop_split] [@expl:lemma_cap_part requires #0] [%#sl3start'2] 0
        <= Seq.length rv
      /\ Seq.length rv <= Seq.length rv /\ Seq.length rv = n /\ n > 0 /\ usable >= 0)
    /\ ([@stop_split] [@expl:lemma_cap_part requires #1] [%#sl3start'3] forall i: int. 0 <= i /\ i < Seq.length rv
      -> UInt64.t'int (Seq.get arena (UInt64.t'int (Seq.get rv i))).buddy.total_usable_size = rsize usable n i))
  /\ (([@stop_split] [@expl:lemma_cap_part ensures] ([@stop_split] [@expl:lemma_cap_part ensures #0] [%#sl3start'4] Seq.length rv
        < n -> cap_sum arena rv (Seq.length rv) = Seq.length rv * ComputerDivision.div usable n)
