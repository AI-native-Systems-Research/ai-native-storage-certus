use creusot.int.UInt64
use creusot.int.UInt32
use creusot.int.UInt8
use seq.Seq
use creusot.prelude.Any
use int.Int

type t_Superblock = {
  magic: UInt64.t;
  version: UInt32.t;
  data_disk_size: UInt64.t;
  sector_size: UInt32.t;
  slab_size: UInt64.t;
  max_extent_size: UInt32.t;
  region_count: UInt32.t;
  checkpoint_seq: UInt64.t;
  active_copy: UInt8.t;
  checkpoint_region_offset: UInt64.t;
  checkpoint_region_size: UInt64.t;
  instance_id: UInt64.t;
  metadata_disk_ns_id: UInt32.t;
  data_start_offset: UInt64.t }

type t_Vec_u8_Global

