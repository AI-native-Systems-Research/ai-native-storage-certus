      s5
    | s5 = any [ br0 -> {r'0 = None} (! bb5) | br1 (x0: UInt64.t) -> {r'0 = Some x0} (! bb6) ] ]
  | bb6 = s0
    [ s0 = elim_Some {r'0} (fun (r0: UInt64.t) -> [ &x <- r0 ] s1)
