    | s3 = -{resolve_refmut_BuddyAllocator b}- s4
    | s4 = bb8 ]
  | bb5 = s0 [ s0 = -{resolve_refmut_BuddyAllocator b}- s1 | s1 = bb8 ]
  | bb8 = s0 [ s0 = [ &_ret <- { f0 = r'0; f1 = mid } ] s1 | s1 = return {_ret} ] ]
  [ & _ret: tup2_Option_u64_Snapshot_Int = Any.any_l ()
  | & b: MutBorrow.t t_BuddyAllocator = b
  | & size: UInt64.t = size
  | & r: t_RegionState = r
  | & r'0: t_Option_u64 = Any.any_l ()
  | & _19: MutBorrow.t t_BuddyAllocator = Any.any_l ()
