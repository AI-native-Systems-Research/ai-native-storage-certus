      /\ UInt64.t'int result.f1.max_order = 1 /\ Seq.length (view_Vec_Vec_u64_Global_Global result.f1.free_lists) = 2)
    /\ ([@stop_split] [@expl:w1p_recovered ensures #3] [%#sbatch2'5] Seq.length (view_Vec_u64_Global (Seq.get (view_Vec_Vec_u64_Global_Global result.f1.free_lists) 1))
      = 0
    /\ view_Vec_u64_Global (Seq.get (view_Vec_Vec_u64_Global_Global result.f1.free_lists) 0)
    = Seq.singleton (0: UInt64.t))}
    (! return {result}) ]

