        - 1) (UInt32.t'int self.current.sector_size))) (first_ne (view_Vec_Vec_u64_Global_Global self.current.free_lists) (ord (ComputerDivision.div (UInt64.t'int size
          + UInt32.t'int self.current.sector_size
        - 1) (UInt32.t'int self.current.sector_size))) (UInt64.t'int self.current.max_order)) (UInt64.t'int r))
    /\ ([@stop_split] [@expl:alloc ensures #9] [%#sbuddy'10] forall r: UInt64.t. result = Some r
