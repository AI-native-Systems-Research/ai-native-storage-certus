      /\ self.final.total_usable_size = self.current.total_usable_size)
    /\ ([@stop_split] [@expl:alloc ensures #5] [%#sbuddy'6] self.final.sector_size = self.current.sector_size
      /\ self.final.max_order = self.current.max_order)
    /\ ([@stop_split] [@expl:alloc ensures #6] [%#sbuddy'7] Seq.length (view_Vec_Vec_u64_Global_Global self.final.free_lists)
