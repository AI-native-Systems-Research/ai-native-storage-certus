  <= UInt64.t'int const_MAX'0)}
  any
  [ return (result: t_Option_u64) ->
  {[@stop_split] [@expl:alloc ensures] ([@stop_split] [@expl:alloc ensures #0] [%#sbuddy'1] bd_shape self.final)
    /\ ([@stop_split] [@expl:alloc ensures #1] [%#sbuddy'2] bd_aligned self.final)
    /\ ([@stop_split] [@expl:alloc ensures #2] [%#sbuddy'3] bd_inside self.final)
    /\ ([@stop_split] [@expl:alloc ensures #3] [%#sbuddy'4] bd_inv self.final)
