use int.ComputerDivision
use int.Int

function ckoff_l [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/component.rs" 652 0 652 29] (a: int) : int
 = [%#scomponent] if a = 0 then 4096 else ComputerDivision.div (4096 + a - 1) a * a

function lemma_divmod [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/buddy.rs" 184 0 184 35] (x: int) (m: int) : ()

axiom lemma_divmod_spec: forall x: int, m: int. ([%#sbuddy] m > 0 /\ x >= 0)
    -> ([%#sbuddy'0] x = m * ComputerDivision.div x m + ComputerDivision.mod x m)

axiom lemma_divmod_spec'0: forall x: int, m: int. ([%#sbuddy] m > 0 /\ x >= 0)
    -> ([%#sbuddy'1] 0 <= ComputerDivision.mod x m /\ ComputerDivision.mod x m < m)

axiom lemma_divmod_spec'1: forall x: int, m: int. ([%#sbuddy] m > 0 /\ x >= 0)
    -> ([%#sbuddy'2] ComputerDivision.div x m >= 0)

function lemma_mul_le [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/buddy.rs" 156 0 156 43] (a: int) (b: int) (c: int) : ()

axiom lemma_mul_le_spec: forall a: int, b: int, c: int. ([%#sbuddy'3] 0 <= a /\ a <= b /\ 0 <= c)
    -> ([%#sbuddy'4] a * c <= b * c)

function lemma_distrib [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/buddy.rs" 164 0 164 44] (a: int) (b: int) (c: int) : ()

axiom lemma_distrib_spec: forall a: int, b: int, c: int. [%#sbuddy'5] (a + b) * c = a * c + b * c

function lemma_div_le7 [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/props/batch7.rs" 225 0 225 44] (k: int) (q: int) (a: int) : ()
 = [%#sbatch7'3] if q > k then let _ = lemma_mul_le (k + 1) q a in lemma_distrib k 1 a else ()

axiom lemma_div_le7_spec: forall k: int, q: int, a: int. ([%#sbatch7'1] a > 0
      /\ k >= 0 /\ q >= 0 /\ q * a <= 4095 + a /\ k * a >= 4096) -> ([%#sbatch7'2] q * a <= k * a)

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant a : int

constant m : int

function lemma_mult_ge7 [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/props/batch7.rs" 214 0 214 37] (a: int) (m: int) : ()

goal vc_lemma_mult_ge7: ([%#sbatch7] a > 0 /\ m >= 4096 /\ ComputerDivision.mod m a = 0)
  -> ([@stop_split] [@expl:lemma_divmod requires] [%#sbuddy] a > 0 /\ m >= 0)
  /\ (([@stop_split] [@expl:lemma_divmod ensures] ([@stop_split] [@expl:lemma_divmod ensures #0] [%#sbuddy'0] m
      = a * ComputerDivision.div m a + ComputerDivision.mod m a)
    /\ ([@stop_split] [@expl:lemma_divmod ensures #1] [%#sbuddy'1] 0 <= ComputerDivision.mod m a
      /\ ComputerDivision.mod m a < a)
    /\ ([@stop_split] [@expl:lemma_divmod ensures #2] [%#sbuddy'2] ComputerDivision.div m a >= 0))
  -> (let _ = lemma_divmod m a in ([@stop_split] [@expl:lemma_divmod requires] [%#sbuddy] a > 0 /\ 4096 + a - 1 >= 0)
  /\ (([@stop_split] [@expl:lemma_divmod ensures] ([@stop_split] [@expl:lemma_divmod ensures #0] [%#sbuddy'0] 4096 + a
        - 1
      = a * ComputerDivision.div (4096 + a - 1) a + ComputerDivision.mod (4096 + a - 1) a)
    /\ ([@stop_split] [@expl:lemma_divmod ensures #1] [%#sbuddy'1] 0 <= ComputerDivision.mod (4096 + a - 1) a
      /\ ComputerDivision.mod (4096 + a - 1) a < a)
    /\ ([@stop_split] [@expl:lemma_divmod ensures #2] [%#sbuddy'2] ComputerDivision.div (4096 + a - 1) a >= 0))
  -> (let _ = lemma_divmod (4096 + a - 1) a in ([@stop_split] [@expl:lemma_div_le7 requires] [%#sbatch7'1] a > 0
    /\ ComputerDivision.div m a >= 0
    /\ ComputerDivision.div (4096 + a - 1) a >= 0
    /\ ComputerDivision.div (4096 + a - 1) a * a <= 4095 + a /\ ComputerDivision.div m a * a >= 4096)
  /\ (([@stop_split] [@expl:lemma_div_le7 ensures] [%#sbatch7'2] ComputerDivision.div (4096 + a - 1) a * a
    <= ComputerDivision.div m a * a) -> ([@stop_split] [@expl:lemma_mult_ge7 ensures] [%#sbatch7'0] ckoff_l a <= m))))))
