  [%#ssbbytes'2] forall k: int. 0 <= k /\ k < 4 -> Seq.get s (pos + k) = le32 v k

function crc32 [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/sbbytes.rs" 29 0 29 31] (s: Seq.seq UInt8.t) : UInt32.t

predicate sb_layout [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/sbbytes.rs" 126 0 126 52] (s: Seq.seq UInt8.t) (sb: t_Superblock) =
  [%#ssbbytes'0] Seq.length s = 4096
  /\ has64 s 0 sb.magic
  /\ has32 s 8 sb.version
  /\ has64 s 12 sb.data_disk_size
  /\ has32 s 20 sb.sector_size
  /\ has64 s 24 sb.slab_size
  /\ has32 s 32 sb.max_extent_size
  /\ has32 s 36 sb.region_count
  /\ has64 s 40 sb.checkpoint_seq
  /\ Seq.get s 48 = sb.active_copy
  /\ (forall q: int. 49 <= q /\ q < 56 -> Seq.get s q = (0: UInt8.t))
  /\ has64 s 56 sb.checkpoint_region_offset
  /\ has64 s 64 sb.checkpoint_region_size
  /\ has64 s 72 sb.instance_id
  /\ has32 s 80 sb.metadata_disk_ns_id
  /\ has64 s 84 sb.data_start_offset
