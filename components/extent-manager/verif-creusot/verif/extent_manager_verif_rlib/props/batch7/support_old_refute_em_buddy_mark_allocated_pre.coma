  /\ s.slab_size'1 = d64 d (q + 8)
  /\ s.element_size'1 = d32 d (q + 16)
  /\ Seq.length (view_Vec_u64_Global s.keys'1) = UInt32.t'int (d32 d (q + 20))
  /\ q + 24 + 8 * Seq.length (view_Vec_u64_Global s.keys'1) <= Seq.length d
  /\ (forall t: int. 0 <= t /\ t < Seq.length (view_Vec_u64_Global s.keys'1)
