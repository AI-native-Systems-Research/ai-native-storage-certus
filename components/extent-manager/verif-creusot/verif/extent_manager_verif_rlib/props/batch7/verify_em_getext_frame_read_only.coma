  forall self: t_Vec_Extent_Global [view_Vec_Extent_Global self]. [%#svec] Seq.length (view_Vec_Extent_Global self)
    <= UInt64.t'int const_MAX

constant const_FREE_KEY: UInt64.t = [%#sslab] (18446744073709551615: UInt64.t)

function slot_off [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/slab.rs" 84 0 84 39] (s: t_Slab) (i: int) : int
 = [%#sslab'4] UInt64.t'int s.start_offset'1 + i * UInt32.t'int s.element_size'1

predicate from_slot [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/listing.rs" 40 0 40 67] (r: t_RegionState) (k: int) (j: int) (e: t_Extent) =
  [%#slisting'7] contains_Int (view_SlabMap r.slabs'0) k
  /\ 0 <= j
  /\ j < UInt32.t'int (lookup_Int (view_SlabMap r.slabs'0) k).bitmap'1.num_slots
  /\ Seq.get (view_Vec_u64_Global (lookup_Int (view_SlabMap r.slabs'0) k).keys'1) j = e.key
  /\ e.key <> const_FREE_KEY
  /\ UInt64.t'int e.offset = slot_off (lookup_Int (view_SlabMap r.slabs'0) k) j
  /\ e.size = (lookup_Int (view_SlabMap r.slabs'0) k).element_size'1

predicate from_region [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/listing.rs" 53 0 53 53] (r: t_RegionState) (e: t_Extent) =
  [%#slisting'5] exists k: int, j: int. from_slot r k j e

predicate listed_ok [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/listing.rs" 159 0 159 75] (em: t_ExtentManager) (rv: Seq.seq UInt64.t) (s: Seq.seq t_Extent) =
  [%#slisting'3] forall p: int. 0 <= p /\ p < Seq.length s
    -> (Seq.get s p).key <> const_FREE_KEY
    /\ (exists i: int. 0 <= i
      /\ i < Seq.length rv
      /\ from_region (Seq.get (view_Vec_RegionState_Global em.arena) (UInt64.t'int (Seq.get rv i))) (Seq.get s p))

predicate in_from [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/listing.rs" 65 0 65 58] (s: Seq.seq t_Extent) (lo: int) (e: t_Extent) =
  [%#slisting'8] exists p: int. lo <= p /\ p < Seq.length s /\ Seq.get s p = e

predicate all_listed [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/listing.rs" 71 0 71 66] (s: Seq.seq t_Extent) (lo: int) (r: t_RegionState) =
  [%#slisting'6] forall k: int, j: int, e: t_Extent. from_slot r k j e -> in_from s lo e

predicate all_regions_listed [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/listing.rs" 83 0 83 101] (em: t_ExtentManager) (rv: Seq.seq UInt64.t) (s: Seq.seq t_Extent) (lo: int) (n: int) =
  [%#slisting'4] forall i: int. 0 <= i /\ i < n
    -> all_listed s lo (Seq.get (view_Vec_RegionState_Global em.arena) (UInt64.t'int (Seq.get rv i)))

let get_extents (self: t_ExtentManager) (return (x: t_Vec_Extent_Global)) =
{[@stop_split] [@expl:get_extents requires] ([@stop_split] [@expl:get_extents 'self' type invariant] [%#slisting] inv_ref_ExtentManager self)
  /\ ([@stop_split] [@expl:get_extents requires] [%#slisting'0] em_regions_wf self /\ em_list_ok self)}
  any
  [ return (result: t_Vec_Extent_Global) ->
  {[@stop_split] [@expl:get_extents ensures] ([@stop_split] [@expl:get_extents ensures #0] [%#slisting'1] match self.regions with
        | None -> Seq.length (view_Vec_Extent_Global result) = 0
        | Some rv -> listed_ok self (view_Vec_usize_Global rv) (view_Vec_Extent_Global result)
        end)
    /\ ([@stop_split] [@expl:get_extents ensures #1] [%#slisting'2] match self.regions with
      | None -> true
      | Some rv -> all_regions_listed self (view_Vec_usize_Global rv) (view_Vec_Extent_Global result) 0 (Seq.length (view_Vec_usize_Global rv))
      end)}
    (! return {result}) ]

