let verify_em_getext_frame_read_only [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/props/batch7.rs" 302 0 302 78]
  (em: MutBorrow.t t_ExtentManager) (return (x: t_Vec_Extent_Global)) =
{[@stop_split] [@expl:verify_em_getext_frame_read_only requires] ([@stop_split] [@expl:verify_em_getext_frame_read_only 'em' type invariant] [%#sbatch7'0] inv_refmut_ExtentManager em)
  /\ ([@stop_split] [@expl:verify_em_getext_frame_read_only requires] [%#sbatch7'1] em_regions_wf em.current
  /\ em_list_ok em.current)}
  (! bb0
  [ bb0 = s0
    [ s0 = s1 [ _ck -> (! {[@expl:type invariant] inv_refmut_ExtentManager em} any) ]
    | s1 = -{resolve_refmut_ExtentManager em}- s2
    | s2 = get_extents [%#sbatch7] {em.current} (fun (_x: t_Vec_Extent_Global) -> [ &_ret <- _x ] s3)
    | s3 = return {_ret} ] ] [ & _ret: t_Vec_Extent_Global = Any.any_l () | & em: MutBorrow.t t_ExtentManager = em ])
  [ return (result: t_Vec_Extent_Global) ->
  {[@stop_split] [@expl:verify_em_getext_frame_read_only ensures] [%#sbatch7'2] em.final = em.current}
    (! return {result}) ]
