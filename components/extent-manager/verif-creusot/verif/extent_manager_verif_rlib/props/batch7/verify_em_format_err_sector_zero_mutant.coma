    | s3 = -{resolve_refmut_ExtentManager em}- s4
    | s4 = return {_ret} ] ]
  [ & _ret: t_Result_unit_EmError = Any.any_l ()
  | & em: MutBorrow.t t_ExtentManager = em
  | & params: t_FormatParams = params
  | & qn: t_Option_u64 = qn
