    -> ([%#sbuddy'0] Pow2int.pow2 (ord b) >= b)

axiom lemma_ord_ge_spec'0: forall b: int. ([%#sbuddy] 0 <= b /\ b <= 18446744073709551616)
    -> ([%#sbuddy'1] 0 <= ord b /\ ord b <= 64)

function lemma_span_mono [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/buddy.rs" 104 0 104 47] (ss: int) (a: int) (b: int) : ()

axiom lemma_span_mono_spec: forall ss: int, a: int, b: int. ([%#sbuddy'6] 0 <= a /\ a <= b /\ 0 <= ss)
    -> ([%#sbuddy'7] span ss a <= span ss b)

function lemma_divmod [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/buddy.rs" 184 0 184 35] (x: int) (m: int) : ()

axiom lemma_divmod_spec: forall x: int, m: int. ([%#sbuddy'8] m > 0 /\ x >= 0)
    -> ([%#sbuddy'9] x = m * ComputerDivision.div x m + ComputerDivision.mod x m)

axiom lemma_divmod_spec'0: forall x: int, m: int. ([%#sbuddy'8] m > 0 /\ x >= 0)
    -> ([%#sbuddy'10] 0 <= ComputerDivision.mod x m /\ ComputerDivision.mod x m < m)

axiom lemma_divmod_spec'1: forall x: int, m: int. ([%#sbuddy'8] m > 0 /\ x >= 0)
    -> ([%#sbuddy'11] ComputerDivision.div x m >= 0)

function lemma_span_pos [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/buddy.rs" 114 0 114 38] (ss: int) (o: int) : ()

axiom lemma_span_pos_spec: forall ss: int, o: int. ([%#sbuddy'12] ss > 0 /\ 0 <= o) -> ([%#sbuddy'13] span ss o >= ss)

axiom lemma_span_pos_spec'0: forall ss: int, o: int. ([%#sbuddy'12] ss > 0 /\ 0 <= o) -> ([%#sbuddy'14] span ss o > 0)

function lemma_pow2 [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/buddy.rs" 49 0 49 25] (o: int) : ()

axiom lemma_pow2_spec: forall o: int. ([%#sbuddy'16] 0 <= o) -> ([%#sbuddy'17] Pow2int.pow2 o >= 1)

axiom lemma_pow2_spec'0: forall o: int. ([%#sbuddy'16] 0 <= o)
    -> ([%#sbuddy'18] Pow2int.pow2 (o + 1) = 2 * Pow2int.pow2 o)

