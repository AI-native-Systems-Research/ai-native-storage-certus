axiom lemma_mul_le_spec: forall a: int, b: int, c: int. ([%#sbuddy'21] 0 <= a /\ a <= b /\ 0 <= c)
    -> ([%#sbuddy'22] a * c <= b * c)

function lemma_distrib [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/buddy.rs" 164 0 164 44] (a: int) (b: int) (c: int) : ()

axiom lemma_distrib_spec: forall a: int, b: int, c: int. [%#sbuddy'23] (a + b) * c = a * c + b * c

function lemma_tot_lt [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/props/l2m.rs" 141 0 141 49] (ss: int) (total: int) (mo: int) : ()
 = [%#sl2m'12] let _ = lemma_divmod total ss in let _ = lemma_mul_le (ComputerDivision.div total ss
  + 1) (Pow2int.pow2 (mo + 1)) ss in lemma_distrib (ComputerDivision.div total ss) 1 ss

axiom lemma_tot_lt_spec: forall ss: int, total: int, mo: int. ([%#sl2m'10] ss > 0
      /\ total >= 0 /\ mo >= 0 /\ ComputerDivision.div total ss < Pow2int.pow2 (mo + 1))
    -> ([%#sl2m'11] total < span ss (mo + 1))

function lemma_no_big [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/props/l2m.rs" 338 0 338 55] (b: t_BuddyAllocator) (kk: int) (x: int) : ()
 = [%#sl2m'5] let _ = lemma_span_mono (UInt32.t'int b.sector_size) (UInt64.t'int b.max_order
  + 1) kk in let _ = lemma_divmod (UInt64.t'int b.total_usable_size) (UInt32.t'int b.sector_size) in let _ = lemma_span_pos (UInt32.t'int b.sector_size) (UInt64.t'int b.max_order
  + 1) in let _ = lemma_span_mono (UInt32.t'int b.sector_size) 0 (UInt64.t'int b.max_order
  + 1) in let _ = lemma_pow2 0 in if ComputerDivision.div (UInt64.t'int b.total_usable_size) (UInt32.t'int b.sector_size)
  >= 1 then
    lemma_tot_lt (UInt32.t'int b.sector_size) (UInt64.t'int b.total_usable_size) (UInt64.t'int b.max_order)
  else
    ()


axiom lemma_no_big_spec: forall b: t_BuddyAllocator, kk: int, x: int. ([%#sl2m'2] bgeo b
      /\ kk > UInt64.t'int b.max_order
      /\ x >= 0 /\ x + span (UInt32.t'int b.sector_size) kk <= UInt64.t'int b.total_usable_size) -> ([%#sl2m'3] false)

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant a : t_BuddyAllocator

constant la : Seq.seq tup2_u64_u64

constant x0 : int

constant x1 : int

predicate lemma_desc_ord_b [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/props/l2m.rs" 417 0 417 89] (a: t_BuddyAllocator) (la: Seq.seq tup2_u64_u64) (x0: int) (x1: int)

goal vc_lemma_desc_ord_b: ([%#sl2m] bh a la
    /\ x0 >= UInt64.t'int a.base_offset /\ 0 <= x1 /\ x1 <= UInt64.t'int const_MAX'0)
  -> ([%#sl2m'0] x0 - UInt64.t'int a.base_offset
      + span (UInt32.t'int a.sector_size) (ord (ComputerDivision.div x1 (UInt32.t'int a.sector_size)))
    <= UInt64.t'int a.total_usable_size)
  -> ([@stop_split] [@expl:lemma_ord_ge requires] [%#sbuddy] 0 <= ComputerDivision.div x1 (UInt32.t'int a.sector_size)
    /\ ComputerDivision.div x1 (UInt32.t'int a.sector_size) <= 18446744073709551616)
  /\ (([@stop_split] [@expl:lemma_ord_ge ensures] ([@stop_split] [@expl:lemma_ord_ge ensures #0] [%#sbuddy'0] Pow2int.pow2 (ord (ComputerDivision.div x1 (UInt32.t'int a.sector_size)))
      >= ComputerDivision.div x1 (UInt32.t'int a.sector_size))
    /\ ([@stop_split] [@expl:lemma_ord_ge ensures #1] [%#sbuddy'1] 0
      <= ord (ComputerDivision.div x1 (UInt32.t'int a.sector_size))
    /\ ord (ComputerDivision.div x1 (UInt32.t'int a.sector_size)) <= 64))
  -> (let _ = lemma_ord_ge (ComputerDivision.div x1 (UInt32.t'int a.sector_size)) in if ord (ComputerDivision.div x1 (UInt32.t'int a.sector_size))
  > UInt64.t'int a.max_order then
    ([@stop_split] [@expl:lemma_no_big requires] [%#sl2m'2] bgeo a
      /\ ord (ComputerDivision.div x1 (UInt32.t'int a.sector_size)) > UInt64.t'int a.max_order
      /\ x0 - UInt64.t'int a.base_offset >= 0
      /\ x0 - UInt64.t'int a.base_offset
        + span (UInt32.t'int a.sector_size) (ord (ComputerDivision.div x1 (UInt32.t'int a.sector_size)))
      <= UInt64.t'int a.total_usable_size)
    /\ (([@stop_split] [@expl:lemma_no_big ensures] [%#sl2m'3] false)
    -> (let _ = lemma_no_big a (ord (ComputerDivision.div x1 (UInt32.t'int a.sector_size))) (x0
    - UInt64.t'int a.base_offset) in [@stop_split] [@expl:lemma_desc_ord_b ensures] [%#sl2m'1] true
    /\ ord (ComputerDivision.div x1 (UInt32.t'int a.sector_size)) <= UInt64.t'int a.max_order))
  else
    [@stop_split] [@expl:lemma_desc_ord_b ensures] [%#sl2m'1] true
    /\ ord (ComputerDivision.div x1 (UInt32.t'int a.sector_size)) <= UInt64.t'int a.max_order
  ))
