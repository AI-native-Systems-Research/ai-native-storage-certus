goal vc_lemma_cov_total_b: ([%#sl2m] cov fl ss (ComputerDivision.div total ss * ss) /\ ss > 0 /\ total >= 0)
  -> ([%#sl2m'0] 0 <= kk /\ 0 <= t /\ ComputerDivision.mod t (span ss kk) = 0 /\ t + span ss kk <= total)
  -> ([@stop_split] [@expl:lemma_cov_total requires] ([@stop_split] [@expl:lemma_cov_total requires #0] [%#sl2] cov fl ss (ComputerDivision.div total ss
        * ss)
      /\ ss > 0 /\ total >= 0)
    /\ ([@stop_split] [@expl:lemma_cov_total requires #1] [%#sl2'0] 0 <= kk
    /\ 0 <= t /\ ComputerDivision.mod t (span ss kk) = 0 /\ t + span ss kk <= total))
  /\ (([@stop_split] [@expl:lemma_cov_total ensures] [%#sl2'1] inblk fl ss kk t)
  -> (let _ = lemma_cov_total fl ss total kk t in [@stop_split] [@expl:lemma_cov_total_b ensures] [%#sl2m'1] true
  /\ inblk fl ss kk t))
