use int.ComputerDivision
use bv.Pow2int
use int.Int

function span [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/buddy.rs" 32 0 32 35] (ss: int) (o: int) : int
 = [%#sbuddy'11] Pow2int.pow2 o * ss

function lemma_span_pos [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/buddy.rs" 114 0 114 38] (ss: int) (o: int) : ()

axiom lemma_span_pos_spec: forall ss: int, o: int. ([%#sbuddy] ss > 0 /\ 0 <= o) -> ([%#sbuddy'0] span ss o >= ss)

axiom lemma_span_pos_spec'0: forall ss: int, o: int. ([%#sbuddy] ss > 0 /\ 0 <= o) -> ([%#sbuddy'1] span ss o > 0)

function lemma_pow2 [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/buddy.rs" 49 0 49 25] (o: int) : ()

axiom lemma_pow2_spec: forall o: int. ([%#sbuddy'2] 0 <= o) -> ([%#sbuddy'3] Pow2int.pow2 o >= 1)

axiom lemma_pow2_spec'0: forall o: int. ([%#sbuddy'2] 0 <= o)
    -> ([%#sbuddy'4] Pow2int.pow2 (o + 1) = 2 * Pow2int.pow2 o)

function lemma_span_mult [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/l2.rs" 218 0 218 47] (ss: int) (a: int) (b: int) : ()

axiom lemma_span_mult_spec: forall ss: int, a: int, b: int. ([%#sl2] ss > 0 /\ 0 <= a /\ a <= b)
    -> ([%#sl2'0] ComputerDivision.mod (span ss b) (span ss a) = 0)

function lemma_span_div [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/buddy.rs" 201 0 201 54] (x: int) (ss: int) (a: int) (b: int) : ()

axiom lemma_span_div_spec: forall x: int, ss: int, a: int, b: int. ([%#sbuddy'5] ss > 0 /\ 0 <= a /\ a <= b /\ x >= 0)
    -> ([%#sbuddy'6] ComputerDivision.mod x (span ss b) = 0) -> ([%#sbuddy'7] ComputerDivision.mod x (span ss a) = 0)

function lemma_mod_add [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/buddy.rs" 214 0 214 44] (x: int) (y: int) (m: int) : ()

axiom lemma_mod_add_spec: forall x: int, y: int, m: int. ([%#sbuddy'8] m > 0
      /\ x >= 0 /\ y >= 0 /\ ComputerDivision.mod x m = 0 /\ ComputerDivision.mod y m = 0)
    -> ([%#sbuddy'9] ComputerDivision.mod (x + y) m = 0)

axiom lemma_mod_add_spec'0: forall x: int, y: int, m: int. ([%#sbuddy'8] m > 0
      /\ x >= 0 /\ y >= 0 /\ ComputerDivision.mod x m = 0 /\ ComputerDivision.mod y m = 0)
    -> ([%#sbuddy'10] x >= y -> ComputerDivision.mod (x - y) m = 0)

function lemma_floor_le [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/l2.rs" 458 0 458 45] (m: int) (d: int) (n: int) : ()

axiom lemma_floor_le_spec: forall m: int, d: int, n: int. ([%#sl2'1] d > 0
      /\ m >= 0 /\ n >= 0 /\ ComputerDivision.mod m d = 0 /\ m <= n) -> ([%#sl2'2] m <= ComputerDivision.div n d * d)

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant ss : int

constant total : int

constant kk : int

constant t : int

function lemma_fit_usable [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/props/l2m.rs" 151 0 151 61] (ss: int) (total: int) (kk: int) (t: int) : ()

goal vc_lemma_fit_usable: ([%#sl2m] ss > 0
    /\ 0 <= kk /\ t >= 0 /\ ComputerDivision.mod t (span ss kk) = 0 /\ t + span ss kk <= total)
  -> ([@stop_split] [@expl:lemma_span_pos requires] [%#sbuddy] ss > 0 /\ 0 <= kk)
  /\ (([@stop_split] [@expl:lemma_span_pos ensures] ([@stop_split] [@expl:lemma_span_pos ensures #0] [%#sbuddy'0] span ss kk
      >= ss)
    /\ ([@stop_split] [@expl:lemma_span_pos ensures #1] [%#sbuddy'1] span ss kk > 0))
  -> (let _ = lemma_span_pos ss kk in ([@stop_split] [@expl:lemma_pow2 requires] [%#sbuddy'2] 0 <= 0)
  /\ (([@stop_split] [@expl:lemma_pow2 ensures] ([@stop_split] [@expl:lemma_pow2 ensures #0] [%#sbuddy'3] Pow2int.pow2 0
      >= 1)
    /\ ([@stop_split] [@expl:lemma_pow2 ensures #1] [%#sbuddy'4] Pow2int.pow2 (0 + 1) = 2 * Pow2int.pow2 0))
  -> (let _ = lemma_pow2 0 in span ss 0 = ss
  && ([@stop_split] [@expl:lemma_span_mult requires] [%#sl2] ss > 0 /\ 0 <= 0 /\ 0 <= kk)
  /\ (([@stop_split] [@expl:lemma_span_mult ensures] [%#sl2'0] ComputerDivision.mod (span ss kk) (span ss 0) = 0)
  -> (let _ = lemma_span_mult ss 0 kk in ([@stop_split] [@expl:lemma_span_div requires] ([@stop_split] [@expl:lemma_span_div requires #0] [%#sbuddy'5] ss
        > 0
      /\ 0 <= 0 /\ 0 <= kk /\ t >= 0)
    /\ ([@stop_split] [@expl:lemma_span_div requires #1] [%#sbuddy'6] ComputerDivision.mod t (span ss kk) = 0))
  /\ (([@stop_split] [@expl:lemma_span_div ensures] [%#sbuddy'7] ComputerDivision.mod t (span ss 0) = 0)
  -> (let _ = lemma_span_div t ss 0 kk in ([@stop_split] [@expl:lemma_mod_add requires] [%#sbuddy'8] ss > 0
    /\ t >= 0 /\ span ss kk >= 0 /\ ComputerDivision.mod t ss = 0 /\ ComputerDivision.mod (span ss kk) ss = 0)
  /\ (([@stop_split] [@expl:lemma_mod_add ensures] ([@stop_split] [@expl:lemma_mod_add ensures #0] [%#sbuddy'9] ComputerDivision.mod (t
        + span ss kk) ss
      = 0)
    /\ ([@stop_split] [@expl:lemma_mod_add ensures #1] [%#sbuddy'10] t >= span ss kk
    -> ComputerDivision.mod (t - span ss kk) ss = 0))
  -> (let _ = lemma_mod_add t (span ss kk) ss in ([@stop_split] [@expl:lemma_floor_le requires] [%#sl2'1] ss > 0
    /\ t + span ss kk >= 0 /\ total >= 0 /\ ComputerDivision.mod (t + span ss kk) ss = 0 /\ t + span ss kk <= total)
  /\ (([@stop_split] [@expl:lemma_floor_le ensures] [%#sl2'2] t + span ss kk <= ComputerDivision.div total ss * ss)
  -> ([@stop_split] [@expl:lemma_fit_usable ensures] [%#sl2m'0] t + span ss kk
  <= ComputerDivision.div total ss * ss))))))))))))
