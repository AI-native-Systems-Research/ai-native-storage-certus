use bv.Pow2int
use int.ComputerDivision
use int.Int

function ord_from [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/buddy.rs" 284 0 284 38] (b: int) (k: int) : int

axiom ord_from_def: forall b: int, k: int [ord_from b k]. ord_from b k
    = ([%#sbuddy'14] if k >= 64 \/ k < 0 \/ Pow2int.pow2 k >= b then k else ord_from b (k + 1))

function ord [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/buddy.rs" 290 0 290 25] (b: int) : int
 = [%#sbuddy'8] ord_from b 0

function span [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/buddy.rs" 32 0 32 35] (ss: int) (o: int) : int
 = [%#sbuddy'9] Pow2int.pow2 o * ss

function lemma_pow2 [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/buddy.rs" 49 0 49 25] (o: int) : ()

axiom lemma_pow2_spec: forall o: int. ([%#sbuddy] 0 <= o) -> ([%#sbuddy'0] Pow2int.pow2 o >= 1)

axiom lemma_pow2_spec'0: forall o: int. ([%#sbuddy] 0 <= o) -> ([%#sbuddy'1] Pow2int.pow2 (o + 1) = 2 * Pow2int.pow2 o)

function lemma_mul_mod0 [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/buddy.rs" 170 0 170 37] (m: int) (k: int) : ()

axiom lemma_mul_mod0_spec: forall m: int, k: int. ([%#sbuddy'2] m > 0 /\ k >= 0)
    -> ([%#sbuddy'3] ComputerDivision.mod (m * k) m = 0)

axiom lemma_mul_mod0_spec'0: forall m: int, k: int. ([%#sbuddy'2] m > 0 /\ k >= 0)
    -> ([%#sbuddy'4] ComputerDivision.div (m * k) m = k)

predicate is_order [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/buddy.rs" 38 0 38 39] (r: int) (b: int) =
  [%#sbuddy'11] 0 <= r /\ r <= 64 /\ Pow2int.pow2 r >= b /\ (r = 0 \/ Pow2int.pow2 (r - 1) < b)

function lemma_ord_eq [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/buddy.rs" 299 0 299 43] (b: int) (k: int) (r: int) : ()

axiom lemma_ord_eq_spec: forall b: int, k: int, r: int. ([%#sbuddy'5] 0 <= k /\ k <= r /\ is_order r b)
    -> ([%#sbuddy'6] k = 0 \/ Pow2int.pow2 (k - 1) < b) -> ([%#sbuddy'7] ord_from b k = r)

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant ss : int

constant k : int

function lemma_ord_span [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/props/l2m.rs" 126 0 126 38] (ss: int) (k: int) : ()

goal vc_lemma_ord_span: ([%#sl2m] ss > 0 /\ 0 <= k /\ k < 64)
  -> ([@stop_split] [@expl:lemma_pow2 requires] [%#sbuddy] 0 <= k)
  /\ (([@stop_split] [@expl:lemma_pow2 ensures] ([@stop_split] [@expl:lemma_pow2 ensures #0] [%#sbuddy'0] Pow2int.pow2 k
      >= 1)
    /\ ([@stop_split] [@expl:lemma_pow2 ensures #1] [%#sbuddy'1] Pow2int.pow2 (k + 1) = 2 * Pow2int.pow2 k))
  -> (let _ = lemma_pow2 k in ([@stop_split] [@expl:lemma_mul_mod0 requires] [%#sbuddy'2] ss > 0 /\ Pow2int.pow2 k >= 0)
  /\ (([@stop_split] [@expl:lemma_mul_mod0 ensures] ([@stop_split] [@expl:lemma_mul_mod0 ensures #0] [%#sbuddy'3] ComputerDivision.mod (ss
        * Pow2int.pow2 k) ss
      = 0)
    /\ ([@stop_split] [@expl:lemma_mul_mod0 ensures #1] [%#sbuddy'4] ComputerDivision.div (ss * Pow2int.pow2 k) ss
    = Pow2int.pow2 k))
  -> (let _ = lemma_mul_mod0 ss (Pow2int.pow2 k) in ComputerDivision.div (span ss k) ss = Pow2int.pow2 k
  && (if k > 0 then
    ([@stop_split] [@expl:lemma_pow2 requires] [%#sbuddy] 0 <= k - 1)
    /\ (([@stop_split] [@expl:lemma_pow2 ensures] ([@stop_split] [@expl:lemma_pow2 ensures #0] [%#sbuddy'0] Pow2int.pow2 (k
          - 1)
        >= 1)
      /\ ([@stop_split] [@expl:lemma_pow2 ensures #1] [%#sbuddy'1] Pow2int.pow2 (k - 1 + 1) = 2 * Pow2int.pow2 (k - 1)))
    -> (let _ = lemma_pow2 (k - 1) in is_order k (Pow2int.pow2 k)
    && ([@stop_split] [@expl:lemma_ord_eq requires] ([@stop_split] [@expl:lemma_ord_eq requires #0] [%#sbuddy'5] 0 <= 0
        /\ 0 <= k /\ is_order k (Pow2int.pow2 k))
      /\ ([@stop_split] [@expl:lemma_ord_eq requires #1] [%#sbuddy'6] 0 = 0 \/ Pow2int.pow2 (0 - 1) < Pow2int.pow2 k))
    /\ (([@stop_split] [@expl:lemma_ord_eq ensures] [%#sbuddy'7] ord_from (Pow2int.pow2 k) 0 = k)
    -> ([@stop_split] [@expl:lemma_ord_span ensures] [%#sl2m'0] ord (ComputerDivision.div (span ss k) ss) = k))))
  else
    is_order k (Pow2int.pow2 k)
    && ([@stop_split] [@expl:lemma_ord_eq requires] ([@stop_split] [@expl:lemma_ord_eq requires #0] [%#sbuddy'5] 0 <= 0
        /\ 0 <= k /\ is_order k (Pow2int.pow2 k))
      /\ ([@stop_split] [@expl:lemma_ord_eq requires #1] [%#sbuddy'6] 0 = 0 \/ Pow2int.pow2 (0 - 1) < Pow2int.pow2 k))
    /\ (([@stop_split] [@expl:lemma_ord_eq ensures] [%#sbuddy'7] ord_from (Pow2int.pow2 k) 0 = k)
    -> ([@stop_split] [@expl:lemma_ord_span ensures] [%#sl2m'0] ord (ComputerDivision.div (span ss k) ss) = k))
  )))))
