axiom view_Vec_Vec_u64_Global_Global_spec:
  forall self: t_Vec_Vec_u64_Global_Global [view_Vec_Vec_u64_Global_Global self]. [%#svec] Seq.length (view_Vec_Vec_u64_Global_Global self)
    <= UInt64.t'int const_MAX

constant const_MAX'0: UInt64.t = (18446744073709551615: UInt64.t)

function span [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/buddy.rs" 32 0 32 35] (ss: int) (o: int) : int
