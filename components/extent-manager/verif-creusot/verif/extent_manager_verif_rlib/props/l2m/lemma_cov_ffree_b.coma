predicate lemma_cov_ffree_b [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/props/l2m.rs" 177 0 177 80] (fl: Seq.seq t_Vec_u64_Global) (ss: int) (total: int) (z: int)

goal vc_lemma_cov_ffree_b: ([%#sl2m] cov fl ss (ComputerDivision.div total ss * ss)
    /\ ss > 0 /\ total >= 0 /\ 0 <= z /\ z < ComputerDivision.div total ss * ss)
  -> ([@stop_split] [@expl:lemma_divmod requires] [%#sbuddy] ss > 0 /\ z >= 0)
  /\ (([@stop_split] [@expl:lemma_divmod ensures] ([@stop_split] [@expl:lemma_divmod ensures #0] [%#sbuddy'0] z
      = ss * ComputerDivision.div z ss + ComputerDivision.mod z ss)
    /\ ([@stop_split] [@expl:lemma_divmod ensures #1] [%#sbuddy'1] 0 <= ComputerDivision.mod z ss
      /\ ComputerDivision.mod z ss < ss)
    /\ ([@stop_split] [@expl:lemma_divmod ensures #2] [%#sbuddy'2] ComputerDivision.div z ss >= 0))
  -> (let _ = lemma_divmod z ss in ([@stop_split] [@expl:lemma_divmod requires] [%#sbuddy] ss > 0 /\ total >= 0)
  /\ (([@stop_split] [@expl:lemma_divmod ensures] ([@stop_split] [@expl:lemma_divmod ensures #0] [%#sbuddy'0] total
      = ss * ComputerDivision.div total ss + ComputerDivision.mod total ss)
    /\ ([@stop_split] [@expl:lemma_divmod ensures #1] [%#sbuddy'1] 0 <= ComputerDivision.mod total ss
      /\ ComputerDivision.mod total ss < ss)
    /\ ([@stop_split] [@expl:lemma_divmod ensures #2] [%#sbuddy'2] ComputerDivision.div total ss >= 0))
  -> (let _ = lemma_divmod total ss in ([@stop_split] [@expl:lemma_pow2 requires] [%#sbuddy'3] 0 <= 0)
  /\ (([@stop_split] [@expl:lemma_pow2 ensures] ([@stop_split] [@expl:lemma_pow2 ensures #0] [%#sbuddy'4] Pow2int.pow2 0
      >= 1)
    /\ ([@stop_split] [@expl:lemma_pow2 ensures #1] [%#sbuddy'5] Pow2int.pow2 (0 + 1) = 2 * Pow2int.pow2 0))
  -> (let _ = lemma_pow2 0 in span ss 0 = ss
  && ([@stop_split] [@expl:lemma_mul_mod0 requires] [%#sbuddy'6] ss > 0 /\ ComputerDivision.div z ss >= 0)
  /\ (([@stop_split] [@expl:lemma_mul_mod0 ensures] ([@stop_split] [@expl:lemma_mul_mod0 ensures #0] [%#sbuddy'7] ComputerDivision.mod (ss
        * ComputerDivision.div z ss) ss
      = 0)
    /\ ([@stop_split] [@expl:lemma_mul_mod0 ensures #1] [%#sbuddy'8] ComputerDivision.div (ss
      * ComputerDivision.div z ss) ss
    = ComputerDivision.div z ss))
  -> (let _ = lemma_mul_mod0 ss (ComputerDivision.div z ss) in if ComputerDivision.mod (z
    - ComputerDivision.mod z ss) ss
  = 0 then
    if z - ComputerDivision.mod z ss >= 0 then
      z - ComputerDivision.mod z ss = ss * ComputerDivision.div z ss
      && ComputerDivision.div z ss < ComputerDivision.div total ss
      && ([@stop_split] [@expl:lemma_mul_le requires] [%#sbuddy'9] 0 <= ComputerDivision.div z ss + 1
        /\ ComputerDivision.div z ss + 1 <= ComputerDivision.div total ss /\ 0 <= ss)
      /\ (([@stop_split] [@expl:lemma_mul_le ensures] [%#sbuddy'10] (ComputerDivision.div z ss + 1) * ss
        <= ComputerDivision.div total ss * ss)
      -> (let _ = lemma_mul_le (ComputerDivision.div z ss
      + 1) (ComputerDivision.div total ss) ss in ([@stop_split] [@expl:lemma_distrib ensures] [%#sbuddy'11] (ComputerDivision.div z ss
            + 1)
          * ss
        = ComputerDivision.div z ss * ss + 1 * ss)
      -> (let _ = lemma_distrib (ComputerDivision.div z ss) 1 ss in z - ComputerDivision.mod z ss + ss
        <= ComputerDivision.div total ss * ss
      && ComputerDivision.div total ss * ss <= total
      && ([@stop_split] [@expl:lemma_cov_total requires] ([@stop_split] [@expl:lemma_cov_total requires #0] [%#sl2] cov fl ss (ComputerDivision.div total ss
            * ss)
          /\ ss > 0 /\ total >= 0)
        /\ ([@stop_split] [@expl:lemma_cov_total requires #1] [%#sl2'0] 0 <= 0
        /\ 0 <= z - ComputerDivision.mod z ss
        /\ ComputerDivision.mod (z - ComputerDivision.mod z ss) (span ss 0) = 0
        /\ z - ComputerDivision.mod z ss + span ss 0 <= total))
      /\ (([@stop_split] [@expl:lemma_cov_total ensures] [%#sl2'1] inblk fl ss 0 (z - ComputerDivision.mod z ss))
      -> (let _ = lemma_cov_total fl ss total 0 (z
      - ComputerDivision.mod z ss) in [@stop_split] [@expl:lemma_cov_ffree_b ensures] [%#sl2m'0] true
      /\ ffree fl ss z)))))
    else
      false
      && ComputerDivision.div z ss < ComputerDivision.div total ss
      && ([@stop_split] [@expl:lemma_mul_le requires] [%#sbuddy'9] 0 <= ComputerDivision.div z ss + 1
        /\ ComputerDivision.div z ss + 1 <= ComputerDivision.div total ss /\ 0 <= ss)
      /\ (([@stop_split] [@expl:lemma_mul_le ensures] [%#sbuddy'10] (ComputerDivision.div z ss + 1) * ss
        <= ComputerDivision.div total ss * ss)
      -> (let _ = lemma_mul_le (ComputerDivision.div z ss
      + 1) (ComputerDivision.div total ss) ss in ([@stop_split] [@expl:lemma_distrib ensures] [%#sbuddy'11] (ComputerDivision.div z ss
            + 1)
          * ss
        = ComputerDivision.div z ss * ss + 1 * ss)
      -> (let _ = lemma_distrib (ComputerDivision.div z ss) 1 ss in z - ComputerDivision.mod z ss + ss
        <= ComputerDivision.div total ss * ss
      && ComputerDivision.div total ss * ss <= total
      && ([@stop_split] [@expl:lemma_cov_total requires] ([@stop_split] [@expl:lemma_cov_total requires #0] [%#sl2] cov fl ss (ComputerDivision.div total ss
            * ss)
          /\ ss > 0 /\ total >= 0)
        /\ ([@stop_split] [@expl:lemma_cov_total requires #1] [%#sl2'0] 0 <= 0
        /\ 0 <= z - ComputerDivision.mod z ss
        /\ ComputerDivision.mod (z - ComputerDivision.mod z ss) (span ss 0) = 0
        /\ z - ComputerDivision.mod z ss + span ss 0 <= total))
      /\ (([@stop_split] [@expl:lemma_cov_total ensures] [%#sl2'1] inblk fl ss 0 (z - ComputerDivision.mod z ss))
      -> (let _ = lemma_cov_total fl ss total 0 (z
      - ComputerDivision.mod z ss) in [@stop_split] [@expl:lemma_cov_ffree_b ensures] [%#sl2m'0] true
      /\ ffree fl ss z)))))
  
  else
    false
    && ComputerDivision.div z ss < ComputerDivision.div total ss
    && ([@stop_split] [@expl:lemma_mul_le requires] [%#sbuddy'9] 0 <= ComputerDivision.div z ss + 1
      /\ ComputerDivision.div z ss + 1 <= ComputerDivision.div total ss /\ 0 <= ss)
    /\ (([@stop_split] [@expl:lemma_mul_le ensures] [%#sbuddy'10] (ComputerDivision.div z ss + 1) * ss
      <= ComputerDivision.div total ss * ss)
    -> (let _ = lemma_mul_le (ComputerDivision.div z ss
    + 1) (ComputerDivision.div total ss) ss in ([@stop_split] [@expl:lemma_distrib ensures] [%#sbuddy'11] (ComputerDivision.div z ss
          + 1)
        * ss
      = ComputerDivision.div z ss * ss + 1 * ss)
    -> (let _ = lemma_distrib (ComputerDivision.div z ss) 1 ss in z - ComputerDivision.mod z ss + ss
      <= ComputerDivision.div total ss * ss
    && ComputerDivision.div total ss * ss <= total
    && ([@stop_split] [@expl:lemma_cov_total requires] ([@stop_split] [@expl:lemma_cov_total requires #0] [%#sl2] cov fl ss (ComputerDivision.div total ss
          * ss)
        /\ ss > 0 /\ total >= 0)
      /\ ([@stop_split] [@expl:lemma_cov_total requires #1] [%#sl2'0] 0 <= 0
      /\ 0 <= z - ComputerDivision.mod z ss
      /\ ComputerDivision.mod (z - ComputerDivision.mod z ss) (span ss 0) = 0
      /\ z - ComputerDivision.mod z ss + span ss 0 <= total))
    /\ (([@stop_split] [@expl:lemma_cov_total ensures] [%#sl2'1] inblk fl ss 0 (z - ComputerDivision.mod z ss))
    -> (let _ = lemma_cov_total fl ss total 0 (z
    - ComputerDivision.mod z ss) in [@stop_split] [@expl:lemma_cov_ffree_b ensures] [%#sl2m'0] true
    /\ ffree fl ss z)))))
  ))))))))
