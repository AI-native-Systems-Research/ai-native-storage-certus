function lemma_mul_le [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/buddy.rs" 156 0 156 43] (a: int) (b: int) (c: int) : ()

axiom lemma_mul_le_spec: forall a: int, b: int, c: int. ([%#sbuddy'9] 0 <= a /\ a <= b /\ 0 <= c)
    -> ([%#sbuddy'10] a * c <= b * c)

function lemma_distrib [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/buddy.rs" 164 0 164 44] (a: int) (b: int) (c: int) : ()

axiom lemma_distrib_spec: forall a: int, b: int, c: int. [%#sbuddy'11] (a + b) * c = a * c + b * c

predicate inblk [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/l2.rs" 67 0 67 65] (fl: Seq.seq t_Vec_u64_Global) (ss: int) (kk: int) (t: int) =
  [%#sl2'3] exists o: int, k: int. fv fl o k /\ o >= kk /\ fs fl o k <= t /\ t + span ss kk <= fs fl o k + span ss o

function lemma_cov_total [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/l2.rs" 444 0 444 79] (fl: Seq.seq t_Vec_u64_Global) (ss: int) (total: int) (kk: int) (t: int) : ()

axiom lemma_cov_total_spec:
  forall fl: Seq.seq t_Vec_u64_Global, ss: int, total: int, kk: int, t: int. ([%#sl2] cov fl ss (ComputerDivision.div total ss
        * ss)
      /\ ss > 0 /\ total >= 0)
    -> ([%#sl2'0] 0 <= kk /\ 0 <= t /\ ComputerDivision.mod t (span ss kk) = 0 /\ t + span ss kk <= total)
    -> ([%#sl2'1] inblk fl ss kk t)

