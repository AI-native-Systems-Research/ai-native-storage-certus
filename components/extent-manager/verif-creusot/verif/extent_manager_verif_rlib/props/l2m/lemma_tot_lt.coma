use int.ComputerDivision
use bv.Pow2int
use int.Int

function span [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/buddy.rs" 32 0 32 35] (ss: int) (o: int) : int
 = [%#sbuddy'6] Pow2int.pow2 o * ss

function lemma_divmod [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/buddy.rs" 184 0 184 35] (x: int) (m: int) : ()

axiom lemma_divmod_spec: forall x: int, m: int. ([%#sbuddy] m > 0 /\ x >= 0)
    -> ([%#sbuddy'0] x = m * ComputerDivision.div x m + ComputerDivision.mod x m)

axiom lemma_divmod_spec'0: forall x: int, m: int. ([%#sbuddy] m > 0 /\ x >= 0)
    -> ([%#sbuddy'1] 0 <= ComputerDivision.mod x m /\ ComputerDivision.mod x m < m)

axiom lemma_divmod_spec'1: forall x: int, m: int. ([%#sbuddy] m > 0 /\ x >= 0)
    -> ([%#sbuddy'2] ComputerDivision.div x m >= 0)

function lemma_mul_le [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/buddy.rs" 156 0 156 43] (a: int) (b: int) (c: int) : ()

axiom lemma_mul_le_spec: forall a: int, b: int, c: int. ([%#sbuddy'3] 0 <= a /\ a <= b /\ 0 <= c)
    -> ([%#sbuddy'4] a * c <= b * c)

function lemma_distrib [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/buddy.rs" 164 0 164 44] (a: int) (b: int) (c: int) : ()

axiom lemma_distrib_spec: forall a: int, b: int, c: int. [%#sbuddy'5] (a + b) * c = a * c + b * c

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant ss : int

constant total : int

constant mo : int

function lemma_tot_lt [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/props/l2m.rs" 141 0 141 49] (ss: int) (total: int) (mo: int) : ()

goal vc_lemma_tot_lt: ([%#sl2m] ss > 0
    /\ total >= 0 /\ mo >= 0 /\ ComputerDivision.div total ss < Pow2int.pow2 (mo + 1))
  -> ([@stop_split] [@expl:lemma_divmod requires] [%#sbuddy] ss > 0 /\ total >= 0)
  /\ (([@stop_split] [@expl:lemma_divmod ensures] ([@stop_split] [@expl:lemma_divmod ensures #0] [%#sbuddy'0] total
      = ss * ComputerDivision.div total ss + ComputerDivision.mod total ss)
    /\ ([@stop_split] [@expl:lemma_divmod ensures #1] [%#sbuddy'1] 0 <= ComputerDivision.mod total ss
      /\ ComputerDivision.mod total ss < ss)
    /\ ([@stop_split] [@expl:lemma_divmod ensures #2] [%#sbuddy'2] ComputerDivision.div total ss >= 0))
  -> (let _ = lemma_divmod total ss in ([@stop_split] [@expl:lemma_mul_le requires] [%#sbuddy'3] 0
      <= ComputerDivision.div total ss + 1
    /\ ComputerDivision.div total ss + 1 <= Pow2int.pow2 (mo + 1) /\ 0 <= ss)
  /\ (([@stop_split] [@expl:lemma_mul_le ensures] [%#sbuddy'4] (ComputerDivision.div total ss + 1) * ss
    <= Pow2int.pow2 (mo + 1) * ss)
  -> (let _ = lemma_mul_le (ComputerDivision.div total ss + 1) (Pow2int.pow2 (mo
  + 1)) ss in ([@stop_split] [@expl:lemma_distrib ensures] [%#sbuddy'5] (ComputerDivision.div total ss + 1) * ss
    = ComputerDivision.div total ss * ss + 1 * ss)
  -> ([@stop_split] [@expl:lemma_tot_lt ensures] [%#sl2m'0] total < span ss (mo + 1))))))
