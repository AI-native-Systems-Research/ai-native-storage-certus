use creusot.prelude.MutBorrow
use creusot.int.UInt64
use seq.Seq
use creusot.int.UInt32
use bv.Pow2int
use int.ComputerDivision
use creusot.prelude.Any
use int.Int

type t_Vec_tup2_u64_u64_Global

type tup2_u64_u64 = { f0: UInt64.t; f1: UInt64.t }

constant const_MAX: UInt64.t = (18446744073709551615: UInt64.t)

function view_Vec_tup2_u64_u64_Global (self: t_Vec_tup2_u64_u64_Global) : Seq.seq tup2_u64_u64

axiom view_Vec_tup2_u64_u64_Global_spec:
  forall self: t_Vec_tup2_u64_u64_Global [view_Vec_tup2_u64_u64_Global self]. [%#svec] Seq.length (view_Vec_tup2_u64_u64_Global self)
    <= UInt64.t'int const_MAX

type t_Vec_Vec_u64_Global_Global

type t_BuddyAllocator = {
  base_offset: UInt64.t;
  total_usable_size: UInt64.t;
  sector_size: UInt32.t;
  max_order: UInt64.t;
  free_lists: t_Vec_Vec_u64_Global_Global }

type t_BOp = Alloc UInt64.t | Free UInt64.t

let elim_Free (_x: t_BOp) (return (f0'0: UInt64.t)) = any
  [ _k (f0'0: UInt64.t) -> {Free f0'0 = _x} (! return {f0'0})
  | _chk -> (! {[@expl:elim Free] match _x with
      | Free _ -> true
      | _ -> false
