 = [%#sl2m'7] ()

axiom lemma_rm_rel_spec: forall lb: Seq.seq tup2_u64_u64, la: Seq.seq tup2_u64_u64, i: int. ([%#sl2m'5] 0 <= i
      /\ i < Seq.length la /\ lb = Seq.(++) (Seq.([..]) la 0 i) (Seq.([..]) la (i + 1) (Seq.length la)))
    -> ([%#sl2m'6] rm_rel lb la i)

type t_Vec_Vec_u64_Global_Global

