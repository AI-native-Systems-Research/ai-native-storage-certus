let set_data_base_lba (self: MutBorrow.t t_ExtentManager) (base_lba: UInt64.t) (return (x: ())) =
{[@stop_split] [@expl:set_data_base_lba 'self' type invariant] [%#scomponent] inv_refmut_ExtentManager self}
  any
  [ return (result: ()) ->
  {[@stop_split] [@expl:set_data_base_lba ensures] ([@stop_split] [@expl:set_data_base_lba ensures #0] [%#scomponent'0] self.final.data_base_lba
      = base_lba)
    /\ ([@stop_split] [@expl:set_data_base_lba ensures #1] [%#scomponent'1] self.final.arena = self.current.arena
      /\ self.final.regions = self.current.regions /\ self.final.shared = self.current.shared)
    /\ ([@stop_split] [@expl:set_data_base_lba ensures #2] [%#scomponent'2] self.final.metadata_base_lba
        = self.current.metadata_base_lba
      /\ self.final.metadata_ns_id = self.current.metadata_ns_id)
    /\ ([@stop_split] [@expl:set_data_base_lba ensures #3] [%#scomponent'3] self.final.dev = self.current.dev)}
    (! return {result}) ]

