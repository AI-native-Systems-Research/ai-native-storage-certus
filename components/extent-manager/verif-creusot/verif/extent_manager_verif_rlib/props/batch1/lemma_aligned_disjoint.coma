use int.ComputerDivision
use int.Int

function lemma_divmod [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/buddy.rs" 184 0 184 35] (x: int) (m: int) : ()

axiom lemma_divmod_spec: forall x: int, m: int. ([%#sbuddy] m > 0 /\ x >= 0)
    -> ([%#sbuddy'0] x = m * ComputerDivision.div x m + ComputerDivision.mod x m)

axiom lemma_divmod_spec'0: forall x: int, m: int. ([%#sbuddy] m > 0 /\ x >= 0)
    -> ([%#sbuddy'1] 0 <= ComputerDivision.mod x m /\ ComputerDivision.mod x m < m)

axiom lemma_divmod_spec'1: forall x: int, m: int. ([%#sbuddy] m > 0 /\ x >= 0)
    -> ([%#sbuddy'2] ComputerDivision.div x m >= 0)

function lemma_mul_le [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/buddy.rs" 156 0 156 43] (a: int) (b: int) (c: int) : ()

axiom lemma_mul_le_spec: forall a: int, b: int, c: int. ([%#sbuddy'3] 0 <= a /\ a <= b /\ 0 <= c)
    -> ([%#sbuddy'4] a * c <= b * c)

function lemma_distrib [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/buddy.rs" 164 0 164 44] (a: int) (b: int) (c: int) : ()

axiom lemma_distrib_spec: forall a: int, b: int, c: int. [%#sbuddy'5] (a + b) * c = a * c + b * c

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant x : int

constant y : int

constant m : int

function lemma_aligned_disjoint [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/props/batch1.rs" 347 0 347 53] (x: int) (y: int) (m: int) : ()

goal vc_lemma_aligned_disjoint: ([%#sbatch1] m > 0
    /\ x >= 0 /\ y >= 0 /\ ComputerDivision.mod x m = 0 /\ ComputerDivision.mod y m = 0 /\ x < y)
  -> ([@stop_split] [@expl:lemma_divmod requires] [%#sbuddy] m > 0 /\ x >= 0)
  /\ (([@stop_split] [@expl:lemma_divmod ensures] ([@stop_split] [@expl:lemma_divmod ensures #0] [%#sbuddy'0] x
      = m * ComputerDivision.div x m + ComputerDivision.mod x m)
    /\ ([@stop_split] [@expl:lemma_divmod ensures #1] [%#sbuddy'1] 0 <= ComputerDivision.mod x m
      /\ ComputerDivision.mod x m < m)
    /\ ([@stop_split] [@expl:lemma_divmod ensures #2] [%#sbuddy'2] ComputerDivision.div x m >= 0))
  -> (let _ = lemma_divmod x m in ([@stop_split] [@expl:lemma_divmod requires] [%#sbuddy] m > 0 /\ y >= 0)
  /\ (([@stop_split] [@expl:lemma_divmod ensures] ([@stop_split] [@expl:lemma_divmod ensures #0] [%#sbuddy'0] y
      = m * ComputerDivision.div y m + ComputerDivision.mod y m)
    /\ ([@stop_split] [@expl:lemma_divmod ensures #1] [%#sbuddy'1] 0 <= ComputerDivision.mod y m
      /\ ComputerDivision.mod y m < m)
    /\ ([@stop_split] [@expl:lemma_divmod ensures #2] [%#sbuddy'2] ComputerDivision.div y m >= 0))
  -> (let _ = lemma_divmod y m in ([@stop_split] [@expl:lemma_mul_le requires] [%#sbuddy'3] 0
      <= ComputerDivision.div x m + 1
    /\ ComputerDivision.div x m + 1 <= ComputerDivision.div y m /\ 0 <= m)
  /\ (([@stop_split] [@expl:lemma_mul_le ensures] [%#sbuddy'4] (ComputerDivision.div x m + 1) * m
    <= ComputerDivision.div y m * m)
  -> (let _ = lemma_mul_le (ComputerDivision.div x m
  + 1) (ComputerDivision.div y m) m in ([@stop_split] [@expl:lemma_distrib ensures] [%#sbuddy'5] (ComputerDivision.div x m
        + 1)
      * m
    = ComputerDivision.div x m * m + 1 * m)
  -> ([@stop_split] [@expl:lemma_aligned_disjoint ensures] [%#sbatch1'0] x + m <= y)))))))
