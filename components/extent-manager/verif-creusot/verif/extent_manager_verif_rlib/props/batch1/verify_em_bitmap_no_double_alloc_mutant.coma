let mark_slot_allocated (self: MutBorrow.t t_Slab) (slot_index: UInt64.t) (return (x: ())) =
{[@stop_split] [@expl:mark_slot_allocated requires] ([@stop_split] [@expl:mark_slot_allocated requires #0] [%#sslab] slab_inv self.current)
  /\ ([@stop_split] [@expl:mark_slot_allocated requires #1] [%#sslab'0] UInt64.t'int slot_index
    < UInt32.t'int self.current.bitmap.num_slots)
  /\ ([@stop_split] [@expl:mark_slot_allocated requires #2] [%#sslab'1] not slot_bit self.current.bitmap (UInt64.t'int slot_index))}
  any
  [ return (result: ()) ->
  {[@stop_split] [@expl:mark_slot_allocated ensures] ([@stop_split] [@expl:mark_slot_allocated ensures #0] [%#sslab'2] slab_inv self.final)
    /\ ([@stop_split] [@expl:mark_slot_allocated ensures #1] [%#sslab'3] self.final.start_offset
        = self.current.start_offset
      /\ self.final.slab_size = self.current.slab_size)
    /\ ([@stop_split] [@expl:mark_slot_allocated ensures #2] [%#sslab'4] self.final.element_size
        = self.current.element_size
      /\ self.final.keys = self.current.keys)
    /\ ([@stop_split] [@expl:mark_slot_allocated ensures #3] [%#sslab'5] self.final.rover = self.current.rover
      /\ self.final.bitmap.num_slots = self.current.bitmap.num_slots)
    /\ ([@stop_split] [@expl:mark_slot_allocated ensures #4] [%#sslab'6] slot_bit self.final.bitmap (UInt64.t'int slot_index))
    /\ ([@stop_split] [@expl:mark_slot_allocated ensures #5] [%#sslab'7] forall j: int. 0 <= j
          /\ j < UInt32.t'int self.current.bitmap.num_slots /\ j <> UInt64.t'int slot_index
        -> slot_bit self.final.bitmap j = slot_bit self.current.bitmap j)
    /\ ([@stop_split] [@expl:mark_slot_allocated ensures #6] [%#sslab'8] UInt32.t'int self.final.bitmap.allocated_count
    = UInt32.t'int self.current.bitmap.allocated_count + 1)}
    (! return {result}) ]

predicate resolve_refmut_Slab [@inline:trivial] (_1: MutBorrow.t t_Slab) = _1.final = _1.current

meta "rewrite_def" predicate resolve_refmut_Slab

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

