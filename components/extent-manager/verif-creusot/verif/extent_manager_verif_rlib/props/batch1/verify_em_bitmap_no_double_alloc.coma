    /\ ([@stop_split] [@expl:alloc_slot ensures #2] [%#sslab'3] self.final.element_size'0 = self.current.element_size'0
      /\ self.final.keys'0 = self.current.keys'0)
    /\ ([@stop_split] [@expl:alloc_slot ensures #3] [%#sslab'4] self.final.bitmap'0.num_slots
      = self.current.bitmap'0.num_slots)
    /\ ([@stop_split] [@expl:alloc_slot ensures #4] [%#sslab'5] match result with
      | Some {f0 = idx; f1 = off} -> UInt64.t'int idx < UInt32.t'int self.current.bitmap'0.num_slots
