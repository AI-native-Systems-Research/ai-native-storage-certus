      /\ slot_bit self.final.bitmap'0 (UInt64.t'int idx)
      /\ (UInt64.t'int self.current.rover'0 <= UInt64.t'int idx
        -> (forall j: int. UInt64.t'int self.current.rover'0 <= j /\ j < UInt64.t'int idx
          -> slot_bit self.current.bitmap'0 j))
      /\ UInt64.t'int off = slot_off self.current (UInt64.t'int idx)
      /\ UInt64.t'int self.final.rover'0
        = ComputerDivision.mod (UInt64.t'int idx + 1) (UInt32.t'int self.current.bitmap'0.num_slots)
      /\ UInt32.t'int self.final.bitmap'0.allocated_count = UInt32.t'int self.current.bitmap'0.allocated_count + 1
      /\ (forall j: int. 0 <= j /\ j < UInt32.t'int self.current.bitmap'0.num_slots /\ j <> UInt64.t'int idx
        -> slot_bit self.final.bitmap'0 j = slot_bit self.current.bitmap'0 j)
