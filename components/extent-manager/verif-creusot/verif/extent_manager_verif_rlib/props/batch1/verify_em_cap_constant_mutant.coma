  any
  [ return (result: ()) ->
  {[@stop_split] [@expl:apply_cop ensures] ([@stop_split] [@expl:apply_cop ensures #0] [%#sbatch1'10] em_ok em.final)
    /\ ([@stop_split] [@expl:apply_cop ensures #1] [%#sbatch1'11] em.final.regions = em.current.regions
      /\ Seq.length (view_Vec_RegionState_Global em.final.arena)
      = Seq.length (view_Vec_RegionState_Global em.current.arena))
    /\ ([@stop_split] [@expl:apply_cop ensures #2] [%#sbatch1'12] forall i: int. 0 <= i
          /\ i < Seq.length (view_Vec_RegionState_Global em.current.arena)
        -> rg_frame (Seq.get (view_Vec_RegionState_Global em.current.arena) i) (Seq.get (view_Vec_RegionState_Global em.final.arena) i))
    /\ ([@stop_split] [@expl:apply_cop ensures #3] [%#sbatch1'13] em.final.metadata_base_lba
        = em.current.metadata_base_lba
      /\ em.final.data_base_lba = em.current.data_base_lba)
    /\ ([@stop_split] [@expl:apply_cop ensures #4] [%#sbatch1'14] shared_frame em.current.shared em.final.shared)
    /\ ([@stop_split] [@expl:apply_cop ensures #5] [%#sbatch1'15] seq_agree em.current -> seq_agree em.final)
    /\ ([@stop_split] [@expl:apply_cop ensures #6] [%#sbatch1'16] match { f0'0 = em.current.shared;
                                                                          f1'0 = em.final.shared } with
      | {f0'0 = Some'1 a; f1'0 = Some'1 b} -> sb_frame a.superblock b.superblock
      | _ -> true
      end)}
    (! return {result}) ]

