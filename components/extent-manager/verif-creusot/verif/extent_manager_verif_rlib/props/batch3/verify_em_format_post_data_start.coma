use creusot.int.UInt64
use creusot.prelude.MutBorrow
use creusot.int.UInt32
use creusot.int.UInt8
use seq.Seq
use int.ComputerDivision
use bv.Pow2int
use map.Map
use map.Const
use creusot.prelude.Any
use int.Int

type t_Vec_RegionState_Global

type t_Vec_usize_Global

type t_Option_Vec_usize_Global = None | Some t_Vec_usize_Global

type t_Option_u64 = None'0 | Some'0 UInt64.t

type t_FormatParams = {
  data_disk_size: UInt64.t;
  slab_size: UInt64.t;
  max_extent_size: UInt32.t;
  sector_size: UInt32.t;
  region_count: UInt32.t;
  metadata_alignment: UInt64.t;
  instance_id: t_Option_u64;
  metadata_disk_ns_id: UInt32.t;
  metadata_region_size: UInt64.t }

type t_Superblock = {
  magic'0: UInt64.t;
  version'0: UInt32.t;
  data_disk_size'0: UInt64.t;
  sector_size'0: UInt32.t;
  slab_size'0: UInt64.t;
  max_extent_size'0: UInt32.t;
  region_count'0: UInt32.t;
  checkpoint_seq'0: UInt64.t;
  active_copy'0: UInt8.t;
  checkpoint_region_offset'0: UInt64.t;
  checkpoint_region_size'0: UInt64.t;
  instance_id'0: UInt64.t;
  metadata_disk_ns_id'0: UInt32.t;
  data_start_offset'0: UInt64.t }

type t_SharedState = { format_params: t_FormatParams; checkpoint_seq: UInt64.t; superblock: t_Superblock }

type t_Option_SharedState = None'1 | Some'1 t_SharedState

type t_Option_u32 = None'2 | Some'2 UInt32.t

type t_Option_Superblock = None'3 | Some'3 t_Superblock

type tup2_u64_usize = { f0: UInt64.t; f1: UInt64.t }

type t_Option_tup2_u64_usize = None'4 | Some'4 tup2_u64_usize

type t_MetaDevice = {
  connected'1: bool;
  sector_size'1: UInt32.t;
  num_sectors'1: UInt64.t;
  sb'1: t_Option_Superblock;
  ckpt0'1: t_Option_tup2_u64_usize;
  ckpt1'1: t_Option_tup2_u64_usize }

type t_ExtentManager = {
  arena: t_Vec_RegionState_Global;
  regions: t_Option_Vec_usize_Global;
  shared: t_Option_SharedState;
  metadata_ns_id: t_Option_u32;
  metadata_base_lba: UInt64.t;
  data_base_lba: UInt64.t;
  dev: t_MetaDevice }

type t_BTreeMap_u64_Slab_Global

type t_SlabMap = { inner: t_BTreeMap_u64_Slab_Global }

type t_HashMap_u32_Vec_u64_Global_RandomState_Global

type t_SizeClassManager = { map: t_HashMap_u32_Vec_u64_Global_RandomState_Global }

type t_Vec_Vec_u64_Global_Global

type t_BuddyAllocator = {
  base_offset'2: UInt64.t;
  total_usable_size'2: UInt64.t;
  sector_size'2: UInt32.t;
  max_order'2: UInt64.t;
  free_lists'2: t_Vec_Vec_u64_Global_Global }

type t_Vec_tup2_u64_usize_Global

type t_RegionState = {
  slabs'0: t_SlabMap;
  size_classes'0: t_SizeClassManager;
  buddy'0: t_BuddyAllocator;
  dirty'0: bool;
  format_params'0: t_FormatParams;
  pending_frees'0: t_Vec_tup2_u64_usize_Global }

predicate inv_BTreeMap_u64_Slab_Global (_1: t_BTreeMap_u64_Slab_Global)

predicate inv_SlabMap (_1: t_SlabMap)

axiom inv_axiom [@rewrite]: forall x: t_SlabMap [inv_SlabMap x]. inv_SlabMap x = inv_BTreeMap_u64_Slab_Global x.inner

predicate inv_HashMap_u32_Vec_u64_Global_RandomState_Global (_1: t_HashMap_u32_Vec_u64_Global_RandomState_Global)

predicate inv_SizeClassManager (_1: t_SizeClassManager)

axiom inv_axiom'0 [@rewrite]: forall x: t_SizeClassManager [inv_SizeClassManager x]. inv_SizeClassManager x
    = inv_HashMap_u32_Vec_u64_Global_RandomState_Global x.map

predicate inv_RegionState (_1: t_RegionState)

axiom inv_axiom'1 [@rewrite]: forall x: t_RegionState [inv_RegionState x]. inv_RegionState x
    = (inv_SlabMap x.slabs'0 /\ inv_SizeClassManager x.size_classes'0)

predicate invariant_ref_RegionState [@inline:trivial] (self: t_RegionState) = [%#sinvariant'0] inv_RegionState self

meta "rewrite_def" predicate invariant_ref_RegionState

predicate inv_ref_RegionState [@inline:trivial] (_1: t_RegionState) = invariant_ref_RegionState _1

