use creusot.int.UInt64
use creusot.int.UInt32
use map.Map
use seq.Seq
use creusot.prelude.MutBorrow
use creusot.int.UInt8
use int.ComputerDivision
use bv.Pow2int
use creusot.prelude.Any
use int.Int

type t_Handle = {
  region: UInt64.t;
  key: UInt64.t;
  offset: UInt64.t;
  size: UInt32.t;
  slab_start: UInt64.t;
  slot_idx: UInt64.t }

type t_WH = { h: t_Handle; publish_fn: bool; abort_fn: bool }

let new (h'0: t_Handle) (return (x: t_WH)) = any
  [ return (result: t_WH) -> {[@stop_split] [@expl:new ensures] [%#sb3] result.h = h'0
    /\ result.publish_fn /\ result.abort_fn}
    (! return {result}) ]

type t_FMap_Int_Slab

type t_Vec_u64_Global

type t_AllocationBitmap = { words: t_Vec_u64_Global; num_slots: UInt32.t; allocated_count: UInt32.t }

type t_Slab = {
  start_offset: UInt64.t;
  slab_size: UInt64.t;
  element_size: UInt32.t;
  bitmap: t_AllocationBitmap;
  keys: t_Vec_u64_Global;
  rover: UInt64.t }

type t_Option_Slab = None | Some t_Slab

predicate index_Mapping_Slab_bool [@inline:trivial] (self: Map.map t_Slab bool) (a: t_Slab) =
  [%#smapping] Map.get self a

meta "rewrite_def" predicate index_Mapping_Slab_bool

function such_that_Slab (p: Map.map t_Slab bool) : t_Slab

axiom such_that_Slab_spec:
  forall p: Map.map t_Slab bool [such_that_Slab p]. ([%#slogic] exists x: t_Slab. index_Mapping_Slab_bool p x)
    -> ([%#slogic'0] index_Mapping_Slab_bool p (such_that_Slab p))

function unwrap_Option_Slab (self: t_Option_Slab) : t_Slab = [%#soption'0] match self with
    | Some x -> x
    | None -> such_that_Slab (fun (__0: t_Slab) -> true)
    end

function to_mapping_Int (self: t_FMap_Int_Slab) : Map.map int t_Option_Slab

function get_Int [@inline:trivial] (self: t_FMap_Int_Slab) (k: int) : t_Option_Slab =
  [%#sfmap'0] Map.get (to_mapping_Int self) k

meta "rewrite_def" function get_Int

function lookup_Int [@inline:trivial] (self: t_FMap_Int_Slab) (k: int) : t_Slab =
  [%#sfmap] unwrap_Option_Slab (get_Int self k)

meta "rewrite_def" function lookup_Int

type t_BTreeMap_u64_Slab_Global

type t_SlabMap = { inner: t_BTreeMap_u64_Slab_Global }

function view_SlabMap [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/region.rs" 34 4 34 36] (self: t_SlabMap) : t_FMap_Int_Slab

type t_Vec_RegionState_Global

type t_HashMap_u32_Vec_u64_Global_RandomState_Global

type t_SizeClassManager = { map: t_HashMap_u32_Vec_u64_Global_RandomState_Global }

type t_Vec_Vec_u64_Global_Global

type t_BuddyAllocator = {
  base_offset: UInt64.t;
  total_usable_size: UInt64.t;
  sector_size: UInt32.t;
  max_order: UInt64.t;
  free_lists: t_Vec_Vec_u64_Global_Global }

type t_Option_u64 = None'0 | Some'0 UInt64.t

type t_FormatParams = {
  data_disk_size'0: UInt64.t;
  slab_size'0: UInt64.t;
  max_extent_size'0: UInt32.t;
  sector_size'0: UInt32.t;
  region_count'0: UInt32.t;
  metadata_alignment'0: UInt64.t;
  instance_id'0: t_Option_u64;
  metadata_disk_ns_id'0: UInt32.t;
  metadata_region_size'0: UInt64.t }

type t_Vec_tup2_u64_usize_Global

type t_RegionState = {
  slabs: t_SlabMap;
  size_classes: t_SizeClassManager;
  buddy: t_BuddyAllocator;
  dirty: bool;
  format_params: t_FormatParams;
  pending_frees: t_Vec_tup2_u64_usize_Global }

constant const_MAX: UInt64.t = (18446744073709551615: UInt64.t)

function view_Vec_RegionState_Global (self: t_Vec_RegionState_Global) : Seq.seq t_RegionState

axiom view_Vec_RegionState_Global_spec:
  forall self: t_Vec_RegionState_Global [view_Vec_RegionState_Global self]. [%#svec] Seq.length (view_Vec_RegionState_Global self)
    <= UInt64.t'int const_MAX

type t_Vec_usize_Global

type t_Option_Vec_usize_Global = None'1 | Some'1 t_Vec_usize_Global

type t_Superblock = {
  magic'1: UInt64.t;
  version'1: UInt32.t;
  data_disk_size'1: UInt64.t;
  sector_size'1: UInt32.t;
  slab_size'1: UInt64.t;
  max_extent_size'1: UInt32.t;
  region_count'1: UInt32.t;
  checkpoint_seq'1: UInt64.t;
  active_copy'1: UInt8.t;
  checkpoint_region_offset'1: UInt64.t;
  checkpoint_region_size'1: UInt64.t;
  instance_id'1: UInt64.t;
  metadata_disk_ns_id'1: UInt32.t;
  data_start_offset'1: UInt64.t }

type t_SharedState = { format_params'0: t_FormatParams; checkpoint_seq'0: UInt64.t; superblock'0: t_Superblock }

type t_Option_SharedState = None'2 | Some'2 t_SharedState

type t_Option_u32 = None'3 | Some'3 UInt32.t

type t_Option_Superblock = None'4 | Some'4 t_Superblock

type tup2_u64_usize = { f0: UInt64.t; f1: UInt64.t }

type t_Option_tup2_u64_usize = None'5 | Some'5 tup2_u64_usize

type t_MetaDevice = {
  connected'2: bool;
