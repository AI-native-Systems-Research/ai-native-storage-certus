use int.ComputerDivision
use int.Int

function eff_l [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/component.rs" 659 0 659 38] (md: int) (mrs: int) : int
 = [%#scomponent'1] if mrs > 0 then if md <= mrs then md else mrs else md

function ckoff_l [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/component.rs" 652 0 652 29] (a: int) : int
 = [%#scomponent'0] if a = 0 then 4096 else ComputerDivision.div (4096 + a - 1) a * a

function cksize_l [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/component.rs" 666 0 666 58] (md: int) (mrs: int) (a: int) (ss: int) : int
 = [%#scomponent] if eff_l md mrs >= ckoff_l a then
    ComputerDivision.div (ComputerDivision.div (eff_l md mrs - ckoff_l a) 2) ss * ss
  else
    0


function lemma_divmod [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/buddy.rs" 184 0 184 35] (x: int) (m: int) : ()

axiom lemma_divmod_spec: forall x: int, m: int. ([%#sbuddy] m > 0 /\ x >= 0)
    -> ([%#sbuddy'0] x = m * ComputerDivision.div x m + ComputerDivision.mod x m)

axiom lemma_divmod_spec'0: forall x: int, m: int. ([%#sbuddy] m > 0 /\ x >= 0)
    -> ([%#sbuddy'1] 0 <= ComputerDivision.mod x m /\ ComputerDivision.mod x m < m)

axiom lemma_divmod_spec'1: forall x: int, m: int. ([%#sbuddy] m > 0 /\ x >= 0)
    -> ([%#sbuddy'2] ComputerDivision.div x m >= 0)

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant md : int

constant mrs : int

constant a : int

constant ss : int

function lemma_cklayout_fits [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/props/batch3.rs" 431 0 431 62] (md: int) (mrs: int) (a: int) (ss: int) : ()

goal vc_lemma_cklayout_fits: ([%#sbatch3] md >= 0 /\ mrs >= 0 /\ a >= 0 /\ ss > 0)
  -> ([%#sbatch3'0] cksize_l md mrs a ss > 0)
  -> ([@stop_split] [@expl:lemma_divmod requires] [%#sbuddy] 2 > 0 /\ eff_l md mrs - ckoff_l a >= 0)
  /\ (([@stop_split] [@expl:lemma_divmod ensures] ([@stop_split] [@expl:lemma_divmod ensures #0] [%#sbuddy'0] eff_l md mrs
        - ckoff_l a
      = 2 * ComputerDivision.div (eff_l md mrs - ckoff_l a) 2 + ComputerDivision.mod (eff_l md mrs - ckoff_l a) 2)
    /\ ([@stop_split] [@expl:lemma_divmod ensures #1] [%#sbuddy'1] 0
        <= ComputerDivision.mod (eff_l md mrs - ckoff_l a) 2
      /\ ComputerDivision.mod (eff_l md mrs - ckoff_l a) 2 < 2)
    /\ ([@stop_split] [@expl:lemma_divmod ensures #2] [%#sbuddy'2] ComputerDivision.div (eff_l md mrs - ckoff_l a) 2
    >= 0))
  -> (let _ = lemma_divmod (eff_l md mrs - ckoff_l a) 2 in ([@stop_split] [@expl:lemma_divmod requires] [%#sbuddy] ss
      > 0
    /\ ComputerDivision.div (eff_l md mrs - ckoff_l a) 2 >= 0)
  /\ (([@stop_split] [@expl:lemma_divmod ensures] ([@stop_split] [@expl:lemma_divmod ensures #0] [%#sbuddy'0] ComputerDivision.div (eff_l md mrs
        - ckoff_l a) 2
      = ss * ComputerDivision.div (ComputerDivision.div (eff_l md mrs - ckoff_l a) 2) ss
      + ComputerDivision.mod (ComputerDivision.div (eff_l md mrs - ckoff_l a) 2) ss)
    /\ ([@stop_split] [@expl:lemma_divmod ensures #1] [%#sbuddy'1] 0
        <= ComputerDivision.mod (ComputerDivision.div (eff_l md mrs - ckoff_l a) 2) ss
      /\ ComputerDivision.mod (ComputerDivision.div (eff_l md mrs - ckoff_l a) 2) ss < ss)
    /\ ([@stop_split] [@expl:lemma_divmod ensures #2] [%#sbuddy'2] ComputerDivision.div (ComputerDivision.div (eff_l md mrs
      - ckoff_l a) 2) ss
    >= 0))
  -> ([@stop_split] [@expl:lemma_cklayout_fits ensures] [%#sbatch3'1] ckoff_l a + 2 * cksize_l md mrs a ss
  <= eff_l md mrs))))
