let recover_rd (sb_seq'0: UInt64.t) (active: UInt8.t) (act: t_RdOut) (inact: t_RdOut)
  (return (x: t_Result_Recovered_EmError)) = {[@stop_split] [@expl:recover_rd requires] [%#sb3] UInt8.t'int active <= 1}
  any
  [ return (result: t_Result_Recovered_EmError) ->
  {[@stop_split] [@expl:recover_rd ensures] ([@stop_split] [@expl:recover_rd ensures #0] [%#sb3'0] UInt64.t'int sb_seq'0
        = 0 -> result = Ok (Empty))
    /\ ([@stop_split] [@expl:recover_rd ensures #1] [%#sb3'1] UInt64.t'int sb_seq'0 > 0 /\ act = Good sb_seq'0
      -> result = Ok (Copy active))
    /\ ([@stop_split] [@expl:recover_rd ensures #2] [%#sb3'2] forall q: UInt64.t. UInt64.t'int sb_seq'0 > 1
          /\ UInt64.t'int q = UInt64.t'int sb_seq'0 - 1 /\ act <> Good sb_seq'0 /\ inact = Good q
        -> result = Ok (Copy (if UInt8.t'int active = 0 then (1: UInt8.t) else (0: UInt8.t))))
    /\ ([@stop_split] [@expl:recover_rd ensures #3] [%#sb3'3] UInt64.t'int sb_seq'0 > 0
      /\ act <> Good sb_seq'0
      /\ (UInt64.t'int sb_seq'0 = 1
      \/ (forall q: UInt64.t. UInt64.t'int q = UInt64.t'int sb_seq'0 - 1 -> inact <> Good q))
    -> result = Err (CorruptMetadata))}
    (! return {result}) ]

