use creusot.int.UInt32
use creusot.int.UInt64
use seq.Seq
use int.ComputerDivision
use int.Int

type t_Vec_u64_Global

type t_AllocationBitmap = { words: t_Vec_u64_Global; num_slots: UInt32.t; allocated_count: UInt32.t }

constant const_MAX: UInt64.t = (18446744073709551615: UInt64.t)

function view_Vec_u64_Global (self: t_Vec_u64_Global) : Seq.seq UInt64.t

axiom view_Vec_u64_Global_spec:
  forall self: t_Vec_u64_Global [view_Vec_u64_Global self]. [%#svec] Seq.length (view_Vec_u64_Global self)
    <= UInt64.t'int const_MAX

predicate slot_bit [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/bitmap.rs" 33 0 33 53] (bm: t_AllocationBitmap) (i: int) =
  [%#sbitmap] UInt64.nth (Seq.get (view_Vec_u64_Global bm.words) (ComputerDivision.div i 64)) (ComputerDivision.mod i 64)

function cnt [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/bitmap.rs" 40 0 40 47] (bm: t_AllocationBitmap) (n: int) : int

axiom cnt_def: forall bm: t_AllocationBitmap, n: int [cnt bm n]. cnt bm n
    = ([%#sbitmap'1] if n <= 0 then 0 else cnt bm (n - 1) + (if slot_bit bm (n - 1) then 1 else 0))

predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
  [%#swell_founded] self >= 0 /\ self > other

meta "rewrite_def" predicate well_founded_relation_Int

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant a : t_AllocationBitmap

constant n : int

function lemma_cnt_zero [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/props/batch3.rs" 1001 0 1001 50] (a: t_AllocationBitmap) (n: int) : ()

goal vc_lemma_cnt_zero: ([%#sbatch3'0] 0 <= n)
  -> ([%#sbatch3'1] forall j: int. 0 <= j /\ j < n -> not slot_bit a j)
  -> (if n > 0 then
    (([@stop_split] [@expl:lemma_cnt_zero requires] ([@stop_split] [@expl:lemma_cnt_zero requires #0] [%#sbatch3'0] 0
          <= n - 1)
        /\ ([@stop_split] [@expl:lemma_cnt_zero requires #1] [%#sbatch3'1] forall j: int. 0 <= j /\ j < n - 1
          -> not slot_bit a j))
      /\ ([@expl:variant decreases] well_founded_relation_Int ([%#sbatch3] n) ([%#sbatch3] n - 1)))
    /\ (([@stop_split] [@expl:lemma_cnt_zero ensures] [%#sbatch3'2] cnt a (n - 1) = 0)
    -> ([@stop_split] [@expl:lemma_cnt_zero ensures] [%#sbatch3'2] cnt a n = 0))
  else
    [@stop_split] [@expl:lemma_cnt_zero ensures] [%#sbatch3'2] cnt a n = 0
  )
