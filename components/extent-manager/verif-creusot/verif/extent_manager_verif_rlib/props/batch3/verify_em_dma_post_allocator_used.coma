          /\ p < Seq.length rd.final.log -> ev_alloc_is (Seq.get rd.final.log p) (User a))
    /\ ([@stop_split] [@expl:verify_em_dma_post_allocator_used ensures #2] [%#sbatch3'15] forall p: int. Seq.length dd.current.log
          <= p
        /\ p < Seq.length dd.final.log -> ev_alloc_is (Seq.get dd.final.log p) (Default))}
    (! return {result}) ]
