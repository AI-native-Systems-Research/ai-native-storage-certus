 = [%#sbatch3'4] ()

axiom lemma_slab_unfold_spec: forall ir: t_RegionState, k: int. ([%#sbatch3'1] rg_inv ir
      /\ contains_Int (view_SlabMap ir.slabs) k)
    -> ([%#sbatch3'2] slab_inv (lookup_Int (view_SlabMap ir.slabs) k)
    /\ Seq.length (view_Vec_u64_Global (lookup_Int (view_SlabMap ir.slabs) k).keys'1)
    = UInt32.t'int (lookup_Int (view_SlabMap ir.slabs) k).bitmap'1.num_slots)

