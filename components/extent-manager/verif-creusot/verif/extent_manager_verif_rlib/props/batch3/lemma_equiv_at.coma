function lemma_equiv_at [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/props/batch3.rs" 1523 0 1523 106] (r: t_RegionState) (ir: t_RegionState) (ds: Seq.seq t_SlabDescriptor) (p: int) (j: int) (e: t_Extent) : ()

goal vc_lemma_equiv_at: ([%#sbatch3] rebuilt_all r ds /\ descs_of ir ds /\ rg_inv ir /\ 0 <= p /\ p < Seq.length ds)
  -> ([@stop_split] [@expl:lemma_slab_unfold requires] [%#sbatch3'1] rg_inv ir
    /\ contains_Int (view_SlabMap ir.slabs) (UInt64.t'int (Seq.get ds p).start_offset))
  /\ (([@stop_split] [@expl:lemma_slab_unfold ensures] [%#sbatch3'2] slab_inv (lookup_Int (view_SlabMap ir.slabs) (UInt64.t'int (Seq.get ds p).start_offset))
    /\ Seq.length (view_Vec_u64_Global (lookup_Int (view_SlabMap ir.slabs) (UInt64.t'int (Seq.get ds p).start_offset)).keys'1)
    = UInt32.t'int (lookup_Int (view_SlabMap ir.slabs) (UInt64.t'int (Seq.get ds p).start_offset)).bitmap'1.num_slots)
  -> ([@stop_split] [@expl:lemma_equiv_at ensures] [%#sbatch3'0] from_slot r (UInt64.t'int (Seq.get ds p).start_offset) j e
  = from_slot ir (UInt64.t'int (Seq.get ds p).start_offset) j e))
