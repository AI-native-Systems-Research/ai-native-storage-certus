use creusot.int.UInt64
use creusot.int.UInt32
use seq.Seq
use int.ComputerDivision
use creusot.prelude.Any
use int.Int

type t_Vec_u64_Global

type t_SlabDescriptor = { start_offset: UInt64.t; slab_size: UInt64.t; element_size: UInt32.t; keys: t_Vec_u64_Global }

type t_AllocationBitmap = { words: t_Vec_u64_Global; num_slots: UInt32.t; allocated_count: UInt32.t }

type t_Slab = {
  start_offset'0: UInt64.t;
  slab_size'0: UInt64.t;
  element_size'0: UInt32.t;
  bitmap'0: t_AllocationBitmap;
  keys'0: t_Vec_u64_Global;
  rover'0: UInt64.t }

constant const_MAX: UInt64.t = (18446744073709551615: UInt64.t)

function view_Vec_u64_Global (self: t_Vec_u64_Global) : Seq.seq UInt64.t

axiom view_Vec_u64_Global_spec:
  forall self: t_Vec_u64_Global [view_Vec_u64_Global self]. [%#svec] Seq.length (view_Vec_u64_Global self)
    <= UInt64.t'int const_MAX

function slots_of [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/slab.rs" 42 0 42 57] (slab_size'1: int) (element_size'1: int) : int
 = [%#sslab] ComputerDivision.mod (ComputerDivision.div slab_size'1 element_size'1) 4294967296

constant const_MAX'0: UInt64.t = (18446744073709551615: UInt64.t)

predicate slab_geom [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/slab.rs" 48 0 48 33] (s: t_Slab) =
  [%#sslab'3] UInt32.t'int s.element_size'0 > 0
  /\ UInt32.t'int s.bitmap'0.num_slots = slots_of (UInt64.t'int s.slab_size'0) (UInt32.t'int s.element_size'0)
  /\ UInt64.t'int s.start_offset'0 + UInt64.t'int s.slab_size'0 <= UInt64.t'int const_MAX'0

predicate slab_keys_len [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/slab.rs" 58 0 58 37] (s: t_Slab) =
  [%#sslab'4] Seq.length (view_Vec_u64_Global s.keys'0) = UInt32.t'int s.bitmap'0.num_slots

predicate slab_rover [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/slab.rs" 64 0 64 34] (s: t_Slab) =
  [%#sslab'5] UInt64.t'int s.rover'0 < UInt32.t'int s.bitmap'0.num_slots
  \/ UInt32.t'int s.bitmap'0.num_slots = 0 /\ UInt64.t'int s.rover'0 = 0

predicate bm_wf [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/bitmap.rs" 27 0 27 42] (bm: t_AllocationBitmap) =
  [%#sbitmap'1] Seq.length (view_Vec_u64_Global bm.words) = ComputerDivision.div (UInt32.t'int bm.num_slots + 63) 64

predicate slot_bit [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/bitmap.rs" 33 0 33 53] (bm: t_AllocationBitmap) (i: int) =
  [%#sbitmap] UInt64.nth (Seq.get (view_Vec_u64_Global bm.words) (ComputerDivision.div i 64)) (ComputerDivision.mod i 64)

function cnt [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/bitmap.rs" 40 0 40 47] (bm: t_AllocationBitmap) (n: int) : int

axiom cnt_def: forall bm: t_AllocationBitmap, n: int [cnt bm n]. cnt bm n
    = ([%#sbitmap'4] if n <= 0 then 0 else cnt bm (n - 1) + (if slot_bit bm (n - 1) then 1 else 0))

predicate bm_count_ok [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/bitmap.rs" 46 0 46 48] (bm: t_AllocationBitmap) =
  [%#sbitmap'2] UInt32.t'int bm.allocated_count = cnt bm (UInt32.t'int bm.num_slots)

predicate bm_inv [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/bitmap.rs" 52 0 52 43] (bm: t_AllocationBitmap) =
  [%#sbitmap'0] bm_wf bm /\ bm_count_ok bm

predicate slab_inv [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/slab.rs" 70 0 70 32] (s: t_Slab) =
  [%#sslab'0] slab_geom s /\ slab_keys_len s /\ slab_rover s /\ bm_inv s.bitmap'0

constant const_FREE_KEY: UInt64.t = [%#sslab'2] (18446744073709551615: UInt64.t)

predicate key_alloc [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/slab.rs" 76 0 76 33] (s: t_Slab) =
  [%#sslab'1] forall i: int. 0 <= i
      /\ i < UInt32.t'int s.bitmap'0.num_slots /\ Seq.get (view_Vec_u64_Global s.keys'0) i <> const_FREE_KEY
    -> slot_bit s.bitmap'0 i

let slab_from_descriptor (desc: t_SlabDescriptor) (return (x: t_Slab)) =
{[@stop_split] [@expl:slab_from_descriptor requires] ([@stop_split] [@expl:slab_from_descriptor requires #0] [%#sregion] UInt32.t'int desc.element_size
    > 0)
  /\ ([@stop_split] [@expl:slab_from_descriptor requires #1] [%#sregion'0] Seq.length (view_Vec_u64_Global desc.keys)
    = slots_of (UInt64.t'int desc.slab_size) (UInt32.t'int desc.element_size))
  /\ ([@stop_split] [@expl:slab_from_descriptor requires #2] [%#sregion'1] UInt64.t'int desc.start_offset
    + UInt64.t'int desc.slab_size
  <= UInt64.t'int const_MAX'0)}
  any
  [ return (result: t_Slab) ->
  {[@stop_split] [@expl:slab_from_descriptor ensures] ([@stop_split] [@expl:slab_from_descriptor ensures #0] [%#sregion'2] slab_inv result
      /\ key_alloc result)
    /\ ([@stop_split] [@expl:slab_from_descriptor ensures #1] [%#sregion'3] result.start_offset'0 = desc.start_offset
      /\ result.slab_size'0 = desc.slab_size)
    /\ ([@stop_split] [@expl:slab_from_descriptor ensures #2] [%#sregion'4] result.element_size'0 = desc.element_size
      /\ view_Vec_u64_Global result.keys'0 = view_Vec_u64_Global desc.keys /\ UInt64.t'int result.rover'0 = 0)
    /\ ([@stop_split] [@expl:slab_from_descriptor ensures #3] [%#sregion'5] forall i: int. 0 <= i
        /\ i < UInt32.t'int result.bitmap'0.num_slots
      -> slot_bit result.bitmap'0 i = (Seq.get (view_Vec_u64_Global desc.keys) i <> const_FREE_KEY))}
    (! return {result}) ]

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let verify_em_recover_slab_from_descriptor__mutant [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/props/batch3.rs" 61 0 61 84]
  (desc: t_SlabDescriptor) (return (x: t_Slab)) =
{[@stop_split] [@expl:verify_em_recover_slab_from_descriptor__mutant requires] ([@stop_split] [@expl:verify_em_recover_slab_from_descriptor__mutant requires #0] [%#sbatch3'0] UInt32.t'int desc.element_size
    > 0)
  /\ ([@stop_split] [@expl:verify_em_recover_slab_from_descriptor__mutant requires #1] [%#sbatch3'1] Seq.length (view_Vec_u64_Global desc.keys)
    = slots_of (UInt64.t'int desc.slab_size) (UInt32.t'int desc.element_size))
  /\ ([@stop_split] [@expl:verify_em_recover_slab_from_descriptor__mutant requires #2] [%#sbatch3'2] UInt64.t'int desc.start_offset
      + UInt64.t'int desc.slab_size
    <= UInt64.t'int const_MAX'0)
  /\ ([@stop_split] [@expl:verify_em_recover_slab_from_descriptor__mutant requires #3] [%#sbatch3'3] Seq.length (view_Vec_u64_Global desc.keys)
  > 0)}
  (! bb0
  [ bb0 = s0
    [ s0 = slab_from_descriptor [%#sbatch3] {desc} (fun (_x: t_Slab) -> [ &_ret <- _x ] s1) | s1 = return {_ret} ] ]
  [ & _ret: t_Slab = Any.any_l () | & desc: t_SlabDescriptor = desc ])
  [ return (result: t_Slab) ->
  {[@stop_split] [@expl:verify_em_recover_slab_from_descriptor__mutant ensures] [%#sbatch3'4] slot_bit result.bitmap'0 0}
    (! return {result}) ]
