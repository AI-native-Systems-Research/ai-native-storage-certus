use int.ComputerDivision
use int.Int

function lemma_divmod [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/buddy.rs" 184 0 184 35] (x: int) (m: int) : ()

axiom lemma_divmod_spec: forall x: int, m: int. ([%#sbuddy] m > 0 /\ x >= 0)
    -> ([%#sbuddy'0] x = m * ComputerDivision.div x m + ComputerDivision.mod x m)

axiom lemma_divmod_spec'0: forall x: int, m: int. ([%#sbuddy] m > 0 /\ x >= 0)
    -> ([%#sbuddy'1] 0 <= ComputerDivision.mod x m /\ ComputerDivision.mod x m < m)

axiom lemma_divmod_spec'1: forall x: int, m: int. ([%#sbuddy] m > 0 /\ x >= 0)
    -> ([%#sbuddy'2] ComputerDivision.div x m >= 0)

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant x : int

constant s : int

function lemma_small_half [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/props/batch6.rs" 435 0 435 39] (x: int) (s: int) : ()

goal vc_lemma_small_half: ([%#sbatch6] s > 0 /\ 0 <= x /\ x < 2 * s)
  -> ([@stop_split] [@expl:lemma_divmod requires] [%#sbuddy] 2 > 0 /\ x >= 0)
  /\ (([@stop_split] [@expl:lemma_divmod ensures] ([@stop_split] [@expl:lemma_divmod ensures #0] [%#sbuddy'0] x
      = 2 * ComputerDivision.div x 2 + ComputerDivision.mod x 2)
    /\ ([@stop_split] [@expl:lemma_divmod ensures #1] [%#sbuddy'1] 0 <= ComputerDivision.mod x 2
      /\ ComputerDivision.mod x 2 < 2)
    /\ ([@stop_split] [@expl:lemma_divmod ensures #2] [%#sbuddy'2] ComputerDivision.div x 2 >= 0))
  -> (let _ = lemma_divmod x 2 in ([@stop_split] [@expl:lemma_divmod requires] [%#sbuddy] s > 0
    /\ ComputerDivision.div x 2 >= 0)
  /\ (([@stop_split] [@expl:lemma_divmod ensures] ([@stop_split] [@expl:lemma_divmod ensures #0] [%#sbuddy'0] ComputerDivision.div x 2
      = s * ComputerDivision.div (ComputerDivision.div x 2) s + ComputerDivision.mod (ComputerDivision.div x 2) s)
    /\ ([@stop_split] [@expl:lemma_divmod ensures #1] [%#sbuddy'1] 0
        <= ComputerDivision.mod (ComputerDivision.div x 2) s
      /\ ComputerDivision.mod (ComputerDivision.div x 2) s < s)
    /\ ([@stop_split] [@expl:lemma_divmod ensures #2] [%#sbuddy'2] ComputerDivision.div (ComputerDivision.div x 2) s
    >= 0))
  -> ([@stop_split] [@expl:lemma_small_half ensures] [%#sbatch6'0] ComputerDivision.div (ComputerDivision.div x 2) s * s
  = 0))))
