let run6 (self: MutBorrow.t t_Ck6) (io: t_Io6) (plen: UInt64.t) (return (x: t_Result_unit_EmError)) =
{[@stop_split] [@expl:run6 requires] [%#sb6'1] match self.current.regions with
    | Some rs -> any_dirty6 (view_Vec_bool_Global rs) /\ io.client -> ck6_hd self.current (UInt64.t'int plen)
    | None -> true
    end}
  any
  [ return (result: t_Result_unit_EmError) ->
  {[@stop_split] [@expl:run6 ensures] ([@stop_split] [@expl:run6 ensures #0] [%#sb6'2] self.current.regions = None
      -> result = Err (NotInitialized) /\ self.final = self.current)
    /\ ([@stop_split] [@expl:run6 ensures #1] [%#sb6'3] match self.current.regions with
        | Some rs -> not any_dirty6 (view_Vec_bool_Global rs) -> result = Ok () /\ self.final = self.current
        | None -> true
        end)
    /\ ([@stop_split] [@expl:run6 ensures #2] [%#sb6'4] match self.current.regions with
        | Some rs -> any_dirty6 (view_Vec_bool_Global rs) /\ not io.client
        -> result = Err (IoError) /\ self.final = self.current
        | None -> true
        end)
    /\ ([@stop_split] [@expl:run6 ensures #3] [%#sb6'5] match self.current.regions with
        | Some rs -> any_dirty6 (view_Vec_bool_Global rs)
          /\ io.client /\ 16 + UInt64.t'int plen > UInt64.t'int self.current.ck_size
        -> result = Err (CorruptMetadata) /\ self.final = self.current
        | None -> true
        end)
    /\ ([@stop_split] [@expl:run6 ensures #4] [%#sb6'6] match self.current.regions with
        | Some rs -> any_dirty6 (view_Vec_bool_Global rs)
          /\ io.client /\ 16 + UInt64.t'int plen <= UInt64.t'int self.current.ck_size
        -> self.final.log = Seq.(++) self.current.log (ck_evs self.current (UInt64.t'int plen) io)
        /\ (result = Ok ()) = io_ok io self.current.vwc
        /\ (result <> Ok () -> result = Err (IoError))
        /\ (io_data_ok io self.current.vwc
          -> UInt8.t'int self.final.active = 1 - UInt8.t'int self.current.active
          /\ UInt64.t'int self.final.seq = UInt64.t'int self.current.seq + 1)
        /\ (not io_data_ok io self.current.vwc
          -> self.final.active = self.current.active /\ self.final.seq = self.current.seq)
        /\ (io_ok io self.current.vwc
          -> match self.final.regions with
            | Some rs2 -> Seq.length (view_Vec_bool_Global rs2) = Seq.length (view_Vec_bool_Global rs)
            /\ not any_dirty6 (view_Vec_bool_Global rs2)
