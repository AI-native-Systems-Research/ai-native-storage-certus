        -> self.final.log = Seq.(++) self.current.log (ck_evs self.current (UInt64.t'int plen) io)
        /\ (result = Ok ()) = io_ok io self.current.vwc
        /\ (result <> Ok () -> result = Err (IoError))
        /\ (io_data_ok io self.current.vwc
          -> UInt8.t'int self.final.active = 1 - UInt8.t'int self.current.active
          /\ UInt64.t'int self.final.seq = UInt64.t'int self.current.seq + 1)
        /\ (not io_data_ok io self.current.vwc
          -> self.final.active = self.current.active /\ self.final.seq = self.current.seq)
        /\ (io_ok io self.current.vwc
          -> match self.final.regions with
