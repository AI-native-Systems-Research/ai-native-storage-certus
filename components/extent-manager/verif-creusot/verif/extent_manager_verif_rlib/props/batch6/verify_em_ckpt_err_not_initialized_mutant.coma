        /\ (not io_ok io self.current.vwc -> self.final.regions = self.current.regions)
        | None -> true
        end)
    /\ ([@stop_split] [@expl:run6 ensures #5] [%#sb6'5] self.final.ck_off = self.current.ck_off
      /\ self.final.ck_size = self.current.ck_size /\ self.final.ms = self.current.ms)
    /\ ([@stop_split] [@expl:run6 ensures #6] [%#sb6'6] self.final.hook = self.current.hook
      /\ self.final.vwc = self.current.vwc)
    /\ ([@stop_split] [@expl:run6 ensures #7] [%#sb6'7] (self.final.regions = None) = (self.current.regions = None))}
