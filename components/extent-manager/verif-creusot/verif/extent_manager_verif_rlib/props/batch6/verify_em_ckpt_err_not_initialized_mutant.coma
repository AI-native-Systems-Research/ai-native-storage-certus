      -> result = Err (NotInitialized) /\ self.final = self.current)
    /\ ([@stop_split] [@expl:run6 ensures #1] [%#sb6'1] match self.current.regions with
        | Some rs -> not any_dirty6 (view_Vec_bool_Global rs) -> result = Ok () /\ self.final = self.current
