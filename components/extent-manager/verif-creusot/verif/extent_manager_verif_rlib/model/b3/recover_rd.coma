type t_RdOut = DevErr | Bad | Good UInt64.t

type t_Result_unit_EmError = Ok'0 () | Err'0 t_EmError

let read_ckpt (o: t_RdOut) (expected: UInt64.t) (return (x: t_Result_unit_EmError)) = any
