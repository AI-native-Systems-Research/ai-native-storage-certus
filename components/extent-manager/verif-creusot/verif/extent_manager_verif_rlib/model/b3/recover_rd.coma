      | DevErr -> result = Err'0 (IoError)
      | Bad -> result = Err'0 (CorruptMetadata)
      | Good s -> if s = expected then result = Ok'0 () else result = Err'0 (CorruptMetadata)
      end}
    (! return {result}) ]

let elim_Err (_x: t_Result_unit_EmError) (return (f0: t_EmError)) = any
  [ _k (f0: t_EmError) -> {Err'0 f0 = _x} (! return {f0})
  | _chk -> (! {[@expl:elim Err] match _x with
