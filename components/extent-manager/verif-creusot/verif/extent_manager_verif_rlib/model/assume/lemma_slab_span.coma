function lemma_slab_span [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/assume.rs" 296 0 296 42] (slab: int) (ss: int) : ()

goal vc_lemma_slab_span: ([%#sassume] a_7cb7c3 slab ss
    /\ 0 <= slab /\ t_u32 ss /\ ComputerDivision.mod slab ss = 0 /\ slab <= UInt64.t'int const_MAX'0)
  -> ([@stop_split] [@expl:lemma_7cb7c3_pos requires] [%#sassume'1] a_7cb7c3 slab ss /\ 0 <= slab /\ 0 <= ss)
  /\ (([@stop_split] [@expl:lemma_7cb7c3_pos ensures] [%#sassume'2] ss > 0 /\ slab >= ss /\ slab > 0)
  -> (let _ = lemma_7cb7c3_pos slab ss in ([@stop_split] [@expl:lemma_divmod requires] [%#sbuddy] ss > 0 /\ slab >= 0)
  /\ (([@stop_split] [@expl:lemma_divmod ensures] ([@stop_split] [@expl:lemma_divmod ensures #0] [%#sbuddy'0] slab
      = ss * ComputerDivision.div slab ss + ComputerDivision.mod slab ss)
    /\ ([@stop_split] [@expl:lemma_divmod ensures #1] [%#sbuddy'1] 0 <= ComputerDivision.mod slab ss
      /\ ComputerDivision.mod slab ss < ss)
    /\ ([@stop_split] [@expl:lemma_divmod ensures #2] [%#sbuddy'2] ComputerDivision.div slab ss >= 0))
  -> (let _ = lemma_divmod slab ss in ([@stop_split] [@expl:lemma_div_le_self requires] [%#sassume'3] ss >= 1
    /\ slab >= 0)
  /\ (([@stop_split] [@expl:lemma_div_le_self ensures] [%#sassume'4] ComputerDivision.div slab ss <= slab)
  -> (let _ = lemma_div_le_self slab ss in ([@stop_split] [@expl:lemma_ord_p2 requires] [%#sassume'5] p2 (ComputerDivision.div slab ss)
    /\ ComputerDivision.div slab ss <= 18446744073709551616)
  /\ (([@stop_split] [@expl:lemma_ord_p2 ensures] [%#sassume'6] Pow2int.pow2 (ord (ComputerDivision.div slab ss))
    = ComputerDivision.div slab ss)
  -> ([@stop_split] [@expl:lemma_slab_span ensures] [%#sassume'0] span ss (ord (ComputerDivision.div slab ss))
  = slab))))))))
