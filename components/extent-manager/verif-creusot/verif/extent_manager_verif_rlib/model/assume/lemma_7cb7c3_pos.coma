goal vc_lemma_7cb7c3_pos: ([%#sassume] a_7cb7c3 slab ss /\ 0 <= slab /\ 0 <= ss)
  -> ([@stop_split] [@expl:lemma_p2_pos requires] [%#sassume'1] p2 (ComputerDivision.div slab ss))
  /\ (([@stop_split] [@expl:lemma_p2_pos ensures] [%#sassume'2] ComputerDivision.div slab ss >= 1)
  -> (let _ = lemma_p2_pos (ComputerDivision.div slab ss) in ([@stop_split] [@expl:lemma_divmod requires] [%#sbuddy] ss
      > 0
    /\ slab >= 0)
  /\ (([@stop_split] [@expl:lemma_divmod ensures] ([@stop_split] [@expl:lemma_divmod ensures #0] [%#sbuddy'0] slab
      = ss * ComputerDivision.div slab ss + ComputerDivision.mod slab ss)
