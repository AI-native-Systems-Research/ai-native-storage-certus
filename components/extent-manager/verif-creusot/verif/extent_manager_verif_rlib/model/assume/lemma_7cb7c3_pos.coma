      /\ ComputerDivision.mod slab ss < ss)
    /\ ([@stop_split] [@expl:lemma_divmod ensures #2] [%#sbuddy'2] ComputerDivision.div slab ss >= 0))
  -> (let _ = lemma_divmod slab ss in ([@stop_split] [@expl:lemma_mul_le requires] [%#sbuddy'3] 0 <= 1
    /\ 1 <= ComputerDivision.div slab ss /\ 0 <= ss)
  /\ (([@stop_split] [@expl:lemma_mul_le ensures] [%#sbuddy'4] 1 * ss <= ComputerDivision.div slab ss * ss)
  -> ([@stop_split] [@expl:lemma_7cb7c3_pos ensures] [%#sassume'0] ss > 0 /\ slab >= ss /\ slab > 0))))))
