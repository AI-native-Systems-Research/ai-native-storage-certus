constant x : int

function lemma_p2_pos [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/assume.rs" 227 0 227 27] (x: int) : ()

goal vc_lemma_p2_pos: ([%#sassume] p2 x)
  -> (forall k: int. if 0 <= k then
        if Pow2int.pow2 k = x then
          ([@stop_split] [@expl:lemma_pow2 requires] [%#sbuddy] 0 <= k)
          /\ (([@stop_split] [@expl:lemma_pow2 ensures] ([@stop_split] [@expl:lemma_pow2 ensures #0] [%#sbuddy'0] Pow2int.pow2 k
              >= 1)
            /\ ([@stop_split] [@expl:lemma_pow2 ensures #1] [%#sbuddy'1] Pow2int.pow2 (k + 1) = 2 * Pow2int.pow2 k))
          -> (let _ = lemma_pow2 k in true))
        else
          true
      
      else
        true
    )
  /\ (forall k: int. 0 <= k /\ Pow2int.pow2 k = x -> (let _ = lemma_pow2 k in x >= 1))
  && ([@stop_split] [@expl:lemma_p2_pos ensures] [%#sassume'0] x >= 1)
