goal vc_lemma_cap_mono: ([%#scomponent'0] 0 <= m /\ m <= n /\ n <= Seq.length rv)
  -> (if m < n then
    (([@stop_split] [@expl:lemma_cap_mono requires] [%#scomponent'0] 0 <= m /\ m <= n - 1 /\ n - 1 <= Seq.length rv)
      /\ ([@expl:variant decreases] well_founded_relation_Int ([%#scomponent] n - m) ([%#scomponent] n - 1 - m)))
    /\ (([@stop_split] [@expl:lemma_cap_mono ensures] [%#scomponent'1] cap_sum arena rv m <= cap_sum arena rv (n - 1))
    -> ([@stop_split] [@expl:lemma_cap_mono ensures] [%#scomponent'1] cap_sum arena rv m <= cap_sum arena rv n))
  else
    [@stop_split] [@expl:lemma_cap_mono ensures] [%#scomponent'1] cap_sum arena rv m <= cap_sum arena rv n
  )
