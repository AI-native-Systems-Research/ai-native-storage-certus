function cap_sum [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/component.rs" 180 0 180 70] (arena: Seq.seq t_RegionState) (rv: Seq.seq UInt64.t) (n: int) : int

axiom cap_sum_def:
  forall arena: Seq.seq t_RegionState, rv: Seq.seq UInt64.t, n: int [cap_sum arena rv n]. cap_sum arena rv n
    = ([%#scomponent'4] if n <= 0 then
      0
    else
      cap_sum arena rv (n - 1)
      + UInt64.t'int (Seq.get arena (UInt64.t'int (Seq.get rv (n - 1)))).buddy.total_usable_size
    )

predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
  [%#swell_founded] self >= 0 /\ self > other

meta "rewrite_def" predicate well_founded_relation_Int

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant a : Seq.seq t_RegionState

constant b : Seq.seq t_RegionState

constant rv : Seq.seq UInt64.t

constant n : int

function lemma_cap_frame [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/component.rs" 190 0 190 88] (a: Seq.seq t_RegionState) (b: Seq.seq t_RegionState) (rv: Seq.seq UInt64.t) (n: int) : ()

goal vc_lemma_cap_frame: ([%#scomponent'0] 0 <= n /\ n <= Seq.length rv)
  -> ([%#scomponent'1] forall i: int. 0 <= i /\ i < Seq.length rv
      -> (Seq.get a (UInt64.t'int (Seq.get rv i))).buddy.total_usable_size
      = (Seq.get b (UInt64.t'int (Seq.get rv i))).buddy.total_usable_size)
  -> (if n > 0 then
    (([@stop_split] [@expl:lemma_cap_frame requires] ([@stop_split] [@expl:lemma_cap_frame requires #0] [%#scomponent'0] 0
            <= n - 1
          /\ n - 1 <= Seq.length rv)
        /\ ([@stop_split] [@expl:lemma_cap_frame requires #1] [%#scomponent'1] forall i: int. 0 <= i
            /\ i < Seq.length rv
          -> (Seq.get a (UInt64.t'int (Seq.get rv i))).buddy.total_usable_size
          = (Seq.get b (UInt64.t'int (Seq.get rv i))).buddy.total_usable_size))
      /\ ([@expl:variant decreases] well_founded_relation_Int ([%#scomponent] n) ([%#scomponent] n - 1)))
    /\ (([@stop_split] [@expl:lemma_cap_frame ensures] [%#scomponent'2] cap_sum a rv (n - 1) = cap_sum b rv (n - 1))
    -> ([@stop_split] [@expl:lemma_cap_frame ensures] [%#scomponent'2] cap_sum a rv n = cap_sum b rv n))
  else
    [@stop_split] [@expl:lemma_cap_frame ensures] [%#scomponent'2] cap_sum a rv n = cap_sum b rv n
  )
