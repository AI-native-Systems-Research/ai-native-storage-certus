use creusot.int.UInt64
use creusot.int.UInt32
use seq.Seq
use int.Int

type t_BTreeMap_u64_Slab_Global

type t_SlabMap = { inner: t_BTreeMap_u64_Slab_Global }

type t_HashMap_u32_Vec_u64_Global_RandomState_Global

type t_SizeClassManager = { map: t_HashMap_u32_Vec_u64_Global_RandomState_Global }

type t_Vec_Vec_u64_Global_Global

type t_BuddyAllocator = {
  base_offset: UInt64.t;
  total_usable_size: UInt64.t;
  sector_size: UInt32.t;
  max_order: UInt64.t;
  free_lists: t_Vec_Vec_u64_Global_Global }

type t_Option_u64 = None | Some UInt64.t

type t_FormatParams = {
  data_disk_size'0: UInt64.t;
  slab_size'0: UInt64.t;
  max_extent_size'0: UInt32.t;
  sector_size'0: UInt32.t;
  region_count'0: UInt32.t;
  metadata_alignment'0: UInt64.t;
  instance_id'0: t_Option_u64;
  metadata_disk_ns_id'0: UInt32.t;
  metadata_region_size'0: UInt64.t }

type t_Vec_tup2_u64_usize_Global

type t_RegionState = {
  slabs: t_SlabMap;
  size_classes: t_SizeClassManager;
  buddy: t_BuddyAllocator;
  dirty: bool;
  format_params: t_FormatParams;
  pending_frees: t_Vec_tup2_u64_usize_Global }

predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
  [%#swell_founded] self >= 0 /\ self > other

meta "rewrite_def" predicate well_founded_relation_Int

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant arena : Seq.seq t_RegionState

constant rv : Seq.seq UInt64.t

constant n : int

function cap_sum [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/component.rs" 180 0 180 70] (arena: Seq.seq t_RegionState) (rv: Seq.seq UInt64.t) (n: int) : int

goal vc_cap_sum: if n <= 0 then
    true
  else
    [@expl:variant decreases] well_founded_relation_Int ([%#scomponent] n) ([%#scomponent] n - 1)
  
