use creusot.int.UInt64
use creusot.prelude.Any
use int.Int

type t_Ordering = Less | Equal | Greater

function cmp_log_usize (self: UInt64.t) (o: UInt64.t) : t_Ordering = [%#sord'12] if UInt64.lt self o then
    Less
  else
    if self = o then Equal else Greater


function eq_cmp_usize (x: UInt64.t) (y: UInt64.t) : ()

axiom eq_cmp_usize_spec: forall x: UInt64.t, y: UInt64.t. [%#sord'11] (x = y) = (cmp_log_usize x y = Equal)

function antisym2_usize (x: UInt64.t) (y: UInt64.t) : ()

axiom antisym2_usize_spec: forall x: UInt64.t, y: UInt64.t. ([%#sord'9] cmp_log_usize x y = Greater)
    -> ([%#sord'10] cmp_log_usize y x = Less)

function antisym1_usize (x: UInt64.t) (y: UInt64.t) : ()

axiom antisym1_usize_spec: forall x: UInt64.t, y: UInt64.t. ([%#sord'7] cmp_log_usize x y = Less)
    -> ([%#sord'8] cmp_log_usize y x = Greater)

function trans_usize (x: UInt64.t) (y: UInt64.t) (z: UInt64.t) (o: t_Ordering) : ()

axiom trans_usize_spec: forall x: UInt64.t, y: UInt64.t, z: UInt64.t, o: t_Ordering. ([%#sord'4] cmp_log_usize x y = o)
    -> ([%#sord'5] cmp_log_usize y z = o) -> ([%#sord'6] cmp_log_usize x z = o)

function refl_usize (x: UInt64.t) : ()

axiom refl_usize_spec: forall x: UInt64.t. [%#sord'3] cmp_log_usize x x = Equal

function cmp_gt_log_usize (x: UInt64.t) (y: UInt64.t) : ()

axiom cmp_gt_log_usize_spec: forall x: UInt64.t, y: UInt64.t. [%#sord'2] UInt64.gt x y = (cmp_log_usize x y = Greater)

function cmp_ge_log_usize (x: UInt64.t) (y: UInt64.t) : ()

axiom cmp_ge_log_usize_spec: forall x: UInt64.t, y: UInt64.t. [%#sord'1] UInt64.ge x y = (cmp_log_usize x y <> Less)

function cmp_lt_log_usize (x: UInt64.t) (y: UInt64.t) : ()

axiom cmp_lt_log_usize_spec: forall x: UInt64.t, y: UInt64.t. [%#sord'0] UInt64.lt x y = (cmp_log_usize x y = Less)

function cmp_le_log_usize (x: UInt64.t) (y: UInt64.t) : ()

axiom cmp_le_log_usize_spec: forall x: UInt64.t, y: UInt64.t. [%#sord] UInt64.le x y = (cmp_log_usize x y <> Greater)

let and_mask_bv (x: UInt64.t) (m: UInt64.t) (return (x'0: UInt64.t)) = any
  [ return (result: UInt64.t) ->
  {[@stop_split] [@expl:and_mask_bv ensures] ([@stop_split] [@expl:and_mask_bv ensures #0] [%#scomponent'2] UInt64.le result m)
    /\ ([@stop_split] [@expl:and_mask_bv ensures #1] [%#scomponent'3] result = UInt64.bw_and x m)}
    (! return {result}) ]

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let and_mask [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/component.rs" 206 0 206 44]
  (x: UInt64.t) (m: UInt64.t) (return (x'0: UInt64.t)) = (! bb0
  [ bb0 = s0
    [ s0 = and_mask_bv [%#scomponent] {x} {m} (fun (_x: UInt64.t) -> [ &_ret <- _x ] s1) | s1 = return {_ret} ] ]
  [ & _ret: UInt64.t = Any.any_l () | & x: UInt64.t = x | & m: UInt64.t = m ])
  [ return (result: UInt64.t) ->
  {[@stop_split] [@expl:and_mask ensures] ([@stop_split] [@expl:and_mask ensures #0] [%#scomponent'0] UInt64.t'int result
      <= UInt64.t'int m)
    /\ ([@stop_split] [@expl:and_mask ensures #1] [%#scomponent'1] result = UInt64.bw_and x m)}
    (! return {result}) ]
