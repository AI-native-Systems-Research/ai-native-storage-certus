use creusot.int.UInt64
use creusot.int.UInt32
use seq.Seq
use int.Int

type t_Extent = { key: UInt64.t; size: UInt32.t; offset: UInt64.t }

predicate in_from [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/listing.rs" 65 0 65 58] (s: Seq.seq t_Extent) (lo: int) (e: t_Extent) =
  [%#slisting'1] exists p: int. lo <= p /\ p < Seq.length s /\ Seq.get s p = e

