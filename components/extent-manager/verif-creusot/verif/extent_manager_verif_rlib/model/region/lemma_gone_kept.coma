function lemma_gone_kept [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/region.rs" 799 0 799 100] (a: t_RegionState) (b: t_RegionState) (s: UInt64.t) (i: UInt64.t) (sl: t_Slab) (t: UInt64.t) (j: UInt64.t) : ()

goal vc_lemma_gone_kept: ([%#sregion] free_case a b s i sl
    /\ get_Int (view_SlabMap a.slabs) (UInt64.t'int s) = Some'0 sl)
  -> ([%#sregion'0] slot_gone a t j)
  -> ([%#sregion'1] contains_Int (view_SlabMap a.slabs) (UInt64.t'int t)
    -> UInt64.t'int j < UInt32.t'int (lookup_Int (view_SlabMap a.slabs) (UInt64.t'int t)).bitmap.num_slots)
  -> (if UInt32.t'int sl.bitmap.allocated_count = 1 then
    ([@stop_split] [@expl:remove ensures] ([@stop_split] [@expl:remove ensures #0] [%#sfmap] to_mapping_Int (remove_Int (view_SlabMap a.slabs) (UInt64.t'int s))
        = Map.set (to_mapping_Int (view_SlabMap a.slabs)) (UInt64.t'int s) (None'0))
      /\ ([@stop_split] [@expl:remove ensures #1] [%#sfmap'0] len_Int (remove_Int (view_SlabMap a.slabs) (UInt64.t'int s))
      = (if contains_Int (view_SlabMap a.slabs) (UInt64.t'int s) then
        len_Int (view_SlabMap a.slabs) - 1
      else
        len_Int (view_SlabMap a.slabs)
      )))
    -> view_SlabMap b.slabs = remove_Int (view_SlabMap a.slabs) (UInt64.t'int s)
    && ([@stop_split] [@expl:lemma_gone_kept ensures] [%#sregion'2] slot_gone b t j)
  else
    ([@stop_split] [@expl:insert ensures] ([@stop_split] [@expl:insert ensures #0] [%#sfmap'1] to_mapping_Int (insert_Int (view_SlabMap a.slabs) (UInt64.t'int s) (lookup_Int (view_SlabMap b.slabs) (UInt64.t'int s)))
        = Map.set (to_mapping_Int (view_SlabMap a.slabs)) (UInt64.t'int s) (Some'0 (lookup_Int (view_SlabMap b.slabs) (UInt64.t'int s))))
      /\ ([@stop_split] [@expl:insert ensures #1] [%#sfmap'2] len_Int (insert_Int (view_SlabMap a.slabs) (UInt64.t'int s) (lookup_Int (view_SlabMap b.slabs) (UInt64.t'int s)))
      = (if contains_Int (view_SlabMap a.slabs) (UInt64.t'int s) then
        len_Int (view_SlabMap a.slabs)
      else
        len_Int (view_SlabMap a.slabs) + 1
      )))
    -> view_SlabMap b.slabs
      = insert_Int (view_SlabMap a.slabs) (UInt64.t'int s) (lookup_Int (view_SlabMap b.slabs) (UInt64.t'int s))
    && (if UInt64.t'int t = UInt64.t'int s then
      if UInt64.t'int j = UInt64.t'int i then
        [@stop_split] [@expl:lemma_gone_kept ensures] [%#sregion'2] slot_gone b t j
      else
        lookup_Int (view_SlabMap a.slabs) (UInt64.t'int s) = sl
        && ([@stop_split] [@expl:lemma_gone_kept ensures] [%#sregion'2] slot_gone b t j)
    
    else
      [@stop_split] [@expl:lemma_gone_kept ensures] [%#sregion'2] slot_gone b t j
    )
  )
