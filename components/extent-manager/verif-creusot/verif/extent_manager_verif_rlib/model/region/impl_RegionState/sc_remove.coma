function filter_ne [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/slab.rs" 302 0 302 49] (s: Seq.seq UInt64.t) (x: UInt64.t) : Seq.seq UInt64.t

axiom filter_ne_def: forall s: Seq.seq UInt64.t, x: UInt64.t [filter_ne s x]. filter_ne s x
    = ([%#sslab'3] if Seq.length s = 0 then
      Seq.empty: Seq.seq UInt64.t
    else
      if Seq.get s (Seq.length s - 1) = x then
        filter_ne (Seq.([..]) s 0 (Seq.length s - 1)) x
      else
        Seq.snoc (filter_ne (Seq.([..]) s 0 (Seq.length s - 1)) x) (Seq.get s (Seq.length s - 1))
    
    )

let remove_slab (self: MutBorrow.t t_SizeClassManager) (element_size: UInt32.t) (start_offset: UInt64.t)
  (return (x: ())) =
{[@stop_split] [@expl:remove_slab 'self' type invariant] [%#sslab] inv_refmut_SizeClassManager self}
  any
  [ return (result: ()) -> {[@stop_split] [@expl:remove_slab ensures] [%#sslab'0] forall e: int. sc_get self.final e
      = (if e = UInt32.t'int element_size then
        filter_ne (sc_get self.current e) start_offset
      else
        sc_get self.current e
      )}
    (! return {result}) ]

