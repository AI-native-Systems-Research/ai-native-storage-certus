predicate inv_BTreeMap_u64_Slab_Global (_1: t_BTreeMap_u64_Slab_Global)

predicate inv_SlabMap (_1: t_SlabMap)

axiom inv_axiom [@rewrite]: forall x: t_SlabMap [inv_SlabMap x]. inv_SlabMap x = inv_BTreeMap_u64_Slab_Global x.inner

predicate invariant_ref_SlabMap [@inline:trivial] (self: t_SlabMap) = [%#sinvariant'0] inv_SlabMap self

meta "rewrite_def" predicate invariant_ref_SlabMap

predicate inv_ref_SlabMap [@inline:trivial] (_1: t_SlabMap) = invariant_ref_SlabMap _1

meta "rewrite_def" predicate inv_ref_SlabMap

type t_FMap_Int_Slab

type t_Vec_u64_Global

type t_AllocationBitmap = { words: t_Vec_u64_Global; num_slots: UInt32.t; allocated_count: UInt32.t }

type t_Slab = {
  start_offset: UInt64.t;
  slab_size: UInt64.t;
  element_size: UInt32.t;
  bitmap: t_AllocationBitmap;
  keys: t_Vec_u64_Global;
