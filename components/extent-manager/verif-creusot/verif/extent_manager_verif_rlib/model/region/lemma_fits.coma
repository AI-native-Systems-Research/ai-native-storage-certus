use int.ComputerDivision
use bv.Pow2int
use int.Int

function span [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/buddy.rs" 32 0 32 35] (ss: int) (o: int) : int
 = [%#sbuddy'8] Pow2int.pow2 o * ss

function ord_from [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/buddy.rs" 284 0 284 38] (b: int) (k: int) : int

axiom ord_from_def: forall b: int, k: int [ord_from b k]. ord_from b k
    = ([%#sbuddy'11] if k >= 64 \/ k < 0 \/ Pow2int.pow2 k >= b then k else ord_from b (k + 1))

function ord [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/buddy.rs" 290 0 290 25] (b: int) : int
 = [%#sbuddy'9] ord_from b 0

function lemma_ord_ge [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/buddy.rs" 324 0 324 27] (b: int) : ()

axiom lemma_ord_ge_spec: forall b: int. ([%#sbuddy] 0 <= b /\ b <= 18446744073709551616)
    -> ([%#sbuddy'0] Pow2int.pow2 (ord b) >= b)

axiom lemma_ord_ge_spec'0: forall b: int. ([%#sbuddy] 0 <= b /\ b <= 18446744073709551616)
    -> ([%#sbuddy'1] 0 <= ord b /\ ord b <= 64)

function lemma_divmod [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/buddy.rs" 184 0 184 35] (x: int) (m: int) : ()

axiom lemma_divmod_spec: forall x: int, m: int. ([%#sbuddy'2] m > 0 /\ x >= 0)
    -> ([%#sbuddy'3] x = m * ComputerDivision.div x m + ComputerDivision.mod x m)

axiom lemma_divmod_spec'0: forall x: int, m: int. ([%#sbuddy'2] m > 0 /\ x >= 0)
    -> ([%#sbuddy'4] 0 <= ComputerDivision.mod x m /\ ComputerDivision.mod x m < m)

axiom lemma_divmod_spec'1: forall x: int, m: int. ([%#sbuddy'2] m > 0 /\ x >= 0)
    -> ([%#sbuddy'5] ComputerDivision.div x m >= 0)

function lemma_mul_le [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/buddy.rs" 156 0 156 43] (a: int) (b: int) (c: int) : ()

axiom lemma_mul_le_spec: forall a: int, b: int, c: int. ([%#sbuddy'6] 0 <= a /\ a <= b /\ 0 <= c)
    -> ([%#sbuddy'7] a * c <= b * c)

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant n : int

constant d : int

function lemma_fits [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/region.rs" 1149 0 1149 33] (n: int) (d: int) : ()

goal vc_lemma_fits: ([%#sregion] d > 0 /\ n >= 0 /\ ComputerDivision.mod n d = 0 /\ n <= 18446744073709551615)
  -> ([@stop_split] [@expl:lemma_ord_ge requires] [%#sbuddy] 0 <= ComputerDivision.div n d
    /\ ComputerDivision.div n d <= 18446744073709551616)
  /\ (([@stop_split] [@expl:lemma_ord_ge ensures] ([@stop_split] [@expl:lemma_ord_ge ensures #0] [%#sbuddy'0] Pow2int.pow2 (ord (ComputerDivision.div n d))
      >= ComputerDivision.div n d)
    /\ ([@stop_split] [@expl:lemma_ord_ge ensures #1] [%#sbuddy'1] 0 <= ord (ComputerDivision.div n d)
    /\ ord (ComputerDivision.div n d) <= 64))
  -> (let _ = lemma_ord_ge (ComputerDivision.div n d) in ([@stop_split] [@expl:lemma_divmod requires] [%#sbuddy'2] d > 0
    /\ n >= 0)
  /\ (([@stop_split] [@expl:lemma_divmod ensures] ([@stop_split] [@expl:lemma_divmod ensures #0] [%#sbuddy'3] n
      = d * ComputerDivision.div n d + ComputerDivision.mod n d)
    /\ ([@stop_split] [@expl:lemma_divmod ensures #1] [%#sbuddy'4] 0 <= ComputerDivision.mod n d
      /\ ComputerDivision.mod n d < d)
    /\ ([@stop_split] [@expl:lemma_divmod ensures #2] [%#sbuddy'5] ComputerDivision.div n d >= 0))
  -> (let _ = lemma_divmod n d in ([@stop_split] [@expl:lemma_mul_le requires] [%#sbuddy'6] 0
      <= ComputerDivision.div n d
    /\ ComputerDivision.div n d <= Pow2int.pow2 (ord (ComputerDivision.div n d)) /\ 0 <= d)
  /\ (([@stop_split] [@expl:lemma_mul_le ensures] [%#sbuddy'7] ComputerDivision.div n d * d
    <= Pow2int.pow2 (ord (ComputerDivision.div n d)) * d)
  -> ([@stop_split] [@expl:lemma_fits ensures] [%#sregion'0] n <= span d (ord (ComputerDivision.div n d))))))))
