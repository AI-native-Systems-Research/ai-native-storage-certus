let new (start_offset'1: UInt64.t) (slab_size'1: UInt64.t) (element_size'1: UInt32.t) (return (x: t_Slab)) =
{[@stop_split] [@expl:new requires] ([@stop_split] [@expl:new requires #0] [%#sslab] UInt32.t'int element_size'1 > 0)
  /\ ([@stop_split] [@expl:new requires #1] [%#sslab'0] UInt64.t'int start_offset'1 + UInt64.t'int slab_size'1
  <= UInt64.t'int const_MAX)}
  any
  [ return (result: t_Slab) ->
  {[@stop_split] [@expl:new ensures] ([@stop_split] [@expl:new ensures #0] [%#sslab'1] result.start_offset'0
        = start_offset'1
      /\ result.slab_size'0 = slab_size'1)
    /\ ([@stop_split] [@expl:new ensures #1] [%#sslab'2] result.element_size'0 = element_size'1)
    /\ ([@stop_split] [@expl:new ensures #2] [%#sslab'3] UInt32.t'int result.bitmap'0.num_slots
      = slots_of (UInt64.t'int slab_size'1) (UInt32.t'int element_size'1))
    /\ ([@stop_split] [@expl:new ensures #3] [%#sslab'4] UInt32.t'int result.bitmap'0.allocated_count = 0
      /\ UInt64.t'int result.rover'0 = 0)
    /\ ([@stop_split] [@expl:new ensures #4] [%#sslab'5] forall j: int. 0 <= j
          /\ j < UInt32.t'int result.bitmap'0.num_slots -> not slot_bit result.bitmap'0 j)
    /\ ([@stop_split] [@expl:new ensures #5] [%#sslab'6] forall j: int. 0 <= j
          /\ j < Seq.length (view_Vec_u64_Global result.keys'0)
        -> Seq.get (view_Vec_u64_Global result.keys'0) j = const_FREE_KEY)
    /\ ([@stop_split] [@expl:new ensures #6] [%#sslab'7] slab_inv result)
    /\ ([@stop_split] [@expl:new ensures #7] [%#sslab'8] key_alloc result)}
    (! return {result}) ]

let len_u64 (self_: t_Vec_u64_Global) (return (x: UInt64.t)) = any
