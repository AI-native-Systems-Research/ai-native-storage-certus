let mark_slot_allocated (self: MutBorrow.t t_Slab) (slot_index: UInt64.t) (return (x: ())) =
{[@stop_split] [@expl:mark_slot_allocated requires] ([@stop_split] [@expl:mark_slot_allocated requires #0] [%#sslab'12] slab_inv self.current)
