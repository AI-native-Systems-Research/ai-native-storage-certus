function lemma_listed_filter [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/region.rs" 918 0 918 56] (sq: Seq.seq UInt64.t) (x: UInt64.t) (k: int) : ()

axiom lemma_listed_filter_def:
  forall sq: Seq.seq UInt64.t, x: UInt64.t, k: int [lemma_listed_filter sq x k]. ([%#sregion'5] listed sq k
      /\ UInt64.t'int x <> k)
    -> lemma_listed_filter sq x k
    = ([%#sregion'9] if Seq.length sq > 0 then
      let pre = Seq.([..]) sq 0 (Seq.length sq - 1) in if UInt64.t'int (Seq.get sq (Seq.length sq - 1)) = k then
        lemma_listed_push_self (filter_ne pre x) (Seq.get sq (Seq.length sq - 1))
      else
        let _ = lemma_listed_filter pre x k in if Seq.get sq (Seq.length sq - 1) = x then
          ()
        else
          lemma_listed_push (filter_ne pre x) (Seq.get sq (Seq.length sq - 1)) k
      
    
    else
      ()
    )

axiom lemma_listed_filter_spec: forall sq: Seq.seq UInt64.t, x: UInt64.t, k: int. ([%#sregion'5] listed sq k
      /\ UInt64.t'int x <> k) -> ([%#sregion'6] listed (filter_ne sq x) k)

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant it : t_RegionState

constant new : t_RegionState

constant s : UInt64.t

constant es : int

function lemma_nf_stale [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/region.rs" 980 0 980 73] (it: t_RegionState) (new: t_RegionState) (s: UInt64.t) (es: int) : ()

goal vc_lemma_nf_stale: ([%#sregion] nonfull_listed it)
  -> ([%#sregion'0] forall k: int. contains_Int (view_SlabMap new.slabs) k = contains_Int (view_SlabMap it.slabs) k)
  -> ([%#sregion'1] forall k: int. contains_Int (view_SlabMap new.slabs) k
      -> lookup_Int (view_SlabMap new.slabs) k = lookup_Int (view_SlabMap it.slabs) k)
  -> ([%#sregion'2] not contains_Int (view_SlabMap it.slabs) (UInt64.t'int s)
    \/ UInt32.t'int (lookup_Int (view_SlabMap it.slabs) (UInt64.t'int s)).bitmap.allocated_count
    = UInt32.t'int (lookup_Int (view_SlabMap it.slabs) (UInt64.t'int s)).bitmap.num_slots)
  -> ([%#sregion'3] forall e: int. sc_get new.size_classes e
      = (if e = es then filter_ne (sc_get it.size_classes e) s else sc_get it.size_classes e))
  -> (forall k: int. if contains_Int (view_SlabMap new.slabs) k then
        if UInt32.t'int (lookup_Int (view_SlabMap new.slabs) k).bitmap.allocated_count
        < UInt32.t'int (lookup_Int (view_SlabMap new.slabs) k).bitmap.num_slots then
          ([@stop_split] [@expl:lemma_listed_filter requires] [%#sregion'5] listed (sc_get it.size_classes (UInt32.t'int (lookup_Int (view_SlabMap new.slabs) k).element_size)) k
            /\ UInt64.t'int s <> k)
          /\ (([@stop_split] [@expl:lemma_listed_filter ensures] [%#sregion'6] listed (filter_ne (sc_get it.size_classes (UInt32.t'int (lookup_Int (view_SlabMap new.slabs) k).element_size)) s) k)
          -> (let _ = lemma_listed_filter (sc_get it.size_classes (UInt32.t'int (lookup_Int (view_SlabMap new.slabs) k).element_size)) s k in true))
        else
          true
      
      else
        true
    )
  /\ (forall k: int. contains_Int (view_SlabMap new.slabs) k
        /\ UInt32.t'int (lookup_Int (view_SlabMap new.slabs) k).bitmap.allocated_count
        < UInt32.t'int (lookup_Int (view_SlabMap new.slabs) k).bitmap.num_slots
      -> (let _ = lemma_listed_filter (sc_get it.size_classes (UInt32.t'int (lookup_Int (view_SlabMap new.slabs) k).element_size)) s k in listed (sc_get new.size_classes (UInt32.t'int (lookup_Int (view_SlabMap new.slabs) k).element_size)) k))
  && ([@stop_split] [@expl:lemma_nf_stale ensures] [%#sregion'4] nonfull_listed new)
