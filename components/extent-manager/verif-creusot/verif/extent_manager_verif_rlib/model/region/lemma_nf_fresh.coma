constant it : t_RegionState

constant new : t_RegionState

constant d : UInt64.t

constant sl : t_Slab

constant es : int

function lemma_nf_fresh [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/region.rs" 998 0 998 83] (it: t_RegionState) (new: t_RegionState) (d: UInt64.t) (sl: t_Slab) (es: int) : ()

goal vc_lemma_nf_fresh: ([%#sregion] nonfull_listed it)
  -> ([%#sregion'0] view_SlabMap new.slabs = insert_Int (view_SlabMap it.slabs) (UInt64.t'int d) sl)
  -> ([%#sregion'1] UInt32.t'int sl.element_size = es)
  -> ([%#sregion'2] forall e: int. sc_get new.size_classes e
      = (if e = es /\ UInt32.t'int sl.bitmap.allocated_count < UInt32.t'int sl.bitmap.num_slots then
        Seq.snoc (sc_get it.size_classes e) d
      else
        sc_get it.size_classes e
      ))
  -> (if UInt32.t'int sl.bitmap.allocated_count < UInt32.t'int sl.bitmap.num_slots then
    ([@stop_split] [@expl:lemma_listed_push_self ensures] [%#sregion'4] listed (Seq.snoc (sc_get it.size_classes es) d) (UInt64.t'int d))
    -> (let _ = lemma_listed_push_self (sc_get it.size_classes es) d in listed (sc_get new.size_classes es) (UInt64.t'int d)
    && (forall k: int, e: int. if listed (sc_get it.size_classes e) k then
          ([@stop_split] [@expl:lemma_listed_push requires] [%#sregion'5] listed (sc_get it.size_classes e) k)
          /\ (([@stop_split] [@expl:lemma_listed_push ensures] [%#sregion'6] listed (Seq.snoc (sc_get it.size_classes e) d) k)
          -> (let _ = lemma_listed_push (sc_get it.size_classes e) d k in true))
        else
          true
      )
    /\ (forall k: int, e: int. listed (sc_get it.size_classes e) k
        -> (let _ = lemma_listed_push (sc_get it.size_classes e) d k in listed (sc_get new.size_classes e) k))
    && ([@stop_split] [@expl:lemma_nf_fresh ensures] [%#sregion'3] nonfull_listed new))
  else
    (forall k: int, e: int. if listed (sc_get it.size_classes e) k then
          ([@stop_split] [@expl:lemma_listed_push requires] [%#sregion'5] listed (sc_get it.size_classes e) k)
          /\ (([@stop_split] [@expl:lemma_listed_push ensures] [%#sregion'6] listed (Seq.snoc (sc_get it.size_classes e) d) k)
          -> (let _ = lemma_listed_push (sc_get it.size_classes e) d k in true))
        else
          true
      )
    /\ (forall k: int, e: int. listed (sc_get it.size_classes e) k
        -> (let _ = lemma_listed_push (sc_get it.size_classes e) d k in listed (sc_get new.size_classes e) k))
    && ([@stop_split] [@expl:lemma_nf_fresh ensures] [%#sregion'3] nonfull_listed new)
  )
