goal vc_lemma_nf_update: ([%#sregion] nonfull_listed it)
  -> ([%#sregion'0] contains_Int (view_SlabMap it.slabs) (UInt64.t'int s)
    /\ lookup_Int (view_SlabMap it.slabs) (UInt64.t'int s) = pa)
  -> ([%#sregion'1] view_SlabMap new.slabs = insert_Int (view_SlabMap it.slabs) (UInt64.t'int s) pb
    /\ new.size_classes = it.size_classes)
  -> ([%#sregion'2] pb.element_size = pa.element_size /\ pb.bitmap.num_slots = pa.bitmap.num_slots)
  -> ([%#sregion'3] UInt32.t'int pa.bitmap.allocated_count <= UInt32.t'int pb.bitmap.allocated_count)
  -> ([@stop_split] [@expl:lemma_nf_update ensures] [%#sregion'4] nonfull_listed new)
