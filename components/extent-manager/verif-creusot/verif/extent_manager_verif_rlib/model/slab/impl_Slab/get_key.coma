    | s1 = [ &_ret <- _9 ] s2
    | s2 = return {_ret} ] ]
  [ & _ret: UInt64.t = Any.any_l ()
  | & self: t_Slab = self
  | & slot_index: UInt64.t = slot_index
  | & _9: UInt64.t = Any.any_l () ])
  [ return (result: UInt64.t) -> {[@stop_split] [@expl:get_key ensures] [%#sslab'1] result
    = Seq.get (view_Vec_u64_Global self.keys) (UInt64.t'int slot_index)}
