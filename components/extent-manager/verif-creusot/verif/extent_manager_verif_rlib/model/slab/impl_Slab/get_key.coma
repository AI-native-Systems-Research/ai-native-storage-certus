  (self: t_Slab) (slot_index: UInt64.t) (return (x: UInt64.t)) =
{[@stop_split] [@expl:get_key requires] [%#sslab'0] UInt64.t'int slot_index
  < Seq.length (view_Vec_u64_Global self.keys)}
