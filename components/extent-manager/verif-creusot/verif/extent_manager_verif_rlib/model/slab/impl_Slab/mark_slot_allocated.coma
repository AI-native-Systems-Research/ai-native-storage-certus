let set (self: MutBorrow.t t_AllocationBitmap) (idx: UInt64.t) (return (x: ())) =
{[@stop_split] [@expl:set requires] ([@stop_split] [@expl:set requires #0] [%#sbitmap'3] bm_wf self.current)
