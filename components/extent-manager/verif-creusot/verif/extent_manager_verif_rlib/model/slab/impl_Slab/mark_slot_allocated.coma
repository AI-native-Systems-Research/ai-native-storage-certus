      = self.current.num_slots)
    /\ ([@stop_split] [@expl:set ensures #1] [%#sbitmap'8] UInt32.t'int self.final.allocated_count
      = UInt32.t'int self.current.allocated_count + 1)
    /\ ([@stop_split] [@expl:set ensures #2] [%#sbitmap'9] bm_wf self.final)
    /\ ([@stop_split] [@expl:set ensures #3] [%#sbitmap'10] slot_bit self.final (UInt64.t'int idx))
    /\ ([@stop_split] [@expl:set ensures #4] [%#sbitmap'11] forall j: int. 0 <= j
        /\ j < 64 * Seq.length (view_Vec_u64_Global self.current.words) /\ j <> UInt64.t'int idx
      -> slot_bit self.final j = slot_bit self.current j)}
    (! return {result}) ]

predicate resolve_refmut_Slab [@inline:trivial] (_1: MutBorrow.t t_Slab) = _1.final = _1.current

