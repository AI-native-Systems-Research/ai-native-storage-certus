function lemma_cnt_inc [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/bitmap.rs" 118 0 118 78] (a: t_AllocationBitmap) (b: t_AllocationBitmap) (k: int) (n: int) : ()

axiom lemma_cnt_inc_spec: forall a: t_AllocationBitmap, b: t_AllocationBitmap, k: int, n: int. ([%#sbitmap'13] 0 <= k
      /\ k < n)
    -> ([%#sbitmap'14] forall j: int. 0 <= j /\ j < n /\ j <> k -> slot_bit a j = slot_bit b j)
