meta "select_lsinst" "all"

let set_key [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/slab.rs" 198 4 198 58]
  (self: MutBorrow.t t_Slab) (slot_index: UInt64.t) (key: UInt64.t) (return (x: ())) =
{[@stop_split] [@expl:set_key requires] [%#sslab'0] UInt64.t'int slot_index
  < Seq.length (view_Vec_u64_Global self.current.keys)}
  (! bb0
  [ bb0 = s0
    [ s0 = MutBorrow.borrow_final <t_Vec_u64_Global> {self.current.keys}
        {MutBorrow.inherit_id (MutBorrow.get_id self) 4}
        (fun (_bor: MutBorrow.t t_Vec_u64_Global) ->
          [ &_25 <- _bor ] [ &self <- { self with current = { self.current with keys = _bor.final } } ] s1)
    | s1 = index_mut_Vec_u64_Global [%#sslab] {_25} {slot_index} (fun (_x: MutBorrow.t UInt64.t) -> [ &_24 <- _x ] s2)
    | s2 = [ &_24 <- { _24 with current = key } ] s3
    | s3 = -{resolve_refmut_u64 _24}- s4
    | s4 = -{resolve_refmut_Slab self}- s5
    | s5 = return {_ret} ] ]
  [ & _ret: () = Any.any_l ()
  | & self: MutBorrow.t t_Slab = self
  | & slot_index: UInt64.t = slot_index
  | & key: UInt64.t = key
  | & _24: MutBorrow.t UInt64.t = Any.any_l ()
  | & _25: MutBorrow.t t_Vec_u64_Global = Any.any_l () ])
  [ return (result: ()) ->
  {[@stop_split] [@expl:set_key ensures] ([@stop_split] [@expl:set_key ensures #0] [%#sslab'1] view_Vec_u64_Global self.final.keys
      = Seq.set (view_Vec_u64_Global self.current.keys) (UInt64.t'int slot_index) key)
    /\ ([@stop_split] [@expl:set_key ensures #1] [%#sslab'2] self.final.bitmap = self.current.bitmap
      /\ self.final.rover = self.current.rover)
    /\ ([@stop_split] [@expl:set_key ensures #2] [%#sslab'3] self.final.start_offset = self.current.start_offset
      /\ self.final.slab_size = self.current.slab_size)
    /\ ([@stop_split] [@expl:set_key ensures #3] [%#sslab'4] self.final.element_size = self.current.element_size)
    /\ ([@stop_split] [@expl:set_key ensures #4] [%#sslab'5] slab_inv self.current -> slab_inv self.final)
