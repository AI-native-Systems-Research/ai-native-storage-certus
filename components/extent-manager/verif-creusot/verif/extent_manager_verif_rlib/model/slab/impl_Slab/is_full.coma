  (self: t_Slab) (return (x: bool)) = (! bb0
  [ bb0 = s0
    [ s0 = count_set [%#sslab] {self.bitmap} (fun (_x: UInt64.t) -> [ &_4 <- _x ] s1)
    | s1 = num_slots'0 [%#sslab'0] {self.bitmap} (fun (_x: UInt32.t) -> [ &_7 <- _x ] s2)
    | s2 = [ &_6 <- UInt64.of_int (UInt32.t'int _7) ] s3
    | s3 = [ &_ret <- _4 = _6 ] s4
    | s4 = return {_ret} ] ]
  [ & _ret: bool = Any.any_l ()
  | & self: t_Slab = self
  | & _4: UInt64.t = Any.any_l ()
  | & _6: UInt64.t = Any.any_l ()
  | & _7: UInt32.t = Any.any_l () ])
  [ return (result: bool) -> {[@stop_split] [@expl:is_full ensures] [%#sslab'1] result
    = (UInt32.t'int self.bitmap.allocated_count = UInt32.t'int self.bitmap.num_slots)}
    (! return {result}) ]
