use creusot.int.UInt32
use creusot.int.UInt64
use creusot.prelude.Any

type t_Vec_u64_Global

type t_AllocationBitmap = { words: t_Vec_u64_Global; num_slots: UInt32.t; allocated_count: UInt32.t }

type t_Slab = {
  start_offset: UInt64.t;
  slab_size: UInt64.t;
  element_size: UInt32.t;
  bitmap: t_AllocationBitmap;
  keys: t_Vec_u64_Global;
  rover: UInt64.t }

let count_set (self: t_AllocationBitmap) (return (x: UInt64.t)) = any
  [ return (result: UInt64.t) -> {[@stop_split] [@expl:count_set ensures] [%#sbitmap] UInt64.t'int result
    = UInt32.t'int self.allocated_count}
    (! return {result}) ]

let num_slots'0 (self: t_AllocationBitmap) (return (x: UInt32.t)) = any
  [ return (result: UInt32.t) -> {[@stop_split] [@expl:num_slots ensures] [%#sbitmap'0] result = self.num_slots}
    (! return {result}) ]

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

