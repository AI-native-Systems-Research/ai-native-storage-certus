  forall self: t_Vec_Th_Global [view_Vec_Th_Global self]. [%#svec'1] Seq.length (view_Vec_Th_Global self)
    <= UInt64.t'int const_MAX

predicate has_value_usize [@inline:trivial] (self: UInt64.t) (seq: Seq.seq t_Th) (out: t_Th) =
