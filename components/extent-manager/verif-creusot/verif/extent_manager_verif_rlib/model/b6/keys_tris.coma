use creusot.int.UInt64
use seq.Seq
use creusot.int.UInt32
use map.Map
use int.Int

type t_FMap_Int_Slab

type tup3_u64_Int_u32 = { f0: UInt64.t; f1: int; f2: UInt32.t }

predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
  [%#swell_founded] self >= 0 /\ self > other

meta "rewrite_def" predicate well_founded_relation_Int

type t_Vec_u64_Global

type t_AllocationBitmap = { words: t_Vec_u64_Global; num_slots: UInt32.t; allocated_count: UInt32.t }

type t_Slab = {
  start_offset: UInt64.t;
  slab_size: UInt64.t;
  element_size: UInt32.t;
  bitmap: t_AllocationBitmap;
  keys: t_Vec_u64_Global;
  rover: UInt64.t }

type t_Option_Slab = None | Some t_Slab

function to_mapping_Int (self: t_FMap_Int_Slab) : Map.map int t_Option_Slab

function get_Int [@inline:trivial] (self: t_FMap_Int_Slab) (k: int) : t_Option_Slab =
  [%#sfmap'1] Map.get (to_mapping_Int self) k

meta "rewrite_def" function get_Int

predicate contains_Int [@inline:trivial] (self: t_FMap_Int_Slab) (k: int) = [%#sfmap] get_Int self k <> None

meta "rewrite_def" predicate contains_Int

predicate index_Mapping_Slab_bool [@inline:trivial] (self: Map.map t_Slab bool) (a: t_Slab) =
  [%#smapping] Map.get self a

meta "rewrite_def" predicate index_Mapping_Slab_bool

function such_that_Slab (p: Map.map t_Slab bool) : t_Slab

axiom such_that_Slab_spec:
  forall p: Map.map t_Slab bool [such_that_Slab p]. ([%#slogic] exists x: t_Slab. index_Mapping_Slab_bool p x)
    -> ([%#slogic'0] index_Mapping_Slab_bool p (such_that_Slab p))

function unwrap_Option_Slab (self: t_Option_Slab) : t_Slab = [%#soption'0] match self with
    | Some x -> x
    | None -> such_that_Slab (fun (__0: t_Slab) -> true)
    end

function lookup_Int [@inline:trivial] (self: t_FMap_Int_Slab) (k: int) : t_Slab =
  [%#sfmap'0] unwrap_Option_Slab (get_Int self k)

meta "rewrite_def" function lookup_Int

constant const_MAX: UInt64.t = (18446744073709551615: UInt64.t)

function view_Vec_u64_Global (self: t_Vec_u64_Global) : Seq.seq UInt64.t

axiom view_Vec_u64_Global_spec:
  forall self: t_Vec_u64_Global [view_Vec_u64_Global self]. [%#svec] Seq.length (view_Vec_u64_Global self)
    <= UInt64.t'int const_MAX

constant const_FREE_KEY: UInt64.t = [%#sslab] (18446744073709551615: UInt64.t)

function slot_off [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/slab.rs" 84 0 84 39] (s: t_Slab) (i: int) : int
 = [%#sslab'0] UInt64.t'int s.start_offset + i * UInt32.t'int s.element_size

function slab_tris [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/b6.rs" 560 0 560 58] (sl: t_Slab) (n: int) : Seq.seq tup3_u64_Int_u32

axiom slab_tris_def: forall sl: t_Slab, n: int [slab_tris sl n]. slab_tris sl n
    = ([%#sb6'1] if n <= 0 then
      Seq.empty: Seq.seq tup3_u64_Int_u32
    else
      if Seq.get (view_Vec_u64_Global sl.keys) (n - 1) <> const_FREE_KEY then
        Seq.snoc (slab_tris sl (n - 1)) { f0 = Seq.get (view_Vec_u64_Global sl.keys) (n - 1);
                                          f1 = slot_off sl (n - 1);
                                          f2 = sl.element_size }
      else
        slab_tris sl (n - 1)
    
    )

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant m : t_FMap_Int_Slab

constant ks : Seq.seq UInt64.t

constant a : int

function keys_tris [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/b6.rs" 572 0 572 82] (m: t_FMap_Int_Slab) (ks: Seq.seq UInt64.t) (a: int) : Seq.seq tup3_u64_Int_u32

goal vc_keys_tris: if a <= 0 then
    true
  else
    [@expl:variant decreases] well_founded_relation_Int ([%#sb6] a) ([%#sb6] a - 1)
  
