  [ bb0 = s0 [ s0 = [ &_ret <- self ] s1 | s1 = return {_ret} ] ] [ & _ret: t_Th = Any.any_l () | & self: t_Th = self ])
  [ return (result: t_Th) -> (! return {result}) ]
