use creusot.int.UInt64
use seq.Seq
use creusot.prelude.MutBorrow
use creusot.prelude.Any
use int.Int

type t_Vec_Th_Global

type t_Co = { completed_seq: UInt64.t; in_progress: bool }

type t_CoSys = { co: t_Co; ts: t_Vec_Th_Global }

type t_Th = Idle | Waiting UInt64.t | Running UInt64.t

predicate in_bounds_usize [@inline:trivial] (self: UInt64.t) (seq: Seq.seq t_Th) =
  [%#sslice] UInt64.t'int self < Seq.length seq

meta "rewrite_def" predicate in_bounds_usize

constant const_MAX: UInt64.t = (18446744073709551615: UInt64.t)

function view_Vec_Th_Global (self: t_Vec_Th_Global) : Seq.seq t_Th

axiom view_Vec_Th_Global_spec:
  forall self: t_Vec_Th_Global [view_Vec_Th_Global self]. [%#svec'1] Seq.length (view_Vec_Th_Global self)
    <= UInt64.t'int const_MAX

predicate has_value_usize [@inline:trivial] (self: UInt64.t) (seq: Seq.seq t_Th) (out: t_Th) =
  [%#sslice'0] Seq.get seq (UInt64.t'int self) = out

meta "rewrite_def" predicate has_value_usize

let index_Vec_Th_Global (self_: t_Vec_Th_Global) (ix: UInt64.t) (return (x: t_Th)) =
{[@stop_split] [@expl:index requires] [%#svec] in_bounds_usize ix (view_Vec_Th_Global self_)}
  any
  [ return (result: t_Th) ->
  {[@stop_split] [@expl:index ensures] [%#svec'0] has_value_usize ix (view_Vec_Th_Global self_) result}
    (! return {result}) ]

predicate resolve_refmut_CoSys [@inline:trivial] (_1: MutBorrow.t t_CoSys) = _1.final = _1.current

meta "rewrite_def" predicate resolve_refmut_CoSys

let elim_Waiting (_x: t_Th) (return (f0: UInt64.t)) = any
  [ _k (f0: UInt64.t) -> {Waiting f0 = _x} (! return {f0})
  | _chk -> (! {[@expl:elim Waiting] match _x with
      | Waiting _ -> true
      | _ -> false
      end}
    any) ]

predicate is_run [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/b4.rs" 138 0 138 28] (t: t_Th) =
  [%#sb4'8] match t with
    | Running _ -> true
    | _ -> false
    end

predicate co_run_flag [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/b4.rs" 149 0 149 36] (s: t_CoSys) =
  [%#sb4'9] forall i: int. 0 <= i
      /\ i < Seq.length (view_Vec_Th_Global s.ts) /\ is_run (Seq.get (view_Vec_Th_Global s.ts) i) -> s.co.in_progress

predicate co_single [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/b4.rs" 155 0 155 34] (s: t_CoSys) =
  [%#sb4'10] forall i: int, j: int. 0 <= i
      /\ i < Seq.length (view_Vec_Th_Global s.ts)
      /\ 0 <= j
      /\ j < Seq.length (view_Vec_Th_Global s.ts)
      /\ is_run (Seq.get (view_Vec_Th_Global s.ts) i) /\ is_run (Seq.get (view_Vec_Th_Global s.ts) j) -> i = j

function th_need [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/b4.rs" 143 0 143 28] (t: t_Th) : int
 = [%#sb4'12] match t with
    | Running n -> UInt64.t'int n
    | Waiting n -> UInt64.t'int n
    | Idle -> 0
    end

predicate co_bound [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/b4.rs" 165 0 165 33] (s: t_CoSys) =
  [%#sb4'11] forall i: int. 0 <= i /\ i < Seq.length (view_Vec_Th_Global s.ts)
    -> th_need (Seq.get (view_Vec_Th_Global s.ts) i) <= UInt64.t'int s.co.completed_seq + 2
    /\ (is_run (Seq.get (view_Vec_Th_Global s.ts) i)
    -> UInt64.t'int s.co.completed_seq < th_need (Seq.get (view_Vec_Th_Global s.ts) i))

predicate co_inv [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/b4.rs" 173 0 173 31] (s: t_CoSys) =
  [%#sb4'6] co_run_flag s /\ co_single s /\ co_bound s

predicate co_step [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/b4.rs" 179 0 179 42] (a: t_CoSys) (b: t_CoSys) =
  [%#sb4'7] Seq.length (view_Vec_Th_Global b.ts) = Seq.length (view_Vec_Th_Global a.ts)
  /\ UInt64.t'int a.co.completed_seq <= UInt64.t'int b.co.completed_seq
  /\ UInt64.t'int b.co.completed_seq <= UInt64.t'int a.co.completed_seq + 2

let check' (self: MutBorrow.t t_CoSys) (t: UInt64.t) (needed: UInt64.t) (return (x: ())) =
{[@stop_split] [@expl:check requires] ([@stop_split] [@expl:check requires #0] [%#sb4'3] co_inv self.current
    /\ UInt64.t'int t < Seq.length (view_Vec_Th_Global self.current.ts)
    /\ not is_run (Seq.get (view_Vec_Th_Global self.current.ts) (UInt64.t'int t)))
  /\ ([@stop_split] [@expl:check requires #1] [%#sb4'4] UInt64.t'int needed
  <= UInt64.t'int self.current.co.completed_seq + 2)}
  any
  [ return (result: ()) -> {[@stop_split] [@expl:check ensures] [%#sb4'5] co_inv self.final
    /\ co_step self.current self.final /\ self.final.co.completed_seq = self.current.co.completed_seq}
    (! return {result}) ]

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let wake [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/b4.rs" 243 4 243 36]
  (self: MutBorrow.t t_CoSys) (t: UInt64.t) (return (x: ())) =
{[@stop_split] [@expl:wake requires] [%#sb4'1] co_inv self.current
  /\ UInt64.t'int t < Seq.length (view_Vec_Th_Global self.current.ts)}
  (! bb0
  [ bb0 = s0
    [ s0 = index_Vec_Th_Global [%#sb4] {self.current.ts} {t} (fun (_x: t_Th) -> [ &_8 <- _x ] s1)
    | s1 = any
      [ br0 -> {_8 = Idle} (! bb2)
      | br1 (x0: UInt64.t) -> {_8 = Waiting x0} (! bb4)
      | br2 (x0: UInt64.t) -> {_8 = Running x0} (! bb2) ] ]
  | bb2 = s0 [ s0 = -{resolve_refmut_CoSys self}- s1 | s1 = return {_ret} ]
  | bb4 = s0
    [ s0 = elim_Waiting {_8} (fun (r0: UInt64.t) -> [ &n <- r0 ] s1)
    | s1 = MutBorrow.borrow_final <t_CoSys> {self.current} {MutBorrow.get_id self}
        (fun (_bor: MutBorrow.t t_CoSys) -> [ &_13 <- _bor ] [ &self <- { self with current = _bor.final } ] s2)
    | s2 = check' [%#sb4'0] {_13} {t} {n} (fun (_x: ()) -> [ &_ret <- _x ] s3)
    | s3 = -{resolve_refmut_CoSys self}- s4
    | s4 = return {_ret} ] ]
  [ & _ret: () = Any.any_l ()
  | & self: MutBorrow.t t_CoSys = self
  | & t: UInt64.t = t
  | & _8: t_Th = Any.any_l ()
  | & n: UInt64.t = Any.any_l ()
  | & _13: MutBorrow.t t_CoSys = Any.any_l () ])
  [ return (result: ()) -> {[@stop_split] [@expl:wake ensures] [%#sb4'2] co_inv self.final
    /\ co_step self.current self.final}
    (! return {result}) ]
