    | s2 = MutBorrow.borrow_final <t_Vec_Th_Global> {self.current.ts} {MutBorrow.inherit_id (MutBorrow.get_id self) 1}
        (fun (_bor: MutBorrow.t t_Vec_Th_Global) ->
          [ &_19 <- _bor ] [ &self <- { self with current = { self.current with ts = _bor.final } } ] s3)
    | s3 = index_mut_Vec_Th_Global [%#sb4'1] {_19} {t} (fun (_x: MutBorrow.t t_Th) -> [ &_18 <- _x ] s4)
    | s4 = [ &_18 <- { _18 with current = _17 } ] s5
