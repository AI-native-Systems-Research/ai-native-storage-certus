type t_Client = { sector_size: UInt32.t; ns_id: UInt32.t; base_lba: UInt64.t }

type t_Vec_u8_Global

constant const_MAX: UInt64.t = (18446744073709551615: UInt64.t)

function view_Vec_u8_Global (self: t_Vec_u8_Global) : Seq.seq UInt8.t

axiom view_Vec_u8_Global_spec:
  forall self: t_Vec_u8_Global [view_Vec_u8_Global self]. [%#svec'0] Seq.length (view_Vec_u8_Global self)
    <= UInt64.t'int const_MAX

let new_u8 (return (x: t_Vec_u8_Global)) = any
  [ return (result: t_Vec_u8_Global) ->
  {[@stop_split] [@expl:new ensures] [%#svec] Seq.length (view_Vec_u8_Global result) = 0}
    (! return {result}) ]

type t_Option_Seq_u8 = None | Some (Seq.seq UInt8.t)

type t_FMap_tup2_Int_Int_Seq_u8

type tup2_Int_Int = { f0: int; f1: int }

function to_mapping_tup2_Int_Int (self: t_FMap_tup2_Int_Int_Seq_u8) : Map.map tup2_Int_Int t_Option_Seq_u8

function get_tup2_Int_Int [@inline:trivial] (self: t_FMap_tup2_Int_Int_Seq_u8) (k: tup2_Int_Int) : t_Option_Seq_u8 =
  [%#sfmap] Map.get (to_mapping_tup2_Int_Int self) k

meta "rewrite_def" function get_tup2_Int_Int

type t_BDev = { store: t_FMap_tup2_Int_Int_Seq_u8; log: Seq.seq tup2_Int_Int }

function lemma_divmod [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/buddy.rs" 184 0 184 35] (x: int) (m: int) : ()

axiom lemma_divmod_spec: forall x: int, m: int. ([%#sbuddy] m > 0 /\ x >= 0)
    -> ([%#sbuddy'0] x = m * ComputerDivision.div x m + ComputerDivision.mod x m)

axiom lemma_divmod_spec'0: forall x: int, m: int. ([%#sbuddy] m > 0 /\ x >= 0)
    -> ([%#sbuddy'1] 0 <= ComputerDivision.mod x m /\ ComputerDivision.mod x m < m)

axiom lemma_divmod_spec'1: forall x: int, m: int. ([%#sbuddy] m > 0 /\ x >= 0)
    -> ([%#sbuddy'2] ComputerDivision.div x m >= 0)

function lemma_mul_le [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/buddy.rs" 156 0 156 43] (a: int) (b: int) (c: int) : ()

axiom lemma_mul_le_spec: forall a: int, b: int, c: int. ([%#sbuddy'3] 0 <= a /\ a <= b /\ 0 <= c)
    -> ([%#sbuddy'4] a * c <= b * c)

function lemma_ceil_lt [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/blockio.rs" 236 0 236 44] (n: int) (d: int) (i: int) : ()
 = [%#sblockio'45] let _ = lemma_divmod (n + d - 1) d in lemma_mul_le (i + 1) (ComputerDivision.div (n + d - 1) d) d

axiom lemma_ceil_lt_spec: forall n: int, d: int, i: int. ([%#sblockio'43] d > 0
      /\ n >= 0 /\ 0 <= i /\ i < ComputerDivision.div (n + d - 1) d) -> ([%#sblockio'44] i * d < n)

type t_EmError = CorruptMetadata | IoError | NotInitialized | OffsetNotFound UInt64.t | OutOfSpace

type t_Result_Vec_u8_Global_EmError = Ok t_Vec_u8_Global | Err t_EmError

let dev_read_sync (dev: MutBorrow.t t_BDev) (ns: UInt32.t) (lba: UInt64.t) (n: UInt64.t)
  (return (x: t_Result_Vec_u8_Global_EmError)) = any
  [ return (result: t_Result_Vec_u8_Global_EmError) ->
  {[@stop_split] [@expl:dev_read_sync ensures] ([@stop_split] [@expl:dev_read_sync ensures #0] [%#sblockio'46] dev.final.log
      = Seq.snoc dev.current.log { f0 = UInt32.t'int ns; f1 = UInt64.t'int lba })
    /\ ([@stop_split] [@expl:dev_read_sync ensures #1] [%#sblockio'47] dev.final.store = dev.current.store)
    /\ ([@stop_split] [@expl:dev_read_sync ensures #2] [%#sblockio'48] match result with
      | Ok v -> Seq.length (view_Vec_u8_Global v) = UInt64.t'int n
      /\ match get_tup2_Int_Int dev.current.store { f0 = UInt32.t'int ns; f1 = UInt64.t'int lba } with
        | Some s -> view_Vec_u8_Global v = s
        | None -> true
        end
      | Err e -> e = IoError
      end)}
    (! return {result}) ]

type t_Result_Infallible_EmError = Ok'0 () | Err'0 t_EmError

type t_ControlFlow_Result_Infallible_EmError_Vec_u8_Global =
  | Continue t_Vec_u8_Global
  | Break t_Result_Infallible_EmError

predicate inv_Infallible [@inline:trivial] (_1: ()) = false

meta "rewrite_def" predicate inv_Infallible

predicate inv_Result_Infallible_EmError (_1: t_Result_Infallible_EmError)

axiom inv_axiom [@rewrite]:
  forall x: t_Result_Infallible_EmError [inv_Result_Infallible_EmError x]. inv_Result_Infallible_EmError x
    = match x with
      | Ok'0 f0'0 -> inv_Infallible f0'0
      | Err'0 f0'0 -> true
      end

predicate inv_ControlFlow_Result_Infallible_EmError_Vec_u8_Global (_1: t_ControlFlow_Result_Infallible_EmError_Vec_u8_Global)

axiom inv_axiom'0 [@rewrite]:
  forall x: t_ControlFlow_Result_Infallible_EmError_Vec_u8_Global [inv_ControlFlow_Result_Infallible_EmError_Vec_u8_Global x]. inv_ControlFlow_Result_Infallible_EmError_Vec_u8_Global x
    = match x with
      | Continue f0'0 -> true
      | Break f0'0 -> inv_Result_Infallible_EmError f0'0
      end

let branch_Result_Vec_u8_Global_EmError (self_: t_Result_Vec_u8_Global_EmError)
  (return (x: t_ControlFlow_Result_Infallible_EmError_Vec_u8_Global)) = any
  [ return (result: t_ControlFlow_Result_Infallible_EmError_Vec_u8_Global) ->
  {[@stop_split] [@expl:branch_Result_Vec_u8_Global_EmError ensures] ([@stop_split] [@expl:branch result type invariant] inv_ControlFlow_Result_Infallible_EmError_Vec_u8_Global result)
    /\ ([@stop_split] [@expl:branch ensures] [%#sops] match self_ with
      | Ok v -> result = Continue v
      | Err e -> result = Break (Err'0 e)
      end)}
    (! return {result}) ]

let elim_Continue (_x: t_ControlFlow_Result_Infallible_EmError_Vec_u8_Global) (return (f0'0: t_Vec_u8_Global)) = any
  [ _k (f0'0: t_Vec_u8_Global) -> {Continue f0'0 = _x} (! return {f0'0})
  | _chk -> (! {[@expl:elim Continue] match _x with
