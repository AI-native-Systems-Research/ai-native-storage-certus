use int.ComputerDivision
use int.Int

function lemma_divmod [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/buddy.rs" 184 0 184 35] (x: int) (m: int) : ()

axiom lemma_divmod_spec: forall x: int, m: int. ([%#sbuddy] m > 0 /\ x >= 0)
    -> ([%#sbuddy'0] x = m * ComputerDivision.div x m + ComputerDivision.mod x m)

axiom lemma_divmod_spec'0: forall x: int, m: int. ([%#sbuddy] m > 0 /\ x >= 0)
    -> ([%#sbuddy'1] 0 <= ComputerDivision.mod x m /\ ComputerDivision.mod x m < m)

axiom lemma_divmod_spec'1: forall x: int, m: int. ([%#sbuddy] m > 0 /\ x >= 0)
    -> ([%#sbuddy'2] ComputerDivision.div x m >= 0)

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant i : int

constant d : int

constant j : int

function lemma_divmod_at [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/blockio.rs" 254 0 254 46] (i: int) (d: int) (j: int) : ()

goal vc_lemma_divmod_at: ([%#sblockio] d > 0 /\ i >= 0 /\ 0 <= j /\ j < d)
  -> ([@stop_split] [@expl:lemma_divmod requires] [%#sbuddy] d > 0 /\ i * d + j >= 0)
  /\ (([@stop_split] [@expl:lemma_divmod ensures] ([@stop_split] [@expl:lemma_divmod ensures #0] [%#sbuddy'0] i * d + j
      = d * ComputerDivision.div (i * d + j) d + ComputerDivision.mod (i * d + j) d)
    /\ ([@stop_split] [@expl:lemma_divmod ensures #1] [%#sbuddy'1] 0 <= ComputerDivision.mod (i * d + j) d
      /\ ComputerDivision.mod (i * d + j) d < d)
    /\ ([@stop_split] [@expl:lemma_divmod ensures #2] [%#sbuddy'2] ComputerDivision.div (i * d + j) d >= 0))
  -> ([@stop_split] [@expl:lemma_divmod_at ensures] [%#sblockio'0] ComputerDivision.div (i * d + j) d = i
  /\ ComputerDivision.mod (i * d + j) d = j))
