(* model::b5::TSys *)

let%span sb5 = "/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/b5.rs" 115 49 115 54
let%span sb5'0 = "/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/b5.rs" 114 49 114 54
let%span sb5'1 = "/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/b5.rs" 108 14 108 63
let%span sb5'2 = "/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/b5.rs" 109 14 109 78
let%span sb5'3 = "/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/b5.rs" 110 14 110 122

use creusot.int.UInt64
use creusot.prelude.MutBorrow
use creusot.prelude.Any

type t_Option_u64 = None | Some UInt64.t

type t_TPh = Top | Wait int | WaitInf | Woken bool | Work | Exited

type t_TSys = { interval: t_Option_u64; now: int; ph: t_TPh; shutdown: bool; ckpts: UInt64.t }

predicate resolve_refmut_TSys [@inline:trivial] (_1: MutBorrow.t t_TSys) = _1.final = _1.current

meta "rewrite_def" predicate resolve_refmut_TSys

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let set_interval [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/b5.rs" 111 4 111 51]
  (self: MutBorrow.t t_TSys) (iv: t_Option_u64) (return (x: ())) = (! bb0
  [ bb0 = s0
    [ s0 = [ &self <- { self with current = { self.current with interval = iv } } ] s1
    | s1 = any
      [ br0 -> {self.current.ph = Top} (! bb1)
      | br1 (x0: int) -> {self.current.ph = Wait x0} (! bb5)
      | br2 -> {self.current.ph = WaitInf} (! bb4)
      | br3 (x0: bool) -> {self.current.ph = Woken x0} (! bb1)
      | br4 -> {self.current.ph = Work} (! bb1)
      | br5 -> {self.current.ph = Exited} (! bb1) ] ]
  | bb1 = s0 [ s0 = -{resolve_refmut_TSys self}- s1 | s1 = return {_ret} ]
  | bb4 = s0
    [ s0 = [ &_13 <- Woken ([%#sb5] false) ] s1
    | s1 = [ &self <- { self with current = { self.current with ph = _13 } } ] s2
    | s2 = -{resolve_refmut_TSys self}- s3
    | s3 = return {_ret} ]
  | bb5 = s0
    [ s0 = [ &_12 <- Woken ([%#sb5'0] false) ] s1
    | s1 = [ &self <- { self with current = { self.current with ph = _12 } } ] s2
    | s2 = -{resolve_refmut_TSys self}- s3
    | s3 = return {_ret} ] ]
  [ & _ret: () = Any.any_l ()
  | & self: MutBorrow.t t_TSys = self
  | & iv: t_Option_u64 = iv
  | & _12: t_TPh = Any.any_l ()
  | & _13: t_TPh = Any.any_l () ])
  [ return (result: ()) ->
  {[@stop_split] [@expl:set_interval ensures] ([@stop_split] [@expl:set_interval ensures #0] [%#sb5'1] self.final.interval
        = iv
      /\ self.final.now = self.current.now)
    /\ ([@stop_split] [@expl:set_interval ensures #1] [%#sb5'2] self.final.shutdown = self.current.shutdown
      /\ self.final.ckpts = self.current.ckpts)
    /\ ([@stop_split] [@expl:set_interval ensures #2] [%#sb5'3] self.final.ph
    = match self.current.ph with
      | Wait _ -> Woken false
      | WaitInf -> Woken false
      | p -> p
      end)}
    (! return {result}) ]
