  | bb6 = s0
    [ s0 = elim_Some {self.current.interval} (fun (r0: UInt64.t) -> [ &d <- r0 ] s1)
    | s1 = [ &_18 <- Wait ([%#sb5] self.current.now + UInt64.t'int d) ] s2
    | s2 = [ &self <- { self with current = { self.current with ph = _18 } } ] s3
    | s3 = -{resolve_refmut_TSys self}- s4
    | s4 = return {_ret} ]
  | bb5 = s0
    [ s0 = [ &_23 <- WaitInf ] s1
    | s1 = [ &self <- { self with current = { self.current with ph = _23 } } ] s2
    | s2 = -{resolve_refmut_TSys self}- s3
    | s3 = return {_ret} ] ]
  [ & _ret: () = Any.any_l ()
  | & self: MutBorrow.t t_TSys = self
  | & _15: t_TPh = Any.any_l ()
  | & d: UInt64.t = Any.any_l ()
  | & _18: t_TPh = Any.any_l ()
  | & _23: t_TPh = Any.any_l () ])
  [ return (result: ()) ->
  {[@stop_split] [@expl:th_enter ensures] ([@stop_split] [@expl:th_enter ensures #0] [%#sb5'1] self.final.interval
        = self.current.interval
      /\ self.final.now = self.current.now)
    /\ ([@stop_split] [@expl:th_enter ensures #1] [%#sb5'2] self.final.shutdown = self.current.shutdown
      /\ self.final.ckpts = self.current.ckpts)
    /\ ([@stop_split] [@expl:th_enter ensures #2] [%#sb5'3] self.current.shutdown -> self.final.ph = Exited)
    /\ ([@stop_split] [@expl:th_enter ensures #3] [%#sb5'4] not self.current.shutdown
