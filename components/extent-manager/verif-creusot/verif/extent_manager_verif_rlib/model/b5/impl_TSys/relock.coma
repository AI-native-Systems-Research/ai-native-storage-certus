  | bb8 = s0
    [ s0 = [ &_19 <- Top ] s1
    | s1 = [ &self <- { self with current = { self.current with ph = _19 } } ] s2
    | s2 = -{resolve_refmut_TSys self}- s3
    | s3 = return {_ret} ] ]
  [ & _ret: () = Any.any_l ()
  | & self: MutBorrow.t t_TSys = self
  | & t: bool = Any.any_l ()
  | & t'0: bool = Any.any_l ()
  | & _16: t_TPh = Any.any_l ()
  | & _18: t_TPh = Any.any_l ()
  | & _19: t_TPh = Any.any_l () ])
  [ return (result: ()) ->
  {[@stop_split] [@expl:relock ensures] ([@stop_split] [@expl:relock ensures #0] [%#sb5'1] self.final.interval
        = self.current.interval
      /\ self.final.now = self.current.now)
