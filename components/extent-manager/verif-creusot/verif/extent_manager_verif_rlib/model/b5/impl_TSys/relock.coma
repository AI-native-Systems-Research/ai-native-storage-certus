  | bb4 = any [ br0 -> {self.current.shutdown = false} (! bb6) | br1 -> {self.current.shutdown} (! bb5) ]
  | bb5 = s0
    [ s0 = [ &_16 <- Exited ] s1
    | s1 = [ &self <- { self with current = { self.current with ph = _16 } } ] s2
    | s2 = -{resolve_refmut_TSys self}- s3
    | s3 = return {_ret} ]
  | bb6 = any [ br0 -> {t = false} (! bb8) | br1 -> {t} (! bb7) ]
