goal vc_lemma_rb_final: ([%#sl2r] p2 (UInt32.t'int fp.sector_size'0) /\ starts_distinct ds)
  -> ([%#sl2r'0] rb1 r.buddy b0 ds (Seq.length ds) base size fp /\ rb2 r ds (Seq.length ds))
  -> ([%#sl2r'1] rg_inv r /\ r.format_params = fp /\ Seq.length (view_Vec_tup2_u64_usize_Global r.pending_frees) = 0)
  -> ([%#sl2r'2] UInt64.t'int r.buddy.base_offset = base
    /\ UInt64.t'int r.buddy.total_usable_size = size /\ r.buddy.sector_size = fp.sector_size'0)
  -> ([%#sl2r'3] tf (view_Vec_Vec_u64_Global_Global b0.free_lists) (UInt32.t'int fp.sector_size'0) (Seq.length (view_Vec_Vec_u64_Global_Global b0.free_lists))
    = ComputerDivision.div size (UInt32.t'int fp.sector_size'0) * UInt32.t'int fp.sector_size'0)
  -> sk r = dsk fp
  && (forall k: int. contains_Int (view_SlabMap r.slabs) k
      -> (exists p: int. 0 <= p /\ p < Seq.length ds /\ UInt64.t'int (Seq.get ds p).start_offset = k))
  && sl_away r
  && (([@stop_split] [@expl:view ensures] [%#svec] Seq.length (view_Vec_Vec_u64_Global_Global r.buddy.free_lists)
    <= UInt64.t'int const_MAX)
  -> ([@stop_split] [@expl:view ensures] [%#svec] Seq.length (view_Vec_Vec_u64_Global_Global r.buddy.free_lists)
    <= UInt64.t'int const_MAX)
  -> rg_tf r
    = tf (view_Vec_Vec_u64_Global_Global r.buddy.free_lists) (UInt32.t'int fp.sector_size'0) (Seq.length (view_Vec_Vec_u64_Global_Global r.buddy.free_lists))
  && rg_acct r
  && (if rg_core r then
    ([@stop_split] [@expl:view ensures] [%#svec] Seq.length (view_Vec_tup2_u64_usize_Global r.pending_frees)
      <= UInt64.t'int const_MAX)
    -> pv r (view_Vec_tup2_u64_usize_Global r.pending_frees)
    && ([@stop_split] [@expl:lemma_rg_good_o_intro requires] [%#sl2r'5] rg_good r)
    /\ (([@stop_split] [@expl:lemma_rg_good_o_intro ensures] [%#sl2r'6] rg_good_o r)
    -> ([@stop_split] [@expl:lemma_rb_final ensures] [%#sl2r'4] rg_good_o r))
  else
    false
    && ([@stop_split] [@expl:lemma_rg_good_o_intro requires] [%#sl2r'5] rg_good r)
    /\ (([@stop_split] [@expl:lemma_rg_good_o_intro ensures] [%#sl2r'6] rg_good_o r)
    -> ([@stop_split] [@expl:lemma_rb_final ensures] [%#sl2r'4] rg_good_o r))
