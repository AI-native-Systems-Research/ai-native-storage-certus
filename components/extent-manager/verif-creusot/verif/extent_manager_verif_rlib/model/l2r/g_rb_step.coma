      /\ starts_distinct ds /\ rb1 bpre b0 ds i base size fp)
    -> ([%#sl2r'9] 0 <= i /\ i < Seq.length ds /\ desc_ok (Seq.get ds i) base size fp)
    -> ([%#sl2r'10] forall p: int. 0 <= p /\ p < Seq.length ds -> desc_ok (Seq.get ds p) base size fp)
    -> ([%#sl2r'11] bpre.sector_size = fp.sector_size'0
      /\ bpost.sector_size = fp.sector_size'0 /\ UInt32.t'int fp.sector_size'0 > 0 /\ UInt64.t'int fp.slab_size'0 > 0)
    -> ([%#sl2r'12] mk_spec (view_Vec_Vec_u64_Global_Global bpre.free_lists) (view_Vec_Vec_u64_Global_Global bpost.free_lists) (UInt32.t'int fp.sector_size'0) (UInt64.t'int (Seq.get ds i).start_offset
      - base) (ord (ComputerDivision.div (UInt64.t'int (Seq.get ds i).slab_size) (UInt32.t'int fp.sector_size'0))))
    -> ([%#sl2r'13] bd_aligned bpost) -> ([%#sl2r'14] rb1 bpost b0 ds (i + 1) base size fp)

