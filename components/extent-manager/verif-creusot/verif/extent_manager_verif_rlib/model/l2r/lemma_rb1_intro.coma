use creusot.int.UInt64
use creusot.int.UInt32
use seq.Seq
use bv.Pow2int
use int.ComputerDivision
use int.Int

type t_Vec_Vec_u64_Global_Global

type t_BuddyAllocator = {
  base_offset: UInt64.t;
  total_usable_size: UInt64.t;
  sector_size: UInt32.t;
  max_order: UInt64.t;
  free_lists: t_Vec_Vec_u64_Global_Global }

type t_Vec_u64_Global

type t_SlabDescriptor = { start_offset: UInt64.t; slab_size: UInt64.t; element_size: UInt32.t; keys: t_Vec_u64_Global }

type t_Option_u64 = None | Some UInt64.t

type t_FormatParams = {
  data_disk_size'0: UInt64.t;
  slab_size'0: UInt64.t;
  max_extent_size'0: UInt32.t;
  sector_size'0: UInt32.t;
  region_count'0: UInt32.t;
  metadata_alignment'0: UInt64.t;
  instance_id'0: t_Option_u64;
  metadata_disk_ns_id'0: UInt32.t;
  metadata_region_size'0: UInt64.t }

constant const_MAX: UInt64.t = (18446744073709551615: UInt64.t)

function view_Vec_u64_Global (self: t_Vec_u64_Global) : Seq.seq UInt64.t

axiom view_Vec_u64_Global_spec:
  forall self: t_Vec_u64_Global [view_Vec_u64_Global self]. [%#svec] Seq.length (view_Vec_u64_Global self)
    <= UInt64.t'int const_MAX

predicate fv [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/l2.rs" 20 0 20 52] (fl: Seq.seq t_Vec_u64_Global) (o: int) (k: int) =
  [%#sl2'2] 0 <= o /\ o < Seq.length fl /\ 0 <= k /\ k < Seq.length (view_Vec_u64_Global (Seq.get fl o))

predicate disj [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/l2.rs" 32 0 32 55] (x1: int) (l1: int) (x2: int) (l2: int) =
  [%#sl2'3] x1 + l1 <= x2 \/ x2 + l2 <= x1

function fs [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/l2.rs" 26 0 26 51] (fl: Seq.seq t_Vec_u64_Global) (o: int) (k: int) : int
 = [%#sl2'4] UInt64.t'int (Seq.get (view_Vec_u64_Global (Seq.get fl o)) k)

function span [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/buddy.rs" 32 0 32 35] (ss: int) (o: int) : int
 = [%#sbuddy'1] Pow2int.pow2 o * ss

predicate fdisj [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/l2.rs" 38 0 38 48] (fl: Seq.seq t_Vec_u64_Global) (ss: int) =
  [%#sl2] forall o1: int, k1: int, o2: int, k2: int. fv fl o1 k1 /\ fv fl o2 k2 /\ (o1 <> o2 \/ k1 <> k2)
    -> disj (fs fl o1 k1) (span ss o1) (fs fl o2 k2) (span ss o2)

function view_Vec_Vec_u64_Global_Global (self: t_Vec_Vec_u64_Global_Global) : Seq.seq t_Vec_u64_Global

axiom view_Vec_Vec_u64_Global_Global_spec:
  forall self: t_Vec_Vec_u64_Global_Global [view_Vec_Vec_u64_Global_Global self]. [%#svec] Seq.length (view_Vec_Vec_u64_Global_Global self)
    <= UInt64.t'int const_MAX

predicate faway [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/l2.rs" 47 0 47 64] (fl: Seq.seq t_Vec_u64_Global) (ss: int) (y: int) (l: int) =
  [%#sl2'0] forall o: int, k: int. fv fl o k -> disj y l (fs fl o k) (span ss o)

function ord_from [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/buddy.rs" 284 0 284 38] (b: int) (k: int) : int

axiom ord_from_def: forall b: int, k: int [ord_from b k]. ord_from b k
    = ([%#sbuddy'3] if k >= 64 \/ k < 0 \/ Pow2int.pow2 k >= b then k else ord_from b (k + 1))

function ord [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/buddy.rs" 290 0 290 25] (b: int) : int
 = [%#sbuddy] ord_from b 0

function dsk [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/l2r.rs" 579 0 579 35] (fp: t_FormatParams) : int
 =
  [%#sl2r'4] span (UInt32.t'int fp.sector_size'0) (ord (ComputerDivision.div (UInt64.t'int fp.slab_size'0) (UInt32.t'int fp.sector_size'0)))

predicate off_descs [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/l2r.rs" 585 0 585 94] (ds: Seq.seq t_SlabDescriptor) (i: int) (base: int) (fp: t_FormatParams) (t: int) =
  [%#sl2r'5] forall p: int. 0 <= p /\ p < i
    -> disj t (dsk fp) (UInt64.t'int (Seq.get ds p).start_offset - base) (dsk fp)

predicate inblk [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/l2.rs" 67 0 67 65] (fl: Seq.seq t_Vec_u64_Global) (ss: int) (kk: int) (t: int) =
  [%#sl2'1] exists o: int, k: int. fv fl o k /\ o >= kk /\ fs fl o k <= t /\ t + span ss kk <= fs fl o k + span ss o

function tf [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/buddy.rs" 495 4 495 56] (fl: Seq.seq t_Vec_u64_Global) (ss: int) (n: int) : int

predicate rb1 [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/l2r.rs" 592 0 592 130] (b: t_BuddyAllocator) (b0: t_BuddyAllocator) (ds: Seq.seq t_SlabDescriptor) (i: int) (base: int) (size: int) (fp: t_FormatParams) =
  [%#sl2r'6] fdisj (view_Vec_Vec_u64_Global_Global b.free_lists) (UInt32.t'int fp.sector_size'0)
  /\ (forall p: int. 0 <= p /\ p < i
      -> faway (view_Vec_Vec_u64_Global_Global b.free_lists) (UInt32.t'int fp.sector_size'0) (UInt64.t'int (Seq.get ds p).start_offset
      - base) (dsk fp))
  /\ (forall t: int. 0 <= t /\ ComputerDivision.mod t (dsk fp) = 0 /\ t + dsk fp <= size /\ off_descs ds i base fp t
      -> inblk (view_Vec_Vec_u64_Global_Global b.free_lists) (UInt32.t'int fp.sector_size'0) (ord (ComputerDivision.div (UInt64.t'int fp.slab_size'0) (UInt32.t'int fp.sector_size'0))) t)
  /\ tf (view_Vec_Vec_u64_Global_Global b.free_lists) (UInt32.t'int fp.sector_size'0) (Seq.length (view_Vec_Vec_u64_Global_Global b.free_lists))
  = tf (view_Vec_Vec_u64_Global_Global b0.free_lists) (UInt32.t'int fp.sector_size'0) (Seq.length (view_Vec_Vec_u64_Global_Global b0.free_lists))
  - i * dsk fp

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant b : t_BuddyAllocator

constant b0 : t_BuddyAllocator

constant ds : Seq.seq t_SlabDescriptor

constant i : int

constant base : int

constant size : int

constant fp : t_FormatParams

function lemma_rb1_intro [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/l2r.rs" 620 0 620 134] (b: t_BuddyAllocator) (b0: t_BuddyAllocator) (ds: Seq.seq t_SlabDescriptor) (i: int) (base: int) (size: int) (fp: t_FormatParams) : ()

goal vc_lemma_rb1_intro: ([%#sl2r] fdisj (view_Vec_Vec_u64_Global_Global b.free_lists) (UInt32.t'int fp.sector_size'0))
  -> ([%#sl2r'0] forall p: int. 0 <= p /\ p < i
      -> faway (view_Vec_Vec_u64_Global_Global b.free_lists) (UInt32.t'int fp.sector_size'0) (UInt64.t'int (Seq.get ds p).start_offset
      - base) (dsk fp))
  -> ([%#sl2r'1] forall t: int. 0 <= t
        /\ ComputerDivision.mod t (dsk fp) = 0 /\ t + dsk fp <= size /\ off_descs ds i base fp t
      -> inblk (view_Vec_Vec_u64_Global_Global b.free_lists) (UInt32.t'int fp.sector_size'0) (ord (ComputerDivision.div (UInt64.t'int fp.slab_size'0) (UInt32.t'int fp.sector_size'0))) t)
  -> ([%#sl2r'2] tf (view_Vec_Vec_u64_Global_Global b.free_lists) (UInt32.t'int fp.sector_size'0) (Seq.length (view_Vec_Vec_u64_Global_Global b.free_lists))
    = tf (view_Vec_Vec_u64_Global_Global b0.free_lists) (UInt32.t'int fp.sector_size'0) (Seq.length (view_Vec_Vec_u64_Global_Global b0.free_lists))
    - i * dsk fp) -> ([@stop_split] [@expl:lemma_rb1_intro ensures] [%#sl2r'3] rb1 b b0 ds i base size fp)
