meta "select_lsinst" "all"

constant r : t_RegionState

constant k1 : int

constant k2 : int

function lemma_slab_blocks_disj [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/l2r.rs" 305 0 305 63] (r: t_RegionState) (k1: int) (k2: int) : ()

goal vc_lemma_slab_blocks_disj: ([%#sl2r] rg_inv r
    /\ contains_Int (view_SlabMap r.slabs) k1 /\ contains_Int (view_SlabMap r.slabs) k2 /\ k1 <> k2)
  -> ([@stop_split] [@expl:lemma_span_pos requires] [%#sbuddy] UInt32.t'int r.buddy.sector_size > 0 /\ 0 <= slab_k r)
  /\ (([@stop_split] [@expl:lemma_span_pos ensures] ([@stop_split] [@expl:lemma_span_pos ensures #0] [%#sbuddy'0] span (UInt32.t'int r.buddy.sector_size) (slab_k r)
      >= UInt32.t'int r.buddy.sector_size)
    /\ ([@stop_split] [@expl:lemma_span_pos ensures #1] [%#sbuddy'1] span (UInt32.t'int r.buddy.sector_size) (slab_k r)
    > 0))
  -> (let _ = lemma_span_pos (UInt32.t'int r.buddy.sector_size) (slab_k r) in if slab_ok r (lookup_Int (view_SlabMap r.slabs) k1) then
    slab_ok r (lookup_Int (view_SlabMap r.slabs) k2)
    && (if k1 < k2 then
      ([@stop_split] [@expl:lemma_aligned_disj2 requires] [%#sl2] sk r > 0
        /\ k1 - UInt64.t'int r.buddy.base_offset >= 0
        /\ k2 - UInt64.t'int r.buddy.base_offset >= 0
        /\ ComputerDivision.mod (k1 - UInt64.t'int r.buddy.base_offset) (sk r) = 0
        /\ ComputerDivision.mod (k2 - UInt64.t'int r.buddy.base_offset) (sk r) = 0
        /\ k1 - UInt64.t'int r.buddy.base_offset < k2 - UInt64.t'int r.buddy.base_offset)
      /\ (([@stop_split] [@expl:lemma_aligned_disj2 ensures] [%#sl2'0] k1 - UInt64.t'int r.buddy.base_offset + sk r
        <= k2 - UInt64.t'int r.buddy.base_offset)
      -> ([@stop_split] [@expl:lemma_slab_blocks_disj ensures] [%#sl2r'0] disj (k1
      - UInt64.t'int r.buddy.base_offset) (sk r) (k2 - UInt64.t'int r.buddy.base_offset) (sk r)))
    else
      ([@stop_split] [@expl:lemma_aligned_disj2 requires] [%#sl2] sk r > 0
        /\ k2 - UInt64.t'int r.buddy.base_offset >= 0
        /\ k1 - UInt64.t'int r.buddy.base_offset >= 0
        /\ ComputerDivision.mod (k2 - UInt64.t'int r.buddy.base_offset) (sk r) = 0
        /\ ComputerDivision.mod (k1 - UInt64.t'int r.buddy.base_offset) (sk r) = 0
        /\ k2 - UInt64.t'int r.buddy.base_offset < k1 - UInt64.t'int r.buddy.base_offset)
      /\ (([@stop_split] [@expl:lemma_aligned_disj2 ensures] [%#sl2'0] k2 - UInt64.t'int r.buddy.base_offset + sk r
        <= k1 - UInt64.t'int r.buddy.base_offset)
      -> ([@stop_split] [@expl:lemma_slab_blocks_disj ensures] [%#sl2r'0] disj (k1
      - UInt64.t'int r.buddy.base_offset) (sk r) (k2 - UInt64.t'int r.buddy.base_offset) (sk r)))
    )
  else
    false
    && (if k1 < k2 then
      ([@stop_split] [@expl:lemma_aligned_disj2 requires] [%#sl2] sk r > 0
        /\ k1 - UInt64.t'int r.buddy.base_offset >= 0
        /\ k2 - UInt64.t'int r.buddy.base_offset >= 0
        /\ ComputerDivision.mod (k1 - UInt64.t'int r.buddy.base_offset) (sk r) = 0
        /\ ComputerDivision.mod (k2 - UInt64.t'int r.buddy.base_offset) (sk r) = 0
        /\ k1 - UInt64.t'int r.buddy.base_offset < k2 - UInt64.t'int r.buddy.base_offset)
      /\ (([@stop_split] [@expl:lemma_aligned_disj2 ensures] [%#sl2'0] k1 - UInt64.t'int r.buddy.base_offset + sk r
        <= k2 - UInt64.t'int r.buddy.base_offset)
      -> ([@stop_split] [@expl:lemma_slab_blocks_disj ensures] [%#sl2r'0] disj (k1
      - UInt64.t'int r.buddy.base_offset) (sk r) (k2 - UInt64.t'int r.buddy.base_offset) (sk r)))
    else
      ([@stop_split] [@expl:lemma_aligned_disj2 requires] [%#sl2] sk r > 0
        /\ k2 - UInt64.t'int r.buddy.base_offset >= 0
        /\ k1 - UInt64.t'int r.buddy.base_offset >= 0
        /\ ComputerDivision.mod (k2 - UInt64.t'int r.buddy.base_offset) (sk r) = 0
        /\ ComputerDivision.mod (k1 - UInt64.t'int r.buddy.base_offset) (sk r) = 0
        /\ k2 - UInt64.t'int r.buddy.base_offset < k1 - UInt64.t'int r.buddy.base_offset)
