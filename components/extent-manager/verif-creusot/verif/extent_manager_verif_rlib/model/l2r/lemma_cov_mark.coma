function lemma_cov_mark [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/l2r.rs" 630 0 630 91] (a: Seq.seq t_Vec_u64_Global) (b: Seq.seq t_Vec_u64_Global) (ss: int) (kk: int) (x: int) (t: int) : ()

goal vc_lemma_cov_mark: ([%#sl2r] ss > 0
    /\ 0 <= kk /\ fdisj a ss /\ inblk a ss kk t /\ 0 <= t /\ ComputerDivision.mod t (span ss kk) = 0)
  -> ([%#sl2r'0] 0 <= x /\ ComputerDivision.mod x (span ss kk) = 0 /\ disj t (span ss kk) x (span ss kk))
  -> ([%#sl2r'1] forall z: int. ffree a ss z /\ not (x <= z /\ z < x + span ss kk) -> ffree b ss z)
  -> ([%#sl2r'2] fold_k b a kk)
  -> ([%#sl2r'3] forall o: int, k: int. fv b o k -> ComputerDivision.mod (fs b o k) (span ss o) = 0 /\ fs b o k >= 0)
  -> ([@stop_split] [@expl:lemma_span_pos requires] [%#sbuddy] ss > 0 /\ 0 <= kk)
  /\ (([@stop_split] [@expl:lemma_span_pos ensures] ([@stop_split] [@expl:lemma_span_pos ensures #0] [%#sbuddy'0] span ss kk
      >= ss)
    /\ ([@stop_split] [@expl:lemma_span_pos ensures #1] [%#sbuddy'1] span ss kk > 0))
  -> (let _ = lemma_span_pos ss kk in (forall o: int, k: int. fv a o k
        /\ o >= kk /\ fs a o k <= t /\ t + span ss kk <= fs a o k + span ss o -> ffree a ss t)
  && (if ffree a ss t then
    ffree b ss t
    && (forall o2: int, k2: int. if fv b o2 k2 then
          if o2 >= kk then
            if fs b o2 k2 <= t then
              if t < fs b o2 k2 + span ss o2 then
                ([@stop_split] [@expl:lemma_span_mult requires] [%#sl2] ss > 0 /\ 0 <= kk /\ kk <= o2)
                /\ (([@stop_split] [@expl:lemma_span_mult ensures] [%#sl2'0] ComputerDivision.mod (span ss o2) (span ss kk)
                  = 0)
                -> (let _ = lemma_span_mult ss kk o2 in ([@stop_split] [@expl:lemma_span_div requires] ([@stop_split] [@expl:lemma_span_div requires #0] [%#sbuddy'2] ss
                      > 0
                    /\ 0 <= kk /\ kk <= o2 /\ fs b o2 k2 >= 0)
                  /\ ([@stop_split] [@expl:lemma_span_div requires #1] [%#sbuddy'3] ComputerDivision.mod (fs b o2 k2) (span ss o2)
                  = 0))
                /\ (([@stop_split] [@expl:lemma_span_div ensures] [%#sbuddy'4] ComputerDivision.mod (fs b o2 k2) (span ss kk)
                  = 0)
                -> (let _ = lemma_span_div (fs b o2 k2) ss kk o2 in ([@stop_split] [@expl:lemma_span_pos requires] [%#sbuddy] ss
                    > 0
                  /\ 0 <= o2)
                /\ (([@stop_split] [@expl:lemma_span_pos ensures] ([@stop_split] [@expl:lemma_span_pos ensures #0] [%#sbuddy'0] span ss o2
                    >= ss)
                  /\ ([@stop_split] [@expl:lemma_span_pos ensures #1] [%#sbuddy'1] span ss o2 > 0))
                -> (let _ = lemma_span_pos ss o2 in ([@stop_split] [@expl:lemma_lam requires] ([@stop_split] [@expl:lemma_lam requires #0] [%#sl2'1] span ss kk
                      > 0
                    /\ span ss o2 > 0
                    /\ ComputerDivision.mod (span ss o2) (span ss kk) = 0
                    /\ ComputerDivision.mod t (span ss kk) = 0
                    /\ ComputerDivision.mod (fs b o2 k2) (span ss kk) = 0 /\ t >= 0 /\ fs b o2 k2 >= 0)
                  /\ ([@stop_split] [@expl:lemma_lam requires #1] [%#sl2'2] fs b o2 k2 <= t
                  /\ t < fs b o2 k2 + span ss o2))
                /\ (([@stop_split] [@expl:lemma_lam ensures] [%#sl2'3] t + span ss kk <= fs b o2 k2 + span ss o2)
                -> (let _ = lemma_lam t (fs b o2 k2) (span ss kk) (span ss o2) in true))))))))
              else
                true
            
            else
              true
          
          else
            true
        
        else
          true
      )
    /\ (forall o2: int, k2: int. fv b o2 k2 /\ o2 >= kk /\ fs b o2 k2 <= t /\ t < fs b o2 k2 + span ss o2
        -> (let _ = lemma_span_mult ss kk o2 in let _ = lemma_span_div (fs b o2 k2) ss kk o2 in let _ = lemma_span_pos ss o2 in let _ = lemma_lam t (fs b o2 k2) (span ss kk) (span ss o2) in inblk b ss kk t))
    && (forall o2: int, k2: int. if fv b o2 k2 then
          if o2 < kk then
            if 0 <= o2 then
              if fs b o2 k2 <= t then
                if t < fs b o2 k2 + span ss o2 then
                  forall j: int, oF: int, kF: int. if fv a o2 j then
                      if fs a o2 j = fs b o2 k2 then
                        if fv a oF kF then
                          if oF >= kk then
                            if fs a oF kF <= t then
                              if t + span ss kk <= fs a oF kF + span ss oF then
                                ([@stop_split] [@expl:lemma_same_blk requires] ([@stop_split] [@expl:lemma_same_blk requires #0] [%#sl2'4] fdisj a ss
                                    /\ fv a o2 j /\ fv a oF kF)
                                  /\ ([@stop_split] [@expl:lemma_same_blk requires #1] [%#sl2'5] fs a o2 j <= t
                                    /\ t < fs a o2 j + span ss o2)
                                  /\ ([@stop_split] [@expl:lemma_same_blk requires #2] [%#sl2'6] fs a oF kF <= t
                                  /\ t < fs a oF kF + span ss oF))
                                /\ (([@stop_split] [@expl:lemma_same_blk ensures] [%#sl2'7] o2 = oF /\ j = kF)
                                -> (let _ = lemma_same_blk a ss o2 j oF kF t in true))
                              else
                                true
                            
                            else
                              true
                          
                          else
                            true
                        
                        else
                          true
                      
                      else
                        true
                    
                    else
                      true
                
                else
                  true
              
              else
                true
            
            else
              true
          
          else
            true
        
        else
          true
      )
    /\ (forall o2: int, k2: int. fv b o2 k2 /\ o2 < kk /\ 0 <= o2 /\ fs b o2 k2 <= t /\ t < fs b o2 k2 + span ss o2
        -> (forall j: int, oF: int, kF: int. fv a o2 j
            /\ fs a o2 j = fs b o2 k2
            /\ fv a oF kF /\ oF >= kk /\ fs a oF kF <= t /\ t + span ss kk <= fs a oF kF + span ss oF
          -> (let _ = lemma_same_blk a ss o2 j oF kF t in false)))
    && (forall o2: int, k2: int. fv b o2 k2 /\ fs b o2 k2 <= t /\ t < fs b o2 k2 + span ss o2 -> inblk b ss kk t)
    && ([@stop_split] [@expl:lemma_cov_mark ensures] [%#sl2r'4] inblk b ss kk t)
  else
    false
    && (forall o2: int, k2: int. if fv b o2 k2 then
          if o2 >= kk then
            if fs b o2 k2 <= t then
              if t < fs b o2 k2 + span ss o2 then
                ([@stop_split] [@expl:lemma_span_mult requires] [%#sl2] ss > 0 /\ 0 <= kk /\ kk <= o2)
                /\ (([@stop_split] [@expl:lemma_span_mult ensures] [%#sl2'0] ComputerDivision.mod (span ss o2) (span ss kk)
                  = 0)
                -> (let _ = lemma_span_mult ss kk o2 in ([@stop_split] [@expl:lemma_span_div requires] ([@stop_split] [@expl:lemma_span_div requires #0] [%#sbuddy'2] ss
                      > 0
                    /\ 0 <= kk /\ kk <= o2 /\ fs b o2 k2 >= 0)
                  /\ ([@stop_split] [@expl:lemma_span_div requires #1] [%#sbuddy'3] ComputerDivision.mod (fs b o2 k2) (span ss o2)
                  = 0))
                /\ (([@stop_split] [@expl:lemma_span_div ensures] [%#sbuddy'4] ComputerDivision.mod (fs b o2 k2) (span ss kk)
                  = 0)
                -> (let _ = lemma_span_div (fs b o2 k2) ss kk o2 in ([@stop_split] [@expl:lemma_span_pos requires] [%#sbuddy] ss
                    > 0
                  /\ 0 <= o2)
                /\ (([@stop_split] [@expl:lemma_span_pos ensures] ([@stop_split] [@expl:lemma_span_pos ensures #0] [%#sbuddy'0] span ss o2
                    >= ss)
                  /\ ([@stop_split] [@expl:lemma_span_pos ensures #1] [%#sbuddy'1] span ss o2 > 0))
                -> (let _ = lemma_span_pos ss o2 in ([@stop_split] [@expl:lemma_lam requires] ([@stop_split] [@expl:lemma_lam requires #0] [%#sl2'1] span ss kk
                      > 0
                    /\ span ss o2 > 0
                    /\ ComputerDivision.mod (span ss o2) (span ss kk) = 0
                    /\ ComputerDivision.mod t (span ss kk) = 0
                    /\ ComputerDivision.mod (fs b o2 k2) (span ss kk) = 0 /\ t >= 0 /\ fs b o2 k2 >= 0)
                  /\ ([@stop_split] [@expl:lemma_lam requires #1] [%#sl2'2] fs b o2 k2 <= t
                  /\ t < fs b o2 k2 + span ss o2))
                /\ (([@stop_split] [@expl:lemma_lam ensures] [%#sl2'3] t + span ss kk <= fs b o2 k2 + span ss o2)
                -> (let _ = lemma_lam t (fs b o2 k2) (span ss kk) (span ss o2) in true))))))))
              else
                true
            
            else
              true
          
          else
            true
        
        else
          true
      )
    /\ (forall o2: int, k2: int. fv b o2 k2 /\ o2 >= kk /\ fs b o2 k2 <= t /\ t < fs b o2 k2 + span ss o2
        -> (let _ = lemma_span_mult ss kk o2 in let _ = lemma_span_div (fs b o2 k2) ss kk o2 in let _ = lemma_span_pos ss o2 in let _ = lemma_lam t (fs b o2 k2) (span ss kk) (span ss o2) in inblk b ss kk t))
    && (forall o2: int, k2: int. if fv b o2 k2 then
          if o2 < kk then
            if 0 <= o2 then
              if fs b o2 k2 <= t then
                if t < fs b o2 k2 + span ss o2 then
                  forall j: int, oF: int, kF: int. if fv a o2 j then
                      if fs a o2 j = fs b o2 k2 then
                        if fv a oF kF then
                          if oF >= kk then
                            if fs a oF kF <= t then
                              if t + span ss kk <= fs a oF kF + span ss oF then
                                ([@stop_split] [@expl:lemma_same_blk requires] ([@stop_split] [@expl:lemma_same_blk requires #0] [%#sl2'4] fdisj a ss
                                    /\ fv a o2 j /\ fv a oF kF)
                                  /\ ([@stop_split] [@expl:lemma_same_blk requires #1] [%#sl2'5] fs a o2 j <= t
                                    /\ t < fs a o2 j + span ss o2)
                                  /\ ([@stop_split] [@expl:lemma_same_blk requires #2] [%#sl2'6] fs a oF kF <= t
                                  /\ t < fs a oF kF + span ss oF))
                                /\ (([@stop_split] [@expl:lemma_same_blk ensures] [%#sl2'7] o2 = oF /\ j = kF)
                                -> (let _ = lemma_same_blk a ss o2 j oF kF t in true))
                              else
                                true
                            
                            else
