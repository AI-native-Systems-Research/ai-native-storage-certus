predicate listed [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/region.rs" 887 0 887 43] (sq: Seq.seq UInt64.t) (k: int) =
  [%#sregion] exists p: int. 0 <= p /\ p < Seq.length sq /\ UInt64.t'int (Seq.get sq p) = k

predicate sc_sub [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/l2r.rs" 35 0 35 80] (a: t_SizeClassManager) (b: t_SizeClassManager) (es: int) (d: int) =
  [%#sl2r'3] forall e: int, p: int. 0 <= p /\ p < Seq.length (sc_get b e)
    -> listed (sc_get a e) (UInt64.t'int (Seq.get (sc_get b e) p))
    \/ e = es /\ UInt64.t'int (Seq.get (sc_get b e) p) = d

