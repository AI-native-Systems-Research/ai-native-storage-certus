axiom lemma_distrib_spec: forall a: int, b: int, c: int. [%#sbuddy'12] (a + b) * c = a * c + b * c

function lemma_tf_one [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/buddy.rs" 520 4 520 84] (a: Seq.seq t_Vec_u64_Global) (b: Seq.seq t_Vec_u64_Global) (ss: int) (o: int) (n: int) : ()

axiom lemma_tf_one_def:
  forall a: Seq.seq t_Vec_u64_Global, b: Seq.seq t_Vec_u64_Global, ss: int, o: int, n: int [lemma_tf_one a b ss o n]. ([%#sbuddy'4] 0
        <= n
      /\ n <= Seq.length a /\ Seq.length a = Seq.length b)
    -> ([%#sbuddy'5] forall p: int. 0 <= p /\ p < Seq.length a /\ p <> o
        -> Seq.length (view_Vec_u64_Global (Seq.get a p)) = Seq.length (view_Vec_u64_Global (Seq.get b p)))
    -> lemma_tf_one a b ss o n
    = ([%#sbuddy'11] if n > 0 then
