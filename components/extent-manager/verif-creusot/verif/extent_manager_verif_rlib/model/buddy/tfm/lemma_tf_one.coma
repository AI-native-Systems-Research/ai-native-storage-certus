    -> ([@stop_split] [@expl:view ensures] [%#svec] Seq.length (view_Vec_u64_Global (Seq.get b (n - 1)))
      <= UInt64.t'int const_MAX)
    -> ([@stop_split] [@expl:lemma_distrib ensures] [%#sbuddy'3] (Seq.length (view_Vec_u64_Global (Seq.get a (n - 1)))
            - Seq.length (view_Vec_u64_Global (Seq.get b (n - 1)))
          + Seq.length (view_Vec_u64_Global (Seq.get b (n - 1))))
        * span ss (n - 1)
      = (Seq.length (view_Vec_u64_Global (Seq.get a (n - 1))) - Seq.length (view_Vec_u64_Global (Seq.get b (n - 1))))
