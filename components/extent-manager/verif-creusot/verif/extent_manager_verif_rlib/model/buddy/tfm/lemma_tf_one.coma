            <= n - 1
          /\ n - 1 <= Seq.length a /\ Seq.length a = Seq.length b)
        /\ ([@stop_split] [@expl:lemma_tf_one requires #1] [%#sbuddy'1] forall p: int. 0 <= p
            /\ p < Seq.length a /\ p <> o
          -> Seq.length (view_Vec_u64_Global (Seq.get a p)) = Seq.length (view_Vec_u64_Global (Seq.get b p))))
      /\ ([@expl:variant decreases] well_founded_relation_Int ([%#sbuddy] n) ([%#sbuddy] n - 1)))
    /\ (([@stop_split] [@expl:lemma_tf_one ensures] [%#sbuddy'2] tf a ss (n - 1)
