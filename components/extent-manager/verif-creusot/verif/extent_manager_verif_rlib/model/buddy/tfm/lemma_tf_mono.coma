constant n : int

function lemma_tf_mono [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/buddy.rs" 504 4 504 60] (fl: Seq.seq t_Vec_u64_Global) (ss: int) (n: int) : ()

goal vc_lemma_tf_mono: ([%#sbuddy'0] ss > 0 /\ 0 <= n)
  -> (if n > 0 then
    (([@stop_split] [@expl:lemma_tf_mono requires] [%#sbuddy'0] ss > 0 /\ 0 <= n - 1)
      /\ ([@expl:variant decreases] well_founded_relation_Int ([%#sbuddy] n) ([%#sbuddy] n - 1)))
    /\ (([@stop_split] [@expl:lemma_tf_mono ensures] [%#sbuddy'1] forall m: int. 0 <= m /\ m <= n - 1
        -> 0 <= tf fl ss m /\ tf fl ss m <= tf fl ss (n - 1))
    -> (let _ = lemma_tf_mono fl ss (n - 1) in ([@stop_split] [@expl:lemma_span_pos requires] [%#sbuddy'2] ss > 0
      /\ 0 <= n - 1)
    /\ (([@stop_split] [@expl:lemma_span_pos ensures] ([@stop_split] [@expl:lemma_span_pos ensures #0] [%#sbuddy'3] span ss (n
          - 1)
        >= ss)
      /\ ([@stop_split] [@expl:lemma_span_pos ensures #1] [%#sbuddy'4] span ss (n - 1) > 0))
    -> (let _ = lemma_span_pos ss (n
    - 1) in ([@stop_split] [@expl:view ensures] [%#svec] Seq.length (view_Vec_u64_Global (Seq.get fl (n - 1)))
      <= UInt64.t'int const_MAX)
    -> ([@stop_split] [@expl:lemma_mul_le requires] [%#sbuddy'5] 0 <= 0
      /\ 0 <= Seq.length (view_Vec_u64_Global (Seq.get fl (n - 1))) /\ 0 <= span ss (n - 1))
    /\ (([@stop_split] [@expl:lemma_mul_le ensures] [%#sbuddy'6] 0 * span ss (n - 1)
      <= Seq.length (view_Vec_u64_Global (Seq.get fl (n - 1))) * span ss (n - 1))
    -> ([@stop_split] [@expl:lemma_tf_mono ensures] [%#sbuddy'1] forall m: int. 0 <= m /\ m <= n
      -> 0 <= tf fl ss m /\ tf fl ss m <= tf fl ss n))))))
  else
    [@stop_split] [@expl:lemma_tf_mono ensures] [%#sbuddy'1] forall m: int. 0 <= m /\ m <= n
      -> 0 <= tf fl ss m /\ tf fl ss m <= tf fl ss n
  )
