use seq.Seq
use creusot.int.UInt64
use bv.Pow2int
use int.Int

type t_Vec_u64_Global

constant const_MAX: UInt64.t = (18446744073709551615: UInt64.t)

function view_Vec_u64_Global (self: t_Vec_u64_Global) : Seq.seq UInt64.t

axiom view_Vec_u64_Global_spec:
  forall self: t_Vec_u64_Global [view_Vec_u64_Global self]. [%#svec] Seq.length (view_Vec_u64_Global self)
    <= UInt64.t'int const_MAX

function span [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/buddy.rs" 32 0 32 35] (ss: int) (o: int) : int
 = [%#sbuddy'10] Pow2int.pow2 o * ss

function tf [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/buddy.rs" 495 4 495 56] (fl: Seq.seq t_Vec_u64_Global) (ss: int) (n: int) : int

axiom tf_def: forall fl: Seq.seq t_Vec_u64_Global, ss: int, n: int [tf fl ss n]. tf fl ss n
    = ([%#sbuddy'8] if n <= 0 then
      0
    else
      tf fl ss (n - 1) + Seq.length (view_Vec_u64_Global (Seq.get fl (n - 1))) * span ss (n - 1)
    )

predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
  [%#swell_founded] self >= 0 /\ self > other

meta "rewrite_def" predicate well_founded_relation_Int

function lemma_pow2 [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/buddy.rs" 49 0 49 25] (o: int) : ()

axiom lemma_pow2_def: forall o: int [lemma_pow2 o]. ([%#sbuddy'13] 0 <= o)
    -> lemma_pow2 o = ([%#sbuddy'16] if o > 0 then lemma_pow2 (o - 1) else ())

axiom lemma_pow2_spec: forall o: int. ([%#sbuddy'13] 0 <= o) -> ([%#sbuddy'14] Pow2int.pow2 o >= 1)

axiom lemma_pow2_spec'0: forall o: int. ([%#sbuddy'13] 0 <= o)
    -> ([%#sbuddy'15] Pow2int.pow2 (o + 1) = 2 * Pow2int.pow2 o)

function lemma_mul_le [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/buddy.rs" 156 0 156 43] (a: int) (b: int) (c: int) : ()
 = [%#sbuddy'11] ()

axiom lemma_mul_le_spec: forall a: int, b: int, c: int. ([%#sbuddy'5] 0 <= a /\ a <= b /\ 0 <= c)
    -> ([%#sbuddy'6] a * c <= b * c)

function lemma_span_pos [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/buddy.rs" 114 0 114 38] (ss: int) (o: int) : ()
 = [%#sbuddy'9] let _ = lemma_pow2 o in lemma_mul_le 1 (Pow2int.pow2 o) ss

axiom lemma_span_pos_spec: forall ss: int, o: int. ([%#sbuddy'2] ss > 0 /\ 0 <= o) -> ([%#sbuddy'3] span ss o >= ss)

axiom lemma_span_pos_spec'0: forall ss: int, o: int. ([%#sbuddy'2] ss > 0 /\ 0 <= o) -> ([%#sbuddy'4] span ss o > 0)

