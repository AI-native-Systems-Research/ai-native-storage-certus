function lemma_div_sub [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/buddy.rs" 124 0 124 36] (x: int) (m: int) : ()

goal vc_lemma_div_sub: ([%#sbuddy] m > 0 /\ x >= m /\ ComputerDivision.mod x m = 0)
  -> ([@stop_split] [@expl:lemma_divmod requires] [%#sbuddy'2] m > 0 /\ x >= 0)
  /\ (([@stop_split] [@expl:lemma_divmod ensures] ([@stop_split] [@expl:lemma_divmod ensures #0] [%#sbuddy'3] x
      = m * ComputerDivision.div x m + ComputerDivision.mod x m)
    /\ ([@stop_split] [@expl:lemma_divmod ensures #1] [%#sbuddy'4] 0 <= ComputerDivision.mod x m
      /\ ComputerDivision.mod x m < m)
    /\ ([@stop_split] [@expl:lemma_divmod ensures #2] [%#sbuddy'5] ComputerDivision.div x m >= 0))
  -> (let _ = lemma_divmod x m in ([@stop_split] [@expl:lemma_mul_mod0 requires] [%#sbuddy'6] m > 0
    /\ ComputerDivision.div x m - 1 >= 0)
  /\ (([@stop_split] [@expl:lemma_mul_mod0 ensures] ([@stop_split] [@expl:lemma_mul_mod0 ensures #0] [%#sbuddy'7] ComputerDivision.mod (m
        * (ComputerDivision.div x m - 1)) m
      = 0)
    /\ ([@stop_split] [@expl:lemma_mul_mod0 ensures #1] [%#sbuddy'8] ComputerDivision.div (m
      * (ComputerDivision.div x m - 1)) m
    = ComputerDivision.div x m - 1))
  -> ([@stop_split] [@expl:lemma_div_sub ensures] ([@stop_split] [@expl:lemma_div_sub ensures #0] [%#sbuddy'0] ComputerDivision.div (x
      - m) m
    = ComputerDivision.div x m - 1)
  /\ ([@stop_split] [@expl:lemma_div_sub ensures #1] [%#sbuddy'1] ComputerDivision.mod (x - m) m = 0)))))
