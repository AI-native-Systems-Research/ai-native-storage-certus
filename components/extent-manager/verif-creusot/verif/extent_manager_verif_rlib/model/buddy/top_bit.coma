use creusot.int.UInt64BW
use creusot.int.UInt32BW
use bv.Pow2int
use creusot.prelude.Any
use int.Int

type t_Ordering = Less | Equal | Greater

function cmp_log_u32 (self: UInt32BW.t) (o: UInt32BW.t) : t_Ordering = [%#sord'12] if UInt32BW.lt self o then
    Less
  else
    if self = o then Equal else Greater


function eq_cmp_u32 (x: UInt32BW.t) (y: UInt32BW.t) : ()

axiom eq_cmp_u32_spec: forall x: UInt32BW.t, y: UInt32BW.t. [%#sord'11] (x = y) = (cmp_log_u32 x y = Equal)

function antisym2_u32 (x: UInt32BW.t) (y: UInt32BW.t) : ()

axiom antisym2_u32_spec: forall x: UInt32BW.t, y: UInt32BW.t. ([%#sord'9] cmp_log_u32 x y = Greater)
    -> ([%#sord'10] cmp_log_u32 y x = Less)

function antisym1_u32 (x: UInt32BW.t) (y: UInt32BW.t) : ()

axiom antisym1_u32_spec: forall x: UInt32BW.t, y: UInt32BW.t. ([%#sord'7] cmp_log_u32 x y = Less)
    -> ([%#sord'8] cmp_log_u32 y x = Greater)

function trans_u32 (x: UInt32BW.t) (y: UInt32BW.t) (z: UInt32BW.t) (o: t_Ordering) : ()

axiom trans_u32_spec: forall x: UInt32BW.t, y: UInt32BW.t, z: UInt32BW.t, o: t_Ordering. ([%#sord'4] cmp_log_u32 x y
      = o) -> ([%#sord'5] cmp_log_u32 y z = o) -> ([%#sord'6] cmp_log_u32 x z = o)

function refl_u32 (x: UInt32BW.t) : ()

axiom refl_u32_spec: forall x: UInt32BW.t. [%#sord'3] cmp_log_u32 x x = Equal

function cmp_gt_log_u32 (x: UInt32BW.t) (y: UInt32BW.t) : ()

axiom cmp_gt_log_u32_spec: forall x: UInt32BW.t, y: UInt32BW.t. [%#sord'2] UInt32BW.gt x y = (cmp_log_u32 x y = Greater)

function cmp_ge_log_u32 (x: UInt32BW.t) (y: UInt32BW.t) : ()

axiom cmp_ge_log_u32_spec: forall x: UInt32BW.t, y: UInt32BW.t. [%#sord'1] UInt32BW.ge x y = (cmp_log_u32 x y <> Less)

function cmp_lt_log_u32 (x: UInt32BW.t) (y: UInt32BW.t) : ()

axiom cmp_lt_log_u32_spec: forall x: UInt32BW.t, y: UInt32BW.t. [%#sord'0] UInt32BW.lt x y = (cmp_log_u32 x y = Less)

function cmp_le_log_u32 (x: UInt32BW.t) (y: UInt32BW.t) : ()

axiom cmp_le_log_u32_spec: forall x: UInt32BW.t, y: UInt32BW.t. [%#sord] UInt32BW.le x y = (cmp_log_u32 x y <> Greater)

constant const_BITS: UInt32BW.t = (64: UInt32BW.t)

function leading_zeros_u64 (self: UInt64BW.t) : UInt32BW.t

axiom leading_zeros_u64_spec:
  forall self: UInt64BW.t [leading_zeros_u64 self]. [%#snum'0] UInt32BW.le (leading_zeros_u64 self) const_BITS

axiom leading_zeros_u64_spec'0: forall self: UInt64BW.t [leading_zeros_u64 self]. [%#snum'1] (leading_zeros_u64 self
      <> const_BITS)
    = (UInt64BW.shr self (UInt64BW.of_BV256 (UInt32BW.to_BV256 (UInt32BW.sub (UInt32BW.sub const_BITS (leading_zeros_u64 self)) (1: UInt32BW.t))))
    = (1: UInt64BW.t))

axiom leading_zeros_u64_spec'1: forall self: UInt64BW.t [leading_zeros_u64 self]. [%#snum'2] (leading_zeros_u64 self
      = const_BITS)
    = (self = (0: UInt64BW.t))

let leading_zeros (self_: UInt64BW.t) (return (x: UInt32BW.t)) = any
  [ return (result: UInt32BW.t) -> {[@stop_split] [@expl:leading_zeros ensures] [%#snum] result
    = leading_zeros_u64 self_}
    (! return {result}) ]

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let top_bit [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/buddy.rs" 258 0 258 31]
  (x: UInt64BW.t) (return (x'0: UInt64BW.t)) = {[@stop_split] [@expl:top_bit requires] [%#sbuddy'4] UInt64BW.t'int x
  > 0}
  (! bb0
  [ bb0 = s0
    [ s0 = leading_zeros [%#sbuddy] {x} (fun (_x: UInt32BW.t) -> [ &lz <- _x ] s1)
    | s1 = {[@expl:assertion] [%#sbuddy'0] UInt64BW.t'int x
      < Pow2int.pow2 (UInt32BW.t'int (UInt32BW.sub (64: UInt32BW.t) lz))}
      s2
    | s2 = {[@expl:assertion] [%#sbuddy'1] Pow2int.pow2 (UInt32BW.t'int (UInt32BW.sub (63: UInt32BW.t) lz))
      <= UInt64BW.t'int x}
      s3
    | s3 = [ &_19 <- UInt64BW.of_BV256 (UInt32BW.to_BV256 lz) ] s4
    | s4 = UInt64BW.sub [%#sbuddy'3] {[%#sbuddy'2] (63: UInt64BW.t)} {_19} (fun (_x: UInt64BW.t) -> [ &_ret <- _x ] s5)
    | s5 = return {_ret} ] ]
  [ & _ret: UInt64BW.t = Any.any_l ()
  | & x: UInt64BW.t = x
  | & lz: UInt32BW.t = Any.any_l ()
  | & _19: UInt64BW.t = Any.any_l () ])
  [ return (result: UInt64BW.t) ->
  {[@stop_split] [@expl:top_bit ensures] ([@stop_split] [@expl:top_bit ensures #0] [%#sbuddy'5] UInt64BW.t'int result
      < 64)
    /\ ([@stop_split] [@expl:top_bit ensures #1] [%#sbuddy'6] Pow2int.pow2 (UInt64BW.t'int result) <= UInt64BW.t'int x
      /\ UInt64BW.t'int x < Pow2int.pow2 (UInt64BW.t'int result + 1))
    /\ ([@stop_split] [@expl:top_bit ensures #2] [%#sbuddy'7] UInt64BW.t'int result
    = 63 - UInt32BW.t'int (leading_zeros_u64 x))}
    (! return {result}) ]
