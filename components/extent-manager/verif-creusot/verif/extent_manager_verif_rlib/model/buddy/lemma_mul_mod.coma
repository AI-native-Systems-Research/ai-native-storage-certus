function lemma_divmod [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/buddy.rs" 184 0 184 35] (x: int) (m: int) : ()
 = [%#sbuddy'8] ()

axiom lemma_divmod_spec: forall x: int, m: int. ([%#sbuddy'1] m > 0 /\ x >= 0)
    -> ([%#sbuddy'2] x = m * ComputerDivision.div x m + ComputerDivision.mod x m)

axiom lemma_divmod_spec'0: forall x: int, m: int. ([%#sbuddy'1] m > 0 /\ x >= 0)
    -> ([%#sbuddy'3] 0 <= ComputerDivision.mod x m /\ ComputerDivision.mod x m < m)

axiom lemma_divmod_spec'1: forall x: int, m: int. ([%#sbuddy'1] m > 0 /\ x >= 0)
