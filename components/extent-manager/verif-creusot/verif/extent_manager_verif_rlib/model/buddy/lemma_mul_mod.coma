constant x : int

constant p : int

constant c : int

function lemma_mul_mod [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/buddy.rs" 226 0 226 44] (x: int) (p: int) (c: int) : ()

goal vc_lemma_mul_mod: ([%#sbuddy] p > 0 /\ c > 0 /\ x >= 0 /\ ComputerDivision.mod x p = 0)
  -> ([@stop_split] [@expl:lemma_divmod requires] [%#sbuddy'1] p > 0 /\ x >= 0)
  /\ (([@stop_split] [@expl:lemma_divmod ensures] ([@stop_split] [@expl:lemma_divmod ensures #0] [%#sbuddy'2] x
      = p * ComputerDivision.div x p + ComputerDivision.mod x p)
    /\ ([@stop_split] [@expl:lemma_divmod ensures #1] [%#sbuddy'3] 0 <= ComputerDivision.mod x p
      /\ ComputerDivision.mod x p < p)
    /\ ([@stop_split] [@expl:lemma_divmod ensures #2] [%#sbuddy'4] ComputerDivision.div x p >= 0))
  -> (let _ = lemma_divmod x p in ([@stop_split] [@expl:lemma_mul_mod0 requires] [%#sbuddy'5] p * c > 0
    /\ ComputerDivision.div x p >= 0)
  /\ (([@stop_split] [@expl:lemma_mul_mod0 ensures] ([@stop_split] [@expl:lemma_mul_mod0 ensures #0] [%#sbuddy'6] ComputerDivision.mod (p
          * c
        * ComputerDivision.div x p) (p * c)
      = 0)
    /\ ([@stop_split] [@expl:lemma_mul_mod0 ensures #1] [%#sbuddy'7] ComputerDivision.div (p * c
      * ComputerDivision.div x p) (p * c)
    = ComputerDivision.div x p))
  -> ([@stop_split] [@expl:lemma_mul_mod ensures] [%#sbuddy'0] ComputerDivision.mod (x * c) (p * c) = 0))))
