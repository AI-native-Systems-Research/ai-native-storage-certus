function lemma_ord_eq [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/buddy.rs" 299 0 299 43] (b: int) (k: int) (r: int) : ()

goal vc_lemma_ord_eq: ([%#sbuddy'0] 0 <= k /\ k <= r /\ is_order r b)
  -> ([%#sbuddy'1] k = 0 \/ Pow2int.pow2 (k - 1) < b)
  -> (if k < r then
    ([@stop_split] [@expl:lemma_pow2_mono requires] [%#sbuddy'3] 0 <= k /\ k <= r - 1)
    /\ (([@stop_split] [@expl:lemma_pow2_mono ensures] [%#sbuddy'4] Pow2int.pow2 k <= Pow2int.pow2 (r - 1))
    -> (let _ = lemma_pow2_mono k (r
    - 1) in (([@stop_split] [@expl:lemma_ord_eq requires] ([@stop_split] [@expl:lemma_ord_eq requires #0] [%#sbuddy'0] 0
            <= k + 1
          /\ k + 1 <= r /\ is_order r b)
        /\ ([@stop_split] [@expl:lemma_ord_eq requires #1] [%#sbuddy'1] k + 1 = 0 \/ Pow2int.pow2 (k + 1 - 1) < b))
      /\ ([@expl:variant decreases] well_founded_relation_Int ([%#sbuddy] r - k) ([%#sbuddy] r - (k + 1))))
    /\ (([@stop_split] [@expl:lemma_ord_eq ensures] [%#sbuddy'2] ord_from b (k + 1) = r)
    -> ([@stop_split] [@expl:lemma_ord_eq ensures] [%#sbuddy'2] ord_from b k = r))))
  else
    [@stop_split] [@expl:lemma_ord_eq ensures] [%#sbuddy'2] ord_from b k = r
  )
