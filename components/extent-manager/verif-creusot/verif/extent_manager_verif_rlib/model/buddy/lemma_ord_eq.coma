axiom lemma_pow2_spec: forall o: int. ([%#sbuddy'11] 0 <= o) -> ([%#sbuddy'12] Pow2int.pow2 o >= 1)

axiom lemma_pow2_spec'0: forall o: int. ([%#sbuddy'11] 0 <= o)
    -> ([%#sbuddy'13] Pow2int.pow2 (o + 1) = 2 * Pow2int.pow2 o)

function lemma_pow2_mono [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/buddy.rs" 59 0 59 38] (a: int) (b: int) : ()

axiom lemma_pow2_mono_def: forall a: int, b: int [lemma_pow2_mono a b]. ([%#sbuddy'3] 0 <= a /\ a <= b)
    -> lemma_pow2_mono a b
    = ([%#sbuddy'9] let _ = lemma_pow2 a in if a < b then
      let _ = lemma_pow2 (b - 1) in lemma_pow2_mono a (b - 1)
    else
