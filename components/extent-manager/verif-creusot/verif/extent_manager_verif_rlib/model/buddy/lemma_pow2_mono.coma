use bv.Pow2int
use int.Int

function lemma_pow2 [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/buddy.rs" 49 0 49 25] (o: int) : ()

axiom lemma_pow2_def: forall o: int [lemma_pow2 o]. ([%#sbuddy'2] 0 <= o)
    -> lemma_pow2 o = ([%#sbuddy'6] if o > 0 then lemma_pow2 (o - 1) else ())

axiom lemma_pow2_spec: forall o: int. ([%#sbuddy'2] 0 <= o) -> ([%#sbuddy'3] Pow2int.pow2 o >= 1)

axiom lemma_pow2_spec'0: forall o: int. ([%#sbuddy'2] 0 <= o)
    -> ([%#sbuddy'4] Pow2int.pow2 (o + 1) = 2 * Pow2int.pow2 o)

predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
  [%#swell_founded] self >= 0 /\ self > other

meta "rewrite_def" predicate well_founded_relation_Int

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant a : int

constant b : int

function lemma_pow2_mono [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/buddy.rs" 59 0 59 38] (a: int) (b: int) : ()

goal vc_lemma_pow2_mono: ([%#sbuddy'0] 0 <= a /\ a <= b)
  -> ([@stop_split] [@expl:lemma_pow2 requires] [%#sbuddy'2] 0 <= a)
  /\ (([@stop_split] [@expl:lemma_pow2 ensures] ([@stop_split] [@expl:lemma_pow2 ensures #0] [%#sbuddy'3] Pow2int.pow2 a
      >= 1)
    /\ ([@stop_split] [@expl:lemma_pow2 ensures #1] [%#sbuddy'4] Pow2int.pow2 (a + 1) = 2 * Pow2int.pow2 a))
  -> (let _ = lemma_pow2 a in if a < b then
    ([@stop_split] [@expl:lemma_pow2 requires] [%#sbuddy'2] 0 <= b - 1)
    /\ (([@stop_split] [@expl:lemma_pow2 ensures] ([@stop_split] [@expl:lemma_pow2 ensures #0] [%#sbuddy'3] Pow2int.pow2 (b
          - 1)
        >= 1)
      /\ ([@stop_split] [@expl:lemma_pow2 ensures #1] [%#sbuddy'4] Pow2int.pow2 (b - 1 + 1) = 2 * Pow2int.pow2 (b - 1)))
    -> (let _ = lemma_pow2 (b - 1) in (([@stop_split] [@expl:lemma_pow2_mono requires] [%#sbuddy'0] 0 <= a
        /\ a <= b - 1)
      /\ ([@expl:variant decreases] well_founded_relation_Int ([%#sbuddy] b - a) ([%#sbuddy] b - 1 - a)))
    /\ (([@stop_split] [@expl:lemma_pow2_mono ensures] [%#sbuddy'1] Pow2int.pow2 a <= Pow2int.pow2 (b - 1))
    -> ([@stop_split] [@expl:lemma_pow2_mono ensures] [%#sbuddy'1] Pow2int.pow2 a <= Pow2int.pow2 b))))
  else
    [@stop_split] [@expl:lemma_pow2_mono ensures] [%#sbuddy'1] Pow2int.pow2 a <= Pow2int.pow2 b
  ))
