function lemma_span_mono [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/buddy.rs" 104 0 104 47] (ss: int) (a: int) (b: int) : ()

goal vc_lemma_span_mono: ([%#sbuddy] 0 <= a /\ a <= b /\ 0 <= ss)
  -> ([@stop_split] [@expl:lemma_pow2 requires] [%#sbuddy'1] 0 <= a)
  /\ (([@stop_split] [@expl:lemma_pow2 ensures] ([@stop_split] [@expl:lemma_pow2 ensures #0] [%#sbuddy'2] Pow2int.pow2 a
      >= 1)
    /\ ([@stop_split] [@expl:lemma_pow2 ensures #1] [%#sbuddy'3] Pow2int.pow2 (a + 1) = 2 * Pow2int.pow2 a))
  -> (let _ = lemma_pow2 a in ([@stop_split] [@expl:lemma_pow2_mono requires] [%#sbuddy'4] 0 <= a /\ a <= b)
  /\ (([@stop_split] [@expl:lemma_pow2_mono ensures] [%#sbuddy'5] Pow2int.pow2 a <= Pow2int.pow2 b)
  -> (let _ = lemma_pow2_mono a b in ([@stop_split] [@expl:lemma_mul_le requires] [%#sbuddy'6] 0 <= Pow2int.pow2 a
    /\ Pow2int.pow2 a <= Pow2int.pow2 b /\ 0 <= ss)
  /\ (([@stop_split] [@expl:lemma_mul_le ensures] [%#sbuddy'7] Pow2int.pow2 a * ss <= Pow2int.pow2 b * ss)
  -> ([@stop_split] [@expl:lemma_span_mono ensures] [%#sbuddy'0] span ss a <= span ss b))))))
