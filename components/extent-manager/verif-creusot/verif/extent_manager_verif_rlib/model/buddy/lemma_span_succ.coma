function lemma_span_succ [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/buddy.rs" 95 0 95 39] (ss: int) (o: int) : ()

goal vc_lemma_span_succ: ([%#sbuddy] 0 <= o)
  -> ([@stop_split] [@expl:lemma_pow2 requires] [%#sbuddy'1] 0 <= o)
  /\ (([@stop_split] [@expl:lemma_pow2 ensures] ([@stop_split] [@expl:lemma_pow2 ensures #0] [%#sbuddy'2] Pow2int.pow2 o
      >= 1)
    /\ ([@stop_split] [@expl:lemma_pow2 ensures #1] [%#sbuddy'3] Pow2int.pow2 (o + 1) = 2 * Pow2int.pow2 o))
  -> (let _ = lemma_pow2 o in Pow2int.pow2 (o + 1) = 2 * Pow2int.pow2 o
  && 2 * Pow2int.pow2 o * ss = 2 * (Pow2int.pow2 o * ss)
  && ([@stop_split] [@expl:lemma_span_succ ensures] [%#sbuddy'0] span ss (o + 1) = 2 * span ss o)))
