use int.ComputerDivision
use int.Int

function lemma_divmod [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/buddy.rs" 184 0 184 35] (x: int) (m: int) : ()
 = [%#sbuddy'9] ()

axiom lemma_divmod_spec: forall x: int, m: int. ([%#sbuddy'2] m > 0 /\ x >= 0)
    -> ([%#sbuddy'3] x = m * ComputerDivision.div x m + ComputerDivision.mod x m)

axiom lemma_divmod_spec'0: forall x: int, m: int. ([%#sbuddy'2] m > 0 /\ x >= 0)
    -> ([%#sbuddy'4] 0 <= ComputerDivision.mod x m /\ ComputerDivision.mod x m < m)

axiom lemma_divmod_spec'1: forall x: int, m: int. ([%#sbuddy'2] m > 0 /\ x >= 0)
    -> ([%#sbuddy'5] ComputerDivision.div x m >= 0)

function lemma_mul_mod0 [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/buddy.rs" 170 0 170 37] (m: int) (k: int) : ()
 = [%#sbuddy'10] ()

axiom lemma_mul_mod0_spec: forall m: int, k: int. ([%#sbuddy'6] m > 0 /\ k >= 0)
    -> ([%#sbuddy'7] ComputerDivision.mod (m * k) m = 0)

axiom lemma_mul_mod0_spec'0: forall m: int, k: int. ([%#sbuddy'6] m > 0 /\ k >= 0)
    -> ([%#sbuddy'8] ComputerDivision.div (m * k) m = k)

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant x : int

constant y : int

constant m : int

function lemma_mod_add [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/buddy.rs" 214 0 214 44] (x: int) (y: int) (m: int) : ()

goal vc_lemma_mod_add: ([%#sbuddy] m > 0
    /\ x >= 0 /\ y >= 0 /\ ComputerDivision.mod x m = 0 /\ ComputerDivision.mod y m = 0)
  -> ([@stop_split] [@expl:lemma_divmod requires] [%#sbuddy'2] m > 0 /\ x >= 0)
  /\ (([@stop_split] [@expl:lemma_divmod ensures] ([@stop_split] [@expl:lemma_divmod ensures #0] [%#sbuddy'3] x
      = m * ComputerDivision.div x m + ComputerDivision.mod x m)
    /\ ([@stop_split] [@expl:lemma_divmod ensures #1] [%#sbuddy'4] 0 <= ComputerDivision.mod x m
      /\ ComputerDivision.mod x m < m)
    /\ ([@stop_split] [@expl:lemma_divmod ensures #2] [%#sbuddy'5] ComputerDivision.div x m >= 0))
  -> (let _ = lemma_divmod x m in ([@stop_split] [@expl:lemma_divmod requires] [%#sbuddy'2] m > 0 /\ y >= 0)
  /\ (([@stop_split] [@expl:lemma_divmod ensures] ([@stop_split] [@expl:lemma_divmod ensures #0] [%#sbuddy'3] y
      = m * ComputerDivision.div y m + ComputerDivision.mod y m)
    /\ ([@stop_split] [@expl:lemma_divmod ensures #1] [%#sbuddy'4] 0 <= ComputerDivision.mod y m
      /\ ComputerDivision.mod y m < m)
    /\ ([@stop_split] [@expl:lemma_divmod ensures #2] [%#sbuddy'5] ComputerDivision.div y m >= 0))
  -> (let _ = lemma_divmod y m in ([@stop_split] [@expl:lemma_mul_mod0 requires] [%#sbuddy'6] m > 0
    /\ ComputerDivision.div x m + ComputerDivision.div y m >= 0)
  /\ (([@stop_split] [@expl:lemma_mul_mod0 ensures] ([@stop_split] [@expl:lemma_mul_mod0 ensures #0] [%#sbuddy'7] ComputerDivision.mod (m
        * (ComputerDivision.div x m + ComputerDivision.div y m)) m
      = 0)
    /\ ([@stop_split] [@expl:lemma_mul_mod0 ensures #1] [%#sbuddy'8] ComputerDivision.div (m
      * (ComputerDivision.div x m + ComputerDivision.div y m)) m
    = ComputerDivision.div x m + ComputerDivision.div y m))
  -> (let _ = lemma_mul_mod0 m (ComputerDivision.div x m + ComputerDivision.div y m) in if x >= y then
    ([@stop_split] [@expl:lemma_mul_mod0 requires] [%#sbuddy'6] m > 0
      /\ ComputerDivision.div x m - ComputerDivision.div y m >= 0)
    /\ (([@stop_split] [@expl:lemma_mul_mod0 ensures] ([@stop_split] [@expl:lemma_mul_mod0 ensures #0] [%#sbuddy'7] ComputerDivision.mod (m
          * (ComputerDivision.div x m - ComputerDivision.div y m)) m
        = 0)
      /\ ([@stop_split] [@expl:lemma_mul_mod0 ensures #1] [%#sbuddy'8] ComputerDivision.div (m
        * (ComputerDivision.div x m - ComputerDivision.div y m)) m
      = ComputerDivision.div x m - ComputerDivision.div y m))
    -> ([@stop_split] [@expl:lemma_mod_add ensures] ([@stop_split] [@expl:lemma_mod_add ensures #0] [%#sbuddy'0] ComputerDivision.mod (x
        + y) m
      = 0)
    /\ ([@stop_split] [@expl:lemma_mod_add ensures #1] [%#sbuddy'1] x >= y -> ComputerDivision.mod (x - y) m = 0)))
  else
    [@stop_split] [@expl:lemma_mod_add ensures] ([@stop_split] [@expl:lemma_mod_add ensures #0] [%#sbuddy'0] ComputerDivision.mod (x
        + y) m
      = 0)
    /\ ([@stop_split] [@expl:lemma_mod_add ensures #1] [%#sbuddy'1] x >= y -> ComputerDivision.mod (x - y) m = 0)
  ))))))
