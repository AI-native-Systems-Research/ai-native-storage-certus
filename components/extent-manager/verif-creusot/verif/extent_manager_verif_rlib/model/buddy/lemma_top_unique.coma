use bv.Pow2int
use int.Int

function lemma_pow2 [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/buddy.rs" 49 0 49 25] (o: int) : ()

axiom lemma_pow2_def: forall o: int [lemma_pow2 o]. ([%#sbuddy'8] 0 <= o)
    -> lemma_pow2 o = ([%#sbuddy'11] if o > 0 then lemma_pow2 (o - 1) else ())

axiom lemma_pow2_spec: forall o: int. ([%#sbuddy'8] 0 <= o) -> ([%#sbuddy'9] Pow2int.pow2 o >= 1)

axiom lemma_pow2_spec'0: forall o: int. ([%#sbuddy'8] 0 <= o)
    -> ([%#sbuddy'10] Pow2int.pow2 (o + 1) = 2 * Pow2int.pow2 o)

function lemma_pow2_mono [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/buddy.rs" 59 0 59 38] (a: int) (b: int) : ()

axiom lemma_pow2_mono_def: forall a: int, b: int [lemma_pow2_mono a b]. ([%#sbuddy'3] 0 <= a /\ a <= b)
    -> lemma_pow2_mono a b
    = ([%#sbuddy'6] let _ = lemma_pow2 a in if a < b then
      let _ = lemma_pow2 (b - 1) in lemma_pow2_mono a (b - 1)
    else
      ()
    )

axiom lemma_pow2_mono_spec: forall a: int, b: int. ([%#sbuddy'3] 0 <= a /\ a <= b)
    -> ([%#sbuddy'4] Pow2int.pow2 a <= Pow2int.pow2 b)

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant x : int

constant a : int

constant b : int

function lemma_top_unique [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/buddy.rs" 145 0 145 47] (x: int) (a: int) (b: int) : ()

goal vc_lemma_top_unique: ([%#sbuddy] 0 <= a /\ 0 <= b)
  -> ([%#sbuddy'0] Pow2int.pow2 a <= x /\ x < Pow2int.pow2 (a + 1))
  -> ([%#sbuddy'1] Pow2int.pow2 b <= x /\ x < Pow2int.pow2 (b + 1))
  -> (if a < b then
    ([@stop_split] [@expl:lemma_pow2_mono requires] [%#sbuddy'3] 0 <= a + 1 /\ a + 1 <= b)
    /\ (([@stop_split] [@expl:lemma_pow2_mono ensures] [%#sbuddy'4] Pow2int.pow2 (a + 1) <= Pow2int.pow2 b)
    -> ([@stop_split] [@expl:lemma_top_unique ensures] [%#sbuddy'2] a = b))
  else
    if b < a then
      ([@stop_split] [@expl:lemma_pow2_mono requires] [%#sbuddy'3] 0 <= b + 1 /\ b + 1 <= a)
      /\ (([@stop_split] [@expl:lemma_pow2_mono ensures] [%#sbuddy'4] Pow2int.pow2 (b + 1) <= Pow2int.pow2 a)
      -> ([@stop_split] [@expl:lemma_top_unique ensures] [%#sbuddy'2] a = b))
    else
      [@stop_split] [@expl:lemma_top_unique ensures] [%#sbuddy'2] a = b
  
  )
