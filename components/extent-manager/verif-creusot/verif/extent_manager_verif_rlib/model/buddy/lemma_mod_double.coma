use int.ComputerDivision
use int.Int

function lemma_divmod [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/buddy.rs" 184 0 184 35] (x: int) (m: int) : ()
 = [%#sbuddy'9] ()

axiom lemma_divmod_spec: forall x: int, m: int. ([%#sbuddy'2] m > 0 /\ x >= 0)
    -> ([%#sbuddy'3] x = m * ComputerDivision.div x m + ComputerDivision.mod x m)

axiom lemma_divmod_spec'0: forall x: int, m: int. ([%#sbuddy'2] m > 0 /\ x >= 0)
    -> ([%#sbuddy'4] 0 <= ComputerDivision.mod x m /\ ComputerDivision.mod x m < m)

axiom lemma_divmod_spec'1: forall x: int, m: int. ([%#sbuddy'2] m > 0 /\ x >= 0)
    -> ([%#sbuddy'5] ComputerDivision.div x m >= 0)

function lemma_mul_mod0 [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/buddy.rs" 170 0 170 37] (m: int) (k: int) : ()
 = [%#sbuddy'10] ()

axiom lemma_mul_mod0_spec: forall m: int, k: int. ([%#sbuddy'6] m > 0 /\ k >= 0)
    -> ([%#sbuddy'7] ComputerDivision.mod (m * k) m = 0)

axiom lemma_mul_mod0_spec'0: forall m: int, k: int. ([%#sbuddy'6] m > 0 /\ k >= 0)
    -> ([%#sbuddy'8] ComputerDivision.div (m * k) m = k)

meta "compute_max_steps" 1000000

