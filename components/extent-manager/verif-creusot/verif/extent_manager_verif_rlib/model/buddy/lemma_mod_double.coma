constant x : int

constant m : int

function lemma_mod_double [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/buddy.rs" 190 0 190 39] (x: int) (m: int) : ()

goal vc_lemma_mod_double: ([%#sbuddy] m > 0 /\ x >= 0)
  -> ([%#sbuddy'0] ComputerDivision.mod x (2 * m) = 0)
  -> ([@stop_split] [@expl:lemma_divmod requires] [%#sbuddy'2] 2 * m > 0 /\ x >= 0)
  /\ (([@stop_split] [@expl:lemma_divmod ensures] ([@stop_split] [@expl:lemma_divmod ensures #0] [%#sbuddy'3] x
      = 2 * m * ComputerDivision.div x (2 * m) + ComputerDivision.mod x (2 * m))
    /\ ([@stop_split] [@expl:lemma_divmod ensures #1] [%#sbuddy'4] 0 <= ComputerDivision.mod x (2 * m)
      /\ ComputerDivision.mod x (2 * m) < 2 * m)
    /\ ([@stop_split] [@expl:lemma_divmod ensures #2] [%#sbuddy'5] ComputerDivision.div x (2 * m) >= 0))
  -> (let _ = lemma_divmod x (2 * m) in ([@stop_split] [@expl:lemma_mul_mod0 requires] [%#sbuddy'6] m > 0
    /\ 2 * ComputerDivision.div x (2 * m) >= 0)
  /\ (([@stop_split] [@expl:lemma_mul_mod0 ensures] ([@stop_split] [@expl:lemma_mul_mod0 ensures #0] [%#sbuddy'7] ComputerDivision.mod (m
          * 2
        * ComputerDivision.div x (2 * m)) m
      = 0)
    /\ ([@stop_split] [@expl:lemma_mul_mod0 ensures #1] [%#sbuddy'8] ComputerDivision.div (m * 2
      * ComputerDivision.div x (2 * m)) m
    = 2 * ComputerDivision.div x (2 * m)))
  -> ([@stop_split] [@expl:lemma_mod_double ensures] [%#sbuddy'1] ComputerDivision.mod x m = 0))))
