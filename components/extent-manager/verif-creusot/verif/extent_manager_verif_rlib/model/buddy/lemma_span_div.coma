axiom lemma_pow2_def: forall o: int [lemma_pow2 o]. ([%#sbuddy'3] 0 <= o)
    -> lemma_pow2 o = ([%#sbuddy'11] if o > 0 then lemma_pow2 (o - 1) else ())

axiom lemma_pow2_spec: forall o: int. ([%#sbuddy'3] 0 <= o) -> ([%#sbuddy'4] Pow2int.pow2 o >= 1)

