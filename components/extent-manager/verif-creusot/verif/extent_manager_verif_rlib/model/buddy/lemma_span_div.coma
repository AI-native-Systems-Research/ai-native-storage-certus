    -> ([%#sbuddy'14] x = m * ComputerDivision.div x m + ComputerDivision.mod x m)

axiom lemma_divmod_spec'0: forall x: int, m: int. ([%#sbuddy'13] m > 0 /\ x >= 0)
    -> ([%#sbuddy'15] 0 <= ComputerDivision.mod x m /\ ComputerDivision.mod x m < m)

axiom lemma_divmod_spec'1: forall x: int, m: int. ([%#sbuddy'13] m > 0 /\ x >= 0)
    -> ([%#sbuddy'16] ComputerDivision.div x m >= 0)

