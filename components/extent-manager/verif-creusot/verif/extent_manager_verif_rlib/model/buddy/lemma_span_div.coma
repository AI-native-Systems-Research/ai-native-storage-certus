predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
  [%#swell_founded] self >= 0 /\ self > other

meta "rewrite_def" predicate well_founded_relation_Int

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant x : int

constant ss : int

constant a : int

constant b : int

function lemma_span_div [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/buddy.rs" 201 0 201 54] (x: int) (ss: int) (a: int) (b: int) : ()

goal vc_lemma_span_div: ([%#sbuddy'0] ss > 0 /\ 0 <= a /\ a <= b /\ x >= 0)
  -> ([%#sbuddy'1] ComputerDivision.mod x (span ss b) = 0)
  -> (if a < b then
    ([@stop_split] [@expl:lemma_pow2 requires] [%#sbuddy'3] 0 <= b - 1)
    /\ (([@stop_split] [@expl:lemma_pow2 ensures] ([@stop_split] [@expl:lemma_pow2 ensures #0] [%#sbuddy'4] Pow2int.pow2 (b
          - 1)
        >= 1)
      /\ ([@stop_split] [@expl:lemma_pow2 ensures #1] [%#sbuddy'5] Pow2int.pow2 (b - 1 + 1) = 2 * Pow2int.pow2 (b - 1)))
    -> (let _ = lemma_pow2 (b - 1) in ([@stop_split] [@expl:lemma_pow2 requires] [%#sbuddy'3] 0 <= 0)
    /\ (([@stop_split] [@expl:lemma_pow2 ensures] ([@stop_split] [@expl:lemma_pow2 ensures #0] [%#sbuddy'4] Pow2int.pow2 0
        >= 1)
      /\ ([@stop_split] [@expl:lemma_pow2 ensures #1] [%#sbuddy'5] Pow2int.pow2 (0 + 1) = 2 * Pow2int.pow2 0))
    -> (let _ = lemma_pow2 0 in ([@stop_split] [@expl:lemma_mod_double requires] ([@stop_split] [@expl:lemma_mod_double requires #0] [%#sbuddy'6] span ss (b
            - 1)
          > 0
        /\ x >= 0)
      /\ ([@stop_split] [@expl:lemma_mod_double requires #1] [%#sbuddy'7] ComputerDivision.mod x (2 * span ss (b - 1))
      = 0))
    /\ (([@stop_split] [@expl:lemma_mod_double ensures] [%#sbuddy'8] ComputerDivision.mod x (span ss (b - 1)) = 0)
    -> (let _ = lemma_mod_double x (span ss (b
    - 1)) in (([@stop_split] [@expl:lemma_span_div requires] ([@stop_split] [@expl:lemma_span_div requires #0] [%#sbuddy'0] ss
            > 0
          /\ 0 <= a /\ a <= b - 1 /\ x >= 0)
        /\ ([@stop_split] [@expl:lemma_span_div requires #1] [%#sbuddy'1] ComputerDivision.mod x (span ss (b - 1)) = 0))
      /\ ([@expl:variant decreases] well_founded_relation_Int ([%#sbuddy] b - a) ([%#sbuddy] b - 1 - a)))
    /\ (([@stop_split] [@expl:lemma_span_div ensures] [%#sbuddy'2] ComputerDivision.mod x (span ss a) = 0)
    -> ([@stop_split] [@expl:lemma_span_div ensures] [%#sbuddy'2] ComputerDivision.mod x (span ss a) = 0))))))))
  else
    [@stop_split] [@expl:lemma_span_div ensures] [%#sbuddy'2] ComputerDivision.mod x (span ss a) = 0
  )
