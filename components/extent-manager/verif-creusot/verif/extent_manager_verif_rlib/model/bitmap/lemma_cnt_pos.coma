use creusot.int.UInt32
use creusot.int.UInt64
use seq.Seq
use int.ComputerDivision
use int.Int

type t_Vec_u64_Global

type t_AllocationBitmap = { words: t_Vec_u64_Global; num_slots: UInt32.t; allocated_count: UInt32.t }

constant const_MAX: UInt64.t = (18446744073709551615: UInt64.t)

function view_Vec_u64_Global (self: t_Vec_u64_Global) : Seq.seq UInt64.t

axiom view_Vec_u64_Global_spec:
  forall self: t_Vec_u64_Global [view_Vec_u64_Global self]. [%#svec] Seq.length (view_Vec_u64_Global self)
    <= UInt64.t'int const_MAX

predicate slot_bit [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/bitmap.rs" 33 0 33 53] (bm: t_AllocationBitmap) (i: int) =
  [%#sbitmap'5] UInt64.nth (Seq.get (view_Vec_u64_Global bm.words) (ComputerDivision.div i 64)) (ComputerDivision.mod i 64)

function cnt [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/bitmap.rs" 40 0 40 47] (bm: t_AllocationBitmap) (n: int) : int

axiom cnt_def: forall bm: t_AllocationBitmap, n: int [cnt bm n]. cnt bm n
    = ([%#sbitmap'7] if n <= 0 then 0 else cnt bm (n - 1) + (if slot_bit bm (n - 1) then 1 else 0))

predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
  [%#swell_founded] self >= 0 /\ self > other

meta "rewrite_def" predicate well_founded_relation_Int

function lemma_cnt_bounds [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/bitmap.rs" 77 0 77 52] (a: t_AllocationBitmap) (n: int) : ()

axiom lemma_cnt_bounds_def: forall a: t_AllocationBitmap, n: int [lemma_cnt_bounds a n]. ([%#sbitmap'3] 0 <= n)
    -> lemma_cnt_bounds a n = ([%#sbitmap'9] if n > 0 then lemma_cnt_bounds a (n - 1) else ())

axiom lemma_cnt_bounds_spec: forall a: t_AllocationBitmap, n: int. ([%#sbitmap'3] 0 <= n)
    -> ([%#sbitmap'4] 0 <= cnt a n /\ cnt a n <= n)

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant a : t_AllocationBitmap

constant k : int

constant n : int

function lemma_cnt_pos [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/bitmap.rs" 103 0 103 57] (a: t_AllocationBitmap) (k: int) (n: int) : ()

goal vc_lemma_cnt_pos: ([%#sbitmap'0] 0 <= k /\ k < n)
  -> ([%#sbitmap'1] slot_bit a k)
  -> (if n > k + 1 then
    (([@stop_split] [@expl:lemma_cnt_pos requires] ([@stop_split] [@expl:lemma_cnt_pos requires #0] [%#sbitmap'0] 0 <= k
          /\ k < n - 1)
        /\ ([@stop_split] [@expl:lemma_cnt_pos requires #1] [%#sbitmap'1] slot_bit a k))
      /\ ([@expl:variant decreases] well_founded_relation_Int ([%#sbitmap] n) ([%#sbitmap] n - 1)))
    /\ (([@stop_split] [@expl:lemma_cnt_pos ensures] [%#sbitmap'2] cnt a (n - 1) > 0)
    -> ([@stop_split] [@expl:lemma_cnt_pos ensures] [%#sbitmap'2] cnt a n > 0))
  else
    ([@stop_split] [@expl:lemma_cnt_bounds requires] [%#sbitmap'3] 0 <= k)
    /\ (([@stop_split] [@expl:lemma_cnt_bounds ensures] [%#sbitmap'4] 0 <= cnt a k /\ cnt a k <= k)
    -> ([@stop_split] [@expl:lemma_cnt_pos ensures] [%#sbitmap'2] cnt a n > 0))
  )
