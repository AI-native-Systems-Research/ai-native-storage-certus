type t_Vec_u64_Global

type t_AllocationBitmap = { words: t_Vec_u64_Global; num_slots: UInt32BW.t; allocated_count: UInt32BW.t }

predicate in_bounds_usize [@inline:trivial] (self: UInt64BW.t) (seq: Seq.seq UInt64BW.t) =
  [%#sslice] UInt64BW.t'int self < Seq.length seq

meta "rewrite_def" predicate in_bounds_usize

constant const_MAX: UInt64BW.t = (18446744073709551615: UInt64BW.t)

function view_Vec_u64_Global (self: t_Vec_u64_Global) : Seq.seq UInt64BW.t

axiom view_Vec_u64_Global_spec:
  forall self: t_Vec_u64_Global [view_Vec_u64_Global self]. [%#svec'4] Seq.length (view_Vec_u64_Global self)
    <= UInt64BW.t'int const_MAX

predicate has_value_usize [@inline:trivial] (self: UInt64BW.t) (seq: Seq.seq UInt64BW.t) (out: UInt64BW.t) =
  [%#sslice'0] Seq.get seq (UInt64BW.t'int self) = out

meta "rewrite_def" predicate has_value_usize

predicate resolve_elswhere_usize [@inline:trivial] (self: UInt64BW.t) (old': Seq.seq UInt64BW.t) (fin: Seq.seq UInt64BW.t) =
  [%#sslice'1] forall i: int. 0 <= i /\ i <> UInt64BW.t'int self /\ i < Seq.length old'
    -> Seq.get old' i = Seq.get fin i

meta "rewrite_def" predicate resolve_elswhere_usize

let index_mut_Vec_u64_Global (self_: MutBorrow.t t_Vec_u64_Global) (ix: UInt64BW.t)
  (return (x: MutBorrow.t UInt64BW.t)) =
{[@stop_split] [@expl:index_mut requires] [%#svec] in_bounds_usize ix (view_Vec_u64_Global self_.current)}
  any
  [ return (result: MutBorrow.t UInt64BW.t) ->
  {[@stop_split] [@expl:index_mut_Vec_u64_Global ensures] ([@stop_split] [@expl:index_mut ensures #0] [%#svec'0] has_value_usize ix (view_Vec_u64_Global self_.current) result.current)
    /\ ([@stop_split] [@expl:index_mut ensures #1] [%#svec'1] has_value_usize ix (view_Vec_u64_Global self_.final) result.final)
    /\ ([@stop_split] [@expl:index_mut ensures #2] [%#svec'2] resolve_elswhere_usize ix (view_Vec_u64_Global self_.current) (view_Vec_u64_Global self_.final))
    /\ ([@stop_split] [@expl:index_mut ensures #3] [%#svec'3] Seq.length (view_Vec_u64_Global self_.final)
    = Seq.length (view_Vec_u64_Global self_.current))}
    (! return {result}) ]

predicate resolve_refmut_u64 [@inline:trivial] (_1: MutBorrow.t UInt64BW.t) = _1.final = _1.current

meta "rewrite_def" predicate resolve_refmut_u64

predicate resolve_refmut_AllocationBitmap [@inline:trivial] (_1: MutBorrow.t t_AllocationBitmap) = _1.final = _1.current

meta "rewrite_def" predicate resolve_refmut_AllocationBitmap

predicate bm_wf [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/bitmap.rs" 27 0 27 42] (bm: t_AllocationBitmap) =
  [%#sbitmap'17] Seq.length (view_Vec_u64_Global bm.words) = ComputerDivision.div (UInt32BW.t'int bm.num_slots + 63) 64

predicate slot_bit [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/bitmap.rs" 33 0 33 53] (bm: t_AllocationBitmap) (i: int) =
