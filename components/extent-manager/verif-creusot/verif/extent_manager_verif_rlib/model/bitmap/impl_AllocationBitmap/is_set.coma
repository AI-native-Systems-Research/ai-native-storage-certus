  [%#sbitmap'10] Seq.length (view_Vec_u64_Global bm.words) = ComputerDivision.div (UInt32BW.t'int bm.num_slots + 63) 64

predicate slot_bit [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/bitmap.rs" 33 0 33 53] (bm: t_AllocationBitmap) (i: int) =
