meta "rewrite_def" predicate resolve_refmut_Range_usize

predicate completed_Range_usize (self: MutBorrow.t t_Range_usize) =
  [%#srange'0] resolve_refmut_Range_usize self
  /\ deep_model_usize self.current.start >= deep_model_usize self.current.end'

let next_Range_usize (self_: MutBorrow.t t_Range_usize) (return (x: t_Option_usize)) = any
  [ return (result: t_Option_usize) -> {[@stop_split] [@expl:next ensures] [%#siter'0] match result with
      | None -> completed_Range_usize self_
      | Some v -> produces_Range_usize self_.current (Seq.singleton v) self_.final
      end}
    (! return {result}) ]

constant const_MAX: UInt64.t = (18446744073709551615: UInt64.t)

function view_Vec_u64_Global (self: t_Vec_u64_Global) : Seq.seq UInt64.t

axiom view_Vec_u64_Global_spec:
  forall self: t_Vec_u64_Global [view_Vec_u64_Global self]. [%#svec] Seq.length (view_Vec_u64_Global self)
    <= UInt64.t'int const_MAX

