  forall a: t_Range_usize, ab: Seq.seq UInt64.t, b: t_Range_usize, bc: Seq.seq UInt64.t, c: t_Range_usize. ([%#srange'2] produces_Range_usize a ab b)
    -> ([%#srange'3] produces_Range_usize b bc c) -> ([%#srange'4] produces_Range_usize a (Seq.(++) ab bc) c)

