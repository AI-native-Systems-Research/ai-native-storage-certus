    | s8 = {[@expl:assertion] [%#sbitmap'6] forall j: int. 0 <= j /\ j < UInt32BW.t'int num_slots'0 -> not slot_bit r j}
      s9
    | s9 = [ &_25 <- [%#sbitmap'7] lemma_cnt_zero_all r (UInt32BW.t'int num_slots'0) ] s10
