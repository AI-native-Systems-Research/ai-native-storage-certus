use creusot.int.UInt32BW
use creusot.int.UInt64BW
use seq.Seq
use int.ComputerDivision
use creusot.prelude.Any
use int.Int

type t_Vec_u64_Global

constant const_MAX: UInt64BW.t = (18446744073709551615: UInt64BW.t)

function view_Vec_u64_Global (self: t_Vec_u64_Global) : Seq.seq UInt64BW.t

axiom view_Vec_u64_Global_spec:
  forall self: t_Vec_u64_Global [view_Vec_u64_Global self]. [%#svec'2] Seq.length (view_Vec_u64_Global self)
    <= UInt64BW.t'int const_MAX

function index_Vec_u64_Global [@inline:trivial] (self: t_Vec_u64_Global) (ix: int) : UInt64BW.t =
  [%#svec'3] Seq.get (view_Vec_u64_Global self) ix

meta "rewrite_def" function index_Vec_u64_Global

let from_elem_u64 (elem: UInt64BW.t) (n: UInt64BW.t) (return (x: t_Vec_u64_Global)) = any
  [ return (result: t_Vec_u64_Global) ->
  {[@stop_split] [@expl:from_elem_u64 ensures] ([@stop_split] [@expl:from_elem ensures #0] [%#svec'0] Seq.length (view_Vec_u64_Global result)
      = UInt64BW.t'int n)
    /\ ([@stop_split] [@expl:from_elem ensures #1] [%#svec'1] forall i: int. 0 <= i /\ i < UInt64BW.t'int n
      -> index_Vec_u64_Global result i = elem)}
    (! return {result}) ]

type t_AllocationBitmap = { words: t_Vec_u64_Global; num_slots: UInt32BW.t; allocated_count: UInt32BW.t }

predicate slot_bit [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/bitmap.rs" 33 0 33 53] (bm: t_AllocationBitmap) (i: int) =
  [%#sbitmap'13] UInt64BW.nth (Seq.get (view_Vec_u64_Global bm.words) (ComputerDivision.div i 64)) (ComputerDivision.mod i 64)

function cnt [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/bitmap.rs" 40 0 40 47] (bm: t_AllocationBitmap) (n: int) : int

axiom cnt_def: forall bm: t_AllocationBitmap, n: int [cnt bm n]. cnt bm n
    = ([%#sbitmap'22] if n <= 0 then 0 else cnt bm (n - 1) + (if slot_bit bm (n - 1) then 1 else 0))

function lemma_cnt_zero_all [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/bitmap.rs" 281 0 281 54] (a: t_AllocationBitmap) (n: int) : ()

axiom lemma_cnt_zero_all_def: forall a: t_AllocationBitmap, n: int [lemma_cnt_zero_all a n]. ([%#sbitmap'15] 0 <= n)
    -> ([%#sbitmap'16] forall j: int. 0 <= j /\ j < n -> not slot_bit a j)
    -> lemma_cnt_zero_all a n = ([%#sbitmap'18] if n > 0 then lemma_cnt_zero_all a (n - 1) else ())

axiom lemma_cnt_zero_all_spec: forall a: t_AllocationBitmap, n: int. ([%#sbitmap'15] 0 <= n)
    -> ([%#sbitmap'16] forall j: int. 0 <= j /\ j < n -> not slot_bit a j) -> ([%#sbitmap'17] cnt a n = 0)

predicate bm_wf [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/bitmap.rs" 27 0 27 42] (bm: t_AllocationBitmap) =
  [%#sbitmap'19] Seq.length (view_Vec_u64_Global bm.words) = ComputerDivision.div (UInt32BW.t'int bm.num_slots + 63) 64

predicate bm_count_ok [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/bitmap.rs" 46 0 46 48] (bm: t_AllocationBitmap) =
  [%#sbitmap'23] UInt32BW.t'int bm.allocated_count = cnt bm (UInt32BW.t'int bm.num_slots)

predicate bm_inv [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/bitmap.rs" 52 0 52 43] (bm: t_AllocationBitmap) =
  [%#sbitmap'20] bm_wf bm /\ bm_count_ok bm

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

