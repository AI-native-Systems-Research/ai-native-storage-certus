type t_CompF = FlushDone bool | Error | Other

type t_Option_CompF = None | Some t_CompF

let elim_Some (_x: t_Option_CompF) (return (f0: t_CompF)) = any
  [ _k (f0: t_CompF) -> {Some f0 = _x} (! return {f0})
  | _chk -> (! {[@expl:elim Some] match _x with
      | Some _ -> true
      | _ -> false
      end}
    any) ]

type t_EmError = CorruptMetadata | IoError | NotInitialized | OffsetNotFound UInt64.t | OutOfSpace

let io_error (return (x: t_EmError)) = any
  [ return (result: t_EmError) -> {[@stop_split] [@expl:io_error ensures] [%#sb3] result = IoError}
    (! return {result}) ]

type t_Result_unit_EmError = Ok () | Err t_EmError

let nvme_to_em (return (x: t_EmError)) = any
  [ return (result: t_EmError) -> {[@stop_split] [@expl:nvme_to_em ensures] [%#sb3'0] result = IoError}
    (! return {result}) ]

let elim_FlushDone (_x: t_CompF) (return (f0: bool)) = any
  [ _k (f0: bool) -> {FlushDone f0 = _x} (! return {f0})
  | _chk -> (! {[@expl:elim FlushDone] match _x with
      | FlushDone _ -> true
      | _ -> false
      end}
    any) ]

