use creusot.int.UInt64
use creusot.int.UInt32
use creusot.int.UInt8
use seq.Seq
use creusot.prelude.MutBorrow
use int.ComputerDivision
use bv.Pow2int
use map.Map
use creusot.prelude.Any
use int.Int

type t_Vec_RegionState_Global

type t_Vec_usize_Global

type t_Option_Vec_usize_Global = None | Some t_Vec_usize_Global

type t_Option_u64 = None'0 | Some'0 UInt64.t

type t_FormatParams = {
  data_disk_size: UInt64.t;
  slab_size: UInt64.t;
  max_extent_size: UInt32.t;
  sector_size: UInt32.t;
  region_count: UInt32.t;
  metadata_alignment: UInt64.t;
  instance_id: t_Option_u64;
  metadata_disk_ns_id: UInt32.t;
  metadata_region_size: UInt64.t }

type t_Superblock = {
  magic'0: UInt64.t;
  version'0: UInt32.t;
  data_disk_size'0: UInt64.t;
  sector_size'0: UInt32.t;
  slab_size'0: UInt64.t;
  max_extent_size'0: UInt32.t;
  region_count'0: UInt32.t;
  checkpoint_seq'0: UInt64.t;
  active_copy'0: UInt8.t;
  checkpoint_region_offset'0: UInt64.t;
  checkpoint_region_size'0: UInt64.t;
  instance_id'0: UInt64.t;
  metadata_disk_ns_id'0: UInt32.t;
  data_start_offset'0: UInt64.t }

type t_SharedState = { format_params: t_FormatParams; checkpoint_seq: UInt64.t; superblock: t_Superblock }

type t_Option_SharedState = None'1 | Some'1 t_SharedState

type t_Option_u32 = None'2 | Some'2 UInt32.t

type t_Option_Superblock = None'3 | Some'3 t_Superblock

type tup2_u64_usize = { f0: UInt64.t; f1: UInt64.t }

type t_Option_tup2_u64_usize = None'4 | Some'4 tup2_u64_usize

type t_MetaDevice = {
  connected'1: bool;
  sector_size'1: UInt32.t;
  num_sectors'1: UInt64.t;
  sb'1: t_Option_Superblock;
  ckpt0'1: t_Option_tup2_u64_usize;
  ckpt1'1: t_Option_tup2_u64_usize }

type t_ExtentManager = {
  arena: t_Vec_RegionState_Global;
  regions: t_Option_Vec_usize_Global;
  shared: t_Option_SharedState;
  metadata_ns_id: t_Option_u32;
  metadata_base_lba: UInt64.t;
  data_base_lba: UInt64.t;
  dev: t_MetaDevice }

let elim_Some (_x: t_Option_Vec_usize_Global) (return (f0'0: t_Vec_usize_Global)) = any
  [ _k (f0'0: t_Vec_usize_Global) -> {Some f0'0 = _x} (! return {f0'0})
  | _chk -> (! {[@expl:elim Some] match _x with
      | Some _ -> true
      | _ -> false
      end}
    any) ]

constant const_MAX: UInt64.t = (18446744073709551615: UInt64.t)

function view_Vec_usize_Global (self: t_Vec_usize_Global) : Seq.seq UInt64.t

axiom view_Vec_usize_Global_spec:
  forall self: t_Vec_usize_Global [view_Vec_usize_Global self]. [%#svec'2] Seq.length (view_Vec_usize_Global self)
    <= UInt64.t'int const_MAX

let len_usize (self_: t_Vec_usize_Global) (return (x: UInt64.t)) = any
  [ return (result: UInt64.t) -> {[@stop_split] [@expl:len ensures] [%#svec] UInt64.t'int result
    = Seq.length (view_Vec_usize_Global self_)}
    (! return {result}) ]

let elim_Some'0 (_x: t_Option_SharedState) (return (f0'0: t_SharedState)) = any
  [ _k (f0'0: t_SharedState) -> {Some'1 f0'0 = _x} (! return {f0'0})
