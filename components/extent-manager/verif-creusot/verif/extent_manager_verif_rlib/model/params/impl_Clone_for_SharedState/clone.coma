(* <model::params::SharedState as std::clone::Clone> *)

use creusot.int.UInt64
use creusot.int.UInt32
use creusot.int.UInt8
use creusot.prelude.Any

type t_Option_u64 = None | Some UInt64.t

type t_FormatParams = {
  data_disk_size: UInt64.t;
  slab_size: UInt64.t;
  max_extent_size: UInt32.t;
  sector_size: UInt32.t;
  region_count: UInt32.t;
  metadata_alignment: UInt64.t;
  instance_id: t_Option_u64;
  metadata_disk_ns_id: UInt32.t;
  metadata_region_size: UInt64.t }

type t_Superblock = {
  magic'0: UInt64.t;
  version'0: UInt32.t;
  data_disk_size'0: UInt64.t;
  sector_size'0: UInt32.t;
  slab_size'0: UInt64.t;
  max_extent_size'0: UInt32.t;
  region_count'0: UInt32.t;
  checkpoint_seq'0: UInt64.t;
  active_copy'0: UInt8.t;
  checkpoint_region_offset'0: UInt64.t;
  checkpoint_region_size'0: UInt64.t;
  instance_id'0: UInt64.t;
  metadata_disk_ns_id'0: UInt32.t;
  data_start_offset'0: UInt64.t }

type t_SharedState = { format_params: t_FormatParams; checkpoint_seq: UInt64.t; superblock: t_Superblock }

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let clone_SharedState [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/params.rs" 101 9 101 29]
  (self: t_SharedState) (return (x: t_SharedState)) = (! bb0
  [ bb0 = s0 [ s0 = [ &_ret <- self ] s1 | s1 = return {_ret} ] ]
  [ & _ret: t_SharedState = Any.any_l () | & self: t_SharedState = self ])
  [ return (result: t_SharedState) -> (! return {result}) ]
