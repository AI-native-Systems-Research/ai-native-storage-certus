predicate p2 [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/l2.rs" 14 0 14 25] (x: int) =
  [%#sl2'6] exists k: int. 0 <= k /\ Pow2int.pow2 k = x

function log2 [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/l2.rs" 259 0 259 26] (x: int) : int

axiom log2_def: forall x: int [log2 x]. log2 x = ([%#sl2'8] if x <= 1 then 0 else 1 + log2 (ComputerDivision.div x 2))

function span [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/buddy.rs" 32 0 32 35] (ss: int) (o: int) : int
 = [%#sbuddy] Pow2int.pow2 o * ss

