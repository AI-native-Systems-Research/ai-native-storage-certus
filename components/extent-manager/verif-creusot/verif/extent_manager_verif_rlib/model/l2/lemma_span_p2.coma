constant ss : int

constant o : int

function lemma_span_p2 [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/l2.rs" 284 0 284 37] (ss: int) (o: int) : ()

goal vc_lemma_span_p2: ([%#sl2] p2 ss /\ 0 <= o)
  -> (forall k: int. if 0 <= k then
        if Pow2int.pow2 k = ss then
          ([@stop_split] [@expl:lemma_log2 requires] [%#sl2'2] 0 <= k)
          /\ (([@stop_split] [@expl:lemma_log2 ensures] [%#sl2'3] log2 (Pow2int.pow2 k) = k)
          -> (let _ = lemma_log2 k in true))
        else
          true
      
      else
        true
    )
  /\ (forall k: int. 0 <= k /\ Pow2int.pow2 k = ss -> (let _ = lemma_log2 k in log2 ss = k))
  && (if 0 <= log2 ss then
    ss = Pow2int.pow2 (log2 ss)
    && ([@stop_split] [@expl:lemma_pow2_add requires] [%#sl2'4] 0 <= o /\ 0 <= log2 ss)
    /\ (([@stop_split] [@expl:lemma_pow2_add ensures] [%#sl2'5] Pow2int.pow2 (o + log2 ss)
      = Pow2int.pow2 o * Pow2int.pow2 (log2 ss))
    -> ([@stop_split] [@expl:lemma_span_p2 ensures] ([@stop_split] [@expl:lemma_span_p2 ensures #0] [%#sl2'0] 0
        <= log2 ss
      /\ ss = Pow2int.pow2 (log2 ss))
    /\ ([@stop_split] [@expl:lemma_span_p2 ensures #1] [%#sl2'1] span ss o = Pow2int.pow2 (o + log2 ss))))
  else
    false
    && ([@stop_split] [@expl:lemma_pow2_add requires] [%#sl2'4] 0 <= o /\ 0 <= log2 ss)
    /\ (([@stop_split] [@expl:lemma_pow2_add ensures] [%#sl2'5] Pow2int.pow2 (o + log2 ss)
      = Pow2int.pow2 o * Pow2int.pow2 (log2 ss))
    -> ([@stop_split] [@expl:lemma_span_p2 ensures] ([@stop_split] [@expl:lemma_span_p2 ensures #0] [%#sl2'0] 0
        <= log2 ss
      /\ ss = Pow2int.pow2 (log2 ss))
    /\ ([@stop_split] [@expl:lemma_span_p2 ensures #1] [%#sl2'1] span ss o = Pow2int.pow2 (o + log2 ss))))
  )
