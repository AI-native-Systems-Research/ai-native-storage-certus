axiom lemma_pow2_spec: forall o: int. ([%#sbuddy'1] 0 <= o) -> ([%#sbuddy'2] Pow2int.pow2 o >= 1)

axiom lemma_pow2_spec'0: forall o: int. ([%#sbuddy'1] 0 <= o)
    -> ([%#sbuddy'3] Pow2int.pow2 (o + 1) = 2 * Pow2int.pow2 o)

function lemma_log2 [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/l2.rs" 267 0 267 25] (k: int) : ()

axiom lemma_log2_def: forall k: int [lemma_log2 k]. ([%#sl2'2] 0 <= k)
    -> lemma_log2 k = ([%#sl2'10] if k > 0 then let _ = lemma_log2 (k - 1) in let _ = lemma_pow2 (k - 1) in () else ())

axiom lemma_log2_spec: forall k: int. ([%#sl2'2] 0 <= k) -> ([%#sl2'3] log2 (Pow2int.pow2 k) = k)

function lemma_pow2_add [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/l2.rs" 246 0 246 37] (a: int) (b: int) : ()

axiom lemma_pow2_add_def: forall a: int, b: int [lemma_pow2_add a b]. ([%#sl2'4] 0 <= a /\ 0 <= b)
    -> lemma_pow2_add a b
    = ([%#sl2'12] if b > 0 then
      let _ = lemma_pow2_add a (b - 1) in let _ = lemma_pow2 (a + b - 1) in lemma_pow2 (b - 1)
    else
      ()
    )

axiom lemma_pow2_add_spec: forall a: int, b: int. ([%#sl2'4] 0 <= a /\ 0 <= b)
    -> ([%#sl2'5] Pow2int.pow2 (a + b) = Pow2int.pow2 a * Pow2int.pow2 b)

meta "compute_max_steps" 1000000

