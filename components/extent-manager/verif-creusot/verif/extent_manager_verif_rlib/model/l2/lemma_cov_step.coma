goal vc_lemma_cov_step: ([%#sl2] pu_rel a b o v /\ UInt64.t'int v = off * ss /\ ss > 0 /\ 0 <= o /\ off >= 0)
  -> ([%#sl2'0] ComputerDivision.mod off (Pow2int.pow2 (o + 1)) = 0 /\ cov a ss (off * ss))
  -> (forall kk: int, t: int. if 0 <= kk then
        if 0 <= t then
