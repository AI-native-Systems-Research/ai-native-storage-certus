function lemma_cov_one [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/l2.rs" 401 0 401 108] (a: Seq.seq t_Vec_u64_Global) (b: Seq.seq t_Vec_u64_Global) (ss: int) (off: int) (o: int) (v: UInt64.t) (kk: int) (t: int) : ()
 =
  [%#sl2'8] let _ = lemma_pu a b ss o v in let _ = lemma_span_pos ss kk in let _ = lemma_span_pos ss o in let _ = lemma_pow2 o in let _ = lemma_span_succ ss o in if t
    + span ss kk
  <= off * ss then
    ()
  else
    if kk >= o + 1 then
      let _ = lemma_mul_mod off (Pow2int.pow2 (o + 1)) ss in let _ = lemma_span_mult ss (o
      + 1) kk in let _ = lemma_span_div t ss (o + 1) kk in let _ = lemma_span_pos ss (o
      + 1) in let _ = lemma_mod_add t (span ss kk) (span ss (o
      + 1)) in let _ = lemma_mul_le 0 off ss in lemma_aligned_disj2 (off * ss) (t + span ss kk) (span ss (o + 1))
    else
      let _ = lemma_mul_mod off (Pow2int.pow2 (o
      + 1)) ss in let _ = lemma_mul_le 0 off ss in let _ = lemma_span_div (off * ss) ss kk (o + 1) in if t
      < off * ss then
        lemma_aligned_disj2 t (off * ss) (span ss kk)
      else
        ()
    
  


axiom lemma_cov_one_spec:
  forall a: Seq.seq t_Vec_u64_Global, b: Seq.seq t_Vec_u64_Global, ss: int, off: int, o: int, v: UInt64.t, kk: int, t: int. ([%#sl2'2] pu_rel a b o v
      /\ UInt64.t'int v = off * ss /\ ss > 0 /\ 0 <= o /\ off >= 0)
    -> ([%#sl2'3] ComputerDivision.mod off (Pow2int.pow2 (o + 1)) = 0 /\ cov a ss (off * ss))
    -> ([%#sl2'4] 0 <= kk
      /\ 0 <= t /\ ComputerDivision.mod t (span ss kk) = 0 /\ t + span ss kk <= off * ss + span ss o)
    -> ([%#sl2'5] inblk b ss kk t)

