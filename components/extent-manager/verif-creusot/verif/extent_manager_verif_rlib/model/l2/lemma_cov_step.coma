              ([@stop_split] [@expl:lemma_cov_one requires] ([@stop_split] [@expl:lemma_cov_one requires #0] [%#sl2'2] pu_rel a b o v
                  /\ UInt64.t'int v = off * ss /\ ss > 0 /\ 0 <= o /\ off >= 0)
                /\ ([@stop_split] [@expl:lemma_cov_one requires #1] [%#sl2'3] ComputerDivision.mod off (Pow2int.pow2 (o
                      + 1))
                    = 0
                  /\ cov a ss (off * ss))
                /\ ([@stop_split] [@expl:lemma_cov_one requires #2] [%#sl2'4] 0 <= kk
                /\ 0 <= t /\ ComputerDivision.mod t (span ss kk) = 0 /\ t + span ss kk <= off * ss + span ss o))
              /\ (([@stop_split] [@expl:lemma_cov_one ensures] [%#sl2'5] inblk b ss kk t)
              -> (let _ = lemma_cov_one a b ss off o v kk t in true))
            else
              true
          
          else
            true
        
        else
          true
      
      else
        true
    )
  /\ (forall kk: int, t: int. 0 <= kk
        /\ 0 <= t /\ ComputerDivision.mod t (span ss kk) = 0 /\ t + span ss kk <= off * ss + span ss o
      -> (let _ = lemma_cov_one a b ss off o v kk t in inblk b ss kk t))
  && ([@stop_split] [@expl:lemma_cov_step ensures] [%#sl2'1] cov b ss (off * ss + span ss o))
