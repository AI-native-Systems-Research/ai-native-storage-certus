function mulw [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/buddy.rs" 572 4 572 38] (a: int) (b: int) : int

function lemma_acct [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/buddy.rs" 586 4 586 89] (a: Seq.seq t_Vec_u64_Global) (b: Seq.seq t_Vec_u64_Global) (ss: int) (off: int) (blocks: int) : ()

axiom lemma_acct_spec:
  forall a: Seq.seq t_Vec_u64_Global, b: Seq.seq t_Vec_u64_Global, ss: int, off: int, blocks: int. ([%#sbuddy] tf b ss (Seq.length b)
      = mulw off ss)
    -> ([%#sbuddy'0] tf a ss (Seq.length a) = tf b ss (Seq.length b) + mulw blocks ss)
    -> ([%#sbuddy'1] tf a ss (Seq.length a) = mulw (off + blocks) ss)

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let acct_g [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/l2.rs" 500 0 500 131]
  (a: Seq.seq t_Vec_u64_Global) (b: Seq.seq t_Vec_u64_Global) (ss: int) (off: int) (blocks: int) (return (x: ())) =
{[@stop_split] [@expl:acct_g requires] ([@stop_split] [@expl:acct_g requires #0] [%#sl2'0] tf b ss (Seq.length b)
    = mulw off ss)
  /\ ([@stop_split] [@expl:acct_g requires #1] [%#sl2'1] tf a ss (Seq.length a)
  = tf b ss (Seq.length b) + mulw blocks ss)}
  (! bb0
  [ bb0 = s0 [ s0 = {[@expl:assertion] [%#sl2] let _ = lemma_acct a b ss off blocks in true} s1 | s1 = return {_ret} ] ]
  [ & _ret: () = Any.any_l ()
  | & a: Seq.seq t_Vec_u64_Global = a
  | & b: Seq.seq t_Vec_u64_Global = b
  | & ss: int = ss
  | & off: int = off
  | & blocks: int = blocks ])
  [ return (result: ()) -> {[@stop_split] [@expl:acct_g ensures] [%#sl2'2] tf a ss (Seq.length a)
    = mulw (off + blocks) ss}
    (! return {result}) ]
