use seq.Seq
use creusot.int.UInt64
use bv.Pow2int
use int.Int

type t_Vec_u64_Global

constant const_MAX: UInt64.t = (18446744073709551615: UInt64.t)

function view_Vec_u64_Global (self: t_Vec_u64_Global) : Seq.seq UInt64.t

axiom view_Vec_u64_Global_spec:
  forall self: t_Vec_u64_Global [view_Vec_u64_Global self]. [%#svec] Seq.length (view_Vec_u64_Global self)
    <= UInt64.t'int const_MAX

predicate sr_rel [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/l2.rs" 84 0 84 73] (a: Seq.seq t_Vec_u64_Global) (b: Seq.seq t_Vec_u64_Global) (o: int) (p: int) =
  [%#sl2'10] Seq.length a = Seq.length b
  /\ 0 <= o
  /\ o < Seq.length a
  /\ 0 <= p
  /\ p < Seq.length (view_Vec_u64_Global (Seq.get a o))
  /\ Seq.length (view_Vec_u64_Global (Seq.get b o)) = Seq.length (view_Vec_u64_Global (Seq.get a o)) - 1
  /\ (forall k: int. 0 <= k /\ k < Seq.length (view_Vec_u64_Global (Seq.get b o))
      -> Seq.get (view_Vec_u64_Global (Seq.get b o)) k
      = (if k = p then
        Seq.get (view_Vec_u64_Global (Seq.get a o)) (Seq.length (view_Vec_u64_Global (Seq.get a o)) - 1)
      else
        Seq.get (view_Vec_u64_Global (Seq.get a o)) k
      ))
  /\ (forall q: int. 0 <= q /\ q < Seq.length a /\ q <> o -> Seq.get b q = Seq.get a q)

predicate fv [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/l2.rs" 20 0 20 52] (fl: Seq.seq t_Vec_u64_Global) (o: int) (k: int) =
  [%#sl2'17] 0 <= o /\ o < Seq.length fl /\ 0 <= k /\ k < Seq.length (view_Vec_u64_Global (Seq.get fl o))

predicate disj [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/l2.rs" 32 0 32 55] (x1: int) (l1: int) (x2: int) (l2: int) =
  [%#sl2'20] x1 + l1 <= x2 \/ x2 + l2 <= x1

function fs [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/l2.rs" 26 0 26 51] (fl: Seq.seq t_Vec_u64_Global) (o: int) (k: int) : int
 = [%#sl2'13] UInt64.t'int (Seq.get (view_Vec_u64_Global (Seq.get fl o)) k)

function span [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/buddy.rs" 32 0 32 35] (ss: int) (o: int) : int
 = [%#sbuddy] Pow2int.pow2 o * ss

predicate fdisj [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/l2.rs" 38 0 38 48] (fl: Seq.seq t_Vec_u64_Global) (ss: int) =
  [%#sl2'11] forall o1: int, k1: int, o2: int, k2: int. fv fl o1 k1 /\ fv fl o2 k2 /\ (o1 <> o2 \/ k1 <> k2)
    -> disj (fs fl o1 k1) (span ss o1) (fs fl o2 k2) (span ss o2)

predicate faway [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/l2.rs" 47 0 47 64] (fl: Seq.seq t_Vec_u64_Global) (ss: int) (y: int) (l: int) =
  [%#sl2'12] forall o: int, k: int. fv fl o k -> disj y l (fs fl o k) (span ss o)

predicate ffree [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/l2.rs" 53 0 53 56] (fl: Seq.seq t_Vec_u64_Global) (ss: int) (z: int) =
  [%#sl2'14] exists o: int, k: int. fv fl o k /\ fs fl o k <= z /\ z < fs fl o k + span ss o

predicate fold_k [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/l2.rs" 59 0 59 68] (nw: Seq.seq t_Vec_u64_Global) (od: Seq.seq t_Vec_u64_Global) (kk: int) =
  [%#sl2'15] forall o: int, k: int. fv nw o k /\ o < kk -> (exists j: int. fv od o j /\ fs od o j = fs nw o k)

function srp [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/l2.rs" 105 0 105 69] (a: Seq.seq t_Vec_u64_Global) (o: int) (p: int) (o2: int) (k2: int) : int
 = [%#sl2'18] if o2 = o /\ k2 = p then Seq.length (view_Vec_u64_Global (Seq.get a o)) - 1 else k2

function srq [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/l2.rs" 111 0 111 69] (a: Seq.seq t_Vec_u64_Global) (o: int) (p: int) (o2: int) (k2: int) : int
 = [%#sl2'19] if o2 = o /\ k2 = Seq.length (view_Vec_u64_Global (Seq.get a o)) - 1 then p else k2

function lemma_sr_pos [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/l2.rs" 124 0 124 71] (a: Seq.seq t_Vec_u64_Global) (b: Seq.seq t_Vec_u64_Global) (o: int) (p: int) : ()
 = [%#sl2'16] ()

axiom lemma_sr_pos_spec:
  forall a: Seq.seq t_Vec_u64_Global, b: Seq.seq t_Vec_u64_Global, o: int, p: int. ([%#sl2'6] sr_rel a b o p)
    -> ([%#sl2'7] forall o2: int, k2: int. fv b o2 k2
      -> fv a o2 (srp a o p o2 k2) /\ fs b o2 k2 = fs a o2 (srp a o p o2 k2) /\ (o2 <> o \/ srp a o p o2 k2 <> p))

axiom lemma_sr_pos_spec'0:
  forall a: Seq.seq t_Vec_u64_Global, b: Seq.seq t_Vec_u64_Global, o: int, p: int. ([%#sl2'6] sr_rel a b o p)
    -> ([%#sl2'8] forall o2: int, k2: int, o3: int, k3: int. fv b o2 k2 /\ fv b o3 k3 /\ (o2 <> o3 \/ k2 <> k3)
      -> o2 <> o3 \/ srp a o p o2 k2 <> srp a o p o3 k3)

axiom lemma_sr_pos_spec'1:
  forall a: Seq.seq t_Vec_u64_Global, b: Seq.seq t_Vec_u64_Global, o: int, p: int. ([%#sl2'6] sr_rel a b o p)
    -> ([%#sl2'9] forall o2: int, k2: int. fv a o2 k2 /\ (o2 <> o \/ k2 <> p)
      -> fv b o2 (srq a o p o2 k2) /\ fs b o2 (srq a o p o2 k2) = fs a o2 k2)

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant a : Seq.seq t_Vec_u64_Global

constant b : Seq.seq t_Vec_u64_Global

constant ss : int

constant o : int

constant p : int

function lemma_sr [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/l2.rs" 135 0 135 76] (a: Seq.seq t_Vec_u64_Global) (b: Seq.seq t_Vec_u64_Global) (ss: int) (o: int) (p: int) : ()

goal vc_lemma_sr: ([%#sl2] sr_rel a b o p /\ ss > 0)
  -> ([@stop_split] [@expl:lemma_sr_pos requires] [%#sl2'6] sr_rel a b o p)
  /\ (([@stop_split] [@expl:lemma_sr_pos ensures] ([@stop_split] [@expl:lemma_sr_pos ensures #0] [%#sl2'7] forall o2: int, k2: int. fv b o2 k2
        -> fv a o2 (srp a o p o2 k2) /\ fs b o2 k2 = fs a o2 (srp a o p o2 k2) /\ (o2 <> o \/ srp a o p o2 k2 <> p))
    /\ ([@stop_split] [@expl:lemma_sr_pos ensures #1] [%#sl2'8] forall o2: int, k2: int, o3: int, k3: int. fv b o2 k2
          /\ fv b o3 k3 /\ (o2 <> o3 \/ k2 <> k3) -> o2 <> o3 \/ srp a o p o2 k2 <> srp a o p o3 k3)
    /\ ([@stop_split] [@expl:lemma_sr_pos ensures #2] [%#sl2'9] forall o2: int, k2: int. fv a o2 k2
        /\ (o2 <> o \/ k2 <> p) -> fv b o2 (srq a o p o2 k2) /\ fs b o2 (srq a o p o2 k2) = fs a o2 k2))
  -> (let _ = lemma_sr_pos a b o p in if fdisj a ss then
    (forall o1: int, k1: int, o2: int, k2: int. fv b o1 k1 /\ fv b o2 k2 /\ (o1 <> o2 \/ k1 <> k2)
        -> fs b o1 k1 = fs a o1 (srp a o p o1 k1)
        /\ fs b o2 k2 = fs a o2 (srp a o p o2 k2)
        /\ disj (fs a o1 (srp a o p o1 k1)) (span ss o1) (fs a o2 (srp a o p o2 k2)) (span ss o2))
    && (if fdisj a ss then
      (forall o2: int, k2: int. fv b o2 k2 -> disj (fs a o p) (span ss o) (fs a o2 (srp a o p o2 k2)) (span ss o2))
      && (forall z: int. ffree a ss z /\ not (fs a o p <= z /\ z < fs a o p + span ss o)
          -> (exists o2: int, k2: int. fv a o2 k2
            /\ (o2 <> o \/ k2 <> p) /\ fs a o2 k2 <= z /\ z < fs a o2 k2 + span ss o2))
      && ([@stop_split] [@expl:lemma_sr ensures] ([@stop_split] [@expl:lemma_sr ensures #0] [%#sl2'0] fdisj a ss
        -> fdisj b ss)
      /\ ([@stop_split] [@expl:lemma_sr ensures #1] [%#sl2'1] forall y: int, l: int. faway a ss y l -> faway b ss y l)
      /\ ([@stop_split] [@expl:lemma_sr ensures #2] [%#sl2'2] fdisj a ss -> faway b ss (fs a o p) (span ss o))
      /\ ([@stop_split] [@expl:lemma_sr ensures #3] [%#sl2'3] forall z: int. ffree a ss z
            /\ not (fs a o p <= z /\ z < fs a o p + span ss o) -> ffree b ss z)
      /\ ([@stop_split] [@expl:lemma_sr ensures #4] [%#sl2'4] forall z: int. ffree b ss z -> ffree a ss z)
      /\ ([@stop_split] [@expl:lemma_sr ensures #5] [%#sl2'5] forall kk: int. fold_k b a kk))
    else
      (forall z: int. ffree a ss z /\ not (fs a o p <= z /\ z < fs a o p + span ss o)
          -> (exists o2: int, k2: int. fv a o2 k2
            /\ (o2 <> o \/ k2 <> p) /\ fs a o2 k2 <= z /\ z < fs a o2 k2 + span ss o2))
      && ([@stop_split] [@expl:lemma_sr ensures] ([@stop_split] [@expl:lemma_sr ensures #0] [%#sl2'0] fdisj a ss
        -> fdisj b ss)
      /\ ([@stop_split] [@expl:lemma_sr ensures #1] [%#sl2'1] forall y: int, l: int. faway a ss y l -> faway b ss y l)
      /\ ([@stop_split] [@expl:lemma_sr ensures #2] [%#sl2'2] fdisj a ss -> faway b ss (fs a o p) (span ss o))
      /\ ([@stop_split] [@expl:lemma_sr ensures #3] [%#sl2'3] forall z: int. ffree a ss z
            /\ not (fs a o p <= z /\ z < fs a o p + span ss o) -> ffree b ss z)
      /\ ([@stop_split] [@expl:lemma_sr ensures #4] [%#sl2'4] forall z: int. ffree b ss z -> ffree a ss z)
      /\ ([@stop_split] [@expl:lemma_sr ensures #5] [%#sl2'5] forall kk: int. fold_k b a kk))
    )
  else
    if fdisj a ss then
      (forall o2: int, k2: int. fv b o2 k2 -> disj (fs a o p) (span ss o) (fs a o2 (srp a o p o2 k2)) (span ss o2))
      && (forall z: int. ffree a ss z /\ not (fs a o p <= z /\ z < fs a o p + span ss o)
          -> (exists o2: int, k2: int. fv a o2 k2
            /\ (o2 <> o \/ k2 <> p) /\ fs a o2 k2 <= z /\ z < fs a o2 k2 + span ss o2))
      && ([@stop_split] [@expl:lemma_sr ensures] ([@stop_split] [@expl:lemma_sr ensures #0] [%#sl2'0] fdisj a ss
        -> fdisj b ss)
      /\ ([@stop_split] [@expl:lemma_sr ensures #1] [%#sl2'1] forall y: int, l: int. faway a ss y l -> faway b ss y l)
      /\ ([@stop_split] [@expl:lemma_sr ensures #2] [%#sl2'2] fdisj a ss -> faway b ss (fs a o p) (span ss o))
      /\ ([@stop_split] [@expl:lemma_sr ensures #3] [%#sl2'3] forall z: int. ffree a ss z
            /\ not (fs a o p <= z /\ z < fs a o p + span ss o) -> ffree b ss z)
      /\ ([@stop_split] [@expl:lemma_sr ensures #4] [%#sl2'4] forall z: int. ffree b ss z -> ffree a ss z)
      /\ ([@stop_split] [@expl:lemma_sr ensures #5] [%#sl2'5] forall kk: int. fold_k b a kk))
    else
      (forall z: int. ffree a ss z /\ not (fs a o p <= z /\ z < fs a o p + span ss o)
          -> (exists o2: int, k2: int. fv a o2 k2
            /\ (o2 <> o \/ k2 <> p) /\ fs a o2 k2 <= z /\ z < fs a o2 k2 + span ss o2))
      && ([@stop_split] [@expl:lemma_sr ensures] ([@stop_split] [@expl:lemma_sr ensures #0] [%#sl2'0] fdisj a ss
        -> fdisj b ss)
      /\ ([@stop_split] [@expl:lemma_sr ensures #1] [%#sl2'1] forall y: int, l: int. faway a ss y l -> faway b ss y l)
      /\ ([@stop_split] [@expl:lemma_sr ensures #2] [%#sl2'2] fdisj a ss -> faway b ss (fs a o p) (span ss o))
      /\ ([@stop_split] [@expl:lemma_sr ensures #3] [%#sl2'3] forall z: int. ffree a ss z
            /\ not (fs a o p <= z /\ z < fs a o p + span ss o) -> ffree b ss z)
      /\ ([@stop_split] [@expl:lemma_sr ensures #4] [%#sl2'4] forall z: int. ffree b ss z -> ffree a ss z)
      /\ ([@stop_split] [@expl:lemma_sr ensures #5] [%#sl2'5] forall kk: int. fold_k b a kk))
  
  ))
