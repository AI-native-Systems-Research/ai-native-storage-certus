use seq.Seq
use creusot.int.UInt64
use bv.Pow2int
use int.Int

type t_Vec_u64_Global

constant const_MAX: UInt64.t = (18446744073709551615: UInt64.t)

function view_Vec_u64_Global (self: t_Vec_u64_Global) : Seq.seq UInt64.t

axiom view_Vec_u64_Global_spec:
  forall self: t_Vec_u64_Global [view_Vec_u64_Global self]. [%#svec] Seq.length (view_Vec_u64_Global self)
    <= UInt64.t'int const_MAX

predicate fv [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/l2.rs" 20 0 20 52] (fl: Seq.seq t_Vec_u64_Global) (o: int) (k: int) =
  [%#sl2'8] 0 <= o /\ o < Seq.length fl /\ 0 <= k /\ k < Seq.length (view_Vec_u64_Global (Seq.get fl o))

predicate disj [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/l2.rs" 32 0 32 55] (x1: int) (l1: int) (x2: int) (l2: int) =
  [%#sl2'11] x1 + l1 <= x2 \/ x2 + l2 <= x1

function fs [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/l2.rs" 26 0 26 51] (fl: Seq.seq t_Vec_u64_Global) (o: int) (k: int) : int
 = [%#sl2'9] UInt64.t'int (Seq.get (view_Vec_u64_Global (Seq.get fl o)) k)

function span [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/buddy.rs" 32 0 32 35] (ss: int) (o: int) : int
 = [%#sbuddy] Pow2int.pow2 o * ss

predicate faway [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/l2.rs" 47 0 47 64] (fl: Seq.seq t_Vec_u64_Global) (ss: int) (y: int) (l: int) =
  [%#sl2'7] forall o: int, k: int. fv fl o k -> disj y l (fs fl o k) (span ss o)

function lemma_disj_union [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/l2.rs" 169 0 169 63] (y: int) (l: int) (c: int) (d: int) (s: int) : ()
 = [%#sl2'10] ()

axiom lemma_disj_union_spec: forall y: int, l: int, c: int, d: int, s: int. ([%#sl2'3] s > 0 /\ l > 0)
    -> ([%#sl2'4] d = c + s \/ d = c - s)
    -> ([%#sl2'5] disj y l c s /\ disj y l d s) -> ([%#sl2'6] disj y l (if c <= d then c else d) (2 * s))

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant fl : Seq.seq t_Vec_u64_Global

constant ss : int

constant c : int

constant d : int

constant s : int

function lemma_away_union [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/l2.rs" 177 0 177 75] (fl: Seq.seq t_Vec_u64_Global) (ss: int) (c: int) (d: int) (s: int) : ()

goal vc_lemma_away_union: ([%#sl2] s > 0 /\ (d = c + s \/ d = c - s))
  -> ([%#sl2'0] faway fl ss c s /\ faway fl ss d s)
  -> ([%#sl2'1] forall o: int. 0 <= o -> span ss o > 0)
  -> (forall o: int, k: int. if fv fl o k then
        ([@stop_split] [@expl:lemma_disj_union requires] ([@stop_split] [@expl:lemma_disj_union requires #0] [%#sl2'3] s
              > 0
            /\ span ss o > 0)
          /\ ([@stop_split] [@expl:lemma_disj_union requires #1] [%#sl2'4] d = c + s \/ d = c - s)
          /\ ([@stop_split] [@expl:lemma_disj_union requires #2] [%#sl2'5] disj (fs fl o k) (span ss o) c s
          /\ disj (fs fl o k) (span ss o) d s))
        /\ (([@stop_split] [@expl:lemma_disj_union ensures] [%#sl2'6] disj (fs fl o k) (span ss o) (if c <= d then
            c
          else
            d
          ) (2 * s)) -> (let _ = lemma_disj_union (fs fl o k) (span ss o) c d s in true))
      else
        true
    )
  /\ (forall o: int, k: int. fv fl o k
      -> (let _ = lemma_disj_union (fs fl o k) (span ss o) c d s in disj (fs fl o k) (span ss o) (if c <= d then
        c
      else
        d
      ) (2 * s)))
  && ([@stop_split] [@expl:lemma_away_union ensures] [%#sl2'2] faway fl ss (if c <= d then c else d) (2 * s))
