use creusot.prelude.Any
use creusot.int.UInt64BW

type t_Ordering = Less | Equal | Greater

function cmp_log_u64 (self: UInt64BW.t) (o: UInt64BW.t) : t_Ordering = [%#sord'12] if UInt64BW.lt self o then
    Less
  else
    if self = o then Equal else Greater


function eq_cmp_u64 (x: UInt64BW.t) (y: UInt64BW.t) : ()

axiom eq_cmp_u64_spec: forall x: UInt64BW.t, y: UInt64BW.t. [%#sord'11] (x = y) = (cmp_log_u64 x y = Equal)

function antisym2_u64 (x: UInt64BW.t) (y: UInt64BW.t) : ()

axiom antisym2_u64_spec: forall x: UInt64BW.t, y: UInt64BW.t. ([%#sord'9] cmp_log_u64 x y = Greater)
    -> ([%#sord'10] cmp_log_u64 y x = Less)

function antisym1_u64 (x: UInt64BW.t) (y: UInt64BW.t) : ()

axiom antisym1_u64_spec: forall x: UInt64BW.t, y: UInt64BW.t. ([%#sord'7] cmp_log_u64 x y = Less)
    -> ([%#sord'8] cmp_log_u64 y x = Greater)

function trans_u64 (x: UInt64BW.t) (y: UInt64BW.t) (z: UInt64BW.t) (o: t_Ordering) : ()

axiom trans_u64_spec: forall x: UInt64BW.t, y: UInt64BW.t, z: UInt64BW.t, o: t_Ordering. ([%#sord'4] cmp_log_u64 x y
      = o) -> ([%#sord'5] cmp_log_u64 y z = o) -> ([%#sord'6] cmp_log_u64 x z = o)

function refl_u64 (x: UInt64BW.t) : ()

axiom refl_u64_spec: forall x: UInt64BW.t. [%#sord'3] cmp_log_u64 x x = Equal

function cmp_gt_log_u64 (x: UInt64BW.t) (y: UInt64BW.t) : ()

axiom cmp_gt_log_u64_spec: forall x: UInt64BW.t, y: UInt64BW.t. [%#sord'2] UInt64BW.gt x y = (cmp_log_u64 x y = Greater)

function cmp_ge_log_u64 (x: UInt64BW.t) (y: UInt64BW.t) : ()

axiom cmp_ge_log_u64_spec: forall x: UInt64BW.t, y: UInt64BW.t. [%#sord'1] UInt64BW.ge x y = (cmp_log_u64 x y <> Less)

function cmp_lt_log_u64 (x: UInt64BW.t) (y: UInt64BW.t) : ()

axiom cmp_lt_log_u64_spec: forall x: UInt64BW.t, y: UInt64BW.t. [%#sord'0] UInt64BW.lt x y = (cmp_log_u64 x y = Less)

function cmp_le_log_u64 (x: UInt64BW.t) (y: UInt64BW.t) : ()

axiom cmp_le_log_u64_spec: forall x: UInt64BW.t, y: UInt64BW.t. [%#sord] UInt64BW.le x y = (cmp_log_u64 x y <> Greater)

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let bf_maskshift [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/l2.rs" 313 0 313 35]
  (x: UInt64BW.t) (m: UInt64BW.t) (return (x'0: ())) =
{[@stop_split] [@expl:bf_maskshift requires] [%#sl2] UInt64BW.lt m (64: UInt64BW.t)}
  (! bb0
  [ bb0 = return {_ret} ] [ & _ret: () = Any.any_l () ])
  [ return (result: ()) ->
  {[@stop_split] [@expl:bf_maskshift ensures] [%#sl2'0] UInt64BW.bw_and x (UInt64BW.bw_not (UInt64BW.sub (UInt64BW.shl (1: UInt64BW.t) m) (1: UInt64BW.t)))
    = UInt64BW.shl (UInt64BW.shr x m) m}
    (! return {result}) ]
