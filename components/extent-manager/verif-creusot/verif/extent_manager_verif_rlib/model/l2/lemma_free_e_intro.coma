  [%#sl2'3] forall o: int, k: int. fv fl o k -> disj y l (fs fl o k) (span ss o)

predicate free_e [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/l2.rs" 511 0 511 83] (a: Seq.seq t_Vec_u64_Global) (b: Seq.seq t_Vec_u64_Global) (ss: int) (x: int) (l0: int) =
  [%#sl2'5] (fdisj a ss /\ faway a ss x l0 -> fdisj b ss)
  /\ (forall y: int, l: int. 0 < l /\ faway a ss y l /\ disj y l x l0 -> faway b ss y l)

