use seq.Seq
use creusot.int.UInt64
use int.ComputerDivision
use bv.Pow2int
use int.Int

type t_Vec_u64_Global

constant const_MAX: UInt64.t = (18446744073709551615: UInt64.t)

function view_Vec_u64_Global (self: t_Vec_u64_Global) : Seq.seq UInt64.t

axiom view_Vec_u64_Global_spec:
  forall self: t_Vec_u64_Global [view_Vec_u64_Global self]. [%#svec] Seq.length (view_Vec_u64_Global self)
    <= UInt64.t'int const_MAX

predicate sr_rel [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/l2.rs" 84 0 84 73] (a: Seq.seq t_Vec_u64_Global) (b: Seq.seq t_Vec_u64_Global) (o: int) (p: int) =
  [%#sl2'3] Seq.length a = Seq.length b
  /\ 0 <= o
  /\ o < Seq.length a
  /\ 0 <= p
  /\ p < Seq.length (view_Vec_u64_Global (Seq.get a o))
  /\ Seq.length (view_Vec_u64_Global (Seq.get b o)) = Seq.length (view_Vec_u64_Global (Seq.get a o)) - 1
  /\ (forall k: int. 0 <= k /\ k < Seq.length (view_Vec_u64_Global (Seq.get b o))
      -> Seq.get (view_Vec_u64_Global (Seq.get b o)) k
      = (if k = p then
        Seq.get (view_Vec_u64_Global (Seq.get a o)) (Seq.length (view_Vec_u64_Global (Seq.get a o)) - 1)
      else
        Seq.get (view_Vec_u64_Global (Seq.get a o)) k
      ))
  /\ (forall q: int. 0 <= q /\ q < Seq.length a /\ q <> o -> Seq.get b q = Seq.get a q)

predicate fv [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/l2.rs" 20 0 20 52] (fl: Seq.seq t_Vec_u64_Global) (o: int) (k: int) =
  [%#sl2'4] 0 <= o /\ o < Seq.length fl /\ 0 <= k /\ k < Seq.length (view_Vec_u64_Global (Seq.get fl o))

function fs [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/l2.rs" 26 0 26 51] (fl: Seq.seq t_Vec_u64_Global) (o: int) (k: int) : int
 = [%#sl2'6] UInt64.t'int (Seq.get (view_Vec_u64_Global (Seq.get fl o)) k)

function span [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/buddy.rs" 32 0 32 35] (ss: int) (o: int) : int
 = [%#sbuddy] Pow2int.pow2 o * ss

predicate coal [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/l2m.rs" 97 0 97 47] (fl: Seq.seq t_Vec_u64_Global) (ss: int) =
  [%#sl2m'1] forall o: int, k1: int, k2: int. fv fl o k1
      /\ fv fl o k2
      /\ o + 1 < Seq.length fl /\ ComputerDivision.mod (ComputerDivision.div (fs fl o k1) (span ss o)) 2 = 0
    -> fs fl o k2 <> fs fl o k1 + span ss o

function srp [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/l2.rs" 105 0 105 69] (a: Seq.seq t_Vec_u64_Global) (o: int) (p: int) (o2: int) (k2: int) : int
 = [%#sl2'5] if o2 = o /\ k2 = p then Seq.length (view_Vec_u64_Global (Seq.get a o)) - 1 else k2

function srq [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/l2.rs" 111 0 111 69] (a: Seq.seq t_Vec_u64_Global) (o: int) (p: int) (o2: int) (k2: int) : int
 = [%#sl2'7] if o2 = o /\ k2 = Seq.length (view_Vec_u64_Global (Seq.get a o)) - 1 then p else k2

function lemma_sr_pos [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/l2.rs" 124 0 124 71] (a: Seq.seq t_Vec_u64_Global) (b: Seq.seq t_Vec_u64_Global) (o: int) (p: int) : ()

axiom lemma_sr_pos_spec:
  forall a: Seq.seq t_Vec_u64_Global, b: Seq.seq t_Vec_u64_Global, o: int, p: int. ([%#sl2] sr_rel a b o p)
    -> ([%#sl2'0] forall o2: int, k2: int. fv b o2 k2
      -> fv a o2 (srp a o p o2 k2) /\ fs b o2 k2 = fs a o2 (srp a o p o2 k2) /\ (o2 <> o \/ srp a o p o2 k2 <> p))

axiom lemma_sr_pos_spec'0:
  forall a: Seq.seq t_Vec_u64_Global, b: Seq.seq t_Vec_u64_Global, o: int, p: int. ([%#sl2] sr_rel a b o p)
    -> ([%#sl2'1] forall o2: int, k2: int, o3: int, k3: int. fv b o2 k2 /\ fv b o3 k3 /\ (o2 <> o3 \/ k2 <> k3)
      -> o2 <> o3 \/ srp a o p o2 k2 <> srp a o p o3 k3)

axiom lemma_sr_pos_spec'1:
  forall a: Seq.seq t_Vec_u64_Global, b: Seq.seq t_Vec_u64_Global, o: int, p: int. ([%#sl2] sr_rel a b o p)
    -> ([%#sl2'2] forall o2: int, k2: int. fv a o2 k2 /\ (o2 <> o \/ k2 <> p)
      -> fv b o2 (srq a o p o2 k2) /\ fs b o2 (srq a o p o2 k2) = fs a o2 k2)

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant a : Seq.seq t_Vec_u64_Global

constant b : Seq.seq t_Vec_u64_Global

constant ss : int

constant o : int

constant p : int

function lemma_coal_sr [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/l2m.rs" 124 0 124 81] (a: Seq.seq t_Vec_u64_Global) (b: Seq.seq t_Vec_u64_Global) (ss: int) (o: int) (p: int) : ()

goal vc_lemma_coal_sr: ([%#sl2m] sr_rel a b o p /\ coal a ss)
  -> ([@stop_split] [@expl:lemma_sr_pos requires] [%#sl2] sr_rel a b o p)
  /\ (([@stop_split] [@expl:lemma_sr_pos ensures] ([@stop_split] [@expl:lemma_sr_pos ensures #0] [%#sl2'0] forall o2: int, k2: int. fv b o2 k2
        -> fv a o2 (srp a o p o2 k2) /\ fs b o2 k2 = fs a o2 (srp a o p o2 k2) /\ (o2 <> o \/ srp a o p o2 k2 <> p))
    /\ ([@stop_split] [@expl:lemma_sr_pos ensures #1] [%#sl2'1] forall o2: int, k2: int, o3: int, k3: int. fv b o2 k2
          /\ fv b o3 k3 /\ (o2 <> o3 \/ k2 <> k3) -> o2 <> o3 \/ srp a o p o2 k2 <> srp a o p o3 k3)
    /\ ([@stop_split] [@expl:lemma_sr_pos ensures #2] [%#sl2'2] forall o2: int, k2: int. fv a o2 k2
        /\ (o2 <> o \/ k2 <> p) -> fv b o2 (srq a o p o2 k2) /\ fs b o2 (srq a o p o2 k2) = fs a o2 k2))
  -> ([@stop_split] [@expl:lemma_coal_sr ensures] [%#sl2m'0] coal b ss))
