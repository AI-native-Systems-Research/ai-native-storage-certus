use int.ComputerDivision
use int.Int

function lemma_divmod [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/buddy.rs" 184 0 184 35] (x: int) (m: int) : ()

axiom lemma_divmod_spec: forall x: int, m: int. ([%#sbuddy] m > 0 /\ x >= 0)
    -> ([%#sbuddy'0] x = m * ComputerDivision.div x m + ComputerDivision.mod x m)

axiom lemma_divmod_spec'0: forall x: int, m: int. ([%#sbuddy] m > 0 /\ x >= 0)
    -> ([%#sbuddy'1] 0 <= ComputerDivision.mod x m /\ ComputerDivision.mod x m < m)

axiom lemma_divmod_spec'1: forall x: int, m: int. ([%#sbuddy] m > 0 /\ x >= 0)
    -> ([%#sbuddy'2] ComputerDivision.div x m >= 0)

function lemma_assoc [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/buddy.rs" 160 0 160 42] (a: int) (b: int) (c: int) : ()

axiom lemma_assoc_spec: forall a: int, b: int, c: int. [%#sbuddy'3] a * b * c = a * b * c

function lemma_mul_mod0 [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/buddy.rs" 170 0 170 37] (m: int) (k: int) : ()

axiom lemma_mul_mod0_spec: forall m: int, k: int. ([%#sbuddy'4] m > 0 /\ k >= 0)
    -> ([%#sbuddy'5] ComputerDivision.mod (m * k) m = 0)

axiom lemma_mul_mod0_spec'0: forall m: int, k: int. ([%#sbuddy'4] m > 0 /\ k >= 0)
    -> ([%#sbuddy'6] ComputerDivision.div (m * k) m = k)

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant t : int

constant h : int

function lemma_even_q [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/l2m.rs" 29 0 29 35] (t: int) (h: int) : ()

goal vc_lemma_even_q: ([%#sl2m] h > 0 /\ t >= 0 /\ ComputerDivision.mod t (2 * h) = 0)
  -> ([@stop_split] [@expl:lemma_divmod requires] [%#sbuddy] 2 * h > 0 /\ t >= 0)
  /\ (([@stop_split] [@expl:lemma_divmod ensures] ([@stop_split] [@expl:lemma_divmod ensures #0] [%#sbuddy'0] t
      = 2 * h * ComputerDivision.div t (2 * h) + ComputerDivision.mod t (2 * h))
    /\ ([@stop_split] [@expl:lemma_divmod ensures #1] [%#sbuddy'1] 0 <= ComputerDivision.mod t (2 * h)
      /\ ComputerDivision.mod t (2 * h) < 2 * h)
    /\ ([@stop_split] [@expl:lemma_divmod ensures #2] [%#sbuddy'2] ComputerDivision.div t (2 * h) >= 0))
  -> (let _ = lemma_divmod t (2 * h) in ([@stop_split] [@expl:lemma_assoc ensures] [%#sbuddy'3] h * 2
      * ComputerDivision.div t (2 * h)
    = h * 2 * ComputerDivision.div t (2 * h))
  -> (let _ = lemma_assoc h 2 (ComputerDivision.div t (2
  * h)) in ([@stop_split] [@expl:lemma_mul_mod0 requires] [%#sbuddy'4] h > 0 /\ 2 * ComputerDivision.div t (2 * h) >= 0)
  /\ (([@stop_split] [@expl:lemma_mul_mod0 ensures] ([@stop_split] [@expl:lemma_mul_mod0 ensures #0] [%#sbuddy'5] ComputerDivision.mod (h
          * 2
        * ComputerDivision.div t (2 * h)) h
      = 0)
    /\ ([@stop_split] [@expl:lemma_mul_mod0 ensures #1] [%#sbuddy'6] ComputerDivision.div (h * 2
      * ComputerDivision.div t (2 * h)) h
    = 2 * ComputerDivision.div t (2 * h)))
  -> (let _ = lemma_mul_mod0 h (2
  * ComputerDivision.div t (2 * h)) in ([@stop_split] [@expl:lemma_mul_mod0 requires] [%#sbuddy'4] 2 > 0
    /\ ComputerDivision.div t (2 * h) >= 0)
  /\ (([@stop_split] [@expl:lemma_mul_mod0 ensures] ([@stop_split] [@expl:lemma_mul_mod0 ensures #0] [%#sbuddy'5] ComputerDivision.mod (2
        * ComputerDivision.div t (2 * h)) 2
      = 0)
    /\ ([@stop_split] [@expl:lemma_mul_mod0 ensures #1] [%#sbuddy'6] ComputerDivision.div (2
      * ComputerDivision.div t (2 * h)) 2
    = ComputerDivision.div t (2 * h)))
  -> ([@stop_split] [@expl:lemma_even_q ensures] ([@stop_split] [@expl:lemma_even_q ensures #0] [%#sl2m'0] ComputerDivision.mod (ComputerDivision.div t h) 2
    = 0)
  /\ ([@stop_split] [@expl:lemma_even_q ensures #1] [%#sl2m'1] ComputerDivision.mod t h = 0))))))))
