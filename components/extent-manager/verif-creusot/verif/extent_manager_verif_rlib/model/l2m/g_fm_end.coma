axiom lemma_span_pos_spec: forall ss: int, o: int. ([%#sbuddy'0] ss > 0 /\ 0 <= o) -> ([%#sbuddy'1] span ss o >= ss)

axiom lemma_span_pos_spec'0: forall ss: int, o: int. ([%#sbuddy'0] ss > 0 /\ 0 <= o) -> ([%#sbuddy'2] span ss o > 0)

