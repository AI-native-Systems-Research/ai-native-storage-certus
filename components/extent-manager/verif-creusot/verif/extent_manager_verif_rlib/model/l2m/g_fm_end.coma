    -> ([%#sbuddy'9] ComputerDivision.div (x - m) m = ComputerDivision.div x m - 1)

axiom lemma_div_sub_spec'0: forall x: int, m: int. ([%#sbuddy'8] m > 0 /\ x >= m /\ ComputerDivision.mod x m = 0)
    -> ([%#sbuddy'10] ComputerDivision.mod (x - m) m = 0)

