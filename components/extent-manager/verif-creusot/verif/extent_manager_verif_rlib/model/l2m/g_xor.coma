axiom lemma_span_p2_spec: forall ss: int, o: int. ([%#sl2'2] p2 ss /\ 0 <= o)
    -> ([%#sl2'3] 0 <= log2 ss /\ ss = Pow2int.pow2 (log2 ss))

axiom lemma_span_p2_spec'0: forall ss: int, o: int. ([%#sl2'2] p2 ss /\ 0 <= o)
    -> ([%#sl2'4] span ss o = Pow2int.pow2 (o + log2 ss))

function lemma_pow2_mono [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/buddy.rs" 59 0 59 38] (a: int) (b: int) : ()

axiom lemma_pow2_mono_spec: forall a: int, b: int. ([%#sbuddy'0] 0 <= a /\ a <= b)
    -> ([%#sbuddy'1] Pow2int.pow2 a <= Pow2int.pow2 b)

