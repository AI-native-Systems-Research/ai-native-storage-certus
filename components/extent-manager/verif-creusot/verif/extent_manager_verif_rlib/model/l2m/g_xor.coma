let g_xor [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/l2m.rs" 78 0 78 65]
  (a: UInt64.t) (s: UInt64.t) (ss: int) (o: int) (return (x: ())) =
{[@stop_split] [@expl:g_xor requires] [%#sl2m'4] UInt64.t'int s = span ss o
  /\ ss > 0 /\ 0 <= o /\ UInt64.t'int s > 0 /\ ComputerDivision.mod (UInt64.t'int a) (UInt64.t'int s) = 0}
  (! bb0
  [ bb0 = s0
    [ s0 = xor_fact [%#sl2m'0] {a} {s} {[%#sl2m] o + log2 ss} (fun (_x: ()) -> [ &_14 <- _x ] s1)
    | s1 = {[@expl:assertion] [%#sl2m'1] Pow2int.pow2 64 = 18446744073709551616} s2
    | s2 = {[@expl:assertion] [%#sl2m'2] p2 ss
