      s3
    | s3 = {[@expl:assertion] [%#sl2m'3] p2 ss
      -> o + log2 ss >= 64 -> (let _ = lemma_pow2_mono 64 (o + log2 ss) in false)}
      s4
    | s4 = return {_ret} ] ]
  [ & _ret: () = Any.any_l ()
  | & a: UInt64.t = a
  | & s: UInt64.t = s
  | & ss: int = ss
  | & o: int = o
  | & _14: () = Any.any_l () ])
  [ return (result: ()) -> {[@stop_split] [@expl:g_xor ensures] [%#sl2m'5] p2 ss
    -> ComputerDivision.mod (UInt64.t'int (UInt64.bw_xor a s)) (UInt64.t'int s) = 0}
    (! return {result}) ]
