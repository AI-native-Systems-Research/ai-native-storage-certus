axiom log2_def: forall x: int [log2 x]. log2 x = ([%#sl2'0] if x <= 1 then 0 else 1 + log2 (ComputerDivision.div x 2))

let xor_fact (a: UInt64.t) (s: UInt64.t) (e: int) (return (x: ())) =
