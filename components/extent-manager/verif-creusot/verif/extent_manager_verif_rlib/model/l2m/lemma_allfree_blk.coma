function lemma_div_sub [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/buddy.rs" 124 0 124 36] (x: int) (m: int) : ()

axiom lemma_div_sub_spec: forall x: int, m: int. ([%#sbuddy'14] m > 0 /\ x >= m /\ ComputerDivision.mod x m = 0)
    -> ([%#sbuddy'15] ComputerDivision.div (x - m) m = ComputerDivision.div x m - 1)

axiom lemma_div_sub_spec'0: forall x: int, m: int. ([%#sbuddy'14] m > 0 /\ x >= m /\ ComputerDivision.mod x m = 0)
    -> ([%#sbuddy'16] ComputerDivision.mod (x - m) m = 0)

function lemma_div_succ [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/l2m.rs" 18 0 18 37] (x: int) (m: int) : ()
 = [%#sl2m'18] let _ = lemma_mod_self m in let _ = lemma_mod_add x m m in lemma_div_sub (x + m) m

axiom lemma_div_succ_spec: forall x: int, m: int. ([%#sl2m'8] m > 0 /\ x >= 0 /\ ComputerDivision.mod x m = 0)
    -> ([%#sl2m'9] ComputerDivision.div (x + m) m = ComputerDivision.div x m + 1)

axiom lemma_div_succ_spec'0: forall x: int, m: int. ([%#sl2m'8] m > 0 /\ x >= 0 /\ ComputerDivision.mod x m = 0)
    -> ([%#sl2m'10] ComputerDivision.mod (x + m) m = 0)

predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
  [%#swell_founded] self >= 0 /\ self > other

meta "rewrite_def" predicate well_founded_relation_Int

function lemma_divmod [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/buddy.rs" 184 0 184 35] (x: int) (m: int) : ()

axiom lemma_divmod_spec: forall x: int, m: int. ([%#sbuddy'17] m > 0 /\ x >= 0)
    -> ([%#sbuddy'18] x = m * ComputerDivision.div x m + ComputerDivision.mod x m)

axiom lemma_divmod_spec'0: forall x: int, m: int. ([%#sbuddy'17] m > 0 /\ x >= 0)
    -> ([%#sbuddy'19] 0 <= ComputerDivision.mod x m /\ ComputerDivision.mod x m < m)

axiom lemma_divmod_spec'1: forall x: int, m: int. ([%#sbuddy'17] m > 0 /\ x >= 0)
    -> ([%#sbuddy'20] ComputerDivision.div x m >= 0)

function lemma_assoc [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/buddy.rs" 160 0 160 42] (a: int) (b: int) (c: int) : ()

axiom lemma_assoc_spec: forall a: int, b: int, c: int. [%#sbuddy'21] a * b * c = a * b * c

function lemma_mul_mod0 [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/buddy.rs" 170 0 170 37] (m: int) (k: int) : ()

axiom lemma_mul_mod0_spec: forall m: int, k: int. ([%#sbuddy'22] m > 0 /\ k >= 0)
    -> ([%#sbuddy'23] ComputerDivision.mod (m * k) m = 0)

axiom lemma_mul_mod0_spec'0: forall m: int, k: int. ([%#sbuddy'22] m > 0 /\ k >= 0)
    -> ([%#sbuddy'24] ComputerDivision.div (m * k) m = k)

function lemma_even_q [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/l2m.rs" 29 0 29 35] (t: int) (h: int) : ()
 = [%#sl2m'26] let _ = lemma_divmod t (2 * h) in let _ = lemma_assoc h 2 (ComputerDivision.div t (2
  * h)) in let _ = lemma_mul_mod0 h (2 * ComputerDivision.div t (2 * h)) in lemma_mul_mod0 2 (ComputerDivision.div t (2
  * h))

axiom lemma_even_q_spec: forall t: int, h: int. ([%#sl2m'23] h > 0 /\ t >= 0 /\ ComputerDivision.mod t (2 * h) = 0)
    -> ([%#sl2m'24] ComputerDivision.mod (ComputerDivision.div t h) 2 = 0)

axiom lemma_even_q_spec'0: forall t: int, h: int. ([%#sl2m'23] h > 0 /\ t >= 0 /\ ComputerDivision.mod t (2 * h) = 0)
    -> ([%#sl2m'25] ComputerDivision.mod t h = 0)

function lemma_merge_step [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/l2m.rs" 200 0 200 68] (fl: Seq.seq t_Vec_u64_Global) (ss: int) (kk: int) (t: int) : ()
 = [%#sl2m'19] let _ = lemma_span_succ ss (kk - 1) in let _ = lemma_span_pos ss (kk
  - 1) in let _ = lemma_span_pos ss kk in let _ = lemma_even_q t (span ss (kk - 1)) in ()

axiom lemma_merge_step_spec: forall fl: Seq.seq t_Vec_u64_Global, ss: int, kk: int, t: int. ([%#sl2m'11] coal fl ss
      /\ fal fl ss /\ ss > 0)
    -> ([%#sl2m'12] 0 < kk /\ kk < Seq.length fl /\ t >= 0 /\ ComputerDivision.mod t (span ss kk) = 0)
    -> ([%#sl2m'13] inblk fl ss (kk - 1) t /\ inblk fl ss (kk - 1) (t + span ss (kk - 1)))
    -> ([%#sl2m'14] inblk fl ss kk t)

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant fl : Seq.seq t_Vec_u64_Global

constant ss : int

