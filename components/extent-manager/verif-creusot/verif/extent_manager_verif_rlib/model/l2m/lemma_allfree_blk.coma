  [%#sl2m'15] forall o: int, k1: int, k2: int. fv fl o k1
      /\ fv fl o k2
      /\ o + 1 < Seq.length fl /\ ComputerDivision.mod (ComputerDivision.div (fs fl o k1) (span ss o)) 2 = 0
    -> fs fl o k2 <> fs fl o k1 + span ss o

predicate fal [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/l2m.rs" 157 0 157 46] (fl: Seq.seq t_Vec_u64_Global) (ss: int) =
  [%#sl2m'16] forall o: int, k: int. fv fl o k -> ComputerDivision.mod (fs fl o k) (span ss o) = 0

predicate ffree [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/l2.rs" 53 0 53 56] (fl: Seq.seq t_Vec_u64_Global) (ss: int) (z: int) =
  [%#sl2'1] exists o: int, k: int. fv fl o k /\ fs fl o k <= z /\ z < fs fl o k + span ss o

predicate inblk [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/l2.rs" 67 0 67 65] (fl: Seq.seq t_Vec_u64_Global) (ss: int) (kk: int) (t: int) =
  [%#sl2'2] exists o: int, k: int. fv fl o k /\ o >= kk /\ fs fl o k <= t /\ t + span ss kk <= fs fl o k + span ss o

function lemma_span_pos [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/buddy.rs" 114 0 114 38] (ss: int) (o: int) : ()

axiom lemma_span_pos_spec: forall ss: int, o: int. ([%#sbuddy] ss > 0 /\ 0 <= o) -> ([%#sbuddy'0] span ss o >= ss)

axiom lemma_span_pos_spec'0: forall ss: int, o: int. ([%#sbuddy] ss > 0 /\ 0 <= o) -> ([%#sbuddy'1] span ss o > 0)

function lemma_span_mult [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/l2.rs" 218 0 218 47] (ss: int) (a: int) (b: int) : ()

axiom lemma_span_mult_spec: forall ss: int, a: int, b: int. ([%#sl2] ss > 0 /\ 0 <= a /\ a <= b)
    -> ([%#sl2'0] ComputerDivision.mod (span ss b) (span ss a) = 0)

function lemma_span_div [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/buddy.rs" 201 0 201 54] (x: int) (ss: int) (a: int) (b: int) : ()

axiom lemma_span_div_spec: forall x: int, ss: int, a: int, b: int. ([%#sbuddy'2] ss > 0 /\ 0 <= a /\ a <= b /\ x >= 0)
    -> ([%#sbuddy'3] ComputerDivision.mod x (span ss b) = 0) -> ([%#sbuddy'4] ComputerDivision.mod x (span ss a) = 0)

function lemma_aligned_disj2 [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/l2.rs" 207 0 207 50] (x: int) (y: int) (m: int) : ()

axiom lemma_aligned_disj2_spec: forall x: int, y: int, m: int. ([%#sl2'5] m > 0
      /\ x >= 0 /\ y >= 0 /\ ComputerDivision.mod x m = 0 /\ ComputerDivision.mod y m = 0 /\ x < y)
    -> ([%#sl2'6] x + m <= y)

function lemma_lam [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/l2.rs" 196 0 196 48] (t: int) (g: int) (m: int) (n: int) : ()

axiom lemma_lam_spec: forall t: int, g: int, m: int, n: int. ([%#sl2'7] m > 0
      /\ n > 0
      /\ ComputerDivision.mod n m = 0
      /\ ComputerDivision.mod t m = 0 /\ ComputerDivision.mod g m = 0 /\ t >= 0 /\ g >= 0)
    -> ([%#sl2'8] g <= t /\ t < g + n) -> ([%#sl2'9] t + m <= g + n)

predicate lemma_inblk_intro [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/l2m.rs" 167 0 167 93] (fl: Seq.seq t_Vec_u64_Global) (ss: int) (kk: int) (t: int) (o: int) (k: int) =
  [%#sl2m'22] true

axiom lemma_inblk_intro_spec:
  forall fl: Seq.seq t_Vec_u64_Global, ss: int, kk: int, t: int, o: int, k: int [lemma_inblk_intro fl ss kk t o k]. ([%#sl2m'20] fv fl o k
      /\ o >= kk /\ fs fl o k <= t /\ t + span ss kk <= fs fl o k + span ss o)
    -> ([%#sl2m'21] lemma_inblk_intro fl ss kk t o k /\ inblk fl ss kk t)

predicate lemma_ms_hi [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/l2m.rs" 180 0 180 95] (fl: Seq.seq t_Vec_u64_Global) (ss: int) (kk: int) (t: int) (o: int) (k: int) (y: int) =
  [%#sl2m'17] let _ = lemma_span_pos ss kk in let _ = lemma_span_mult ss kk o in let _ = lemma_span_div (fs fl o k) ss kk o in if fs fl o k
  > t then
    let _ = lemma_aligned_disj2 t (fs fl o k) (span ss kk) in true
  else
    let _ = lemma_lam t (fs fl o k) (span ss kk) (span ss o) in lemma_inblk_intro fl ss kk t o k


axiom lemma_ms_hi_spec:
  forall fl: Seq.seq t_Vec_u64_Global, ss: int, kk: int, t: int, o: int, k: int, y: int [lemma_ms_hi fl ss kk t o k y]. ([%#sl2m'4] fal fl ss
      /\ ss > 0 /\ fv fl o k /\ 0 <= kk /\ kk <= o)
    -> ([%#sl2m'5] t >= 0 /\ ComputerDivision.mod t (span ss kk) = 0 /\ t <= y /\ y < t + span ss kk)
    -> ([%#sl2m'6] fs fl o k <= y /\ y < fs fl o k + span ss o)
    -> ([%#sl2m'7] lemma_ms_hi fl ss kk t o k y
    /\ fs fl o k <= t /\ t + span ss kk <= fs fl o k + span ss o /\ inblk fl ss kk t)

function lemma_span_succ [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/buddy.rs" 95 0 95 39] (ss: int) (o: int) : ()

axiom lemma_span_succ_spec: forall ss: int, o: int. ([%#sbuddy'5] 0 <= o)
    -> ([%#sbuddy'6] span ss (o + 1) = 2 * span ss o)

function lemma_mod_self [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/buddy.rs" 175 0 175 29] (m: int) : ()

axiom lemma_mod_self_spec: forall m: int. ([%#sbuddy'9] m > 0) -> ([%#sbuddy'10] ComputerDivision.mod m m = 0)

function lemma_mod_add [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/buddy.rs" 214 0 214 44] (x: int) (y: int) (m: int) : ()

axiom lemma_mod_add_spec: forall x: int, y: int, m: int. ([%#sbuddy'11] m > 0
      /\ x >= 0 /\ y >= 0 /\ ComputerDivision.mod x m = 0 /\ ComputerDivision.mod y m = 0)
    -> ([%#sbuddy'12] ComputerDivision.mod (x + y) m = 0)

axiom lemma_mod_add_spec'0: forall x: int, y: int, m: int. ([%#sbuddy'11] m > 0
      /\ x >= 0 /\ y >= 0 /\ ComputerDivision.mod x m = 0 /\ ComputerDivision.mod y m = 0)
