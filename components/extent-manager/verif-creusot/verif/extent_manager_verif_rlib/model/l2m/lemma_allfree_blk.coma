function lemma_allfree_blk [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/l2m.rs" 233 0 233 69] (fl: Seq.seq t_Vec_u64_Global) (ss: int) (kk: int) (t: int) : ()

goal vc_lemma_allfree_blk: ([%#sl2m'0] coal fl ss /\ fal fl ss /\ ss > 0)
  -> ([%#sl2m'1] 0 <= kk /\ kk < Seq.length fl /\ t >= 0 /\ ComputerDivision.mod t (span ss kk) = 0)
  -> ([%#sl2m'2] forall z: int. t <= z /\ z < t + span ss kk -> ffree fl ss z)
  -> (if kk = 0 then
    ([@stop_split] [@expl:lemma_span_pos requires] [%#sbuddy] ss > 0 /\ 0 <= 0)
    /\ (([@stop_split] [@expl:lemma_span_pos ensures] ([@stop_split] [@expl:lemma_span_pos ensures #0] [%#sbuddy'0] span ss 0
        >= ss)
      /\ ([@stop_split] [@expl:lemma_span_pos ensures #1] [%#sbuddy'1] span ss 0 > 0))
    -> (let _ = lemma_span_pos ss 0 in ffree fl ss t
    && (forall o: int, k: int. if fv fl o k then
          if fs fl o k <= t then
            if t < fs fl o k + span ss o then
              ([@stop_split] [@expl:lemma_span_mult requires] [%#sl2] ss > 0 /\ 0 <= 0 /\ 0 <= o)
              /\ (([@stop_split] [@expl:lemma_span_mult ensures] [%#sl2'0] ComputerDivision.mod (span ss o) (span ss 0)
                = 0)
              -> (let _ = lemma_span_mult ss 0 o in ([@stop_split] [@expl:lemma_span_div requires] ([@stop_split] [@expl:lemma_span_div requires #0] [%#sbuddy'2] ss
                    > 0
                  /\ 0 <= 0 /\ 0 <= o /\ fs fl o k >= 0)
                /\ ([@stop_split] [@expl:lemma_span_div requires #1] [%#sbuddy'3] ComputerDivision.mod (fs fl o k) (span ss o)
                = 0))
              /\ (([@stop_split] [@expl:lemma_span_div ensures] [%#sbuddy'4] ComputerDivision.mod (fs fl o k) (span ss 0)
                = 0)
              -> (let _ = lemma_span_div (fs fl o k) ss 0 o in [@stop_split] [@expl:lemma_ms_hi requires] ([@stop_split] [@expl:lemma_ms_hi requires #0] [%#sl2m'4] fal fl ss
                /\ ss > 0 /\ fv fl o k /\ 0 <= 0 /\ 0 <= o)
              /\ ([@stop_split] [@expl:lemma_ms_hi requires #1] [%#sl2m'5] t >= 0
                /\ ComputerDivision.mod t (span ss 0) = 0 /\ t <= t /\ t < t + span ss 0)
              /\ ([@stop_split] [@expl:lemma_ms_hi requires #2] [%#sl2m'6] fs fl o k <= t
              /\ t < fs fl o k + span ss o)))))
            else
              true
          
          else
            true
        
        else
          true
      )
    /\ (forall o: int, k: int. fv fl o k /\ fs fl o k <= t /\ t < fs fl o k + span ss o
        -> (let _ = lemma_span_mult ss 0 o in let _ = lemma_span_div (fs fl o k) ss 0 o in if lemma_ms_hi fl ss 0 t o k t then
          inblk fl ss 0 t
        else
          false
        ))
    && ([@stop_split] [@expl:lemma_allfree_blk ensures] [%#sl2m'3] inblk fl ss kk t)))
  else
    ([@stop_split] [@expl:lemma_span_succ requires] [%#sbuddy'5] 0 <= kk - 1)
    /\ (([@stop_split] [@expl:lemma_span_succ ensures] [%#sbuddy'6] span ss (kk - 1 + 1) = 2 * span ss (kk - 1))
    -> (let _ = lemma_span_succ ss (kk - 1) in ([@stop_split] [@expl:lemma_span_pos requires] [%#sbuddy] ss > 0
      /\ 0 <= kk - 1)
    /\ (([@stop_split] [@expl:lemma_span_pos ensures] ([@stop_split] [@expl:lemma_span_pos ensures #0] [%#sbuddy'0] span ss (kk
          - 1)
        >= ss)
      /\ ([@stop_split] [@expl:lemma_span_pos ensures #1] [%#sbuddy'1] span ss (kk - 1) > 0))
    -> (let _ = lemma_span_pos ss (kk
    - 1) in ([@stop_split] [@expl:lemma_span_div requires] ([@stop_split] [@expl:lemma_span_div requires #0] [%#sbuddy'2] ss
          > 0
        /\ 0 <= kk - 1 /\ kk - 1 <= kk /\ t >= 0)
      /\ ([@stop_split] [@expl:lemma_span_div requires #1] [%#sbuddy'3] ComputerDivision.mod t (span ss kk) = 0))
    /\ (([@stop_split] [@expl:lemma_span_div ensures] [%#sbuddy'4] ComputerDivision.mod t (span ss (kk - 1)) = 0)
    -> (let _ = lemma_span_div t ss (kk - 1) kk in ([@stop_split] [@expl:lemma_div_succ requires] [%#sl2m'8] span ss (kk
          - 1)
        > 0
      /\ t >= 0 /\ ComputerDivision.mod t (span ss (kk - 1)) = 0)
    /\ (([@stop_split] [@expl:lemma_div_succ ensures] ([@stop_split] [@expl:lemma_div_succ ensures #0] [%#sl2m'9] ComputerDivision.div (t
          + span ss (kk - 1)) (span ss (kk - 1))
        = ComputerDivision.div t (span ss (kk - 1)) + 1)
      /\ ([@stop_split] [@expl:lemma_div_succ ensures #1] [%#sl2m'10] ComputerDivision.mod (t
        + span ss (kk - 1)) (span ss (kk - 1))
      = 0))
    -> (let _ = lemma_div_succ t (span ss (kk
    - 1)) in (([@stop_split] [@expl:lemma_allfree_blk requires] ([@stop_split] [@expl:lemma_allfree_blk requires #0] [%#sl2m'0] coal fl ss
          /\ fal fl ss /\ ss > 0)
        /\ ([@stop_split] [@expl:lemma_allfree_blk requires #1] [%#sl2m'1] 0 <= kk - 1
          /\ kk - 1 < Seq.length fl /\ t >= 0 /\ ComputerDivision.mod t (span ss (kk - 1)) = 0)
        /\ ([@stop_split] [@expl:lemma_allfree_blk requires #2] [%#sl2m'2] forall z: int. t <= z
            /\ z < t + span ss (kk - 1) -> ffree fl ss z))
      /\ ([@expl:variant decreases] well_founded_relation_Int ([%#sl2m] kk) ([%#sl2m] kk - 1)))
    /\ (([@stop_split] [@expl:lemma_allfree_blk ensures] [%#sl2m'3] inblk fl ss (kk - 1) t)
    -> (let _ = lemma_allfree_blk fl ss (kk
    - 1) t in (([@stop_split] [@expl:lemma_allfree_blk requires] ([@stop_split] [@expl:lemma_allfree_blk requires #0] [%#sl2m'0] coal fl ss
          /\ fal fl ss /\ ss > 0)
        /\ ([@stop_split] [@expl:lemma_allfree_blk requires #1] [%#sl2m'1] 0 <= kk - 1
          /\ kk - 1 < Seq.length fl
          /\ t + span ss (kk - 1) >= 0 /\ ComputerDivision.mod (t + span ss (kk - 1)) (span ss (kk - 1)) = 0)
        /\ ([@stop_split] [@expl:lemma_allfree_blk requires #2] [%#sl2m'2] forall z: int. t + span ss (kk - 1) <= z
            /\ z < t + span ss (kk - 1) + span ss (kk - 1) -> ffree fl ss z))
      /\ ([@expl:variant decreases] well_founded_relation_Int ([%#sl2m] kk) ([%#sl2m] kk - 1)))
    /\ (([@stop_split] [@expl:lemma_allfree_blk ensures] [%#sl2m'3] inblk fl ss (kk - 1) (t + span ss (kk - 1)))
    -> (let _ = lemma_allfree_blk fl ss (kk - 1) (t
    + span ss (kk
    - 1)) in ([@stop_split] [@expl:lemma_merge_step requires] ([@stop_split] [@expl:lemma_merge_step requires #0] [%#sl2m'11] coal fl ss
        /\ fal fl ss /\ ss > 0)
      /\ ([@stop_split] [@expl:lemma_merge_step requires #1] [%#sl2m'12] 0 < kk
        /\ kk < Seq.length fl /\ t >= 0 /\ ComputerDivision.mod t (span ss kk) = 0)
      /\ ([@stop_split] [@expl:lemma_merge_step requires #2] [%#sl2m'13] inblk fl ss (kk - 1) t
      /\ inblk fl ss (kk - 1) (t + span ss (kk - 1))))
    /\ (([@stop_split] [@expl:lemma_merge_step ensures] [%#sl2m'14] inblk fl ss kk t)
    -> ([@stop_split] [@expl:lemma_allfree_blk ensures] [%#sl2m'3] inblk fl ss kk t))))))))))))))
  )
