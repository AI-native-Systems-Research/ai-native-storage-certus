  && ([@stop_split] [@expl:lemma_even_q requires] [%#sl2m'3] span ss (kk - 1) > 0
    /\ t >= 0 /\ ComputerDivision.mod t (2 * span ss (kk - 1)) = 0)
  /\ (([@stop_split] [@expl:lemma_even_q ensures] ([@stop_split] [@expl:lemma_even_q ensures #0] [%#sl2m'4] ComputerDivision.mod (ComputerDivision.div t (span ss (kk
        - 1))) 2
      = 0)
    /\ ([@stop_split] [@expl:lemma_even_q ensures #1] [%#sl2m'5] ComputerDivision.mod t (span ss (kk - 1)) = 0))
  -> (let _ = lemma_even_q t (span ss (kk - 1)) in (forall o: int, k: int. if fv fl o k then
        if o >= kk then
          if fs fl o k <= t then
            if t + span ss (kk - 1) <= fs fl o k + span ss o then
              [@stop_split] [@expl:lemma_ms_hi requires] ([@stop_split] [@expl:lemma_ms_hi requires #0] [%#sl2m'6] fal fl ss
                /\ ss > 0 /\ fv fl o k /\ 0 <= kk /\ kk <= o)
              /\ ([@stop_split] [@expl:lemma_ms_hi requires #1] [%#sl2m'7] t >= 0
                /\ ComputerDivision.mod t (span ss kk) = 0 /\ t <= t /\ t < t + span ss kk)
              /\ ([@stop_split] [@expl:lemma_ms_hi requires #2] [%#sl2m'8] fs fl o k <= t /\ t < fs fl o k + span ss o)
            else
              true
          
          else
            true
        
        else
          true
      
      else
        true
    )
  /\ (forall o: int, k: int. fv fl o k /\ o >= kk /\ fs fl o k <= t /\ t + span ss (kk - 1) <= fs fl o k + span ss o
      -> (if lemma_ms_hi fl ss kk t o k t then inblk fl ss kk t else false))
  && (forall o: int, k: int. if fv fl o k then
        if o >= kk then
          if fs fl o k <= t + span ss (kk - 1) then
            if t + span ss (kk - 1) + span ss (kk - 1) <= fs fl o k + span ss o then
