axiom lemma_inblk_intro_spec:
  forall fl: Seq.seq t_Vec_u64_Global, ss: int, kk: int, t: int, o: int, k: int [lemma_inblk_intro fl ss kk t o k]. ([%#sl2m'14] fv fl o k
