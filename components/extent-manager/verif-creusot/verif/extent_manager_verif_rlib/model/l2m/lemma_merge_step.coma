function lemma_merge_step [#"/home/cornel/fv-runs/extent-manager-2cd35bac/components/extent-manager/verif-creusot-l3/src/model/l2m.rs" 200 0 200 68] (fl: Seq.seq t_Vec_u64_Global) (ss: int) (kk: int) (t: int) : ()

goal vc_lemma_merge_step: ([%#sl2m] coal fl ss /\ fal fl ss /\ ss > 0)
  -> ([%#sl2m'0] 0 < kk /\ kk < Seq.length fl /\ t >= 0 /\ ComputerDivision.mod t (span ss kk) = 0)
  -> ([%#sl2m'1] inblk fl ss (kk - 1) t /\ inblk fl ss (kk - 1) (t + span ss (kk - 1)))
  -> ([@stop_split] [@expl:lemma_span_succ requires] [%#sbuddy] 0 <= kk - 1)
  /\ (([@stop_split] [@expl:lemma_span_succ ensures] [%#sbuddy'0] span ss (kk - 1 + 1) = 2 * span ss (kk - 1))
  -> (let _ = lemma_span_succ ss (kk - 1) in ([@stop_split] [@expl:lemma_span_pos requires] [%#sbuddy'1] ss > 0
    /\ 0 <= kk - 1)
  /\ (([@stop_split] [@expl:lemma_span_pos ensures] ([@stop_split] [@expl:lemma_span_pos ensures #0] [%#sbuddy'2] span ss (kk
        - 1)
      >= ss)
    /\ ([@stop_split] [@expl:lemma_span_pos ensures #1] [%#sbuddy'3] span ss (kk - 1) > 0))
  -> (let _ = lemma_span_pos ss (kk - 1) in ([@stop_split] [@expl:lemma_span_pos requires] [%#sbuddy'1] ss > 0
    /\ 0 <= kk)
  /\ (([@stop_split] [@expl:lemma_span_pos ensures] ([@stop_split] [@expl:lemma_span_pos ensures #0] [%#sbuddy'2] span ss kk
      >= ss)
    /\ ([@stop_split] [@expl:lemma_span_pos ensures #1] [%#sbuddy'3] span ss kk > 0))
