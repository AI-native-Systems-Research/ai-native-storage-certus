# Valgrind memcheck suppressions for the zyre bindings' test suite.
#
# SC-005 requires "zero errors related to the bindings". The C libraries the
# bindings link against (libzmq, czmq, libzyre) keep process-global state and
# run their own background I/O / beacon threads that are not fully torn down at
# process exit, so memcheck reports leaks and reachable blocks whose allocation
# stack lies entirely inside those libraries (and the pthread/dl runtime they
# use). Those are not defects in the Rust bindings.
#
# Each suppression below matches only when the allocating call stack passes
# through a C-library object. A leak or invalid access originating in the Rust
# binding (object file `zyre-*`, `integration-*`, or `node.rs`) does NOT match
# and is reported normally.

{
   zmq-internal-leaks
   Memcheck:Leak
   match-leak-kinds: definite,indirect,possible,reachable
   ...
   obj:*/libzmq.so*
}
{
   czmq-internal-leaks
   Memcheck:Leak
   match-leak-kinds: definite,indirect,possible,reachable
   ...
   obj:*/libczmq.so*
}
{
   zyre-c-internal-leaks
   Memcheck:Leak
   match-leak-kinds: definite,indirect,possible,reachable
   ...
   obj:*/libzyre.so*
}
{
   zmq-background-thread-stack
   Memcheck:Leak
   match-leak-kinds: definite,indirect,possible,reachable
   ...
   fun:start_thread
}
{
   dl-init-reachable
   Memcheck:Leak
   match-leak-kinds: reachable,possible
   ...
   fun:_dl_*
}
# czmq's zsys_set_thread_name_prefix_str calls strcpy(dst, src) with dst == src
# (a benign self-copy) during zsys_init; memcheck flags the overlap. This is a
# defect in czmq, not the bindings — reached only because zyre_new initializes
# the czmq subsystem.
{
   czmq-zsys-thread-name-strcpy-overlap
   Memcheck:Overlap
   fun:strcpy
   fun:zsys_set_thread_name_prefix_str
}
