      \/ Seq.get (view_Vec_tup2_u64_u32_Global m.final.e) j
      = Seq.get (view_Vec_tup2_u64_u32_Global m.current.e) (Seq.length (view_Vec_tup2_u64_u32_Global m.current.e) - 1))}
    (! return {result}) ]
