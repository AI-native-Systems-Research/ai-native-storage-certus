use creusot.prelude.MutBorrow
use creusot.int.UInt64
use seq.Seq
use creusot.int.UInt32
use creusot.int.UInt8
use creusot.prelude.Any
use int.Int

type t_LockTrace = { held: UInt64.t; peak: UInt64.t; acquires: UInt64.t; writes': UInt64.t; reads': UInt64.t }

let state_write_lock (t: MutBorrow.t t_LockTrace) (return (x: ())) =
{[@stop_split] [@expl:state_write_lock requires] [%#slib'30] UInt64.t'int t.current.writes' < 4294967294}
  any
  [ return (result: ()) ->
  {[@stop_split] [@expl:state_write_lock ensures] ([@stop_split] [@expl:state_write_lock ensures #0] [%#slib'31] UInt64.t'int t.final.writes'
      = UInt64.t'int t.current.writes' + 1)
    /\ ([@stop_split] [@expl:state_write_lock ensures #1] [%#slib'32] t.final.reads' = t.current.reads'
      /\ t.final.held = t.current.held /\ t.final.peak = t.current.peak)
    /\ ([@stop_split] [@expl:state_write_lock ensures #2] [%#slib'33] t.final.acquires = t.current.acquires)}
    (! return {result}) ]

predicate resolve_refmut_LockTrace [@inline:trivial] (_1: MutBorrow.t t_LockTrace) = _1.final = _1.current

meta "rewrite_def" predicate resolve_refmut_LockTrace

type t_Vec_Pool_Global

type t_Pools = { pools: t_Vec_Pool_Global; announced: bool }

type t_Vec_Node_Global

type t_Vec_u32_Global

type t_Vec_tup2_u64_u32_Global

type t_Map = { e: t_Vec_tup2_u64_u32_Global }

type t_Leaves = { e'0: t_Vec_tup2_u64_u32_Global }

type t_Pool = {
  nodes: t_Vec_Node_Global;
  free: t_Vec_u32_Global;
  by_key: t_Map;
  sessions: t_Map;
  leaves: t_Leaves;
  clock: UInt64.t;
  len: UInt64.t }

constant const_MAX: UInt64.t = (18446744073709551615: UInt64.t)

function view_Vec_Pool_Global (self: t_Vec_Pool_Global) : Seq.seq t_Pool

axiom view_Vec_Pool_Global_spec:
  forall self: t_Vec_Pool_Global [view_Vec_Pool_Global self]. [%#svec'1] Seq.length (view_Vec_Pool_Global self)
    <= UInt64.t'int const_MAX

let len_Pool (self_: t_Vec_Pool_Global) (return (x: UInt64.t)) = any
  [ return (result: UInt64.t) -> {[@stop_split] [@expl:len ensures] [%#svec] UInt64.t'int result
    = Seq.length (view_Vec_Pool_Global self_)}
    (! return {result}) ]

type t_Option_u32 = None | Some UInt32.t

type t_Node = {
  key: UInt64.t;
  session: UInt64.t;
  parent: t_Option_u32;
  child: t_Option_u32;
  stamp: UInt64.t;
  birth: UInt64.t;
  active: bool }

function view_Vec_Node_Global (self: t_Vec_Node_Global) : Seq.seq t_Node

axiom view_Vec_Node_Global_spec:
  forall self: t_Vec_Node_Global [view_Vec_Node_Global self]. [%#svec'1] Seq.length (view_Vec_Node_Global self)
    <= UInt64.t'int const_MAX

function view_Vec_u32_Global (self: t_Vec_u32_Global) : Seq.seq UInt32.t

axiom view_Vec_u32_Global_spec:
  forall self: t_Vec_u32_Global [view_Vec_u32_Global self]. [%#svec'1] Seq.length (view_Vec_u32_Global self)
    <= UInt64.t'int const_MAX

type tup2_u64_u32 = { f0: UInt64.t; f1: UInt32.t }

function view_Vec_tup2_u64_u32_Global (self: t_Vec_tup2_u64_u32_Global) : Seq.seq tup2_u64_u32

axiom view_Vec_tup2_u64_u32_Global_spec:
  forall self: t_Vec_tup2_u64_u32_Global [view_Vec_tup2_u64_u32_Global self]. [%#svec'1] Seq.length (view_Vec_tup2_u64_u32_Global self)
    <= UInt64.t'int const_MAX

