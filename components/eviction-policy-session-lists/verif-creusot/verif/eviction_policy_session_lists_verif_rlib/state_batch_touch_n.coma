    /\ ([@stop_split] [@expl:lock_acquire ensures #1] [%#slib'44] UInt64.t'int t.final.peak
      >= UInt64.t'int t.current.held + 1)
    /\ ([@stop_split] [@expl:lock_acquire ensures #2] [%#slib'45] UInt64.t'int t.current.peak
        >= UInt64.t'int t.current.held + 1 -> t.final.peak = t.current.peak)
    /\ ([@stop_split] [@expl:lock_acquire ensures #3] [%#slib'46] UInt64.t'int t.current.peak
