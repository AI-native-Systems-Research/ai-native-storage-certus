      = UInt64.t'int t.current.acquires + 1)
    /\ ([@stop_split] [@expl:lock_acquire ensures #5] [%#slib'48] t.final.writes' = t.current.writes'
    /\ t.final.reads' = t.current.reads')}
    (! return {result}) ]

