axiom view_Vec_Pool_Global_spec:
  forall self: t_Vec_Pool_Global [view_Vec_Pool_Global self]. [%#svec] Seq.length (view_Vec_Pool_Global self)
    <= UInt64.t'int const_MAX

let state_len (s: t_Pools) (pool: UInt32.t) (t: MutBorrow.t t_LockTrace) (return (x: UInt64.t)) =
{[@stop_split] [@expl:state_len requires] [%#slib'3] UInt64.t'int t.current.reads' < 4294967294}
  any
  [ return (result: UInt64.t) ->
  {[@stop_split] [@expl:state_len ensures] ([@stop_split] [@expl:state_len ensures #0] [%#slib'4] UInt32.t'int pool
        >= Seq.length (view_Vec_Pool_Global s.pools) -> UInt64.t'int result = 0)
    /\ ([@stop_split] [@expl:state_len ensures #1] [%#slib'5] UInt32.t'int pool
        < Seq.length (view_Vec_Pool_Global s.pools)
      -> result = (Seq.get (view_Vec_Pool_Global s.pools) (UInt32.t'int pool)).len)
    /\ ([@stop_split] [@expl:state_len ensures #2] [%#slib'6] UInt64.t'int t.final.reads'
        = UInt64.t'int t.current.reads' + 1
      /\ t.final.writes' = t.current.writes')
    /\ ([@stop_split] [@expl:state_len ensures #3] [%#slib'7] t.final.held = t.current.held
    /\ t.final.peak = t.current.peak /\ t.final.acquires = t.current.acquires)}
    (! return {result}) ]

predicate resolve_refmut_LockTrace [@inline:trivial] (_1: MutBorrow.t t_LockTrace) = _1.final = _1.current

meta "rewrite_def" predicate resolve_refmut_LockTrace

