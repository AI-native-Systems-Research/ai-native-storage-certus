use creusot.int.UInt64
use creusot.int.UInt32
use seq.Seq
use creusot.prelude.MutBorrow
use creusot.prelude.Any
use int.Int

type t_Vec_Node_Global

type t_Vec_u32_Global

type t_Vec_tup2_u64_u32_Global

type t_Map = { e: t_Vec_tup2_u64_u32_Global }

type t_Leaves = { e'0: t_Vec_tup2_u64_u32_Global }

type t_Pool = {
  nodes: t_Vec_Node_Global;
  free: t_Vec_u32_Global;
  by_key: t_Map;
  sessions: t_Map;
  leaves: t_Leaves;
  clock: UInt64.t;
  len: UInt64.t }

type t_Option_u32 = None | Some UInt32.t

type tup2_u64_u32 = { f0: UInt64.t; f1: UInt32.t }

predicate map_distinct [#"/home/cornel/cv-eviction-policy-session-lists-20260927/components/eviction-policy-session-lists/verif-creusot/src/lib.rs" 134 0 134 47] (m: Seq.seq tup2_u64_u32) =
  [%#slib'210] forall i: int, j: int. 0 <= i /\ i < j /\ j < Seq.length m -> (Seq.get m i).f0 <> (Seq.get m j).f0

constant const_MAX: UInt64.t = (18446744073709551615: UInt64.t)

function view_Vec_tup2_u64_u32_Global (self: t_Vec_tup2_u64_u32_Global) : Seq.seq tup2_u64_u32

axiom view_Vec_tup2_u64_u32_Global_spec:
  forall self: t_Vec_tup2_u64_u32_Global [view_Vec_tup2_u64_u32_Global self]. [%#svec'6] Seq.length (view_Vec_tup2_u64_u32_Global self)
    <= UInt64.t'int const_MAX

predicate map_has [#"/home/cornel/cv-eviction-policy-session-lists-20260927/components/eviction-policy-session-lists/verif-creusot/src/lib.rs" 146 0 146 58] (m: Seq.seq tup2_u64_u32) (k: UInt64.t) (v: UInt32.t) =
  [%#slib'193] exists i: int. 0 <= i /\ i < Seq.length m /\ (Seq.get m i).f0 = k /\ (Seq.get m i).f1 = v

predicate map_mem [#"/home/cornel/cv-eviction-policy-session-lists-20260927/components/eviction-policy-session-lists/verif-creusot/src/lib.rs" 140 0 140 50] (m: Seq.seq tup2_u64_u32) (k: UInt64.t) =
  [%#slib'194] exists i: int. 0 <= i /\ i < Seq.length m /\ (Seq.get m i).f0 = k

let map_get (m: t_Map) (k: UInt64.t) (return (x: t_Option_u32)) =
{[@stop_split] [@expl:map_get requires] [%#slib'65] map_distinct (view_Vec_tup2_u64_u32_Global m.e)}
  any
  [ return (result: t_Option_u32) -> {[@stop_split] [@expl:map_get ensures] [%#slib'66] match result with
      | Some v -> map_has (view_Vec_tup2_u64_u32_Global m.e) k v
      | None -> not map_mem (view_Vec_tup2_u64_u32_Global m.e) k
      end}
    (! return {result}) ]

let elim_Some (_x: t_Option_u32) (return (f0'0: UInt32.t)) = any
  [ _k (f0'0: UInt32.t) -> {Some f0'0 = _x} (! return {f0'0})
  | _chk -> (! {[@expl:elim Some] match _x with
      | Some _ -> true
      | _ -> false
      end}
    any) ]

type t_Node = {
  key: UInt64.t;
  session: UInt64.t;
  parent: t_Option_u32;
  child: t_Option_u32;
  stamp: UInt64.t;
  birth: UInt64.t;
  active: bool }

function view_Vec_Node_Global (self: t_Vec_Node_Global) : Seq.seq t_Node

axiom view_Vec_Node_Global_spec:
  forall self: t_Vec_Node_Global [view_Vec_Node_Global self]. [%#svec'6] Seq.length (view_Vec_Node_Global self)
    <= UInt64.t'int const_MAX

function view_Vec_u32_Global (self: t_Vec_u32_Global) : Seq.seq UInt32.t

axiom view_Vec_u32_Global_spec:
  forall self: t_Vec_u32_Global [view_Vec_u32_Global self]. [%#svec'6] Seq.length (view_Vec_u32_Global self)
