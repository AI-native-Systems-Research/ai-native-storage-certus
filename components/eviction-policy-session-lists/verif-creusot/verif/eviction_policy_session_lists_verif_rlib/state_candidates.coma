let index_Vec_Pool_Global (self_: t_Vec_Pool_Global) (ix: UInt64.t) (return (x: t_Pool)) =
{[@stop_split] [@expl:index requires] [%#svec'1] in_bounds_usize ix (view_Vec_Pool_Global self_)}
