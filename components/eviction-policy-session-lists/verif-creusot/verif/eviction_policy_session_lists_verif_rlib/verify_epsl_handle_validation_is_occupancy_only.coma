  forall self: t_Vec_Node_Global [view_Vec_Node_Global self]. [%#svec] Seq.length (view_Vec_Node_Global self)
    <= UInt64.t'int const_MAX

let pool_is_active (p: t_Pool) (index: UInt32.t) (return (x: bool)) = any
  [ return (result: bool) -> {[@stop_split] [@expl:pool_is_active ensures] [%#slib'4] result
    = (UInt32.t'int index < Seq.length (view_Vec_Node_Global p.nodes)
    /\ (Seq.get (view_Vec_Node_Global p.nodes) (UInt32.t'int index)).active)}
    (! return {result}) ]

function view_Vec_u32_Global (self: t_Vec_u32_Global) : Seq.seq UInt32.t

axiom view_Vec_u32_Global_spec:
  forall self: t_Vec_u32_Global [view_Vec_u32_Global self]. [%#svec] Seq.length (view_Vec_u32_Global self)
