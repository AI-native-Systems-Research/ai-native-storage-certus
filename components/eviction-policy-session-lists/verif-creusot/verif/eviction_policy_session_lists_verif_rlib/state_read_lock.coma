  {[@stop_split] [@expl:state_read_lock ensures] ([@stop_split] [@expl:state_read_lock ensures #0] [%#slib'2] UInt64.t'int t.final.reads'
      = UInt64.t'int t.current.reads' + 1)
    /\ ([@stop_split] [@expl:state_read_lock ensures #1] [%#slib'3] t.final.writes' = t.current.writes'
      /\ t.final.held = t.current.held /\ t.final.peak = t.current.peak)
    /\ ([@stop_split] [@expl:state_read_lock ensures #2] [%#slib'4] t.final.acquires = t.current.acquires)}
    (! return {result}) ]
