type t_LockTrace = { held: UInt64.t; peak: UInt64.t; acquires: UInt64.t; writes': UInt64.t; reads': UInt64.t }

predicate resolve_refmut_LockTrace [@inline:trivial] (_1: MutBorrow.t t_LockTrace) = _1.final = _1.current

meta "rewrite_def" predicate resolve_refmut_LockTrace

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let state_read_lock [#"/home/cornel/fv-runs/j12-session-lists/components/eviction-policy-session-lists/verif-creusot/src/lib.rs" 1544 0 1544 41]
  (t: MutBorrow.t t_LockTrace) (return (x: ())) =
{[@stop_split] [@expl:state_read_lock requires] [%#slib'1] UInt64.t'int t.current.reads' < 4294967294}
  (! bb0
  [ bb0 = s0
    [ s0 = UInt64.add [%#slib'0] {t.current.reads'} {[%#slib] (1: UInt64.t)}
