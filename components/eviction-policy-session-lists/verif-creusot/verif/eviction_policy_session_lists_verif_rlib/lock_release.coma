      = UInt64.t'int t.current.held - 1)
    /\ ([@stop_split] [@expl:lock_release ensures #1] [%#slib'3] t.final.peak = t.current.peak)
    /\ ([@stop_split] [@expl:lock_release ensures #2] [%#slib'4] t.final.acquires = t.current.acquires)
    /\ ([@stop_split] [@expl:lock_release ensures #3] [%#slib'5] t.final.writes' = t.current.writes'
    /\ t.final.reads' = t.current.reads')}
    (! return {result}) ]
