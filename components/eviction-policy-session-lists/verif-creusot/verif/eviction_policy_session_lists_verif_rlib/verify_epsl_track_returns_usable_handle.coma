let elim_Err (_x: t_Result_Handle_PolicyError) (return (f0'0: t_PolicyError)) = any
  [ _k (f0'0: t_PolicyError) -> {Err f0'0 = _x} (! return {f0'0})
  | _chk -> (! {[@expl:elim Err] match _x with
      | Err _ -> true
      | _ -> false
      end}
    any) ]

type t_Result_unit_PolicyError = Ok'0 () | Err'0 t_PolicyError

type tup3_Result_Handle_PolicyError_Result_unit_PolicyError_Result_unit_PolicyError = {
  f0'0: t_Result_Handle_PolicyError;
  f1'0: t_Result_unit_PolicyError;
  f2'0: t_Result_unit_PolicyError }

let elim_Ok (_x: t_Result_Handle_PolicyError) (return (f0'1: t_Handle)) = any
  [ _k (f0'1: t_Handle) -> {Ok f0'1 = _x} (! return {f0'1})
  | _chk -> (! {[@expl:elim Ok] match _x with
      | Ok _ -> true
      | _ -> false
      end}
    any) ]

