let state_track (s: MutBorrow.t t_Pools) (pool'0: UInt32.t) (key'0: UInt64.t) (session'0: UInt64.t)
  (log: MutBorrow.t t_Log) (connected: bool) (t: MutBorrow.t t_LockTrace) (return (x: t_Result_Handle_PolicyError)) =
{[@stop_split] [@expl:state_track requires] ([@stop_split] [@expl:state_track requires #0] [%#slib'8] pools_inv s.current)
  /\ ([@stop_split] [@expl:state_track requires #1] [%#slib'9] pools_have_room s.current)
  /\ ([@stop_split] [@expl:state_track requires #2] [%#slib'10] UInt64.t'int log.current.info < 4294967294
    /\ UInt64.t'int log.current.debug < 4294967294 /\ UInt64.t'int log.current.warn < 4294967294)
  /\ ([@stop_split] [@expl:state_track requires #3] [%#slib'11] UInt64.t'int t.current.reads' < 4294967294)}
  any
  [ return (result: t_Result_Handle_PolicyError) ->
  {[@stop_split] [@expl:state_track ensures] ([@stop_split] [@expl:state_track ensures #0] [%#slib'12] UInt32.t'int pool'0
        >= Seq.length (view_Vec_Pool_Global s.current.pools)
      -> result = Err (InvalidPool pool'0)
      /\ view_Vec_Pool_Global s.final.pools = view_Vec_Pool_Global s.current.pools
      /\ s.final.announced = s.current.announced)
    /\ ([@stop_split] [@expl:state_track ensures #1] [%#slib'13] UInt32.t'int pool'0
        < Seq.length (view_Vec_Pool_Global s.current.pools)
      -> Seq.length (view_Vec_Pool_Global s.final.pools) = Seq.length (view_Vec_Pool_Global s.current.pools)
      /\ match result with
        | Ok h -> h.pool = pool'0
        /\ UInt32.t'int h.index
          < Seq.length (view_Vec_Node_Global (Seq.get (view_Vec_Pool_Global s.final.pools) (UInt32.t'int pool'0)).nodes)
        /\ (Seq.get (view_Vec_Node_Global (Seq.get (view_Vec_Pool_Global s.final.pools) (UInt32.t'int pool'0)).nodes) (UInt32.t'int h.index)).active
        /\ (Seq.get (view_Vec_Node_Global (Seq.get (view_Vec_Pool_Global s.final.pools) (UInt32.t'int pool'0)).nodes) (UInt32.t'int h.index)).key
        = key'0
        | Err _ -> false
        end)
    /\ ([@stop_split] [@expl:state_track ensures #2] [%#slib'14] forall j: int. 0 <= j
          /\ j < Seq.length (view_Vec_Pool_Global s.current.pools) /\ j <> UInt32.t'int pool'0
        -> Seq.get (view_Vec_Pool_Global s.final.pools) j = Seq.get (view_Vec_Pool_Global s.current.pools) j)
    /\ ([@stop_split] [@expl:state_track ensures #3] [%#slib'15] pools_inv s.final)
    /\ ([@stop_split] [@expl:state_track ensures #4] [%#slib'16] s.final.announced = s.current.announced)
    /\ ([@stop_split] [@expl:state_track ensures #5] [%#slib'17] UInt64.t'int t.final.reads'
      = UInt64.t'int t.current.reads' + 1)
    /\ ([@stop_split] [@expl:state_track ensures #6] [%#slib'18] t.final.writes' = t.current.writes')
    /\ ([@stop_split] [@expl:state_track ensures #7] [%#slib'19] log.final.info = log.current.info
      /\ log.final.debug = log.current.debug)
    /\ ([@stop_split] [@expl:state_track ensures #8] [%#slib'20] forall i: int. 0 <= i
          /\ i < Seq.length (view_Vec_Pool_Global s.current.pools)
        -> UInt64.t'int (Seq.get (view_Vec_Pool_Global s.final.pools) i).clock
          <= UInt64.t'int (Seq.get (view_Vec_Pool_Global s.current.pools) i).clock + 1
        /\ Seq.length (view_Vec_Node_Global (Seq.get (view_Vec_Pool_Global s.final.pools) i).nodes)
        <= Seq.length (view_Vec_Node_Global (Seq.get (view_Vec_Pool_Global s.current.pools) i).nodes) + 1)
    /\ ([@stop_split] [@expl:state_track ensures #9] [%#slib'21] t.final.held = t.current.held
      /\ t.final.peak = t.current.peak /\ t.final.acquires = t.current.acquires)
