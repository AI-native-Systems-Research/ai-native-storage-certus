    /\ ([@stop_split] [@expl:log_site ensures #5] [%#slib'32] UInt8.t'int kind <> 1
      -> log.final.debug = log.current.debug)
    /\ ([@stop_split] [@expl:log_site ensures #6] [%#slib'33] UInt8.t'int kind <> 2
    -> log.final.warn = log.current.warn)}
