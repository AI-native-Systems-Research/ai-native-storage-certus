let pool_candidates (p: t_Pool) (n: UInt64.t) (return (x: t_Vec_u64_Global)) =
{[@stop_split] [@expl:pool_candidates requires] [%#slib'5] idx_ok p}
  any
  [ return (result: t_Vec_u64_Global) ->
  {[@stop_split] [@expl:pool_candidates ensures] ([@stop_split] [@expl:pool_candidates ensures #0] [%#slib'6] Seq.length (view_Vec_u64_Global result)
      <= UInt64.t'int n)
    /\ ([@stop_split] [@expl:pool_candidates ensures #1] [%#slib'7] Seq.length (view_Vec_u64_Global result)
      <= Seq.length (view_Vec_tup2_u64_u32_Global p.leaves.e'0))
    /\ ([@stop_split] [@expl:pool_candidates ensures #2] [%#slib'8] UInt64.t'int n
        <= Seq.length (view_Vec_tup2_u64_u32_Global p.leaves.e'0)
      -> Seq.length (view_Vec_u64_Global result) = UInt64.t'int n)
    /\ ([@stop_split] [@expl:pool_candidates ensures #3] [%#slib'9] Seq.length (view_Vec_tup2_u64_u32_Global p.leaves.e'0)
        <= UInt64.t'int n
      -> Seq.length (view_Vec_u64_Global result) = Seq.length (view_Vec_tup2_u64_u32_Global p.leaves.e'0))
    /\ ([@stop_split] [@expl:pool_candidates ensures #4] [%#slib'10] forall j: int. 0 <= j
        /\ j < Seq.length (view_Vec_u64_Global result)
      -> Seq.get (view_Vec_u64_Global result) j
      = (Seq.get (view_Vec_Node_Global p.nodes) (UInt32.t'int (Seq.get (view_Vec_tup2_u64_u32_Global p.leaves.e'0) j).f1)).key)}
    (! return {result}) ]

