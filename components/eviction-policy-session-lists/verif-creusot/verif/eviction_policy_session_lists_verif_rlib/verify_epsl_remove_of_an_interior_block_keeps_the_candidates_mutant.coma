  [%#slib'55] Seq.length (view_Vec_Node_Global p.nodes) <= 4294967296
  /\ (forall i: int. 0 <= i /\ i < Seq.length (view_Vec_Node_Global p.nodes)
      -> match (Seq.get (view_Vec_Node_Global p.nodes) i).parent with
        | Some x -> UInt32.t'int x < Seq.length (view_Vec_Node_Global p.nodes)
        | None -> true
        end)
  /\ (forall i: int. 0 <= i /\ i < Seq.length (view_Vec_Node_Global p.nodes)
      -> match (Seq.get (view_Vec_Node_Global p.nodes) i).child with
        | Some x -> UInt32.t'int x < Seq.length (view_Vec_Node_Global p.nodes)
        | None -> true
        end)
  /\ (forall k: int. 0 <= k /\ k < Seq.length (view_Vec_u32_Global p.free)
      -> UInt32.t'int (Seq.get (view_Vec_u32_Global p.free) k) < Seq.length (view_Vec_Node_Global p.nodes))
  /\ (forall k: int. 0 <= k /\ k < Seq.length (view_Vec_tup2_u64_u32_Global p.leaves.e'0)
      -> UInt32.t'int (Seq.get (view_Vec_tup2_u64_u32_Global p.leaves.e'0) k).f1
      < Seq.length (view_Vec_Node_Global p.nodes))
  /\ (forall k: int. 0 <= k /\ k < Seq.length (view_Vec_tup2_u64_u32_Global p.by_key.e)
      -> UInt32.t'int (Seq.get (view_Vec_tup2_u64_u32_Global p.by_key.e) k).f1
      < Seq.length (view_Vec_Node_Global p.nodes))
  /\ (forall k: int. 0 <= k /\ k < Seq.length (view_Vec_tup2_u64_u32_Global p.sessions.e)
    -> UInt32.t'int (Seq.get (view_Vec_tup2_u64_u32_Global p.sessions.e) k).f1
    < Seq.length (view_Vec_Node_Global p.nodes))

predicate size_exact [#"/home/cornel/fv-runs/apply-eviction-policy-session-lists-20261007/components/eviction-policy-session-lists/verif-creusot/src/lib.rs" 470 0 470 35] (p: t_Pool) =
  [%#slib'56] Seq.length (view_Vec_Node_Global p.nodes) = UInt64.t'int p.len + Seq.length (view_Vec_u32_Global p.free)

predicate free_all_inactive [#"/home/cornel/fv-runs/apply-eviction-policy-session-lists-20261007/components/eviction-policy-session-lists/verif-creusot/src/lib.rs" 615 0 615 42] (p: t_Pool) =
