  forall self: t_Vec_Node_Global [view_Vec_Node_Global self]. [%#svec'2] Seq.length (view_Vec_Node_Global self)
    <= UInt64.t'int const_MAX

let len_Node (self_: t_Vec_Node_Global) (return (x: UInt64.t)) = any
