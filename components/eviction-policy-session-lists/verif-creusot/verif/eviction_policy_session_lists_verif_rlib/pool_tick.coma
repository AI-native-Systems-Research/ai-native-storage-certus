    | s3 = return {_ret} ] ] [ & _ret: UInt64.t = Any.any_l () | & p: MutBorrow.t t_Pool = p ])
  [ return (result: UInt64.t) ->
  {[@stop_split] [@expl:pool_tick ensures] ([@stop_split] [@expl:pool_tick ensures #0] [%#slib'2] UInt64.t'int p.final.clock
      = UInt64.t'int p.current.clock + 1)
    /\ ([@stop_split] [@expl:pool_tick ensures #1] [%#slib'3] result = p.final.clock)
    /\ ([@stop_split] [@expl:pool_tick ensures #2] [%#slib'4] UInt64.t'int result > UInt64.t'int p.current.clock)
    /\ ([@stop_split] [@expl:pool_tick ensures #3] [%#slib'5] view_Vec_Node_Global p.final.nodes
      = view_Vec_Node_Global p.current.nodes)
    /\ ([@stop_split] [@expl:pool_tick ensures #4] [%#slib'6] view_Vec_u32_Global p.final.free
      = view_Vec_u32_Global p.current.free)
    /\ ([@stop_split] [@expl:pool_tick ensures #5] [%#slib'7] view_Vec_tup2_u64_u32_Global p.final.by_key.e
      = view_Vec_tup2_u64_u32_Global p.current.by_key.e)
    /\ ([@stop_split] [@expl:pool_tick ensures #6] [%#slib'8] view_Vec_tup2_u64_u32_Global p.final.sessions.e
