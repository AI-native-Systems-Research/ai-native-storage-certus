    /\ ([@stop_split] [@expl:pool_tick ensures #7] [%#slib'9] view_Vec_tup2_u64_u32_Global p.final.leaves.e'0
      = view_Vec_tup2_u64_u32_Global p.current.leaves.e'0)
    /\ ([@stop_split] [@expl:pool_tick ensures #8] [%#slib'10] p.final.len = p.current.len)}
