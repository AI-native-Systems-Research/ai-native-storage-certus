    /\ ([@stop_split] [@expl:state_track ensures #4] [%#slib'19] s.final.announced = s.current.announced)
    /\ ([@stop_split] [@expl:state_track ensures #5] [%#slib'20] UInt64.t'int t.final.reads'
      = UInt64.t'int t.current.reads' + 1)
    /\ ([@stop_split] [@expl:state_track ensures #6] [%#slib'21] t.final.writes' = t.current.writes')
    /\ ([@stop_split] [@expl:state_track ensures #7] [%#slib'22] log.final.info = log.current.info
    /\ log.final.debug = log.current.debug)}
    (! return {result}) ]

