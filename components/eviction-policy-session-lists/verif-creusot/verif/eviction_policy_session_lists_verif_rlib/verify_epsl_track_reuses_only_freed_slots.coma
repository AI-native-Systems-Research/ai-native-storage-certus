  by_key: t_Map;
  sessions: t_Map;
  leaves: t_Leaves;
  clock: UInt64.t;
  len: UInt64.t }

type t_Option_u32 = None | Some UInt32.t

type t_Node = {
  key: UInt64.t;
  session: UInt64.t;
  parent: t_Option_u32;
  child: t_Option_u32;
  stamp: UInt64.t;
  birth: UInt64.t;
  active: bool }

constant const_MAX: UInt64.t = (18446744073709551615: UInt64.t)

function view_Vec_Node_Global (self: t_Vec_Node_Global) : Seq.seq t_Node

axiom view_Vec_Node_Global_spec:
  forall self: t_Vec_Node_Global [view_Vec_Node_Global self]. [%#svec] Seq.length (view_Vec_Node_Global self)
    <= UInt64.t'int const_MAX

function view_Vec_u32_Global (self: t_Vec_u32_Global) : Seq.seq UInt32.t

axiom view_Vec_u32_Global_spec:
  forall self: t_Vec_u32_Global [view_Vec_u32_Global self]. [%#svec] Seq.length (view_Vec_u32_Global self)
    <= UInt64.t'int const_MAX

type tup2_u64_u32 = { f0: UInt64.t; f1: UInt32.t }

