  /\ ([@stop_split] [@expl:state_track requires #3] [%#slib'13] UInt64.t'int t.current.reads' < 4294967294)}
  any
  [ return (result: t_Result_Handle_PolicyError) ->
  {[@stop_split] [@expl:state_track ensures] ([@stop_split] [@expl:state_track ensures #0] [%#slib'14] UInt32.t'int pool'0
        >= Seq.length (view_Vec_Pool_Global s.current.pools)
