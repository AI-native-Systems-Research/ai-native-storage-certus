type t_LockTrace = { held: UInt64.t; peak: UInt64.t; acquires: UInt64.t; writes': UInt64.t; reads': UInt64.t }

let state_read_lock (t: MutBorrow.t t_LockTrace) (return (x: ())) =
{[@stop_split] [@expl:state_read_lock requires] [%#slib'14] UInt64.t'int t.current.reads' < 4294967294}
  any
  [ return (result: ()) ->
  {[@stop_split] [@expl:state_read_lock ensures] ([@stop_split] [@expl:state_read_lock ensures #0] [%#slib'15] UInt64.t'int t.final.reads'
      = UInt64.t'int t.current.reads' + 1)
    /\ ([@stop_split] [@expl:state_read_lock ensures #1] [%#slib'16] t.final.writes' = t.current.writes'
      /\ t.final.held = t.current.held /\ t.final.peak = t.current.peak)
    /\ ([@stop_split] [@expl:state_read_lock ensures #2] [%#slib'17] t.final.acquires = t.current.acquires)}
    (! return {result}) ]

predicate resolve_refmut_LockTrace [@inline:trivial] (_1: MutBorrow.t t_LockTrace) = _1.final = _1.current

meta "rewrite_def" predicate resolve_refmut_LockTrace

type t_Vec_Pool_Global

type t_Pools = { pools: t_Vec_Pool_Global; announced: bool }

type t_Vec_Node_Global

type t_Vec_u32_Global

type t_Vec_tup2_u64_u32_Global

type t_Map = { e: t_Vec_tup2_u64_u32_Global }

type t_Leaves = { e'0: t_Vec_tup2_u64_u32_Global }

type t_Pool = {
  nodes: t_Vec_Node_Global;
  free: t_Vec_u32_Global;
  by_key: t_Map;
  sessions: t_Map;
  leaves: t_Leaves;
  clock: UInt64.t;
  len: UInt64.t }

constant const_MAX: UInt64.t = (18446744073709551615: UInt64.t)

function view_Vec_Pool_Global (self: t_Vec_Pool_Global) : Seq.seq t_Pool

axiom view_Vec_Pool_Global_spec:
  forall self: t_Vec_Pool_Global [view_Vec_Pool_Global self]. [%#svec'5] Seq.length (view_Vec_Pool_Global self)
    <= UInt64.t'int const_MAX

let len_Pool (self_: t_Vec_Pool_Global) (return (x: UInt64.t)) = any
  [ return (result: UInt64.t) -> {[@stop_split] [@expl:len ensures] [%#svec] UInt64.t'int result
    = Seq.length (view_Vec_Pool_Global self_)}
    (! return {result}) ]

predicate in_bounds_usize [@inline:trivial] (self: UInt64.t) (seq: Seq.seq t_Pool) =
  [%#sslice] UInt64.t'int self < Seq.length seq

meta "rewrite_def" predicate in_bounds_usize

predicate has_value_usize [@inline:trivial] (self: UInt64.t) (seq: Seq.seq t_Pool) (out: t_Pool) =
  [%#sslice'0] Seq.get seq (UInt64.t'int self) = out

meta "rewrite_def" predicate has_value_usize

predicate resolve_elswhere_usize [@inline:trivial] (self: UInt64.t) (old': Seq.seq t_Pool) (fin: Seq.seq t_Pool) =
  [%#sslice'1] forall i: int. 0 <= i /\ i <> UInt64.t'int self /\ i < Seq.length old' -> Seq.get old' i = Seq.get fin i

meta "rewrite_def" predicate resolve_elswhere_usize

let index_mut_Vec_Pool_Global (self_: MutBorrow.t t_Vec_Pool_Global) (ix: UInt64.t) (return (x: MutBorrow.t t_Pool)) =
{[@stop_split] [@expl:index_mut requires] [%#svec'0] in_bounds_usize ix (view_Vec_Pool_Global self_.current)}
  any
  [ return (result: MutBorrow.t t_Pool) ->
  {[@stop_split] [@expl:index_mut_Vec_Pool_Global ensures] ([@stop_split] [@expl:index_mut ensures #0] [%#svec'1] has_value_usize ix (view_Vec_Pool_Global self_.current) result.current)
    /\ ([@stop_split] [@expl:index_mut ensures #1] [%#svec'2] has_value_usize ix (view_Vec_Pool_Global self_.final) result.final)
    /\ ([@stop_split] [@expl:index_mut ensures #2] [%#svec'3] resolve_elswhere_usize ix (view_Vec_Pool_Global self_.current) (view_Vec_Pool_Global self_.final))
    /\ ([@stop_split] [@expl:index_mut ensures #3] [%#svec'4] Seq.length (view_Vec_Pool_Global self_.final)
    = Seq.length (view_Vec_Pool_Global self_.current))}
    (! return {result}) ]

type t_Option_u32 = None | Some UInt32.t

type t_Node = {
  key: UInt64.t;
  session: UInt64.t;
  parent: t_Option_u32;
  child: t_Option_u32;
  stamp: UInt64.t;
  birth: UInt64.t;
