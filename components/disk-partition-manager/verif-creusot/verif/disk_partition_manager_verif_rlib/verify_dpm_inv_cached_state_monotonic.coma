type t_Vec_PInfoM_Global

type t_PInfoM = { index: UInt32.t; start_lba: UInt64.t; num_sectors: UInt64.t }

type t_PiOutcome = Ok'1 t_PInfoM | Err'1 t_PtErr | Panic'1

constant const_MAX: UInt64.t = (18446744073709551615: UInt64.t)

function view_Vec_PInfoM_Global (self: t_Vec_PInfoM_Global) : Seq.seq t_PInfoM

axiom view_Vec_PInfoM_Global_spec:
  forall self: t_Vec_PInfoM_Global [view_Vec_PInfoM_Global self]. [%#svec] Seq.length (view_Vec_PInfoM_Global self)
    <= UInt64.t'int const_MAX

let partition_info_m (loaded: bool) (parts: t_Vec_PInfoM_Global) (poisoned: bool) (idx: UInt32.t)
