      -> result = Err'2 (NotInitialized))
    /\ ([@stop_split] [@expl:num_partitions_m ensures #2] [%#slib'27] not poisoned /\ loaded
    -> (exists c: UInt32.t. result = Ok'2 c /\ UInt32.t'int c = Seq.length (view_Vec_PInfoM_Global parts)))}
    (! return {result}) ]

