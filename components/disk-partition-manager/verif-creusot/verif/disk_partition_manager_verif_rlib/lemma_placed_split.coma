use creusot.int.UInt64
use seq.Seq
use int.EuclideanDivision
use int.Int

type t_SpecM = { size_bytes: UInt64.t; tg_zero: bool }

function cdiv [#"/home/cornel/cv-disk-partition-manager-20260930/components/disk-partition-manager/verif-creusot/src/lib.rs" 57 0 57 34] (n: int) (d: int) : int
 = [%#slib'12] EuclideanDivision.div n d + (if EuclideanDivision.mod n d = 0 then 0 else 1)

function demand_l [#"/home/cornel/cv-disk-partition-manager-20260930/components/disk-partition-manager/verif-creusot/src/lib.rs" 239 0 239 53] (sp: t_SpecM) (ss: int) (rest: int) : int
 = [%#slib'11] if UInt64.t'int sp.size_bytes = 0 then rest else cdiv (UInt64.t'int sp.size_bytes) ss

function placed_l [#"/home/cornel/cv-disk-partition-manager-20260930/components/disk-partition-manager/verif-creusot/src/lib.rs" 248 0 248 65] (s: Seq.seq t_SpecM) (n: int) (ss: int) (rest: int) : int

axiom placed_l_def: forall s: Seq.seq t_SpecM, n: int, ss: int, rest: int [placed_l s n ss rest]. ([%#slib'3] 0 <= n
      /\ n <= Seq.length s)
    -> placed_l s n ss rest
    = ([%#slib'4] if n = 0 then 0 else placed_l s (n - 1) ss rest + demand_l (Seq.get s (n - 1)) ss rest)

function fixed_sum_l [#"/home/cornel/cv-disk-partition-manager-20260930/components/disk-partition-manager/verif-creusot/src/lib.rs" 227 0 227 57] (s: Seq.seq t_SpecM) (n: int) (ss: int) : int

axiom fixed_sum_l_def: forall s: Seq.seq t_SpecM, n: int, ss: int [fixed_sum_l s n ss]. ([%#slib'6] 0 <= n
      /\ n <= Seq.length s)
    -> fixed_sum_l s n ss
    = ([%#slib'7] if n = 0 then
      0
    else
      fixed_sum_l s (n - 1) ss
      + (if UInt64.t'int (Seq.get s (n - 1)).size_bytes > 0 then
        cdiv (UInt64.t'int (Seq.get s (n - 1)).size_bytes) ss
      else
        0
      )
    )

function rest_count_l [#"/home/cornel/cv-disk-partition-manager-20260930/components/disk-partition-manager/verif-creusot/src/lib.rs" 214 0 214 49] (s: Seq.seq t_SpecM) (n: int) : int

axiom rest_count_l_def: forall s: Seq.seq t_SpecM, n: int [rest_count_l s n]. ([%#slib'9] 0 <= n /\ n <= Seq.length s)
    -> rest_count_l s n
    = ([%#slib'10] if n = 0 then
      0
    else
      rest_count_l s (n - 1) + (if UInt64.t'int (Seq.get s (n - 1)).size_bytes = 0 then 1 else 0)
    )

predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
  [%#swell_founded] self >= 0 /\ self > other

meta "rewrite_def" predicate well_founded_relation_Int

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant s : Seq.seq t_SpecM

constant n : int

constant ss : int

constant rest : int

function lemma_placed_split [#"/home/cornel/cv-disk-partition-manager-20260930/components/disk-partition-manager/verif-creusot/src/lib.rs" 267 0 267 68] (s: Seq.seq t_SpecM) (n: int) (ss: int) (rest: int) : ()

goal vc_lemma_placed_split: ([%#slib'0] 0 <= n /\ n <= Seq.length s)
  -> (if n > 0 then
    (([@stop_split] [@expl:lemma_placed_split requires] [%#slib'0] 0 <= n - 1 /\ n - 1 <= Seq.length s)
      /\ ([@expl:variant decreases] well_founded_relation_Int ([%#slib] n) ([%#slib] n - 1)))
    /\ (([@stop_split] [@expl:lemma_placed_split ensures] [%#slib'1] placed_l s (n - 1) ss rest
      = fixed_sum_l s (n - 1) ss + rest * rest_count_l s (n - 1))
    -> ([@stop_split] [@expl:lemma_placed_split ensures] [%#slib'1] placed_l s n ss rest
    = fixed_sum_l s n ss + rest * rest_count_l s n))
  else
    [@stop_split] [@expl:lemma_placed_split ensures] [%#slib'1] placed_l s n ss rest
    = fixed_sum_l s n ss + rest * rest_count_l s n
  )
