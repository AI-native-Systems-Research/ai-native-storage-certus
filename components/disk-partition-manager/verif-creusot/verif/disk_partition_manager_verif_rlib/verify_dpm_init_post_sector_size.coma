use creusot.int.UInt64
use creusot.int.UInt32
use creusot.prelude.Any

type t_TabM = { tag: UInt64.t; count: UInt32.t; sector_size: UInt32.t }

type t_PtErr = NoPartitionTable | CorruptTable | InvalidPartition | IoError | LayoutError | NotInitialized

type t_ReadRes = Ok t_TabM | Err t_PtErr

type t_Option_TabM = None | Some t_TabM

type t_Outcome = Ok'0 t_TabM | Err'0 t_PtErr | Panic'0

type tup2_Outcome_Option_TabM = { f0: t_Outcome; f1: t_Option_TabM }

let initialize_m (st: t_Option_TabM) (bound: bool) (geom_ok: bool) (chan_ok: bool) (rd: t_ReadRes) (poisoned: bool)
  (return (x: tup2_Outcome_Option_TabM)) = any
  [ return (result: tup2_Outcome_Option_TabM) ->
  {[@stop_split] [@expl:initialize_m ensures] ([@stop_split] [@expl:initialize_m ensures #0] [%#slib'2] not bound
      -> result.f0 = Err'0 (NotInitialized))
    /\ ([@stop_split] [@expl:initialize_m ensures #1] [%#slib'3] not bound -> result.f1 = st)
    /\ ([@stop_split] [@expl:initialize_m ensures #2] [%#slib'4] bound /\ not geom_ok
      -> result.f0 = Err'0 (IoError) /\ result.f1 = st)
    /\ ([@stop_split] [@expl:initialize_m ensures #3] [%#slib'5] bound /\ geom_ok /\ not chan_ok
      -> result.f0 = Err'0 (IoError) /\ result.f1 = st)
    /\ ([@stop_split] [@expl:initialize_m ensures #4] [%#slib'6] match rd with
        | Err e -> bound /\ geom_ok /\ chan_ok -> result.f0 = Err'0 e /\ result.f1 = st
        | _ -> true
        end)
    /\ ([@stop_split] [@expl:initialize_m ensures #5] [%#slib'7] match rd with
        | Ok t -> bound /\ geom_ok /\ chan_ok /\ poisoned -> result.f0 = Panic'0 /\ result.f1 = st
        | _ -> true
        end)
    /\ ([@stop_split] [@expl:initialize_m ensures #6] [%#slib'8] match rd with
      | Ok t -> bound /\ geom_ok /\ chan_ok /\ not poisoned -> result.f0 = Ok'0 t /\ result.f1 = Some t
      | _ -> true
      end)}
    (! return {result}) ]

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let verify_dpm_init_post_sector_size [#"/home/cornel/cv-disk-partition-manager-20260930/components/disk-partition-manager/verif-creusot/src/lib.rs" 1450 0 1453 28]
  (st: t_Option_TabM) (bound: bool) (geom_ok: bool) (chan_ok: bool) (dev_ss: UInt32.t) (tag'0: UInt64.t)
  (count'0: UInt32.t) (poisoned: bool) (return (x: tup2_Outcome_Option_TabM)) = (! bb0
  [ bb0 = s0
    [ s0 = [ &_18 <- { tag = tag'0; count = count'0; sector_size = dev_ss } ] s1
    | s1 = [ &rd <- Ok _18 ] s2
    | s2 = initialize_m [%#slib] {st} {bound} {geom_ok} {chan_ok} {rd} {poisoned}
        (fun (_x: tup2_Outcome_Option_TabM) -> [ &_ret <- _x ] s3)
    | s3 = return {_ret} ] ]
  [ & _ret: tup2_Outcome_Option_TabM = Any.any_l ()
  | & st: t_Option_TabM = st
  | & bound: bool = bound
  | & geom_ok: bool = geom_ok
  | & chan_ok: bool = chan_ok
  | & dev_ss: UInt32.t = dev_ss
  | & tag'0: UInt64.t = tag'0
  | & count'0: UInt32.t = count'0
  | & poisoned: bool = poisoned
  | & rd: t_ReadRes = Any.any_l ()
  | & _18: t_TabM = Any.any_l () ])
  [ return (result: tup2_Outcome_Option_TabM) ->
  {[@stop_split] [@expl:verify_dpm_init_post_sector_size ensures] ([@stop_split] [@expl:verify_dpm_init_post_sector_size ensures #0] [%#slib'0] bound
        /\ geom_ok /\ chan_ok /\ not poisoned
      -> match result.f0 with
        | Ok'0 r -> r.sector_size = dev_ss
        | _ -> false
        end)
    /\ ([@stop_split] [@expl:verify_dpm_init_post_sector_size ensures #1] [%#slib'1] match result.f0 with
      | Ok'0 r -> r.sector_size = dev_ss
      | _ -> true
      end)}
    (! return {result}) ]
