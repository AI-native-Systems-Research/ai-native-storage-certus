predicate invariant_array_u8_72 (self: Slice64.array UInt8.t) =
  [%#sarray'0] inv_Seq_u8 (Slice64.view self) /\ Seq.length (Slice64.view self) = UInt64.t'int (72: UInt64.t)

predicate inv_array_u8_72 [@inline:trivial] (_1: Slice64.array UInt8.t) = invariant_array_u8_72 _1

meta "rewrite_def" predicate inv_array_u8_72

constant const_MAX: UInt64.t = (18446744073709551615: UInt64.t)

function view_Vec_u16_Global (self: t_Vec_u16_Global) : Seq.seq UInt16.t

axiom view_Vec_u16_Global_spec:
  forall self: t_Vec_u16_Global [view_Vec_u16_Global self]. [%#svec] Seq.length (view_Vec_u16_Global self)
    <= UInt64.t'int const_MAX

function index_array_u8_72 [@inline:trivial] (self: Slice64.array UInt8.t) (ix: int) : UInt8.t =
