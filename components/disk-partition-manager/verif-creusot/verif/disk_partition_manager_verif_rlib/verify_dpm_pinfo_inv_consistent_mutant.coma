use creusot.int.UInt32
use creusot.int.UInt64
use seq.Seq
use creusot.prelude.Any
use int.Int

type t_Vec_PInfoM_Global

type t_PInfoM = { index: UInt32.t; start_lba: UInt64.t; num_sectors: UInt64.t }

type t_PtErr = NoPartitionTable | CorruptTable | InvalidPartition | IoError | LayoutError | NotInitialized

type t_PiOutcome = Ok t_PInfoM | Err t_PtErr | Panic

constant const_MAX: UInt64.t = (18446744073709551615: UInt64.t)

function view_Vec_PInfoM_Global (self: t_Vec_PInfoM_Global) : Seq.seq t_PInfoM

axiom view_Vec_PInfoM_Global_spec:
  forall self: t_Vec_PInfoM_Global [view_Vec_PInfoM_Global self]. [%#svec] Seq.length (view_Vec_PInfoM_Global self)
    <= UInt64.t'int const_MAX

let partition_info_m (loaded: bool) (parts: t_Vec_PInfoM_Global) (poisoned: bool) (idx: UInt32.t)
  (return (x: t_PiOutcome)) = any
  [ return (result: t_PiOutcome) ->
  {[@stop_split] [@expl:partition_info_m ensures] ([@stop_split] [@expl:partition_info_m ensures #0] [%#slib'4] poisoned
      -> result = Panic)
    /\ ([@stop_split] [@expl:partition_info_m ensures #1] [%#slib'5] not poisoned /\ not loaded
      -> result = Err (NotInitialized))
    /\ ([@stop_split] [@expl:partition_info_m ensures #2] [%#slib'6] not poisoned
        /\ loaded /\ UInt32.t'int idx >= Seq.length (view_Vec_PInfoM_Global parts) -> result = Err (InvalidPartition))
    /\ ([@stop_split] [@expl:partition_info_m ensures #3] [%#slib'7] not poisoned
      /\ loaded /\ UInt32.t'int idx < Seq.length (view_Vec_PInfoM_Global parts)
    -> result = Ok (Seq.get (view_Vec_PInfoM_Global parts) (UInt32.t'int idx)))}
    (! return {result}) ]

type t_NpOutcome = Ok'0 UInt32.t | Err'0 t_PtErr | Panic'0

let num_partitions_m (loaded: bool) (parts: t_Vec_PInfoM_Global) (poisoned: bool) (return (x: t_NpOutcome)) =
{[@stop_split] [@expl:num_partitions_m requires] [%#slib'8] Seq.length (view_Vec_PInfoM_Global parts) <= 4294967295}
  any
  [ return (result: t_NpOutcome) ->
  {[@stop_split] [@expl:num_partitions_m ensures] ([@stop_split] [@expl:num_partitions_m ensures #0] [%#slib'9] poisoned
      -> result = Panic'0)
    /\ ([@stop_split] [@expl:num_partitions_m ensures #1] [%#slib'10] not poisoned /\ not loaded
      -> result = Err'0 (NotInitialized))
    /\ ([@stop_split] [@expl:num_partitions_m ensures #2] [%#slib'11] not poisoned /\ loaded
    -> (exists c: UInt32.t. result = Ok'0 c /\ UInt32.t'int c = Seq.length (view_Vec_PInfoM_Global parts)))}
    (! return {result}) ]

type tup3_PiOutcome_PiOutcome_NpOutcome = { f0: t_PiOutcome; f1: t_PiOutcome; f2: t_NpOutcome }

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

