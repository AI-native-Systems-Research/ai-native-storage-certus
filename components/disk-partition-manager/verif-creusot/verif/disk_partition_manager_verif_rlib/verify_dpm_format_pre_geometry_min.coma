let usable_window_wrapping (ss: UInt32.t) (ns: UInt64.t) (return (x: tup2_u64_u64)) =
{[@stop_split] [@expl:usable_window_wrapping requires] ([@stop_split] [@expl:usable_window_wrapping requires #0] [%#slib'5] UInt32.t'int ss
      = 512
    \/ UInt32.t'int ss = 4096)
  /\ ([@stop_split] [@expl:usable_window_wrapping requires #1] [%#slib'6] UInt64.t'int ns >= 1)}
  any
  [ return (result: tup2_u64_u64) ->
  {[@stop_split] [@expl:usable_window_wrapping ensures] ([@stop_split] [@expl:usable_window_wrapping ensures #0] [%#slib'7] UInt64.t'int result.f0
      = first_usable_l (UInt32.t'int ss))
    /\ ([@stop_split] [@expl:usable_window_wrapping ensures #1] [%#slib'8] UInt64.t'int ns
        >= entry_sectors_l (UInt32.t'int ss) + 2
      -> UInt64.t'int result.f1 = last_usable_l (UInt32.t'int ss) (UInt64.t'int ns))
    /\ ([@stop_split] [@expl:usable_window_wrapping ensures #2] [%#slib'9] UInt64.t'int ns
        < entry_sectors_l (UInt32.t'int ss) + 2
      -> UInt64.t'int result.f1 = 18446744073709551616 + last_usable_l (UInt32.t'int ss) (UInt64.t'int ns))
    /\ ([@stop_split] [@expl:usable_window_wrapping ensures #3] [%#slib'10] UInt64.t'int ns
        < entry_sectors_l (UInt32.t'int ss) + 2 -> UInt64.t'int result.f1 > UInt64.t'int ns)
    /\ ([@stop_split] [@expl:usable_window_wrapping ensures #4] [%#slib'11] UInt64.t'int ns
      < entry_sectors_l (UInt32.t'int ss) + 2 -> UInt64.t'int result.f0 < UInt64.t'int result.f1)}
    (! return {result}) ]

