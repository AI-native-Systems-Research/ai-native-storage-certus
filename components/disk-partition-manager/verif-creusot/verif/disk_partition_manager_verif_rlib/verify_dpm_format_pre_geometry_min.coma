        < entry_sectors_l (UInt32.t'int ss) + 2
      -> UInt64.t'int result.f1 = 18446744073709551616 + last_usable_l (UInt32.t'int ss) (UInt64.t'int ns))
    /\ ([@stop_split] [@expl:usable_window_wrapping ensures #3] [%#slib'10] UInt64.t'int ns
        < entry_sectors_l (UInt32.t'int ss) + 2 -> UInt64.t'int result.f1 > UInt64.t'int ns)
    /\ ([@stop_split] [@expl:usable_window_wrapping ensures #4] [%#slib'11] UInt64.t'int ns
      < entry_sectors_l (UInt32.t'int ss) + 2 -> UInt64.t'int result.f0 < UInt64.t'int result.f1)}
    (! return {result}) ]

