use creusot.int.UInt32
use int.EuclideanDivision
use creusot.prelude.Any
use int.Int

constant const_ENTRY_ARRAY_BYTES: UInt32.t = [%#slib'3] (16384: UInt32.t)

function cdiv [#"/home/cornel/fv-runs/apply-disk-partition-manager-20261007/components/disk-partition-manager/verif-creusot/src/lib.rs" 57 0 57 34] (n: int) (d: int) : int
 = [%#slib'7] EuclideanDivision.div n d + (if EuclideanDivision.mod n d = 0 then 0 else 1)

let cdiv32 (n: UInt32.t) (d: UInt32.t) (return (x: UInt32.t)) =
{[@stop_split] [@expl:cdiv32 requires] [%#slib'4] UInt32.t'int d > 0}
  any
  [ return (result: UInt32.t) -> {[@stop_split] [@expl:cdiv32 ensures] [%#slib'5] UInt32.t'int result
    = cdiv (UInt32.t'int n) (UInt32.t'int d)}
    (! return {result}) ]

function entry_sectors_l [#"/home/cornel/fv-runs/apply-disk-partition-manager-20261007/components/disk-partition-manager/verif-creusot/src/lib.rs" 84 0 84 38] (ss: int) : int
 = [%#slib'6] cdiv 16384 ss

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let entry_sectors [#"/home/cornel/fv-runs/apply-disk-partition-manager-20261007/components/disk-partition-manager/verif-creusot/src/lib.rs" 90 0 90 36]
  (ss: UInt32.t) (return (x: UInt32.t)) = {[@stop_split] [@expl:entry_sectors requires] [%#slib'1] UInt32.t'int ss > 0}
  (! bb0
  [ bb0 = s0
    [ s0 = cdiv32 [%#slib'0] {[%#slib] const_ENTRY_ARRAY_BYTES} {ss} (fun (_x: UInt32.t) -> [ &_ret <- _x ] s1)
    | s1 = return {_ret} ] ] [ & _ret: UInt32.t = Any.any_l () | & ss: UInt32.t = ss ])
  [ return (result: UInt32.t) -> {[@stop_split] [@expl:entry_sectors ensures] [%#slib'2] UInt32.t'int result
    = entry_sectors_l (UInt32.t'int ss)}
    (! return {result}) ]
