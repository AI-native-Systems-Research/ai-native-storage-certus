  /\ ([@stop_split] [@expl:refute_dpm_pinfo_post_index_echo requires #3] [%#slib'7] forall j: int. 0 <= j /\ j < 2
    -> UInt64.t'int (Seq.get (view_Vec_EntryM_Global entries) j).end'
