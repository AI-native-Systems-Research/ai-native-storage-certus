      + 1)}
    (! return {result}) ]

type t_PtErr = NoPartitionTable | CorruptTable | InvalidPartition | IoError | LayoutError | NotInitialized

type t_PiOutcome = Ok t_PInfoM | Err t_PtErr | Panic

let partition_info_m (loaded: bool) (parts: t_Vec_PInfoM_Global) (poisoned: bool) (idx: UInt32.t)
  (return (x: t_PiOutcome)) = any
  [ return (result: t_PiOutcome) ->
  {[@stop_split] [@expl:partition_info_m ensures] ([@stop_split] [@expl:partition_info_m ensures #0] [%#slib'16] poisoned
      -> result = Panic)
    /\ ([@stop_split] [@expl:partition_info_m ensures #1] [%#slib'17] not poisoned /\ not loaded
      -> result = Err (NotInitialized))
    /\ ([@stop_split] [@expl:partition_info_m ensures #2] [%#slib'18] not poisoned
        /\ loaded /\ UInt32.t'int idx >= Seq.length (view_Vec_PInfoM_Global parts) -> result = Err (InvalidPartition))
    /\ ([@stop_split] [@expl:partition_info_m ensures #3] [%#slib'19] not poisoned
      /\ loaded /\ UInt32.t'int idx < Seq.length (view_Vec_PInfoM_Global parts)
    -> result = Ok (Seq.get (view_Vec_PInfoM_Global parts) (UInt32.t'int idx)))}
    (! return {result}) ]

