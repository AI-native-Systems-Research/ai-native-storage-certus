axiom view_Vec_EntryM_Global_spec:
  forall self: t_Vec_EntryM_Global [view_Vec_EntryM_Global self]. [%#svec] Seq.length (view_Vec_EntryM_Global self)
    <= UInt64.t'int const_MAX

type t_PInfoM = { index: UInt32.t; start_lba: UInt64.t; num_sectors: UInt64.t }

