use creusot.int.UInt64
use seq.Seq
use int.Int

type t_EntryM = { tg_zero: bool; start: UInt64.t; end': UInt64.t; attrs: UInt64.t }

function occupied_l [#"/home/cornel/cv-disk-partition-manager-20260930/components/disk-partition-manager/verif-creusot/src/lib.rs" 596 0 596 48] (s: Seq.seq t_EntryM) (n: int) : int

axiom occupied_l_def: forall s: Seq.seq t_EntryM, n: int [occupied_l s n]. ([%#slib'4] 0 <= n /\ n <= Seq.length s)
    -> occupied_l s n
    = ([%#slib'5] if n = 0 then 0 else occupied_l s (n - 1) + (if (Seq.get s (n - 1)).tg_zero then 0 else 1))

predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
  [%#swell_founded] self >= 0 /\ self > other

meta "rewrite_def" predicate well_founded_relation_Int

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant s : Seq.seq t_EntryM

constant n : int

function lemma_occupied_mono [#"/home/cornel/cv-disk-partition-manager-20260930/components/disk-partition-manager/verif-creusot/src/lib.rs" 617 0 617 50] (s: Seq.seq t_EntryM) (n: int) : ()

goal vc_lemma_occupied_mono: ([%#slib'0] 0 <= n /\ n <= Seq.length s)
  -> (if n > 0 then
    (([@stop_split] [@expl:lemma_occupied_mono requires] [%#slib'0] 0 <= n - 1 /\ n - 1 <= Seq.length s)
      /\ ([@expl:variant decreases] well_founded_relation_Int ([%#slib] n) ([%#slib] n - 1)))
    /\ (([@stop_split] [@expl:lemma_occupied_mono ensures] ([@stop_split] [@expl:lemma_occupied_mono ensures #0] [%#slib'1] forall j: int. 0
              <= j
            /\ j <= n - 1 -> occupied_l s j <= occupied_l s (n - 1))
      /\ ([@stop_split] [@expl:lemma_occupied_mono ensures #1] [%#slib'2] forall j: int. 0 <= j
          /\ j < n - 1 /\ not (Seq.get s j).tg_zero -> occupied_l s j < occupied_l s (n - 1)))
    -> ([@stop_split] [@expl:lemma_occupied_mono ensures] ([@stop_split] [@expl:lemma_occupied_mono ensures #0] [%#slib'1] forall j: int. 0
            <= j
          /\ j <= n -> occupied_l s j <= occupied_l s n)
    /\ ([@stop_split] [@expl:lemma_occupied_mono ensures #1] [%#slib'2] forall j: int. 0 <= j
        /\ j < n /\ not (Seq.get s j).tg_zero -> occupied_l s j < occupied_l s n)))
  else
    [@stop_split] [@expl:lemma_occupied_mono ensures] ([@stop_split] [@expl:lemma_occupied_mono ensures #0] [%#slib'1] forall j: int. 0
            <= j
          /\ j <= n -> occupied_l s j <= occupied_l s n)
    /\ ([@stop_split] [@expl:lemma_occupied_mono ensures #1] [%#slib'2] forall j: int. 0 <= j
        /\ j < n /\ not (Seq.get s j).tg_zero -> occupied_l s j < occupied_l s n)
  )
