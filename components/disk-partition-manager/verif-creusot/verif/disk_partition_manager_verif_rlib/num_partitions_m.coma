  [ & _ret: t_NpOutcome = Any.any_l ()
  | & loaded: bool = loaded
  | & parts: t_Vec_PInfoM_Global = parts
  | & poisoned: bool = poisoned
  | & _21: t_PtErr = Any.any_l ()
