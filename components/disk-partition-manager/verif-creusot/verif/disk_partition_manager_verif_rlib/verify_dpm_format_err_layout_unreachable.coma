      = first_usable_l (UInt32.t'int ss))
    /\ ([@stop_split] [@expl:usable_window ensures #1] [%#slib'8] UInt64.t'int result.f1
    = last_usable_l (UInt32.t'int ss) (UInt64.t'int ns))}
    (! return {result}) ]

type t_Vec_SpecM_Global

type t_Vec_EntryM_Global

type t_LayoutErr = MultiRest | Capacity | PerPartition

type t_Result_Vec_EntryM_Global_LayoutErr = Ok t_Vec_EntryM_Global | Err t_LayoutErr

type t_SpecM = { size_bytes: UInt64.t; tg_zero: bool }

function fixed_sum_l [#"/home/cornel/fv-runs/j13-dpm/components/disk-partition-manager/verif-creusot/src/lib.rs" 227 0 227 57] (s: Seq.seq t_SpecM) (n: int) (ss: int) : int

axiom fixed_sum_l_def: forall s: Seq.seq t_SpecM, n: int, ss: int [fixed_sum_l s n ss]. ([%#slib'19] 0 <= n
      /\ n <= Seq.length s)
    -> fixed_sum_l s n ss
