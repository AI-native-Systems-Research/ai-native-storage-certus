let protective_mbr (ss: UInt32.t) (ns: UInt64.t) (return (x: t_Vec_u8_Global)) =
{[@stop_split] [@expl:protective_mbr requires] ([@stop_split] [@expl:protective_mbr requires #0] [%#slib'5] UInt32.t'int ss
    >= 512)
  /\ ([@stop_split] [@expl:protective_mbr requires #1] [%#slib'6] UInt64.t'int ns >= 1)}
  any
  [ return (result: t_Vec_u8_Global) ->
  {[@stop_split] [@expl:protective_mbr ensures] ([@stop_split] [@expl:protective_mbr ensures #0] [%#slib'7] Seq.length (view_Vec_u8_Global result)
      = UInt32.t'int ss)
    /\ ([@stop_split] [@expl:protective_mbr ensures #1] [%#slib'8] UInt8.t'int (Seq.get (view_Vec_u8_Global result) 446)
      = 0)
    /\ ([@stop_split] [@expl:protective_mbr ensures #2] [%#slib'9] UInt8.t'int (Seq.get (view_Vec_u8_Global result) 450)
      = 238)
    /\ ([@stop_split] [@expl:protective_mbr ensures #3] [%#slib'10] le32_at (view_Vec_u8_Global result) 454 = 1)
    /\ ([@stop_split] [@expl:protective_mbr ensures #4] [%#slib'11] le32_at (view_Vec_u8_Global result) 458
      = (if UInt64.t'int ns - 1 <= 4294967295 then UInt64.t'int ns - 1 else 4294967295))
    /\ ([@stop_split] [@expl:protective_mbr ensures #5] [%#slib'12] UInt8.t'int (Seq.get (view_Vec_u8_Global result) 510)
        = 85
      /\ UInt8.t'int (Seq.get (view_Vec_u8_Global result) 511) = 170)
    /\ ([@stop_split] [@expl:protective_mbr ensures #6] [%#slib'13] forall i: int. 0 <= i /\ i < 446
        -> UInt8.t'int (Seq.get (view_Vec_u8_Global result) i) = 0)
    /\ ([@stop_split] [@expl:protective_mbr ensures #7] [%#slib'14] forall i: int. 462 <= i /\ i < 510
        -> UInt8.t'int (Seq.get (view_Vec_u8_Global result) i) = 0)
    /\ ([@stop_split] [@expl:protective_mbr ensures #8] [%#slib'15] forall i: int. 512 <= i /\ i < UInt32.t'int ss
      -> UInt8.t'int (Seq.get (view_Vec_u8_Global result) i) = 0)}
