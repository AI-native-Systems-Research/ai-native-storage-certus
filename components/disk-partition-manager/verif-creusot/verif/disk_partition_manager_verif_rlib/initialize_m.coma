use creusot.int.UInt64
use creusot.int.UInt32
use creusot.prelude.Any

type t_TabM = { tag: UInt64.t; count: UInt32.t; sector_size: UInt32.t }

type t_PtErr = NoPartitionTable | CorruptTable | InvalidPartition | IoError | LayoutError | NotInitialized

type t_ReadRes = Ok t_TabM | Err t_PtErr

let elim_Err (_x: t_ReadRes) (return (f0: t_PtErr)) = any
  [ _k (f0: t_PtErr) -> {Err f0 = _x} (! return {f0})
  | _chk -> (! {[@expl:elim Err] match _x with
      | Err _ -> true
      | _ -> false
      end}
    any) ]

type t_Outcome = Ok'0 t_TabM | Err'0 t_PtErr | Panic'0

type t_Option_TabM = None | Some t_TabM

type tup2_Outcome_Option_TabM = { f0: t_Outcome; f1: t_Option_TabM }

let elim_Ok (_x: t_ReadRes) (return (f0'0: t_TabM)) = any
  [ _k (f0'0: t_TabM) -> {Ok f0'0 = _x} (! return {f0'0})
  | _chk -> (! {[@expl:elim Ok] match _x with
      | Ok _ -> true
      | _ -> false
      end}
    any) ]

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

