          | Err e -> result = Err'0 e
          end
        | _ -> true
        end)
    /\ ([@stop_split] [@expl:initialize_or_format_m ensures #4] [%#slib'6] not force
      -> match init with
        | Err (IoError) -> result = Err'0 (IoError)
        | _ -> true
        end)
    /\ ([@stop_split] [@expl:initialize_or_format_m ensures #5] [%#slib'7] not force
      -> match init with
        | Err (NotInitialized) -> result = Err'0 (NotInitialized)
        | _ -> true
        end)
    /\ ([@stop_split] [@expl:initialize_or_format_m ensures #6] [%#slib'8] not force
      -> match init with
        | Err (LayoutError) -> result = Err'0 (LayoutError)
        | _ -> true
