use creusot.int.UInt8
use creusot.int.UInt64
use seq.Seq
use creusot.slice.Slice64
use creusot.slice.Slice64Ops
use creusot.prelude.MutBorrow
use creusot.prelude.Any
use int.Int

type t_Vec_u8_Global

constant const_MAX: UInt64.t = (18446744073709551615: UInt64.t)

function view_Vec_u8_Global (self: t_Vec_u8_Global) : Seq.seq UInt8.t

axiom view_Vec_u8_Global_spec:
  forall self: t_Vec_u8_Global [view_Vec_u8_Global self]. [%#svec'2] Seq.length (view_Vec_u8_Global self)
    <= UInt64.t'int const_MAX

function index_Vec_u8_Global [@inline:trivial] (self: t_Vec_u8_Global) (ix: int) : UInt8.t =
  [%#svec'8] Seq.get (view_Vec_u8_Global self) ix

meta "rewrite_def" function index_Vec_u8_Global

let from_elem_u8 (elem: UInt8.t) (n: UInt64.t) (return (x: t_Vec_u8_Global)) = any
  [ return (result: t_Vec_u8_Global) ->
  {[@stop_split] [@expl:from_elem_u8 ensures] ([@stop_split] [@expl:from_elem ensures #0] [%#svec'0] Seq.length (view_Vec_u8_Global result)
      = UInt64.t'int n)
    /\ ([@stop_split] [@expl:from_elem ensures #1] [%#svec'1] forall i: int. 0 <= i /\ i < UInt64.t'int n
      -> index_Vec_u8_Global result i = elem)}
    (! return {result}) ]

predicate in_bounds_usize [@inline:trivial] (self: UInt64.t) (seq: Seq.seq UInt8.t) =
  [%#sslice] UInt64.t'int self < Seq.length seq

meta "rewrite_def" predicate in_bounds_usize

predicate has_value_usize [@inline:trivial] (self: UInt64.t) (seq: Seq.seq UInt8.t) (out: UInt8.t) =
  [%#sslice'0] Seq.get seq (UInt64.t'int self) = out

meta "rewrite_def" predicate has_value_usize

predicate resolve_elswhere_usize [@inline:trivial] (self: UInt64.t) (old': Seq.seq UInt8.t) (fin: Seq.seq UInt8.t) =
  [%#sslice'1] forall i: int. 0 <= i /\ i <> UInt64.t'int self /\ i < Seq.length old' -> Seq.get old' i = Seq.get fin i

meta "rewrite_def" predicate resolve_elswhere_usize

let index_mut_Vec_u8_Global (self_: MutBorrow.t t_Vec_u8_Global) (ix: UInt64.t) (return (x: MutBorrow.t UInt8.t)) =
{[@stop_split] [@expl:index_mut requires] [%#svec'3] in_bounds_usize ix (view_Vec_u8_Global self_.current)}
  any
  [ return (result: MutBorrow.t UInt8.t) ->
  {[@stop_split] [@expl:index_mut_Vec_u8_Global ensures] ([@stop_split] [@expl:index_mut ensures #0] [%#svec'4] has_value_usize ix (view_Vec_u8_Global self_.current) result.current)
    /\ ([@stop_split] [@expl:index_mut ensures #1] [%#svec'5] has_value_usize ix (view_Vec_u8_Global self_.final) result.final)
    /\ ([@stop_split] [@expl:index_mut ensures #2] [%#svec'6] resolve_elswhere_usize ix (view_Vec_u8_Global self_.current) (view_Vec_u8_Global self_.final))
    /\ ([@stop_split] [@expl:index_mut ensures #3] [%#svec'7] Seq.length (view_Vec_u8_Global self_.final)
    = Seq.length (view_Vec_u8_Global self_.current))}
    (! return {result}) ]

predicate resolve_refmut_u8 [@inline:trivial] (_1: MutBorrow.t UInt8.t) = _1.final = _1.current

meta "rewrite_def" predicate resolve_refmut_u8

predicate inv_Seq_u8 [@inline:trivial] (_1: Seq.seq UInt8.t) = true

meta "rewrite_def" predicate inv_Seq_u8

predicate invariant_array_u8_16 (self: Slice64.array UInt8.t) =
  [%#sarray'0] inv_Seq_u8 (Slice64.view self) /\ Seq.length (Slice64.view self) = UInt64.t'int (16: UInt64.t)

predicate inv_array_u8_16 [@inline:trivial] (_1: Slice64.array UInt8.t) = invariant_array_u8_16 _1

meta "rewrite_def" predicate inv_array_u8_16

predicate invariant_array_u8_72 (self: Slice64.array UInt8.t) =
  [%#sarray'0] inv_Seq_u8 (Slice64.view self) /\ Seq.length (Slice64.view self) = UInt64.t'int (72: UInt64.t)

predicate inv_array_u8_72 [@inline:trivial] (_1: Slice64.array UInt8.t) = invariant_array_u8_72 _1

meta "rewrite_def" predicate inv_array_u8_72

function index_array_u8_16 [@inline:trivial] (self: Slice64.array UInt8.t) (ix: int) : UInt8.t =
  [%#sarray] Seq.get (Slice64.view self) ix

meta "rewrite_def" function index_array_u8_16

function index_array_u8_72 [@inline:trivial] (self: Slice64.array UInt8.t) (ix: int) : UInt8.t =
  [%#sarray] Seq.get (Slice64.view self) ix

meta "rewrite_def" function index_array_u8_72

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let serialize_padding_slot [#"/home/cornel/fv-runs/apply-disk-partition-manager-20261007/components/disk-partition-manager/verif-creusot/src/lib.rs" 1696 0 1698 12]
  (tg: Slice64.array UInt8.t) (ug: Slice64.array UInt8.t) (start: UInt64.t) (end': UInt64.t) (attrs: UInt64.t)
