use creusot.int.UInt64
use seq.Seq
use int.EuclideanDivision
use creusot.int.UInt32
use creusot.prelude.MutBorrow
use creusot.prelude.Any
use int.Int

type t_Vec_EntryM_Global

type t_EntryM = { tg_zero: bool; start: UInt64.t; end': UInt64.t; attrs: UInt64.t }

constant const_MAX: UInt64.t = (18446744073709551615: UInt64.t)

function view_Vec_EntryM_Global (self: t_Vec_EntryM_Global) : Seq.seq t_EntryM

axiom view_Vec_EntryM_Global_spec:
  forall self: t_Vec_EntryM_Global [view_Vec_EntryM_Global self]. [%#svec'1] Seq.length (view_Vec_EntryM_Global self)
    <= UInt64.t'int const_MAX

let new_EntryM (return (x: t_Vec_EntryM_Global)) = any
  [ return (result: t_Vec_EntryM_Global) ->
  {[@stop_split] [@expl:new ensures] [%#svec] Seq.length (view_Vec_EntryM_Global result) = 0}
    (! return {result}) ]

type t_Vec_SpecM_Global

type t_SpecM = { size_bytes'0: UInt64.t; tg_zero'0: bool }

function view_Vec_SpecM_Global (self: t_Vec_SpecM_Global) : Seq.seq t_SpecM

axiom view_Vec_SpecM_Global_spec:
  forall self: t_Vec_SpecM_Global [view_Vec_SpecM_Global self]. [%#svec'1] Seq.length (view_Vec_SpecM_Global self)
    <= UInt64.t'int const_MAX

let len_SpecM (self_: t_Vec_SpecM_Global) (return (x: UInt64.t)) = any
  [ return (result: UInt64.t) -> {[@stop_split] [@expl:len ensures] [%#svec'0] UInt64.t'int result
    = Seq.length (view_Vec_SpecM_Global self_)}
    (! return {result}) ]

function cdiv [#"/home/cornel/fv-runs/apply-disk-partition-manager-20261007/components/disk-partition-manager/verif-creusot/src/lib.rs" 57 0 57 34] (n: int) (d: int) : int
 = [%#slib'98] EuclideanDivision.div n d + (if EuclideanDivision.mod n d = 0 then 0 else 1)

function demand_l [#"/home/cornel/fv-runs/apply-disk-partition-manager-20261007/components/disk-partition-manager/verif-creusot/src/lib.rs" 239 0 239 53] (sp: t_SpecM) (ss: int) (rest: int) : int
 = [%#slib'72] if UInt64.t'int sp.size_bytes'0 = 0 then rest else cdiv (UInt64.t'int sp.size_bytes'0) ss

function placed_l [#"/home/cornel/fv-runs/apply-disk-partition-manager-20261007/components/disk-partition-manager/verif-creusot/src/lib.rs" 248 0 248 65] (s: Seq.seq t_SpecM) (n: int) (ss: int) (rest: int) : int

axiom placed_l_def: forall s: Seq.seq t_SpecM, n: int, ss: int, rest: int [placed_l s n ss rest]. ([%#slib'74] 0 <= n
      /\ n <= Seq.length s)
    -> placed_l s n ss rest
    = ([%#slib'75] if n = 0 then 0 else placed_l s (n - 1) ss rest + demand_l (Seq.get s (n - 1)) ss rest)

predicate in_bounds_usize [@inline:trivial] (self: UInt64.t) (seq: Seq.seq t_SpecM) =
  [%#sslice] UInt64.t'int self < Seq.length seq

meta "rewrite_def" predicate in_bounds_usize

predicate has_value_usize [@inline:trivial] (self: UInt64.t) (seq: Seq.seq t_SpecM) (out: t_SpecM) =
  [%#sslice'0] Seq.get seq (UInt64.t'int self) = out

meta "rewrite_def" predicate has_value_usize

let index_Vec_SpecM_Global (self_: t_Vec_SpecM_Global) (ix: UInt64.t) (return (x: t_SpecM)) =
{[@stop_split] [@expl:index requires] [%#svec'2] in_bounds_usize ix (view_Vec_SpecM_Global self_)}
  any
  [ return (result: t_SpecM) ->
  {[@stop_split] [@expl:index ensures] [%#svec'3] has_value_usize ix (view_Vec_SpecM_Global self_) result}
    (! return {result}) ]

let cdiv64 (n: UInt64.t) (d: UInt64.t) (return (x: UInt64.t)) =
{[@stop_split] [@expl:cdiv64 requires] [%#slib'76] UInt64.t'int d > 0}
  any
  [ return (result: UInt64.t) -> {[@stop_split] [@expl:cdiv64 ensures] [%#slib'77] UInt64.t'int result
