              <> 0)
          /\ UInt8.t'int (index_array_u8_72 data (2 * m)) + 256 * UInt8.t'int (index_array_u8_72 data (2 * m + 1)) = 0
        -> Seq.length (view_Vec_u16_Global result) = m)
    /\ ([@stop_split] [@expl:decode_units ensures #5] [%#slib'13] (forall k: int. 0 <= k /\ k < 36
        -> UInt8.t'int (index_array_u8_72 data (2 * k)) + 256 * UInt8.t'int (index_array_u8_72 data (2 * k + 1)) <> 0)
    -> Seq.length (view_Vec_u16_Global result) = 36)}
