{[@stop_split] [@expl:decode_units 'data' type invariant] [%#slib'7] inv_ref_array_u8_72 data}
  any
  [ return (result: t_Vec_u16_Global) ->
  {[@stop_split] [@expl:decode_units ensures] ([@stop_split] [@expl:decode_units ensures #0] [%#slib'8] Seq.length (view_Vec_u16_Global result)
      <= 36)
    /\ ([@stop_split] [@expl:decode_units ensures #1] [%#slib'9] forall k: int. 0 <= k
          /\ k < Seq.length (view_Vec_u16_Global result)
        -> UInt16.t'int (Seq.get (view_Vec_u16_Global result) k)
        = UInt8.t'int (index_array_u8_72 data (2 * k)) + 256 * UInt8.t'int (index_array_u8_72 data (2 * k + 1)))
    /\ ([@stop_split] [@expl:decode_units ensures #2] [%#slib'10] forall k: int. 0 <= k
          /\ k < Seq.length (view_Vec_u16_Global result) -> UInt16.t'int (Seq.get (view_Vec_u16_Global result) k) <> 0)
    /\ ([@stop_split] [@expl:decode_units ensures #3] [%#slib'11] Seq.length (view_Vec_u16_Global result) < 36
      -> UInt8.t'int (index_array_u8_72 data (2 * Seq.length (view_Vec_u16_Global result)))
        + 256 * UInt8.t'int (index_array_u8_72 data (2 * Seq.length (view_Vec_u16_Global result) + 1))
      = 0)
    /\ ([@stop_split] [@expl:decode_units ensures #4] [%#slib'12] forall m: int. 0 <= m
          /\ m < 36
          /\ (forall k: int. 0 <= k /\ k < m
