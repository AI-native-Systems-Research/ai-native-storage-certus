meta "rewrite_def" function index_array_u8_72

let encode_units (units: t_Vec_u16_Global) (return (x: Slice64.array UInt8.t)) = any
  [ return (result: Slice64.array UInt8.t) ->
  {[@stop_split] [@expl:encode_units ensures] ([@stop_split] [@expl:encode_units result type invariant] [%#slib'4] inv_array_u8_72 result)
    /\ ([@stop_split] [@expl:encode_units ensures #0] [%#slib'5] forall k: int. 0 <= k
          /\ k < 36 /\ k < Seq.length (view_Vec_u16_Global units)
        -> UInt8.t'int (index_array_u8_72 result (2 * k))
          = ComputerDivision.mod (UInt16.t'int (Seq.get (view_Vec_u16_Global units) k)) 256
        /\ UInt8.t'int (index_array_u8_72 result (2 * k + 1))
        = ComputerDivision.div (UInt16.t'int (Seq.get (view_Vec_u16_Global units) k)) 256)
    /\ ([@stop_split] [@expl:encode_units ensures #1] [%#slib'6] forall k: int. Seq.length (view_Vec_u16_Global units)
          <= k
        /\ k < 36
      -> UInt8.t'int (index_array_u8_72 result (2 * k)) = 0 /\ UInt8.t'int (index_array_u8_72 result (2 * k + 1)) = 0)}
    (! return {result}) ]

predicate invariant_ref_array_u8_72 [@inline:trivial] (self: Slice64.array UInt8.t) =
