use creusot.int.UInt32
use creusot.int.UInt64
use seq.Seq
use creusot.prelude.Any
use int.Int

type t_Vec_PInfoM_Global

type t_PInfoM = { index: UInt32.t; start_lba: UInt64.t; num_sectors: UInt64.t }

type t_PtErr = NoPartitionTable | CorruptTable | InvalidPartition | IoError | LayoutError | NotInitialized

type t_PiOutcome = Ok t_PInfoM | Err t_PtErr | Panic

constant const_MAX: UInt64.t = (18446744073709551615: UInt64.t)

function view_Vec_PInfoM_Global (self: t_Vec_PInfoM_Global) : Seq.seq t_PInfoM

axiom view_Vec_PInfoM_Global_spec:
  forall self: t_Vec_PInfoM_Global [view_Vec_PInfoM_Global self]. [%#svec] Seq.length (view_Vec_PInfoM_Global self)
    <= UInt64.t'int const_MAX

let partition_info_m (loaded: bool) (parts: t_Vec_PInfoM_Global) (poisoned: bool) (idx: UInt32.t)
  (return (x: t_PiOutcome)) = any
  [ return (result: t_PiOutcome) ->
  {[@stop_split] [@expl:partition_info_m ensures] ([@stop_split] [@expl:partition_info_m ensures #0] [%#slib'8] poisoned
      -> result = Panic)
    /\ ([@stop_split] [@expl:partition_info_m ensures #1] [%#slib'9] not poisoned /\ not loaded
      -> result = Err (NotInitialized))
    /\ ([@stop_split] [@expl:partition_info_m ensures #2] [%#slib'10] not poisoned
        /\ loaded /\ UInt32.t'int idx >= Seq.length (view_Vec_PInfoM_Global parts) -> result = Err (InvalidPartition))
    /\ ([@stop_split] [@expl:partition_info_m ensures #3] [%#slib'11] not poisoned
      /\ loaded /\ UInt32.t'int idx < Seq.length (view_Vec_PInfoM_Global parts)
    -> result = Ok (Seq.get (view_Vec_PInfoM_Global parts) (UInt32.t'int idx)))}
    (! return {result}) ]

type t_NpOutcome = Ok'0 UInt32.t | Err'0 t_PtErr | Panic'0

let num_partitions_m (loaded: bool) (parts: t_Vec_PInfoM_Global) (poisoned: bool) (return (x: t_NpOutcome)) =
{[@stop_split] [@expl:num_partitions_m requires] [%#slib'12] Seq.length (view_Vec_PInfoM_Global parts) <= 4294967295}
  any
  [ return (result: t_NpOutcome) ->
  {[@stop_split] [@expl:num_partitions_m ensures] ([@stop_split] [@expl:num_partitions_m ensures #0] [%#slib'13] poisoned
      -> result = Panic'0)
    /\ ([@stop_split] [@expl:num_partitions_m ensures #1] [%#slib'14] not poisoned /\ not loaded
      -> result = Err'0 (NotInitialized))
    /\ ([@stop_split] [@expl:num_partitions_m ensures #2] [%#slib'15] not poisoned /\ loaded
    -> (exists c: UInt32.t. result = Ok'0 c /\ UInt32.t'int c = Seq.length (view_Vec_PInfoM_Global parts)))}
    (! return {result}) ]

type t_TabM = { tag: UInt64.t; count: UInt32.t; sector_size: UInt32.t }

type t_Option_TabM = None | Some t_TabM

type t_ReadRes = Ok'1 t_TabM | Err'1 t_PtErr

type t_Outcome = Ok'2 t_TabM | Err'2 t_PtErr | Panic'2

type tup2_Outcome_Option_TabM = { f0: t_Outcome; f1: t_Option_TabM }

let initialize_m (st: t_Option_TabM) (bound: bool) (geom_ok: bool) (chan_ok: bool) (rd: t_ReadRes) (poisoned: bool)
  (return (x: tup2_Outcome_Option_TabM)) = any
  [ return (result: tup2_Outcome_Option_TabM) ->
  {[@stop_split] [@expl:initialize_m ensures] ([@stop_split] [@expl:initialize_m ensures #0] [%#slib'16] not bound
      -> result.f0 = Err'2 (NotInitialized))
    /\ ([@stop_split] [@expl:initialize_m ensures #1] [%#slib'17] not bound -> result.f1 = st)
    /\ ([@stop_split] [@expl:initialize_m ensures #2] [%#slib'18] bound /\ not geom_ok
      -> result.f0 = Err'2 (IoError) /\ result.f1 = st)
    /\ ([@stop_split] [@expl:initialize_m ensures #3] [%#slib'19] bound /\ geom_ok /\ not chan_ok
      -> result.f0 = Err'2 (IoError) /\ result.f1 = st)
    /\ ([@stop_split] [@expl:initialize_m ensures #4] [%#slib'20] match rd with
        | Err'1 e -> bound /\ geom_ok /\ chan_ok -> result.f0 = Err'2 e /\ result.f1 = st
        | _ -> true
        end)
    /\ ([@stop_split] [@expl:initialize_m ensures #5] [%#slib'21] match rd with
        | Ok'1 t -> bound /\ geom_ok /\ chan_ok /\ poisoned -> result.f0 = Panic'2 /\ result.f1 = st
        | _ -> true
        end)
    /\ ([@stop_split] [@expl:initialize_m ensures #6] [%#slib'22] match rd with
      | Ok'1 t -> bound /\ geom_ok /\ chan_ok /\ not poisoned -> result.f0 = Ok'2 t /\ result.f1 = Some t
      | _ -> true
      end)}
    (! return {result}) ]

type tup3_PiOutcome_NpOutcome_Outcome = { f0'0: t_PiOutcome; f1'0: t_NpOutcome; f2'0: t_Outcome }

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

