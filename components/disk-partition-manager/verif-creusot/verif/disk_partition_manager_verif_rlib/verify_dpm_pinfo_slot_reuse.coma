    = (Seq.get (view_Vec_PInfoM_Global b) (UInt32.t'int idx)).index)
  /\ ([@stop_split] [@expl:verify_dpm_pinfo_slot_reuse requires #2] [%#slib'7] (Seq.get (view_Vec_PInfoM_Global a) (UInt32.t'int idx)).start_lba
  <> (Seq.get (view_Vec_PInfoM_Global b) (UInt32.t'int idx)).start_lba)}
