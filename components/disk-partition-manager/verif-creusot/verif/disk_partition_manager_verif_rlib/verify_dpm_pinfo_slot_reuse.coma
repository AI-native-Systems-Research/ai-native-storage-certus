  [ bb0 = s0
    [ s0 = partition_info_m [%#slib'1] {[%#slib] true} {a} {[%#slib'0] false} {idx}
        (fun (_x: t_PiOutcome) -> [ &_17 <- _x ] s1)
    | s1 = partition_info_m [%#slib'4] {[%#slib'2] true} {b} {[%#slib'3] false} {idx}
        (fun (_x: t_PiOutcome) -> [ &_20 <- _x ] s2)
    | s2 = [ &_ret <- { f0 = _17; f1 = _20 } ] s3
    | s3 = return {_ret} ] ]
  [ & _ret: tup2_PiOutcome_PiOutcome = Any.any_l ()
  | & a: t_Vec_PInfoM_Global = a
  | & b: t_Vec_PInfoM_Global = b
  | & idx: UInt32.t = idx
  | & _17: t_PiOutcome = Any.any_l ()
  | & _20: t_PiOutcome = Any.any_l () ])
  [ return (result: tup2_PiOutcome_PiOutcome) ->
  {[@stop_split] [@expl:verify_dpm_pinfo_slot_reuse ensures] [%#slib'8] match result.f0 with
      | Ok p -> match result.f1 with
        | Ok q -> p.index = q.index /\ p.start_lba <> q.start_lba
