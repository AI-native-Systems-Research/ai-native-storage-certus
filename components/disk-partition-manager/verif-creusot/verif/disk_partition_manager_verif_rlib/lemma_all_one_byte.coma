use creusot.int.UInt64
use seq.Seq
use int.EuclideanDivision
use int.Int

type t_SpecM = { size_bytes: UInt64.t; tg_zero: bool }

function rest_count_l [#"/home/cornel/cv-disk-partition-manager-20260930/components/disk-partition-manager/verif-creusot/src/lib.rs" 214 0 214 49] (s: Seq.seq t_SpecM) (n: int) : int

axiom rest_count_l_def: forall s: Seq.seq t_SpecM, n: int [rest_count_l s n]. ([%#slib'5] 0 <= n /\ n <= Seq.length s)
    -> rest_count_l s n
    = ([%#slib'6] if n = 0 then
      0
    else
      rest_count_l s (n - 1) + (if UInt64.t'int (Seq.get s (n - 1)).size_bytes = 0 then 1 else 0)
    )

function cdiv [#"/home/cornel/cv-disk-partition-manager-20260930/components/disk-partition-manager/verif-creusot/src/lib.rs" 57 0 57 34] (n: int) (d: int) : int
 = [%#slib'10] EuclideanDivision.div n d + (if EuclideanDivision.mod n d = 0 then 0 else 1)

function fixed_sum_l [#"/home/cornel/cv-disk-partition-manager-20260930/components/disk-partition-manager/verif-creusot/src/lib.rs" 227 0 227 57] (s: Seq.seq t_SpecM) (n: int) (ss: int) : int

axiom fixed_sum_l_def: forall s: Seq.seq t_SpecM, n: int, ss: int [fixed_sum_l s n ss]. ([%#slib'8] 0 <= n
      /\ n <= Seq.length s)
    -> fixed_sum_l s n ss
    = ([%#slib'9] if n = 0 then
      0
    else
      fixed_sum_l s (n - 1) ss
      + (if UInt64.t'int (Seq.get s (n - 1)).size_bytes > 0 then
        cdiv (UInt64.t'int (Seq.get s (n - 1)).size_bytes) ss
      else
        0
      )
    )

predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
  [%#swell_founded] self >= 0 /\ self > other

meta "rewrite_def" predicate well_founded_relation_Int

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

