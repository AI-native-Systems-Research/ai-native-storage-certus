    -> ([@stop_split] [@expl:lemma_all_one_byte ensures] ([@stop_split] [@expl:lemma_all_one_byte ensures #0] [%#slib'2] rest_count_l s n
      = 0)
    /\ ([@stop_split] [@expl:lemma_all_one_byte ensures #1] [%#slib'3] fixed_sum_l s n 512 = n)))
  else
    [@stop_split] [@expl:lemma_all_one_byte ensures] ([@stop_split] [@expl:lemma_all_one_byte ensures #0] [%#slib'2] rest_count_l s n
      = 0)
    /\ ([@stop_split] [@expl:lemma_all_one_byte ensures #1] [%#slib'3] fixed_sum_l s n 512 = n)
