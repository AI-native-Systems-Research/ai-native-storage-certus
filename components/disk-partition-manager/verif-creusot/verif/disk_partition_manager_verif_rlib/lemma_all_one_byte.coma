constant n : int

function lemma_all_one_byte [#"/home/cornel/cv-disk-partition-manager-20260930/components/disk-partition-manager/verif-creusot/src/lib.rs" 1906 0 1906 48] (s: Seq.seq t_SpecM) (n: int) : ()

goal vc_lemma_all_one_byte: ([%#slib'0] 0 <= n /\ n <= Seq.length s)
  -> ([%#slib'1] forall k: int. 0 <= k /\ k < n -> UInt64.t'int (Seq.get s k).size_bytes = 1)
  -> (if n > 0 then
    (([@stop_split] [@expl:lemma_all_one_byte requires] ([@stop_split] [@expl:lemma_all_one_byte requires #0] [%#slib'0] 0
            <= n - 1
          /\ n - 1 <= Seq.length s)
        /\ ([@stop_split] [@expl:lemma_all_one_byte requires #1] [%#slib'1] forall k: int. 0 <= k /\ k < n - 1
          -> UInt64.t'int (Seq.get s k).size_bytes = 1))
      /\ ([@expl:variant decreases] well_founded_relation_Int ([%#slib] n) ([%#slib] n - 1)))
    /\ (([@stop_split] [@expl:lemma_all_one_byte ensures] ([@stop_split] [@expl:lemma_all_one_byte ensures #0] [%#slib'2] rest_count_l s (n
