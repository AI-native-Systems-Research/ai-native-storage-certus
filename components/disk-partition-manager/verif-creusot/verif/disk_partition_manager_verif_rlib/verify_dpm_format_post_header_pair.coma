    /\ ([@stop_split] [@expl:header_pair ensures #4] [%#slib'12] UInt64.t'int result.f0.my_lba = 1
      /\ UInt64.t'int result.f0.alternate_lba = UInt64.t'int ns - 1)
    /\ ([@stop_split] [@expl:header_pair ensures #5] [%#slib'13] UInt64.t'int result.f0.partition_entry_lba = 2)
    /\ ([@stop_split] [@expl:header_pair ensures #6] [%#slib'14] UInt64.t'int result.f0.first_usable_lba
      = first_usable_l (UInt32.t'int ss))
    /\ ([@stop_split] [@expl:header_pair ensures #7] [%#slib'15] UInt64.t'int result.f0.last_usable_lba
      = last_usable_l (UInt32.t'int ss) (UInt64.t'int ns))
    /\ ([@stop_split] [@expl:header_pair ensures #8] [%#slib'16] UInt64.t'int result.f1.my_lba = UInt64.t'int ns - 1
      /\ UInt64.t'int result.f1.alternate_lba = 1)
    /\ ([@stop_split] [@expl:header_pair ensures #9] [%#slib'17] UInt64.t'int result.f1.partition_entry_lba
      = backup_entry_lba_write_l (UInt32.t'int ss) (UInt64.t'int ns))
    /\ ([@stop_split] [@expl:header_pair ensures #10] [%#slib'18] result.f1.signature = result.f0.signature
      /\ result.f1.revision = result.f0.revision)
    /\ ([@stop_split] [@expl:header_pair ensures #11] [%#slib'19] result.f1.header_size = result.f0.header_size)
    /\ ([@stop_split] [@expl:header_pair ensures #12] [%#slib'20] result.f1.first_usable_lba
      = result.f0.first_usable_lba)
    /\ ([@stop_split] [@expl:header_pair ensures #13] [%#slib'21] result.f1.last_usable_lba = result.f0.last_usable_lba)
    /\ ([@stop_split] [@expl:header_pair ensures #14] [%#slib'22] result.f1.num_partition_entries
      = result.f0.num_partition_entries)
    /\ ([@stop_split] [@expl:header_pair ensures #15] [%#slib'23] result.f1.partition_entry_size
      = result.f0.partition_entry_size)
    /\ ([@stop_split] [@expl:header_pair ensures #16] [%#slib'24] result.f1.partition_entry_crc32
    = result.f0.partition_entry_crc32)}
    (! return {result}) ]

