use creusot.int.UInt64
use creusot.int.UInt32
use creusot.prelude.Any

type t_TabM = { tag: UInt64.t; count: UInt32.t; sector_size: UInt32.t }

type t_Attempt = Ok t_TabM | Corrupt | NoTable | Io

type t_PtErr = NoPartitionTable | CorruptTable | InvalidPartition | IoError | LayoutError | NotInitialized

type t_ReadRes = Ok'0 t_TabM | Err'0 t_PtErr

let elim_Ok (_x: t_Attempt) (return (f0: t_TabM)) = any
  [ _k (f0: t_TabM) -> {Ok f0 = _x} (! return {f0})
  | _chk -> (! {[@expl:elim Ok] match _x with
      | Ok _ -> true
      | _ -> false
      end}
    any) ]

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let read_gpt_m [#"/home/cornel/fv-runs/j13-dpm/components/disk-partition-manager/verif-creusot/src/lib.rs" 1098 0 1098 63]
  (primary: t_Attempt) (backup: t_Attempt) (return (x: t_ReadRes)) = (! bb0
  [ bb0 = any
    [ br0 (x0: t_TabM) -> {primary = Ok x0} (! bb8)
    | br1 -> {primary = Corrupt} (! bb9)
    | br2 -> {primary = NoTable} (! bb9)
    | br3 -> {primary = Io} (! bb5) ]
  | bb5 = s0 [ s0 = [ &_19 <- IoError ] s1 | s1 = [ &_ret <- Err'0 _19 ] s2 | s2 = return {_ret} ]
  | bb9 = any
    [ br0 (x0: t_TabM) -> {backup = Ok x0} (! bb17)
    | br1 -> {backup = Corrupt} (! bb16)
    | br2 -> {backup = NoTable} (! bb15)
    | br3 -> {backup = Io} (! bb14) ]
  | bb14 = s0 [ s0 = [ &_25 <- NoPartitionTable ] s1 | s1 = [ &_ret <- Err'0 _25 ] s2 | s2 = return {_ret} ]
  | bb15 = s0 [ s0 = [ &_24 <- NoPartitionTable ] s1 | s1 = [ &_ret <- Err'0 _24 ] s2 | s2 = return {_ret} ]
  | bb16 = s0 [ s0 = [ &_23 <- NoPartitionTable ] s1 | s1 = [ &_ret <- Err'0 _23 ] s2 | s2 = return {_ret} ]
  | bb17 = s0
    [ s0 = elim_Ok {backup} (fun (r0: t_TabM) -> [ &t'0 <- r0 ] s1)
    | s1 = [ &_ret <- Ok'0 t'0 ] s2
    | s2 = return {_ret} ]
  | bb8 = s0
    [ s0 = elim_Ok {primary} (fun (r0: t_TabM) -> [ &t <- r0 ] s1)
    | s1 = [ &_ret <- Ok'0 t ] s2
    | s2 = return {_ret} ] ]
  [ & _ret: t_ReadRes = Any.any_l ()
  | & primary: t_Attempt = primary
  | & backup: t_Attempt = backup
  | & t: t_TabM = Any.any_l ()
  | & _19: t_PtErr = Any.any_l ()
  | & t'0: t_TabM = Any.any_l ()
  | & _23: t_PtErr = Any.any_l ()
  | & _24: t_PtErr = Any.any_l ()
  | & _25: t_PtErr = Any.any_l () ])
  [ return (result: t_ReadRes) ->
  {[@stop_split] [@expl:read_gpt_m ensures] ([@stop_split] [@expl:read_gpt_m ensures #0] [%#slib] match primary with
        | Ok t -> result = Ok'0 t
        | _ -> true
        end)
    /\ ([@stop_split] [@expl:read_gpt_m ensures #1] [%#slib'0] match primary with
        | Io -> result = Err'0 (IoError)
        | _ -> true
        end)
    /\ ([@stop_split] [@expl:read_gpt_m ensures #2] [%#slib'1] match primary with
        | Corrupt -> match backup with
          | Ok t -> result = Ok'0 t
          | _ -> result = Err'0 (NoPartitionTable)
          end
        | _ -> true
        end)
    /\ ([@stop_split] [@expl:read_gpt_m ensures #3] [%#slib'2] match primary with
      | NoTable -> match backup with
        | Ok t -> result = Ok'0 t
        | _ -> result = Err'0 (NoPartitionTable)
        end
      | _ -> true
      end)}
    (! return {result}) ]
