use creusot.int.UInt32
use creusot.int.UInt64
use seq.Seq
use int.EuclideanDivision
use creusot.prelude.Any
use int.Int

type t_Vec_SpecM_Global

type t_LayoutErr = MultiRest | Capacity | PerPartition

type t_Result_u64_LayoutErr = Ok UInt64.t | Err t_LayoutErr

type t_SpecM = { size_bytes: UInt64.t; tg_zero: bool }

function cdiv [#"/home/cornel/cv-disk-partition-manager-20260930/components/disk-partition-manager/verif-creusot/src/lib.rs" 57 0 57 34] (n: int) (d: int) : int
 = [%#slib'17] EuclideanDivision.div n d + (if EuclideanDivision.mod n d = 0 then 0 else 1)

function fixed_sum_l [#"/home/cornel/cv-disk-partition-manager-20260930/components/disk-partition-manager/verif-creusot/src/lib.rs" 227 0 227 57] (s: Seq.seq t_SpecM) (n: int) (ss: int) : int

axiom fixed_sum_l_def: forall s: Seq.seq t_SpecM, n: int, ss: int [fixed_sum_l s n ss]. ([%#slib'12] 0 <= n
      /\ n <= Seq.length s)
    -> fixed_sum_l s n ss
