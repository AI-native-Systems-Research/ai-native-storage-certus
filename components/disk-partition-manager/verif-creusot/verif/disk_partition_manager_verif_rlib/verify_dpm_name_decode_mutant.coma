type t_Vec_u16_Global

predicate inv_Seq_u8 [@inline:trivial] (_1: Seq.seq UInt8.t) = true

meta "rewrite_def" predicate inv_Seq_u8

predicate invariant_array_u8_72 (self: Slice64.array UInt8.t) =
  [%#sarray'0] inv_Seq_u8 (Slice64.view self) /\ Seq.length (Slice64.view self) = UInt64.t'int (72: UInt64.t)

predicate inv_array_u8_72 [@inline:trivial] (_1: Slice64.array UInt8.t) = invariant_array_u8_72 _1

meta "rewrite_def" predicate inv_array_u8_72

predicate invariant_ref_array_u8_72 [@inline:trivial] (self: Slice64.array UInt8.t) =
  [%#sinvariant] inv_array_u8_72 self

meta "rewrite_def" predicate invariant_ref_array_u8_72

predicate inv_ref_array_u8_72 [@inline:trivial] (_1: Slice64.array UInt8.t) = invariant_ref_array_u8_72 _1

meta "rewrite_def" predicate inv_ref_array_u8_72

constant const_MAX: UInt64.t = (18446744073709551615: UInt64.t)

function view_Vec_u16_Global (self: t_Vec_u16_Global) : Seq.seq UInt16.t

axiom view_Vec_u16_Global_spec:
  forall self: t_Vec_u16_Global [view_Vec_u16_Global self]. [%#svec] Seq.length (view_Vec_u16_Global self)
    <= UInt64.t'int const_MAX

function index_array_u8_72 [@inline:trivial] (self: Slice64.array UInt8.t) (ix: int) : UInt8.t =
  [%#sarray] Seq.get (Slice64.view self) ix

meta "rewrite_def" function index_array_u8_72

let decode_units (data: Slice64.array UInt8.t) (return (x: t_Vec_u16_Global)) =
{[@stop_split] [@expl:decode_units 'data' type invariant] [%#slib'2] inv_ref_array_u8_72 data}
  any
  [ return (result: t_Vec_u16_Global) ->
  {[@stop_split] [@expl:decode_units ensures] ([@stop_split] [@expl:decode_units ensures #0] [%#slib'3] Seq.length (view_Vec_u16_Global result)
      <= 36)
    /\ ([@stop_split] [@expl:decode_units ensures #1] [%#slib'4] forall k: int. 0 <= k
          /\ k < Seq.length (view_Vec_u16_Global result)
        -> UInt16.t'int (Seq.get (view_Vec_u16_Global result) k)
        = UInt8.t'int (index_array_u8_72 data (2 * k)) + 256 * UInt8.t'int (index_array_u8_72 data (2 * k + 1)))
    /\ ([@stop_split] [@expl:decode_units ensures #2] [%#slib'5] forall k: int. 0 <= k
          /\ k < Seq.length (view_Vec_u16_Global result) -> UInt16.t'int (Seq.get (view_Vec_u16_Global result) k) <> 0)
    /\ ([@stop_split] [@expl:decode_units ensures #3] [%#slib'6] Seq.length (view_Vec_u16_Global result) < 36
      -> UInt8.t'int (index_array_u8_72 data (2 * Seq.length (view_Vec_u16_Global result)))
        + 256 * UInt8.t'int (index_array_u8_72 data (2 * Seq.length (view_Vec_u16_Global result) + 1))
      = 0)
    /\ ([@stop_split] [@expl:decode_units ensures #4] [%#slib'7] forall m: int. 0 <= m
          /\ m < 36
          /\ (forall k: int. 0 <= k /\ k < m
              -> UInt8.t'int (index_array_u8_72 data (2 * k)) + 256 * UInt8.t'int (index_array_u8_72 data (2 * k + 1))
              <> 0)
          /\ UInt8.t'int (index_array_u8_72 data (2 * m)) + 256 * UInt8.t'int (index_array_u8_72 data (2 * m + 1)) = 0
        -> Seq.length (view_Vec_u16_Global result) = m)
    /\ ([@stop_split] [@expl:decode_units ensures #5] [%#slib'8] (forall k: int. 0 <= k /\ k < 36
        -> UInt8.t'int (index_array_u8_72 data (2 * k)) + 256 * UInt8.t'int (index_array_u8_72 data (2 * k + 1)) <> 0)
    -> Seq.length (view_Vec_u16_Global result) = 36)}
    (! return {result}) ]

