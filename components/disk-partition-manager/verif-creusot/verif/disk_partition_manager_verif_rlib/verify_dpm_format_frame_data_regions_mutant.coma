use creusot.int.UInt32
use creusot.int.UInt64
use int.EuclideanDivision
use seq.Seq
use creusot.prelude.Any
use int.Int

type t_Vec_Acc_Global

function cdiv [#"/home/cornel/fv-runs/apply-disk-partition-manager-20261007/components/disk-partition-manager/verif-creusot/src/lib.rs" 57 0 57 34] (n: int) (d: int) : int
 = [%#slib'20] EuclideanDivision.div n d + (if EuclideanDivision.mod n d = 0 then 0 else 1)

function entry_sectors_l [#"/home/cornel/fv-runs/apply-disk-partition-manager-20261007/components/disk-partition-manager/verif-creusot/src/lib.rs" 84 0 84 38] (ss: int) : int
 = [%#slib'23] cdiv 16384 ss

type t_Acc = { is_write: bool; ns: UInt32.t; lba: UInt64.t; sectors: UInt64.t }

constant const_MAX: UInt64.t = (18446744073709551615: UInt64.t)

function view_Vec_Acc_Global (self: t_Vec_Acc_Global) : Seq.seq t_Acc

axiom view_Vec_Acc_Global_spec:
  forall self: t_Vec_Acc_Global [view_Vec_Acc_Global self]. [%#svec] Seq.length (view_Vec_Acc_Global self)
    <= UInt64.t'int const_MAX

function last_usable_l [#"/home/cornel/fv-runs/apply-disk-partition-manager-20261007/components/disk-partition-manager/verif-creusot/src/lib.rs" 687 0 687 45] (ss: int) (ns'0: int) : int
 = [%#slib'19] ns'0 - 1 - entry_sectors_l ss - 1

function backup_entry_lba_write_l [#"/home/cornel/fv-runs/apply-disk-partition-manager-20261007/components/disk-partition-manager/verif-creusot/src/lib.rs" 693 0 693 56] (ss: int) (ns'0: int) : int
 = [%#slib'24] last_usable_l ss ns'0 + 1

predicate all_ns [#"/home/cornel/fv-runs/apply-disk-partition-manager-20261007/components/disk-partition-manager/verif-creusot/src/lib.rs" 131 0 131 39] (t: Seq.seq t_Acc) (n: int) =
  [%#slib'21] forall i: int. 0 <= i /\ i < Seq.length t -> UInt32.t'int (Seq.get t i).ns = n

let write_gpt_trace (ns'0: UInt32.t) (ss: UInt32.t) (ns_sectors: UInt64.t) (return (x: t_Vec_Acc_Global)) =
{[@stop_split] [@expl:write_gpt_trace requires] ([@stop_split] [@expl:write_gpt_trace requires #0] [%#slib'9] UInt32.t'int ss
      = 512
    \/ UInt32.t'int ss = 4096)
  /\ ([@stop_split] [@expl:write_gpt_trace requires #1] [%#slib'10] UInt64.t'int ns_sectors
  >= 2 * entry_sectors_l (UInt32.t'int ss) + 4)}
  any
  [ return (result: t_Vec_Acc_Global) ->
  {[@stop_split] [@expl:write_gpt_trace ensures] ([@stop_split] [@expl:write_gpt_trace ensures #0] [%#slib'11] Seq.length (view_Vec_Acc_Global result)
      = 5)
    /\ ([@stop_split] [@expl:write_gpt_trace ensures #1] [%#slib'12] (Seq.get (view_Vec_Acc_Global result) 0).is_write
      /\ UInt64.t'int (Seq.get (view_Vec_Acc_Global result) 0).lba = 0
      /\ UInt64.t'int (Seq.get (view_Vec_Acc_Global result) 0).sectors = 1)
    /\ ([@stop_split] [@expl:write_gpt_trace ensures #2] [%#slib'13] (Seq.get (view_Vec_Acc_Global result) 1).is_write
      /\ UInt64.t'int (Seq.get (view_Vec_Acc_Global result) 1).lba = 1
      /\ UInt64.t'int (Seq.get (view_Vec_Acc_Global result) 1).sectors = 1)
    /\ ([@stop_split] [@expl:write_gpt_trace ensures #3] [%#slib'14] (Seq.get (view_Vec_Acc_Global result) 2).is_write
      /\ UInt64.t'int (Seq.get (view_Vec_Acc_Global result) 2).lba = 2
      /\ UInt64.t'int (Seq.get (view_Vec_Acc_Global result) 2).sectors = entry_sectors_l (UInt32.t'int ss))
    /\ ([@stop_split] [@expl:write_gpt_trace ensures #4] [%#slib'15] (Seq.get (view_Vec_Acc_Global result) 3).is_write
      /\ UInt64.t'int (Seq.get (view_Vec_Acc_Global result) 3).lba
        = backup_entry_lba_write_l (UInt32.t'int ss) (UInt64.t'int ns_sectors)
      /\ UInt64.t'int (Seq.get (view_Vec_Acc_Global result) 3).sectors = entry_sectors_l (UInt32.t'int ss))
    /\ ([@stop_split] [@expl:write_gpt_trace ensures #5] [%#slib'16] (Seq.get (view_Vec_Acc_Global result) 4).is_write
      /\ UInt64.t'int (Seq.get (view_Vec_Acc_Global result) 4).lba = UInt64.t'int ns_sectors - 1
      /\ UInt64.t'int (Seq.get (view_Vec_Acc_Global result) 4).sectors = 1)
    /\ ([@stop_split] [@expl:write_gpt_trace ensures #6] [%#slib'17] all_ns (view_Vec_Acc_Global result) (UInt32.t'int ns'0))}
    (! return {result}) ]

function first_usable_l [#"/home/cornel/fv-runs/apply-disk-partition-manager-20261007/components/disk-partition-manager/verif-creusot/src/lib.rs" 681 0 681 37] (ss: int) : int
 = [%#slib'18] 2 + entry_sectors_l ss

predicate touches [#"/home/cornel/fv-runs/apply-disk-partition-manager-20261007/components/disk-partition-manager/verif-creusot/src/lib.rs" 118 0 118 38] (a: t_Acc) (l: int) =
  [%#slib'25] UInt64.t'int a.lba <= l /\ l < UInt64.t'int a.lba + UInt64.t'int a.sectors

predicate writes_avoid [#"/home/cornel/fv-runs/apply-disk-partition-manager-20261007/components/disk-partition-manager/verif-creusot/src/lib.rs" 136 0 136 55] (t: Seq.seq t_Acc) (lo: int) (hi: int) =
  [%#slib'22] forall i: int, l: int. 0 <= i /\ i < Seq.length t /\ (Seq.get t i).is_write /\ touches (Seq.get t i) l
    -> l < lo \/ hi < l

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let verify_dpm_format_frame_data_regions__mutant [#"/home/cornel/fv-runs/apply-disk-partition-manager-20261007/components/disk-partition-manager/verif-creusot/src/lib.rs" 2279 0 2279 98]
  (ns'0: UInt32.t) (ss: UInt32.t) (ns_sectors: UInt64.t) (return (x: t_Vec_Acc_Global)) =
{[@stop_split] [@expl:verify_dpm_format_frame_data_regions__mutant requires] ([@stop_split] [@expl:verify_dpm_format_frame_data_regions__mutant requires #0] [%#slib'4] UInt32.t'int ss
      = 512
    \/ UInt32.t'int ss = 4096)
  /\ ([@stop_split] [@expl:verify_dpm_format_frame_data_regions__mutant requires #1] [%#slib'5] UInt64.t'int ns_sectors
  >= 2 * cdiv 16384 (UInt32.t'int ss) + 5)}
  (! bb0
  [ bb0 = s0
    [ s0 = write_gpt_trace [%#slib] {ns'0} {ss} {ns_sectors} (fun (_x: t_Vec_Acc_Global) -> [ &t <- _x ] s1)
    | s1 = {[@expl:assertion] [%#slib'0] UInt64.t'int (Seq.get (view_Vec_Acc_Global t) 0).lba
        < first_usable_l (UInt32.t'int ss)
      /\ UInt64.t'int (Seq.get (view_Vec_Acc_Global t) 1).lba < first_usable_l (UInt32.t'int ss)}
      s2
    | s2 = {[@expl:assertion] [%#slib'1] UInt64.t'int (Seq.get (view_Vec_Acc_Global t) 2).lba
        + UInt64.t'int (Seq.get (view_Vec_Acc_Global t) 2).sectors
      = first_usable_l (UInt32.t'int ss)}
      s3
    | s3 = {[@expl:assertion] [%#slib'2] UInt64.t'int (Seq.get (view_Vec_Acc_Global t) 3).lba
      = last_usable_l (UInt32.t'int ss) (UInt64.t'int ns_sectors) + 1}
      s4
    | s4 = {[@expl:assertion] [%#slib'3] UInt64.t'int (Seq.get (view_Vec_Acc_Global t) 4).lba
      > last_usable_l (UInt32.t'int ss) (UInt64.t'int ns_sectors)}
      s5
    | s5 = [ &_ret <- t ] s6
    | s6 = return {_ret} ] ]
  [ & _ret: t_Vec_Acc_Global = Any.any_l ()
  | & ns'0: UInt32.t = ns'0
  | & ss: UInt32.t = ss
  | & ns_sectors: UInt64.t = ns_sectors
  | & t: t_Vec_Acc_Global = Any.any_l () ])
  [ return (result: t_Vec_Acc_Global) ->
  {[@stop_split] [@expl:verify_dpm_format_frame_data_regions__mutant ensures] ([@stop_split] [@expl:verify_dpm_format_frame_data_regions__mutant ensures #0] [%#slib'6] not Seq.length (view_Vec_Acc_Global result)
      = 5)
    /\ ([@stop_split] [@expl:verify_dpm_format_frame_data_regions__mutant ensures #1] [%#slib'7] all_ns (view_Vec_Acc_Global result) (UInt32.t'int ns'0))
    /\ ([@stop_split] [@expl:verify_dpm_format_frame_data_regions__mutant ensures #2] [%#slib'8] writes_avoid (view_Vec_Acc_Global result) (first_usable_l (UInt32.t'int ss)) (last_usable_l (UInt32.t'int ss) (UInt64.t'int ns_sectors)))}
    (! return {result}) ]
