use creusot.int.UInt64
use seq.Seq
use int.Int

type t_SpecM = { size_bytes: UInt64.t; tg_zero: bool }

function rest_count_l [#"/home/cornel/fv-runs/j13-dpm/components/disk-partition-manager/verif-creusot/src/lib.rs" 214 0 214 49] (s: Seq.seq t_SpecM) (n: int) : int

axiom rest_count_l_def: forall s: Seq.seq t_SpecM, n: int [rest_count_l s n]. ([%#slib'4] 0 <= n /\ n <= Seq.length s)
    -> rest_count_l s n
    = ([%#slib'5] if n = 0 then
      0
    else
      rest_count_l s (n - 1) + (if UInt64.t'int (Seq.get s (n - 1)).size_bytes = 0 then 1 else 0)
    )

predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
  [%#swell_founded] self >= 0 /\ self > other

meta "rewrite_def" predicate well_founded_relation_Int

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant s : Seq.seq t_SpecM

constant n : int

function lemma_rest_count_nonneg [#"/home/cornel/fv-runs/j13-dpm/components/disk-partition-manager/verif-creusot/src/lib.rs" 305 0 305 53] (s: Seq.seq t_SpecM) (n: int) : ()

goal vc_lemma_rest_count_nonneg: ([%#slib'0] 0 <= n /\ n <= Seq.length s)
  -> (if n > 0 then
    (([@stop_split] [@expl:lemma_rest_count_nonneg requires] [%#slib'0] 0 <= n - 1 /\ n - 1 <= Seq.length s)
      /\ ([@expl:variant decreases] well_founded_relation_Int ([%#slib] n) ([%#slib] n - 1)))
    /\ (([@stop_split] [@expl:lemma_rest_count_nonneg ensures] ([@stop_split] [@expl:lemma_rest_count_nonneg ensures #0] [%#slib'1] rest_count_l s (n
          - 1)
        >= 0)
      /\ ([@stop_split] [@expl:lemma_rest_count_nonneg ensures #1] [%#slib'2] rest_count_l s (n - 1) <= n - 1))
    -> ([@stop_split] [@expl:lemma_rest_count_nonneg ensures] ([@stop_split] [@expl:lemma_rest_count_nonneg ensures #0] [%#slib'1] rest_count_l s n
      >= 0)
    /\ ([@stop_split] [@expl:lemma_rest_count_nonneg ensures #1] [%#slib'2] rest_count_l s n <= n)))
  else
    [@stop_split] [@expl:lemma_rest_count_nonneg ensures] ([@stop_split] [@expl:lemma_rest_count_nonneg ensures #0] [%#slib'1] rest_count_l s n
      >= 0)
    /\ ([@stop_split] [@expl:lemma_rest_count_nonneg ensures #1] [%#slib'2] rest_count_l s n <= n)
  )
