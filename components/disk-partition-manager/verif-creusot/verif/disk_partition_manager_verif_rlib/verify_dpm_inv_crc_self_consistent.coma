    /\ UInt8.t'int (Seq.get (Seq.create (UInt32.t'int ss) bytes) 18) = 0
    /\ UInt8.t'int (Seq.get (Seq.create (UInt32.t'int ss) bytes) 19) = 0))
  /\ (([@stop_split] [@expl:lemma_crc_field_roundtrip ensures] [%#slib'4] Seq.(==) (set4 (set4 (Seq.create (UInt32.t'int ss) bytes) 16 b0 b1 b2 b3) 16 (0: UInt8.t) (0: UInt8.t) (0: UInt8.t) (0: UInt8.t)) (Seq.create (UInt32.t'int ss) bytes))
