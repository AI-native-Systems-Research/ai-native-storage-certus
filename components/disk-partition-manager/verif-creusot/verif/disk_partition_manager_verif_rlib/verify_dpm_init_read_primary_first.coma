type t_TabM = { tag: UInt64.t; count: UInt32.t; sector_size: UInt32.t }

type t_Attempt = Ok t_TabM | Corrupt | NoTable | Io

type t_PtErr = NoPartitionTable | CorruptTable | InvalidPartition | IoError | LayoutError | NotInitialized

type t_ReadRes = Ok'0 t_TabM | Err'0 t_PtErr

let read_gpt_m (primary: t_Attempt) (backup: t_Attempt) (return (x: t_ReadRes)) = any
  [ return (result: t_ReadRes) ->
  {[@stop_split] [@expl:read_gpt_m ensures] ([@stop_split] [@expl:read_gpt_m ensures #0] [%#slib'17] match primary with
        | Ok t -> result = Ok'0 t
        | _ -> true
