    /\ ([@stop_split] [@expl:read_gpt_m ensures #1] [%#slib'18] match primary with
        | Io -> result = Err'0 (IoError)
        | _ -> true
        end)
    /\ ([@stop_split] [@expl:read_gpt_m ensures #2] [%#slib'19] match primary with
        | Corrupt -> match backup with
          | Ok t -> result = Ok'0 t
          | _ -> result = Err'0 (NoPartitionTable)
          end
        | _ -> true
        end)
    /\ ([@stop_split] [@expl:read_gpt_m ensures #3] [%#slib'20] match primary with
      | NoTable -> match backup with
        | Ok t -> result = Ok'0 t
        | _ -> result = Err'0 (NoPartitionTable)
        end
      | _ -> true
      end)}
    (! return {result}) ]

type tup2_Vec_Acc_Global_ReadRes = { f0: t_Vec_Acc_Global; f1: t_ReadRes }

