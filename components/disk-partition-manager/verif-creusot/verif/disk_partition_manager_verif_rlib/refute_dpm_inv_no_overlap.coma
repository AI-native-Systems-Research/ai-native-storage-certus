function occupied_l [#"/home/cornel/fv-runs/apply-disk-partition-manager-20261007/components/disk-partition-manager/verif-creusot/src/lib.rs" 599 0 599 48] (s: Seq.seq t_EntryM) (n: int) : int

axiom occupied_l_def: forall s: Seq.seq t_EntryM, n: int [occupied_l s n]. ([%#slib'17] 0 <= n /\ n <= Seq.length s)
    -> occupied_l s n
    = ([%#slib'18] if n = 0 then 0 else occupied_l s (n - 1) + (if (Seq.get s (n - 1)).tg_zero then 0 else 1))

let project (entries: t_Vec_EntryM_Global) (return (x: t_Vec_PInfoM_Global)) =
