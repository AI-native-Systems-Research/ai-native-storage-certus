    -> UInt64.t'int (Seq.get (view_Vec_EntryM_Global entries) j).end'
      - UInt64.t'int (Seq.get (view_Vec_EntryM_Global entries) j).start
    < 18446744073709551615)}
  any
  [ return (result: t_Vec_PInfoM_Global) ->
  {[@stop_split] [@expl:project ensures] ([@stop_split] [@expl:project ensures #0] [%#slib'12] Seq.length (view_Vec_PInfoM_Global result)
      = occupied_l (view_Vec_EntryM_Global entries) (Seq.length (view_Vec_EntryM_Global entries)))
    /\ ([@stop_split] [@expl:project ensures #1] [%#slib'13] forall j: int. 0 <= j
          /\ j < Seq.length (view_Vec_EntryM_Global entries) /\ not (Seq.get (view_Vec_EntryM_Global entries) j).tg_zero
        -> UInt32.t'int (Seq.get (view_Vec_PInfoM_Global result) (occupied_l (view_Vec_EntryM_Global entries) j)).index
        = j)
    /\ ([@stop_split] [@expl:project ensures #2] [%#slib'14] forall j: int. 0 <= j
          /\ j < Seq.length (view_Vec_EntryM_Global entries) /\ not (Seq.get (view_Vec_EntryM_Global entries) j).tg_zero
        -> UInt64.t'int (Seq.get (view_Vec_PInfoM_Global result) (occupied_l (view_Vec_EntryM_Global entries) j)).start_lba
        = UInt64.t'int (Seq.get (view_Vec_EntryM_Global entries) j).start)
    /\ ([@stop_split] [@expl:project ensures #3] [%#slib'15] forall j: int. 0 <= j
