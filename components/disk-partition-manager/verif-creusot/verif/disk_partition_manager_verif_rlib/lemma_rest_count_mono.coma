use creusot.int.UInt64
use seq.Seq
use int.Int

type t_SpecM = { size_bytes: UInt64.t; tg_zero: bool }

function rest_count_l [#"/home/cornel/cv-disk-partition-manager-20260930/components/disk-partition-manager/verif-creusot/src/lib.rs" 214 0 214 49] (s: Seq.seq t_SpecM) (n: int) : int

axiom rest_count_l_def: forall s: Seq.seq t_SpecM, n: int [rest_count_l s n]. ([%#slib'3] 0 <= n /\ n <= Seq.length s)
    -> rest_count_l s n
    = ([%#slib'4] if n = 0 then
      0
    else
      rest_count_l s (n - 1) + (if UInt64.t'int (Seq.get s (n - 1)).size_bytes = 0 then 1 else 0)
    )

predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
  [%#swell_founded] self >= 0 /\ self > other

meta "rewrite_def" predicate well_founded_relation_Int

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant s : Seq.seq t_SpecM

constant j : int

constant k : int

function lemma_rest_count_mono [#"/home/cornel/cv-disk-partition-manager-20260930/components/disk-partition-manager/verif-creusot/src/lib.rs" 314 0 314 59] (s: Seq.seq t_SpecM) (j: int) (k: int) : ()

goal vc_lemma_rest_count_mono: ([%#slib'0] 0 <= j /\ j <= k /\ k <= Seq.length s)
  -> (if j < k then
    (([@stop_split] [@expl:lemma_rest_count_mono requires] [%#slib'0] 0 <= j /\ j <= k - 1 /\ k - 1 <= Seq.length s)
      /\ ([@expl:variant decreases] well_founded_relation_Int ([%#slib] k - j) ([%#slib] k - 1 - j)))
    /\ (([@stop_split] [@expl:lemma_rest_count_mono ensures] [%#slib'1] rest_count_l s j <= rest_count_l s (k - 1))
    -> ([@stop_split] [@expl:lemma_rest_count_mono ensures] [%#slib'1] rest_count_l s j <= rest_count_l s k))
  else
    [@stop_split] [@expl:lemma_rest_count_mono ensures] [%#slib'1] rest_count_l s j <= rest_count_l s k
  )
