type t_Option_u32 = None | Some UInt32.t

let parse_header_guard (len: UInt64.t) (return (x: t_Option_u32)) = any
  [ return (result: t_Option_u32) ->
  {[@stop_split] [@expl:parse_header_guard ensures] ([@stop_split] [@expl:parse_header_guard ensures #0] [%#slib'4] UInt64.t'int len
        < 92 -> result = None)
    /\ ([@stop_split] [@expl:parse_header_guard ensures #1] [%#slib'5] UInt64.t'int len >= 92
    -> result = Some (92: UInt32.t))}
    (! return {result}) ]

type t_IoRes = Ok | Fail

type t_TabM = { tag: UInt64.t; count: UInt32.t; sector_size: UInt32.t }

type t_Attempt = Ok'0 t_TabM | Corrupt'0 | NoTable'0 | Io'0

function try_read_gpt_at [#"/home/cornel/fv-runs/apply-disk-partition-manager-20261007/components/disk-partition-manager/verif-creusot/src/lib.rs" 1011 0 1014 12] (hdr_read: t_IoRes) (hdr_len_ok: bool) (sig_ok: bool) (hdr_crc_match: bool) (entry_read: t_IoRes) (entry_crc_match: bool) (tab: t_TabM) : t_Attempt
