  [ bb0 = s0
    [ s0 = dma_step [%#slib] {alloc_ok} (fun (_x: tup2_Option_PtErr_bool) -> [ &_ret <- _x ] s1)
    | s1 = return {_ret} ] ] [ & _ret: tup2_Option_PtErr_bool = Any.any_l () | & alloc_ok: bool = alloc_ok ])
  [ return (result: tup2_Option_PtErr_bool) ->
  {[@stop_split] [@expl:verify_dpm_io_err_dma ensures] ([@stop_split] [@expl:verify_dpm_io_err_dma ensures #0] [%#slib'0] not alloc_ok
      -> result.f0 = Some (IoError))
    /\ ([@stop_split] [@expl:verify_dpm_io_err_dma ensures #1] [%#slib'1] not alloc_ok -> not result.f1)}
