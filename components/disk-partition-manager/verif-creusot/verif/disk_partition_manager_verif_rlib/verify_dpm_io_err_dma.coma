use creusot.prelude.Any

type t_PtErr = NoPartitionTable | CorruptTable | InvalidPartition | IoError | LayoutError | NotInitialized

type t_Option_PtErr = None | Some t_PtErr

type tup2_Option_PtErr_bool = { f0: t_Option_PtErr; f1: bool }

let dma_step (alloc_ok: bool) (return (x: tup2_Option_PtErr_bool)) = any
  [ return (result: tup2_Option_PtErr_bool) ->
  {[@stop_split] [@expl:dma_step ensures] ([@stop_split] [@expl:dma_step ensures #0] [%#slib'2] not alloc_ok
      -> result.f0 = Some (IoError) /\ not result.f1)
    /\ ([@stop_split] [@expl:dma_step ensures #1] [%#slib'3] alloc_ok -> result.f0 = None /\ result.f1)}
    (! return {result}) ]

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

