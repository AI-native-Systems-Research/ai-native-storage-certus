use creusot.int.UInt64
use creusot.int.UInt32
use creusot.prelude.Any

type t_TabM = { tag: UInt64.t; count: UInt32.t; sector_size: UInt32.t }

type t_Option_TabM = None | Some t_TabM

type t_PtErr = NoPartitionTable | CorruptTable | InvalidPartition | IoError | LayoutError | NotInitialized

type t_ReadRes = Ok t_TabM | Err t_PtErr

type t_Outcome = Ok'0 t_TabM | Err'0 t_PtErr | Panic'0

type tup2_Outcome_Option_TabM = { f0: t_Outcome; f1: t_Option_TabM }

let format_m (st: t_Option_TabM) (bound: bool) (chan_ok: bool) (wr: t_ReadRes) (poisoned: bool)
  (return (x: tup2_Outcome_Option_TabM)) = any
  [ return (result: tup2_Outcome_Option_TabM) ->
  {[@stop_split] [@expl:format_m ensures] ([@stop_split] [@expl:format_m ensures #0] [%#slib'3] not bound
      -> result.f0 = Err'0 (NotInitialized) /\ result.f1 = st)
    /\ ([@stop_split] [@expl:format_m ensures #1] [%#slib'4] bound /\ not chan_ok
      -> result.f0 = Err'0 (IoError) /\ result.f1 = st)
    /\ ([@stop_split] [@expl:format_m ensures #2] [%#slib'5] match wr with
        | Err e -> bound /\ chan_ok -> result.f0 = Err'0 e /\ result.f1 = st
        | _ -> true
        end)
    /\ ([@stop_split] [@expl:format_m ensures #3] [%#slib'6] match wr with
        | Ok t -> bound /\ chan_ok /\ poisoned -> result.f0 = Panic'0 /\ result.f1 = st
        | _ -> true
        end)
    /\ ([@stop_split] [@expl:format_m ensures #4] [%#slib'7] match wr with
      | Ok t -> bound /\ chan_ok /\ not poisoned -> result.f0 = Ok'0 t /\ result.f1 = Some t
      | _ -> true
      end)}
    (! return {result}) ]

predicate format_writes_l [#"/home/cornel/fv-runs/apply-disk-partition-manager-20261007/components/disk-partition-manager/verif-creusot/src/lib.rs" 1350 0 1350 90] (bound: bool) (chan_ok: bool) (geom_ok: bool) (layout_ok: bool) =
  [%#slib'9] bound /\ chan_ok /\ geom_ok /\ layout_ok

let format_writes_sectors (bound: bool) (chan_ok: bool) (geom_ok: bool) (layout_ok: bool) (return (x: bool)) = any
  [ return (result: bool) -> {[@stop_split] [@expl:format_writes_sectors ensures] [%#slib'8] result
    = format_writes_l bound chan_ok geom_ok layout_ok}
    (! return {result}) ]

type tup2_Option_TabM_bool = { f0'0: t_Option_TabM; f1'0: bool }

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

