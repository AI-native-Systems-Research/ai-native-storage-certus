  | & layout_ok: bool = layout_ok
  | & wr: t_ReadRes = wr
  | & poisoned: bool = poisoned
  | & s2: t_Option_TabM = Any.any_l ()
  | & _20: tup2_Outcome_Option_TabM = Any.any_l ()
  | & w: bool = Any.any_l () ])
  [ return (result: tup2_Option_TabM_bool) ->
  {[@stop_split] [@expl:verify_dpm_format_stale_cache ensures] ([@stop_split] [@expl:verify_dpm_format_stale_cache ensures #0] [%#slib'1] match wr with
        | Err _ -> bound /\ chan_ok -> result.f0'0 = st
