use creusot.int.UInt64
use seq.Seq
use int.EuclideanDivision
use int.Int

type t_SpecM = { size_bytes: UInt64.t; tg_zero: bool }

function cdiv [#"/home/cornel/fv-runs/j13-dpm/components/disk-partition-manager/verif-creusot/src/lib.rs" 57 0 57 34] (n: int) (d: int) : int
 = [%#slib'11] EuclideanDivision.div n d + (if EuclideanDivision.mod n d = 0 then 0 else 1)

function fixed_sum_l [#"/home/cornel/fv-runs/j13-dpm/components/disk-partition-manager/verif-creusot/src/lib.rs" 227 0 227 57] (s: Seq.seq t_SpecM) (n: int) (ss: int) : int

axiom fixed_sum_l_def: forall s: Seq.seq t_SpecM, n: int, ss: int [fixed_sum_l s n ss]. ([%#slib'8] 0 <= n
      /\ n <= Seq.length s)
    -> fixed_sum_l s n ss
    = ([%#slib'9] if n = 0 then
      0
    else
      fixed_sum_l s (n - 1) ss
      + (if UInt64.t'int (Seq.get s (n - 1)).size_bytes > 0 then
        cdiv (UInt64.t'int (Seq.get s (n - 1)).size_bytes) ss
      else
        0
      )
    )

predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
  [%#swell_founded] self >= 0 /\ self > other

meta "rewrite_def" predicate well_founded_relation_Int

function lemma_cdiv_nonneg [#"/home/cornel/fv-runs/j13-dpm/components/disk-partition-manager/verif-creusot/src/lib.rs" 260 0 260 40] (n: int) (d: int) : ()
 = [%#slib'10] ()

axiom lemma_cdiv_nonneg_spec: forall n: int, d: int. ([%#slib'3] n >= 0 /\ d > 0) -> ([%#slib'4] cdiv n d >= 0)

axiom lemma_cdiv_nonneg_spec'0: forall n: int, d: int. ([%#slib'3] n >= 0 /\ d > 0) -> ([%#slib'5] cdiv n d * d >= n)

axiom lemma_cdiv_nonneg_spec'1: forall n: int, d: int. ([%#slib'3] n >= 0 /\ d > 0)
    -> ([%#slib'6] n > 0 -> cdiv n d >= 1)

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant s : Seq.seq t_SpecM

constant j : int

constant k : int

constant ss : int

function lemma_fixed_sum_mono [#"/home/cornel/fv-runs/j13-dpm/components/disk-partition-manager/verif-creusot/src/lib.rs" 291 0 291 67] (s: Seq.seq t_SpecM) (j: int) (k: int) (ss: int) : ()

goal vc_lemma_fixed_sum_mono: ([%#slib'0] 0 <= j /\ j <= k /\ k <= Seq.length s)
  -> ([%#slib'1] ss > 0)
  -> (if j < k then
    (([@stop_split] [@expl:lemma_fixed_sum_mono requires] ([@stop_split] [@expl:lemma_fixed_sum_mono requires #0] [%#slib'0] 0
            <= j
          /\ j <= k - 1 /\ k - 1 <= Seq.length s)
        /\ ([@stop_split] [@expl:lemma_fixed_sum_mono requires #1] [%#slib'1] ss > 0))
      /\ ([@expl:variant decreases] well_founded_relation_Int ([%#slib] k - j) ([%#slib] k - 1 - j)))
    /\ (([@stop_split] [@expl:lemma_fixed_sum_mono ensures] [%#slib'2] fixed_sum_l s j ss <= fixed_sum_l s (k - 1) ss)
    -> (let _ = lemma_fixed_sum_mono s j (k
    - 1) ss in ([@stop_split] [@expl:lemma_cdiv_nonneg requires] [%#slib'3] UInt64.t'int (Seq.get s (k - 1)).size_bytes
        >= 0
      /\ ss > 0)
    /\ (([@stop_split] [@expl:lemma_cdiv_nonneg ensures] ([@stop_split] [@expl:lemma_cdiv_nonneg ensures #0] [%#slib'4] cdiv (UInt64.t'int (Seq.get s (k
          - 1)).size_bytes) ss
        >= 0)
      /\ ([@stop_split] [@expl:lemma_cdiv_nonneg ensures #1] [%#slib'5] cdiv (UInt64.t'int (Seq.get s (k
            - 1)).size_bytes) ss
          * ss
        >= UInt64.t'int (Seq.get s (k - 1)).size_bytes)
      /\ ([@stop_split] [@expl:lemma_cdiv_nonneg ensures #2] [%#slib'6] UInt64.t'int (Seq.get s (k - 1)).size_bytes > 0
      -> cdiv (UInt64.t'int (Seq.get s (k - 1)).size_bytes) ss >= 1))
    -> ([@stop_split] [@expl:lemma_fixed_sum_mono ensures] [%#slib'2] fixed_sum_l s j ss <= fixed_sum_l s k ss))))
  else
    [@stop_split] [@expl:lemma_fixed_sum_mono ensures] [%#slib'2] fixed_sum_l s j ss <= fixed_sum_l s k ss
  )
