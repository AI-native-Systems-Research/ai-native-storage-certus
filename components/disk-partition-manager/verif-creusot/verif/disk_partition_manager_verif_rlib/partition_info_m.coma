type t_PtErr = NoPartitionTable | CorruptTable | InvalidPartition | IoError | LayoutError | NotInitialized

type t_PiOutcome = Ok t_PInfoM | Err t_PtErr | Panic

type t_Vec_PInfoM_Global

constant const_MAX: UInt64.t = (18446744073709551615: UInt64.t)

function view_Vec_PInfoM_Global (self: t_Vec_PInfoM_Global) : Seq.seq t_PInfoM

axiom view_Vec_PInfoM_Global_spec:
  forall self: t_Vec_PInfoM_Global [view_Vec_PInfoM_Global self]. [%#svec'2] Seq.length (view_Vec_PInfoM_Global self)
    <= UInt64.t'int const_MAX

let len_PInfoM (self_: t_Vec_PInfoM_Global) (return (x: UInt64.t)) = any
  [ return (result: UInt64.t) -> {[@stop_split] [@expl:len ensures] [%#svec] UInt64.t'int result
    = Seq.length (view_Vec_PInfoM_Global self_)}
    (! return {result}) ]

predicate in_bounds_usize [@inline:trivial] (self: UInt64.t) (seq: Seq.seq t_PInfoM) =
  [%#sslice] UInt64.t'int self < Seq.length seq

meta "rewrite_def" predicate in_bounds_usize

predicate has_value_usize [@inline:trivial] (self: UInt64.t) (seq: Seq.seq t_PInfoM) (out: t_PInfoM) =
  [%#sslice'0] Seq.get seq (UInt64.t'int self) = out

meta "rewrite_def" predicate has_value_usize

let index_Vec_PInfoM_Global (self_: t_Vec_PInfoM_Global) (ix: UInt64.t) (return (x: t_PInfoM)) =
{[@stop_split] [@expl:index requires] [%#svec'0] in_bounds_usize ix (view_Vec_PInfoM_Global self_)}
  any
  [ return (result: t_PInfoM) ->
  {[@stop_split] [@expl:index ensures] [%#svec'1] has_value_usize ix (view_Vec_PInfoM_Global self_) result}
    (! return {result}) ]

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

