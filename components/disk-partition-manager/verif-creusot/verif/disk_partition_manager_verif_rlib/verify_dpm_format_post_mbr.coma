  [ & _ret: t_Vec_u8_Global = Any.any_l () | & ss: UInt32.t = ss | & ns: UInt64.t = ns ])
  [ return (result: t_Vec_u8_Global) ->
  {[@stop_split] [@expl:verify_dpm_format_post_mbr ensures] ([@stop_split] [@expl:verify_dpm_format_post_mbr ensures #0] [%#slib'2] UInt8.t'int (Seq.get (view_Vec_u8_Global result) 446)
      = 0)
    /\ ([@stop_split] [@expl:verify_dpm_format_post_mbr ensures #1] [%#slib'3] UInt8.t'int (Seq.get (view_Vec_u8_Global result) 450)
      = 238)
