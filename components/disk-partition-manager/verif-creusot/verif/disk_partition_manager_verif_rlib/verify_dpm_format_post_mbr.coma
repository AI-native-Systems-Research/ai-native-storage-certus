      = 0)
    /\ ([@stop_split] [@expl:protective_mbr ensures #2] [%#slib'11] UInt8.t'int (Seq.get (view_Vec_u8_Global result) 450)
      = 238)
    /\ ([@stop_split] [@expl:protective_mbr ensures #3] [%#slib'12] le32_at (view_Vec_u8_Global result) 454 = 1)
    /\ ([@stop_split] [@expl:protective_mbr ensures #4] [%#slib'13] le32_at (view_Vec_u8_Global result) 458
