use creusot.int.UInt32
use creusot.int.UInt64
use seq.Seq
use creusot.int.UInt8
use creusot.prelude.Any
use int.EuclideanDivision
use int.Int

type t_Vec_u8_Global

constant const_MAX: UInt64.t = (18446744073709551615: UInt64.t)

function view_Vec_u8_Global (self: t_Vec_u8_Global) : Seq.seq UInt8.t

axiom view_Vec_u8_Global_spec:
  forall self: t_Vec_u8_Global [view_Vec_u8_Global self]. [%#svec] Seq.length (view_Vec_u8_Global self)
    <= UInt64.t'int const_MAX

function le32_at [#"/home/cornel/fv-runs/apply-disk-partition-manager-20261007/components/disk-partition-manager/verif-creusot/src/lib.rs" 806 0 806 42] (s: Seq.seq UInt8.t) (at': int) : int
 = [%#slib'19] UInt8.t'int (Seq.get s at') + 256 * UInt8.t'int (Seq.get s (at' + 1))
    + 65536 * UInt8.t'int (Seq.get s (at' + 2))
  + 16777216 * UInt8.t'int (Seq.get s (at' + 3))

let protective_mbr (ss: UInt32.t) (ns: UInt64.t) (return (x: t_Vec_u8_Global)) =
{[@stop_split] [@expl:protective_mbr requires] ([@stop_split] [@expl:protective_mbr requires #0] [%#slib'7] UInt32.t'int ss
    >= 512)
  /\ ([@stop_split] [@expl:protective_mbr requires #1] [%#slib'8] UInt64.t'int ns >= 1)}
  any
  [ return (result: t_Vec_u8_Global) ->
  {[@stop_split] [@expl:protective_mbr ensures] ([@stop_split] [@expl:protective_mbr ensures #0] [%#slib'9] Seq.length (view_Vec_u8_Global result)
      = UInt32.t'int ss)
    /\ ([@stop_split] [@expl:protective_mbr ensures #1] [%#slib'10] UInt8.t'int (Seq.get (view_Vec_u8_Global result) 446)
      = 0)
    /\ ([@stop_split] [@expl:protective_mbr ensures #2] [%#slib'11] UInt8.t'int (Seq.get (view_Vec_u8_Global result) 450)
      = 238)
    /\ ([@stop_split] [@expl:protective_mbr ensures #3] [%#slib'12] le32_at (view_Vec_u8_Global result) 454 = 1)
    /\ ([@stop_split] [@expl:protective_mbr ensures #4] [%#slib'13] le32_at (view_Vec_u8_Global result) 458
      = (if UInt64.t'int ns - 1 <= 4294967295 then UInt64.t'int ns - 1 else 4294967295))
    /\ ([@stop_split] [@expl:protective_mbr ensures #5] [%#slib'14] UInt8.t'int (Seq.get (view_Vec_u8_Global result) 510)
        = 85
      /\ UInt8.t'int (Seq.get (view_Vec_u8_Global result) 511) = 170)
    /\ ([@stop_split] [@expl:protective_mbr ensures #6] [%#slib'15] forall i: int. 0 <= i /\ i < 446
        -> UInt8.t'int (Seq.get (view_Vec_u8_Global result) i) = 0)
    /\ ([@stop_split] [@expl:protective_mbr ensures #7] [%#slib'16] forall i: int. 462 <= i /\ i < 510
        -> UInt8.t'int (Seq.get (view_Vec_u8_Global result) i) = 0)
    /\ ([@stop_split] [@expl:protective_mbr ensures #8] [%#slib'17] forall i: int. 512 <= i /\ i < UInt32.t'int ss
      -> UInt8.t'int (Seq.get (view_Vec_u8_Global result) i) = 0)}
    (! return {result}) ]

function cdiv [#"/home/cornel/fv-runs/apply-disk-partition-manager-20261007/components/disk-partition-manager/verif-creusot/src/lib.rs" 57 0 57 34] (n: int) (d: int) : int
 = [%#slib'18] EuclideanDivision.div n d + (if EuclideanDivision.mod n d = 0 then 0 else 1)

