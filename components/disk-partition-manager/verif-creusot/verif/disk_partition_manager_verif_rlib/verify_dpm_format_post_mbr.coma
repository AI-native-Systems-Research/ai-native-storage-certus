let verify_dpm_format_post_mbr [#"/home/cornel/fv-runs/apply-disk-partition-manager-20261007/components/disk-partition-manager/verif-creusot/src/lib.rs" 2165 0 2165 62]
  (ss: UInt32.t) (ns: UInt64.t) (return (x: t_Vec_u8_Global)) =
{[@stop_split] [@expl:verify_dpm_format_post_mbr requires] ([@stop_split] [@expl:verify_dpm_format_post_mbr requires #0] [%#slib'0] UInt32.t'int ss
      = 512
    \/ UInt32.t'int ss = 4096)
  /\ ([@stop_split] [@expl:verify_dpm_format_post_mbr requires #1] [%#slib'1] UInt64.t'int ns
  >= 2 * cdiv 16384 (UInt32.t'int ss) + 5)}
  (! bb0
  [ bb0 = s0
