      = 1)
    /\ ([@stop_split] [@expl:verify_dpm_format_post_mbr ensures #3] [%#slib'5] le32_at (view_Vec_u8_Global result) 458
      = (if UInt64.t'int ns - 1 <= 4294967295 then UInt64.t'int ns - 1 else 4294967295))
    /\ ([@stop_split] [@expl:verify_dpm_format_post_mbr ensures #4] [%#slib'6] UInt8.t'int (Seq.get (view_Vec_u8_Global result) 510)
      = 85
    /\ UInt8.t'int (Seq.get (view_Vec_u8_Global result) 511) = 170)}
