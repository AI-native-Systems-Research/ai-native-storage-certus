use creusot.int.UInt64
use creusot.int.UInt32
use creusot.prelude.Any

type t_TabM = { tag: UInt64.t; count: UInt32.t; sector_size: UInt32.t }

type t_Attempt = Ok t_TabM | Corrupt | NoTable | Io

type t_PtErr = NoPartitionTable | CorruptTable | InvalidPartition | IoError | LayoutError | NotInitialized

type t_ReadRes = Ok'0 t_TabM | Err'0 t_PtErr

let read_gpt_m (primary: t_Attempt) (backup: t_Attempt) (return (x: t_ReadRes)) = any
  [ return (result: t_ReadRes) ->
  {[@stop_split] [@expl:read_gpt_m ensures] ([@stop_split] [@expl:read_gpt_m ensures #0] [%#slib'6] match primary with
        | Ok t -> result = Ok'0 t
        | _ -> true
        end)
    /\ ([@stop_split] [@expl:read_gpt_m ensures #1] [%#slib'7] match primary with
        | Io -> result = Err'0 (IoError)
        | _ -> true
        end)
    /\ ([@stop_split] [@expl:read_gpt_m ensures #2] [%#slib'8] match primary with
        | Corrupt -> match backup with
          | Ok t -> result = Ok'0 t
          | _ -> result = Err'0 (NoPartitionTable)
          end
        | _ -> true
        end)
    /\ ([@stop_split] [@expl:read_gpt_m ensures #3] [%#slib'9] match primary with
      | NoTable -> match backup with
        | Ok t -> result = Ok'0 t
        | _ -> result = Err'0 (NoPartitionTable)
        end
      | _ -> true
      end)}
    (! return {result}) ]

type t_IofOutcome = Ok'1 t_TabM bool | Err'1 t_PtErr

let initialize_or_format_m (force: bool) (init: t_ReadRes) (fmt: t_ReadRes) (return (x: t_IofOutcome)) = any
  [ return (result: t_IofOutcome) ->
  {[@stop_split] [@expl:initialize_or_format_m ensures] ([@stop_split] [@expl:initialize_or_format_m ensures #0] [%#slib'10] force
      -> match fmt with
        | Ok'0 t -> result = Ok'1 t true
        | Err'0 e -> result = Err'1 e
        end)
    /\ ([@stop_split] [@expl:initialize_or_format_m ensures #1] [%#slib'11] not force
      -> match init with
        | Ok'0 t -> result = Ok'1 t false
        | _ -> true
        end)
    /\ ([@stop_split] [@expl:initialize_or_format_m ensures #2] [%#slib'12] not force
      -> match init with
        | Err'0 (NoPartitionTable) -> match fmt with
          | Ok'0 t -> result = Ok'1 t true
          | Err'0 e -> result = Err'1 e
          end
        | _ -> true
        end)
    /\ ([@stop_split] [@expl:initialize_or_format_m ensures #3] [%#slib'13] not force
      -> match init with
        | Err'0 (CorruptTable) -> match fmt with
          | Ok'0 t -> result = Ok'1 t true
          | Err'0 e -> result = Err'1 e
          end
        | _ -> true
        end)
    /\ ([@stop_split] [@expl:initialize_or_format_m ensures #4] [%#slib'14] not force
      -> match init with
        | Err'0 (IoError) -> result = Err'1 (IoError)
        | _ -> true
        end)
    /\ ([@stop_split] [@expl:initialize_or_format_m ensures #5] [%#slib'15] not force
      -> match init with
        | Err'0 (NotInitialized) -> result = Err'1 (NotInitialized)
        | _ -> true
        end)
    /\ ([@stop_split] [@expl:initialize_or_format_m ensures #6] [%#slib'16] not force
      -> match init with
        | Err'0 (LayoutError) -> result = Err'1 (LayoutError)
        | _ -> true
        end)
    /\ ([@stop_split] [@expl:initialize_or_format_m ensures #7] [%#slib'17] not force
    -> match init with
      | Err'0 (InvalidPartition) -> result = Err'1 (InvalidPartition)
      | _ -> true
      end)}
    (! return {result}) ]

let elim_Err (_x: t_IofOutcome) (return (f0: t_PtErr)) = any
  [ _k (f0: t_PtErr) -> {Err'1 f0 = _x} (! return {f0})
  | _chk -> (! {[@expl:elim Err] match _x with
      | Err'1 _ -> true
      | _ -> false
      end}
    any) ]

let elim_Ok (_x: t_IofOutcome) (return (f0: t_TabM) (f1: bool)) = any
  [ _k (f0: t_TabM) (f1: bool) -> {Ok'1 f0 f1 = _x} (! return {f0} {f1})
  | _chk -> (! {[@expl:elim Ok] match _x with
      | Ok'1 _ _ -> true
      | _ -> false
      end}
    any) ]

type tup2_IofOutcome_bool = { f0: t_IofOutcome; f1: bool }

