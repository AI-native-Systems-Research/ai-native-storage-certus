(* <NpOutcome as std::clone::Clone> *)

use creusot.int.UInt32
use creusot.prelude.Any

type t_PtErr = NoPartitionTable | CorruptTable | InvalidPartition | IoError | LayoutError | NotInitialized

type t_NpOutcome = Ok UInt32.t | Err t_PtErr | Panic

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let clone_NpOutcome [#"/home/cornel/fv-runs/j13-dpm/components/disk-partition-manager/verif-creusot/src/lib.rs" 1232 9 1232 29]
  (self: t_NpOutcome) (return (x: t_NpOutcome)) = (! bb0
  [ bb0 = s0 [ s0 = [ &_ret <- self ] s1 | s1 = return {_ret} ] ]
  [ & _ret: t_NpOutcome = Any.any_l () | & self: t_NpOutcome = self ])
  [ return (result: t_NpOutcome) -> (! return {result}) ]
