use creusot.int.UInt64
use creusot.int.UInt32
use creusot.prelude.Any

type t_TabM = { tag: UInt64.t; count: UInt32.t; sector_size: UInt32.t }

type t_PtErr = NoPartitionTable | CorruptTable | InvalidPartition | IoError | LayoutError | NotInitialized

type t_Outcome = Ok t_TabM | Err t_PtErr | Panic

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let clone_Outcome [#"/home/cornel/fv-runs/j13-dpm/components/disk-partition-manager/verif-creusot/src/lib.rs" 973 9 973 29]
  (self: t_Outcome) (return (x: t_Outcome)) = (! bb0
  [ bb0 = s0 [ s0 = [ &_ret <- self ] s1 | s1 = return {_ret} ] ]
  [ & _ret: t_Outcome = Any.any_l () | & self: t_Outcome = self ]) [ return (result: t_Outcome) -> (! return {result}) ]
