let verify_dpm_inv_entry_sectors_consistent [#"/home/cornel/fv-runs/j13-dpm/components/disk-partition-manager/verif-creusot/src/lib.rs" 2943 0 2945 35]
  (cfg_ss: UInt32.t) (cfg_total: UInt64.t) (dev_ss: UInt32.t) (dev_ns: UInt64.t)
  (return (x: tup6_u32_u64_u64_u64_u64_u32)) =
{[@stop_split] [@expl:verify_dpm_inv_entry_sectors_consistent requires] ([@stop_split] [@expl:verify_dpm_inv_entry_sectors_consistent requires #0] [%#slib'7] (UInt32.t'int cfg_ss
        = 512
      \/ UInt32.t'int cfg_ss = 4096)
    /\ (UInt32.t'int dev_ss = 512 \/ UInt32.t'int dev_ss = 4096))
  /\ ([@stop_split] [@expl:verify_dpm_inv_entry_sectors_consistent requires #1] [%#slib'8] UInt64.t'int cfg_total
      >= 2 * cdiv 16384 (UInt32.t'int cfg_ss) + 5
    /\ UInt64.t'int dev_ns >= cdiv 16384 (UInt32.t'int dev_ss) + 1)
  /\ ([@stop_split] [@expl:verify_dpm_inv_entry_sectors_consistent requires #2] [%#slib'9] dev_ss = cfg_ss
  /\ dev_ns = cfg_total)}
  (! bb0
  [ bb0 = s0
    [ s0 = entry_sectors [%#slib] {cfg_ss} (fun (_x: UInt32.t) -> [ &es <- _x ] s1)
    | s1 = usable_window [%#slib'0] {cfg_ss} {cfg_total} (fun (_x: tup2_u64_u64) -> [ &_32 <- _x ] s2)
    | s2 = [ &first <- _32.f0 ] s3
    | s3 = [ &last <- _32.f1 ] s4
    | s4 = UInt64.add [%#slib'2] {last} {[%#slib'1] (1: UInt64.t)} (fun (_x: UInt64.t) -> [ &backup_write <- _x ] s5)
    | s5 = entry_sectors [%#slib'3] {dev_ss} (fun (_x: UInt32.t) -> [ &es_r <- _x ] s6)
    | s6 = UInt64.sub [%#slib'5] {dev_ns} {[%#slib'4] (1: UInt64.t)} (fun (_x: UInt64.t) -> [ &_40 <- _x ] s7)
    | s7 = [ &_42 <- UInt64.of_int (UInt32.t'int es_r) ] s8
    | s8 = UInt64.sub [%#slib'6] {_40} {_42} (fun (_x: UInt64.t) -> [ &backup_read <- _x ] s9)
    | s9 = [ &_ret <- { f0'0 = es; f1'0 = first; f2'0 = last; f3'0 = backup_write; f4'0 = backup_read; f5'0 = es_r } ]
      s10
    | s10 = return {_ret} ] ]
  [ & _ret: tup6_u32_u64_u64_u64_u64_u32 = Any.any_l ()
  | & cfg_ss: UInt32.t = cfg_ss
  | & cfg_total: UInt64.t = cfg_total
  | & dev_ss: UInt32.t = dev_ss
  | & dev_ns: UInt64.t = dev_ns
  | & es: UInt32.t = Any.any_l ()
  | & first: UInt64.t = Any.any_l ()
  | & last: UInt64.t = Any.any_l ()
  | & _32: tup2_u64_u64 = Any.any_l ()
  | & backup_write: UInt64.t = Any.any_l ()
  | & es_r: UInt32.t = Any.any_l ()
  | & backup_read: UInt64.t = Any.any_l ()
  | & _40: UInt64.t = Any.any_l ()
  | & _42: UInt64.t = Any.any_l () ])
  [ return (result: tup6_u32_u64_u64_u64_u64_u32) ->
  {[@stop_split] [@expl:verify_dpm_inv_entry_sectors_consistent ensures] ([@stop_split] [@expl:verify_dpm_inv_entry_sectors_consistent ensures #0] [%#slib'10] UInt32.t'int result.f0'0
      = cdiv 16384 (UInt32.t'int cfg_ss))
    /\ ([@stop_split] [@expl:verify_dpm_inv_entry_sectors_consistent ensures #1] [%#slib'11] UInt64.t'int result.f1'0
      = 2 + UInt32.t'int result.f0'0)
    /\ ([@stop_split] [@expl:verify_dpm_inv_entry_sectors_consistent ensures #2] [%#slib'12] UInt64.t'int result.f2'0
      = UInt64.t'int cfg_total - 2 - UInt32.t'int result.f0'0)
    /\ ([@stop_split] [@expl:verify_dpm_inv_entry_sectors_consistent ensures #3] [%#slib'13] UInt64.t'int result.f3'0
      = UInt64.t'int result.f2'0 + 1)
    /\ ([@stop_split] [@expl:verify_dpm_inv_entry_sectors_consistent ensures #4] [%#slib'14] UInt64.t'int result.f4'0
      = UInt64.t'int dev_ns - 1 - UInt32.t'int result.f5'0)
    /\ ([@stop_split] [@expl:verify_dpm_inv_entry_sectors_consistent ensures #5] [%#slib'15] result.f5'0 = result.f0'0)
    /\ ([@stop_split] [@expl:verify_dpm_inv_entry_sectors_consistent ensures #6] [%#slib'16] result.f3'0 = result.f4'0)}
    (! return {result}) ]
