    \/ UInt32.t'int ss = 4096)
  /\ ([@stop_split] [@expl:usable_window requires #1] [%#slib'17] UInt64.t'int ns
  >= entry_sectors_l (UInt32.t'int ss) + 2)}
  any
  [ return (result: tup2_u64_u64) ->
  {[@stop_split] [@expl:usable_window ensures] ([@stop_split] [@expl:usable_window ensures #0] [%#slib'18] UInt64.t'int result.f0
