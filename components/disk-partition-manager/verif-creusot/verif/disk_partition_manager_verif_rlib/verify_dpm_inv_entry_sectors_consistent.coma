use creusot.int.UInt32
use int.EuclideanDivision
use creusot.int.UInt64
use creusot.prelude.Any
use int.Int

function cdiv [#"/home/cornel/fv-runs/j13-dpm/components/disk-partition-manager/verif-creusot/src/lib.rs" 57 0 57 34] (n: int) (d: int) : int
 = [%#slib'23] EuclideanDivision.div n d + (if EuclideanDivision.mod n d = 0 then 0 else 1)

function entry_sectors_l [#"/home/cornel/fv-runs/j13-dpm/components/disk-partition-manager/verif-creusot/src/lib.rs" 84 0 84 38] (ss: int) : int
 = [%#slib'24] cdiv 16384 ss

let entry_sectors (ss: UInt32.t) (return (x: UInt32.t)) =
{[@stop_split] [@expl:entry_sectors requires] [%#slib'17] UInt32.t'int ss > 0}
  any
  [ return (result: UInt32.t) -> {[@stop_split] [@expl:entry_sectors ensures] [%#slib'18] UInt32.t'int result
    = entry_sectors_l (UInt32.t'int ss)}
    (! return {result}) ]

type tup2_u64_u64 = { f0: UInt64.t; f1: UInt64.t }

function first_usable_l [#"/home/cornel/fv-runs/j13-dpm/components/disk-partition-manager/verif-creusot/src/lib.rs" 681 0 681 37] (ss: int) : int
 = [%#slib'25] 2 + entry_sectors_l ss

function last_usable_l [#"/home/cornel/fv-runs/j13-dpm/components/disk-partition-manager/verif-creusot/src/lib.rs" 687 0 687 45] (ss: int) (ns: int) : int
 = [%#slib'26] ns - 1 - entry_sectors_l ss - 1

let usable_window (ss: UInt32.t) (ns: UInt64.t) (return (x: tup2_u64_u64)) =
{[@stop_split] [@expl:usable_window requires] ([@stop_split] [@expl:usable_window requires #0] [%#slib'19] UInt32.t'int ss
      = 512
    \/ UInt32.t'int ss = 4096)
  /\ ([@stop_split] [@expl:usable_window requires #1] [%#slib'20] UInt64.t'int ns
  >= entry_sectors_l (UInt32.t'int ss) + 2)}
  any
  [ return (result: tup2_u64_u64) ->
  {[@stop_split] [@expl:usable_window ensures] ([@stop_split] [@expl:usable_window ensures #0] [%#slib'21] UInt64.t'int result.f0
      = first_usable_l (UInt32.t'int ss))
    /\ ([@stop_split] [@expl:usable_window ensures #1] [%#slib'22] UInt64.t'int result.f1
    = last_usable_l (UInt32.t'int ss) (UInt64.t'int ns))}
    (! return {result}) ]

