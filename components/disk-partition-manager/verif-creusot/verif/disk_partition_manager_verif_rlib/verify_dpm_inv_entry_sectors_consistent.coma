type tup2_u64_u64 = { f0: UInt64.t; f1: UInt64.t }

function first_usable_l [#"/home/cornel/cv-disk-partition-manager-20260930/components/disk-partition-manager/verif-creusot/src/lib.rs" 675 0 675 37] (ss: int) : int
 = [%#slib'22] 2 + entry_sectors_l ss

function last_usable_l [#"/home/cornel/cv-disk-partition-manager-20260930/components/disk-partition-manager/verif-creusot/src/lib.rs" 681 0 681 45] (ss: int) (ns: int) : int
 = [%#slib'23] ns - 1 - entry_sectors_l ss - 1

let usable_window (ss: UInt32.t) (ns: UInt64.t) (return (x: tup2_u64_u64)) =
{[@stop_split] [@expl:usable_window requires] ([@stop_split] [@expl:usable_window requires #0] [%#slib'16] UInt32.t'int ss
