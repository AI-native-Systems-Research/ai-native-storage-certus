  {[@stop_split] [@expl:partition_info_m ensures] ([@stop_split] [@expl:partition_info_m ensures #0] [%#slib'3] poisoned
      -> result = Panic)
    /\ ([@stop_split] [@expl:partition_info_m ensures #1] [%#slib'4] not poisoned /\ not loaded
