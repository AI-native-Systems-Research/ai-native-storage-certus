type t_Vec_u8_Global

constant const_MAX: UInt64.t = (18446744073709551615: UInt64.t)

function view_Vec_u8_Global (self: t_Vec_u8_Global) : Seq.seq UInt8.t

axiom view_Vec_u8_Global_spec:
  forall self: t_Vec_u8_Global [view_Vec_u8_Global self]. [%#svec'0] Seq.length (view_Vec_u8_Global self)
    <= UInt64.t'int const_MAX

function le32_at [#"/home/cornel/cv-disk-partition-manager-20260930/components/disk-partition-manager/verif-creusot/src/lib.rs" 800 0 800 42] (s: Seq.seq UInt8.t) (at': int) : int
 = [%#slib'20] UInt8.t'int (Seq.get s at') + 256 * UInt8.t'int (Seq.get s (at' + 1))
    + 65536 * UInt8.t'int (Seq.get s (at' + 2))
  + 16777216 * UInt8.t'int (Seq.get s (at' + 3))

let protective_mbr (ss: UInt32.t) (ns: UInt64.t) (return (x: t_Vec_u8_Global)) =
{[@stop_split] [@expl:protective_mbr requires] ([@stop_split] [@expl:protective_mbr requires #0] [%#slib'7] UInt32.t'int ss
    >= 512)
  /\ ([@stop_split] [@expl:protective_mbr requires #1] [%#slib'8] UInt64.t'int ns >= 1)}
  any
  [ return (result: t_Vec_u8_Global) ->
  {[@stop_split] [@expl:protective_mbr ensures] ([@stop_split] [@expl:protective_mbr ensures #0] [%#slib'9] Seq.length (view_Vec_u8_Global result)
      = UInt32.t'int ss)
    /\ ([@stop_split] [@expl:protective_mbr ensures #1] [%#slib'10] UInt8.t'int (Seq.get (view_Vec_u8_Global result) 446)
      = 0)
    /\ ([@stop_split] [@expl:protective_mbr ensures #2] [%#slib'11] UInt8.t'int (Seq.get (view_Vec_u8_Global result) 450)
      = 238)
    /\ ([@stop_split] [@expl:protective_mbr ensures #3] [%#slib'12] le32_at (view_Vec_u8_Global result) 454 = 1)
    /\ ([@stop_split] [@expl:protective_mbr ensures #4] [%#slib'13] le32_at (view_Vec_u8_Global result) 458
      = (if UInt64.t'int ns - 1 <= 4294967295 then UInt64.t'int ns - 1 else 4294967295))
    /\ ([@stop_split] [@expl:protective_mbr ensures #5] [%#slib'14] UInt8.t'int (Seq.get (view_Vec_u8_Global result) 510)
        = 85
      /\ UInt8.t'int (Seq.get (view_Vec_u8_Global result) 511) = 170)
    /\ ([@stop_split] [@expl:protective_mbr ensures #6] [%#slib'15] forall i: int. 0 <= i /\ i < 446
        -> UInt8.t'int (Seq.get (view_Vec_u8_Global result) i) = 0)
    /\ ([@stop_split] [@expl:protective_mbr ensures #7] [%#slib'16] forall i: int. 462 <= i /\ i < 510
        -> UInt8.t'int (Seq.get (view_Vec_u8_Global result) i) = 0)
    /\ ([@stop_split] [@expl:protective_mbr ensures #8] [%#slib'17] forall i: int. 512 <= i /\ i < UInt32.t'int ss
      -> UInt8.t'int (Seq.get (view_Vec_u8_Global result) i) = 0)}
    (! return {result}) ]

let len_u8 (self_: t_Vec_u8_Global) (return (x: UInt64.t)) = any
  [ return (result: UInt64.t) -> {[@stop_split] [@expl:len ensures] [%#svec] UInt64.t'int result
    = Seq.length (view_Vec_u8_Global self_)}
    (! return {result}) ]

function cdiv [#"/home/cornel/cv-disk-partition-manager-20260930/components/disk-partition-manager/verif-creusot/src/lib.rs" 57 0 57 34] (n: int) (d: int) : int
 = [%#slib'22] EuclideanDivision.div n d + (if EuclideanDivision.mod n d = 0 then 0 else 1)

function entry_sectors_l [#"/home/cornel/cv-disk-partition-manager-20260930/components/disk-partition-manager/verif-creusot/src/lib.rs" 84 0 84 38] (ss: int) : int
 = [%#slib'21] cdiv 16384 ss

let entry_sectors (ss: UInt32.t) (return (x: UInt32.t)) =
{[@stop_split] [@expl:entry_sectors requires] [%#slib'18] UInt32.t'int ss > 0}
  any
  [ return (result: UInt32.t) -> {[@stop_split] [@expl:entry_sectors ensures] [%#slib'19] UInt32.t'int result
    = entry_sectors_l (UInt32.t'int ss)}
    (! return {result}) ]

type tup2_usize_u32 = { f0: UInt64.t; f1: UInt32.t }

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let verify_dpm_format_pre_sector_size [#"/home/cornel/cv-disk-partition-manager-20260930/components/disk-partition-manager/verif-creusot/src/lib.rs" 1775 0 1775 74]
  (ss: UInt32.t) (ns: UInt64.t) (return (x: tup2_usize_u32)) =
{[@stop_split] [@expl:verify_dpm_format_pre_sector_size requires] ([@stop_split] [@expl:verify_dpm_format_pre_sector_size requires #0] [%#slib'2] UInt32.t'int ss
      = 512
    \/ UInt32.t'int ss = 4096)
  /\ ([@stop_split] [@expl:verify_dpm_format_pre_sector_size requires #1] [%#slib'3] UInt64.t'int ns >= 1)}
  (! bb0
  [ bb0 = s0
    [ s0 = protective_mbr [%#slib] {ss} {ns} (fun (_x: t_Vec_u8_Global) -> [ &mbr <- _x ] s1)
    | s1 = len_u8 [%#slib'0] {mbr} (fun (_x: UInt64.t) -> [ &_16 <- _x ] s2)
    | s2 = entry_sectors [%#slib'1] {ss} (fun (_x: UInt32.t) -> [ &_18 <- _x ] s3)
    | s3 = [ &_ret <- { f0 = _16; f1 = _18 } ] s4
