  [ & _ret: tup2_usize_u32 = Any.any_l ()
  | & ss: UInt32.t = ss
  | & ns: UInt64.t = ns
  | & mbr: t_Vec_u8_Global = Any.any_l ()
  | & _16: UInt64.t = Any.any_l ()
  | & _18: UInt32.t = Any.any_l () ])
  [ return (result: tup2_usize_u32) ->
  {[@stop_split] [@expl:verify_dpm_format_pre_sector_size ensures] ([@stop_split] [@expl:verify_dpm_format_pre_sector_size ensures #0] [%#slib'4] UInt64.t'int result.f0
        = UInt32.t'int ss
      /\ UInt64.t'int result.f0 >= 512)
    /\ ([@stop_split] [@expl:verify_dpm_format_pre_sector_size ensures #1] [%#slib'5] UInt32.t'int ss = 512
      -> UInt32.t'int result.f1 = 32)
    /\ ([@stop_split] [@expl:verify_dpm_format_pre_sector_size ensures #2] [%#slib'6] UInt32.t'int ss = 4096
    -> UInt32.t'int result.f1 = 4)}
    (! return {result}) ]
