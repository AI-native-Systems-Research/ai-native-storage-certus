use creusot.int.UInt32
use creusot.int.UInt64
use seq.Seq
use creusot.prelude.Any
use int.Int

type t_Vec_PInfoM_Global

type t_PInfoM = { index: UInt32.t; start_lba: UInt64.t; num_sectors: UInt64.t }

type t_PtErr = NoPartitionTable | CorruptTable | InvalidPartition | IoError | LayoutError | NotInitialized

type t_PiOutcome = Ok t_PInfoM | Err t_PtErr | Panic

constant const_MAX: UInt64.t = (18446744073709551615: UInt64.t)

function view_Vec_PInfoM_Global (self: t_Vec_PInfoM_Global) : Seq.seq t_PInfoM

axiom view_Vec_PInfoM_Global_spec:
  forall self: t_Vec_PInfoM_Global [view_Vec_PInfoM_Global self]. [%#svec] Seq.length (view_Vec_PInfoM_Global self)
    <= UInt64.t'int const_MAX

let partition_info_m (loaded: bool) (parts: t_Vec_PInfoM_Global) (poisoned: bool) (idx: UInt32.t)
  (return (x: t_PiOutcome)) = any
  [ return (result: t_PiOutcome) ->
  {[@stop_split] [@expl:partition_info_m ensures] ([@stop_split] [@expl:partition_info_m ensures #0] [%#slib'2] poisoned
      -> result = Panic)
    /\ ([@stop_split] [@expl:partition_info_m ensures #1] [%#slib'3] not poisoned /\ not loaded
      -> result = Err (NotInitialized))
    /\ ([@stop_split] [@expl:partition_info_m ensures #2] [%#slib'4] not poisoned
        /\ loaded /\ UInt32.t'int idx >= Seq.length (view_Vec_PInfoM_Global parts) -> result = Err (InvalidPartition))
    /\ ([@stop_split] [@expl:partition_info_m ensures #3] [%#slib'5] not poisoned
      /\ loaded /\ UInt32.t'int idx < Seq.length (view_Vec_PInfoM_Global parts)
    -> result = Ok (Seq.get (view_Vec_PInfoM_Global parts) (UInt32.t'int idx)))}
    (! return {result}) ]

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let verify_dpm_pinfo_post_match [#"/home/cornel/fv-runs/apply-disk-partition-manager-20261007/components/disk-partition-manager/verif-creusot/src/lib.rs" 2890 0 2892 14]
  (loaded: bool) (parts: t_Vec_PInfoM_Global) (poisoned: bool) (idx: UInt32.t) (return (x: t_PiOutcome)) = (! bb0
  [ bb0 = s0
    [ s0 = partition_info_m [%#slib] {loaded} {parts} {poisoned} {idx} (fun (_x: t_PiOutcome) -> [ &_ret <- _x ] s1)
    | s1 = return {_ret} ] ]
  [ & _ret: t_PiOutcome = Any.any_l ()
  | & loaded: bool = loaded
  | & parts: t_Vec_PInfoM_Global = parts
  | & poisoned: bool = poisoned
  | & idx: UInt32.t = idx ])
  [ return (result: t_PiOutcome) ->
  {[@stop_split] [@expl:verify_dpm_pinfo_post_match ensures] ([@stop_split] [@expl:verify_dpm_pinfo_post_match ensures #0] [%#slib'0] not poisoned
        /\ loaded /\ UInt32.t'int idx < Seq.length (view_Vec_PInfoM_Global parts)
      -> result = Ok (Seq.get (view_Vec_PInfoM_Global parts) (UInt32.t'int idx)))
    /\ ([@stop_split] [@expl:verify_dpm_pinfo_post_match ensures #1] [%#slib'1] match result with
      | Ok p -> loaded /\ not poisoned /\ UInt32.t'int idx < Seq.length (view_Vec_PInfoM_Global parts)
      -> p.index = (Seq.get (view_Vec_PInfoM_Global parts) (UInt32.t'int idx)).index
      /\ p.start_lba = (Seq.get (view_Vec_PInfoM_Global parts) (UInt32.t'int idx)).start_lba
      /\ p.num_sectors = (Seq.get (view_Vec_PInfoM_Global parts) (UInt32.t'int idx)).num_sectors
      | _ -> true
      end)}
    (! return {result}) ]
