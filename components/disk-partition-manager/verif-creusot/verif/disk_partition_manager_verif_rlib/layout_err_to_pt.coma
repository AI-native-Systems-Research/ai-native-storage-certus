type t_PtErr = NoPartitionTable | CorruptTable | InvalidPartition | IoError | LayoutError | NotInitialized

type t_LayoutErr = MultiRest | Capacity | PerPartition

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let layout_err_to_pt [#"/home/cornel/fv-runs/j13-dpm/components/disk-partition-manager/verif-creusot/src/lib.rs" 4704 0 4704 46]
  (e: t_LayoutErr) (return (x: t_PtErr)) = (! bb0
  [ bb0 = s0 [ s0 = [ &_ret <- LayoutError ] s1 | s1 = return {_ret} ] ] [ & _ret: t_PtErr = Any.any_l () ])
  [ return (result: t_PtErr) -> {[@stop_split] [@expl:layout_err_to_pt ensures] [%#slib] result = LayoutError}
    (! return {result}) ]
