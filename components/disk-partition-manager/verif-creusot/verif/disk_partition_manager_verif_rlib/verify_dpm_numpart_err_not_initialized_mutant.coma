let num_partitions_m (loaded: bool) (parts: t_Vec_PInfoM_Global) (poisoned: bool) (return (x: t_NpOutcome)) =
{[@stop_split] [@expl:num_partitions_m requires] [%#slib'2] Seq.length (view_Vec_PInfoM_Global parts) <= 4294967295}
