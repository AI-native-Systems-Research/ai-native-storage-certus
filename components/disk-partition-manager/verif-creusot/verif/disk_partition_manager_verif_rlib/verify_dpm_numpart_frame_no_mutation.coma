use creusot.int.UInt32
use seq.Seq
use creusot.int.UInt64
use creusot.prelude.Any
use int.Int

type t_Vec_PInfoM_Global

type t_PtErr = NoPartitionTable | CorruptTable | InvalidPartition | IoError | LayoutError | NotInitialized

type t_NpOutcome = Ok UInt32.t | Err t_PtErr | Panic

type t_PInfoM = { index: UInt32.t; start_lba: UInt64.t; num_sectors: UInt64.t }

constant const_MAX: UInt64.t = (18446744073709551615: UInt64.t)

function view_Vec_PInfoM_Global (self: t_Vec_PInfoM_Global) : Seq.seq t_PInfoM

axiom view_Vec_PInfoM_Global_spec:
  forall self: t_Vec_PInfoM_Global [view_Vec_PInfoM_Global self]. [%#svec] Seq.length (view_Vec_PInfoM_Global self)
    <= UInt64.t'int const_MAX

let num_partitions_m (loaded: bool) (parts: t_Vec_PInfoM_Global) (poisoned: bool) (return (x: t_NpOutcome)) =
{[@stop_split] [@expl:num_partitions_m requires] [%#slib'7] Seq.length (view_Vec_PInfoM_Global parts) <= 4294967295}
  any
  [ return (result: t_NpOutcome) ->
  {[@stop_split] [@expl:num_partitions_m ensures] ([@stop_split] [@expl:num_partitions_m ensures #0] [%#slib'8] poisoned
      -> result = Panic)
    /\ ([@stop_split] [@expl:num_partitions_m ensures #1] [%#slib'9] not poisoned /\ not loaded
      -> result = Err (NotInitialized))
    /\ ([@stop_split] [@expl:num_partitions_m ensures #2] [%#slib'10] not poisoned /\ loaded
    -> (exists c: UInt32.t. result = Ok c /\ UInt32.t'int c = Seq.length (view_Vec_PInfoM_Global parts)))}
    (! return {result}) ]

type t_TabM = { tag: UInt64.t; count: UInt32.t; sector_size: UInt32.t }

type t_Option_TabM = None | Some t_TabM

type t_Option_u32 = None'0 | Some'0 UInt32.t

