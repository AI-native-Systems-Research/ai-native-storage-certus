use creusot.int.UInt64
use seq.Seq
use int.Int

type t_EntryM = { tg_zero: bool; start: UInt64.t; end': UInt64.t; attrs: UInt64.t }

function occupied_l [#"/home/cornel/fv-runs/apply-disk-partition-manager-20261007/components/disk-partition-manager/verif-creusot/src/lib.rs" 599 0 599 48] (s: Seq.seq t_EntryM) (n: int) : int

axiom occupied_l_def: forall s: Seq.seq t_EntryM, n: int [occupied_l s n]. ([%#slib'4] 0 <= n /\ n <= Seq.length s)
    -> occupied_l s n
    = ([%#slib'5] if n = 0 then 0 else occupied_l s (n - 1) + (if (Seq.get s (n - 1)).tg_zero then 0 else 1))

predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
  [%#swell_founded] self >= 0 /\ self > other

meta "rewrite_def" predicate well_founded_relation_Int

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant s : Seq.seq t_EntryM

constant m : int

constant n : int

function lemma_occupied_tail_zero [#"/home/cornel/fv-runs/apply-disk-partition-manager-20261007/components/disk-partition-manager/verif-creusot/src/lib.rs" 1966 0 1966 63] (s: Seq.seq t_EntryM) (m: int) (n: int) : ()

goal vc_lemma_occupied_tail_zero: ([%#slib'0] 0 <= m /\ m <= n /\ n <= Seq.length s)
  -> ([%#slib'1] forall k: int. m <= k /\ k < n -> (Seq.get s k).tg_zero)
  -> (if m < n then
    (([@stop_split] [@expl:lemma_occupied_tail_zero requires] ([@stop_split] [@expl:lemma_occupied_tail_zero requires #0] [%#slib'0] 0
            <= m
          /\ m <= n - 1 /\ n - 1 <= Seq.length s)
        /\ ([@stop_split] [@expl:lemma_occupied_tail_zero requires #1] [%#slib'1] forall k: int. m <= k /\ k < n - 1
          -> (Seq.get s k).tg_zero))
      /\ ([@expl:variant decreases] well_founded_relation_Int ([%#slib] n - m) ([%#slib] n - 1 - m)))
    /\ (([@stop_split] [@expl:lemma_occupied_tail_zero ensures] [%#slib'2] occupied_l s (n - 1) = occupied_l s m)
    -> ([@stop_split] [@expl:lemma_occupied_tail_zero ensures] [%#slib'2] occupied_l s n = occupied_l s m))
  else
    [@stop_split] [@expl:lemma_occupied_tail_zero ensures] [%#slib'2] occupied_l s n = occupied_l s m
  )
