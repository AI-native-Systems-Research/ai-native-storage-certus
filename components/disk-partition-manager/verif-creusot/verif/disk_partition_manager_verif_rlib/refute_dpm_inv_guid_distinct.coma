use creusot.slice.Slice64
use creusot.int.UInt8
use seq.Seq
use creusot.int.UInt64
use creusot.prelude.Any
use int.Int

predicate inv_Seq_u8 [@inline:trivial] (_1: Seq.seq UInt8.t) = true

meta "rewrite_def" predicate inv_Seq_u8

predicate invariant_array_u8_16 (self: Slice64.array UInt8.t) =
  [%#sarray'0] inv_Seq_u8 (Slice64.view self) /\ Seq.length (Slice64.view self) = UInt64.t'int (16: UInt64.t)

predicate inv_array_u8_16 [@inline:trivial] (_1: Slice64.array UInt8.t) = invariant_array_u8_16 _1

meta "rewrite_def" predicate inv_array_u8_16

function index_array_u8_16 [@inline:trivial] (self: Slice64.array UInt8.t) (ix: int) : UInt8.t =
  [%#sarray] Seq.get (Slice64.view self) ix

meta "rewrite_def" function index_array_u8_16

let generate_guid (opened: bool) (bytes: Slice64.array UInt8.t) (return (x: Slice64.array UInt8.t)) =
{[@stop_split] [@expl:generate_guid 'bytes' type invariant] [%#slib'11] inv_array_u8_16 bytes}
  any
  [ return (result: Slice64.array UInt8.t) ->
  {[@stop_split] [@expl:generate_guid ensures] ([@stop_split] [@expl:generate_guid result type invariant] [%#slib'12] inv_array_u8_16 result)
    /\ ([@stop_split] [@expl:generate_guid ensures #0] [%#slib'13] UInt8.bw_and (index_array_u8_16 result 6) (240: UInt8.t)
      = (64: UInt8.t))
    /\ ([@stop_split] [@expl:generate_guid ensures #1] [%#slib'14] UInt8.bw_and (index_array_u8_16 result 8) (192: UInt8.t)
      = (128: UInt8.t))
    /\ ([@stop_split] [@expl:generate_guid ensures #2] [%#slib'15] not opened
      -> index_array_u8_16 result 6 = (64: UInt8.t))
    /\ ([@stop_split] [@expl:generate_guid ensures #3] [%#slib'16] not opened
      -> index_array_u8_16 result 8 = (128: UInt8.t))
    /\ ([@stop_split] [@expl:generate_guid ensures #4] [%#slib'17] not opened
      -> (forall i: int. 0 <= i /\ i < 16 /\ i <> 6 /\ i <> 8 -> index_array_u8_16 result i = (0: UInt8.t)))
    /\ ([@stop_split] [@expl:generate_guid ensures #5] [%#slib'18] opened
    -> (forall i: int. 0 <= i /\ i < 16 /\ i <> 6 /\ i <> 8 -> index_array_u8_16 result i = index_array_u8_16 bytes i))}
    (! return {result}) ]

type tup3_array_u8_16_array_u8_16_array_u8_16 = {
  f0: Slice64.array UInt8.t;
  f1: Slice64.array UInt8.t;
  f2: Slice64.array UInt8.t }

predicate inv_tup3_array_u8_16_array_u8_16_array_u8_16 [@inline:trivial] (_1: tup3_array_u8_16_array_u8_16_array_u8_16) =
  inv_array_u8_16 _1.f0 /\ inv_array_u8_16 _1.f1 /\ inv_array_u8_16 _1.f2

meta "rewrite_def" predicate inv_tup3_array_u8_16_array_u8_16_array_u8_16

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let refute_dpm_inv_guid_distinct [#"/home/cornel/fv-runs/j13-dpm/components/disk-partition-manager/verif-creusot/src/lib.rs" 2547 0 2549 35]
  (b1: Slice64.array UInt8.t) (b2: Slice64.array UInt8.t) (b3: Slice64.array UInt8.t)
  (return (x: tup3_array_u8_16_array_u8_16_array_u8_16)) =
{[@stop_split] [@expl:refute_dpm_inv_guid_distinct requires] ([@stop_split] [@expl:refute_dpm_inv_guid_distinct 'b1' type invariant] [%#slib'5] inv_array_u8_16 b1)
  /\ ([@stop_split] [@expl:refute_dpm_inv_guid_distinct 'b2' type invariant] [%#slib'6] inv_array_u8_16 b2)
  /\ ([@stop_split] [@expl:refute_dpm_inv_guid_distinct 'b3' type invariant] [%#slib'7] inv_array_u8_16 b3)}
  (! bb0
  [ bb0 = s0
    [ s0 = generate_guid [%#slib'0] {[%#slib] false} {b1} (fun (_x: Slice64.array UInt8.t) -> [ &_6 <- _x ] s1)
    | s1 = generate_guid [%#slib'2] {[%#slib'1] false} {b2} (fun (_x: Slice64.array UInt8.t) -> [ &_8 <- _x ] s2)
    | s2 = generate_guid [%#slib'4] {[%#slib'3] false} {b3} (fun (_x: Slice64.array UInt8.t) -> [ &_10 <- _x ] s3)
    | s3 = [ &_ret <- { f0 = _6; f1 = _8; f2 = _10 } ] s4
    | s4 = return {_ret} ] ]
  [ & _ret: tup3_array_u8_16_array_u8_16_array_u8_16 = Any.any_l ()
  | & b1: Slice64.array UInt8.t = b1
  | & b2: Slice64.array UInt8.t = b2
  | & b3: Slice64.array UInt8.t = b3
  | & _6: Slice64.array UInt8.t = Any.any_l ()
  | & _8: Slice64.array UInt8.t = Any.any_l ()
  | & _10: Slice64.array UInt8.t = Any.any_l () ])
  [ return (result: tup3_array_u8_16_array_u8_16_array_u8_16) ->
  {[@stop_split] [@expl:refute_dpm_inv_guid_distinct ensures] ([@stop_split] [@expl:refute_dpm_inv_guid_distinct result type invariant] [%#slib'8] inv_tup3_array_u8_16_array_u8_16_array_u8_16 result)
    /\ ([@stop_split] [@expl:refute_dpm_inv_guid_distinct ensures #0] [%#slib'9] forall i: int. 0 <= i /\ i < 16
        -> index_array_u8_16 result.f0 i = index_array_u8_16 result.f1 i)
    /\ ([@stop_split] [@expl:refute_dpm_inv_guid_distinct ensures #1] [%#slib'10] forall i: int. 0 <= i /\ i < 16
      -> index_array_u8_16 result.f0 i = index_array_u8_16 result.f2 i)}
    (! return {result}) ]
