            | Ok'1 -> if not entry_crc_match then Corrupt else Ok tab
            end
      
    
    
    end

let try_read_gpt_at_m (hdr_read: t_IoRes) (hdr_len_ok: bool) (sig_ok: bool) (hdr_crc_match: bool) (entry_read: t_IoRes)
  (entry_crc_match: bool) (tab: t_TabM) (return (x: t_Attempt)) = any
