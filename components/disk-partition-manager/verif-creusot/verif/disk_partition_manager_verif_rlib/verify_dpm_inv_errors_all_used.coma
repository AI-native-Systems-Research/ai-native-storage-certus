          | _ -> true
          end
        | _ -> true
        end)
    /\ ([@stop_split] [@expl:try_read_gpt_at_m ensures #5] [%#slib'39] match hdr_read with
        | Ok'1 -> match entry_read with
          | Ok'1 -> hdr_len_ok /\ sig_ok /\ hdr_crc_match /\ not entry_crc_match -> result = Corrupt
          | _ -> true
          end
