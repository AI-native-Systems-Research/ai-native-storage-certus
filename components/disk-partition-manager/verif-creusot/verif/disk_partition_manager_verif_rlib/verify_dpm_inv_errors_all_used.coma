type t_Vec_PInfoM_Global

type t_PInfoM = { index: UInt32.t; start_lba: UInt64.t; num_sectors: UInt64.t }

type t_PiOutcome = Ok'2 t_PInfoM | Err'2 t_PtErr | Panic'2

constant const_MAX: UInt64.t = (18446744073709551615: UInt64.t)

function view_Vec_PInfoM_Global (self: t_Vec_PInfoM_Global) : Seq.seq t_PInfoM

axiom view_Vec_PInfoM_Global_spec:
  forall self: t_Vec_PInfoM_Global [view_Vec_PInfoM_Global self]. [%#svec] Seq.length (view_Vec_PInfoM_Global self)
    <= UInt64.t'int const_MAX

let partition_info_m (loaded: bool) (parts: t_Vec_PInfoM_Global) (poisoned: bool) (idx: UInt32.t)
  (return (x: t_PiOutcome)) = any
  [ return (result: t_PiOutcome) ->
  {[@stop_split] [@expl:partition_info_m ensures] ([@stop_split] [@expl:partition_info_m ensures #0] [%#slib'43] poisoned
      -> result = Panic'2)
    /\ ([@stop_split] [@expl:partition_info_m ensures #1] [%#slib'44] not poisoned /\ not loaded
      -> result = Err'2 (NotInitialized))
    /\ ([@stop_split] [@expl:partition_info_m ensures #2] [%#slib'45] not poisoned
        /\ loaded /\ UInt32.t'int idx >= Seq.length (view_Vec_PInfoM_Global parts) -> result = Err'2 (InvalidPartition))
    /\ ([@stop_split] [@expl:partition_info_m ensures #3] [%#slib'46] not poisoned
      /\ loaded /\ UInt32.t'int idx < Seq.length (view_Vec_PInfoM_Global parts)
    -> result = Ok'2 (Seq.get (view_Vec_PInfoM_Global parts) (UInt32.t'int idx)))}
    (! return {result}) ]

let elim_Err'0 (_x: t_PiOutcome) (return (f0: t_PtErr)) = any
  [ _k (f0: t_PtErr) -> {Err'2 f0 = _x} (! return {f0})
  | _chk -> (! {[@expl:elim Err] match _x with
      | Err'2 _ -> true
      | _ -> false
      end}
    any) ]

type t_SpecM = { size_bytes: UInt64.t; tg_zero: bool }

function rest_count_l [#"/home/cornel/fv-runs/apply-disk-partition-manager-20261007/components/disk-partition-manager/verif-creusot/src/lib.rs" 214 0 214 49] (s: Seq.seq t_SpecM) (n: int) : int

axiom rest_count_l_def: forall s: Seq.seq t_SpecM, n: int [rest_count_l s n]. ([%#slib'48] 0 <= n /\ n <= Seq.length s)
    -> rest_count_l s n
    = ([%#slib'49] if n = 0 then
      0
    else
      rest_count_l s (n - 1) + (if UInt64.t'int (Seq.get s (n - 1)).size_bytes = 0 then 1 else 0)
    )

type t_Vec_SpecM_Global

function view_Vec_SpecM_Global (self: t_Vec_SpecM_Global) : Seq.seq t_SpecM

axiom view_Vec_SpecM_Global_spec:
  forall self: t_Vec_SpecM_Global [view_Vec_SpecM_Global self]. [%#svec] Seq.length (view_Vec_SpecM_Global self)
    <= UInt64.t'int const_MAX

type t_LayoutErr = MultiRest | Capacity | PerPartition

type t_Result_u64_LayoutErr = Ok'3 UInt64.t | Err'3 t_LayoutErr

function cdiv [#"/home/cornel/fv-runs/apply-disk-partition-manager-20261007/components/disk-partition-manager/verif-creusot/src/lib.rs" 57 0 57 34] (n: int) (d: int) : int
 = [%#slib'68] EuclideanDivision.div n d + (if EuclideanDivision.mod n d = 0 then 0 else 1)

function fixed_sum_l [#"/home/cornel/fv-runs/apply-disk-partition-manager-20261007/components/disk-partition-manager/verif-creusot/src/lib.rs" 227 0 227 57] (s: Seq.seq t_SpecM) (n: int) (ss: int) : int

axiom fixed_sum_l_def: forall s: Seq.seq t_SpecM, n: int, ss: int [fixed_sum_l s n ss]. ([%#slib'66] 0 <= n
      /\ n <= Seq.length s)
    -> fixed_sum_l s n ss
    = ([%#slib'67] if n = 0 then
      0
    else
      fixed_sum_l s (n - 1) ss
      + (if UInt64.t'int (Seq.get s (n - 1)).size_bytes > 0 then
        cdiv (UInt64.t'int (Seq.get s (n - 1)).size_bytes) ss
      else
        0
      )
    )

let layout_classify (specs: t_Vec_SpecM_Global) (ss: UInt32.t) (total_usable: UInt64.t)
  (return (x: t_Result_u64_LayoutErr)) =
{[@stop_split] [@expl:layout_classify requires] ([@stop_split] [@expl:layout_classify requires #0] [%#slib'50] UInt32.t'int ss
      = 512
    \/ UInt32.t'int ss = 4096)
  /\ ([@stop_split] [@expl:layout_classify requires #1] [%#slib'51] rest_count_l (view_Vec_SpecM_Global specs) (Seq.length (view_Vec_SpecM_Global specs))
    <= 1
  -> fixed_sum_l (view_Vec_SpecM_Global specs) (Seq.length (view_Vec_SpecM_Global specs)) (UInt32.t'int ss)
  <= 18446744073709551615)}
  any
  [ return (result: t_Result_u64_LayoutErr) ->
  {[@stop_split] [@expl:layout_classify ensures] ([@stop_split] [@expl:layout_classify ensures #0] [%#slib'52] match result with
        | Err'3 (MultiRest) -> rest_count_l (view_Vec_SpecM_Global specs) (Seq.length (view_Vec_SpecM_Global specs)) > 1
