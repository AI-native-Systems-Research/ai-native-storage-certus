    | Fail -> Io'0
    | Ok -> if not hdr_len_ok then
      Corrupt'0
    else
      if not sig_ok then
        NoTable'0
      else
        if not hdr_crc_match then
          Corrupt'0
        else
          match entry_read with
            | Fail -> Io'0
