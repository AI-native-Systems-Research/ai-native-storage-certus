  partition_entry_size: UInt32.t;
  partition_entry_crc32: UInt32.t }

type tup2_HdrM_HdrM = { f0: t_HdrM; f1: t_HdrM }

function cdiv [#"/home/cornel/fv-runs/j13-dpm/components/disk-partition-manager/verif-creusot/src/lib.rs" 57 0 57 34] (n: int) (d: int) : int
 = [%#slib'25] EuclideanDivision.div n d + (if EuclideanDivision.mod n d = 0 then 0 else 1)

function entry_sectors_l [#"/home/cornel/fv-runs/j13-dpm/components/disk-partition-manager/verif-creusot/src/lib.rs" 84 0 84 38] (ss: int) : int
 = [%#slib'26] cdiv 16384 ss

constant const_GPT_SIGNATURE: UInt64.t = [%#slib'27] (6075990659671082565: UInt64.t)

function first_usable_l [#"/home/cornel/fv-runs/j13-dpm/components/disk-partition-manager/verif-creusot/src/lib.rs" 681 0 681 37] (ss: int) : int
 = [%#slib'28] 2 + entry_sectors_l ss

function last_usable_l [#"/home/cornel/fv-runs/j13-dpm/components/disk-partition-manager/verif-creusot/src/lib.rs" 687 0 687 45] (ss: int) (ns: int) : int
 = [%#slib'29] ns - 1 - entry_sectors_l ss - 1

function backup_entry_lba_write_l [#"/home/cornel/fv-runs/j13-dpm/components/disk-partition-manager/verif-creusot/src/lib.rs" 693 0 693 56] (ss: int) (ns: int) : int
 = [%#slib'30] last_usable_l ss ns + 1

let header_pair (ss: UInt32.t) (ns: UInt64.t) (entry_crc: UInt32.t) (return (x: tup2_HdrM_HdrM)) =
{[@stop_split] [@expl:header_pair requires] ([@stop_split] [@expl:header_pair requires #0] [%#slib'6] UInt32.t'int ss
