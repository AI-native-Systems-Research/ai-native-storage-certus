  {[@stop_split] [@expl:header_pair ensures] ([@stop_split] [@expl:header_pair ensures #0] [%#slib'8] result.f0.signature
      = const_GPT_SIGNATURE)
    /\ ([@stop_split] [@expl:header_pair ensures #1] [%#slib'9] UInt32.t'int result.f0.revision = 65536)
