    /\ ([@stop_split] [@expl:is_unsupported ensures #3] [%#slib'8] k = ControllerReset -> result = true)
    /\ ([@stop_split] [@expl:is_unsupported ensures #4] [%#slib'9] k = Supported -> result = false)}
    (! return {result}) ]

