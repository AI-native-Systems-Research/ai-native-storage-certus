use creusot.int.UInt64
use creusot.int.UInt32
use creusot.prelude.Any
use int.Int

type t_Result_unit_unit = Ok () | Err ()

constant const_MAX: UInt64.t = (18446744073709551615: UInt64.t)

let validate_lba (cfg_num_blocks: UInt64.t) (ns_id: UInt32.t) (lba: UInt64.t) (num_blocks: UInt64.t)
  (return (x: t_Result_unit_unit)) = any
  [ return (result: t_Result_unit_unit) ->
  {[@stop_split] [@expl:validate_lba ensures] ([@stop_split] [@expl:validate_lba ensures #0] [%#slib'8] UInt32.t'int ns_id
        <> 1 -> result = Err ())
    /\ ([@stop_split] [@expl:validate_lba ensures #1] [%#slib'9] UInt32.t'int ns_id = 1
        /\ UInt64.t'int lba + UInt64.t'int num_blocks > UInt64.t'int const_MAX -> result = Err ())
    /\ ([@stop_split] [@expl:validate_lba ensures #2] [%#slib'10] UInt32.t'int ns_id = 1
        /\ UInt64.t'int lba + UInt64.t'int num_blocks <= UInt64.t'int const_MAX
        /\ UInt64.t'int lba + UInt64.t'int num_blocks > UInt64.t'int cfg_num_blocks -> result = Err ())
    /\ ([@stop_split] [@expl:validate_lba ensures #3] [%#slib'11] result = Ok ()
    -> UInt32.t'int ns_id = 1 /\ UInt64.t'int lba + UInt64.t'int num_blocks <= UInt64.t'int cfg_num_blocks)}
    (! return {result}) ]

type t_Option_u64 = None | Some UInt64.t

let offset_for_lba (block_size: UInt32.t) (lba: UInt64.t) (return (x: UInt64.t)) =
{[@stop_split] [@expl:offset_for_lba requires] [%#slib'12] UInt64.t'int lba * UInt32.t'int block_size
  <= UInt64.t'int const_MAX}
  any
  [ return (result: UInt64.t) -> {[@stop_split] [@expl:offset_for_lba ensures] [%#slib'13] UInt64.t'int result
    = UInt64.t'int lba * UInt32.t'int block_size}
    (! return {result}) ]

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

