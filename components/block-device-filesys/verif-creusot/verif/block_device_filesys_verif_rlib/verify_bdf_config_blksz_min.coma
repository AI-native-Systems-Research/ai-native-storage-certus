        /\ UInt32.bw_and block_size (UInt32.sub block_size (1: UInt32.t)) = (0: UInt32.t)
        /\ UInt64.t'int num_blocks <> 0 /\ UInt32.t'int block_size * UInt64.t'int num_blocks > UInt64.t'int const_MAX
      -> result = Err ())
    /\ ([@stop_split] [@expl:cfg_new ensures #4] [%#slib'6] forall v: UInt64.t. result = Ok v
        -> UInt64.t'int v = UInt32.t'int block_size * UInt64.t'int num_blocks)
    /\ ([@stop_split] [@expl:cfg_new ensures #5] [%#slib'7] UInt32.t'int block_size >= 512
      /\ block_size <> (0: UInt32.t)
      /\ UInt32.bw_and block_size (UInt32.sub block_size (1: UInt32.t)) = (0: UInt32.t)
      /\ UInt64.t'int num_blocks <> 0 /\ UInt32.t'int block_size * UInt64.t'int num_blocks <= UInt64.t'int const_MAX
