type t_Result_u64_unit = Ok UInt64.t | Err ()

constant const_MAX: UInt64.t = (18446744073709551615: UInt64.t)

let cfg_new (block_size: UInt32.t) (num_blocks: UInt64.t) (return (x: t_Result_u64_unit)) = any
  [ return (result: t_Result_u64_unit) ->
  {[@stop_split] [@expl:cfg_new ensures] ([@stop_split] [@expl:cfg_new ensures #0] [%#slib'2] UInt32.t'int block_size
        < 512 -> result = Err ())
    /\ ([@stop_split] [@expl:cfg_new ensures #1] [%#slib'3] UInt32.t'int block_size >= 512
        /\ UInt32.bw_and block_size (UInt32.sub block_size (1: UInt32.t)) <> (0: UInt32.t) -> result = Err ())
    /\ ([@stop_split] [@expl:cfg_new ensures #2] [%#slib'4] UInt32.t'int block_size >= 512
        /\ block_size <> (0: UInt32.t)
