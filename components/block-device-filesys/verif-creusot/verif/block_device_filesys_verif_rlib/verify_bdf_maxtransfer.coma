constant const_MIN: UInt32.t = (0: UInt32.t)

constant const_MAX: UInt32.t = (4294967295: UInt32.t)

let saturating_mul (self_: UInt32.t) (rhs: UInt32.t) (return (x: UInt32.t)) = any
  [ return (result: UInt32.t) ->
  {[@stop_split] [@expl:saturating_mul ensures] ([@stop_split] [@expl:saturating_mul ensures #0] [%#snum] UInt32.t'int self_
            * UInt32.t'int rhs
          >= UInt32.t'int const_MIN
        /\ UInt32.t'int self_ * UInt32.t'int rhs <= UInt32.t'int const_MAX
      -> UInt32.t'int result = UInt32.t'int self_ * UInt32.t'int rhs)
    /\ ([@stop_split] [@expl:saturating_mul ensures #1] [%#snum'0] UInt32.t'int self_ * UInt32.t'int rhs
        < UInt32.t'int const_MIN -> UInt32.t'int result = UInt32.t'int const_MIN)
    /\ ([@stop_split] [@expl:saturating_mul ensures #2] [%#snum'1] UInt32.t'int self_ * UInt32.t'int rhs
      > UInt32.t'int const_MAX -> UInt32.t'int result = UInt32.t'int const_MAX)}
    (! return {result}) ]

