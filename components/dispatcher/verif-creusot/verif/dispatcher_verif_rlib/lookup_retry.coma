        | Ok (NotExist) -> not has g0 k /\ s.current.g = g0
        | Ok (Mismatch) -> false
        | Ok r -> has g0 k
        /\ UInt32.t'int (ent g0 k).wr = 0
        /\ UInt32.t'int (ent g0 k).rr < UInt32.t'int const_MAX
        /\ r = lr_of (ent g0 k).loc /\ ent_rr g0 s.current.g k 1 /\ only_dm g0 s.current.g
