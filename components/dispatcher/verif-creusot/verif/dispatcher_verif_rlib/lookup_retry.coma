    | s3 = dm_lookup [%#sbatch'1] {_15} {k} (fun (_x: t_Result_Lr_DmE) -> [ &lk <- _x ] s4)
    | s4 = [ &retries <- [%#sbatch'2] (0: UInt32.t) ] s5
