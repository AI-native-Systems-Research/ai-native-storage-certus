      /\ UInt32.t'int (ent s.current.g k).rr < UInt32.t'int const_MAX
      /\ r = lr_of (ent s.current.g k).loc /\ ent_rr s.current.g s.final.g k 1 /\ only_dm s.current.g s.final.g
      | Err _ -> has s.current.g k
      /\ (UInt32.t'int (ent s.current.g k).wr > 0 \/ UInt32.t'int (ent s.current.g k).rr = UInt32.t'int const_MAX)
