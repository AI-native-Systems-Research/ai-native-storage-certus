  tick: int;
  ob: Map.map int bool;
  ob2: Map.map int bool;
  og: Map.map int bool;
  os: Map.map int bool;
  ov: Map.map int UInt64.t;
  ok: Map.map int (Seq.seq UInt64.t);
  ext: Map.map int (Seq.seq t_Ext);
  pool: bool;
  cluster: bool;
  threads: int;
  rw: Map.map int UInt64.t;
  cfree: Map.map int int;
  wf: Map.map UInt64.t bool }

type t_S = { p: t_P; g: t_W }

type t_Lr = NotExist | Mismatch | Blk UInt64.t | Mem UInt64.t UInt32.t

type t_DmE =
  | KeyNotFound
  | AlreadyExists
  | ActiveRefs
  | Timeout
  | InvalidSize
  | Underflow
  | Overflow
  | NoWrite
  | InvalidState
  | Other

type t_Result_Lr_DmE = Ok t_Lr | Err t_DmE

type t_Option_u64 = None'0 | Some'0 UInt64.t

type t_Loc = Mem'0 UInt64.t UInt32.t t_Option_u64 | Blk'0 UInt64.t

type t_Ent = { loc: t_Loc; es: UInt32.t; rr: UInt32.t; wr: UInt32.t }

type t_Option_Ent = None'1 | Some'1 t_Ent

function to_mapping_u64 (self: t_FMap_u64_Ent) : Map.map UInt64.t t_Option_Ent

function get_u64 [@inline:trivial] (self: t_FMap_u64_Ent) (k: UInt64.t) : t_Option_Ent =
  [%#sfmap'1] Map.get (to_mapping_u64 self) k

meta "rewrite_def" function get_u64

predicate contains_u64 [@inline:trivial] (self: t_FMap_u64_Ent) (k: UInt64.t) = [%#sfmap] get_u64 self k <> None'1

meta "rewrite_def" predicate contains_u64

predicate has [#"/home/cornel/repair-j33-rc26/components/dispatcher/verif-creusot/src/core.rs" 331 0 331 32] (w: t_W) (k: UInt64.t) =
  [%#score] contains_u64 w.dm k

predicate index_Mapping_Ent_bool [@inline:trivial] (self: Map.map t_Ent bool) (a: t_Ent) = [%#smapping] Map.get self a

meta "rewrite_def" predicate index_Mapping_Ent_bool

function such_that_Ent (p'0: Map.map t_Ent bool) : t_Ent

axiom such_that_Ent_spec:
  forall p'0: Map.map t_Ent bool [such_that_Ent p'0]. ([%#slogic] exists x: t_Ent. index_Mapping_Ent_bool p'0 x)
    -> ([%#slogic'0] index_Mapping_Ent_bool p'0 (such_that_Ent p'0))

function unwrap_Option_Ent (self: t_Option_Ent) : t_Ent = [%#soption'0] match self with
    | Some'1 x -> x
    | None'1 -> such_that_Ent (fun (__0: t_Ent) -> true)
    end

function lookup_u64 [@inline:trivial] (self: t_FMap_u64_Ent) (k: UInt64.t) : t_Ent =
  [%#sfmap'0] unwrap_Option_Ent (get_u64 self k)

meta "rewrite_def" function lookup_u64

function ent [#"/home/cornel/repair-j33-rc26/components/dispatcher/verif-creusot/src/core.rs" 336 0 336 31] (w: t_W) (k: UInt64.t) : t_Ent
 = [%#score'0] lookup_u64 w.dm k

constant const_MAX: UInt32.t = (4294967295: UInt32.t)

function lr_of [#"/home/cornel/repair-j33-rc26/components/dispatcher/verif-creusot/src/core.rs" 361 0 361 26] (l: t_Loc) : t_Lr
 = [%#score'1] match l with
    | Blk'0 off -> Blk off
    | Mem'0 ptr size'1 _ -> Mem ptr size'1
    end

predicate others [#"/home/cornel/repair-j33-rc26/components/dispatcher/verif-creusot/src/core.rs" 579 0 579 41] (a: t_W) (b: t_W) (k: UInt64.t) =
  [%#score'4] forall j: UInt64.t. j <> k -> get_u64 b.dm j = get_u64 a.dm j

predicate ent_rr [#"/home/cornel/repair-j33-rc26/components/dispatcher/verif-creusot/src/core.rs" 597 0 597 49] (a: t_W) (b: t_W) (k: UInt64.t) (d: int) =
  [%#score'2] has a k
  /\ has b k
  /\ (ent b k).loc = (ent a k).loc
  /\ (ent b k).es = (ent a k).es
  /\ (ent b k).wr = (ent a k).wr /\ UInt32.t'int (ent b k).rr = UInt32.t'int (ent a k).rr + d /\ others a b k

predicate only_dm [#"/home/cornel/repair-j33-rc26/components/dispatcher/verif-creusot/src/core.rs" 585 0 585 34] (a: t_W) (b: t_W) =
  [%#score'3] b
  = { dm = b.dm;
      mt = a.mt;
      used = a.used;
      cap = a.cap;
      c = a.c;
      wq = a.wq;
      log = a.log;
      tick = a.tick;
      ob = a.ob;
      ob2 = a.ob2;
      og = a.og;
      os = a.os;
      ov = a.ov;
      ok = a.ok;
      ext = a.ext;
      pool = a.pool;
      cluster = a.cluster;
      threads = a.threads;
      rw = a.rw;
      cfree = a.cfree;
      wf = a.wf }

let dm_lookup (s: MutBorrow.t t_S) (k: UInt64.t) (return (x: t_Result_Lr_DmE)) = any
  [ return (result: t_Result_Lr_DmE) ->
  {[@stop_split] [@expl:dm_lookup ensures] ([@stop_split] [@expl:dm_lookup ensures #0] [%#sboundary] s.final.p
      = s.current.p)
    /\ ([@stop_split] [@expl:dm_lookup ensures #1] [%#sboundary'0] match result with
      | Ok (NotExist) -> not has s.current.g k /\ s.final.g = s.current.g
      | Ok (Mismatch) -> false
      | Ok r -> has s.current.g k
      /\ UInt32.t'int (ent s.current.g k).wr = 0
      /\ UInt32.t'int (ent s.current.g k).rr < UInt32.t'int const_MAX
      /\ r = lr_of (ent s.current.g k).loc /\ ent_rr s.current.g s.final.g k 1 /\ only_dm s.current.g s.final.g
      | Err (Timeout) -> has s.current.g k /\ UInt32.t'int (ent s.current.g k).wr > 0 /\ s.final.g = s.current.g
      | Err (Overflow) -> has s.current.g k
      /\ UInt32.t'int (ent s.current.g k).wr = 0
      /\ UInt32.t'int (ent s.current.g k).rr = UInt32.t'int const_MAX /\ s.final.g = s.current.g
      | Err _ -> false
      end)}
    (! return {result}) ]

predicate resolve_refmut_S [@inline:trivial] (_1: MutBorrow.t t_S) = _1.final = _1.current

meta "rewrite_def" predicate resolve_refmut_S

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

