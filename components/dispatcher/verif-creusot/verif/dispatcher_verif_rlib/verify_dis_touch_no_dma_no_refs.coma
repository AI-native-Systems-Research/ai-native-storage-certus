type t_S = { p: t_P; g: t_W }

type t_Ni = Dispatcher | DispatchMap | MemoryTier | Gpu | Spdk | Logger | Ring

type t_IoK =
  | Partition'0 UInt64.t UInt64.t UInt64.t
  | Drive'0 UInt64.t
  | Gpu'0
  | Sync'0
  | Ssd'0
  | Promote'0
  | Dm'0
  | Remote'0
  | Stream'0
  | Channel'0
  | Other'0

type t_DE = NotInit t_Ni | InvalidParam | KeyNotFound UInt64.t | AlreadyExists UInt64.t | Alloc | Io t_IoK | Timeout

type t_Result_unit_DE = Ok () | Err t_DE

type t_Option_u64 = None'0 | Some'0 UInt64.t

type t_Loc = Mem UInt64.t UInt32.t t_Option_u64 | Blk UInt64.t

type t_Ent = { loc: t_Loc; es: UInt32.t; rr: UInt32.t; wr: UInt32.t }

type t_Option_Ent = None'1 | Some'1 t_Ent

function to_mapping_u64 (self: t_FMap_u64_Ent) : Map.map UInt64.t t_Option_Ent

function get_u64 [@inline:trivial] (self: t_FMap_u64_Ent) (k: UInt64.t) : t_Option_Ent =
  [%#sfmap'0] Map.get (to_mapping_u64 self) k

meta "rewrite_def" function get_u64

predicate contains_u64 [@inline:trivial] (self: t_FMap_u64_Ent) (k: UInt64.t) = [%#sfmap] get_u64 self k <> None'1

meta "rewrite_def" predicate contains_u64

predicate has [#"/home/cornel/repair-j35-rc8/components/dispatcher/verif-creusot/src/core.rs" 344 0 344 32] (w: t_W) (k: UInt64.t) =
  [%#score'1] contains_u64 w.dm k

predicate log_ext [#"/home/cornel/repair-j35-rc8/components/dispatcher/verif-creusot/src/core.rs" 435 0 435 34] (a: t_W) (b: t_W) =
  [%#score'2] Seq.length a.log <= Seq.length b.log
  /\ (forall i: int. 0 <= i /\ i < Seq.length a.log -> Seq.get b.log i = Seq.get a.log i)

predicate no_dma [#"/home/cornel/repair-j35-rc8/components/dispatcher/verif-creusot/src/core.rs" 441 0 441 33] (a: t_W) (b: t_W) =
  [%#score'0] forall i: int. Seq.length a.log <= i /\ i < Seq.length b.log
    -> match Seq.get b.log i with
      | H2D _ _ _ _ -> false
      | D2H _ _ _ _ -> false
      | _ -> true
      end

let touch (s: MutBorrow.t t_S) (k: UInt64.t) (return (x: t_Result_unit_DE)) = any
  [ return (result: t_Result_unit_DE) ->
  {[@stop_split] [@expl:touch ensures] ([@stop_split] [@expl:touch ensures #0] [%#smethods] s.final.p = s.current.p)
    /\ ([@stop_split] [@expl:touch ensures #1] [%#smethods'0] not s.current.p.init
      -> result = Err (NotInit (Dispatcher)) /\ s.final.g = s.current.g)
    /\ ([@stop_split] [@expl:touch ensures #2] [%#smethods'1] s.current.p.init /\ s.current.p.has_dm
      -> match result with
        | Ok () -> has s.current.g k
        /\ s.final.g.dm = s.current.g.dm
        /\ s.final.g.mt = s.current.g.mt
        /\ s.final.g.log
        = (if s.current.p.has_mt then
          Seq.snoc (Seq.snoc s.current.g.log (DmTouch k)) (MtTouch k)
        else
          Seq.snoc s.current.g.log (DmTouch k)
        )
        | Err (KeyNotFound j) -> j = k /\ not has s.current.g k /\ s.final.g = s.current.g
        | Err _ -> false
        end)
    /\ ([@stop_split] [@expl:touch ensures #3] [%#smethods'2] s.final.g.dm = s.current.g.dm
    /\ s.final.g.mt = s.current.g.mt /\ log_ext s.current.g s.final.g /\ no_dma s.current.g s.final.g)}
    (! return {result}) ]

predicate resolve_refmut_S [@inline:trivial] (_1: MutBorrow.t t_S) = _1.final = _1.current

meta "rewrite_def" predicate resolve_refmut_S

predicate pinv [#"/home/cornel/repair-j35-rc8/components/dispatcher/verif-creusot/src/core.rs" 619 0 619 25] (p'0: t_P) =
  [%#score] (p'0.init -> p'0.has_dm /\ p'0.has_mt /\ p'0.writer) /\ (not p'0.init -> not p'0.ssd_ev /\ not p'0.mt_ev)

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let verify_dis_touch_no_dma_no_refs [#"/home/cornel/repair-j35-rc8/components/dispatcher/verif-creusot/src/drivers.rs" 1606 0 1606 75]
  (s: MutBorrow.t t_S) (k: UInt64.t) (return (x: t_Result_unit_DE)) =
{[@stop_split] [@expl:verify_dis_touch_no_dma_no_refs requires] [%#sdrivers'0] pinv s.current.p /\ s.current.p.init}
  (! bb0
  [ bb0 = s0
    [ s0 = MutBorrow.borrow_final <t_S> {s.current} {MutBorrow.get_id s}
        (fun (_bor: MutBorrow.t t_S) -> [ &_7 <- _bor ] [ &s <- { s with current = _bor.final } ] s1)
    | s1 = touch [%#sdrivers] {_7} {k} (fun (_x: t_Result_unit_DE) -> [ &_ret <- _x ] s2)
    | s2 = -{resolve_refmut_S s}- s3
    | s3 = return {_ret} ] ]
  [ & _ret: t_Result_unit_DE = Any.any_l ()
  | & s: MutBorrow.t t_S = s
  | & k: UInt64.t = k
  | & _7: MutBorrow.t t_S = Any.any_l () ])
  [ return (result: t_Result_unit_DE) ->
  {[@stop_split] [@expl:verify_dis_touch_no_dma_no_refs ensures] [%#sdrivers'1] s.final.g.dm = s.current.g.dm
    /\ no_dma s.current.g s.final.g}
    (! return {result}) ]
