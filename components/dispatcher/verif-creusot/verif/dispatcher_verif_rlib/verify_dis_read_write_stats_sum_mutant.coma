meta "rewrite_def" function index_Mapping_Int_u64

function rwsum [#"/home/cornel/repair-j33-rc26/components/dispatcher/verif-creusot/src/core.rs" 661 0 661 49] (m: Map.map int UInt64.t) (n: int) : int

axiom rwsum_def: forall m: Map.map int UInt64.t, n: int [rwsum m n]. rwsum m n
    = ([%#score'0] if n <= 0 then 0 else rwsum m (n - 1) + UInt64.t'int (index_Mapping_Int_u64 m (n - 1)))

let read_write_stats (s: MutBorrow.t t_S) (return (x: UInt64.t)) = any
  [ return (result: UInt64.t) ->
  {[@stop_split] [@expl:read_write_stats ensures] ([@stop_split] [@expl:read_write_stats ensures #0] [%#smisc] s.final.p
        = s.current.p
      /\ s.final.g = s.current.g)
    /\ ([@stop_split] [@expl:read_write_stats ensures #1] [%#smisc'0] UInt64.t'int result
    = rwsum s.current.g.rw (UInt64.t'int s.current.p.nd))}
    (! return {result}) ]

predicate resolve_refmut_S [@inline:trivial] (_1: MutBorrow.t t_S) = _1.final = _1.current

meta "rewrite_def" predicate resolve_refmut_S

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

