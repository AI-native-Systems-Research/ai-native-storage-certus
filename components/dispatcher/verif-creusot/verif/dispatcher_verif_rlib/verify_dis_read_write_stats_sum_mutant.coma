function rw_total [#"/home/cornel/repair-j33-rc21/components/dispatcher/verif-creusot/src/core.rs" 677 0 677 36] (w: t_W) (n: int) : int

function rw_total_zero [#"/home/cornel/repair-j33-rc21/components/dispatcher/verif-creusot/src/core.rs" 691 0 691 26] (w: t_W) : ()
 = [%#score'0] ()

axiom rw_total_zero_spec: forall w: t_W. [%#score] rw_total w 0 = w.rw_base

