type t_S = { p: t_P; g: t_W }

let read_write_stats (s: MutBorrow.t t_S) (return (x: UInt64.t)) = any
  [ return (result: UInt64.t) ->
  {[@stop_split] [@expl:read_write_stats ensures] ([@stop_split] [@expl:read_write_stats ensures #0] [%#smisc] s.final.p
        = s.current.p
      /\ s.final.g = s.current.g)
    /\ ([@stop_split] [@expl:read_write_stats ensures #1] [%#smisc'0] UInt64.t'int result
    = rw_total s.current.g (UInt64.t'int s.current.p.nd))}
    (! return {result}) ]

predicate resolve_refmut_S [@inline:trivial] (_1: MutBorrow.t t_S) = _1.final = _1.current

meta "rewrite_def" predicate resolve_refmut_S

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let verify_dis_read_write_stats_sum__mutant [#"/home/cornel/repair-j33-rc21/components/dispatcher/verif-creusot/src/drivers.rs" 1997 0 1997 64]
  (s: MutBorrow.t t_S) (return (x: UInt64.t)) = (! bb0
  [ bb0 = s0
    [ s0 = {[@expl:assertion] [%#sdrivers] rw_total_zero s.current.g = ()} s1
    | s1 = MutBorrow.borrow_final <t_S> {s.current} {MutBorrow.get_id s}
        (fun (_bor: MutBorrow.t t_S) -> [ &_8 <- _bor ] [ &s <- { s with current = _bor.final } ] s2)
    | s2 = read_write_stats [%#sdrivers'0] {_8} (fun (_x: UInt64.t) -> [ &_ret <- _x ] s3)
    | s3 = -{resolve_refmut_S s}- s4
    | s4 = return {_ret} ] ]
  [ & _ret: UInt64.t = Any.any_l () | & s: MutBorrow.t t_S = s | & _8: MutBorrow.t t_S = Any.any_l () ])
  [ return (result: UInt64.t) ->
  {[@stop_split] [@expl:verify_dis_read_write_stats_sum__mutant ensures] [%#sdrivers'1] UInt64.t'int result
    = rw_total s.current.g (UInt64.t'int s.current.p.nd) + 1}
    (! return {result}) ]
