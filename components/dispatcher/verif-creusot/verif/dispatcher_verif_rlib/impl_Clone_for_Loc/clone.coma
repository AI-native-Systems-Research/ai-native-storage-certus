(* <Loc as std::clone::Clone> *)

use creusot.int.UInt64
use creusot.int.UInt32
use creusot.prelude.Any

type t_Option_u64 = None | Some UInt64.t

type t_Loc = Mem UInt64.t UInt32.t t_Option_u64 | Blk UInt64.t

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let clone_Loc [#"/home/cornel/repair-j35-rc23/components/dispatcher/verif-creusot/src/core.rs" 20 9 20 29] (self: t_Loc)
  (return (x: t_Loc)) = (! bb0
  [ bb0 = s0 [ s0 = [ &_ret <- self ] s1 | s1 = return {_ret} ] ]
  [ & _ret: t_Loc = Any.any_l () | & self: t_Loc = self ]) [ return (result: t_Loc) -> (! return {result}) ]
