predicate demote_before_free [#"/home/cornel/repair-j33-rc24/components/dispatcher/verif-creusot/src/core.rs" 461 0 461 45] (a: t_W) (b: t_W) =
  [%#score'20] forall i: int. Seq.length a.log <= i /\ i < Seq.length b.log
    -> match Seq.get b.log i with
      | MtRemove key'2 -> i > Seq.length a.log /\ Seq.get b.log (i - 1) = DmDemote key'2
      | _ -> true
      end

