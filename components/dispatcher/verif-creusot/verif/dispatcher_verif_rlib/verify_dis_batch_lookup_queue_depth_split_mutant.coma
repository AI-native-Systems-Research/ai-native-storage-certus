use creusot.int.UInt64
use seq.Seq
use int.ComputerDivision
use creusot.prelude.Any
use int.Int

type t_Vec_usize_Global

constant const_MAX: UInt64.t = (18446744073709551615: UInt64.t)

function view_Vec_usize_Global (self: t_Vec_usize_Global) : Seq.seq UInt64.t

axiom view_Vec_usize_Global_spec:
  forall self: t_Vec_usize_Global [view_Vec_usize_Global self]. [%#svec] Seq.length (view_Vec_usize_Global self)
    <= UInt64.t'int const_MAX

function min_int [#"/home/cornel/repair-j33-rc17/components/dispatcher/verif-creusot/src/lookup.rs" 5 0 5 37] (a: int) (b: int) : int
 = [%#slookup] if a <= b then a else b

function qsum [#"/home/cornel/repair-j33-rc17/components/dispatcher/verif-creusot/src/bg.rs" 251 0 251 41] (s: Seq.seq UInt64.t) (n: int) : int

axiom qsum_def: forall s: Seq.seq UInt64.t, n: int [qsum s n]. qsum s n
    = ([%#sbg'4] if n <= 0 then 0 else qsum s (n - 1) + UInt64.t'int (Seq.get s (n - 1)))

let qd_shares (segs: t_Vec_usize_Global) (max_qd: UInt64.t) (return (x: t_Vec_usize_Global)) =
{[@stop_split] [@expl:qd_shares requires] [%#sbg] Seq.length (view_Vec_usize_Global segs) > 0
  /\ (forall d: int. 0 <= d /\ d < Seq.length (view_Vec_usize_Global segs)
    -> UInt64.t'int (Seq.get (view_Vec_usize_Global segs) d) >= 1)}
  any
  [ return (result: t_Vec_usize_Global) ->
  {[@stop_split] [@expl:qd_shares ensures] ([@stop_split] [@expl:qd_shares ensures #0] [%#sbg'0] Seq.length (view_Vec_usize_Global result)
      = Seq.length (view_Vec_usize_Global segs))
    /\ ([@stop_split] [@expl:qd_shares ensures #1] [%#sbg'1] forall d: int. 0 <= d
          /\ d < Seq.length (view_Vec_usize_Global segs)
        -> UInt64.t'int (Seq.get (view_Vec_usize_Global result) d)
        = min_int (if ComputerDivision.div (UInt64.t'int max_qd
          * UInt64.t'int (Seq.get (view_Vec_usize_Global segs) d)) (qsum (view_Vec_usize_Global segs) (Seq.length (view_Vec_usize_Global segs)))
        >= 1 then
          ComputerDivision.div (UInt64.t'int max_qd
          * UInt64.t'int (Seq.get (view_Vec_usize_Global segs) d)) (qsum (view_Vec_usize_Global segs) (Seq.length (view_Vec_usize_Global segs)))
        else
          1
        ) (UInt64.t'int (Seq.get (view_Vec_usize_Global segs) d)))
    /\ ([@stop_split] [@expl:qd_shares ensures #2] [%#sbg'2] Seq.length (view_Vec_usize_Global segs) = 1
      /\ UInt64.t'int max_qd >= 1
    -> UInt64.t'int (Seq.get (view_Vec_usize_Global result) 0)
    = min_int (UInt64.t'int max_qd) (UInt64.t'int (Seq.get (view_Vec_usize_Global segs) 0)))}
    (! return {result}) ]

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

