  (segs: t_Vec_usize_Global) (return (x: ())) =
{[@stop_split] [@expl:verify_dis_batch_lookup_queue_depth_split__mutant requires] [%#sdrivers'2] Seq.length (view_Vec_usize_Global segs)
    > 0
  /\ (forall d: int. 0 <= d /\ d < Seq.length (view_Vec_usize_Global segs)
    -> UInt64.t'int (Seq.get (view_Vec_usize_Global segs) d) >= 1)}
  (! bb0
  [ bb0 = s0
    [ s0 = qd_shares [%#sdrivers'0] {segs} {[%#sdrivers] (128: UInt64.t)}
        (fun (_x: t_Vec_usize_Global) -> [ &qd <- _x ] s1)
    | s1 = {[@expl:assertion] [%#sdrivers'1] Seq.length (view_Vec_usize_Global segs) = 1
      -> UInt64.t'int (Seq.get (view_Vec_usize_Global qd) 0) = 64}
      s2
    | s2 = return {_ret} ] ]
  [ & _ret: () = Any.any_l () | & segs: t_Vec_usize_Global = segs | & qd: t_Vec_usize_Global = Any.any_l () ])
  [ return (result: ()) -> (! return {result}) ]
