let%span score = "/home/cornel/repair-j33-rc4/components/dispatcher/verif-creusot/src/core.rs" 545 11 545 32
let%span score'0 = "/home/cornel/repair-j33-rc4/components/dispatcher/verif-creusot/src/core.rs" 546 10 546 49
let%span score'1 = "/home/cornel/repair-j33-rc4/components/dispatcher/verif-creusot/src/core.rs" 541 16 541 43
let%span score'2 = "/home/cornel/repair-j33-rc4/components/dispatcher/verif-creusot/src/core.rs" 526 10 526 17
let%span score'3 = "/home/cornel/repair-j33-rc4/components/dispatcher/verif-creusot/src/core.rs" 528 16 528 107

use creusot.int.UInt64
use creusot.int.UInt32
use seq.Seq
use int.Int

type t_Ipc = { addr: UInt64.t; size: UInt32.t }

function sum_sz [#"/home/cornel/repair-j33-rc4/components/dispatcher/verif-creusot/src/core.rs" 527 0 527 33] (r: Seq.seq t_Ipc) : int

axiom sum_sz_def: forall r: Seq.seq t_Ipc [sum_sz r]. sum_sz r
    = ([%#score'3] if Seq.length r = 0 then
      0
    else
      sum_sz (Seq.([..]) r 0 (Seq.length r - 1)) + UInt32.t'int (Seq.get r (Seq.length r - 1)).size
    )

function pre [#"/home/cornel/repair-j33-rc4/components/dispatcher/verif-creusot/src/core.rs" 540 0 540 38] (r: Seq.seq t_Ipc) (i: int) : int
 = [%#score'1] sum_sz (Seq.([..]) r 0 i)

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant r : Seq.seq t_Ipc

constant i : int

function pre_step [#"/home/cornel/repair-j33-rc4/components/dispatcher/verif-creusot/src/core.rs" 547 0 547 36] (r: Seq.seq t_Ipc) (i: int) : ()

goal vc_pre_step: ([%#score] 0 <= i /\ i < Seq.length r)
  -> Seq.([..]) (Seq.([..]) r 0 (i + 1)) 0 i = Seq.([..]) r 0 i
  && ([@stop_split] [@expl:pre_step ensures] [%#score'0] pre r (i + 1) = pre r i + UInt32.t'int (Seq.get r i).size)
