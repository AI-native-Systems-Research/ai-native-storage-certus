let%span score = "/home/cornel/repair-j33-rc29/components/dispatcher/verif-creusot/src/core.rs" 548 11 548 32
let%span score'0 = "/home/cornel/repair-j33-rc29/components/dispatcher/verif-creusot/src/core.rs" 549 10 549 49
let%span score'1 = "/home/cornel/repair-j33-rc29/components/dispatcher/verif-creusot/src/core.rs" 544 16 544 43
let%span score'2 = "/home/cornel/repair-j33-rc29/components/dispatcher/verif-creusot/src/core.rs" 529 10 529 17
let%span score'3 = "/home/cornel/repair-j33-rc29/components/dispatcher/verif-creusot/src/core.rs" 531 16 531 107

use creusot.int.UInt64
use creusot.int.UInt32
use seq.Seq
use int.Int

type t_Ipc = { addr: UInt64.t; size: UInt32.t }

function sum_sz [#"/home/cornel/repair-j33-rc29/components/dispatcher/verif-creusot/src/core.rs" 530 0 530 33] (r: Seq.seq t_Ipc) : int

axiom sum_sz_def: forall r: Seq.seq t_Ipc [sum_sz r]. sum_sz r
    = ([%#score'3] if Seq.length r = 0 then
      0
    else
      sum_sz (Seq.([..]) r 0 (Seq.length r - 1)) + UInt32.t'int (Seq.get r (Seq.length r - 1)).size
    )

function pre [#"/home/cornel/repair-j33-rc29/components/dispatcher/verif-creusot/src/core.rs" 543 0 543 38] (r: Seq.seq t_Ipc) (i: int) : int
 = [%#score'1] sum_sz (Seq.([..]) r 0 i)

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant r : Seq.seq t_Ipc

constant i : int

function pre_step [#"/home/cornel/repair-j33-rc29/components/dispatcher/verif-creusot/src/core.rs" 550 0 550 36] (r: Seq.seq t_Ipc) (i: int) : ()

goal vc_pre_step: ([%#score] 0 <= i /\ i < Seq.length r)
  -> Seq.([..]) (Seq.([..]) r 0 (i + 1)) 0 i = Seq.([..]) r 0 i
  && ([@stop_split] [@expl:pre_step ensures] [%#score'0] pre r (i + 1) = pre r i + UInt32.t'int (Seq.get r i).size)
