let%span sbatch = "/home/cornel/repair-j33-rc21/components/dispatcher/verif-creusot/src/batch.rs" 239 10 239 82
let%span sbatch'0 = "/home/cornel/repair-j33-rc21/components/dispatcher/verif-creusot/src/batch.rs" 257 10 257 17
let%span sbatch'1 = "/home/cornel/repair-j33-rc21/components/dispatcher/verif-creusot/src/batch.rs" 259 16 259 130

use creusot.int.UInt64
use seq.Seq
use int.Int

function count_k [#"/home/cornel/repair-j33-rc21/components/dispatcher/verif-creusot/src/batch.rs" 258 0 258 42] (s: Seq.seq UInt64.t) (k: UInt64.t) : int

axiom count_k_def: forall s: Seq.seq UInt64.t, k: UInt64.t [count_k s k]. count_k s k
    = ([%#sbatch'1] if Seq.length s = 0 then
      0
    else
      count_k (Seq.([..]) s 0 (Seq.length s - 1)) k + (if Seq.get s (Seq.length s - 1) = k then 1 else 0)
    )

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant s : Seq.seq UInt64.t

constant x : UInt64.t

constant k : UInt64.t

function count_push [#"/home/cornel/repair-j33-rc21/components/dispatcher/verif-creusot/src/batch.rs" 240 0 240 46] (s: Seq.seq UInt64.t) (x: UInt64.t) (k: UInt64.t) : ()

goal vc_count_push: Seq.([..]) (Seq.snoc s x) 0 (Seq.length s) = s
  && ([@stop_split] [@expl:count_push ensures] [%#sbatch] count_k (Seq.snoc s x) k
  = count_k s k + (if x = k then 1 else 0))
