let gpu_h2d_async (s: MutBorrow.t t_S) (src: UInt64.t) (dst: UInt64.t) (len: UInt64.t) (stream: UInt64.t)
  (return (x: bool)) = any
  [ return (result: bool) ->
  {[@stop_split] [@expl:gpu_h2d_async ensures] ([@stop_split] [@expl:gpu_h2d_async ensures #0] [%#sboundary] s.final.p
