    | s2 = ssd_evictor_pass [%#sdrivers'0] {_9} {batch} (fun (_x: UInt32.t) -> [ &_n <- _x ] s3)
    | s3 = -{resolve_refmut_S s}- s4
    | s4 = {[@expl:assertion] [%#sdrivers'1] forall k: UInt64.t. has g0 k /\ is_mem (ent g0 k).loc
        -> get_u64 s.current.g.dm k = get_u64 g0.dm k}
      s5
