predicate index_Mapping_Ent_bool [@inline:trivial] (self: Map.map t_Ent bool) (a: t_Ent) = [%#smapping] Map.get self a

meta "rewrite_def" predicate index_Mapping_Ent_bool

function such_that_Ent (p'0: Map.map t_Ent bool) : t_Ent

axiom such_that_Ent_spec:
  forall p'0: Map.map t_Ent bool [such_that_Ent p'0]. ([%#slogic] exists x: t_Ent. index_Mapping_Ent_bool p'0 x)
    -> ([%#slogic'0] index_Mapping_Ent_bool p'0 (such_that_Ent p'0))

function unwrap_Option_Ent (self: t_Option_Ent) : t_Ent = [%#soption'0] match self with
    | Some'1 x -> x
    | None'1 -> such_that_Ent (fun (__0: t_Ent) -> true)
    end

function lookup_u64 [@inline:trivial] (self: t_FMap_u64_Ent) (k: UInt64.t) : t_Ent =
  [%#sfmap'1] unwrap_Option_Ent (get_u64 self k)

meta "rewrite_def" function lookup_u64

function ent [#"/home/cornel/repair-j33-rc26/components/dispatcher/verif-creusot/src/core.rs" 336 0 336 31] (w: t_W) (k: UInt64.t) : t_Ent
 = [%#score'1] lookup_u64 w.dm k

let ssd_evictor_pass (s: MutBorrow.t t_S) (batch_size: UInt64.t) (return (x: UInt32.t)) =
{[@stop_split] [@expl:ssd_evictor_pass requires] [%#sbg] UInt64.t'int s.current.p.nd > 0}
  any
  [ return (result: UInt32.t) ->
  {[@stop_split] [@expl:ssd_evictor_pass ensures] ([@stop_split] [@expl:ssd_evictor_pass ensures #0] [%#sbg'0] s.final.p
      = s.current.p)
    /\ ([@stop_split] [@expl:ssd_evictor_pass ensures #1] [%#sbg'1] forall k: UInt64.t. has s.current.g k
          /\ is_mem (ent s.current.g k).loc -> get_u64 s.final.g.dm k = get_u64 s.current.g.dm k)
    /\ ([@stop_split] [@expl:ssd_evictor_pass ensures #2] [%#sbg'2] forall k: UInt64.t. has s.current.g k
          /\ (UInt32.t'int (ent s.current.g k).rr > 0 \/ UInt32.t'int (ent s.current.g k).wr > 0)
        -> get_u64 s.final.g.dm k = get_u64 s.current.g.dm k)
    /\ ([@stop_split] [@expl:ssd_evictor_pass ensures #3] [%#sbg'3] forall k: UInt64.t. has s.final.g k
      -> has s.current.g k)}
    (! return {result}) ]

predicate resolve_refmut_S [@inline:trivial] (_1: MutBorrow.t t_S) = _1.final = _1.current

meta "rewrite_def" predicate resolve_refmut_S

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

