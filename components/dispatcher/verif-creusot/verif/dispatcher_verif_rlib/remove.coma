let dm_lookup (s: MutBorrow.t t_S) (k: UInt64.t) (return (x: t_Result_Lr_DmE)) = any
  [ return (result: t_Result_Lr_DmE) ->
  {[@stop_split] [@expl:dm_lookup ensures] ([@stop_split] [@expl:dm_lookup ensures #0] [%#sboundary] s.final.p
      = s.current.p)
    /\ ([@stop_split] [@expl:dm_lookup ensures #1] [%#sboundary'0] match result with
      | Ok'0 (NotExist) -> not has s.current.g k /\ s.final.g = s.current.g
      | Ok'0 (Mismatch) -> false
      | Ok'0 r -> has s.current.g k
      /\ UInt32.t'int (ent s.current.g k).wr = 0
      /\ UInt32.t'int (ent s.current.g k).rr < UInt32.t'int const_MAX
      /\ r = lr_of (ent s.current.g k).loc /\ ent_rr s.current.g s.final.g k 1 /\ only_dm s.current.g s.final.g
      | Err'0 (Timeout'1) -> has s.current.g k /\ UInt32.t'int (ent s.current.g k).wr > 0 /\ s.final.g = s.current.g
      | Err'0 (Overflow'1) -> has s.current.g k
      /\ UInt32.t'int (ent s.current.g k).wr = 0
      /\ UInt32.t'int (ent s.current.g k).rr = UInt32.t'int const_MAX /\ s.final.g = s.current.g
      | Err'0 _ -> false
      end)}
    (! return {result}) ]

let elim_Ok (_x: t_Result_Lr_DmE) (return (f0: t_Lr)) = any
  [ _k (f0: t_Lr) -> {Ok'0 f0 = _x} (! return {f0})
  | _chk -> (! {[@expl:elim Ok] match _x with
      | Ok'0 _ -> true
      | _ -> false
      end}
    any) ]

type t_Result_unit_DmE = Ok'1 () | Err'1 t_DmE

predicate persisted [#"/home/cornel/repair-dispatcher-remove/components/dispatcher/verif-creusot/src/core.rs" 356 0 356 32] (l: t_Loc) =
  [%#score'9] match l with
    | Mem'0 _ _ ssd -> ssd <> None'0
    | Blk'0 _ -> false
    end

function demoted_loc [#"/home/cornel/repair-dispatcher-remove/components/dispatcher/verif-creusot/src/core.rs" 369 0 369 33] (l: t_Loc) : t_Loc
 = [%#score'10] match l with
    | Mem'0 _ _ (Some'0 o) -> Blk'0 o
    | _ -> l
    end

let dm_convert_memory_tier_to_block (s: MutBorrow.t t_S) (k: UInt64.t) (return (x: t_Result_unit_DmE)) = any
  [ return (result: t_Result_unit_DmE) ->
  {[@stop_split] [@expl:dm_convert_memory_tier_to_block ensures] ([@stop_split] [@expl:dm_convert_memory_tier_to_block ensures #0] [%#sboundary'1] s.final.p
      = s.current.p)
    /\ ([@stop_split] [@expl:dm_convert_memory_tier_to_block ensures #1] [%#sboundary'2] match result with
      | Ok'1 () -> has s.current.g k
      /\ persisted (ent s.current.g k).loc
      /\ has s.final.g k
      /\ (ent s.final.g k).loc = demoted_loc (ent s.current.g k).loc
      /\ (ent s.final.g k).es = (ent s.current.g k).es
      /\ (ent s.final.g k).rr = (ent s.current.g k).rr
      /\ (ent s.final.g k).wr = (ent s.current.g k).wr
      /\ others s.current.g s.final.g k /\ only_dm s.current.g s.final.g
      | Err'1 (KeyNotFound'1) -> not has s.current.g k /\ s.final.g = s.current.g
      | Err'1 (InvalidState'1) -> has s.current.g k /\ not persisted (ent s.current.g k).loc /\ s.final.g = s.current.g
      | Err'1 _ -> false
      end)}
    (! return {result}) ]

let is_ok_unit (self_: t_Result_unit_DmE) (return (x: bool)) = any
  [ return (result: bool) -> {[@stop_split] [@expl:is_ok ensures] [%#sresult] result = (exists t: (). self_ = Ok'1 t)}
    (! return {result}) ]

