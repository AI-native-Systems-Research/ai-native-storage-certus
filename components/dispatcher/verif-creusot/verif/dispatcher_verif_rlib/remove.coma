 = [%#score'0] lookup_u64 w.dm k

constant const_MAX: UInt32.t = (4294967295: UInt32.t)

function lr_of [#"/home/cornel/repair-j33-rc21/components/dispatcher/verif-creusot/src/core.rs" 367 0 367 26] (l: t_Loc) : t_Lr
 = [%#score'6] match l with
