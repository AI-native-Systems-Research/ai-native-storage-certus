let elim_Mem (_x: t_Lr) (return (ptr: UInt64.t) (size'1: UInt32.t)) = any
  [ _k (ptr: UInt64.t) (size'1: UInt32.t) -> {Mem ptr size'1 = _x} (! return {ptr} {size'1})
  | _chk -> (! {[@expl:elim Mem] match _x with
      | Mem _ _ -> true
      | _ -> false
      end}
    any) ]

type t_Result_unit_DmE = Ok'1 () | Err'1 t_DmE

