type t_Vec_Ipc_Global

type t_Be = { key: UInt64.t; regions: t_Vec_Ipc_Global }

let len_Be (self_: Slice64.slice t_Be) (return (x: UInt64.t)) = any
  [ return (result: UInt64.t) -> {[@stop_split] [@expl:len ensures] [%#sslice] Seq.length (Slice64.view self_)
    = UInt64.t'int result}
    (! return {result}) ]

type t_Ipc = { addr: UInt64.t; size: UInt32.t }

constant const_MAX: UInt64.t = (18446744073709551615: UInt64.t)

function view_Vec_Ipc_Global (self: t_Vec_Ipc_Global) : Seq.seq t_Ipc

axiom view_Vec_Ipc_Global_spec:
  forall self: t_Vec_Ipc_Global [view_Vec_Ipc_Global self]. [%#svec'2] Seq.length (view_Vec_Ipc_Global self)
    <= UInt64.t'int const_MAX

let len_Ipc (self_: t_Vec_Ipc_Global) (return (x: UInt64.t)) = any
  [ return (result: UInt64.t) -> {[@stop_split] [@expl:len ensures] [%#svec] UInt64.t'int result
    = Seq.length (view_Vec_Ipc_Global self_)}
    (! return {result}) ]

predicate in_bounds_usize [@inline:trivial] (self: UInt64.t) (seq: Seq.seq t_Ipc) =
  [%#sslice'0] UInt64.t'int self < Seq.length seq

meta "rewrite_def" predicate in_bounds_usize

predicate has_value_usize [@inline:trivial] (self: UInt64.t) (seq: Seq.seq t_Ipc) (out: t_Ipc) =
  [%#sslice'1] Seq.get seq (UInt64.t'int self) = out

meta "rewrite_def" predicate has_value_usize

let index_Vec_Ipc_Global (self_: t_Vec_Ipc_Global) (ix: UInt64.t) (return (x: t_Ipc)) =
{[@stop_split] [@expl:index requires] [%#svec'0] in_bounds_usize ix (view_Vec_Ipc_Global self_)}
  any
  [ return (result: t_Ipc) ->
  {[@stop_split] [@expl:index ensures] [%#svec'1] has_value_usize ix (view_Vec_Ipc_Global self_) result}
    (! return {result}) ]

meta "compute_max_steps" 1000000

