let lookup_retry (s: MutBorrow.t t_S) (k: UInt64.t) (return (x: tup2_Result_Lr_DmE_Snapshot_u32)) = any
  [ return (result: tup2_Result_Lr_DmE_Snapshot_u32) ->
  {[@stop_split] [@expl:lookup_retry ensures] ([@stop_split] [@expl:lookup_retry ensures #0] [%#sbatch] s.final.p
      = s.current.p)
    /\ ([@stop_split] [@expl:lookup_retry ensures #1] [%#sbatch'0] UInt32.t'int result.f1 <= 5)
    /\ ([@stop_split] [@expl:lookup_retry ensures #2] [%#sbatch'1] match result.f0 with
      | Ok (NotExist) -> not has s.current.g k /\ s.final.g = s.current.g
      | Ok (Mismatch) -> false
      | Ok r -> has s.current.g k
      /\ UInt32.t'int (ent s.current.g k).wr = 0
      /\ UInt32.t'int (ent s.current.g k).rr < UInt32.t'int const_MAX
      /\ r = lr_of (ent s.current.g k).loc /\ ent_rr s.current.g s.final.g k 1 /\ only_dm s.current.g s.final.g
      | Err _ -> has s.current.g k
      /\ (UInt32.t'int (ent s.current.g k).wr > 0 \/ UInt32.t'int (ent s.current.g k).rr = UInt32.t'int const_MAX)
      /\ s.final.g = s.current.g
      end)}
    (! return {result}) ]

