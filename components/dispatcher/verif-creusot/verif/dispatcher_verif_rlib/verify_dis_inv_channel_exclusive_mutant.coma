  [ return (result: t_Option_u64) ->
  {[@stop_split] [@expl:chan_pool_checkout ensures] ([@stop_split] [@expl:chan_pool_checkout ensures #0] [%#sbg'0] s.final.p
        = s.current.p
      /\ nodup (view_Vec_u64_Global free.final))
    /\ ([@stop_split] [@expl:chan_pool_checkout ensures #1] [%#sbg'1] match result with
      | Some'0 c'0 -> (forall i: int. 0 <= i /\ i < Seq.length (view_Vec_u64_Global free.final)
          -> Seq.get (view_Vec_u64_Global free.final) i <> c'0)
