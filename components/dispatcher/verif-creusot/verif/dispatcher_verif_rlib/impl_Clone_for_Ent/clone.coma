(* <Ent as std::clone::Clone> *)

use creusot.int.UInt64
use creusot.int.UInt32
use creusot.prelude.Any

type t_Option_u64 = None | Some UInt64.t

type t_Loc = Mem UInt64.t UInt32.t t_Option_u64 | Blk UInt64.t

type t_Ent = { loc: t_Loc; es: UInt32.t; rr: UInt32.t; wr: UInt32.t }

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let clone_Ent [#"/home/cornel/repair-j33-rc24/components/dispatcher/verif-creusot/src/core.rs" 27 9 27 29] (self: t_Ent)
  (return (x: t_Ent)) = (! bb0
  [ bb0 = s0 [ s0 = [ &_ret <- self ] s1 | s1 = return {_ret} ] ]
  [ & _ret: t_Ent = Any.any_l () | & self: t_Ent = self ]) [ return (result: t_Ent) -> (! return {result}) ]
