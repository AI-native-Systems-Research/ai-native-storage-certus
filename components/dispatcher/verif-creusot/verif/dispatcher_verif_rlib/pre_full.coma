let%span score = "/home/cornel/repair-j33-rc29/components/dispatcher/verif-creusot/src/core.rs" 555 10 555 38
let%span score'0 = "/home/cornel/repair-j33-rc29/components/dispatcher/verif-creusot/src/core.rs" 544 16 544 43
let%span score'1 = "/home/cornel/repair-j33-rc29/components/dispatcher/verif-creusot/src/core.rs" 529 10 529 17
let%span score'2 = "/home/cornel/repair-j33-rc29/components/dispatcher/verif-creusot/src/core.rs" 531 16 531 107

use creusot.int.UInt64
use creusot.int.UInt32
use seq.Seq
use int.Int

type t_Ipc = { addr: UInt64.t; size: UInt32.t }

function sum_sz [#"/home/cornel/repair-j33-rc29/components/dispatcher/verif-creusot/src/core.rs" 530 0 530 33] (r: Seq.seq t_Ipc) : int

axiom sum_sz_def: forall r: Seq.seq t_Ipc [sum_sz r]. sum_sz r
    = ([%#score'2] if Seq.length r = 0 then
      0
    else
      sum_sz (Seq.([..]) r 0 (Seq.length r - 1)) + UInt32.t'int (Seq.get r (Seq.length r - 1)).size
    )

function pre [#"/home/cornel/repair-j33-rc29/components/dispatcher/verif-creusot/src/core.rs" 543 0 543 38] (r: Seq.seq t_Ipc) (i: int) : int
 = [%#score'0] sum_sz (Seq.([..]) r 0 i)

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant r : Seq.seq t_Ipc

function pre_full [#"/home/cornel/repair-j33-rc29/components/dispatcher/verif-creusot/src/core.rs" 556 0 556 28] (r: Seq.seq t_Ipc) : ()

goal vc_pre_full: Seq.([..]) r 0 (Seq.length r) = r
  && ([@stop_split] [@expl:pre_full ensures] [%#score] pre r (Seq.length r) = sum_sz r)
