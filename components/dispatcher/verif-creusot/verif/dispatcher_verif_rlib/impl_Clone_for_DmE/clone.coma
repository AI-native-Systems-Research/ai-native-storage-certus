(* <DmE as std::clone::Clone> *)

use creusot.prelude.Any

type t_DmE =
  | KeyNotFound
  | AlreadyExists
  | ActiveRefs
  | Timeout
  | InvalidSize
  | Underflow
  | Overflow
  | NoWrite
