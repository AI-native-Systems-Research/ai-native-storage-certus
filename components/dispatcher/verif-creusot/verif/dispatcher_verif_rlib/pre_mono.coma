use creusot.int.UInt64
use creusot.int.UInt32
use seq.Seq
use int.Int

type t_Ipc = { addr: UInt64.t; size: UInt32.t }

function sum_sz [#"/home/cornel/repair-j33-rc4/components/dispatcher/verif-creusot/src/core.rs" 527 0 527 33] (r: Seq.seq t_Ipc) : int

axiom sum_sz_def: forall r: Seq.seq t_Ipc [sum_sz r]. sum_sz r
    = ([%#score'7] if Seq.length r = 0 then
      0
    else
      sum_sz (Seq.([..]) r 0 (Seq.length r - 1)) + UInt32.t'int (Seq.get r (Seq.length r - 1)).size
    )

function pre [#"/home/cornel/repair-j33-rc4/components/dispatcher/verif-creusot/src/core.rs" 540 0 540 38] (r: Seq.seq t_Ipc) (i: int) : int
 = [%#score'4] sum_sz (Seq.([..]) r 0 i)

predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
  [%#swell_founded] self >= 0 /\ self > other

meta "rewrite_def" predicate well_founded_relation_Int

function pre_step [#"/home/cornel/repair-j33-rc4/components/dispatcher/verif-creusot/src/core.rs" 547 0 547 36] (r: Seq.seq t_Ipc) (i: int) : ()
 = [%#score'5] ()

axiom pre_step_spec: forall r: Seq.seq t_Ipc, i: int. ([%#score'2] 0 <= i /\ i < Seq.length r)
    -> ([%#score'3] pre r (i + 1) = pre r i + UInt32.t'int (Seq.get r i).size)

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant r : Seq.seq t_Ipc

constant i : int

constant j : int

function pre_mono [#"/home/cornel/repair-j33-rc4/components/dispatcher/verif-creusot/src/core.rs" 567 0 567 44] (r: Seq.seq t_Ipc) (i: int) (j: int) : ()

goal vc_pre_mono: ([%#score'0] 0 <= i /\ i <= j /\ j <= Seq.length r)
  -> (if i < j then
    (([@stop_split] [@expl:pre_mono requires] [%#score'0] 0 <= i /\ i <= j - 1 /\ j - 1 <= Seq.length r)
      /\ ([@expl:variant decreases] well_founded_relation_Int ([%#score] j - i) ([%#score] j - 1 - i)))
    /\ (([@stop_split] [@expl:pre_mono ensures] [%#score'1] pre r i <= pre r (j - 1))
    -> (let _ = pre_mono r i (j - 1) in ([@stop_split] [@expl:pre_step requires] [%#score'2] 0 <= j - 1
      /\ j - 1 < Seq.length r)
    /\ (([@stop_split] [@expl:pre_step ensures] [%#score'3] pre r (j - 1 + 1)
      = pre r (j - 1) + UInt32.t'int (Seq.get r (j - 1)).size)
    -> (let _ = pre_step r (j - 1) in [@stop_split] [@expl:pre_mono ensures] [%#score'1] pre r i <= pre r j))))
  else
    [@stop_split] [@expl:pre_mono ensures] [%#score'1] pre r i <= pre r j
  )
