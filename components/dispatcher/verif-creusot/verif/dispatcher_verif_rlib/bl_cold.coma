  | D2H UInt64.t UInt64.t UInt64.t UInt64.t
  | Sync UInt64.t
  | MtTouch UInt64.t
  | MtGet UInt64.t
  | MtBatchTouch
  | MtRemove UInt64.t
  | MtInsert UInt64.t
  | DmTouch UInt64.t
  | DmDemote UInt64.t
  | DmRemove UInt64.t
  | DmCreate UInt64.t
  | DmPromote UInt64.t
  | RelRead UInt64.t int
  | RelWrite UInt64.t int
  | Enq t_Job
  | ExtFree UInt64.t UInt64.t
  | Recover UInt64.t UInt64.t UInt32.t
  | EmFormat UInt64.t
  | EmInit UInt64.t
  | Checkpoint UInt64.t
  | DevSignal UInt64.t
  | DevShutdown UInt64.t
  | DevDetach UInt64.t
  | Register
  | Unregister
  | Join
  | Leave
  | SsdRead UInt64.t UInt64.t
  | SsdWrite UInt64.t UInt64.t
  | RemoteFwd UInt64.t UInt32.t
  | Spawn
  | Cpu UInt64.t t_Option_usize

type t_Ext = { key'0: UInt64.t; off'0: UInt64.t; size'0: UInt32.t }

type t_W = {
  dm: t_FMap_u64_Ent;
  mt: t_FMap_u64_Slot;
  used: int;
  cap: int;
  c: t_Ctr;
  wq: Seq.seq t_Job;
  log: Seq.seq t_Ev;
  tick: int;
  ob: Map.map int bool;
  ob2: Map.map int bool;
  og: Map.map int bool;
  os: Map.map int bool;
  ov: Map.map int UInt64.t;
  ok: Map.map int (Seq.seq UInt64.t);
  ext: Map.map int (Seq.seq t_Ext);
  pool: bool;
  cluster: bool;
  threads: int;
  rw: Map.map int UInt64.t;
  cfree: Map.map int int;
  wf: Map.map UInt64.t bool }

type t_S = { p: t_P; g: t_W }

type t_Vec_Option_Result_unit_DE_Global

type t_Vec_ColdE_Global

type t_ColdE = { idx'1: UInt64.t; key'1: UInt64.t; off'1: UInt64.t; total'1: UInt32.t }

constant const_MAX: UInt64.t = (18446744073709551615: UInt64.t)

function view_Vec_ColdE_Global (self: t_Vec_ColdE_Global) : Seq.seq t_ColdE

axiom view_Vec_ColdE_Global_spec:
  forall self: t_Vec_ColdE_Global [view_Vec_ColdE_Global self]. [%#svec] Seq.length (view_Vec_ColdE_Global self)
    <= UInt64.t'int const_MAX

type t_Ni = Dispatcher | DispatchMap | MemoryTier | Gpu | Spdk | Logger | Ring

type t_IoK =
  | Partition'0 UInt64.t UInt64.t UInt64.t
  | Drive'0 UInt64.t
  | Gpu'0
  | Sync'0
  | Ssd'0
  | Promote'0
  | Dm'0
  | Remote'0
  | Stream'0
  | Channel'0
  | Other'0

type t_DE = NotInit t_Ni | InvalidParam | KeyNotFound UInt64.t | AlreadyExists UInt64.t | Alloc | Io t_IoK | Timeout

type t_Result_unit_DE = Ok () | Err t_DE

type t_Option_Result_unit_DE = None'0 | Some'0 t_Result_unit_DE

function view_Vec_Option_Result_unit_DE_Global (self: t_Vec_Option_Result_unit_DE_Global) : Seq.seq t_Option_Result_unit_DE

axiom view_Vec_Option_Result_unit_DE_Global_spec:
  forall self: t_Vec_Option_Result_unit_DE_Global [view_Vec_Option_Result_unit_DE_Global self]. [%#svec] Seq.length (view_Vec_Option_Result_unit_DE_Global self)
    <= UInt64.t'int const_MAX

predicate log_ext [#"/home/cornel/repair-j33-rc26/components/dispatcher/verif-creusot/src/core.rs" 422 0 422 34] (a: t_W) (b: t_W) =
  [%#score'3] Seq.length a.log <= Seq.length b.log
  /\ (forall i: int. 0 <= i /\ i < Seq.length a.log -> Seq.get b.log i = Seq.get a.log i)

predicate same_env [#"/home/cornel/repair-j33-rc26/components/dispatcher/verif-creusot/src/core.rs" 673 0 673 35] (a: t_W) (b: t_W) =
  [%#score'4] b.pool = a.pool
  /\ b.cluster = a.cluster
  /\ b.cap = a.cap
  /\ b.ext = a.ext
  /\ b.rw = a.rw
  /\ b.ob = a.ob
  /\ b.ob2 = a.ob2
  /\ b.og = a.og /\ b.os = a.os /\ b.ov = a.ov /\ b.ok = a.ok /\ b.threads = a.threads /\ b.cfree = a.cfree

function count_true [#"/home/cornel/repair-j33-rc26/components/dispatcher/verif-creusot/src/batch.rs" 341 0 341 46] (s: Seq.seq bool) (n: int) : int

axiom count_true_def: forall s: Seq.seq bool, n: int [count_true s n]. count_true s n
    = ([%#sbatch'84] if n <= 0 then 0 else count_true s (n - 1) + (if Seq.get s (n - 1) then 1 else 0))

predicate rd_ctr [#"/home/cornel/repair-j33-rc26/components/dispatcher/verif-creusot/src/lookup.rs" 115 0 115 37] (a: t_Ctr) (b: t_Ctr) =
  [%#slookup] a.ev_ssd = b.ev_ssd
  /\ a.hit_dram = b.hit_dram
  /\ a.hit_ssd = b.hit_ssd
  /\ a.r_hit = b.r_hit
  /\ a.r_miss = b.r_miss
  /\ a.bp = b.bp
  /\ a.drop_full = b.drop_full
  /\ a.promo_mem <= b.promo_mem
  /\ a.promo_gpu <= b.promo_gpu
  /\ a.already <= b.already
  /\ a.ev_mem <= b.ev_mem /\ a.blk_pin <= b.blk_pin /\ a.exhausted <= b.exhausted /\ a.blk_unp <= b.blk_unp

predicate no_reg [#"/home/cornel/repair-j33-rc26/components/dispatcher/verif-creusot/src/core.rs" 680 0 680 33] (a: t_W) (b: t_W) =
  [%#score'0] forall i: int. Seq.length a.log <= i /\ i < Seq.length b.log
    -> match Seq.get b.log i with
      | DmCreate _ -> false
      | Enq _ -> false
      | _ -> true
