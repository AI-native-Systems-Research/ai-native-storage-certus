use seq.Seq
use creusot.int.UInt64
use creusot.int.UInt32
use map.Map
use creusot.int.Int32
use creusot.prelude.MutBorrow
use creusot.slice.Slice64
use creusot.slice.Slice64Ops
use creusot.prelude.Any
use int.Int

type t_Vec_ColdE_Global

type t_ColdE = { idx: UInt64.t; key: UInt64.t; off: UInt64.t; total: UInt32.t }

constant const_MAX: UInt64.t = (18446744073709551615: UInt64.t)

function view_Vec_ColdE_Global (self: t_Vec_ColdE_Global) : Seq.seq t_ColdE

axiom view_Vec_ColdE_Global_spec:
  forall self: t_Vec_ColdE_Global [view_Vec_ColdE_Global self]. [%#svec'0] Seq.length (view_Vec_ColdE_Global self)
    <= UInt64.t'int const_MAX

let len_ColdE (self_: t_Vec_ColdE_Global) (return (x: UInt64.t)) = any
  [ return (result: UInt64.t) -> {[@stop_split] [@expl:len ensures] [%#svec] UInt64.t'int result
    = Seq.length (view_Vec_ColdE_Global self_)}
    (! return {result}) ]

function index_Vec_ColdE_Global [@inline:trivial] (self: t_Vec_ColdE_Global) (ix: UInt64.t) : t_ColdE =
  [%#svec'1] Seq.get (view_Vec_ColdE_Global self) (UInt64.t'int ix)

meta "rewrite_def" function index_Vec_ColdE_Global

type t_P = {
  init: bool;
  has_dm: bool;
  has_mt: bool;
  has_gpu: bool;
  has_spdk: bool;
  has_factory: bool;
  has_rl: bool;
  has_logger: bool;
  max_att: UInt64.t;
  bp_ms: UInt64.t;
  nd: UInt64.t;
  writer: bool;
  ssd_ev: bool;
  mt_ev: bool;
  ring: bool;
  chunk: UInt64.t;
  stg: bool;
  stg_bytes: UInt64.t;
  warm: UInt64.t }

type t_FMap_u64_Ent

type t_FMap_u64_Slot

type t_Ctr = {
  promo_mem: int;
  promo_gpu: int;
  ev_mem: int;
  ev_ssd: int;
  hit_dram: int;
  hit_ssd: int;
  r_hit: int;
  r_miss: int;
  bp: int;
  drop_full: int;
  already: int;
  blk_pin: int;
  exhausted: int;
  blk_unp: int }

type t_Job = { key'0: UInt64.t; size'0: UInt32.t; dev'0: UInt64.t }

type t_Option_usize = None | Some UInt64.t

type t_Ev =
  | H2D UInt64.t UInt64.t UInt64.t UInt64.t
  | D2H UInt64.t UInt64.t UInt64.t UInt64.t
  | Sync UInt64.t
  | MtTouch UInt64.t
  | MtGet UInt64.t
  | MtBatchTouch
  | MtRemove UInt64.t
  | MtInsert UInt64.t
  | DmTouch UInt64.t
  | DmDemote UInt64.t
  | DmRemove UInt64.t
  | DmCreate UInt64.t
  | DmPromote UInt64.t
  | RelRead UInt64.t int
  | RelWrite UInt64.t int
  | Enq t_Job
  | ExtFree UInt64.t UInt64.t
  | Recover UInt64.t UInt64.t UInt32.t
  | EmFormat UInt64.t
  | EmInit UInt64.t
  | Checkpoint UInt64.t
  | DevSignal UInt64.t
