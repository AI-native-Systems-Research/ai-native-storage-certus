function sum_sz [#"/home/cornel/repair-j35-rc23/components/dispatcher/verif-creusot/src/core.rs" 540 0 540 33] (r: Seq.seq t_Ipc) : int

axiom sum_sz_def: forall r: Seq.seq t_Ipc [sum_sz r]. sum_sz r
