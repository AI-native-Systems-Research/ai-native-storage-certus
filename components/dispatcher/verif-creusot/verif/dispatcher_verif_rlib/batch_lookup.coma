  {[@stop_split] [@expl:set_batch_device ensures] ([@stop_split] [@expl:set_batch_device ensures #0] [%#sboundary] s.final.p
        = s.current.p
      /\ s.final.g = nx s.current.g)
    /\ ([@stop_split] [@expl:set_batch_device ensures #1] [%#sboundary'0] Int32.to_int result'0 >= - 1)}
    (! return {result'0}) ]

type t_Ds = { warm'1: UInt64.t; store'1: UInt64.t; pipe0'1: UInt64.t; pipe1'1: UInt64.t }

type t_Option_Ds = None'1 | Some'1 t_Ds

function index_Mapping_u64_i32 [@inline:trivial] (self: Map.map UInt64.t Int32.t) (a: UInt64.t) : Int32.t =
  [%#smapping] Map.get self a

meta "rewrite_def" function index_Mapping_u64_i32

let device_streams_for (s: MutBorrow.t t_S) (device: Int32.t) (return (x: t_Option_Ds)) = any
  [ return (result'0: t_Option_Ds) ->
  {[@stop_split] [@expl:device_streams_for ensures] ([@stop_split] [@expl:device_streams_for ensures #0] [%#sboundary'1] s.final.p
        = s.current.p
      /\ s.final.g = nx s.current.g)
    /\ ([@stop_split] [@expl:device_streams_for ensures #1] [%#sboundary'2] Int32.to_int device < 0
      -> result'0 = None'1)
    /\ ([@stop_split] [@expl:device_streams_for ensures #2] [%#sboundary'3] match result'0 with
      | Some'1 ds -> Int32.to_int device >= 0
      /\ UInt64.t'int ds.warm'1 <> 0 /\ index_Mapping_u64_i32 s.current.g.sdev ds.warm'1 = device
      | None'1 -> true
      end)}
    (! return {result'0}) ]

let elim_Some (_x: t_Option_Ds) (return (f0'0: t_Ds)) = any
  [ _k (f0'0: t_Ds) -> {Some'1 f0'0 = _x} (! return {f0'0})
  | _chk -> (! {[@expl:elim Some] match _x with
