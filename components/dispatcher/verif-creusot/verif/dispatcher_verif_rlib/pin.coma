let dm_take_read (s: MutBorrow.t t_S) (k: UInt64.t) (return (x: t_Result_unit_DmE)) = any
  [ return (result: t_Result_unit_DmE) ->
  {[@stop_split] [@expl:dm_take_read ensures] ([@stop_split] [@expl:dm_take_read ensures #0] [%#sboundary] s.final.p
      = s.current.p)
    /\ ([@stop_split] [@expl:dm_take_read ensures #1] [%#sboundary'0] match result with
      | Ok'0 () -> has s.current.g k
      /\ UInt32.t'int (ent s.current.g k).wr = 0
      /\ UInt32.t'int (ent s.current.g k).rr < UInt32.t'int const_MAX
      /\ ent_rr s.current.g s.final.g k 1 /\ only_dm s.current.g s.final.g
      | Err'0 (KeyNotFound'1) -> not has s.current.g k /\ s.final.g = s.current.g
      | Err'0 (Timeout'1) -> has s.current.g k /\ UInt32.t'int (ent s.current.g k).wr > 0 /\ s.final.g = s.current.g
      | Err'0 (Overflow'1) -> has s.current.g k
      /\ UInt32.t'int (ent s.current.g k).wr = 0
      /\ UInt32.t'int (ent s.current.g k).rr = UInt32.t'int const_MAX /\ s.final.g = s.current.g
      | Err'0 _ -> false
      end)}
    (! return {result}) ]

