 = [%#score'2] lookup_u64 w.dm k

constant const_MAX: UInt32.t = (4294967295: UInt32.t)

predicate others [#"/home/cornel/repair-j35-rc23/components/dispatcher/verif-creusot/src/core.rs" 592 0 592 41] (a: t_W) (b: t_W) (k: UInt64.t) =
