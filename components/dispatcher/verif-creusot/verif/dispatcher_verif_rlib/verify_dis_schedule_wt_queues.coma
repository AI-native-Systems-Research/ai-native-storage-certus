    | s3 = MutBorrow.borrow_final <t_S> {s.current} {MutBorrow.get_id s}
        (fun (_bor: MutBorrow.t t_S) -> [ &_24 <- _bor ] [ &s <- { s with current = _bor.final } ] s4)
    | s4 = writer_step [%#sdrivers'1] {_24} (fun (_x: t_WjOut) -> [ &out <- _x ] s5)
    | s5 = -{resolve_refmut_S s}- s6
    | s6 = {[@expl:assertion] [%#sdrivers'2] match out with
        | Stored _ -> persisted (ent s.current.g key'1).loc
        | _ -> true
        end}
      s7
    | s7 = return {_ret} ] ]
  [ & _ret: () = Any.any_l ()
  | & s: MutBorrow.t t_S = s
  | & key'1: UInt64.t = key'1
  | & size'1: UInt32.t = size'1
  | & r: t_Result_unit_DE = Any.any_l ()
  | & _15: MutBorrow.t t_S = Any.any_l ()
  | & out: t_WjOut = Any.any_l ()
  | & _24: MutBorrow.t t_S = Any.any_l () ]) [ return (result: ()) -> (! return {result}) ]
