{[@stop_split] [@expl:writer_step requires] ([@stop_split] [@expl:writer_step requires #0] [%#smethods'3] a_us5_q s.current.p s.current.g.wq)
  /\ ([@stop_split] [@expl:writer_step requires #1] [%#smethods'4] Seq.length s.current.g.wq > 0)}
  any
  [ return (result: t_WjOut) ->
  {[@stop_split] [@expl:writer_step ensures] ([@stop_split] [@expl:writer_step ensures #0] [%#smethods'5] s.final.p
      = s.current.p)
    /\ ([@stop_split] [@expl:writer_step ensures #1] [%#smethods'6] s.final.g.wq
      = Seq.([..]) s.current.g.wq 1 (Seq.length s.current.g.wq))
    /\ ([@stop_split] [@expl:writer_step ensures #2] [%#smethods'7] log_ext s.current.g s.final.g
      /\ no_cpdev s.current.g s.final.g
      /\ same_env s.current.g s.final.g /\ s.final.g.mt = s.current.g.mt /\ same_ctr s.current.g.c s.final.g.c)
    /\ ([@stop_split] [@expl:writer_step ensures #3] [%#smethods'8] forall k: UInt64.t. has s.current.g k
        -> has s.final.g k)
