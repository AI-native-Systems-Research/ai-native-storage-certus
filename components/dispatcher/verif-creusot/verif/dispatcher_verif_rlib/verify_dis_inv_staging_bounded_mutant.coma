function view_Vec_usize_Global (self: t_Vec_usize_Global) : Seq.seq UInt64.t

axiom view_Vec_usize_Global_spec:
  forall self: t_Vec_usize_Global [view_Vec_usize_Global self]. [%#svec] Seq.length (view_Vec_usize_Global self)
    <= UInt64.t'int const_MAX

predicate stg_inv [#"/home/cornel/repair-j33-rc4/components/dispatcher/verif-creusot/src/bg.rs" 161 0 161 30] (p'0: t_Stg) =
  [%#sbg'2] p'0.leased >= 0
  /\ p'0.leased + Seq.length (view_Vec_usize_Global p'0.free) = UInt64.t'int p'0.slots
  /\ (forall i: int. 0 <= i /\ i < Seq.length (view_Vec_usize_Global p'0.free)
    -> UInt64.t'int (Seq.get (view_Vec_usize_Global p'0.free) i) < UInt64.t'int p'0.slots)

let stg_new (slots'0: UInt64.t) (return (x: t_Stg)) = any
  [ return (result: t_Stg) -> {[@stop_split] [@expl:stg_new ensures] [%#sbg] stg_inv result
    /\ result.leased = 0 /\ result.slots = slots'0}
    (! return {result}) ]

let stg_pool_checkout (p'0: MutBorrow.t t_Stg) (return (x: UInt64.t)) =
{[@stop_split] [@expl:stg_pool_checkout requires] [%#sbg'0] stg_inv p'0.current}
  any
  [ return (result: UInt64.t) -> {[@stop_split] [@expl:stg_pool_checkout ensures] [%#sbg'1] stg_inv p'0.final
    /\ p'0.final.leased = p'0.current.leased + 1
    /\ p'0.final.leased <= UInt64.t'int p'0.current.slots /\ UInt64.t'int result < UInt64.t'int p'0.current.slots}
    (! return {result}) ]

predicate resolve_refmut_Stg [@inline:trivial] (_1: MutBorrow.t t_Stg) = _1.final = _1.current

