(* <Outcome as std::clone::Clone> *)

use creusot.int.UInt64
use creusot.prelude.Any

type t_ServedBy = Dram | Ssd | Remote | Miss | SizeMismatch | Error

type t_Ni = Dispatcher | DispatchMap | MemoryTier | Gpu | Spdk | Logger | Ring

type t_IoK =
  | Partition'0 UInt64.t UInt64.t UInt64.t
  | Drive'0 UInt64.t
  | Gpu'0
  | Sync'0
  | Ssd'0
  | Promote'0
  | Dm'0
  | Remote'0
  | Stream'0
  | Channel'0
  | Other'0

type t_DE = NotInit t_Ni | InvalidParam | KeyNotFound UInt64.t | AlreadyExists UInt64.t | Alloc | Io t_IoK | Timeout

type t_Result_unit_DE = Ok () | Err t_DE

type t_Outcome = { served_by: t_ServedBy; result: t_Result_unit_DE }

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let clone_Outcome [#"/home/cornel/repair-j33-rc22/components/dispatcher/verif-creusot/src/batch.rs" 757 9 757 29]
  (self: t_Outcome) (return (x: t_Outcome)) = (! bb0
  [ bb0 = s0 [ s0 = [ &_ret <- self ] s1 | s1 = return {_ret} ] ]
  [ & _ret: t_Outcome = Any.any_l () | & self: t_Outcome = self ])
  [ return (result'0: t_Outcome) -> (! return {result'0}) ]
