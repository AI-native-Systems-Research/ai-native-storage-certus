let clear_memory_tier (s: MutBorrow.t t_S) (return (x: t_Result_usize_DE)) = any
  [ return (result: t_Result_usize_DE) ->
  {[@stop_split] [@expl:clear_memory_tier ensures] ([@stop_split] [@expl:clear_memory_tier ensures #0] [%#smisc] s.final.p
      = s.current.p)
    /\ ([@stop_split] [@expl:clear_memory_tier ensures #1] [%#smisc'0] not s.current.p.init
      -> result = Err (NotInit (Dispatcher)) /\ s.final.g = s.current.g)
    /\ ([@stop_split] [@expl:clear_memory_tier ensures #2] [%#smisc'1] s.current.p.init
        /\ s.current.p.has_dm /\ s.current.p.has_mt
      -> match result with
        | Ok _ -> len_u64'0 s.final.g.mt = 0
        | Err (Timeout) -> true
        | Err _ -> false
        end)
    /\ ([@stop_split] [@expl:clear_memory_tier ensures #3] [%#smisc'2] forall k: UInt64.t. has s.current.g k
          /\ (UInt32.t'int (ent s.current.g k).rr > 0 \/ UInt32.t'int (ent s.current.g k).wr > 0)
        -> get_u64 s.final.g.dm k = get_u64 s.current.g.dm k)
    /\ ([@stop_split] [@expl:clear_memory_tier ensures #4] [%#smisc'3] forall k: UInt64.t. has s.current.g k
          /\ (UInt32.t'int (ent s.current.g k).rr > 0 \/ UInt32.t'int (ent s.current.g k).wr > 0)
          /\ mt_has s.current.g k -> mt_has s.final.g k)
    /\ ([@stop_split] [@expl:clear_memory_tier ensures #5] [%#smisc'4] log_ext s.current.g s.final.g
    /\ mono_ctr s.current.g.c s.final.g.c /\ s.final.g.wq = s.current.g.wq /\ same_env s.current.g s.final.g)}
    (! return {result}) ]

