use seq.Seq
use int.Int

predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
  [%#swell_founded] self >= 0 /\ self > other

meta "rewrite_def" predicate well_founded_relation_Int

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant s : Seq.seq bool

constant n : int

function count_true [#"/home/cornel/repair-j33-rc26/components/dispatcher/verif-creusot/src/batch.rs" 341 0 341 46] (s: Seq.seq bool) (n: int) : int

goal vc_count_true: if n <= 0 then
    true
  else
    [@expl:variant decreases] well_founded_relation_Int ([%#sbatch] n) ([%#sbatch] n - 1)
  
