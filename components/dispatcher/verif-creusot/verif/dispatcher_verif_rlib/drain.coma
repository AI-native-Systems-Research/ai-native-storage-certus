    /\ ([@stop_split] [@expl:drain ensures #3] [%#smethods'15] forall k: UInt64.t. has s.current.g k
          /\ persisted (ent s.current.g k).loc -> persisted (ent s.final.g k).loc)
    /\ ([@stop_split] [@expl:drain ensures #4] [%#smethods'16] forall i: int. 0 <= i /\ i < Seq.length result
      -> has s.final.g (Seq.get result i) /\ persisted (ent s.final.g (Seq.get result i)).loc)}
    (! return {result}) ]
