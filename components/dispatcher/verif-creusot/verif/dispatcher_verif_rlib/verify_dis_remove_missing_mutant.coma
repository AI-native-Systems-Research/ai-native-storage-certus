let remove (s: MutBorrow.t t_S) (k: UInt64.t) (return (x: t_Result_unit_DE)) = any
  [ return (result: t_Result_unit_DE) ->
  {[@stop_split] [@expl:remove ensures] ([@stop_split] [@expl:remove ensures #0] [%#smethods] s.final.p = s.current.p)
    /\ ([@stop_split] [@expl:remove ensures #1] [%#smethods'0] not s.current.p.init
      -> result = Err (NotInit (Dispatcher)) /\ s.final.g = s.current.g)
    /\ ([@stop_split] [@expl:remove ensures #2] [%#smethods'1] s.current.p.init
        /\ s.current.p.has_dm /\ not has s.current.g k -> result = Err (KeyNotFound k) /\ s.final.g = s.current.g)
    /\ ([@stop_split] [@expl:remove ensures #3] [%#smethods'2] s.current.p.init
        /\ s.current.p.has_dm
        /\ has s.current.g k /\ UInt32.t'int (ent s.current.g k).rr = 0 /\ UInt32.t'int (ent s.current.g k).wr = 0
      -> result = Ok ())
    /\ ([@stop_split] [@expl:remove ensures #4] [%#smethods'3] s.current.p.init
        /\ s.current.p.has_dm /\ s.current.p.has_mt
      -> match result with
        | Ok () -> has s.current.g k
        /\ not has s.final.g k
        /\ not mt_has s.final.g k
        /\ (UInt64.t'int s.current.p.nd = 0
        \/ match (ent s.current.g k).loc with
          | Blk off -> logged s.current.g s.final.g (ExtFree (di k s.current.p.nd) off)
          | Mem _ _ (Some'0 off) -> logged s.current.g s.final.g (ExtFree (di k s.current.p.nd) off)
          | _ -> true
          end)
        | _ -> true
        end)
    /\ ([@stop_split] [@expl:remove ensures #5] [%#smethods'4] forall j: UInt64.t. j <> k
        -> get_u64 s.final.g.dm j = get_u64 s.current.g.dm j /\ get_u64'0 s.final.g.mt j = get_u64'0 s.current.g.mt j)
    /\ ([@stop_split] [@expl:remove ensures #6] [%#smethods'5] log_ext s.current.g s.final.g
      /\ same_ctr s.current.g.c s.final.g.c)
    /\ ([@stop_split] [@expl:remove ensures #7] [%#smethods'6] s.current.p.init /\ s.current.p.has_dm
    -> own_reads s.current.g s.final.g)}
    (! return {result}) ]

predicate resolve_refmut_S [@inline:trivial] (_1: MutBorrow.t t_S) = _1.final = _1.current

meta "rewrite_def" predicate resolve_refmut_S

predicate pinv [#"/home/cornel/repair-j35-rc8/components/dispatcher/verif-creusot/src/core.rs" 619 0 619 25] (p'0: t_P) =
