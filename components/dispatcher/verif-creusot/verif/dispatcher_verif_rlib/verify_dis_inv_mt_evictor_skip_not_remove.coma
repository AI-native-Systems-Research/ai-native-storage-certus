let mt_evictor_pass (s: MutBorrow.t t_S) (scan_size: UInt64.t) (return (x: UInt32.t)) = any
  [ return (result: UInt32.t) ->
  {[@stop_split] [@expl:mt_evictor_pass ensures] ([@stop_split] [@expl:mt_evictor_pass ensures #0] [%#sbg] s.final.p
        = s.current.p
      /\ evict_frame s.current.g s.final.g /\ s.final.g.wq = s.current.g.wq /\ mono_ctr s.current.g.c s.final.g.c)
    /\ ([@stop_split] [@expl:mt_evictor_pass ensures #1] [%#sbg'0] forall k: UInt64.t. has s.current.g k
        /\ not evictable s.current.g k
      -> get_u64 s.final.g.dm k = get_u64 s.current.g.dm k /\ get_u64'0 s.final.g.mt k = get_u64'0 s.current.g.mt k)}
    (! return {result}) ]

