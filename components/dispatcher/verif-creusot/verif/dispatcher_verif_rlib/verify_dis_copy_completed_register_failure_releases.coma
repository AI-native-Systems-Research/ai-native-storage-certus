function wjob [#"/home/cornel/repair-j35-rc8/components/dispatcher/verif-creusot/src/store.rs" 135 0 135 45] (p'0: t_P) (key'1: UInt64.t) (size'2: UInt32.t) : t_Job
 = [%#sstore'5] { key = key'1;
                  size = size'2;
                  dev = di key'1 (if UInt64.t'int p'0.nd = 0 then (1: UInt64.t) else p'0.nd) }

let copy_gpu_to_memory_completed (s: MutBorrow.t t_S) (key'1: UInt64.t) (size'2: UInt32.t)
  (return (x: t_Result_unit_DE)) =
{[@stop_split] [@expl:copy_gpu_to_memory_completed requires] [%#sstore] pinv s.current.p}
  any
  [ return (result: t_Result_unit_DE) ->
  {[@stop_split] [@expl:copy_gpu_to_memory_completed ensures] ([@stop_split] [@expl:copy_gpu_to_memory_completed ensures #0] [%#sstore'0] s.final.p
      = s.current.p)
    /\ ([@stop_split] [@expl:copy_gpu_to_memory_completed ensures #1] [%#sstore'1] not s.current.p.init
      -> result = Err (NotInit (Dispatcher)) /\ s.final.g = s.current.g)
    /\ ([@stop_split] [@expl:copy_gpu_to_memory_completed ensures #2] [%#sstore'2] same_ctr s.current.g.c s.final.g.c
      /\ same_env s.current.g s.final.g /\ log_ext s.current.g s.final.g /\ no_dma s.current.g s.final.g)
    /\ ([@stop_split] [@expl:copy_gpu_to_memory_completed ensures #3] [%#sstore'3] others s.current.g s.final.g key'1
      /\ (forall j: UInt64.t. j <> key'1 -> get_u64'0 s.final.g.mt j = get_u64'0 s.current.g.mt j))
    /\ ([@stop_split] [@expl:copy_gpu_to_memory_completed ensures #4] [%#sstore'4] s.current.p.init
    -> match result with
      | Err (KeyNotFound k) -> k = key'1 /\ not mt_has s.current.g key'1 /\ s.final.g = s.current.g
      | Err (AlreadyExists k) -> k = key'1
      /\ mt_has s.current.g key'1
      /\ has s.current.g key'1
      /\ not mt_has s.final.g key'1 /\ s.final.g.dm = s.current.g.dm /\ s.final.g.wq = s.current.g.wq
      | Err (Io (Dm'0)) -> mt_has s.current.g key'1
      /\ (not has s.current.g key'1 \/ UInt32.t'int size'2 = 0)
      /\ not mt_has s.final.g key'1 /\ s.final.g.dm = s.current.g.dm /\ s.final.g.wq = s.current.g.wq
      | Ok () -> mt_has s.current.g key'1
      /\ not has s.current.g key'1
      /\ s.final.g.mt = s.current.g.mt
      /\ get_u64 s.final.g.dm key'1
        = Some'1 { loc = Mem ((lookup_u64 s.current.g.mt key'1).ptr'1) size'2 (None'0);
                   es = size'2;
                   rr = (1: UInt32.t);
                   wr = (0: UInt32.t) }
      /\ s.final.g.wq = Seq.snoc s.current.g.wq (wjob s.current.p key'1 size'2)
      /\ Seq.get s.final.g.log (Seq.length s.final.g.log - 1) = Enq (wjob s.current.p key'1 size'2)
      | Err _ -> false
      end)}
    (! return {result}) ]

predicate resolve_refmut_S [@inline:trivial] (_1: MutBorrow.t t_S) = _1.final = _1.current

meta "rewrite_def" predicate resolve_refmut_S

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let verify_dis_copy_completed_register_failure_releases [#"/home/cornel/repair-j35-rc8/components/dispatcher/verif-creusot/src/drivers.rs" 2002 0 2002 108]
  (s: MutBorrow.t t_S) (key'1: UInt64.t) (size'2: UInt32.t) (return (x: t_Result_unit_DE)) =
{[@stop_split] [@expl:verify_dis_copy_completed_register_failure_releases requires] [%#sdrivers'0] pinv s.current.p
  /\ s.current.p.init}
  (! bb0
  [ bb0 = s0
    [ s0 = MutBorrow.borrow_final <t_S> {s.current} {MutBorrow.get_id s}
        (fun (_bor: MutBorrow.t t_S) -> [ &_9 <- _bor ] [ &s <- { s with current = _bor.final } ] s1)
    | s1 = copy_gpu_to_memory_completed [%#sdrivers] {_9} {key'1} {size'2}
        (fun (_x: t_Result_unit_DE) -> [ &_ret <- _x ] s2)
    | s2 = -{resolve_refmut_S s}- s3
    | s3 = return {_ret} ] ]
  [ & _ret: t_Result_unit_DE = Any.any_l ()
  | & s: MutBorrow.t t_S = s
  | & key'1: UInt64.t = key'1
  | & size'2: UInt32.t = size'2
  | & _9: MutBorrow.t t_S = Any.any_l () ])
  [ return (result: t_Result_unit_DE) ->
  {[@stop_split] [@expl:verify_dis_copy_completed_register_failure_releases ensures] [%#sdrivers'1] result
      = Err (Io (Dm'0)) -> not mt_has s.final.g key'1 /\ s.final.g.dm = s.current.g.dm}
    (! return {result}) ]
