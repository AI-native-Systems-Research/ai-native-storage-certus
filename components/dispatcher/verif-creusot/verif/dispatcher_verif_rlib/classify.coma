  /\ b.og = a.og /\ b.os = a.os /\ b.ov = a.ov /\ b.ok = a.ok /\ b.threads = a.threads /\ b.cfree = a.cfree

type t_Lr = NotExist'0 | Mismatch'0 | Blk'0 UInt64.t | Mem'0 UInt64.t UInt32.t

type t_DmE =
