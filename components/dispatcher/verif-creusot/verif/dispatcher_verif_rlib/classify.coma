let dm_lookup (s: MutBorrow.t t_S) (k: UInt64.t) (return (x: t_Result_Lr_DmE)) = any
  [ return (result: t_Result_Lr_DmE) ->
  {[@stop_split] [@expl:dm_lookup ensures] ([@stop_split] [@expl:dm_lookup ensures #0] [%#sboundary] s.final.p
      = s.current.p)
    /\ ([@stop_split] [@expl:dm_lookup ensures #1] [%#sboundary'0] match result with
      | Ok (NotExist'0) -> not has s.current.g k /\ s.final.g = s.current.g
      | Ok (Mismatch'0) -> false
      | Ok r -> has s.current.g k
