constant const_MAX: UInt64.t = (18446744073709551615: UInt64.t)

function view_Vec_Cold_Global (self: t_Vec_Cold_Global) : Seq.seq t_Cold

axiom view_Vec_Cold_Global_spec:
  forall self: t_Vec_Cold_Global [view_Vec_Cold_Global self]. [%#svec'0] Seq.length (view_Vec_Cold_Global self)
    <= UInt64.t'int const_MAX

let new_Cold (return (x: t_Vec_Cold_Global)) = any
  [ return (result: t_Vec_Cold_Global) ->
  {[@stop_split] [@expl:new ensures] [%#svec] Seq.length (view_Vec_Cold_Global result) = 0}
    (! return {result}) ]

let len_u64 (self_: Slice64.slice UInt64.t) (return (x: UInt64.t)) = any
