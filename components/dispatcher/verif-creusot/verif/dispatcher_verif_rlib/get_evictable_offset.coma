let dm_release_read (s: MutBorrow.t t_S) (k: UInt64.t) (own: int) (return (x: t_Result_unit_DmE)) = any
  [ return (result: t_Result_unit_DmE) ->
  {[@stop_split] [@expl:dm_release_read ensures] ([@stop_split] [@expl:dm_release_read ensures #0] [%#sboundary'1] s.final.p
      = s.current.p)
    /\ ([@stop_split] [@expl:dm_release_read ensures #1] [%#sboundary'2] match result with
      | Ok'0 () -> has s.current.g k
      /\ UInt32.t'int (ent s.current.g k).rr > 0
      /\ ent_rr s.current.g s.final.g k (- 1) /\ only_dm_log s.current.g s.final.g (RelRead k own)
      | Err'0 (KeyNotFound) -> not has s.current.g k /\ s.final.g = lg s.current.g (RelRead k own)
      | Err'0 (Underflow) -> has s.current.g k
      /\ UInt32.t'int (ent s.current.g k).rr = 0 /\ s.final.g = lg s.current.g (RelRead k own)
      | Err'0 _ -> false
      end)}
    (! return {result}) ]

let elim_Blk (_x: t_Lr) (return (off: UInt64.t)) = any
  [ _k (off: UInt64.t) -> {Blk off = _x} (! return {off})
