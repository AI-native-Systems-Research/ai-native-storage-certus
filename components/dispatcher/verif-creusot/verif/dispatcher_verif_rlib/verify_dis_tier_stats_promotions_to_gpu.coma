meta "rewrite_def" function get_u64

predicate contains_u64 [@inline:trivial] (self: t_FMap_u64_Ent) (k: UInt64.t) = [%#sfmap'0] get_u64 self k <> None'1

meta "rewrite_def" predicate contains_u64

