let lookup_async (s: MutBorrow.t t_S) (key'1: UInt64.t) (h: t_Ipc) (return (x: tup2_Result_u64_DE_Snapshot_LaG)) =
{[@stop_split] [@expl:lookup_async requires] [%#slookup] pinv s.current.p}
  any
  [ return (result: tup2_Result_u64_DE_Snapshot_LaG) ->
  {[@stop_split] [@expl:lookup_async ensures] ([@stop_split] [@expl:lookup_async ensures #0] [%#slookup'0] s.final.p
      = s.current.p)
    /\ ([@stop_split] [@expl:lookup_async ensures #1] [%#slookup'1] not s.current.p.init
      -> result.f0 = Err (NotInit (Dispatcher)) /\ s.final.g = s.current.g)
    /\ ([@stop_split] [@expl:lookup_async ensures #2] [%#slookup'2] rd_ctr s.current.g.c s.final.g.c
      /\ log_ext s.current.g s.final.g /\ same_env s.current.g s.final.g /\ s.final.g.wq = s.current.g.wq)
    /\ ([@stop_split] [@expl:lookup_async ensures #3] [%#slookup'3] match result.f0 with
        | Ok st -> UInt64.t'int st = 0
        | _ -> true
        end)
    /\ ([@stop_split] [@expl:lookup_async ensures #4] [%#slookup'4] s.current.p.init /\ s.current.p.has_gpu
      -> match result.f1.path'0 with
        | Early'0 -> false
        | Miss'0 -> not has s.current.g key'1
        /\ result.f0 = Err (KeyNotFound key'1)
        /\ s.final.g
        = { dm = s.current.g.dm;
            mt = s.current.g.mt;
            used = s.current.g.used;
            cap = s.current.g.cap;
            c = s.current.g.c;
            wq = s.current.g.wq;
            log = s.current.g.log;
            tick = s.final.g.tick;
            ob = s.current.g.ob;
            ob2 = s.current.g.ob2;
            og = s.current.g.og;
            os = s.current.g.os;
            ov = s.current.g.ov;
            ok = s.current.g.ok;
            ext = s.current.g.ext;
            pool = s.current.g.pool;
            cluster = s.current.g.cluster;
            threads = s.current.g.threads;
            rw = s.current.g.rw;
            cfree = s.current.g.cfree;
            wf = s.current.g.wf }
        | Timeout'0 -> has s.current.g key'1
        /\ (UInt32.t'int (ent s.current.g key'1).wr > 0
          \/ UInt32.t'int (ent s.current.g key'1).rr = UInt32.t'int const_MAX)
        /\ result.f0 = Err (KeyNotFound key'1)
        /\ s.final.g
        = { dm = s.current.g.dm;
            mt = s.current.g.mt;
            used = s.current.g.used;
            cap = s.current.g.cap;
            c = s.current.g.c;
            wq = s.current.g.wq;
            log = s.current.g.log;
            tick = s.final.g.tick;
            ob = s.current.g.ob;
            ob2 = s.current.g.ob2;
            og = s.current.g.og;
            os = s.current.g.os;
            ov = s.current.g.ov;
            ok = s.current.g.ok;
            ext = s.current.g.ext;
            pool = s.current.g.pool;
            cluster = s.current.g.cluster;
            threads = s.current.g.threads;
            rw = s.current.g.rw;
            cfree = s.current.g.cfree;
            wf = s.current.g.wf }
        | Warm'0 -> has s.current.g key'1
        /\ is_mem (ent s.current.g key'1).loc
        /\ UInt32.t'int (ent s.current.g key'1).wr = 0
        /\ UInt32.t'int (ent s.current.g key'1).rr < UInt32.t'int const_MAX
        /\ match (ent s.current.g key'1).loc with
            | Mem ptr'0 size'3 _ -> scattered s.final.g result.f1.sv'0.base (Seq.singleton h) result.f1.sv'0.m ptr'0 size'3 result.f1.warm'0
            /\ h2d_within s.current.g s.final.g ptr'0 size'3
            /\ (min_int (UInt32.t'int h.size'1) (UInt32.t'int size'3) > 0 /\ result.f0 = Ok (0: UInt64.t)
              -> result.f1.sv'0.m = 1)
            /\ (result.f1.sv'0.m = 1
            -> h2d_logged s.current.g s.final.g ptr'0 h.addr'1 (min_int (UInt32.t'int h.size'1) (UInt32.t'int size'3)))
            | _ -> false
            end
        /\ (result.f0 = Ok (0: UInt64.t)) = result.f1.sv'0.gpu_ok
        /\ match result.f0 with
            | Ok _ -> true
            | Err (Io _) -> true
            | _ -> false
            end
        /\ (forall j: UInt64.t. get_u64 s.final.g.dm j = get_u64 s.current.g.dm j)
        /\ s.final.g.mt = s.current.g.mt
        /\ logged s.current.g s.final.g (MtTouch key'1)
        /\ logged s.current.g s.final.g (RelRead key'1 1)
        /\ s.final.g.c.promo_gpu = s.current.g.c.promo_gpu + (if result.f1.sv'0.gpu_ok then 1 else 0)
        /\ s.final.g.c.promo_mem = s.current.g.c.promo_mem
        /\ own_reads s.current.g s.final.g /\ own_writes s.current.g s.final.g
        | Cold'0 -> has s.current.g key'1
        /\ is_blk (ent s.current.g key'1).loc
        /\ UInt32.t'int (ent s.current.g key'1).wr = 0
        /\ UInt32.t'int (ent s.current.g key'1).rr < UInt32.t'int const_MAX
        /\ match result.f0 with
            | Ok _ -> result.f1.ps'0.read_ok \/ UInt64.t'int s.current.p.nd = 0
            | _ -> true
            end
        /\ s.final.g.c.promo_gpu = s.current.g.c.promo_gpu + (if result.f0 = Ok (0: UInt64.t) then 1 else 0)
        /\ s.final.g.c.promo_mem = s.current.g.c.promo_mem + (if result.f1.ps'0.promoted then 1 else 0)
        end)
    /\ ([@stop_split] [@expl:lookup_async ensures #5] [%#slookup'5] s.current.p.init /\ s.current.p.has_gpu
      -> match result.f1.path'0 with
        | Cold'0 -> promote_post s.current.g result.f1.after_lookup'0 s.final.g s.current.p key'1 h result.f0 result.f1.ps'0
        | _ -> true
        end)
    /\ ([@stop_split] [@expl:lookup_async ensures #6] [%#slookup'6] s.current.p.init
      /\ s.current.p.has_gpu
      /\ UInt64.t'int s.current.p.nd = 0
      /\ has s.current.g key'1
      /\ is_blk (ent s.current.g key'1).loc
      /\ UInt32.t'int (ent s.current.g key'1).wr = 0
      /\ UInt32.t'int (ent s.current.g key'1).rr < UInt32.t'int const_MAX
      /\ not mt_has s.current.g key'1
      /\ UInt32.t'int h.size'1 > 0
      /\ s.current.g.used + UInt32.t'int h.size'1 <= s.current.g.cap
      /\ all_from s.current.g.ob s.current.g.tick /\ all_from s.current.g.og s.current.g.tick
    -> result.f0 = Ok (0: UInt64.t)
    /\ result.f1.path'0 = Cold'0
    /\ result.f1.ps'0.path = NoDrives
    /\ result.f1.ps'0.promoted
    /\ result.f1.ps'0.read_ok
    /\ has s.final.g key'1
    /\ mt_has s.final.g key'1
    /\ match (ent s.final.g key'1).loc with
        | Mem ptr'0 size'3 _ -> ptr'0 = result.f1.ps'0.ptr /\ size'3 = h.size'1
        | _ -> false
        end
    /\ Seq.length s.final.g.log = Seq.length result.f1.ps'0.mid.log + 2
    /\ match Seq.get s.final.g.log (Seq.length result.f1.ps'0.mid.log) with
        | H2D src dst len _ -> src = result.f1.ps'0.ptr /\ dst = h.addr'1 /\ UInt64.t'int len = UInt32.t'int h.size'1
        | _ -> false
        end
    /\ Seq.get s.final.g.log (Seq.length result.f1.ps'0.mid.log + 1) = DmPromote key'1)}
    (! return {result}) ]

