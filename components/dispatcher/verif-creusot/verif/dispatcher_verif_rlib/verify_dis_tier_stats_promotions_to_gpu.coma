function such_that_Ent (p'0: Map.map t_Ent bool) : t_Ent

axiom such_that_Ent_spec:
  forall p'0: Map.map t_Ent bool [such_that_Ent p'0]. ([%#slogic] exists x: t_Ent. index_Mapping_Ent_bool p'0 x)
