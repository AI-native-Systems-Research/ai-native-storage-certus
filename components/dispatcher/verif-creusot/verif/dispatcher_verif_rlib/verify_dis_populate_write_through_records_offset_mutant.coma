let process_write_job (s: MutBorrow.t t_S) (job: t_Job) (return (x: t_WjOut)) =
{[@stop_split] [@expl:process_write_job requires] [%#smethods] a_us5 s.current.p job.key}
  any
  [ return (result: t_WjOut) ->
  {[@stop_split] [@expl:process_write_job ensures] ([@stop_split] [@expl:process_write_job ensures #0] [%#smethods'0] s.final.p
      = s.current.p)
    /\ ([@stop_split] [@expl:process_write_job ensures #1] [%#smethods'1] log_ext s.current.g s.final.g
      /\ no_lru s.current.g s.final.g job.key /\ no_cpdev s.current.g s.final.g /\ same_env s.current.g s.final.g)
    /\ ([@stop_split] [@expl:process_write_job ensures #2] [%#smethods'2] s.final.g.mt = s.current.g.mt
      /\ s.final.g.wq = s.current.g.wq /\ same_ctr s.current.g.c s.final.g.c)
    /\ ([@stop_split] [@expl:process_write_job ensures #3] [%#smethods'3] others s.current.g s.final.g job.key)
    /\ ([@stop_split] [@expl:process_write_job ensures #4] [%#smethods'4] match result with
        | Stored off -> mt_has s.current.g job.key
        /\ (UInt64.t'int s.current.p.nd = 0 -> UInt64.t'int off = UInt64.t'int job.key * 4096)
        /\ (has s.current.g job.key /\ is_mem (ent s.current.g job.key).loc
          -> has s.final.g job.key
          /\ (ent s.final.g job.key).loc
            = match (ent s.current.g job.key).loc with
              | Mem ptr size'2 _ -> Mem ptr size'2 (Some'0 off)
              | l -> l
              end
          /\ (ent s.final.g job.key).wr = (ent s.current.g job.key).wr
          /\ UInt32.t'int (ent s.final.g job.key).rr
          = (if UInt32.t'int (ent s.current.g job.key).rr > 0 then
            UInt32.t'int (ent s.current.g job.key).rr - 1
          else
            0
          ))
        /\ (not (has s.current.g job.key /\ is_mem (ent s.current.g job.key).loc) -> s.final.g.dm = s.current.g.dm)
        | _ -> (has s.current.g job.key /\ UInt32.t'int (ent s.current.g job.key).rr > 0
          -> ent_rr s.current.g s.final.g job.key (- 1))
        /\ (not (has s.current.g job.key /\ UInt32.t'int (ent s.current.g job.key).rr > 0)
        -> s.final.g.dm = s.current.g.dm)
        end)
    /\ ([@stop_split] [@expl:process_write_job ensures #5] [%#smethods'5] match result with
        | NoSlot -> not mt_has s.current.g job.key
        | _ -> true
        end)
    /\ ([@stop_split] [@expl:process_write_job ensures #6] [%#smethods'6] forall k: UInt64.t. has s.current.g k
        -> has s.final.g k)
    /\ ([@stop_split] [@expl:process_write_job ensures #7] [%#smethods'7] forall k: UInt64.t. has s.current.g k
        /\ persisted (ent s.current.g k).loc -> persisted (ent s.final.g k).loc)}
    (! return {result}) ]

