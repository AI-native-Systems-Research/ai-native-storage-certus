let copy_gpu_to_memory_completed (s: MutBorrow.t t_S) (key'1: UInt64.t) (size'2: UInt32.t)
  (return (x: t_Result_unit_DE)) =
{[@stop_split] [@expl:copy_gpu_to_memory_completed requires] [%#sstore] pinv s.current.p}
  any
  [ return (result: t_Result_unit_DE) ->
  {[@stop_split] [@expl:copy_gpu_to_memory_completed ensures] ([@stop_split] [@expl:copy_gpu_to_memory_completed ensures #0] [%#sstore'0] s.final.p
      = s.current.p)
    /\ ([@stop_split] [@expl:copy_gpu_to_memory_completed ensures #1] [%#sstore'1] not s.current.p.init
      -> result = Err (NotInit (Dispatcher)) /\ s.final.g = s.current.g)
    /\ ([@stop_split] [@expl:copy_gpu_to_memory_completed ensures #2] [%#sstore'2] same_ctr s.current.g.c s.final.g.c
      /\ same_env s.current.g s.final.g /\ log_ext s.current.g s.final.g /\ no_dma s.current.g s.final.g)
    /\ ([@stop_split] [@expl:copy_gpu_to_memory_completed ensures #3] [%#sstore'3] others s.current.g s.final.g key'1
      /\ (forall j: UInt64.t. j <> key'1 -> get_u64'0 s.final.g.mt j = get_u64'0 s.current.g.mt j))
    /\ ([@stop_split] [@expl:copy_gpu_to_memory_completed ensures #4] [%#sstore'4] s.current.p.init
    -> match result with
      | Err (KeyNotFound k) -> k = key'1 /\ not mt_has s.current.g key'1 /\ s.final.g = s.current.g
      | Err (AlreadyExists k) -> k = key'1
      /\ mt_has s.current.g key'1
      /\ has s.current.g key'1
      /\ not mt_has s.final.g key'1 /\ s.final.g.dm = s.current.g.dm /\ s.final.g.wq = s.current.g.wq
      | Err (Io (Dm'0)) -> mt_has s.current.g key'1
      /\ (not has s.current.g key'1 \/ UInt32.t'int size'2 = 0)
      /\ not mt_has s.final.g key'1 /\ s.final.g.dm = s.current.g.dm /\ s.final.g.wq = s.current.g.wq
      | Ok () -> mt_has s.current.g key'1
      /\ not has s.current.g key'1
      /\ s.final.g.mt = s.current.g.mt
      /\ get_u64 s.final.g.dm key'1
        = Some'0 { loc = Mem ((lookup_u64 s.current.g.mt key'1).ptr'1) size'2 (None);
                   es = size'2;
                   rr = (1: UInt32.t);
