function wjob [#"/home/cornel/repair-j33-rc29/components/dispatcher/verif-creusot/src/store.rs" 135 0 135 45] (p'0: t_P) (key: UInt64.t) (size'2: UInt32.t) : t_Job
 = [%#sstore'5] { key'0 = key;
