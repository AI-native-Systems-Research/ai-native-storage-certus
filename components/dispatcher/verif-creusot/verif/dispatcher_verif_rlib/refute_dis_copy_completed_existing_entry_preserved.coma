  [%#score'2] a.promo_mem = b.promo_mem
  /\ a.promo_gpu = b.promo_gpu
  /\ a.ev_mem = b.ev_mem
  /\ a.ev_ssd = b.ev_ssd
  /\ a.hit_dram = b.hit_dram
  /\ a.hit_ssd = b.hit_ssd
  /\ a.r_hit = b.r_hit
  /\ a.r_miss = b.r_miss
  /\ a.bp = b.bp
  /\ a.drop_full = b.drop_full
  /\ a.already = b.already /\ a.blk_pin = b.blk_pin /\ a.exhausted = b.exhausted /\ a.blk_unp = b.blk_unp

predicate same_env [#"/home/cornel/repair-j33-rc29/components/dispatcher/verif-creusot/src/core.rs" 676 0 676 35] (a: t_W) (b: t_W) =
  [%#score'3] b.pool = a.pool
  /\ b.cluster = a.cluster
  /\ b.cap = a.cap
  /\ b.ext = a.ext
  /\ b.rw = a.rw
  /\ b.ob = a.ob
  /\ b.ob2 = a.ob2
  /\ b.og = a.og /\ b.os = a.os /\ b.ov = a.ov /\ b.ok = a.ok /\ b.threads = a.threads /\ b.cfree = a.cfree

predicate log_ext [#"/home/cornel/repair-j33-rc29/components/dispatcher/verif-creusot/src/core.rs" 425 0 425 34] (a: t_W) (b: t_W) =
  [%#score'4] Seq.length a.log <= Seq.length b.log
  /\ (forall i: int. 0 <= i /\ i < Seq.length a.log -> Seq.get b.log i = Seq.get a.log i)

predicate no_dma [#"/home/cornel/repair-j33-rc29/components/dispatcher/verif-creusot/src/core.rs" 431 0 431 33] (a: t_W) (b: t_W) =
  [%#score'5] forall i: int. Seq.length a.log <= i /\ i < Seq.length b.log
    -> match Seq.get b.log i with
      | H2D _ _ _ _ -> false
      | D2H _ _ _ _ -> false
      | _ -> true
      end

predicate others [#"/home/cornel/repair-j33-rc29/components/dispatcher/verif-creusot/src/core.rs" 582 0 582 41] (a: t_W) (b: t_W) (k: UInt64.t) =
