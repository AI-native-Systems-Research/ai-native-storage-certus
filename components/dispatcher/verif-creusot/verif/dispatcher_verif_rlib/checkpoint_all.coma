use creusot.prelude.MutBorrow
use creusot.int.UInt64
use creusot.int.UInt32
use seq.Seq
use map.Map
use creusot.prelude.Any
use int.Int

type t_P = {
  init: bool;
  has_dm: bool;
  has_mt: bool;
  has_gpu: bool;
  has_spdk: bool;
  has_factory: bool;
  has_rl: bool;
  has_logger: bool;
  max_att: UInt64.t;
  bp_ms: UInt64.t;
  nd: UInt64.t;
  writer: bool;
  ssd_ev: bool;
  mt_ev: bool;
  ring: bool;
  chunk: UInt64.t;
  stg: bool;
  stg_bytes: UInt64.t;
  warm: UInt64.t }

type t_FMap_u64_Ent

type t_FMap_u64_Slot

type t_Ctr = {
  promo_mem: int;
  promo_gpu: int;
  ev_mem: int;
  ev_ssd: int;
  hit_dram: int;
  hit_ssd: int;
  r_hit: int;
  r_miss: int;
  bp: int;
  drop_full: int;
  already: int;
  blk_pin: int;
  exhausted: int;
  blk_unp: int }

type t_Job = { key: UInt64.t; size: UInt32.t; dev: UInt64.t }

type t_Option_usize = None | Some UInt64.t

type t_Ev =
  | H2D UInt64.t UInt64.t UInt64.t UInt64.t
  | D2H UInt64.t UInt64.t UInt64.t UInt64.t
  | Sync UInt64.t
  | MtTouch UInt64.t
  | MtGet UInt64.t
  | MtBatchTouch
  | MtRemove UInt64.t
  | MtInsert UInt64.t
  | DmTouch UInt64.t
  | DmDemote UInt64.t
  | DmRemove UInt64.t
  | DmCreate UInt64.t
  | DmPromote UInt64.t
  | RelRead UInt64.t int
  | RelWrite UInt64.t int
  | Enq t_Job
  | ExtFree UInt64.t UInt64.t
  | Recover UInt64.t UInt64.t UInt32.t
  | EmFormat UInt64.t
  | EmInit UInt64.t
  | Checkpoint UInt64.t
  | DevSignal UInt64.t
  | DevShutdown UInt64.t
  | DevDetach UInt64.t
  | Register
  | Unregister
  | Join
  | Leave
  | SsdRead UInt64.t UInt64.t
  | SsdWrite UInt64.t UInt64.t
  | RemoteFwd UInt64.t UInt32.t
  | Spawn
  | Cpu UInt64.t t_Option_usize

type t_Ext = { key'0: UInt64.t; off'0: UInt64.t; size'0: UInt32.t }

type t_W = {
  dm: t_FMap_u64_Ent;
  mt: t_FMap_u64_Slot;
  used: int;
  cap: int;
  c: t_Ctr;
  wq: Seq.seq t_Job;
  log: Seq.seq t_Ev;
  tick: int;
  ob: Map.map int bool;
  ob2: Map.map int bool;
  og: Map.map int bool;
  os: Map.map int bool;
  ov: Map.map int UInt64.t;
  ok: Map.map int (Seq.seq UInt64.t);
  ext: Map.map int (Seq.seq t_Ext);
  pool: bool;
  cluster: bool;
  threads: int;
  rw: Map.map int UInt64.t;
  cfree: Map.map int int;
  wf: Map.map UInt64.t bool }

type t_S = { p: t_P; g: t_W }

function lg [#"/home/cornel/repair-j33-rc4/components/dispatcher/verif-creusot/src/core.rs" 300 0 300 27] (w: t_W) (e: t_Ev) : t_W
 = [%#score] { dm = w.dm;
               mt = w.mt;
               used = w.used;
               cap = w.cap;
               c = w.c;
               wq = w.wq;
               log = Seq.snoc w.log e;
               tick = w.tick;
               ob = w.ob;
               ob2 = w.ob2;
               og = w.og;
               os = w.os;
               ov = w.ov;
               ok = w.ok;
               ext = w.ext;
               pool = w.pool;
               cluster = w.cluster;
               threads = w.threads;
               rw = w.rw;
               cfree = w.cfree;
               wf = w.wf }

let em_checkpoint (s: MutBorrow.t t_S) (drive: UInt64.t) (return (x: ())) = any
  [ return (result: ()) -> {[@stop_split] [@expl:em_checkpoint ensures] [%#sboundary] s.final.p = s.current.p
    /\ s.final.g = lg s.current.g (Checkpoint drive)}
    (! return {result}) ]

predicate resolve_refmut_S [@inline:trivial] (_1: MutBorrow.t t_S) = _1.final = _1.current

meta "rewrite_def" predicate resolve_refmut_S

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

