               mt = w.mt;
               used = w.used;
               cap = w.cap;
               c = w.c;
               wq = w.wq;
               log = Seq.snoc w.log e;
               tick = w.tick;
               ob = w.ob;
               ob2 = w.ob2;
               og = w.og;
               os = w.os;
               ov = w.ov;
               ok = w.ok;
               ext = w.ext;
               pool = w.pool;
               cluster = w.cluster;
               threads = w.threads;
               rw = w.rw;
               rw_base = w.rw_base;
               cfree = w.cfree;
               wf = w.wf }

