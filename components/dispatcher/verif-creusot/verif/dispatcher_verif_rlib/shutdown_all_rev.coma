  ob2: Map.map int bool;
  og: Map.map int bool;
  os: Map.map int bool;
  ov: Map.map int UInt64.t;
  ok: Map.map int (Seq.seq UInt64.t);
  ext: Map.map int (Seq.seq t_Ext);
  pool: bool;
  cluster: bool;
  threads: int;
  rw: Map.map int UInt64.t;
  rw_base: int;
  cfree: Map.map int int;
  wf: Map.map UInt64.t bool }

type t_S = { p: t_P; g: t_W }

function lg [#"/home/cornel/repair-j33-rc21/components/dispatcher/verif-creusot/src/core.rs" 306 0 306 27] (w: t_W) (e: t_Ev) : t_W
