predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
  [%#swell_founded] self >= 0 /\ self > other

meta "rewrite_def" predicate well_founded_relation_Int

type t_Option_u64 = None'0 | Some'0 UInt64.t

type t_Loc = Mem UInt64.t UInt32.t t_Option_u64 | Blk UInt64.t

type t_Ent = { loc: t_Loc; es: UInt32.t; rr: UInt32.t; wr: UInt32.t }

type t_Option_Ent = None'1 | Some'1 t_Ent

function to_mapping_u64 (self: t_FMap_u64_Ent) : Map.map UInt64.t t_Option_Ent

function get_u64 [@inline:trivial] (self: t_FMap_u64_Ent) (k: UInt64.t) : t_Option_Ent =
  [%#sfmap'1] Map.get (to_mapping_u64 self) k

meta "rewrite_def" function get_u64

predicate contains_u64 [@inline:trivial] (self: t_FMap_u64_Ent) (k: UInt64.t) = [%#sfmap] get_u64 self k <> None'1

meta "rewrite_def" predicate contains_u64

predicate has [#"/home/cornel/repair-j33-rc29/components/dispatcher/verif-creusot/src/core.rs" 334 0 334 32] (w: t_W) (k: UInt64.t) =
  [%#score'0] contains_u64 w.dm k

predicate persisted [#"/home/cornel/repair-j33-rc29/components/dispatcher/verif-creusot/src/core.rs" 359 0 359 32] (l: t_Loc) =
  [%#score'1] match l with
    | Mem _ _ ssd -> ssd <> None'0
    | Blk _ -> false
    end

predicate index_Mapping_Ent_bool [@inline:trivial] (self: Map.map t_Ent bool) (a: t_Ent) = [%#smapping] Map.get self a

meta "rewrite_def" predicate index_Mapping_Ent_bool

function such_that_Ent (p: Map.map t_Ent bool) : t_Ent

axiom such_that_Ent_spec:
  forall p: Map.map t_Ent bool [such_that_Ent p]. ([%#slogic] exists x: t_Ent. index_Mapping_Ent_bool p x)
    -> ([%#slogic'0] index_Mapping_Ent_bool p (such_that_Ent p))

function unwrap_Option_Ent (self: t_Option_Ent) : t_Ent = [%#soption'0] match self with
    | Some'1 x -> x
    | None'1 -> such_that_Ent (fun (__0: t_Ent) -> true)
    end

function lookup_u64 [@inline:trivial] (self: t_FMap_u64_Ent) (k: UInt64.t) : t_Ent =
  [%#sfmap'0] unwrap_Option_Ent (get_u64 self k)

meta "rewrite_def" function lookup_u64

function ent [#"/home/cornel/repair-j33-rc29/components/dispatcher/verif-creusot/src/core.rs" 339 0 339 31] (w: t_W) (k: UInt64.t) : t_Ent
 = [%#score'2] lookup_u64 w.dm k

predicate evictable [#"/home/cornel/repair-j33-rc29/components/dispatcher/verif-creusot/src/core.rs" 697 0 697 38] (w: t_W) (c'0: UInt64.t) =
  [%#score] has w c'0 /\ persisted (ent w c'0).loc /\ UInt32.t'int (ent w c'0).rr = 0 /\ UInt32.t'int (ent w c'0).wr = 0

