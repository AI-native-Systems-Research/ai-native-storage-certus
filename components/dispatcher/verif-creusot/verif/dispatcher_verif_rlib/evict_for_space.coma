let mt_used (s: MutBorrow.t t_S) (return (x: UInt64.t)) = any
  [ return (result: UInt64.t) ->
  {[@stop_split] [@expl:mt_used ensures] ([@stop_split] [@expl:mt_used ensures #0] [%#sboundary] s.final.p = s.current.p
      /\ s.final.g = s.current.g)
    /\ ([@stop_split] [@expl:mt_used ensures #1] [%#sboundary'0] UInt64.t'int result = s.current.g.used)}
    (! return {result}) ]

let mt_capacity (s: MutBorrow.t t_S) (return (x: UInt64.t)) = any
  [ return (result: UInt64.t) ->
  {[@stop_split] [@expl:mt_capacity ensures] ([@stop_split] [@expl:mt_capacity ensures #0] [%#sboundary'1] s.final.p
        = s.current.p
      /\ s.final.g = s.current.g)
    /\ ([@stop_split] [@expl:mt_capacity ensures #1] [%#sboundary'2] UInt64.t'int result = s.current.g.cap)}
    (! return {result}) ]

constant const_MAX: UInt64.t = (18446744073709551615: UInt64.t)

let padd (a: UInt64.t) (b: UInt64.t) (return (x: UInt64.t)) = any
  [ return (result: UInt64.t) -> {[@stop_split] [@expl:padd ensures] [%#score] UInt64.t'int a + UInt64.t'int b
      <= UInt64.t'int const_MAX
    /\ UInt64.t'int result = UInt64.t'int a + UInt64.t'int b}
    (! return {result}) ]

