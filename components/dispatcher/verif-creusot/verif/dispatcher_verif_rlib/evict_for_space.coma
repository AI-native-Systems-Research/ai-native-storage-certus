let evict_one_clean (s: MutBorrow.t t_S) (scan: UInt64.t) (return (x: bool)) = any
  [ return (result: bool) ->
  {[@stop_split] [@expl:evict_one_clean ensures] ([@stop_split] [@expl:evict_one_clean ensures #0] [%#sevict'26] s.final.p
      = s.current.p)
    /\ ([@stop_split] [@expl:evict_one_clean ensures #1] [%#sevict'27] evict_frame s.current.g s.final.g
      /\ ev_ctr s.current.g.c s.final.g.c)
    /\ ([@stop_split] [@expl:evict_one_clean ensures #2] [%#sevict'28] result
      -> s.final.g.c.ev_mem = s.current.g.c.ev_mem + 1 /\ s.final.g.c.exhausted = s.current.g.c.exhausted)
    /\ ([@stop_split] [@expl:evict_one_clean ensures #3] [%#sevict'29] not result
      -> s.final.g.c.ev_mem = s.current.g.c.ev_mem /\ s.final.g.c.exhausted = s.current.g.c.exhausted + 1)
    /\ ([@stop_split] [@expl:evict_one_clean ensures #4] [%#sevict'30] UInt64.t'int scan >= 1
      /\ Seq.length (index_Mapping_Int_Seq_u64 s.current.g.ok s.current.g.tick) >= 1
      /\ evictable s.current.g (cand0 s.current.g)
    -> result
    /\ s.final.g.dm = insert_u64 s.current.g.dm (cand0 s.current.g) (dem_ent (ent s.current.g (cand0 s.current.g)))
    /\ s.final.g.mt = remove_u64 s.current.g.mt (cand0 s.current.g)
    /\ s.final.g.used
    = (if s.current.g.used >= UInt32.t'int (lookup_u64'0 s.current.g.mt (cand0 s.current.g)).size'1 then
      s.current.g.used - UInt32.t'int (lookup_u64'0 s.current.g.mt (cand0 s.current.g)).size'1
    else
      0
    ))}
    (! return {result}) ]

