type t_Ext = { key'0: UInt64.t; off'0: UInt64.t; size'0: UInt32.t }

type t_W = {
  dm: t_FMap_u64_Ent;
  mt: t_FMap_u64_Slot;
  used: int;
  cap: int;
  c: t_Ctr;
  wq: Seq.seq t_Job;
  log: Seq.seq t_Ev;
  tick: int;
  ob: Map.map int bool;
  ob2: Map.map int bool;
  og: Map.map int bool;
  os: Map.map int bool;
  ov: Map.map int UInt64.t;
  ok: Map.map int (Seq.seq UInt64.t);
  ext: Map.map int (Seq.seq t_Ext);
  pool: bool;
  cluster: bool;
  threads: int;
  rw: Map.map int UInt64.t;
  cfree: Map.map int int;
  wf: Map.map UInt64.t bool;
  sdev: Map.map UInt64.t Int32.t }

type t_S = { p: t_P; g: t_W }

type t_Ni = Dispatcher | DispatchMap | MemoryTier | Gpu | Spdk | Logger | Ring

type t_IoK =
  | Partition'0 UInt64.t UInt64.t UInt64.t
  | Drive'0 UInt64.t
  | Gpu'0
  | Sync'0
  | Ssd'0
  | Promote'0
  | Dm'0
  | Remote'0
  | Stream'0
  | Channel'0
  | Other'0

type t_DE = NotInit t_Ni | InvalidParam | KeyNotFound UInt64.t | AlreadyExists UInt64.t | Alloc | Io t_IoK | Timeout

type t_Result_unit_DE = Ok () | Err t_DE

predicate pinv [#"/home/cornel/repair-j33-rc24/components/dispatcher/verif-creusot/src/core.rs" 610 0 610 25] (p'0: t_P) =
  [%#score] (p'0.init -> p'0.has_dm /\ p'0.has_mt /\ p'0.writer) /\ (not p'0.init -> not p'0.ssd_ev /\ not p'0.mt_ev)

function lg [#"/home/cornel/repair-j33-rc24/components/dispatcher/verif-creusot/src/core.rs" 304 0 304 27] (w: t_W) (e: t_Ev) : t_W
 = [%#score'0] { dm = w.dm;
                 mt = w.mt;
                 used = w.used;
                 cap = w.cap;
                 c = w.c;
                 wq = w.wq;
                 log = Seq.snoc w.log e;
                 tick = w.tick;
                 ob = w.ob;
                 ob2 = w.ob2;
                 og = w.og;
                 os = w.os;
                 ov = w.ov;
                 ok = w.ok;
                 ext = w.ext;
                 pool = w.pool;
                 cluster = w.cluster;
                 threads = w.threads;
                 rw = w.rw;
                 cfree = w.cfree;
                 wf = w.wf;
                 sdev = w.sdev }

function di [#"/home/cornel/repair-j33-rc24/components/dispatcher/verif-creusot/src/core.rs" 628 0 628 36] (k: UInt64.t) (n: UInt64.t) : UInt64.t

let schedule_write_through (s: MutBorrow.t t_S) (key'1: UInt64.t) (size'1: UInt32.t) (return (x: t_Result_unit_DE)) =
{[@stop_split] [@expl:schedule_write_through requires] [%#smethods] pinv s.current.p}
  any
  [ return (result: t_Result_unit_DE) ->
  {[@stop_split] [@expl:schedule_write_through ensures] ([@stop_split] [@expl:schedule_write_through ensures #0] [%#smethods'0] s.final.p
      = s.current.p)
    /\ ([@stop_split] [@expl:schedule_write_through ensures #1] [%#smethods'1] not s.current.p.init
      -> result = Err (NotInit (Dispatcher)) /\ s.final.g = s.current.g)
    /\ ([@stop_split] [@expl:schedule_write_through ensures #2] [%#smethods'2] s.current.p.init
    -> result = Ok ()
    /\ s.final.g
    = lg { dm = s.current.g.dm;
           mt = s.current.g.mt;
           used = s.current.g.used;
           cap = s.current.g.cap;
           c = s.current.g.c;
           wq = Seq.snoc s.current.g.wq { key = key'1;
                                          size = size'1;
                                          dev = di key'1 (if UInt64.t'int s.current.p.nd = 0 then
                                            (1: UInt64.t)
                                          else
                                            s.current.p.nd
                                          ) };
           log = s.current.g.log;
           tick = s.current.g.tick;
           ob = s.current.g.ob;
           ob2 = s.current.g.ob2;
           og = s.current.g.og;
           os = s.current.g.os;
           ov = s.current.g.ov;
           ok = s.current.g.ok;
           ext = s.current.g.ext;
           pool = s.current.g.pool;
           cluster = s.current.g.cluster;
           threads = s.current.g.threads;
           rw = s.current.g.rw;
           cfree = s.current.g.cfree;
           wf = s.current.g.wf;
           sdev = s.current.g.sdev } (Enq { key = key'1;
                                            size = size'1;
                                            dev = di key'1 (if UInt64.t'int s.current.p.nd = 0 then
                                              (1: UInt64.t)
                                            else
                                              s.current.p.nd
                                            ) }))}
    (! return {result}) ]

predicate resolve_refmut_S [@inline:trivial] (_1: MutBorrow.t t_S) = _1.final = _1.current

meta "rewrite_def" predicate resolve_refmut_S

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

