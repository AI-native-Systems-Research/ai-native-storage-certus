predicate index_Mapping_Ent_bool [@inline:trivial] (self: Map.map t_Ent bool) (a: t_Ent) = [%#smapping] Map.get self a

meta "rewrite_def" predicate index_Mapping_Ent_bool

function such_that_Ent (p'0: Map.map t_Ent bool) : t_Ent

axiom such_that_Ent_spec:
  forall p'0: Map.map t_Ent bool [such_that_Ent p'0]. ([%#slogic] exists x: t_Ent. index_Mapping_Ent_bool p'0 x)
    -> ([%#slogic'0] index_Mapping_Ent_bool p'0 (such_that_Ent p'0))

function unwrap_Option_Ent (self: t_Option_Ent) : t_Ent = [%#soption'0] match self with
    | Some'1 x -> x
    | None'1 -> such_that_Ent (fun (__0: t_Ent) -> true)
    end

function lookup_u64 [@inline:trivial] (self: t_FMap_u64_Ent) (k: UInt64.t) : t_Ent =
  [%#sfmap] unwrap_Option_Ent (get_u64 self k)

meta "rewrite_def" function lookup_u64

function ent [#"/home/cornel/repair-j33-rc22/components/dispatcher/verif-creusot/src/core.rs" 336 0 336 31] (w: t_W) (k: UInt64.t) : t_Ent
 = [%#score'17] lookup_u64 w.dm k

function demoted_loc [#"/home/cornel/repair-j33-rc22/components/dispatcher/verif-creusot/src/core.rs" 369 0 369 33] (l: t_Loc) : t_Loc
 = [%#score'20] match l with
    | Mem _ _ (Some'0 o) -> Blk o
    | _ -> l
    end

predicate contains_u64'0 [@inline:trivial] (self: t_FMap_u64_Slot) (k: UInt64.t) =
  [%#sfmap'1] get_u64'0 self k <> None'2

meta "rewrite_def" predicate contains_u64'0

predicate mt_has [#"/home/cornel/repair-j33-rc22/components/dispatcher/verif-creusot/src/core.rs" 382 0 382 35] (w: t_W) (k: UInt64.t) =
  [%#score'0] contains_u64'0 w.mt k

predicate demoted_k [#"/home/cornel/repair-j33-rc22/components/dispatcher/verif-creusot/src/core.rs" 482 0 482 44] (a: t_W) (b: t_W) (k: UInt64.t) =
  [%#score'5] has a k
  /\ persisted (ent a k).loc
  /\ UInt32.t'int (ent a k).rr = 0
  /\ UInt32.t'int (ent a k).wr = 0
  /\ get_u64 b.dm k
    = Some'1 { loc = demoted_loc (ent a k).loc; es = (ent a k).es; rr = (ent a k).rr; wr = (ent a k).wr }
  /\ not mt_has b k

predicate log_ext [#"/home/cornel/repair-j33-rc22/components/dispatcher/verif-creusot/src/core.rs" 422 0 422 34] (a: t_W) (b: t_W) =
  [%#score'6] Seq.length a.log <= Seq.length b.log
  /\ (forall i: int. 0 <= i /\ i < Seq.length a.log -> Seq.get b.log i = Seq.get a.log i)

predicate demote_before_free [#"/home/cornel/repair-j33-rc22/components/dispatcher/verif-creusot/src/core.rs" 457 0 457 45] (a: t_W) (b: t_W) =
  [%#score'7] forall i: int. Seq.length a.log <= i /\ i < Seq.length b.log
    -> match Seq.get b.log i with
      | MtRemove key'1 -> i > Seq.length a.log /\ Seq.get b.log (i - 1) = DmDemote key'1
      | _ -> true
      end

