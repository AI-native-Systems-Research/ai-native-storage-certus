let%span score = "/home/cornel/repair-j35-rc8/components/dispatcher/verif-creusot/src/core.rs" 546 10 546 17
let%span score'0 = "/home/cornel/repair-j35-rc8/components/dispatcher/verif-creusot/src/core.rs" 545 10 545 24
let%span score'1 = "/home/cornel/repair-j35-rc8/components/dispatcher/verif-creusot/src/core.rs" 539 10 539 17
let%span score'2 = "/home/cornel/repair-j35-rc8/components/dispatcher/verif-creusot/src/core.rs" 541 16 541 107
let%span swell_founded = "/home/cornel/repair-j35-rc8/components/dispatcher/creusot/creusot-std/src/logic/well_founded.rs" 43 8 43 33

use creusot.int.UInt64
use creusot.int.UInt32
use seq.Seq
use int.Int

type t_Ipc = { addr: UInt64.t; size: UInt32.t }

function sum_sz [#"/home/cornel/repair-j35-rc8/components/dispatcher/verif-creusot/src/core.rs" 540 0 540 33] (r: Seq.seq t_Ipc) : int

axiom sum_sz_def: forall r: Seq.seq t_Ipc [sum_sz r]. sum_sz r
    = ([%#score'2] if Seq.length r = 0 then
      0
    else
      sum_sz (Seq.([..]) r 0 (Seq.length r - 1)) + UInt32.t'int (Seq.get r (Seq.length r - 1)).size
    )

predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
  [%#swell_founded] self >= 0 /\ self > other

meta "rewrite_def" predicate well_founded_relation_Int

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant r : Seq.seq t_Ipc

function sum_sz_nonneg [#"/home/cornel/repair-j35-rc8/components/dispatcher/verif-creusot/src/core.rs" 547 0 547 33] (r: Seq.seq t_Ipc) : ()

goal vc_sum_sz_nonneg: if Seq.length r = 0 then
    [@stop_split] [@expl:sum_sz_nonneg ensures] [%#score'0] sum_sz r >= 0
  else
    ([@expl:variant decreases] well_founded_relation_Int ([%#score] Seq.length r) ([%#score] Seq.length (Seq.([..]) r 0 (Seq.length r
      - 1))))
    /\ (([@stop_split] [@expl:sum_sz_nonneg ensures] [%#score'0] sum_sz (Seq.([..]) r 0 (Seq.length r - 1)) >= 0)
    -> ([@stop_split] [@expl:sum_sz_nonneg ensures] [%#score'0] sum_sz r >= 0))
  
