use seq.Seq
use int.Int

function count_true [#"/home/cornel/repair-j33-rc4/components/dispatcher/verif-creusot/src/batch.rs" 401 0 401 46] (s: Seq.seq bool) (n: int) : int

axiom count_true_def: forall s: Seq.seq bool, n: int [count_true s n]. count_true s n
    = ([%#sbatch'3] if n <= 0 then 0 else count_true s (n - 1) + (if Seq.get s (n - 1) then 1 else 0))

predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
  [%#swell_founded] self >= 0 /\ self > other

meta "rewrite_def" predicate well_founded_relation_Int

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant a : Seq.seq bool

constant b : Seq.seq bool

constant n : int

function count_eq [#"/home/cornel/repair-j33-rc4/components/dispatcher/verif-creusot/src/batch.rs" 787 0 787 51] (a: Seq.seq bool) (b: Seq.seq bool) (n: int) : ()

goal vc_count_eq: ([%#sbatch'0] 0 <= n
    /\ n <= Seq.length a /\ n <= Seq.length b /\ (forall i: int. 0 <= i /\ i < n -> Seq.get a i = Seq.get b i))
  -> (if n <= 0 then
    [@stop_split] [@expl:count_eq ensures] [%#sbatch'1] count_true a n = count_true b n
  else
    (([@stop_split] [@expl:count_eq requires] [%#sbatch'0] 0 <= n - 1
        /\ n - 1 <= Seq.length a
        /\ n - 1 <= Seq.length b /\ (forall i: int. 0 <= i /\ i < n - 1 -> Seq.get a i = Seq.get b i))
      /\ ([@expl:variant decreases] well_founded_relation_Int ([%#sbatch] n) ([%#sbatch] n - 1)))
    /\ (([@stop_split] [@expl:count_eq ensures] [%#sbatch'1] count_true a (n - 1) = count_true b (n - 1))
    -> ([@stop_split] [@expl:count_eq ensures] [%#sbatch'1] count_true a n = count_true b n))
  )
