meta "rewrite_def" function index_Mapping_Int_u64

predicate drives_ok [#"/home/cornel/repair-j35-rc23/components/dispatcher/verif-creusot/src/init.rs" 31 0 31 38] (w: t_W) (t: int) =
  [%#sinit'18] all_from w.ob t /\ (forall i: int. i >= t -> UInt64.t'int (index_Mapping_Int_u64 w.ov i) >= 3)

function index_Mapping_Int_Seq_Ext [@inline:trivial] (self: Map.map int (Seq.seq t_Ext)) (a: int) : Seq.seq t_Ext =
