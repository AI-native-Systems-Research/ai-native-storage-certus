let initialize (s: MutBorrow.t t_S) (cfg: t_ICfg) (return (x: tup2_Result_unit_DE_DFail)) =
{[@stop_split] [@expl:initialize requires] [%#sinit] pinv s.current.p}
  any
  [ return (result: tup2_Result_unit_DE_DFail) ->
  {[@stop_split] [@expl:initialize ensures] ([@stop_split] [@expl:initialize ensures #0] [%#sinit'0] pinv s.final.p)
    /\ ([@stop_split] [@expl:initialize ensures #1] [%#sinit'1] result.f0 = Ok ()
      -> s.final.p.max_att = cfg.max_att'0 /\ s.final.p.bp_ms = cfg.bp_ms'0)
    /\ ([@stop_split] [@expl:initialize ensures #2] [%#sinit'2] result.f0 <> Ok ()
      -> s.final.p.max_att = s.current.p.max_att /\ s.final.p.bp_ms = s.current.p.bp_ms)
    /\ ([@stop_split] [@expl:initialize ensures #3] [%#sinit'3] s.final.p.has_dm = s.current.p.has_dm
      /\ s.final.p.has_mt = s.current.p.has_mt
      /\ s.final.p.has_gpu = s.current.p.has_gpu
      /\ s.final.p.has_spdk = s.current.p.has_spdk
      /\ s.final.p.has_factory = s.current.p.has_factory
      /\ s.final.p.has_rl = s.current.p.has_rl /\ s.final.p.has_logger = s.current.p.has_logger)
    /\ ([@stop_split] [@expl:initialize ensures #4] [%#sinit'4] log_ext s.current.g s.final.g
      /\ same_ctr s.current.g.c s.final.g.c /\ s.final.g.wq = s.current.g.wq /\ s.final.g.mt = s.current.g.mt)
    /\ ([@stop_split] [@expl:initialize ensures #5] [%#sinit'5] not s.current.p.has_dm
      -> result.f0 = Err (NotInit (DispatchMap)) /\ s.final.g = s.current.g)
    /\ ([@stop_split] [@expl:initialize ensures #6] [%#sinit'6] s.current.p.has_dm /\ not s.current.p.has_mt
      -> result.f0 = Err (NotInit (MemoryTier)) /\ s.final.g = s.current.g)
    /\ ([@stop_split] [@expl:initialize ensures #7] [%#sinit'7] s.current.p.has_dm
        /\ s.current.p.has_mt /\ UInt64.t'int cfg.n_addrs'0 = 0
      -> result.f0 = Err (InvalidParam) /\ s.final.g = s.current.g /\ s.final.p.nd = s.current.p.nd)
    /\ ([@stop_split] [@expl:initialize ensures #8] [%#sinit'8] match result.f0 with
        | Err _ -> s.final.p.init = s.current.p.init
        /\ s.final.p.writer = s.current.p.writer
        /\ s.final.p.ssd_ev = s.current.p.ssd_ev /\ s.final.p.mt_ev = s.current.p.mt_ev
        | Ok () -> true
        end)
    /\ ([@stop_split] [@expl:initialize ensures #9] [%#sinit'9] match result.f0 with
        | Ok () -> s.final.p.init
        /\ s.final.p.writer
        /\ s.final.p.ssd_ev = (s.current.p.ssd_ev \/ cfg.ssd_thr_pos'0 /\ UInt64.t'int s.final.p.nd > 0)
        /\ s.final.p.mt_ev = (s.current.p.mt_ev \/ cfg.mt_thr_pos'0)
        /\ (s.current.p.has_spdk \/ s.current.p.has_factory
          -> s.final.p.nd = cfg.n_addrs'0
          /\ (forall i: int. 0 <= i /\ i < UInt64.t'int cfg.n_addrs'0 -> index_Mapping_Int_Int s.final.g.cfree i = 0))
        /\ (not (s.current.p.has_spdk \/ s.current.p.has_factory) -> s.final.p.nd = s.current.p.nd)
        /\ (s.current.p.has_rl -> logged s.current.g s.final.g (Join))
        | Err (NotInit _) -> true
        | Err (InvalidParam) -> true
        | Err (Io _) -> (s.current.p.has_spdk \/ s.current.p.has_factory)
        /\ match result.f1 with
          | None'1 -> false
          | Parse'1 _ -> false
          | _ -> true
          end
        | Err _ -> false
        end)
    /\ ([@stop_split] [@expl:initialize ensures #10] [%#sinit'10] match result.f0 with
        | Err (Io (Partition'0 drive expected found)) -> UInt64.t'int expected = 3
        /\ UInt64.t'int found < 3 /\ result.f1 = Few'1 drive found
        | _ -> true
        end)
    /\ ([@stop_split] [@expl:initialize ensures #11] [%#sinit'11] s.current.p.has_dm
        /\ s.current.p.has_mt /\ UInt64.t'int cfg.n_addrs'0 > 0 /\ not (s.current.p.has_spdk \/ s.current.p.has_factory)
      -> result.f0 = Ok ())
    /\ ([@stop_split] [@expl:initialize ensures #12] [%#sinit'12] s.current.p.has_dm
        /\ s.current.p.has_mt
        /\ UInt64.t'int cfg.n_addrs'0 > 0
        /\ (s.current.p.has_spdk \/ s.current.p.has_factory)
        /\ s.current.p.has_logger /\ drives_ok s.current.g s.current.g.tick -> result.f0 = Ok ())
    /\ ([@stop_split] [@expl:initialize ensures #13] [%#sinit'13] s.current.p.has_dm
        /\ s.current.p.has_mt
        /\ UInt64.t'int cfg.n_addrs'0 > 0
        /\ (s.current.p.has_spdk \/ s.current.p.has_factory) /\ not cfg.format_on_init'0 /\ result.f0 = Ok ()
      -> (forall d: int, e: int. 0 <= d
          /\ d < UInt64.t'int cfg.n_addrs'0 /\ 0 <= e /\ e < Seq.length (index_Mapping_Int_Seq_Ext s.current.g.ext d)
        -> logged s.current.g s.final.g (Recover ((Seq.get (index_Mapping_Int_Seq_Ext s.current.g.ext d) e).key'0) ((Seq.get (index_Mapping_Int_Seq_Ext s.current.g.ext d) e).off'0) ((Seq.get (index_Mapping_Int_Seq_Ext s.current.g.ext d) e).size'0))))
    /\ ([@stop_split] [@expl:initialize ensures #14] [%#sinit'14] s.current.p.has_dm
        /\ s.current.p.has_mt
        /\ UInt64.t'int cfg.n_addrs'0 >= 1
        /\ (s.current.p.has_spdk \/ s.current.p.has_factory)
        /\ not cfg.format_on_init'0
        /\ s.current.p.has_logger
        /\ all_from s.current.g.ob s.current.g.tick
        /\ all_from s.current.g.ob2 s.current.g.tick
        /\ (forall i: int. i >= s.current.g.tick -> UInt64.t'int (index_Mapping_Int_u64 s.current.g.ov i) >= 3)
      -> logged s.current.g s.final.g (EmFormat (0: UInt64.t)))
    /\ ([@stop_split] [@expl:initialize ensures #15] [%#sinit'15] s.current.p.has_dm
        /\ s.current.p.has_mt
        /\ UInt64.t'int cfg.n_addrs'0 > 0 /\ s.current.p.has_gpu /\ s.current.g.pool /\ result.f0 = Ok ()
      -> logged s.current.g s.final.g (Register))
    /\ ([@stop_split] [@expl:initialize ensures #16] [%#sinit'16] s.current.p.has_dm
        /\ s.current.p.has_mt
        /\ UInt64.t'int cfg.n_addrs'0 > 0
        /\ s.current.p.has_gpu /\ s.current.g.pool /\ not (s.current.p.has_spdk \/ s.current.p.has_factory)
      -> not index_Mapping_Int_bool s.current.g.ob s.current.g.tick -> logged s.current.g s.final.g (RegWarn))
    /\ ([@stop_split] [@expl:initialize ensures #17] [%#sinit'17] match result.f0 with
      | Ok () -> s.current.p.has_spdk \/ s.current.p.has_factory
      -> s.final.g.rw_base = rw_total s.current.g (UInt64.t'int s.current.p.nd)
      | Err _ -> s.final.g.rw_base = s.current.g.rw_base
      end)}
    (! return {result}) ]

predicate resolve_refmut_S [@inline:trivial] (_1: MutBorrow.t t_S) = _1.final = _1.current

meta "rewrite_def" predicate resolve_refmut_S

meta "compute_max_steps" 1000000

