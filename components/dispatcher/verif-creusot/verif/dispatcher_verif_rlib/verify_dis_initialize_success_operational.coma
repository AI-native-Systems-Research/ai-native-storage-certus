let verify_dis_initialize_success_operational [#"/home/cornel/repair-j35-rc23/components/dispatcher/verif-creusot/src/drivers.rs" 83 0 83 97]
  (s: MutBorrow.t t_S) (cfg: t_ICfg) (return (x: tup2_Result_unit_DE_DFail)) =
{[@stop_split] [@expl:verify_dis_initialize_success_operational requires] ([@stop_split] [@expl:verify_dis_initialize_success_operational requires #0] [%#sdrivers'0] pinv s.current.p)
  /\ ([@stop_split] [@expl:verify_dis_initialize_success_operational requires #1] [%#sdrivers'1] s.current.p.has_dm
  /\ s.current.p.has_mt /\ s.current.p.has_spdk /\ UInt64.t'int cfg.n_addrs'0 > 0)}
  (! bb0
  [ bb0 = s0
    [ s0 = MutBorrow.borrow_final <t_S> {s.current} {MutBorrow.get_id s}
        (fun (_bor: MutBorrow.t t_S) -> [ &_13 <- _bor ] [ &s <- { s with current = _bor.final } ] s1)
    | s1 = initialize [%#sdrivers] {_13} {cfg} (fun (_x: tup2_Result_unit_DE_DFail) -> [ &_ret <- _x ] s2)
    | s2 = -{resolve_refmut_S s}- s3
    | s3 = return {_ret} ] ]
  [ & _ret: tup2_Result_unit_DE_DFail = Any.any_l ()
  | & s: MutBorrow.t t_S = s
  | & cfg: t_ICfg = cfg
  | & _13: MutBorrow.t t_S = Any.any_l () ])
  [ return (result: tup2_Result_unit_DE_DFail) ->
  {[@stop_split] [@expl:verify_dis_initialize_success_operational ensures] [%#sdrivers'2] result.f0 = Ok ()
    -> s.final.p.nd = cfg.n_addrs'0 /\ s.final.p.writer /\ s.final.p.init /\ pinv s.final.p}
    (! return {result}) ]
