use creusot.int.UInt64
use seq.Seq
use int.Int

predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
  [%#swell_founded] self >= 0 /\ self > other

meta "rewrite_def" predicate well_founded_relation_Int

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant s : Seq.seq UInt64.t

constant k : UInt64.t

function count_k [#"/home/cornel/repair-dispatcher-remove/components/dispatcher/verif-creusot/src/batch.rs" 258 0 258 42] (s: Seq.seq UInt64.t) (k: UInt64.t) : int

goal vc_count_k: if Seq.length s = 0 then
    true
  else
    [@expl:variant decreases] well_founded_relation_Int ([%#sbatch] Seq.length s) ([%#sbatch] Seq.length (Seq.([..]) s 0 (Seq.length s
    - 1)))
  
