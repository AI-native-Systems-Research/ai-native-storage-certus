type t_Job = { key: UInt64.t; size: UInt32.t; dev: UInt64.t }

type t_Option_usize = None | Some UInt64.t

type t_Ev =
  | H2D UInt64.t UInt64.t UInt64.t UInt64.t
  | D2H UInt64.t UInt64.t UInt64.t UInt64.t
  | Sync UInt64.t
  | MtTouch UInt64.t
  | MtGet UInt64.t
