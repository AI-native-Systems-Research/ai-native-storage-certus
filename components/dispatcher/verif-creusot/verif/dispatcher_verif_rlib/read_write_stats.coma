  ssd_ev: bool;
  mt_ev: bool;
  ring: bool;
  chunk: UInt64.t;
  stg: bool;
  stg_bytes: UInt64.t;
  warm: UInt64.t }

type t_FMap_u64_Ent

type t_FMap_u64_Slot

type t_Ctr = {
  promo_mem: int;
  promo_gpu: int;
  ev_mem: int;
  ev_ssd: int;
  hit_dram: int;
  hit_ssd: int;
