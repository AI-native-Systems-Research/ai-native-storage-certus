type t_Result_usize_DE = Ok UInt64.t | Err t_DE

function len_u64 (self: t_FMap_u64_Slot) : int

axiom len_u64_spec: forall self: t_FMap_u64_Slot [len_u64 self]. [%#sfmap'0] len_u64 self >= 0

type t_Option_u64 = None'0 | Some'0 UInt64.t

type t_Loc = Mem UInt64.t UInt32.t t_Option_u64 | Blk UInt64.t

type t_Ent = { loc: t_Loc; es: UInt32.t; rr: UInt32.t; wr: UInt32.t }

type t_Option_Ent = None'1 | Some'1 t_Ent

function to_mapping_u64 (self: t_FMap_u64_Ent) : Map.map UInt64.t t_Option_Ent

function get_u64 [@inline:trivial] (self: t_FMap_u64_Ent) (k: UInt64.t) : t_Option_Ent =
  [%#sfmap] Map.get (to_mapping_u64 self) k

meta "rewrite_def" function get_u64

predicate contains_u64 [@inline:trivial] (self: t_FMap_u64_Ent) (k: UInt64.t) = [%#sfmap'1] get_u64 self k <> None'1

meta "rewrite_def" predicate contains_u64

predicate has [#"/home/cornel/repair-j33-rc24/components/dispatcher/verif-creusot/src/core.rs" 335 0 335 32] (w: t_W) (k: UInt64.t) =
  [%#score'0] contains_u64 w.dm k

predicate index_Mapping_Ent_bool [@inline:trivial] (self: Map.map t_Ent bool) (a: t_Ent) = [%#smapping] Map.get self a

meta "rewrite_def" predicate index_Mapping_Ent_bool

function such_that_Ent (p'0: Map.map t_Ent bool) : t_Ent

axiom such_that_Ent_spec:
  forall p'0: Map.map t_Ent bool [such_that_Ent p'0]. ([%#slogic] exists x: t_Ent. index_Mapping_Ent_bool p'0 x)
    -> ([%#slogic'0] index_Mapping_Ent_bool p'0 (such_that_Ent p'0))

function unwrap_Option_Ent (self: t_Option_Ent) : t_Ent = [%#soption'0] match self with
    | Some'1 x -> x
    | None'1 -> such_that_Ent (fun (__0: t_Ent) -> true)
    end

function lookup_u64 [@inline:trivial] (self: t_FMap_u64_Ent) (k: UInt64.t) : t_Ent =
  [%#sfmap'2] unwrap_Option_Ent (get_u64 self k)

meta "rewrite_def" function lookup_u64

function ent [#"/home/cornel/repair-j33-rc24/components/dispatcher/verif-creusot/src/core.rs" 340 0 340 31] (w: t_W) (k: UInt64.t) : t_Ent
 = [%#score'1] lookup_u64 w.dm k

type t_Slot = { ptr'1: UInt64.t; size'1: UInt32.t }

type t_Option_Slot = None'2 | Some'2 t_Slot

function to_mapping_u64'0 (self: t_FMap_u64_Slot) : Map.map UInt64.t t_Option_Slot

function get_u64'0 [@inline:trivial] (self: t_FMap_u64_Slot) (k: UInt64.t) : t_Option_Slot =
  [%#sfmap] Map.get (to_mapping_u64'0 self) k

meta "rewrite_def" function get_u64'0

predicate contains_u64'0 [@inline:trivial] (self: t_FMap_u64_Slot) (k: UInt64.t) =
  [%#sfmap'1] get_u64'0 self k <> None'2

meta "rewrite_def" predicate contains_u64'0

predicate mt_has [#"/home/cornel/repair-j33-rc24/components/dispatcher/verif-creusot/src/core.rs" 386 0 386 35] (w: t_W) (k: UInt64.t) =
  [%#score'2] contains_u64'0 w.mt k

predicate log_ext [#"/home/cornel/repair-j33-rc24/components/dispatcher/verif-creusot/src/core.rs" 426 0 426 34] (a: t_W) (b: t_W) =
  [%#score'3] Seq.length a.log <= Seq.length b.log
  /\ (forall i: int. 0 <= i /\ i < Seq.length a.log -> Seq.get b.log i = Seq.get a.log i)

predicate mono_ctr [#"/home/cornel/repair-j33-rc24/components/dispatcher/verif-creusot/src/core.rs" 416 0 416 39] (a: t_Ctr) (b: t_Ctr) =
  [%#score'4] a.promo_mem <= b.promo_mem
  /\ a.promo_gpu <= b.promo_gpu
  /\ a.ev_mem <= b.ev_mem
  /\ a.ev_ssd <= b.ev_ssd
  /\ a.hit_dram <= b.hit_dram
  /\ a.hit_ssd <= b.hit_ssd
  /\ a.r_hit <= b.r_hit
  /\ a.r_miss <= b.r_miss
  /\ a.bp <= b.bp
  /\ a.drop_full <= b.drop_full
  /\ a.already <= b.already /\ a.blk_pin <= b.blk_pin /\ a.exhausted <= b.exhausted /\ a.blk_unp <= b.blk_unp

predicate same_env [#"/home/cornel/repair-j33-rc24/components/dispatcher/verif-creusot/src/core.rs" 677 0 677 35] (a: t_W) (b: t_W) =
  [%#score'5] b.pool = a.pool
  /\ b.cluster = a.cluster
  /\ b.cap = a.cap
  /\ b.ext = a.ext
  /\ b.rw = a.rw
  /\ b.ob = a.ob
  /\ b.ob2 = a.ob2
  /\ b.og = a.og /\ b.os = a.os /\ b.ov = a.ov /\ b.ok = a.ok /\ b.threads = a.threads /\ b.cfree = a.cfree

let clear_memory_tier (s: MutBorrow.t t_S) (return (x: t_Result_usize_DE)) = any
  [ return (result: t_Result_usize_DE) ->
  {[@stop_split] [@expl:clear_memory_tier ensures] ([@stop_split] [@expl:clear_memory_tier ensures #0] [%#smisc] s.final.p
      = s.current.p)
    /\ ([@stop_split] [@expl:clear_memory_tier ensures #1] [%#smisc'0] not s.current.p.init
      -> result = Err (NotInit (Dispatcher)) /\ s.final.g = s.current.g)
    /\ ([@stop_split] [@expl:clear_memory_tier ensures #2] [%#smisc'1] s.current.p.init
        /\ s.current.p.has_dm /\ s.current.p.has_mt
      -> match result with
        | Ok _ -> len_u64 s.final.g.mt = 0
        | Err (Timeout) -> true
        | Err _ -> false
        end)
    /\ ([@stop_split] [@expl:clear_memory_tier ensures #3] [%#smisc'2] forall k: UInt64.t. has s.current.g k
          /\ (UInt32.t'int (ent s.current.g k).rr > 0 \/ UInt32.t'int (ent s.current.g k).wr > 0)
        -> get_u64 s.final.g.dm k = get_u64 s.current.g.dm k)
    /\ ([@stop_split] [@expl:clear_memory_tier ensures #4] [%#smisc'3] forall k: UInt64.t. has s.current.g k
          /\ (UInt32.t'int (ent s.current.g k).rr > 0 \/ UInt32.t'int (ent s.current.g k).wr > 0)
          /\ mt_has s.current.g k -> mt_has s.final.g k)
    /\ ([@stop_split] [@expl:clear_memory_tier ensures #5] [%#smisc'4] log_ext s.current.g s.final.g
    /\ mono_ctr s.current.g.c s.final.g.c /\ s.final.g.wq = s.current.g.wq /\ same_env s.current.g s.final.g)}
    (! return {result}) ]

predicate resolve_refmut_S [@inline:trivial] (_1: MutBorrow.t t_S) = _1.final = _1.current

meta "rewrite_def" predicate resolve_refmut_S

predicate pinv [#"/home/cornel/repair-j33-rc24/components/dispatcher/verif-creusot/src/core.rs" 610 0 610 25] (p'0: t_P) =
  [%#score] (p'0.init -> p'0.has_dm /\ p'0.has_mt /\ p'0.writer) /\ (not p'0.init -> not p'0.ssd_ev /\ not p'0.mt_ev)

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let verify_dis_clear_mt_pin_safe [#"/home/cornel/repair-j33-rc24/components/dispatcher/verif-creusot/src/drivers.rs" 1934 0 1934 67]
  (s: MutBorrow.t t_S) (return (x: t_Result_usize_DE)) =
{[@stop_split] [@expl:verify_dis_clear_mt_pin_safe requires] [%#sdrivers'0] pinv s.current.p /\ s.current.p.init}
  (! bb0
  [ bb0 = s0
    [ s0 = MutBorrow.borrow_final <t_S> {s.current} {MutBorrow.get_id s}
        (fun (_bor: MutBorrow.t t_S) -> [ &_6 <- _bor ] [ &s <- { s with current = _bor.final } ] s1)
    | s1 = clear_memory_tier [%#sdrivers] {_6} (fun (_x: t_Result_usize_DE) -> [ &_ret <- _x ] s2)
    | s2 = -{resolve_refmut_S s}- s3
    | s3 = return {_ret} ] ]
  [ & _ret: t_Result_usize_DE = Any.any_l () | & s: MutBorrow.t t_S = s | & _6: MutBorrow.t t_S = Any.any_l () ])
  [ return (result: t_Result_usize_DE) ->
  {[@stop_split] [@expl:verify_dis_clear_mt_pin_safe ensures] [%#sdrivers'1] forall k: UInt64.t. has s.current.g k
        /\ (UInt32.t'int (ent s.current.g k).rr > 0 \/ UInt32.t'int (ent s.current.g k).wr > 0) /\ mt_has s.current.g k
      -> mt_has s.final.g k /\ get_u64 s.final.g.dm k = get_u64 s.current.g.dm k}
    (! return {result}) ]
