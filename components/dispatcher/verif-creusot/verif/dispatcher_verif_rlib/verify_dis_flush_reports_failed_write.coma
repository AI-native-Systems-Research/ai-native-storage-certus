let verify_dis_flush_reports_failed_write [#"/home/cornel/repair-j33-rc29/components/dispatcher/verif-creusot/src/drivers.rs" 1952 0 1952 98]
  (s: MutBorrow.t t_S) (return (x: tup2_Result_usize_DE_Snapshot_Seq_u64)) =
{[@stop_split] [@expl:verify_dis_flush_reports_failed_write requires] ([@stop_split] [@expl:verify_dis_flush_reports_failed_write requires #0] [%#sdrivers'0] pinv s.current.p
    /\ s.current.p.init)
  /\ ([@stop_split] [@expl:verify_dis_flush_reports_failed_write requires #1] [%#sdrivers'1] a_us5_q s.current.p s.current.g.wq)}
  (! bb0
  [ bb0 = s0
    [ s0 = MutBorrow.borrow_final <t_S> {s.current} {MutBorrow.get_id s}
        (fun (_bor: MutBorrow.t t_S) -> [ &_9 <- _bor ] [ &s <- { s with current = _bor.final } ] s1)
    | s1 = flush_to_ssd [%#sdrivers] {_9} (fun (_x: tup2_Result_usize_DE_Snapshot_Seq_u64) -> [ &_ret <- _x ] s2)
    | s2 = -{resolve_refmut_S s}- s3
    | s3 = return {_ret} ] ]
  [ & _ret: tup2_Result_usize_DE_Snapshot_Seq_u64 = Any.any_l ()
  | & s: MutBorrow.t t_S = s
  | & _9: MutBorrow.t t_S = Any.any_l () ])
  [ return (result: tup2_Result_usize_DE_Snapshot_Seq_u64) ->
  {[@stop_split] [@expl:verify_dis_flush_reports_failed_write ensures] [%#sdrivers'2] Seq.length s.final.g.wq = 0
    /\ match result.f0 with
      | Ok _ -> forall k: UInt64.t. mt_has s.final.g k -> not index_Mapping_u64_bool s.final.g.wf k
      | Err e -> e = Io (Ssd'0) /\ (exists k: UInt64.t. mt_has s.final.g k /\ index_Mapping_u64_bool s.final.g.wf k)
      end}
    (! return {result}) ]
