let flush_to_ssd (s: MutBorrow.t t_S) (return (x: tup2_Result_usize_DE_Snapshot_Seq_u64)) =
{[@stop_split] [@expl:flush_to_ssd requires] [%#smethods] pinv s.current.p /\ a_us5_q s.current.p s.current.g.wq}
  any
  [ return (result: tup2_Result_usize_DE_Snapshot_Seq_u64) ->
  {[@stop_split] [@expl:flush_to_ssd ensures] ([@stop_split] [@expl:flush_to_ssd ensures #0] [%#smethods'0] s.final.p
      = s.current.p)
    /\ ([@stop_split] [@expl:flush_to_ssd ensures #1] [%#smethods'1] not s.current.p.init
      -> result.f0 = Err (NotInit (Dispatcher)) /\ s.final.g = s.current.g)
    /\ ([@stop_split] [@expl:flush_to_ssd ensures #2] [%#smethods'2] s.current.p.init -> Seq.length s.final.g.wq = 0)
    /\ ([@stop_split] [@expl:flush_to_ssd ensures #3] [%#smethods'3] s.current.p.init
      -> match result.f0 with
        | Ok _ -> forall k: UInt64.t. mt_has s.final.g k -> not index_Mapping_u64_bool s.final.g.wf k
        | Err e -> e = Io (Ssd'0) /\ (exists k: UInt64.t. mt_has s.final.g k /\ index_Mapping_u64_bool s.final.g.wf k)
        end)
    /\ ([@stop_split] [@expl:flush_to_ssd ensures #4] [%#smethods'4] s.current.p.init
      -> (forall i: int. 0 <= i /\ i < Seq.length result.f1
        -> has s.final.g (Seq.get result.f1 i) /\ persisted (ent s.final.g (Seq.get result.f1 i)).loc))
    /\ ([@stop_split] [@expl:flush_to_ssd ensures #5] [%#smethods'5] forall k: UInt64.t. has s.current.g k
          /\ persisted (ent s.current.g k).loc -> persisted (ent s.final.g k).loc)
    /\ ([@stop_split] [@expl:flush_to_ssd ensures #6] [%#smethods'6] forall k: UInt64.t. has s.current.g k
        -> has s.final.g k)
    /\ ([@stop_split] [@expl:flush_to_ssd ensures #7] [%#smethods'7] log_ext s.current.g s.final.g
    /\ same_ctr s.current.g.c s.final.g.c /\ s.final.g.mt = s.current.g.mt)}
    (! return {result}) ]

predicate resolve_refmut_S [@inline:trivial] (_1: MutBorrow.t t_S) = _1.final = _1.current

meta "rewrite_def" predicate resolve_refmut_S

meta "compute_max_steps" 1000000

