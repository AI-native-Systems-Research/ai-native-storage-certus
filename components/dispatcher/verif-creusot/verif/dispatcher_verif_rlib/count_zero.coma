use seq.Seq
use int.Int

function count_true [#"/home/cornel/repair-j33-rc4/components/dispatcher/verif-creusot/src/batch.rs" 401 0 401 46] (s: Seq.seq bool) (n: int) : int

axiom count_true_def: forall s: Seq.seq bool, n: int [count_true s n]. count_true s n
    = ([%#sbatch'4] if n <= 0 then 0 else count_true s (n - 1) + (if Seq.get s (n - 1) then 1 else 0))

predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
  [%#swell_founded] self >= 0 /\ self > other

meta "rewrite_def" predicate well_founded_relation_Int

