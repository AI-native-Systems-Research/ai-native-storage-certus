    /\ ([@stop_split] [@expl:classify ensures #1] [%#smisc'11] forall j: UInt64.t. get_u64 s.final.g.dm j
        = get_u64 s.current.g.dm j)
    /\ ([@stop_split] [@expl:classify ensures #2] [%#smisc'12] s.final.g.mt = s.current.g.mt
      /\ s.final.g.used = s.current.g.used /\ s.final.g.wq = s.current.g.wq /\ same_ctr s.current.g.c s.final.g.c)
    /\ ([@stop_split] [@expl:classify ensures #3] [%#smisc'13] no_dma s.current.g s.final.g
      /\ no_ssd s.current.g s.final.g)
    /\ ([@stop_split] [@expl:classify ensures #4] [%#smisc'14] forall i: int. 0 <= i
          /\ i < Seq.length (view_Vec_Cold_Global result)
        -> has s.current.g (Seq.get (view_Vec_Cold_Global result) i).key'1
        /\ is_blk (ent s.current.g (Seq.get (view_Vec_Cold_Global result) i).key'1).loc
        /\ (Seq.get (view_Vec_Cold_Global result) i).size'1
          = (ent s.current.g (Seq.get (view_Vec_Cold_Global result) i).key'1).es
        /\ (ent s.current.g (Seq.get (view_Vec_Cold_Global result) i).key'1).loc
        = Blk ((Seq.get (view_Vec_Cold_Global result) i).off'1))
    /\ ([@stop_split] [@expl:classify ensures #5] [%#smisc'15] Seq.length (Slice64.view keys) = 1
        /\ has s.current.g (Seq.get (Slice64.view keys) 0)
        /\ is_blk (ent s.current.g (Seq.get (Slice64.view keys) 0)).loc
        /\ UInt32.t'int (ent s.current.g (Seq.get (Slice64.view keys) 0)).wr = 0
