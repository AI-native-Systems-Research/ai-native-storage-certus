      /\ match Seq.get (view_Vec_Option_Result_unit_DE_Global results.final) (UInt64.t'int (Seq.get (view_Vec_ColdE_Global cold) (UInt64.t'int (Seq.get (view_Vec_Job2_Global jobs) 0).q)).idx'1) with
