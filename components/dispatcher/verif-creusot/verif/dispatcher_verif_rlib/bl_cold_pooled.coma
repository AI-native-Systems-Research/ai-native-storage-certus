    /\ ([@stop_split] [@expl:bl_cold_pooled ensures #12] [%#sbatch'128] no_new_kn (view_Vec_Option_Result_unit_DE_Global results.current) (view_Vec_Option_Result_unit_DE_Global results.final))}
