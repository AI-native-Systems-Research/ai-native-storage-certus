use creusot.prelude.MutBorrow
use creusot.int.UInt64
use seq.Seq
use creusot.prelude.Any
use int.Int

type t_Vec_usize_Global

type t_Stg = { slots: UInt64.t; free: t_Vec_usize_Global; leased: int }

constant const_MAX: UInt64.t = (18446744073709551615: UInt64.t)

function view_Vec_usize_Global (self: t_Vec_usize_Global) : Seq.seq UInt64.t

axiom view_Vec_usize_Global_spec:
  forall self: t_Vec_usize_Global [view_Vec_usize_Global self]. [%#svec'1] Seq.length (view_Vec_usize_Global self)
    <= UInt64.t'int const_MAX

let len_usize (self_: t_Vec_usize_Global) (return (x: UInt64.t)) = any
  [ return (result: UInt64.t) -> {[@stop_split] [@expl:len ensures] [%#svec] UInt64.t'int result
    = Seq.length (view_Vec_usize_Global self_)}
    (! return {result}) ]

type t_Option_usize = None | Some UInt64.t

let pop_usize (self_: MutBorrow.t t_Vec_usize_Global) (return (x: t_Option_usize)) = any
  [ return (result: t_Option_usize) -> {[@stop_split] [@expl:pop ensures] [%#svec'0] match result with
      | Some t -> view_Vec_usize_Global self_.final
        = Seq.([..]) (view_Vec_usize_Global self_.current) 0 (Seq.length (view_Vec_usize_Global self_.current) - 1)
      /\ view_Vec_usize_Global self_.current = Seq.snoc (view_Vec_usize_Global self_.final) t
      | None -> self_.current = self_.final /\ Seq.length (view_Vec_usize_Global self_.current) = 0
      end}
    (! return {result}) ]

let unwrap_or_panic_usize (o: t_Option_usize) (return (x: UInt64.t)) = any
  [ return (result: UInt64.t) -> {[@stop_split] [@expl:unwrap_or_panic ensures] [%#score] o = Some result}
    (! return {result}) ]

predicate resolve_refmut_Stg [@inline:trivial] (_1: MutBorrow.t t_Stg) = _1.final = _1.current

meta "rewrite_def" predicate resolve_refmut_Stg

predicate stg_inv [#"/home/cornel/repair-j33-rc21/components/dispatcher/verif-creusot/src/bg.rs" 161 0 161 30] (p: t_Stg) =
  [%#sbg'8] p.leased >= 0
  /\ p.leased + Seq.length (view_Vec_usize_Global p.free) = UInt64.t'int p.slots
  /\ (forall i: int. 0 <= i /\ i < Seq.length (view_Vec_usize_Global p.free)
    -> UInt64.t'int (Seq.get (view_Vec_usize_Global p.free) i) < UInt64.t'int p.slots)

