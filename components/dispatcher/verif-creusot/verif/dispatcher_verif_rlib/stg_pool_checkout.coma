  | & _20: t_Option_usize = Any.any_l ()
  | & _21: MutBorrow.t t_Vec_usize_Global = Any.any_l () ])
  [ return (result: UInt64.t) -> {[@stop_split] [@expl:stg_pool_checkout ensures] [%#sbg'7] stg_inv p.final
