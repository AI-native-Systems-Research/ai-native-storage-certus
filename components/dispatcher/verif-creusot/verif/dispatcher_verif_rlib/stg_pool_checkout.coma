    | s6 = return {_ret} ] ]
  [ & _ret: UInt64.t = Any.any_l ()
  | & p: MutBorrow.t t_Stg = p
  | & p0: t_Stg = Any.any_l ()
  | & _15: bool = Any.any_l ()
