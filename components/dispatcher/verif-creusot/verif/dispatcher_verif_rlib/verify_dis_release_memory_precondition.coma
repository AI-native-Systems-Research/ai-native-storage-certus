let verify_dis_release_memory_precondition [#"/home/cornel/repair-j35-rc23/components/dispatcher/verif-creusot/src/drivers.rs" 2039 0 2039 82]
  (s: MutBorrow.t t_S) (k: UInt64.t) (return (x: t_Result_unit_DE)) =
{[@stop_split] [@expl:verify_dis_release_memory_precondition requires] ([@stop_split] [@expl:verify_dis_release_memory_precondition requires #0] [%#sdrivers'0] pinv s.current.p
    /\ s.current.p.init)
  /\ ([@stop_split] [@expl:verify_dis_release_memory_precondition requires #1] [%#sdrivers'1] mt_has s.current.g k
  -> not (has s.current.g k
  /\ match (ent s.current.g k).loc with
    | Mem ptr _ _ -> ptr = (lookup_u64 s.current.g.mt k).ptr'1
    | _ -> false
    end))}
  (! bb0
  [ bb0 = s0
    [ s0 = MutBorrow.borrow_final <t_S> {s.current} {MutBorrow.get_id s}
        (fun (_bor: MutBorrow.t t_S) -> [ &_11 <- _bor ] [ &s <- { s with current = _bor.final } ] s1)
    | s1 = release_memory [%#sdrivers] {_11} {k} (fun (_x: t_Result_unit_DE) -> [ &_ret <- _x ] s2)
    | s2 = -{resolve_refmut_S s}- s3
    | s3 = return {_ret} ] ]
  [ & _ret: t_Result_unit_DE = Any.any_l ()
  | & s: MutBorrow.t t_S = s
  | & k: UInt64.t = k
  | & _11: MutBorrow.t t_S = Any.any_l () ])
  [ return (result: t_Result_unit_DE) ->
  {[@stop_split] [@expl:verify_dis_release_memory_precondition ensures] [%#sdrivers'2] s.final.g.dm = s.current.g.dm
    /\ (forall j: UInt64.t. has s.final.g j
      -> match (ent s.final.g j).loc with
        | Mem ptr _ _ -> j <> k -> get_u64 s.final.g.mt j = get_u64 s.current.g.mt j
        | _ -> true
        end)}
    (! return {result}) ]
