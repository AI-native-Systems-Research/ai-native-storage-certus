let release_memory (s: MutBorrow.t t_S) (k: UInt64.t) (return (x: t_Result_unit_DE)) = any
  [ return (result: t_Result_unit_DE) ->
  {[@stop_split] [@expl:release_memory ensures] ([@stop_split] [@expl:release_memory ensures #0] [%#smethods] s.final.p
      = s.current.p)
    /\ ([@stop_split] [@expl:release_memory ensures #1] [%#smethods'0] not s.current.p.init
      -> result = Err (NotInit (Dispatcher)) /\ s.final.g = s.current.g)
    /\ ([@stop_split] [@expl:release_memory ensures #2] [%#smethods'1] s.current.p.init /\ s.current.p.has_mt
      -> result = Ok ()
      /\ not mt_has s.final.g k
      /\ (mt_has s.current.g k
        -> s.final.g
        = lg { dm = s.current.g.dm;
               mt = remove_u64 s.current.g.mt k;
               used = (if s.current.g.used >= UInt32.t'int (lookup_u64 s.current.g.mt k).size'1 then
                 s.current.g.used - UInt32.t'int (lookup_u64 s.current.g.mt k).size'1
               else
                 0
               );
               cap = s.current.g.cap;
               c = s.current.g.c;
               wq = s.current.g.wq;
               log = s.current.g.log;
               tick = s.current.g.tick;
               ob = s.current.g.ob;
               ob2 = s.current.g.ob2;
               og = s.current.g.og;
               os = s.current.g.os;
               ov = s.current.g.ov;
               ok = s.current.g.ok;
               ext = s.current.g.ext;
               pool = s.current.g.pool;
               cluster = s.current.g.cluster;
               threads = s.current.g.threads;
               rw = s.current.g.rw;
               rw_base = s.current.g.rw_base;
               cfree = s.current.g.cfree;
               wf = s.current.g.wf;
               sdev = s.current.g.sdev } (MtRemove k))
      /\ (not mt_has s.current.g k -> s.final.g = s.current.g))
    /\ ([@stop_split] [@expl:release_memory ensures #3] [%#smethods'2] s.final.g.dm = s.current.g.dm
    /\ (forall j: UInt64.t. j <> k -> get_u64 s.final.g.mt j = get_u64 s.current.g.mt j))}
    (! return {result}) ]

