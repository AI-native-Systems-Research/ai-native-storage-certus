use seq.Seq
use int.Int

function count_true [#"/home/cornel/repair-j35-rc23/components/dispatcher/verif-creusot/src/batch.rs" 419 0 419 46] (s: Seq.seq bool) (n: int) : int

axiom count_true_def: forall s: Seq.seq bool, n: int [count_true s n]. count_true s n
    = ([%#sbatch'5] if n <= 0 then 0 else count_true s (n - 1) + (if Seq.get s (n - 1) then 1 else 0))

function count_eq [#"/home/cornel/repair-j35-rc23/components/dispatcher/verif-creusot/src/batch.rs" 805 0 805 51] (a: Seq.seq bool) (b: Seq.seq bool) (n: int) : ()

axiom count_eq_def: forall a: Seq.seq bool, b: Seq.seq bool, n: int [count_eq a b n]. ([%#sbatch'2] 0 <= n
      /\ n <= Seq.length a /\ n <= Seq.length b /\ (forall i: int. 0 <= i /\ i < n -> Seq.get a i = Seq.get b i))
    -> count_eq a b n = ([%#sbatch'7] if n <= 0 then () else count_eq a b (n - 1))

axiom count_eq_spec: forall a: Seq.seq bool, b: Seq.seq bool, n: int. ([%#sbatch'2] 0 <= n
      /\ n <= Seq.length a /\ n <= Seq.length b /\ (forall i: int. 0 <= i /\ i < n -> Seq.get a i = Seq.get b i))
    -> ([%#sbatch'3] count_true a n = count_true b n)

predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
  [%#swell_founded] self >= 0 /\ self > other

meta "rewrite_def" predicate well_founded_relation_Int

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant s : Seq.seq bool

constant q : int

constant n : int

function count_set [#"/home/cornel/repair-j35-rc23/components/dispatcher/verif-creusot/src/batch.rs" 797 0 797 46] (s: Seq.seq bool) (q: int) (n: int) : ()

goal vc_count_set: ([%#sbatch'0] 0 <= q /\ q < n /\ n <= Seq.length s /\ not Seq.get s q)
  -> (if n <= q + 1 then
    ([@stop_split] [@expl:count_eq requires] [%#sbatch'2] 0 <= q
      /\ q <= Seq.length s
      /\ q <= Seq.length (Seq.set s q true)
      /\ (forall i: int. 0 <= i /\ i < q -> Seq.get s i = Seq.get (Seq.set s q true) i))
    /\ (([@stop_split] [@expl:count_eq ensures] [%#sbatch'3] count_true s q = count_true (Seq.set s q true) q)
    -> ([@stop_split] [@expl:count_set ensures] [%#sbatch'1] count_true (Seq.set s q true) n = count_true s n + 1))
  else
    (([@stop_split] [@expl:count_set requires] [%#sbatch'0] 0 <= q
        /\ q < n - 1 /\ n - 1 <= Seq.length s /\ not Seq.get s q)
      /\ ([@expl:variant decreases] well_founded_relation_Int ([%#sbatch] n) ([%#sbatch] n - 1)))
    /\ (([@stop_split] [@expl:count_set ensures] [%#sbatch'1] count_true (Seq.set s q true) (n - 1)
      = count_true s (n - 1) + 1)
    -> ([@stop_split] [@expl:count_set ensures] [%#sbatch'1] count_true (Seq.set s q true) n = count_true s n + 1))
  )
