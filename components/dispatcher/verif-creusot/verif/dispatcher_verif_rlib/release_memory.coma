      | Ok'0 () -> mt_has s.current.g k
      /\ s.final.g
      = lg { dm = s.current.g.dm;
             mt = remove_u64 s.current.g.mt k;
             used = (if s.current.g.used >= UInt32.t'int (lookup_u64 s.current.g.mt k).size'1 then
               s.current.g.used - UInt32.t'int (lookup_u64 s.current.g.mt k).size'1
             else
               0
             );
             cap = s.current.g.cap;
             c = s.current.g.c;
             wq = s.current.g.wq;
             log = s.current.g.log;
             tick = s.current.g.tick;
             ob = s.current.g.ob;
             ob2 = s.current.g.ob2;
             og = s.current.g.og;
             os = s.current.g.os;
             ov = s.current.g.ov;
             ok = s.current.g.ok;
             ext = s.current.g.ext;
             pool = s.current.g.pool;
             cluster = s.current.g.cluster;
             threads = s.current.g.threads;
             rw = s.current.g.rw;
             cfree = s.current.g.cfree;
             wf = s.current.g.wf } (MtRemove k)
      | Err'0 (KeyNotFound'1) -> not mt_has s.current.g k /\ s.final.g = s.current.g
      | Err'0 _ -> false
      end)}
    (! return {result}) ]

