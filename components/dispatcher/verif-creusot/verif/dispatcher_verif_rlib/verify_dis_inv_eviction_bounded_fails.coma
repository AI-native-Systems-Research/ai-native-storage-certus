let evict_for_space (s: MutBorrow.t t_S) (needed: UInt32.t) (max_attempts: UInt64.t) (return (x: t_Result_unit_DE)) =
any
  [ return (result: t_Result_unit_DE) ->
  {[@stop_split] [@expl:evict_for_space ensures] ([@stop_split] [@expl:evict_for_space ensures #0] [%#sevict] s.final.p
      = s.current.p)
    /\ ([@stop_split] [@expl:evict_for_space ensures #1] [%#sevict'0] evict_frame s.current.g s.final.g
      /\ ev_ctr s.current.g.c s.final.g.c)
    /\ ([@stop_split] [@expl:evict_for_space ensures #2] [%#sevict'1] match result with
        | Ok () -> s.final.g.used + UInt32.t'int needed <= s.final.g.cap
        | Err e -> e = Alloc
        end)
    /\ ([@stop_split] [@expl:evict_for_space ensures #3] [%#sevict'2] s.current.g.used + UInt32.t'int needed
        <= s.current.g.cap -> result = Ok () /\ s.final.g = s.current.g)
    /\ ([@stop_split] [@expl:evict_for_space ensures #4] [%#sevict'3] UInt64.t'int max_attempts = 0
        /\ s.current.g.used + UInt32.t'int needed > s.current.g.cap -> result = Err (Alloc) /\ s.final.g = s.current.g)
    /\ ([@stop_split] [@expl:evict_for_space ensures #5] [%#sevict'4] UInt64.t'int max_attempts >= 1
      /\ s.current.g.used + UInt32.t'int needed > s.current.g.cap
      /\ Seq.length (index_Mapping_Int_Seq_u64 s.current.g.ok s.current.g.tick) >= 1
      /\ evictable s.current.g (cand0 s.current.g)
      /\ mt_has s.current.g (cand0 s.current.g)
      /\ s.current.g.used >= UInt32.t'int (lookup_u64'0 s.current.g.mt (cand0 s.current.g)).size'1
      /\ s.current.g.used - UInt32.t'int (lookup_u64'0 s.current.g.mt (cand0 s.current.g)).size'1 + UInt32.t'int needed
      <= s.current.g.cap
    -> result = Ok ()
    /\ demoted_k s.current.g s.final.g (cand0 s.current.g)
    /\ (forall k: UInt64.t. k <> cand0 s.current.g
      -> get_u64 s.final.g.dm k = get_u64 s.current.g.dm k /\ get_u64'0 s.final.g.mt k = get_u64'0 s.current.g.mt k))}
    (! return {result}) ]

predicate resolve_refmut_S [@inline:trivial] (_1: MutBorrow.t t_S) = _1.final = _1.current

meta "rewrite_def" predicate resolve_refmut_S

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let verify_dis_inv_eviction_bounded_fails [#"/home/cornel/repair-j33-rc21/components/dispatcher/verif-creusot/src/drivers.rs" 1564 0 1564 107]
  (s: MutBorrow.t t_S) (needed: UInt32.t) (max_attempts: UInt64.t) (return (x: t_Result_unit_DE)) = (! bb0
  [ bb0 = s0
    [ s0 = MutBorrow.borrow_final <t_S> {s.current} {MutBorrow.get_id s}
        (fun (_bor: MutBorrow.t t_S) -> [ &_11 <- _bor ] [ &s <- { s with current = _bor.final } ] s1)
    | s1 = evict_for_space [%#sdrivers] {_11} {needed} {max_attempts} (fun (_x: t_Result_unit_DE) -> [ &_ret <- _x ] s2)
    | s2 = -{resolve_refmut_S s}- s3
    | s3 = return {_ret} ] ]
  [ & _ret: t_Result_unit_DE = Any.any_l ()
  | & s: MutBorrow.t t_S = s
  | & needed: UInt32.t = needed
  | & max_attempts: UInt64.t = max_attempts
  | & _11: MutBorrow.t t_S = Any.any_l () ])
