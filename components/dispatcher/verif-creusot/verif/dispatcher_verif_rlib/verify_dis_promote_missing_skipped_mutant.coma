let promote_to_memory_tier (s: MutBorrow.t t_S) (keys: Slice64.slice UInt64.t) (return (x: ())) = any
  [ return (result: ()) ->
  {[@stop_split] [@expl:promote_to_memory_tier ensures] ([@stop_split] [@expl:promote_to_memory_tier ensures #0] [%#smisc] s.final.p
      = s.current.p)
    /\ ([@stop_split] [@expl:promote_to_memory_tier ensures #1] [%#smisc'0] not (s.current.p.init
        /\ s.current.p.has_dm /\ s.current.p.has_mt) -> s.final.g = s.current.g)
    /\ ([@stop_split] [@expl:promote_to_memory_tier ensures #2] [%#smisc'1] refs_kept s.current.g s.final.g
      /\ log_ext s.current.g s.final.g
      /\ no_dma s.current.g s.final.g /\ mono_ctr s.current.g.c s.final.g.c /\ s.final.g.wq = s.current.g.wq)
    /\ ([@stop_split] [@expl:promote_to_memory_tier ensures #3] [%#smisc'2] forall k: UInt64.t. not has s.current.g k
        -> not has s.final.g k)
    /\ ([@stop_split] [@expl:promote_to_memory_tier ensures #4] [%#smisc'3] UInt64.t'int s.current.p.nd = 0
      -> no_ssd s.current.g s.final.g)
    /\ ([@stop_split] [@expl:promote_to_memory_tier ensures #5] [%#smisc'4] s.current.p.init
        /\ s.current.p.has_dm
        /\ s.current.p.has_mt
        /\ Seq.length (Slice64.view keys) = 1
        /\ has s.current.g (Seq.get (Slice64.view keys) 0)
        /\ is_blk (ent s.current.g (Seq.get (Slice64.view keys) 0)).loc
        /\ UInt32.t'int (ent s.current.g (Seq.get (Slice64.view keys) 0)).wr = 0
        /\ UInt32.t'int (ent s.current.g (Seq.get (Slice64.view keys) 0)).rr < UInt32.t'int const_MAX
        /\ not mt_has s.current.g (Seq.get (Slice64.view keys) 0)
        /\ s.current.g.used + UInt32.t'int (ent s.current.g (Seq.get (Slice64.view keys) 0)).es <= s.current.g.cap
        /\ all_from s.current.g.ob s.current.g.tick /\ all_from s.current.g.os s.current.g.tick
      -> (UInt32.t'int (ent s.current.g (Seq.get (Slice64.view keys) 0)).es > 0
        -> is_mem (ent s.final.g (Seq.get (Slice64.view keys) 0)).loc)
      /\ (UInt32.t'int (ent s.current.g (Seq.get (Slice64.view keys) 0)).es = 0
      -> mt_has s.final.g (Seq.get (Slice64.view keys) 0)
      /\ is_blk (ent s.final.g (Seq.get (Slice64.view keys) 0)).loc))
    /\ ([@stop_split] [@expl:promote_to_memory_tier ensures #6] [%#smisc'5] s.current.p.init
      /\ s.current.p.has_dm /\ s.current.p.has_mt
    -> (forall i: int. 0 <= i
        /\ i < Seq.length (Slice64.view keys)
        /\ has s.current.g (Seq.get (Slice64.view keys) i)
        /\ is_mem (ent s.current.g (Seq.get (Slice64.view keys) i)).loc
        /\ UInt32.t'int (ent s.current.g (Seq.get (Slice64.view keys) i)).wr = 0
        /\ UInt32.t'int (ent s.current.g (Seq.get (Slice64.view keys) i)).rr < UInt32.t'int const_MAX
      -> logged s.current.g s.final.g (DmTouch (Seq.get (Slice64.view keys) i))))}
    (! return {result}) ]

