let verify_dis_promote_missing_skipped__mutant [#"/home/cornel/repair-j33-rc29/components/dispatcher/verif-creusot/src/drivers.rs" 1824 0 1824 80]
  (s: MutBorrow.t t_S) (keys: Slice64.slice UInt64.t) (return (x: ())) = (! bb0
  [ bb0 = s0
    [ s0 = MutBorrow.borrow_final <t_S> {s.current} {MutBorrow.get_id s}
        (fun (_bor: MutBorrow.t t_S) -> [ &_5 <- _bor ] [ &s <- { s with current = _bor.final } ] s1)
    | s1 = promote_to_memory_tier [%#sdrivers] {_5} {keys} (fun (_x: ()) -> [ &_ret <- _x ] s2)
    | s2 = -{resolve_refmut_S s}- s3
    | s3 = return {_ret} ] ]
  [ & _ret: () = Any.any_l ()
  | & s: MutBorrow.t t_S = s
  | & keys: Slice64.slice UInt64.t = keys
  | & _5: MutBorrow.t t_S = Any.any_l () ])
  [ return (result: ()) ->
  {[@stop_split] [@expl:verify_dis_promote_missing_skipped__mutant ensures] [%#sdrivers'0] exists k: UInt64.t. not has s.current.g k
      /\ has s.final.g k}
    (! return {result}) ]
