type t_Job = { key: UInt64.t; size: UInt32.t; dev: UInt64.t }

type t_Option_usize = None | Some UInt64.t

type t_Ev =
  | H2D UInt64.t UInt64.t UInt64.t UInt64.t
  | D2H UInt64.t UInt64.t UInt64.t UInt64.t
  | Sync UInt64.t
  | MtTouch UInt64.t
  | MtGet UInt64.t
  | MtBatchTouch
  | MtRemove UInt64.t
  | MtInsert UInt64.t
  | DmTouch UInt64.t
  | DmDemote UInt64.t
  | DmRemove UInt64.t
  | DmCreate UInt64.t
  | DmPromote UInt64.t
  | RelRead UInt64.t int
  | RelWrite UInt64.t int
  | Enq t_Job
  | ExtFree UInt64.t UInt64.t
  | Recover UInt64.t UInt64.t UInt32.t
  | EmFormat UInt64.t
  | EmInit UInt64.t
  | Checkpoint UInt64.t
  | DevSignal UInt64.t
  | DevShutdown UInt64.t
  | DevDetach UInt64.t
  | Register
  | Unregister
  | Join
  | Leave
  | SsdRead UInt64.t UInt64.t
  | SsdWrite UInt64.t UInt64.t
  | RemoteFwd UInt64.t UInt32.t
  | Spawn
  | Cpu UInt64.t t_Option_usize

type t_Ext = { key'0: UInt64.t; off'0: UInt64.t; size'0: UInt32.t }

type t_W = {
  dm: t_FMap_u64_Ent;
  mt: t_FMap_u64_Slot;
  used: int;
  cap: int;
  c: t_Ctr;
  wq: Seq.seq t_Job;
  log: Seq.seq t_Ev;
  tick: int;
  ob: Map.map int bool;
  ob2: Map.map int bool;
  og: Map.map int bool;
  os: Map.map int bool;
  ov: Map.map int UInt64.t;
  ok: Map.map int (Seq.seq UInt64.t);
  ext: Map.map int (Seq.seq t_Ext);
  pool: bool;
  cluster: bool;
  threads: int;
  rw: Map.map int UInt64.t;
  cfree: Map.map int int;
  wf: Map.map UInt64.t bool }

type t_S = { p: t_P; g: t_W }

type t_ICfg = {
  n_addrs'0: UInt64.t;
  format_on_init'0: bool;
  ssd_thr_pos'0: bool;
  mt_thr_pos'0: bool;
  max_att'0: UInt64.t;
  bp_ms'0: UInt64.t;
  stg_slots'0: UInt64.t;
  stg_bytes'0: UInt64.t }

predicate resolve_refmut_S [@inline:trivial] (_1: MutBorrow.t t_S) = _1.final = _1.current

meta "rewrite_def" predicate resolve_refmut_S

type t_Ni = Dispatcher | DispatchMap | MemoryTier | Gpu | Spdk | Logger | Ring

type t_IoK =
  | Partition'0 UInt64.t UInt64.t UInt64.t
  | Drive'0 UInt64.t
  | Gpu'0
  | Sync'0
  | Ssd'0
  | Promote'0
  | Dm'0
  | Remote'0
  | Stream'0
  | Channel'0
  | Other'0

type t_DE = NotInit t_Ni | InvalidParam | KeyNotFound UInt64.t | AlreadyExists UInt64.t | Alloc | Io t_IoK | Timeout

type t_Result_unit_DE = Ok () | Err t_DE

type t_DFail =
  | None'1
  | Parse'1 UInt64.t
  | Create'1 UInt64.t
  | Partition'1 UInt64.t
  | Few'1 UInt64.t UInt64.t
  | Format'1 UInt64.t

type tup2_Result_unit_DE_DFail = { f0: t_Result_unit_DE; f1: t_DFail }

predicate log_ext [#"/home/cornel/repair-j33-rc22/components/dispatcher/verif-creusot/src/core.rs" 422 0 422 34] (a: t_W) (b: t_W) =
  [%#score'3] Seq.length a.log <= Seq.length b.log
  /\ (forall i: int. 0 <= i /\ i < Seq.length a.log -> Seq.get b.log i = Seq.get a.log i)

predicate same_ctr [#"/home/cornel/repair-j33-rc22/components/dispatcher/verif-creusot/src/core.rs" 402 0 402 39] (a: t_Ctr) (b: t_Ctr) =
  [%#score'5] a.promo_mem = b.promo_mem
  /\ a.promo_gpu = b.promo_gpu
  /\ a.ev_mem = b.ev_mem
  /\ a.ev_ssd = b.ev_ssd
  /\ a.hit_dram = b.hit_dram
  /\ a.hit_ssd = b.hit_ssd
  /\ a.r_hit = b.r_hit
  /\ a.r_miss = b.r_miss
  /\ a.bp = b.bp
  /\ a.drop_full = b.drop_full
  /\ a.already = b.already /\ a.blk_pin = b.blk_pin /\ a.exhausted = b.exhausted /\ a.blk_unp = b.blk_unp

function index_Mapping_Int_Int [@inline:trivial] (self: Map.map int int) (a: int) : int = [%#smapping] Map.get self a

meta "rewrite_def" function index_Mapping_Int_Int

predicate index_Mapping_Int_bool [@inline:trivial] (self: Map.map int bool) (a: int) = [%#smapping] Map.get self a

meta "rewrite_def" predicate index_Mapping_Int_bool

predicate all_from [#"/home/cornel/repair-j33-rc22/components/dispatcher/verif-creusot/src/core.rs" 321 0 321 54] (m: Map.map int bool) (t: int) =
  [%#score'6] forall i: int. i >= t -> index_Mapping_Int_bool m i

function index_Mapping_Int_u64 [@inline:trivial] (self: Map.map int UInt64.t) (a: int) : UInt64.t =
  [%#smapping] Map.get self a

meta "rewrite_def" function index_Mapping_Int_u64

predicate drives_ok [#"/home/cornel/repair-j33-rc22/components/dispatcher/verif-creusot/src/init.rs" 31 0 31 38] (w: t_W) (t: int) =
  [%#sinit'53] all_from w.ob t /\ (forall i: int. i >= t -> UInt64.t'int (index_Mapping_Int_u64 w.ov i) >= 3)

predicate logged [#"/home/cornel/repair-j33-rc22/components/dispatcher/verif-creusot/src/core.rs" 464 0 464 40] (a: t_W) (b: t_W) (e: t_Ev) =
  [%#score] exists i: int. Seq.length a.log <= i /\ i < Seq.length b.log /\ Seq.get b.log i = e

let create_data_drives (s: MutBorrow.t t_S) (cfg: t_ICfg) (return (x: tup2_Result_unit_DE_DFail)) =
{[@stop_split] [@expl:create_data_drives requires] [%#sinit'42] s.current.p.has_spdk \/ s.current.p.has_factory}
  any
  [ return (result: tup2_Result_unit_DE_DFail) ->
  {[@stop_split] [@expl:create_data_drives ensures] ([@stop_split] [@expl:create_data_drives ensures #0] [%#sinit'43] s.final.p
        = s.current.p
      /\ log_ext s.current.g s.final.g /\ same_ctr s.current.g.c s.final.g.c)
    /\ ([@stop_split] [@expl:create_data_drives ensures #1] [%#sinit'44] s.final.g.dm = s.current.g.dm
      /\ s.final.g.mt = s.current.g.mt
      /\ s.final.g.wq = s.current.g.wq
      /\ s.final.g.pool = s.current.g.pool
      /\ s.final.g.cluster = s.current.g.cluster
      /\ s.final.g.ob = s.current.g.ob
      /\ s.final.g.ob2 = s.current.g.ob2
      /\ s.final.g.ov = s.current.g.ov /\ s.final.g.ext = s.current.g.ext /\ s.final.g.tick >= s.current.g.tick)
    /\ ([@stop_split] [@expl:create_data_drives ensures #2] [%#sinit'45] match result.f0 with
        | Ok () -> s.current.p.has_logger
        /\ result.f1 = None'1
        /\ (forall i: int. 0 <= i /\ i < UInt64.t'int cfg.n_addrs'0 -> index_Mapping_Int_Int s.final.g.cfree i = 0)
        | Err (NotInit (Logger)) -> not s.current.p.has_logger /\ result.f1 = None'1
        | Err (InvalidParam) -> match result.f1 with
          | Parse'1 _ -> true
          | _ -> false
          end
        | Err (Io (Partition'0 drive expected found)) -> UInt64.t'int expected = 3
        /\ UInt64.t'int found < 3 /\ result.f1 = Few'1 drive found
        | Err (Io (Drive'0 i)) -> result.f1 = Create'1 i \/ result.f1 = Partition'1 i \/ result.f1 = Format'1 i
        | Err _ -> false
        end)
    /\ ([@stop_split] [@expl:create_data_drives ensures #3] [%#sinit'46] s.current.p.has_logger
        /\ drives_ok s.current.g s.current.g.tick -> result.f0 = Ok ())
    /\ ([@stop_split] [@expl:create_data_drives ensures #4] [%#sinit'47] match result.f1 with
        | Few'1 d f -> result.f0 = Err (Io (Partition'0 d (3: UInt64.t) f)) /\ UInt64.t'int f < 3
        | Create'1 d -> result.f0 = Err (Io (Drive'0 d))
        | Partition'1 d -> result.f0 = Err (Io (Drive'0 d))
        | Format'1 d -> result.f0 = Err (Io (Drive'0 d))
        | Parse'1 _ -> result.f0 = Err (InvalidParam)
        | None'1 -> true
        end)
    /\ ([@stop_split] [@expl:create_data_drives ensures #5] [%#sinit'48] forall i: int. Seq.length s.current.g.log <= i
          /\ i < Seq.length s.final.g.log
        -> match Seq.get s.final.g.log i with
          | EmFormat _ -> true
          | EmInit _ -> true
          | _ -> false
          end)
    /\ ([@stop_split] [@expl:create_data_drives ensures #6] [%#sinit'49] not cfg.format_on_init'0
      /\ s.current.p.has_logger
      /\ UInt64.t'int cfg.n_addrs'0 >= 1
      /\ all_from s.current.g.ob s.current.g.tick
      /\ all_from s.current.g.ob2 s.current.g.tick
      /\ (forall i: int. i >= s.current.g.tick -> UInt64.t'int (index_Mapping_Int_u64 s.current.g.ov i) >= 3)
    -> logged s.current.g s.final.g (EmFormat (0: UInt64.t)))}
    (! return {result}) ]

let elim_Err (_x: t_Result_unit_DE) (return (f0'0: t_DE)) = any
  [ _k (f0'0: t_DE) -> {Err f0'0 = _x} (! return {f0'0})
  | _chk -> (! {[@expl:elim Err] match _x with
      | Err _ -> true
      | _ -> false
      end}
    any) ]

predicate same_env [#"/home/cornel/repair-j33-rc22/components/dispatcher/verif-creusot/src/core.rs" 673 0 673 35] (a: t_W) (b: t_W) =
  [%#score'7] b.pool = a.pool
  /\ b.cluster = a.cluster
  /\ b.cap = a.cap
  /\ b.ext = a.ext
  /\ b.rw = a.rw
  /\ b.ob = a.ob
  /\ b.ob2 = a.ob2
  /\ b.og = a.og /\ b.os = a.os /\ b.ov = a.ov /\ b.ok = a.ok /\ b.threads = a.threads /\ b.cfree = a.cfree

function index_Mapping_Int_Seq_Ext [@inline:trivial] (self: Map.map int (Seq.seq t_Ext)) (a: int) : Seq.seq t_Ext =
  [%#smapping] Map.get self a

meta "rewrite_def" function index_Mapping_Int_Seq_Ext

type t_Option_u64 = None'0 | Some'0 UInt64.t

