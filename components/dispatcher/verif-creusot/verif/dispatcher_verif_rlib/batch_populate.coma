               cap = s.current.g.cap;
               c = s.current.g.c;
               wq = s.current.g.wq;
               log = s.current.g.log;
               tick = s.current.g.tick;
               ob = s.current.g.ob;
               ob2 = s.current.g.ob2;
               og = s.current.g.og;
               os = s.current.g.os;
