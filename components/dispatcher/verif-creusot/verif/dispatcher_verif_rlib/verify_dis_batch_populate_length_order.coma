type t_S = { p: t_P; g: t_W }

type t_Ipc = { addr'1: UInt64.t; size'1: UInt32.t }

type t_Pe = { key'1: UInt64.t; h'1: t_Ipc }

type t_Vec_Result_unit_DE_Global

type t_Kind = Unseen | Zero | Dropped | RsvErr | CopyErr | Sub

type t_BpG = {
  kind: Seq.seq t_Kind;
  rel: Seq.seq bool;
  reg: Seq.seq bool;
  sync_at: int;
  sync_ok: bool;
  store: UInt64.t }

type tup2_Vec_Result_unit_DE_Global_Snapshot_BpG = { f0: t_Vec_Result_unit_DE_Global; f1: t_BpG }

predicate pinv [#"/home/cornel/repair-j33-rc21/components/dispatcher/verif-creusot/src/core.rs" 612 0 612 25] (p'0: t_P) =
  [%#score] (p'0.init -> p'0.has_dm /\ p'0.has_mt /\ p'0.writer) /\ (not p'0.init -> not p'0.ssd_ev /\ not p'0.mt_ev)

type t_Ni = Dispatcher | DispatchMap | MemoryTier | Gpu | Spdk | Logger | Ring

type t_IoK =
  | Partition'0 UInt64.t UInt64.t UInt64.t
  | Drive'0 UInt64.t
  | Gpu'0
  | Sync'0
  | Ssd'0
  | Promote'0
  | Dm'0
  | Remote'0
  | Stream'0
  | Channel'0
  | Other'0

type t_DE = NotInit t_Ni | InvalidParam | KeyNotFound UInt64.t | AlreadyExists UInt64.t | Alloc | Io t_IoK | Timeout

type t_Result_unit_DE = Ok () | Err t_DE

constant const_MAX: UInt64.t = (18446744073709551615: UInt64.t)

function view_Vec_Result_unit_DE_Global (self: t_Vec_Result_unit_DE_Global) : Seq.seq t_Result_unit_DE

axiom view_Vec_Result_unit_DE_Global_spec:
  forall self: t_Vec_Result_unit_DE_Global [view_Vec_Result_unit_DE_Global self]. [%#svec] Seq.length (view_Vec_Result_unit_DE_Global self)
    <= UInt64.t'int const_MAX

let batch_populate (s: MutBorrow.t t_S) (entries: Slice64.slice t_Pe)
  (return (x: tup2_Vec_Result_unit_DE_Global_Snapshot_BpG)) =
{[@stop_split] [@expl:batch_populate requires] [%#sstore] pinv s.current.p}
  any
  [ return (result: tup2_Vec_Result_unit_DE_Global_Snapshot_BpG) ->
  {[@stop_split] [@expl:batch_populate ensures] ([@stop_split] [@expl:batch_populate ensures #0] [%#sstore'0] s.final.p
      = s.current.p)
    /\ ([@stop_split] [@expl:batch_populate ensures #1] [%#sstore'1] Seq.length (view_Vec_Result_unit_DE_Global result.f0)
      = Seq.length (Slice64.view entries))
    /\ ([@stop_split] [@expl:batch_populate ensures #2] [%#sstore'2] Seq.length (Slice64.view entries) = 0
      -> s.final.g = s.current.g)
    /\ ([@stop_split] [@expl:batch_populate ensures #3] [%#sstore'3] s.current.p.init /\ not s.current.p.has_gpu
      -> s.final.g = s.current.g
      /\ (forall i: int. 0 <= i /\ i < Seq.length (Slice64.view entries)
        -> Seq.get (view_Vec_Result_unit_DE_Global result.f0) i = Err (NotInit (Gpu))))
    /\ ([@stop_split] [@expl:batch_populate ensures #4] [%#sstore'4] not s.current.p.init
      -> (forall i: int. 0 <= i /\ i < Seq.length (Slice64.view entries)
        -> Seq.get (view_Vec_Result_unit_DE_Global result.f0) i = Err (NotInit (Dispatcher))))
    /\ ([@stop_split] [@expl:batch_populate ensures #5] [%#sstore'5] s.current.p.init
      /\ s.current.p.has_gpu /\ Seq.length (Slice64.view entries) > 0
    -> Seq.length result.f1.kind = Seq.length (Slice64.view entries)
    /\ Seq.length result.f1.rel = Seq.length (Slice64.view entries)
    /\ Seq.length result.f1.reg = Seq.length (Slice64.view entries)
    /\ (forall i: int. 0 <= i /\ i < Seq.length (Slice64.view entries)
        -> Seq.get result.f1.kind i <> Unseen
        /\ (UInt32.t'int (Seq.get (Slice64.view entries) i).h'1.size'1 = 0) = (Seq.get result.f1.kind i = Zero)
        /\ (Seq.get result.f1.kind i = Zero
          -> Seq.get (view_Vec_Result_unit_DE_Global result.f0) i = Err (InvalidParam))
        /\ (Seq.get result.f1.kind i = Dropped
          -> Seq.get (view_Vec_Result_unit_DE_Global result.f0) i = Ok () /\ not Seq.get result.f1.reg i)
        /\ (Seq.get result.f1.kind i = CopyErr
          -> match Seq.get (view_Vec_Result_unit_DE_Global result.f0) i with
              | Err _ -> true
              | _ -> false
              end
          /\ Seq.get result.f1.rel i /\ not Seq.get result.f1.reg i)
        /\ (Seq.get result.f1.kind i = RsvErr
          -> match Seq.get (view_Vec_Result_unit_DE_Global result.f0) i with
              | Err _ -> true
              | _ -> false
              end
          /\ not Seq.get result.f1.reg i)
        /\ (Seq.get result.f1.reg i -> Seq.get result.f1.kind i = Sub /\ result.f1.sync_ok)
        /\ (Seq.get result.f1.kind i = Sub /\ not result.f1.sync_ok
          -> Seq.get (view_Vec_Result_unit_DE_Global result.f0) i = Err (Io (Sync'0))
          /\ Seq.get result.f1.rel i /\ not Seq.get result.f1.reg i)
        /\ (Seq.get result.f1.kind i = Sub /\ result.f1.sync_ok -> Seq.get result.f1.reg i)
        /\ match Seq.get (view_Vec_Result_unit_DE_Global result.f0) i with
          | Err (AlreadyExists k) -> k = (Seq.get (Slice64.view entries) i).key'1
          | _ -> true
          end)
    /\ ((exists i: int. 0 <= i /\ i < Seq.length (Slice64.view entries) /\ Seq.get result.f1.kind i = Sub)
      -> Seq.length s.current.g.log <= result.f1.sync_at
      /\ result.f1.sync_at < Seq.length s.final.g.log
      /\ Seq.get s.final.g.log result.f1.sync_at = Sync (result.f1.store))
    /\ (forall q: int. Seq.length s.current.g.log <= q /\ q < Seq.length s.final.g.log
      -> match Seq.get s.final.g.log q with
        | DmCreate _ -> q > result.f1.sync_at /\ result.f1.sync_at >= 0 /\ result.f1.sync_ok
        | Enq _ -> q > result.f1.sync_at /\ result.f1.sync_at >= 0 /\ result.f1.sync_ok
        | _ -> true
        end))}
    (! return {result}) ]

predicate resolve_refmut_S [@inline:trivial] (_1: MutBorrow.t t_S) = _1.final = _1.current

meta "rewrite_def" predicate resolve_refmut_S

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let verify_dis_batch_populate_length_order [#"/home/cornel/repair-j33-rc21/components/dispatcher/verif-creusot/src/drivers.rs" 525 0 525 112]
  (s: MutBorrow.t t_S) (entries: Slice64.slice t_Pe) (return (x: tup2_Vec_Result_unit_DE_Global_Snapshot_BpG)) =
{[@stop_split] [@expl:verify_dis_batch_populate_length_order requires] [%#sdrivers'0] pinv s.current.p
  /\ s.current.p.init}
  (! bb0
  [ bb0 = s0
    [ s0 = MutBorrow.borrow_final <t_S> {s.current} {MutBorrow.get_id s}
        (fun (_bor: MutBorrow.t t_S) -> [ &_10 <- _bor ] [ &s <- { s with current = _bor.final } ] s1)
    | s1 = batch_populate [%#sdrivers] {_10} {entries}
        (fun (_x: tup2_Vec_Result_unit_DE_Global_Snapshot_BpG) -> [ &_ret <- _x ] s2)
    | s2 = -{resolve_refmut_S s}- s3
    | s3 = return {_ret} ] ]
  [ & _ret: tup2_Vec_Result_unit_DE_Global_Snapshot_BpG = Any.any_l ()
  | & s: MutBorrow.t t_S = s
  | & entries: Slice64.slice t_Pe = entries
  | & _10: MutBorrow.t t_S = Any.any_l () ])
  [ return (result: tup2_Vec_Result_unit_DE_Global_Snapshot_BpG) ->
  {[@stop_split] [@expl:verify_dis_batch_populate_length_order ensures] ([@stop_split] [@expl:verify_dis_batch_populate_length_order ensures #0] [%#sdrivers'1] Seq.length (view_Vec_Result_unit_DE_Global result.f0)
      = Seq.length (Slice64.view entries))
    /\ ([@stop_split] [@expl:verify_dis_batch_populate_length_order ensures #1] [%#sdrivers'2] s.current.p.has_gpu
      /\ Seq.length (Slice64.view entries) > 0
    -> (forall i: int. 0 <= i /\ i < Seq.length (Slice64.view entries)
      -> (UInt32.t'int (Seq.get (Slice64.view entries) i).h'1.size'1 = 0
        -> Seq.get (view_Vec_Result_unit_DE_Global result.f0) i = Err (InvalidParam))
      /\ match Seq.get (view_Vec_Result_unit_DE_Global result.f0) i with
        | Err (AlreadyExists k) -> k = (Seq.get (Slice64.view entries) i).key'1
        | _ -> true
        end))}
    (! return {result}) ]
