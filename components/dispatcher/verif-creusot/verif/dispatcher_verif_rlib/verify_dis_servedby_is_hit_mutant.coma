  [ bb0 = s0 [ s0 = served_by_is_hit [%#sdrivers] {sb} (fun (_x: bool) -> [ &_ret <- _x ] s1) | s1 = return {_ret} ] ]
  [ & _ret: bool = Any.any_l () | & sb: t_ServedBy = sb ])
  [ return (result: bool) ->
  {[@stop_split] [@expl:verify_dis_servedby_is_hit__mutant ensures] ([@stop_split] [@expl:verify_dis_servedby_is_hit__mutant ensures #0] [%#sdrivers'0] result
