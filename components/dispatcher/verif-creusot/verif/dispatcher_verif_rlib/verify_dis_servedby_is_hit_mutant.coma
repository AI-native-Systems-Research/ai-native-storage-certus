use creusot.prelude.Any

type t_ServedBy = Dram | Ssd | Remote | Miss | SizeMismatch | Error

let served_by_is_hit (sb: t_ServedBy) (return (x: bool)) = any
  [ return (result: bool) -> {[@stop_split] [@expl:served_by_is_hit ensures] [%#smisc] result
    = match sb with
      | Dram -> true
      | Ssd -> true
      | Remote -> true
      | _ -> false
      end}
    (! return {result}) ]

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let verify_dis_servedby_is_hit__mutant [#"/home/cornel/repair-j33-rc24/components/dispatcher/verif-creusot/src/drivers.rs" 2209 0 2209 63]
