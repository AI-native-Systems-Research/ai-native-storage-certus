    /\ ([@stop_split] [@expl:batch_lookup ensures #5] [%#sbatch'5] result'0.f1.ready'0
      -> s.final.g.c.promo_gpu
        = s.current.g.c.promo_gpu + count_ok (view_Vec_Outcome_Global result'0.f0) (Seq.length (Slice64.view entries))
      /\ s.final.g.c.hit_dram
        = s.current.g.c.hit_dram
