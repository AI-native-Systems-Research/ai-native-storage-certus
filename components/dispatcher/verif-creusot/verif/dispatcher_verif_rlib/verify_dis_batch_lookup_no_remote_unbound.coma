let batch_lookup (s: MutBorrow.t t_S) (entries: Slice64.slice t_Be) (return (x: tup2_Vec_Outcome_Global_Snapshot_BlG)) =
{[@stop_split] [@expl:batch_lookup requires] [%#sbatch] pinv s.current.p /\ a_fr039 (Slice64.view entries)}
