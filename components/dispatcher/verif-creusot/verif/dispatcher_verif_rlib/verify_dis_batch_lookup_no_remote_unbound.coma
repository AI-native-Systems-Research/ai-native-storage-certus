    /\ ([@stop_split] [@expl:batch_lookup ensures #2] [%#sbatch'2] Seq.length (Slice64.view entries) = 0
      -> s.final.g = s.current.g)
    /\ ([@stop_split] [@expl:batch_lookup ensures #3] [%#sbatch'3] Seq.length (Slice64.view entries) > 0
        /\ not (s.current.p.init /\ s.current.p.has_dm /\ s.current.p.has_mt /\ s.current.p.has_gpu)
      -> s.final.g = s.current.g
      /\ not result'0.f1.ready'0
      /\ (forall i: int. 0 <= i /\ i < Seq.length (Slice64.view entries)
