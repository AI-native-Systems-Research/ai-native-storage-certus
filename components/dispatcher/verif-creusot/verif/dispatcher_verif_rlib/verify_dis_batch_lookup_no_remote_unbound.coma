    /\ ([@stop_split] [@expl:batch_lookup ensures #4] [%#sbatch'4] result'0.f1.ready'0
      -> Seq.length result'0.f1.cls'0 = Seq.length (Slice64.view entries)
      /\ Seq.length result'0.f1.tier'0 = Seq.length (Slice64.view entries)
      /\ (forall i: int. 0 <= i /\ i < Seq.length (Slice64.view entries)
