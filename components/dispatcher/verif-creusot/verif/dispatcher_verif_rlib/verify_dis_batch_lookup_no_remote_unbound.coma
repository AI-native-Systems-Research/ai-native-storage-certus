              | _ -> false
              end -> Seq.get result'0.f1.tier'0 i = Some'0 (Ssd'0))
        /\ (Seq.get result'0.f1.tier'0 i = Some'0 (Remote'0) -> Seq.get result'0.f1.cls'0 i = Miss)
        /\ match (Seq.get (view_Vec_Outcome_Global result'0.f0) i).result with
