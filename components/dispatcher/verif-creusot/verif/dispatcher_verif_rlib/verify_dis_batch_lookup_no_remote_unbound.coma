          = attr (Seq.get (view_Vec_Outcome_Global result'0.f0) i).result (Seq.get result'0.f1.tier'0 i)
        /\ ((Seq.get (view_Vec_Outcome_Global result'0.f0) i).result = Ok'0 ()
          -> Seq.get result'0.f1.tier'0 i <> None'0)
        /\ (Seq.get result'0.f1.tier'0 i = None'0
          \/ Seq.get result'0.f1.tier'0 i = Some'0 (Dram'0)
          \/ Seq.get result'0.f1.tier'0 i = Some'0 (Ssd'0) \/ Seq.get result'0.f1.tier'0 i = Some'0 (Remote'0))
