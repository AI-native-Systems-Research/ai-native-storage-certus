function len_u64 (self: t_FMap_u64_Ent) : int

axiom len_u64_spec: forall self: t_FMap_u64_Ent [len_u64 self]. [%#sfmap'3] len_u64 self >= 0

function insert_u64 (self: t_FMap_u64_Ent) (k: UInt64.t) (v: t_Ent) : t_FMap_u64_Ent

axiom insert_u64_spec:
  forall self: t_FMap_u64_Ent, k: UInt64.t, v: t_Ent [insert_u64 self k v]. [%#sfmap'0] to_mapping_u64 (insert_u64 self k v)
    = Map.set (to_mapping_u64 self) k (Some'1 v)

axiom insert_u64_spec'0:
  forall self: t_FMap_u64_Ent, k: UInt64.t, v: t_Ent [insert_u64 self k v]. [%#sfmap'1] len_u64 (insert_u64 self k v)
    = (if contains_u64 self k then len_u64 self else len_u64 self + 1)

let dm_recover (s: MutBorrow.t t_S) (k: UInt64.t) (off: UInt64.t) (size'1: UInt32.t) (return (x: t_Result_unit_DmE)) =
any
  [ return (result: t_Result_unit_DmE) ->
  {[@stop_split] [@expl:dm_recover ensures] ([@stop_split] [@expl:dm_recover ensures #0] [%#sboundary'1] s.final.p
      = s.current.p)
    /\ ([@stop_split] [@expl:dm_recover ensures #1] [%#sboundary'2] match result with
      | Ok () -> not has s.current.g k
      /\ s.final.g
      = lg { dm = insert_u64 s.current.g.dm k { loc = Blk off; es = size'1; rr = (0: UInt32.t); wr = (0: UInt32.t) };
             mt = s.current.g.mt;
             used = s.current.g.used;
             cap = s.current.g.cap;
             c = s.current.g.c;
             wq = s.current.g.wq;
             log = s.current.g.log;
             tick = s.current.g.tick;
             ob = s.current.g.ob;
             ob2 = s.current.g.ob2;
             og = s.current.g.og;
             os = s.current.g.os;
             ov = s.current.g.ov;
             ok = s.current.g.ok;
             ext = s.current.g.ext;
             pool = s.current.g.pool;
             cluster = s.current.g.cluster;
             threads = s.current.g.threads;
             rw = s.current.g.rw;
             cfree = s.current.g.cfree;
             wf = s.current.g.wf } (Recover k off size'1)
      | Err (AlreadyExists) -> has s.current.g k /\ s.final.g = lg s.current.g (Recover k off size'1)
      | Err _ -> false
      end)}
    (! return {result}) ]

