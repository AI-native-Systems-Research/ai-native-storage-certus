type t_Vec_Ext_Global

constant const_MAX: UInt64.t = (18446744073709551615: UInt64.t)

function view_Vec_Ext_Global (self: t_Vec_Ext_Global) : Seq.seq t_Ext

axiom view_Vec_Ext_Global_spec:
