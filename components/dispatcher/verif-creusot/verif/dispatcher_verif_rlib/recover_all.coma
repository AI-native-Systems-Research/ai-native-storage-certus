let em_extents (s: MutBorrow.t t_S) (drive: UInt64.t) (return (x: t_Vec_Ext_Global)) = any
  [ return (result: t_Vec_Ext_Global) ->
  {[@stop_split] [@expl:em_extents ensures] ([@stop_split] [@expl:em_extents ensures #0] [%#sboundary] s.final.p
        = s.current.p
      /\ s.final.g = s.current.g)
    /\ ([@stop_split] [@expl:em_extents ensures #1] [%#sboundary'0] view_Vec_Ext_Global result
    = index_Mapping_Int_Seq_Ext s.current.g.ext (UInt64.t'int drive))}
    (! return {result}) ]

let len_Ext (self_: t_Vec_Ext_Global) (return (x: UInt64.t)) = any
  [ return (result: UInt64.t) -> {[@stop_split] [@expl:len ensures] [%#svec] UInt64.t'int result
    = Seq.length (view_Vec_Ext_Global self_)}
    (! return {result}) ]

predicate in_bounds_usize [@inline:trivial] (self: UInt64.t) (seq: Seq.seq t_Ext) =
  [%#sslice] UInt64.t'int self < Seq.length seq

meta "rewrite_def" predicate in_bounds_usize

predicate has_value_usize [@inline:trivial] (self: UInt64.t) (seq: Seq.seq t_Ext) (out: t_Ext) =
  [%#sslice'0] Seq.get seq (UInt64.t'int self) = out

meta "rewrite_def" predicate has_value_usize

let index_Vec_Ext_Global (self_: t_Vec_Ext_Global) (ix: UInt64.t) (return (x: t_Ext)) =
{[@stop_split] [@expl:index requires] [%#svec'1] in_bounds_usize ix (view_Vec_Ext_Global self_)}
  any
  [ return (result: t_Ext) ->
  {[@stop_split] [@expl:index ensures] [%#svec'2] has_value_usize ix (view_Vec_Ext_Global self_) result}
    (! return {result}) ]

