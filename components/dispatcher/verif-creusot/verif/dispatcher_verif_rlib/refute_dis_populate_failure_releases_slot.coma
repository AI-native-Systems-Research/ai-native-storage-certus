let p_zero (return (x: t_P)) = any
  [ return (result: t_P) -> {[@stop_split] [@expl:p_zero ensures] [%#sdrivers'13] not result.init
    /\ not result.has_dm
    /\ not result.has_mt
    /\ not result.has_gpu
    /\ not result.has_spdk
    /\ not result.has_factory
    /\ not result.has_rl
    /\ not result.has_logger
    /\ UInt64.t'int result.max_att = 0
    /\ UInt64.t'int result.bp_ms = 0
    /\ UInt64.t'int result.nd = 0
    /\ not result.writer
    /\ not result.ssd_ev
    /\ not result.mt_ev
    /\ not result.ring
    /\ UInt64.t'int result.chunk = 0
    /\ not result.stg /\ UInt64.t'int result.stg_bytes = 0 /\ UInt64.t'int result.warm = 0}
    (! return {result}) ]

