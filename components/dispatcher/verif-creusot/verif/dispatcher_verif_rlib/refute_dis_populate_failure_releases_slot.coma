let populate (s: MutBorrow.t t_S) (key'1: UInt64.t) (h: t_Ipc) (return (x: tup2_Result_unit_DE_Snapshot_PopG)) =
{[@stop_split] [@expl:populate requires] [%#sstore] pinv s.current.p}
  any
  [ return (result: tup2_Result_unit_DE_Snapshot_PopG) ->
  {[@stop_split] [@expl:populate ensures] ([@stop_split] [@expl:populate ensures #0] [%#sstore'0] s.final.p
      = s.current.p)
    /\ ([@stop_split] [@expl:populate ensures #1] [%#sstore'1] not s.current.p.init
      -> result.f0 = Err (NotInit (Dispatcher)) /\ s.final.g = s.current.g)
    /\ ([@stop_split] [@expl:populate ensures #2] [%#sstore'2] s.current.p.init /\ UInt32.t'int h.size'2 = 0
      -> result.f0 = Err (InvalidParam) /\ s.final.g = s.current.g)
    /\ ([@stop_split] [@expl:populate ensures #3] [%#sstore'3] result.f0 <> Err (Alloc))
    /\ ([@stop_split] [@expl:populate ensures #4] [%#sstore'4] s.current.p.init /\ UInt32.t'int h.size'2 > 0
      -> match result.f0 with
        | Ok () -> result.f1.reserved
          /\ has s.final.g key'1
          /\ is_mem (ent s.final.g key'1).loc
          /\ UInt32.t'int (ent s.final.g key'1).wr = 0
          /\ UInt32.t'int (ent s.final.g key'1).rr = 1
          /\ mt_has s.final.g key'1
          /\ (ent s.final.g key'1).loc = Mem ((lookup_u64'0 s.final.g.mt key'1).ptr'1) (h.size'2) (None'0)
          /\ s.final.g.wq = Seq.snoc s.current.g.wq (wjob s.current.p key'1 h.size'2)
          /\ (forall k: UInt64.t. k <> key'1
              -> get_u64 s.final.g.dm k = get_u64 s.current.g.dm k
                /\ get_u64'0 s.final.g.mt k = get_u64'0 s.current.g.mt k
              \/ demoted_k s.current.g s.final.g k)
          /\ result.f1.mid.used <= result.f1.mid.cap
          /\ get_u64'0 result.f1.mid.mt key'1 <> None'2 /\ not has s.current.g key'1
        \/ not result.f1.reserved
        /\ s.final.g.c.drop_full = s.current.g.c.drop_full + 1
        /\ evict_frame s.current.g s.final.g /\ (not has s.current.g key'1 -> not has s.final.g key'1)
        | Err (Io _) -> result.f1.copy_failed \/ result.f1.reserved
        | _ -> true
        end)
    /\ ([@stop_split] [@expl:populate ensures #5] [%#sstore'5] result.f1.copy_failed
      -> match result.f0 with
        | Err (Io _) -> true
        | _ -> false
        end)
    /\ ([@stop_split] [@expl:populate ensures #6] [%#sstore'6] s.current.p.init
        /\ s.current.p.has_gpu
        /\ UInt32.t'int h.size'2 > 0
        /\ result.f1.reserved
        /\ match result.f0 with
          | Err (Io (Sync'0)) -> true
          | _ -> false
          end -> mt_has s.final.g key'1)
    /\ ([@stop_split] [@expl:populate ensures #7] [%#sstore'7] s.current.p.init
        /\ UInt32.t'int h.size'2 > 0 /\ not s.current.p.has_gpu /\ result.f1.reserved
      -> result.f0 = Err (NotInit (Gpu)) /\ mt_has s.final.g key'1)
    /\ ([@stop_split] [@expl:populate ensures #8] [%#sstore'8] s.current.p.init
        /\ UInt32.t'int h.size'2 > 0
        /\ UInt64.t'int s.current.p.bp_ms = 0
        /\ all_from s.current.g.ob s.current.g.tick
        /\ s.current.g.used + UInt32.t'int h.size'2 <= s.current.g.cap /\ not mt_has s.current.g key'1
      -> result.f1.reserved)
    /\ ([@stop_split] [@expl:populate ensures #9] [%#sstore'9] s.current.p.init
      /\ UInt32.t'int h.size'2 > 0
      /\ UInt64.t'int s.current.p.bp_ms = 0
      /\ UInt64.t'int s.current.p.max_att = 0 /\ s.current.g.used + UInt32.t'int h.size'2 > s.current.g.cap
    -> result.f0 = Ok () /\ not result.f1.reserved /\ s.final.g.dm = s.current.g.dm)}
    (! return {result}) ]

