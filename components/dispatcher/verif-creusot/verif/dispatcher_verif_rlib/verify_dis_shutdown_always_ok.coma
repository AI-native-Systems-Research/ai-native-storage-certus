let verify_dis_shutdown_always_ok [#"/home/cornel/repair-j33-rc4/components/dispatcher/verif-creusot/src/drivers.rs" 314 0 314 86]
  (s: MutBorrow.t t_S) (return (x: tup2_Result_unit_DE_Snapshot_ShutPos)) =
{[@stop_split] [@expl:verify_dis_shutdown_always_ok requires] [%#sdrivers'0] a_us5_q s.current.p s.current.g.wq}
