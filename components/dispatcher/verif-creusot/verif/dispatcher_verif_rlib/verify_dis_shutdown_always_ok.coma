type t_DE = NotInit t_Ni | InvalidParam | KeyNotFound UInt64.t | AlreadyExists UInt64.t | Alloc | Io t_IoK | Timeout

type t_Result_unit_DE = Ok () | Err t_DE

type t_ShutPos = { drained: int; devs: int }

type tup2_Result_unit_DE_Snapshot_ShutPos = { f0: t_Result_unit_DE; f1: t_ShutPos }

constant const_MAX: UInt64.t = (18446744073709551615: UInt64.t)

