      /\ not s.final.p.writer /\ not s.final.p.ssd_ev /\ not s.final.p.mt_ev /\ UInt64.t'int s.final.p.nd = 0)
    /\ ([@stop_split] [@expl:shutdown ensures #2] [%#smethods'2] s.final.p.has_dm = s.current.p.has_dm
      /\ s.final.p.has_mt = s.current.p.has_mt
      /\ s.final.p.has_gpu = s.current.p.has_gpu
      /\ s.final.p.has_spdk = s.current.p.has_spdk
      /\ s.final.p.has_factory = s.current.p.has_factory
      /\ s.final.p.has_rl = s.current.p.has_rl
      /\ s.final.p.has_logger = s.current.p.has_logger
      /\ s.final.p.max_att = s.current.p.max_att /\ s.final.p.bp_ms = s.current.p.bp_ms)
    /\ ([@stop_split] [@expl:shutdown ensures #3] [%#smethods'3] s.current.p.writer -> Seq.length s.final.g.wq = 0)
    /\ ([@stop_split] [@expl:shutdown ensures #4] [%#smethods'4] not s.current.p.writer
      -> s.final.g.wq = s.current.g.wq)
    /\ ([@stop_split] [@expl:shutdown ensures #5] [%#smethods'5] log_ext s.current.g s.final.g
      /\ same_ctr s.current.g.c s.final.g.c)
    /\ ([@stop_split] [@expl:shutdown ensures #6] [%#smethods'6] s.final.g.ob = s.current.g.ob
      /\ s.final.g.ov = s.current.g.ov)
    /\ ([@stop_split] [@expl:shutdown ensures #7] [%#smethods'7] forall k: UInt64.t. has s.current.g k
        -> has s.final.g k)
    /\ ([@stop_split] [@expl:shutdown ensures #8] [%#smethods'8] Seq.length s.current.g.log <= result.f1.drained
      /\ result.f1.drained + UInt64.t'int s.current.p.nd <= result.f1.devs
      /\ result.f1.devs + 3 * UInt64.t'int s.current.p.nd <= Seq.length s.final.g.log)
    /\ ([@stop_split] [@expl:shutdown ensures #9] [%#smethods'9] forall i: int. Seq.length s.current.g.log <= i
          /\ i < result.f1.drained -> not is_cp (Seq.get s.final.g.log i) /\ not is_dev (Seq.get s.final.g.log i))
    /\ ([@stop_split] [@expl:shutdown ensures #10] [%#smethods'10] forall j: int. 0 <= j
          /\ j < UInt64.t'int s.current.p.nd
        -> match Seq.get s.final.g.log (result.f1.drained + j) with
