        (fun (_bor: MutBorrow.t t_S) -> [ &_7 <- _bor ] [ &s <- { s with current = _bor.final } ] s1)
    | s1 = shutdown [%#sdrivers] {_7} (fun (_x: tup2_Result_unit_DE_Snapshot_ShutPos) -> [ &_ret <- _x ] s2)
    | s2 = -{resolve_refmut_S s}- s3
    | s3 = return {_ret} ] ]
  [ & _ret: tup2_Result_unit_DE_Snapshot_ShutPos = Any.any_l ()
  | & s: MutBorrow.t t_S = s
  | & _7: MutBorrow.t t_S = Any.any_l () ])
  [ return (result: tup2_Result_unit_DE_Snapshot_ShutPos) ->
  {[@stop_split] [@expl:verify_dis_shutdown_always_ok ensures] [%#sdrivers'1] result.f0 = Ok () /\ not s.final.p.init}
    (! return {result}) ]
