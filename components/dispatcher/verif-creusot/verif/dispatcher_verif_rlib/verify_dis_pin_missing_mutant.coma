type t_Result_unit_DE = Ok () | Err t_DE

type t_Option_u64 = None'0 | Some'0 UInt64.t

type t_Loc = Mem UInt64.t UInt32.t t_Option_u64 | Blk UInt64.t

type t_Ent = { loc: t_Loc; es: UInt32.t; rr: UInt32.t; wr: UInt32.t }

type t_Option_Ent = None'1 | Some'1 t_Ent

function to_mapping_u64 (self: t_FMap_u64_Ent) : Map.map UInt64.t t_Option_Ent

function get_u64 [@inline:trivial] (self: t_FMap_u64_Ent) (k: UInt64.t) : t_Option_Ent =
  [%#sfmap'1] Map.get (to_mapping_u64 self) k

meta "rewrite_def" function get_u64

predicate contains_u64 [@inline:trivial] (self: t_FMap_u64_Ent) (k: UInt64.t) = [%#sfmap] get_u64 self k <> None'1

meta "rewrite_def" predicate contains_u64

predicate has [#"/home/cornel/repair-j35-rc23/components/dispatcher/verif-creusot/src/core.rs" 344 0 344 32] (w: t_W) (k: UInt64.t) =
  [%#score'0] contains_u64 w.dm k

predicate index_Mapping_Ent_bool [@inline:trivial] (self: Map.map t_Ent bool) (a: t_Ent) = [%#smapping] Map.get self a

meta "rewrite_def" predicate index_Mapping_Ent_bool

function such_that_Ent (p'0: Map.map t_Ent bool) : t_Ent

axiom such_that_Ent_spec:
  forall p'0: Map.map t_Ent bool [such_that_Ent p'0]. ([%#slogic] exists x: t_Ent. index_Mapping_Ent_bool p'0 x)
    -> ([%#slogic'0] index_Mapping_Ent_bool p'0 (such_that_Ent p'0))

function unwrap_Option_Ent (self: t_Option_Ent) : t_Ent = [%#soption'0] match self with
    | Some'1 x -> x
    | None'1 -> such_that_Ent (fun (__0: t_Ent) -> true)
    end

function lookup_u64 [@inline:trivial] (self: t_FMap_u64_Ent) (k: UInt64.t) : t_Ent =
  [%#sfmap'0] unwrap_Option_Ent (get_u64 self k)

meta "rewrite_def" function lookup_u64

function ent [#"/home/cornel/repair-j35-rc23/components/dispatcher/verif-creusot/src/core.rs" 349 0 349 31] (w: t_W) (k: UInt64.t) : t_Ent
 = [%#score'3] lookup_u64 w.dm k

predicate others [#"/home/cornel/repair-j35-rc23/components/dispatcher/verif-creusot/src/core.rs" 592 0 592 41] (a: t_W) (b: t_W) (k: UInt64.t) =
  [%#score'4] forall j: UInt64.t. j <> k -> get_u64 b.dm j = get_u64 a.dm j

predicate ent_rr [#"/home/cornel/repair-j35-rc23/components/dispatcher/verif-creusot/src/core.rs" 610 0 610 49] (a: t_W) (b: t_W) (k: UInt64.t) (d: int) =
  [%#score'1] has a k
  /\ has b k
  /\ (ent b k).loc = (ent a k).loc
  /\ (ent b k).es = (ent a k).es
  /\ (ent b k).wr = (ent a k).wr /\ UInt32.t'int (ent b k).rr = UInt32.t'int (ent a k).rr + d /\ others a b k

predicate only_dm [#"/home/cornel/repair-j35-rc23/components/dispatcher/verif-creusot/src/core.rs" 598 0 598 34] (a: t_W) (b: t_W) =
  [%#score'2] b
  = { dm = b.dm;
      mt = a.mt;
      used = a.used;
      cap = a.cap;
      c = a.c;
      wq = a.wq;
      log = a.log;
      tick = a.tick;
      ob = a.ob;
      ob2 = a.ob2;
      og = a.og;
      os = a.os;
      ov = a.ov;
      ok = a.ok;
      ext = a.ext;
      pool = a.pool;
      cluster = a.cluster;
      threads = a.threads;
      rw = a.rw;
      rw_base = a.rw_base;
      cfree = a.cfree;
      wf = a.wf;
      sdev = a.sdev }

let pin (s: MutBorrow.t t_S) (k: UInt64.t) (return (x: t_Result_unit_DE)) = any
  [ return (result: t_Result_unit_DE) ->
  {[@stop_split] [@expl:pin ensures] ([@stop_split] [@expl:pin ensures #0] [%#smethods] s.final.p = s.current.p)
    /\ ([@stop_split] [@expl:pin ensures #1] [%#smethods'0] not s.current.p.init
      -> result = Err (NotInit (Dispatcher)) /\ s.final.g = s.current.g)
    /\ ([@stop_split] [@expl:pin ensures #2] [%#smethods'1] s.current.p.init /\ s.current.p.has_dm
    -> match result with
      | Ok () -> ent_rr s.current.g s.final.g k 1 /\ only_dm s.current.g s.final.g
      | Err (KeyNotFound j) -> j = k /\ not has s.current.g k /\ s.final.g = s.current.g
      | Err (Timeout) -> has s.current.g k /\ UInt32.t'int (ent s.current.g k).wr > 0 /\ s.final.g = s.current.g
      | Err (Io _) -> s.final.g = s.current.g
      | Err _ -> false
      end)}
    (! return {result}) ]

predicate resolve_refmut_S [@inline:trivial] (_1: MutBorrow.t t_S) = _1.final = _1.current

meta "rewrite_def" predicate resolve_refmut_S

predicate pinv [#"/home/cornel/repair-j35-rc23/components/dispatcher/verif-creusot/src/core.rs" 619 0 619 25] (p'0: t_P) =
  [%#score] (p'0.init -> p'0.has_dm /\ p'0.has_mt /\ p'0.writer) /\ (not p'0.init -> not p'0.ssd_ev /\ not p'0.mt_ev)

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let verify_dis_pin_missing__mutant [#"/home/cornel/repair-j35-rc23/components/dispatcher/verif-creusot/src/drivers.rs" 1622 0 1622 74]
  (s: MutBorrow.t t_S) (k: UInt64.t) (return (x: t_Result_unit_DE)) =
{[@stop_split] [@expl:verify_dis_pin_missing__mutant requires] ([@stop_split] [@expl:verify_dis_pin_missing__mutant requires #0] [%#sdrivers'0] pinv s.current.p
    /\ s.current.p.init)
  /\ ([@stop_split] [@expl:verify_dis_pin_missing__mutant requires #1] [%#sdrivers'1] not has s.current.g k)}
  (! bb0
  [ bb0 = s0
    [ s0 = MutBorrow.borrow_final <t_S> {s.current} {MutBorrow.get_id s}
        (fun (_bor: MutBorrow.t t_S) -> [ &_9 <- _bor ] [ &s <- { s with current = _bor.final } ] s1)
    | s1 = pin [%#sdrivers] {_9} {k} (fun (_x: t_Result_unit_DE) -> [ &_ret <- _x ] s2)
    | s2 = -{resolve_refmut_S s}- s3
    | s3 = return {_ret} ] ]
  [ & _ret: t_Result_unit_DE = Any.any_l ()
  | & s: MutBorrow.t t_S = s
  | & k: UInt64.t = k
  | & _9: MutBorrow.t t_S = Any.any_l () ])
  [ return (result: t_Result_unit_DE) ->
  {[@stop_split] [@expl:verify_dis_pin_missing__mutant ensures] [%#sdrivers'2] result = Ok ()}
    (! return {result}) ]
