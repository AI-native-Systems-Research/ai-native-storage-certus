let dm_create (s: MutBorrow.t t_S) (k: UInt64.t) (ptr: UInt64.t) (size'2: UInt32.t) (return (x: t_Result_unit_DmE)) =
any
  [ return (result: t_Result_unit_DmE) ->
  {[@stop_split] [@expl:dm_create ensures] ([@stop_split] [@expl:dm_create ensures #0] [%#sboundary'1] s.final.p
      = s.current.p)
    /\ ([@stop_split] [@expl:dm_create ensures #1] [%#sboundary'2] match result with
      | Ok'0 () -> UInt32.t'int size'2 > 0
      /\ not has s.current.g k
      /\ o1 s.current.g
      /\ s.final.g
      = lg (nx { dm = insert_u64 s.current.g.dm k { loc = Mem ptr size'2 (None'2);
                                                    es = size'2;
                                                    rr = (0: UInt32.t);
                                                    wr = (1: UInt32.t) };
                 mt = s.current.g.mt;
                 used = s.current.g.used;
                 cap = s.current.g.cap;
                 c = s.current.g.c;
                 wq = s.current.g.wq;
                 log = s.current.g.log;
                 tick = s.current.g.tick;
                 ob = s.current.g.ob;
                 ob2 = s.current.g.ob2;
                 og = s.current.g.og;
                 os = s.current.g.os;
                 ov = s.current.g.ov;
                 ok = s.current.g.ok;
                 ext = s.current.g.ext;
                 pool = s.current.g.pool;
                 cluster = s.current.g.cluster;
                 threads = s.current.g.threads;
                 rw = s.current.g.rw;
                 cfree = s.current.g.cfree;
                 wf = s.current.g.wf;
                 sdev = s.current.g.sdev }) (DmCreate k)
      | Err'0 (InvalidSize'1) -> UInt32.t'int size'2 = 0 /\ s.final.g = nx s.current.g
      | Err'0 (AlreadyExists'1) -> UInt32.t'int size'2 > 0 /\ has s.current.g k /\ s.final.g = nx s.current.g
      | Err'0 (Other'1) -> UInt32.t'int size'2 > 0
