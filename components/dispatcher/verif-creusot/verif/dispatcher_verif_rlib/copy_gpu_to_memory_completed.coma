      /\ (forall j: UInt64.t. j <> key'1 -> get_u64 s.final.g.mt j = get_u64 s.current.g.mt j))
    /\ ([@stop_split] [@expl:copy_gpu_to_memory_completed ensures #4] [%#sstore'15] s.current.p.init
    -> match result with
      | Err (KeyNotFound k) -> k = key'1 /\ not mt_has s.current.g key'1 /\ s.final.g = s.current.g
      | Err (AlreadyExists k) -> k = key'1
      /\ mt_has s.current.g key'1
      /\ has s.current.g key'1
      /\ not mt_has s.final.g key'1 /\ s.final.g.dm = s.current.g.dm /\ s.final.g.wq = s.current.g.wq
      | Err (Io (Dm'0)) -> mt_has s.current.g key'1
      /\ (not has s.current.g key'1 \/ UInt32.t'int size'2 = 0)
      /\ not mt_has s.final.g key'1 /\ s.final.g.dm = s.current.g.dm /\ s.final.g.wq = s.current.g.wq
      | Ok () -> mt_has s.current.g key'1
      /\ not has s.current.g key'1
      /\ s.final.g.mt = s.current.g.mt
      /\ get_u64'0 s.final.g.dm key'1
        = Some'3 { loc = Mem ((lookup_u64 s.current.g.mt key'1).ptr'1) size'2 (None'2);
                   es = size'2;
                   rr = (1: UInt32.t);
                   wr = (0: UInt32.t) }
      /\ s.final.g.wq = Seq.snoc s.current.g.wq (wjob s.current.p key'1 size'2)
      /\ Seq.get s.final.g.log (Seq.length s.final.g.log - 1) = Enq (wjob s.current.p key'1 size'2)
      | Err _ -> false
      end)}
    (! return {result}) ]
