function n_evictable [#"/home/cornel/repair-j33-rc29/components/dispatcher/verif-creusot/src/misc.rs" 320 0 320 53] (w: t_W) (ks: Seq.seq UInt64.t) (i: int) : int

axiom n_evictable_def: forall w: t_W, ks: Seq.seq UInt64.t, i: int [n_evictable w ks i]. n_evictable w ks i
    = ([%#smisc'29] if i <= 0 then
      0
    else
      n_evictable w ks (i - 1) + (if evictable w (Seq.get ks (i - 1)) then 1 else 0)
    )

function n_evictable_le [#"/home/cornel/repair-j33-rc29/components/dispatcher/verif-creusot/src/misc.rs" 328 0 328 49] (w: t_W) (ks: Seq.seq UInt64.t) (i: int) : ()

axiom n_evictable_le_def: forall w: t_W, ks: Seq.seq UInt64.t, i: int [n_evictable_le w ks i]. ([%#smisc'25] 0 <= i)
    -> n_evictable_le w ks i = ([%#smisc'27] if i <= 0 then () else n_evictable_le w ks (i - 1))

axiom n_evictable_le_spec: forall w: t_W, ks: Seq.seq UInt64.t, i: int. ([%#smisc'25] 0 <= i)
    -> ([%#smisc'26] 0 <= n_evictable w ks i /\ n_evictable w ks i <= i)

predicate in_bounds_usize [@inline:trivial] (self: UInt64.t) (seq: Seq.seq UInt64.t) =
  [%#sslice] UInt64.t'int self < Seq.length seq

