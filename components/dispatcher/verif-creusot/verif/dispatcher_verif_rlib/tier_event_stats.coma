let tier_event_stats [#"/home/cornel/repair-j33-rc29/components/dispatcher/verif-creusot/src/misc.rs" 338 0 338 53]
  (s: MutBorrow.t t_S) (return (x: t_Stats)) = (! bb0
  [ bb0 = s0
    [ s0 = [ &g0 <- [%#smisc] s.current.g ] s1
    | s1 = [ &sampled <- [%#smisc'0] (0: UInt64.t) ] s2
    | s2 = [ &persisted'0 <- [%#smisc'1] (0: UInt64.t) ] s3
    | s3 = any [ br0 -> {s.current.p.has_dm = false} (! bb19) | br1 -> {s.current.p.has_dm} (! bb2) ] ]
