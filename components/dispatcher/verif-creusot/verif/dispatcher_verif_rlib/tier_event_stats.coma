let index_Vec_u64_Global (self_: t_Vec_u64_Global) (ix: UInt64.t) (return (x: UInt64.t)) =
{[@stop_split] [@expl:index requires] [%#svec'1] in_bounds_usize ix (view_Vec_u64_Global self_)}
  any
  [ return (result: UInt64.t) ->
  {[@stop_split] [@expl:index ensures] [%#svec'2] has_value_usize ix (view_Vec_u64_Global self_) result}
    (! return {result}) ]

let dm_is_evictable (s: MutBorrow.t t_S) (k: UInt64.t) (return (x: bool)) = any
  [ return (result: bool) ->
  {[@stop_split] [@expl:dm_is_evictable ensures] ([@stop_split] [@expl:dm_is_evictable ensures #0] [%#sboundary'3] s.final.p
        = s.current.p
      /\ s.final.g = s.current.g)
    /\ ([@stop_split] [@expl:dm_is_evictable ensures #1] [%#sboundary'4] result
    = (has s.current.g k
    /\ UInt32.t'int (ent s.current.g k).rr = 0
    /\ UInt32.t'int (ent s.current.g k).wr = 0 /\ persisted (ent s.current.g k).loc))}
    (! return {result}) ]

