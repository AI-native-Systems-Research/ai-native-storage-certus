  {[@stop_split] [@expl:evict_and_insert ensures] ([@stop_split] [@expl:evict_and_insert ensures #0] [%#sevict] s.final.p
      = s.current.p)
    /\ ([@stop_split] [@expl:evict_and_insert ensures #1] [%#sevict'0] match result with
        | Ok ptr -> eai_frame s.current.g s.final.g key'1 ptr size'3
        | Err (Alloc) -> evict_frame s.current.g s.final.g
