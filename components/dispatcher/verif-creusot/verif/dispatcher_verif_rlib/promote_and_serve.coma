        /\ s.current.g.used + UInt32.t'int size'3 <= s.current.g.cap /\ not mt_has s.current.g key'1
      -> match result with
        | Ok _ -> s.final.g.dm = s.current.g.dm
        | _ -> false
        end)
    /\ ([@stop_split] [@expl:evict_and_insert ensures #4] [%#sevict'3] UInt64.t'int max_attempts = 0
        /\ s.current.g.used + UInt32.t'int size'3 > s.current.g.cap -> result = Err (Alloc) /\ s.final.g = s.current.g)
    /\ ([@stop_split] [@expl:evict_and_insert ensures #5] [%#sevict'4] match result with
      | Err (AlreadyExists _) -> s.final.g.c.already = s.current.g.c.already + 1
      | _ -> s.final.g.c.already = s.current.g.c.already
      end)}
    (! return {result}) ]

