  /\ a.r_miss = b.r_miss
  /\ a.bp = b.bp
  /\ a.drop_full = b.drop_full
  /\ a.promo_mem <= b.promo_mem
  /\ a.promo_gpu <= b.promo_gpu
  /\ a.already <= b.already
