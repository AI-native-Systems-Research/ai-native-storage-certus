      -> match result.f1.path'0 with
        | Early'0 -> false
        | Miss'0 -> not has s.current.g key'1
        /\ result.f0 = Err (KeyNotFound key'1)
        /\ s.final.g
        = { dm = s.current.g.dm;
            mt = s.current.g.mt;
            used = s.current.g.used;
            cap = s.current.g.cap;
            c = s.current.g.c;
            wq = s.current.g.wq;
            log = s.current.g.log;
            tick = s.final.g.tick;
            ob = s.current.g.ob;
            ob2 = s.current.g.ob2;
            og = s.current.g.og;
            os = s.current.g.os;
            ov = s.current.g.ov;
            ok = s.current.g.ok;
            ext = s.current.g.ext;
            pool = s.current.g.pool;
            cluster = s.current.g.cluster;
            threads = s.current.g.threads;
            rw = s.current.g.rw;
            rw_base = s.current.g.rw_base;
            cfree = s.current.g.cfree;
            wf = s.current.g.wf }
        | Timeout'0 -> has s.current.g key'1
        /\ (UInt32.t'int (ent s.current.g key'1).wr > 0
          \/ UInt32.t'int (ent s.current.g key'1).rr = UInt32.t'int const_MAX)
        /\ result.f0 = Err (KeyNotFound key'1)
        /\ s.final.g
        = { dm = s.current.g.dm;
            mt = s.current.g.mt;
            used = s.current.g.used;
            cap = s.current.g.cap;
            c = s.current.g.c;
            wq = s.current.g.wq;
            log = s.current.g.log;
            tick = s.final.g.tick;
            ob = s.current.g.ob;
            ob2 = s.current.g.ob2;
            og = s.current.g.og;
            os = s.current.g.os;
            ov = s.current.g.ov;
            ok = s.current.g.ok;
            ext = s.current.g.ext;
            pool = s.current.g.pool;
            cluster = s.current.g.cluster;
            threads = s.current.g.threads;
            rw = s.current.g.rw;
            rw_base = s.current.g.rw_base;
            cfree = s.current.g.cfree;
            wf = s.current.g.wf }
        | Warm'0 -> has s.current.g key'1
        /\ is_mem (ent s.current.g key'1).loc
        /\ UInt32.t'int (ent s.current.g key'1).wr = 0
        /\ UInt32.t'int (ent s.current.g key'1).rr < UInt32.t'int const_MAX
        /\ match (ent s.current.g key'1).loc with
            | Mem ptr'0 size'3 _ -> scattered s.final.g result.f1.sv'0.base (Seq.singleton h) result.f1.sv'0.m ptr'0 size'3 result.f1.warm'0
            /\ h2d_within s.current.g s.final.g ptr'0 size'3
            /\ (min_int (UInt32.t'int h.size'2) (UInt32.t'int size'3) > 0 /\ result.f0 = Ok (0: UInt64.t)
              -> result.f1.sv'0.m = 1)
            /\ (result.f1.sv'0.m = 1
            -> h2d_logged s.current.g s.final.g ptr'0 h.addr'2 (min_int (UInt32.t'int h.size'2) (UInt32.t'int size'3)))
            | _ -> false
            end
