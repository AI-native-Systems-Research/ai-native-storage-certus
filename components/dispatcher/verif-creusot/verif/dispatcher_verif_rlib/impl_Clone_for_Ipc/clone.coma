use creusot.int.UInt64
use creusot.int.UInt32
use creusot.prelude.Any

type t_Ipc = { addr: UInt64.t; size: UInt32.t }

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let clone_Ipc [#"/home/cornel/repair-j33-rc29/components/dispatcher/verif-creusot/src/core.rs" 129 9 129 29]
  (self: t_Ipc) (return (x: t_Ipc)) = (! bb0
  [ bb0 = s0 [ s0 = [ &_ret <- self ] s1 | s1 = return {_ret} ] ]
  [ & _ret: t_Ipc = Any.any_l () | & self: t_Ipc = self ]) [ return (result: t_Ipc) -> (! return {result}) ]
