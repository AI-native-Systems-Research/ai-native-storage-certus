predicate log_ext [#"/home/cornel/repair-j35-rc23/components/dispatcher/verif-creusot/src/core.rs" 435 0 435 34] (a: t_W) (b: t_W) =
  [%#score'3] Seq.length a.log <= Seq.length b.log
  /\ (forall i: int. 0 <= i /\ i < Seq.length a.log -> Seq.get b.log i = Seq.get a.log i)

let get_evictable_offset (s: MutBorrow.t t_S) (k: UInt64.t) (return (x: t_Option_u64)) = any
  [ return (result: t_Option_u64) ->
  {[@stop_split] [@expl:get_evictable_offset ensures] ([@stop_split] [@expl:get_evictable_offset ensures #0] [%#sbg'28] s.final.p
        = s.current.p
      /\ s.final.g
        = { dm = s.final.g.dm;
            mt = s.current.g.mt;
            used = s.current.g.used;
            cap = s.current.g.cap;
            c = s.current.g.c;
            wq = s.current.g.wq;
            log = s.final.g.log;
            tick = s.current.g.tick;
            ob = s.current.g.ob;
            ob2 = s.current.g.ob2;
            og = s.current.g.og;
            os = s.current.g.os;
            ov = s.current.g.ov;
            ok = s.current.g.ok;
            ext = s.current.g.ext;
            pool = s.current.g.pool;
            cluster = s.current.g.cluster;
            threads = s.current.g.threads;
            rw = s.current.g.rw;
            rw_base = s.current.g.rw_base;
            cfree = s.current.g.cfree;
            wf = s.current.g.wf;
            sdev = s.current.g.sdev }
      /\ log_ext s.current.g s.final.g)
    /\ ([@stop_split] [@expl:get_evictable_offset ensures #1] [%#sbg'29] forall j: UInt64.t. get_u64 s.final.g.dm j
        = get_u64 s.current.g.dm j)
    /\ ([@stop_split] [@expl:get_evictable_offset ensures #2] [%#sbg'30] match result with
