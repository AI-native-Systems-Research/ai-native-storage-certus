type t_S = { p: t_P; g: t_W }

type t_Lr = NotExist | Mismatch | Blk UInt64.t | Mem UInt64.t UInt32.t

type t_DmE =
  | KeyNotFound
  | AlreadyExists
  | ActiveRefs
  | Timeout
  | InvalidSize
  | Underflow
  | Overflow
  | NoWrite
  | InvalidState
  | Other

type t_Result_Lr_DmE = Ok t_Lr | Err t_DmE

function nx [#"/home/cornel/repair-j33-rc26/components/dispatcher/verif-creusot/src/core.rs" 290 0 290 20] (w: t_W) : t_W
 = [%#score'2] { dm = w.dm;
                 mt = w.mt;
                 used = w.used;
                 cap = w.cap;
                 c = w.c;
                 wq = w.wq;
                 log = w.log;
                 tick = w.tick + 1;
                 ob = w.ob;
                 ob2 = w.ob2;
                 og = w.og;
                 os = w.os;
                 ov = w.ov;
                 ok = w.ok;
                 ext = w.ext;
                 pool = w.pool;
                 cluster = w.cluster;
                 threads = w.threads;
                 rw = w.rw;
                 cfree = w.cfree;
                 wf = w.wf }

let dm_lookup_racing (s: MutBorrow.t t_S) (k: UInt64.t) (return (x: t_Result_Lr_DmE)) = any
  [ return (result: t_Result_Lr_DmE) -> {[@stop_split] [@expl:dm_lookup_racing ensures] [%#sboundary] s.final.p
      = s.current.p
    /\ s.final.g = nx s.current.g}
    (! return {result}) ]

predicate log_ext [#"/home/cornel/repair-j33-rc26/components/dispatcher/verif-creusot/src/core.rs" 422 0 422 34] (a: t_W) (b: t_W) =
  [%#score] Seq.length a.log <= Seq.length b.log
  /\ (forall i: int. 0 <= i /\ i < Seq.length a.log -> Seq.get b.log i = Seq.get a.log i)

predicate same_env [#"/home/cornel/repair-j33-rc26/components/dispatcher/verif-creusot/src/core.rs" 673 0 673 35] (a: t_W) (b: t_W) =
  [%#score'0] b.pool = a.pool
  /\ b.cluster = a.cluster
  /\ b.cap = a.cap
  /\ b.ext = a.ext
  /\ b.rw = a.rw
  /\ b.ob = a.ob
  /\ b.ob2 = a.ob2
  /\ b.og = a.og /\ b.os = a.os /\ b.ov = a.ov /\ b.ok = a.ok /\ b.threads = a.threads /\ b.cfree = a.cfree

predicate same_ctr [#"/home/cornel/repair-j33-rc26/components/dispatcher/verif-creusot/src/core.rs" 402 0 402 39] (a: t_Ctr) (b: t_Ctr) =
  [%#score'1] a.promo_mem = b.promo_mem
  /\ a.promo_gpu = b.promo_gpu
  /\ a.ev_mem = b.ev_mem
  /\ a.ev_ssd = b.ev_ssd
  /\ a.hit_dram = b.hit_dram
  /\ a.hit_ssd = b.hit_ssd
  /\ a.r_hit = b.r_hit
  /\ a.r_miss = b.r_miss
  /\ a.bp = b.bp
  /\ a.drop_full = b.drop_full
  /\ a.already = b.already /\ a.blk_pin = b.blk_pin /\ a.exhausted = b.exhausted /\ a.blk_unp = b.blk_unp

let elim_Ok (_x: t_Result_Lr_DmE) (return (f0: t_Lr)) = any
  [ _k (f0: t_Lr) -> {Ok f0 = _x} (! return {f0})
  | _chk -> (! {[@expl:elim Ok] match _x with
      | Ok _ -> true
      | _ -> false
      end}
    any) ]

type t_Result_unit_DmE = Ok'0 () | Err'0 t_DmE

type t_Option_u64 = None'0 | Some'0 UInt64.t

type t_Loc = Mem'0 UInt64.t UInt32.t t_Option_u64 | Blk'0 UInt64.t

type t_Ent = { loc: t_Loc; es: UInt32.t; rr: UInt32.t; wr: UInt32.t }

type t_Option_Ent = None'1 | Some'1 t_Ent

function to_mapping_u64 (self: t_FMap_u64_Ent) : Map.map UInt64.t t_Option_Ent

function get_u64 [@inline:trivial] (self: t_FMap_u64_Ent) (k: UInt64.t) : t_Option_Ent =
  [%#sfmap'1] Map.get (to_mapping_u64 self) k

meta "rewrite_def" function get_u64

predicate contains_u64 [@inline:trivial] (self: t_FMap_u64_Ent) (k: UInt64.t) = [%#sfmap] get_u64 self k <> None'1

meta "rewrite_def" predicate contains_u64

predicate has [#"/home/cornel/repair-j33-rc26/components/dispatcher/verif-creusot/src/core.rs" 331 0 331 32] (w: t_W) (k: UInt64.t) =
  [%#score'3] contains_u64 w.dm k

predicate index_Mapping_Ent_bool [@inline:trivial] (self: Map.map t_Ent bool) (a: t_Ent) = [%#smapping] Map.get self a

meta "rewrite_def" predicate index_Mapping_Ent_bool

function such_that_Ent (p'0: Map.map t_Ent bool) : t_Ent

axiom such_that_Ent_spec:
  forall p'0: Map.map t_Ent bool [such_that_Ent p'0]. ([%#slogic] exists x: t_Ent. index_Mapping_Ent_bool p'0 x)
    -> ([%#slogic'0] index_Mapping_Ent_bool p'0 (such_that_Ent p'0))

function unwrap_Option_Ent (self: t_Option_Ent) : t_Ent = [%#soption'0] match self with
    | Some'1 x -> x
    | None'1 -> such_that_Ent (fun (__0: t_Ent) -> true)
    end

function lookup_u64 [@inline:trivial] (self: t_FMap_u64_Ent) (k: UInt64.t) : t_Ent =
  [%#sfmap'0] unwrap_Option_Ent (get_u64 self k)

meta "rewrite_def" function lookup_u64

function ent [#"/home/cornel/repair-j33-rc26/components/dispatcher/verif-creusot/src/core.rs" 336 0 336 31] (w: t_W) (k: UInt64.t) : t_Ent
 = [%#score'4] lookup_u64 w.dm k

predicate others [#"/home/cornel/repair-j33-rc26/components/dispatcher/verif-creusot/src/core.rs" 579 0 579 41] (a: t_W) (b: t_W) (k: UInt64.t) =
  [%#score'13] forall j: UInt64.t. j <> k -> get_u64 b.dm j = get_u64 a.dm j

predicate ent_rr [#"/home/cornel/repair-j33-rc26/components/dispatcher/verif-creusot/src/core.rs" 597 0 597 49] (a: t_W) (b: t_W) (k: UInt64.t) (d: int) =
  [%#score'5] has a k
  /\ has b k
  /\ (ent b k).loc = (ent a k).loc
  /\ (ent b k).es = (ent a k).es
  /\ (ent b k).wr = (ent a k).wr /\ UInt32.t'int (ent b k).rr = UInt32.t'int (ent a k).rr + d /\ others a b k

predicate only_dm_log [#"/home/cornel/repair-j33-rc26/components/dispatcher/verif-creusot/src/core.rs" 591 0 591 45] (a: t_W) (b: t_W) (e: t_Ev) =
  [%#score'6] b
  = { dm = b.dm;
      mt = a.mt;
      used = a.used;
      cap = a.cap;
      c = a.c;
      wq = a.wq;
      log = Seq.snoc a.log e;
      tick = a.tick;
      ob = a.ob;
      ob2 = a.ob2;
      og = a.og;
      os = a.os;
      ov = a.ov;
      ok = a.ok;
      ext = a.ext;
      pool = a.pool;
      cluster = a.cluster;
      threads = a.threads;
      rw = a.rw;
      cfree = a.cfree;
      wf = a.wf }

function lg [#"/home/cornel/repair-j33-rc26/components/dispatcher/verif-creusot/src/core.rs" 300 0 300 27] (w: t_W) (e: t_Ev) : t_W
 = [%#score'7] { dm = w.dm;
                 mt = w.mt;
                 used = w.used;
                 cap = w.cap;
                 c = w.c;
                 wq = w.wq;
                 log = Seq.snoc w.log e;
                 tick = w.tick;
                 ob = w.ob;
                 ob2 = w.ob2;
                 og = w.og;
                 os = w.os;
                 ov = w.ov;
                 ok = w.ok;
                 ext = w.ext;
                 pool = w.pool;
                 cluster = w.cluster;
                 threads = w.threads;
                 rw = w.rw;
                 cfree = w.cfree;
                 wf = w.wf }

let dm_release_read (s: MutBorrow.t t_S) (k: UInt64.t) (own: int) (return (x: t_Result_unit_DmE)) = any
  [ return (result: t_Result_unit_DmE) ->
  {[@stop_split] [@expl:dm_release_read ensures] ([@stop_split] [@expl:dm_release_read ensures #0] [%#sboundary'0] s.final.p
      = s.current.p)
    /\ ([@stop_split] [@expl:dm_release_read ensures #1] [%#sboundary'1] match result with
      | Ok'0 () -> has s.current.g k
      /\ UInt32.t'int (ent s.current.g k).rr > 0
      /\ ent_rr s.current.g s.final.g k (- 1) /\ only_dm_log s.current.g s.final.g (RelRead k own)
      | Err'0 (KeyNotFound) -> not has s.current.g k /\ s.final.g = lg s.current.g (RelRead k own)
      | Err'0 (Underflow) -> has s.current.g k
      /\ UInt32.t'int (ent s.current.g k).rr = 0 /\ s.final.g = lg s.current.g (RelRead k own)
      | Err'0 _ -> false
      end)}
