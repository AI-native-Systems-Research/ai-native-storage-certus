      /\ UInt32.t'int (ent s.current.g k).rr = 0
      /\ UInt32.t'int (ent s.current.g k).wr = 0
      /\ persisted (ent s.current.g k).loc
      /\ s.final.g
      = lg { dm = insert_u64 s.current.g.dm k { loc = demoted_loc (ent s.current.g k).loc;
                                                es = (ent s.current.g k).es;
                                                rr = (ent s.current.g k).rr;
                                                wr = (ent s.current.g k).wr };
             mt = s.current.g.mt;
             used = s.current.g.used;
             cap = s.current.g.cap;
             c = s.current.g.c;
             wq = s.current.g.wq;
             log = s.current.g.log;
             tick = s.current.g.tick;
             ob = s.current.g.ob;
             ob2 = s.current.g.ob2;
             og = s.current.g.og;
             os = s.current.g.os;
             ov = s.current.g.ov;
             ok = s.current.g.ok;
             ext = s.current.g.ext;
             pool = s.current.g.pool;
             cluster = s.current.g.cluster;
             threads = s.current.g.threads;
             rw = s.current.g.rw;
             cfree = s.current.g.cfree;
             wf = s.current.g.wf;
             sdev = s.current.g.sdev } (DmDemote k)
      | Err (KeyNotFound) -> not has s.current.g k /\ s.final.g = s.current.g
      | Err (ActiveRefs) -> has s.current.g k
      /\ (UInt32.t'int (ent s.current.g k).rr > 0 \/ UInt32.t'int (ent s.current.g k).wr > 0) /\ s.final.g = s.current.g
