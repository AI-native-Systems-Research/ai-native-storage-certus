  | Dm'0
  | Remote'0
  | Stream'0
  | Channel'0
  | Other'0

type t_DE = NotInit t_Ni | InvalidParam | KeyNotFound UInt64.t | AlreadyExists UInt64.t | Alloc | Io t_IoK | Timeout

type t_Result_unit_DE = Ok () | Err t_DE

