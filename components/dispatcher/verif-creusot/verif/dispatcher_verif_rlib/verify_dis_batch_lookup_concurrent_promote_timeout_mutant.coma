  {[@stop_split] [@expl:serve_concurrently_promoted ensures] ([@stop_split] [@expl:serve_concurrently_promoted ensures #0] [%#sbatch] s.final.p
      = s.current.p)
    /\ ([@stop_split] [@expl:serve_concurrently_promoted ensures #1] [%#sbatch'0] match result.f0 with
        | Err (AlreadyExists _) -> false
        | _ -> true
        end)
    /\ ([@stop_split] [@expl:serve_concurrently_promoted ensures #2] [%#sbatch'1] result.f0 = Ok () -> result.f1)
    /\ ([@stop_split] [@expl:serve_concurrently_promoted ensures #3] [%#sbatch'2] match result.f0 with
