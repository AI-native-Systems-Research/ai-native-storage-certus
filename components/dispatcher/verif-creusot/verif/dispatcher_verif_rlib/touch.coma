type t_Result_unit_DE = Ok () | Err t_DE

let ensure_initialized (s: t_S) (return (x: t_Result_unit_DE)) = any
  [ return (result: t_Result_unit_DE) ->
  {[@stop_split] [@expl:ensure_initialized ensures] [%#smethods'6] match result with
      | Ok () -> s.p.init
      | Err e -> not s.p.init /\ e = NotInit (Dispatcher)
      end}
    (! return {result}) ]

predicate resolve_refmut_S [@inline:trivial] (_1: MutBorrow.t t_S) = _1.final = _1.current

meta "rewrite_def" predicate resolve_refmut_S

let elim_Err (_x: t_Result_unit_DE) (return (f0: t_DE)) = any
  [ _k (f0: t_DE) -> {Err f0 = _x} (! return {f0})
  | _chk -> (! {[@expl:elim Err] match _x with
      | Err _ -> true
      | _ -> false
      end}
    any) ]

type t_DmE =
  | KeyNotFound'1
  | AlreadyExists'1
  | ActiveRefs'1
  | Timeout'1
  | InvalidSize'1
  | Underflow'1
  | Overflow'1
  | NoWrite'1
  | InvalidState'1
  | Other'1

type t_Result_unit_DmE = Ok'0 () | Err'0 t_DmE

type t_Option_u64 = None'0 | Some'0 UInt64.t

type t_Loc = Mem UInt64.t UInt32.t t_Option_u64 | Blk UInt64.t

type t_Ent = { loc: t_Loc; es: UInt32.t; rr: UInt32.t; wr: UInt32.t }

type t_Option_Ent = None'1 | Some'1 t_Ent

function to_mapping_u64 (self: t_FMap_u64_Ent) : Map.map UInt64.t t_Option_Ent

function get_u64 [@inline:trivial] (self: t_FMap_u64_Ent) (k: UInt64.t) : t_Option_Ent =
  [%#sfmap'0] Map.get (to_mapping_u64 self) k

meta "rewrite_def" function get_u64

predicate contains_u64 [@inline:trivial] (self: t_FMap_u64_Ent) (k: UInt64.t) = [%#sfmap] get_u64 self k <> None'1

meta "rewrite_def" predicate contains_u64

predicate has [#"/home/cornel/repair-j33-rc24/components/dispatcher/verif-creusot/src/core.rs" 335 0 335 32] (w: t_W) (k: UInt64.t) =
  [%#score] contains_u64 w.dm k

function lg [#"/home/cornel/repair-j33-rc24/components/dispatcher/verif-creusot/src/core.rs" 304 0 304 27] (w: t_W) (e: t_Ev) : t_W
 = [%#score'2] { dm = w.dm;
                 mt = w.mt;
                 used = w.used;
                 cap = w.cap;
                 c = w.c;
                 wq = w.wq;
                 log = Seq.snoc w.log e;
                 tick = w.tick;
                 ob = w.ob;
                 ob2 = w.ob2;
                 og = w.og;
                 os = w.os;
                 ov = w.ov;
                 ok = w.ok;
                 ext = w.ext;
                 pool = w.pool;
                 cluster = w.cluster;
                 threads = w.threads;
                 rw = w.rw;
                 cfree = w.cfree;
                 wf = w.wf;
                 sdev = w.sdev }

let dm_touch (s: MutBorrow.t t_S) (k: UInt64.t) (return (x: t_Result_unit_DmE)) = any
  [ return (result: t_Result_unit_DmE) ->
  {[@stop_split] [@expl:dm_touch ensures] ([@stop_split] [@expl:dm_touch ensures #0] [%#sboundary] s.final.p
      = s.current.p)
    /\ ([@stop_split] [@expl:dm_touch ensures #1] [%#sboundary'0] match result with
      | Ok'0 () -> has s.current.g k /\ s.final.g = lg s.current.g (DmTouch k)
      | Err'0 (KeyNotFound'1) -> not has s.current.g k /\ s.final.g = s.current.g
      | Err'0 _ -> false
      end)}
    (! return {result}) ]

let mt_touch (s: MutBorrow.t t_S) (k: UInt64.t) (return (x: ())) = any
  [ return (result: ()) -> {[@stop_split] [@expl:mt_touch ensures] [%#sboundary'1] s.final.p = s.current.p
    /\ s.final.g = lg s.current.g (MtTouch k)}
    (! return {result}) ]

predicate log_ext [#"/home/cornel/repair-j33-rc24/components/dispatcher/verif-creusot/src/core.rs" 426 0 426 34] (a: t_W) (b: t_W) =
  [%#score'0] Seq.length a.log <= Seq.length b.log
  /\ (forall i: int. 0 <= i /\ i < Seq.length a.log -> Seq.get b.log i = Seq.get a.log i)

predicate no_dma [#"/home/cornel/repair-j33-rc24/components/dispatcher/verif-creusot/src/core.rs" 432 0 432 33] (a: t_W) (b: t_W) =
  [%#score'1] forall i: int. Seq.length a.log <= i /\ i < Seq.length b.log
    -> match Seq.get b.log i with
      | H2D _ _ _ _ -> false
      | D2H _ _ _ _ -> false
      | _ -> true
      end

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

