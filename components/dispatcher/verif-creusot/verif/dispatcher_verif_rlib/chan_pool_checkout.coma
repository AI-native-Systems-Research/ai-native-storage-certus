let connect_client (s: MutBorrow.t t_S) (free: t_Vec_u64_Global) (return (x: t_Option_u64)) = any
  [ return (result: t_Option_u64) ->
  {[@stop_split] [@expl:connect_client ensures] ([@stop_split] [@expl:connect_client ensures #0] [%#sboundary] s.final.p
        = s.current.p
      /\ s.final.g = nx s.current.g)
    /\ ([@stop_split] [@expl:connect_client ensures #1] [%#sboundary'0] match result with
      | Some c'0 -> o1 s.current.g
      /\ (forall i: int. 0 <= i /\ i < Seq.length (view_Vec_u64_Global free)
        -> Seq.get (view_Vec_u64_Global free) i <> c'0)
      | None -> not o1 s.current.g
      end)}
    (! return {result}) ]

