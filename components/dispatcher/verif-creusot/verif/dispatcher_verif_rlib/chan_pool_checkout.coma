               mt = w.mt;
               used = w.used;
               cap = w.cap;
               c = w.c;
               wq = w.wq;
               log = w.log;
               tick = w.tick + 1;
               ob = w.ob;
               ob2 = w.ob2;
               og = w.og;
               os = w.os;
               ov = w.ov;
               ok = w.ok;
               ext = w.ext;
               pool = w.pool;
               cluster = w.cluster;
               threads = w.threads;
               rw = w.rw;
               cfree = w.cfree;
               wf = w.wf }

