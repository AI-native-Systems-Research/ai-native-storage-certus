let pop_u64 (self_: MutBorrow.t t_Vec_u64_Global) (return (x: t_Option_u64)) = any
  [ return (result: t_Option_u64) -> {[@stop_split] [@expl:pop ensures] [%#svec] match result with
      | Some t -> view_Vec_u64_Global self_.final
        = Seq.([..]) (view_Vec_u64_Global self_.current) 0 (Seq.length (view_Vec_u64_Global self_.current) - 1)
      /\ view_Vec_u64_Global self_.current = Seq.snoc (view_Vec_u64_Global self_.final) t
      | None -> self_.current = self_.final /\ Seq.length (view_Vec_u64_Global self_.current) = 0
      end}
    (! return {result}) ]

