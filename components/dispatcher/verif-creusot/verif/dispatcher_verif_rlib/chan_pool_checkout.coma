let chan_try_recv (s: MutBorrow.t t_S) (ch: UInt64.t) (return (x: bool)) = any
  [ return (result: bool) ->
  {[@stop_split] [@expl:chan_try_recv ensures] ([@stop_split] [@expl:chan_try_recv ensures #0] [%#sboundary'1] s.final.p
        = s.current.p
      /\ result = (index_Mapping_Int_Int s.current.g.cfree (UInt64.t'int ch + 1000000) > 0))
    /\ ([@stop_split] [@expl:chan_try_recv ensures #1] [%#sboundary'2] result
      -> s.final.g
      = { dm = s.current.g.dm;
          mt = s.current.g.mt;
          used = s.current.g.used;
          cap = s.current.g.cap;
          c = s.current.g.c;
          wq = s.current.g.wq;
          log = s.current.g.log;
          tick = s.current.g.tick;
          ob = s.current.g.ob;
          ob2 = s.current.g.ob2;
          og = s.current.g.og;
          os = s.current.g.os;
          ov = s.current.g.ov;
          ok = s.current.g.ok;
          ext = s.current.g.ext;
          pool = s.current.g.pool;
          cluster = s.current.g.cluster;
          threads = s.current.g.threads;
          rw = s.current.g.rw;
          cfree = Map.set s.current.g.cfree (UInt64.t'int ch
          + 1000000) (index_Mapping_Int_Int s.current.g.cfree (UInt64.t'int ch + 1000000) - 1);
          wf = s.current.g.wf })
    /\ ([@stop_split] [@expl:chan_try_recv ensures #2] [%#sboundary'3] not result -> s.final.g = s.current.g)}
    (! return {result}) ]

