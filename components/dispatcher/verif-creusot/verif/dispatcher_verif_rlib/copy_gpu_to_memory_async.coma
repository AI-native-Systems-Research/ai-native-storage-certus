function to_mapping_u64 (self: t_FMap_u64_Slot) : Map.map UInt64.t t_Option_Slot

function get_u64 [@inline:trivial] (self: t_FMap_u64_Slot) (k: UInt64.t) : t_Option_Slot =
  [%#sfmap] Map.get (to_mapping_u64 self) k

meta "rewrite_def" function get_u64

predicate contains_u64 [@inline:trivial] (self: t_FMap_u64_Slot) (k: UInt64.t) = [%#sfmap'3] get_u64 self k <> None'1

meta "rewrite_def" predicate contains_u64

predicate mt_has [#"/home/cornel/repair-j33-rc22/components/dispatcher/verif-creusot/src/core.rs" 382 0 382 35] (w: t_W) (k: UInt64.t) =
  [%#score'19] contains_u64 w.mt k

predicate index_Mapping_Slot_bool [@inline:trivial] (self: Map.map t_Slot bool) (a: t_Slot) =
  [%#smapping] Map.get self a

meta "rewrite_def" predicate index_Mapping_Slot_bool

function such_that_Slot (p'0: Map.map t_Slot bool) : t_Slot

axiom such_that_Slot_spec:
  forall p'0: Map.map t_Slot bool [such_that_Slot p'0]. ([%#slogic] exists x: t_Slot. index_Mapping_Slot_bool p'0 x)
    -> ([%#slogic'0] index_Mapping_Slot_bool p'0 (such_that_Slot p'0))

function unwrap_Option_Slot (self: t_Option_Slot) : t_Slot = [%#soption'0] match self with
    | Some'1 x -> x
    | None'1 -> such_that_Slot (fun (__0: t_Slot) -> true)
    end

function lookup_u64 [@inline:trivial] (self: t_FMap_u64_Slot) (k: UInt64.t) : t_Slot =
  [%#sfmap'0] unwrap_Option_Slot (get_u64 self k)

meta "rewrite_def" function lookup_u64

function lg [#"/home/cornel/repair-j33-rc22/components/dispatcher/verif-creusot/src/core.rs" 300 0 300 27] (w: t_W) (e: t_Ev) : t_W
 = [%#score'21] { dm = w.dm;
                  mt = w.mt;
                  used = w.used;
                  cap = w.cap;
                  c = w.c;
                  wq = w.wq;
                  log = Seq.snoc w.log e;
                  tick = w.tick;
                  ob = w.ob;
                  ob2 = w.ob2;
                  og = w.og;
                  os = w.os;
                  ov = w.ov;
                  ok = w.ok;
                  ext = w.ext;
                  pool = w.pool;
                  cluster = w.cluster;
                  threads = w.threads;
                  rw = w.rw;
                  cfree = w.cfree;
                  wf = w.wf }

let mt_get (s: MutBorrow.t t_S) (k: UInt64.t) (return (x: t_Option_tup2_u64_u32)) = any
  [ return (result: t_Option_tup2_u64_u32) ->
  {[@stop_split] [@expl:mt_get ensures] ([@stop_split] [@expl:mt_get ensures #0] [%#sboundary] s.final.p = s.current.p)
    /\ ([@stop_split] [@expl:mt_get ensures #1] [%#sboundary'0] match result with
      | Some'0 {f0'0 = p'0; f1'0 = z} -> mt_has s.current.g k
      /\ lookup_u64 s.current.g.mt k = { ptr'1 = p'0; size'1 = z } /\ s.final.g = lg s.current.g (MtGet k)
      | None'0 -> not mt_has s.current.g k /\ s.final.g = s.current.g
      end)}
    (! return {result}) ]

let elim_Some (_x: t_Option_tup2_u64_u32) (return (f0'1: tup2_u64_u32)) = any
  [ _k (f0'1: tup2_u64_u32) -> {Some'0 f0'1 = _x} (! return {f0'1})
  | _chk -> (! {[@expl:elim Some] match _x with
