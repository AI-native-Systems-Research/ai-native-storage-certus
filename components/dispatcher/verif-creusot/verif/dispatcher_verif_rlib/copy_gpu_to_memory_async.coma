  | Promote'0
  | Dm'0
  | Remote'0
  | Stream'0
  | Channel'0
  | Other'0

type t_DE = NotInit t_Ni | InvalidParam | KeyNotFound UInt64.t | AlreadyExists UInt64.t | Alloc | Io t_IoK | Timeout

type t_Result_unit_DE = Ok () | Err t_DE

let ensure_initialized (s: t_S) (return (x: t_Result_unit_DE)) = any
  [ return (result: t_Result_unit_DE) ->
  {[@stop_split] [@expl:ensure_initialized ensures] [%#smethods] match result with
      | Ok () -> s.p.init
      | Err e -> not s.p.init /\ e = NotInit (Dispatcher)
      end}
    (! return {result}) ]

predicate resolve_refmut_S [@inline:trivial] (_1: MutBorrow.t t_S) = _1.final = _1.current

meta "rewrite_def" predicate resolve_refmut_S

let elim_Err (_x: t_Result_unit_DE) (return (f0: t_DE)) = any
  [ _k (f0: t_DE) -> {Err f0 = _x} (! return {f0})
  | _chk -> (! {[@expl:elim Err] match _x with
      | Err _ -> true
      | _ -> false
      end}
    any) ]

type tup2_Result_unit_DE_Snapshot_CopyG = { f0: t_Result_unit_DE; f1: t_CopyG }

type tup2_u64_u32 = { f0'0: UInt64.t; f1'0: UInt32.t }

type t_Option_tup2_u64_u32 = None'0 | Some'0 tup2_u64_u32

