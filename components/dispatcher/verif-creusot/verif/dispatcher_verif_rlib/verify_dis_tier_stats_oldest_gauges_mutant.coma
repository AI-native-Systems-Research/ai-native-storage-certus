predicate same_ctr [#"/home/cornel/repair-j33-rc4/components/dispatcher/verif-creusot/src/core.rs" 402 0 402 39] (a: t_Ctr) (b: t_Ctr) =
  [%#score] a.promo_mem = b.promo_mem
  /\ a.promo_gpu = b.promo_gpu
  /\ a.ev_mem = b.ev_mem
  /\ a.ev_ssd = b.ev_ssd
  /\ a.hit_dram = b.hit_dram
  /\ a.hit_ssd = b.hit_ssd
  /\ a.r_hit = b.r_hit
  /\ a.r_miss = b.r_miss
  /\ a.bp = b.bp
  /\ a.drop_full = b.drop_full
  /\ a.already = b.already /\ a.blk_pin = b.blk_pin /\ a.exhausted = b.exhausted /\ a.blk_unp = b.blk_unp

function index_Mapping_Int_Seq_u64 [@inline:trivial] (self: Map.map int (Seq.seq UInt64.t)) (a: int) : Seq.seq UInt64.t
 = [%#smapping] Map.get self a

meta "rewrite_def" function index_Mapping_Int_Seq_u64

type t_Option_u64 = None'0 | Some'0 UInt64.t

type t_Loc = Mem UInt64.t UInt32.t t_Option_u64 | Blk UInt64.t

type t_Ent = { loc: t_Loc; es: UInt32.t; rr: UInt32.t; wr: UInt32.t }

type t_Option_Ent = None'1 | Some'1 t_Ent

function to_mapping_u64 (self: t_FMap_u64_Ent) : Map.map UInt64.t t_Option_Ent

function get_u64 [@inline:trivial] (self: t_FMap_u64_Ent) (k: UInt64.t) : t_Option_Ent =
  [%#sfmap'1] Map.get (to_mapping_u64 self) k

meta "rewrite_def" function get_u64

predicate contains_u64 [@inline:trivial] (self: t_FMap_u64_Ent) (k: UInt64.t) = [%#sfmap] get_u64 self k <> None'1

meta "rewrite_def" predicate contains_u64

predicate has [#"/home/cornel/repair-j33-rc4/components/dispatcher/verif-creusot/src/core.rs" 331 0 331 32] (w: t_W) (k: UInt64.t) =
  [%#score'1] contains_u64 w.dm k

predicate persisted [#"/home/cornel/repair-j33-rc4/components/dispatcher/verif-creusot/src/core.rs" 356 0 356 32] (l: t_Loc) =
  [%#score'2] match l with
    | Mem _ _ ssd -> ssd <> None'0
    | Blk _ -> false
    end

predicate index_Mapping_Ent_bool [@inline:trivial] (self: Map.map t_Ent bool) (a: t_Ent) = [%#smapping] Map.get self a

meta "rewrite_def" predicate index_Mapping_Ent_bool

function such_that_Ent (p'0: Map.map t_Ent bool) : t_Ent

axiom such_that_Ent_spec:
  forall p'0: Map.map t_Ent bool [such_that_Ent p'0]. ([%#slogic] exists x: t_Ent. index_Mapping_Ent_bool p'0 x)
    -> ([%#slogic'0] index_Mapping_Ent_bool p'0 (such_that_Ent p'0))

function unwrap_Option_Ent (self: t_Option_Ent) : t_Ent = [%#soption'0] match self with
    | Some'1 x -> x
    | None'1 -> such_that_Ent (fun (__0: t_Ent) -> true)
    end

function lookup_u64 [@inline:trivial] (self: t_FMap_u64_Ent) (k: UInt64.t) : t_Ent =
  [%#sfmap'0] unwrap_Option_Ent (get_u64 self k)

meta "rewrite_def" function lookup_u64

function ent [#"/home/cornel/repair-j33-rc4/components/dispatcher/verif-creusot/src/core.rs" 336 0 336 31] (w: t_W) (k: UInt64.t) : t_Ent
 = [%#score'3] lookup_u64 w.dm k

predicate evictable [#"/home/cornel/repair-j33-rc4/components/dispatcher/verif-creusot/src/core.rs" 694 0 694 38] (w: t_W) (c'1: UInt64.t) =
  [%#score'0] has w c'1
  /\ persisted (ent w c'1).loc /\ UInt32.t'int (ent w c'1).rr = 0 /\ UInt32.t'int (ent w c'1).wr = 0

function n_evictable [#"/home/cornel/repair-j33-rc4/components/dispatcher/verif-creusot/src/misc.rs" 320 0 320 53] (w: t_W) (ks: Seq.seq UInt64.t) (i: int) : int

axiom n_evictable_def: forall w: t_W, ks: Seq.seq UInt64.t, i: int [n_evictable w ks i]. n_evictable w ks i
    = ([%#smisc'5] if i <= 0 then 0 else n_evictable w ks (i - 1) + (if evictable w (Seq.get ks (i - 1)) then 1 else 0))

let tier_event_stats (s: MutBorrow.t t_S) (return (x: t_Stats)) = any
  [ return (result: t_Stats) ->
  {[@stop_split] [@expl:tier_event_stats ensures] ([@stop_split] [@expl:tier_event_stats ensures #0] [%#smisc] s.final.p
        = s.current.p
      /\ s.final.g
      = { dm = s.current.g.dm;
          mt = s.current.g.mt;
          used = s.current.g.used;
          cap = s.current.g.cap;
          c = s.current.g.c;
          wq = s.current.g.wq;
          log = s.current.g.log;
          tick = s.final.g.tick;
          ob = s.current.g.ob;
          ob2 = s.current.g.ob2;
          og = s.current.g.og;
          os = s.current.g.os;
          ov = s.current.g.ov;
          ok = s.current.g.ok;
          ext = s.current.g.ext;
          pool = s.current.g.pool;
          cluster = s.current.g.cluster;
          threads = s.current.g.threads;
          rw = s.current.g.rw;
          cfree = s.current.g.cfree;
          wf = s.current.g.wf })
    /\ ([@stop_split] [@expl:tier_event_stats ensures #1] [%#smisc'0] same_ctr result.c'0 s.current.g.c)
    /\ ([@stop_split] [@expl:tier_event_stats ensures #2] [%#smisc'1] result.oldest_persisted'0
        <= result.oldest_sampled'0
      /\ 0 <= result.oldest_persisted'0)
    /\ ([@stop_split] [@expl:tier_event_stats ensures #3] [%#smisc'2] s.current.p.has_dm /\ s.current.p.has_mt
      -> result.oldest_sampled'0 = Seq.length (index_Mapping_Int_Seq_u64 s.current.g.ok s.current.g.tick)
      /\ result.oldest_persisted'0
      = n_evictable s.current.g (index_Mapping_Int_Seq_u64 s.current.g.ok s.current.g.tick) result.oldest_sampled'0)
    /\ ([@stop_split] [@expl:tier_event_stats ensures #4] [%#smisc'3] not (s.current.p.has_dm /\ s.current.p.has_mt)
    -> result.oldest_sampled'0 = 0 /\ result.oldest_persisted'0 = 0)}
    (! return {result}) ]

predicate resolve_refmut_S [@inline:trivial] (_1: MutBorrow.t t_S) = _1.final = _1.current

meta "rewrite_def" predicate resolve_refmut_S

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let verify_dis_tier_stats_oldest_gauges__mutant [#"/home/cornel/repair-j33-rc4/components/dispatcher/verif-creusot/src/drivers.rs" 2071 0 2071 80]
  (s: MutBorrow.t t_S) (return (x: t_Stats)) = (! bb0
  [ bb0 = s0
    [ s0 = MutBorrow.borrow_final <t_S> {s.current} {MutBorrow.get_id s}
        (fun (_bor: MutBorrow.t t_S) -> [ &_3 <- _bor ] [ &s <- { s with current = _bor.final } ] s1)
    | s1 = tier_event_stats [%#sdrivers] {_3} (fun (_x: t_Stats) -> [ &_ret <- _x ] s2)
    | s2 = -{resolve_refmut_S s}- s3
    | s3 = return {_ret} ] ]
  [ & _ret: t_Stats = Any.any_l () | & s: MutBorrow.t t_S = s | & _3: MutBorrow.t t_S = Any.any_l () ])
  [ return (result: t_Stats) ->
  {[@stop_split] [@expl:verify_dis_tier_stats_oldest_gauges__mutant ensures] [%#sdrivers'0] result.oldest_persisted'0
    > result.oldest_sampled'0}
    (! return {result}) ]
