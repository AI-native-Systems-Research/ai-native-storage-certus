type t_Vec_Option_Result_unit_DE_Global

type t_Ni = Dispatcher | DispatchMap | MemoryTier | Gpu | Spdk | Logger | Ring

type t_IoK =
  | Partition'0 UInt64.t UInt64.t UInt64.t
  | Drive'0 UInt64.t
  | Gpu'0
  | Sync'0
  | Ssd'0
  | Promote'0
  | Dm'0
  | Remote'0
  | Stream'0
  | Channel'0
  | Other'0

type t_DE = NotInit t_Ni | InvalidParam | KeyNotFound UInt64.t | AlreadyExists UInt64.t | Alloc | Io t_IoK | Timeout

type t_Result_unit_DE = Ok () | Err t_DE

type t_Option_Result_unit_DE = None'0 | Some'0 t_Result_unit_DE

constant const_MAX: UInt64.t = (18446744073709551615: UInt64.t)

function view_Vec_Option_Result_unit_DE_Global (self: t_Vec_Option_Result_unit_DE_Global) : Seq.seq t_Option_Result_unit_DE

axiom view_Vec_Option_Result_unit_DE_Global_spec:
  forall self: t_Vec_Option_Result_unit_DE_Global [view_Vec_Option_Result_unit_DE_Global self]. [%#svec] Seq.length (view_Vec_Option_Result_unit_DE_Global self)
    <= UInt64.t'int const_MAX

type t_Vec_ColdE_Global

type t_ColdE = { idx'1: UInt64.t; key'1: UInt64.t; off'1: UInt64.t; total'1: UInt32.t }

function view_Vec_ColdE_Global (self: t_Vec_ColdE_Global) : Seq.seq t_ColdE

axiom view_Vec_ColdE_Global_spec:
  forall self: t_Vec_ColdE_Global [view_Vec_ColdE_Global self]. [%#svec] Seq.length (view_Vec_ColdE_Global self)
    <= UInt64.t'int const_MAX

let len_ColdE (self_: t_Vec_ColdE_Global) (return (x: UInt64.t)) = any
  [ return (result: UInt64.t) -> {[@stop_split] [@expl:len ensures] [%#svec'0] UInt64.t'int result
    = Seq.length (view_Vec_ColdE_Global self_)}
    (! return {result}) ]

predicate no_reg [#"/home/cornel/repair-j33-rc24/components/dispatcher/verif-creusot/src/core.rs" 684 0 684 33] (a: t_W) (b: t_W) =
  [%#score] forall i: int. Seq.length a.log <= i /\ i < Seq.length b.log
    -> match Seq.get b.log i with
      | DmCreate _ -> false
      | Enq _ -> false
      | _ -> true
      end

predicate own_reads [#"/home/cornel/repair-j33-rc24/components/dispatcher/verif-creusot/src/core.rs" 453 0 453 36] (a: t_W) (b: t_W) =
  [%#score'0] forall i: int. Seq.length a.log <= i /\ i < Seq.length b.log
    -> match Seq.get b.log i with
      | RelRead _ own -> own > 0
      | _ -> true
      end

predicate own_writes [#"/home/cornel/repair-j33-rc24/components/dispatcher/verif-creusot/src/core.rs" 446 0 446 37] (a: t_W) (b: t_W) =
  [%#score'1] forall i: int. Seq.length a.log <= i /\ i < Seq.length b.log
    -> match Seq.get b.log i with
      | RelWrite _ own -> own > 0
      | _ -> true
      end

predicate no_ssd [#"/home/cornel/repair-j33-rc24/components/dispatcher/verif-creusot/src/core.rs" 691 0 691 33] (a: t_W) (b: t_W) =
  [%#score'2] forall i: int. Seq.length a.log <= i /\ i < Seq.length b.log
    -> match Seq.get b.log i with
      | SsdRead _ _ -> false
      | _ -> true
      end

predicate rd_ctr [#"/home/cornel/repair-j33-rc24/components/dispatcher/verif-creusot/src/lookup.rs" 121 0 121 37] (a: t_Ctr) (b: t_Ctr) =
  [%#slookup] a.ev_ssd = b.ev_ssd
  /\ a.hit_dram = b.hit_dram
  /\ a.hit_ssd = b.hit_ssd
  /\ a.r_hit = b.r_hit
  /\ a.r_miss = b.r_miss
  /\ a.bp = b.bp
  /\ a.drop_full = b.drop_full
  /\ a.promo_mem <= b.promo_mem
  /\ a.promo_gpu <= b.promo_gpu
  /\ a.already <= b.already
  /\ a.ev_mem <= b.ev_mem /\ a.blk_pin <= b.blk_pin /\ a.exhausted <= b.exhausted /\ a.blk_unp <= b.blk_unp

function count_true [#"/home/cornel/repair-j33-rc24/components/dispatcher/verif-creusot/src/batch.rs" 341 0 341 46] (s: Seq.seq bool) (n: int) : int

axiom count_true_def: forall s: Seq.seq bool, n: int [count_true s n]. count_true s n
    = ([%#sbatch'34] if n <= 0 then 0 else count_true s (n - 1) + (if Seq.get s (n - 1) then 1 else 0))

predicate is_kn [#"/home/cornel/repair-j33-rc24/components/dispatcher/verif-creusot/src/batch.rs" 73 0 73 28] (r: t_Option_Result_unit_DE) =
  [%#sbatch'40] match r with
    | Some'0 (Err (KeyNotFound _)) -> true
    | _ -> false
    end

predicate no_new_kn [#"/home/cornel/repair-j33-rc24/components/dispatcher/verif-creusot/src/batch.rs" 68 0 68 51] (r0: Seq.seq t_Option_Result_unit_DE) (r: Seq.seq t_Option_Result_unit_DE) =
  [%#sbatch'35] Seq.length r0 = Seq.length r
  /\ (forall i: int. 0 <= i /\ i < Seq.length r
    -> (is_kn (Seq.get r i) -> is_kn (Seq.get r0 i)) /\ (Seq.get r i = None'0 -> Seq.get r0 i = None'0))

predicate log_ext [#"/home/cornel/repair-j33-rc24/components/dispatcher/verif-creusot/src/core.rs" 426 0 426 34] (a: t_W) (b: t_W) =
