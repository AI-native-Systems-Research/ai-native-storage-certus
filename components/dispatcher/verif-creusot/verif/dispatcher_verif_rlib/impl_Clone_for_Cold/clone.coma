(* <Cold as std::clone::Clone> *)

use creusot.int.UInt64
use creusot.int.UInt32
use creusot.prelude.Any

type t_Cold = { key: UInt64.t; off: UInt64.t; size: UInt32.t }

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let clone_Cold [#"/home/cornel/repair-j33-rc22/components/dispatcher/verif-creusot/src/misc.rs" 5 9 5 29] (self: t_Cold)
  (return (x: t_Cold)) = (! bb0
  [ bb0 = s0 [ s0 = [ &_ret <- self ] s1 | s1 = return {_ret} ] ]
  [ & _ret: t_Cold = Any.any_l () | & self: t_Cold = self ]) [ return (result: t_Cold) -> (! return {result}) ]
