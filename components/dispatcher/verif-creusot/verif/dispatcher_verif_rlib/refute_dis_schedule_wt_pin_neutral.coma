          /\ persisted (ent s.current.g k).loc -> persisted (ent s.final.g k).loc)
    /\ ([@stop_split] [@expl:writer_step ensures #5] [%#smethods'10] match result with
      | Stored _ -> has s.current.g (Seq.get s.current.g.wq 0).key'0
        /\ is_mem (ent s.current.g (Seq.get s.current.g.wq 0).key'0).loc
      -> persisted (ent s.final.g (Seq.get s.current.g.wq 0).key'0).loc
      | _ -> true
      end)}
    (! return {result}) ]

