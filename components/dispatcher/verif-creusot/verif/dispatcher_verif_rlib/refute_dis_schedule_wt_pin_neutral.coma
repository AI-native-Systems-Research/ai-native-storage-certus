function lg [#"/home/cornel/repair-j33-rc29/components/dispatcher/verif-creusot/src/core.rs" 303 0 303 27] (w: t_W) (e: t_Ev) : t_W
 = [%#score'1] { dm = w.dm;
                 mt = w.mt;
                 used = w.used;
                 cap = w.cap;
                 c = w.c;
                 wq = w.wq;
                 log = Seq.snoc w.log e;
