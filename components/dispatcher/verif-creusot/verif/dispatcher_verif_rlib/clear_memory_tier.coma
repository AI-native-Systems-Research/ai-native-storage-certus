function len_u64 (self: t_FMap_u64_Slot) : int

axiom len_u64_spec: forall self: t_FMap_u64_Slot [len_u64 self]. [%#sfmap'0] len_u64 self >= 0

let mt_oldest (s: MutBorrow.t t_S) (n: UInt64.t) (return (x: t_Vec_u64_Global)) = any
  [ return (result: t_Vec_u64_Global) ->
  {[@stop_split] [@expl:mt_oldest ensures] ([@stop_split] [@expl:mt_oldest ensures #0] [%#sboundary] s.final.p
        = s.current.p
      /\ s.final.g = nx s.current.g)
    /\ ([@stop_split] [@expl:mt_oldest ensures #1] [%#sboundary'0] view_Vec_u64_Global result
        = index_Mapping_Int_Seq_u64 s.current.g.ok s.current.g.tick
      /\ Seq.length (view_Vec_u64_Global result) <= UInt64.t'int n)
    /\ ([@stop_split] [@expl:mt_oldest ensures #2] [%#sboundary'1] forall i: int. 0 <= i
          /\ i < Seq.length (view_Vec_u64_Global result) -> mt_has s.current.g (Seq.get (view_Vec_u64_Global result) i))
    /\ ([@stop_split] [@expl:mt_oldest ensures #3] [%#sboundary'2] UInt64.t'int n > 0
    -> Seq.length (view_Vec_u64_Global result) = 0 -> len_u64 s.current.g.mt = 0)}
    (! return {result}) ]

let len_u64'0 (self_: t_Vec_u64_Global) (return (x: UInt64.t)) = any
