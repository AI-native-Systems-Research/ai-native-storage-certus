let serve_memory_tier_to_gpu (s: MutBorrow.t t_S) (pointer: UInt64.t) (size'3: UInt32.t) (regions: Slice64.slice t_Ipc)
  (warm_raw: UInt64.t) (synchronize: bool) (return (x: tup2_Result_unit_DE_Snapshot_ServeG)) = any
  [ return (result: tup2_Result_unit_DE_Snapshot_ServeG) ->
  {[@stop_split] [@expl:serve_memory_tier_to_gpu ensures] ([@stop_split] [@expl:serve_memory_tier_to_gpu ensures #0] [%#slookup] s.final.p
        = s.current.p
      /\ s.final.g
        = { dm = s.current.g.dm;
            mt = s.current.g.mt;
            used = s.current.g.used;
            cap = s.current.g.cap;
            c = s.current.g.c;
            wq = s.current.g.wq;
            log = s.final.g.log;
            tick = s.final.g.tick;
            ob = s.current.g.ob;
            ob2 = s.current.g.ob2;
            og = s.current.g.og;
            os = s.current.g.os;
            ov = s.current.g.ov;
            ok = s.current.g.ok;
            ext = s.current.g.ext;
            pool = s.current.g.pool;
            cluster = s.current.g.cluster;
            threads = s.current.g.threads;
            rw = s.current.g.rw;
            cfree = s.current.g.cfree;
            wf = s.current.g.wf }
      /\ log_ext s.current.g s.final.g)
    /\ ([@stop_split] [@expl:serve_memory_tier_to_gpu ensures #1] [%#slookup'0] result.f1.base
        = Seq.length s.current.g.log
      /\ 0 <= result.f1.m /\ result.f1.m <= Seq.length (Slice64.view regions))
    /\ ([@stop_split] [@expl:serve_memory_tier_to_gpu ensures #2] [%#slookup'1] scattered s.final.g result.f1.base (Slice64.view regions) result.f1.m pointer size'3 warm_raw)
    /\ ([@stop_split] [@expl:serve_memory_tier_to_gpu ensures #3] [%#slookup'2] result.f1.m
          < Seq.length (Slice64.view regions)
        /\ result.f0 = Ok () -> chunk_of (Slice64.view regions) result.f1.m (UInt32.t'int size'3) = 0)
    /\ ([@stop_split] [@expl:serve_memory_tier_to_gpu ensures #4] [%#slookup'3] h2d_within s.current.g s.final.g pointer size'3
      /\ own_reads s.current.g s.final.g /\ own_writes s.current.g s.final.g /\ no_reg s.current.g s.final.g)
    /\ ([@stop_split] [@expl:serve_memory_tier_to_gpu ensures #5] [%#slookup'4] result.f0 = Ok () -> result.f1.gpu_ok)
    /\ ([@stop_split] [@expl:serve_memory_tier_to_gpu ensures #6] [%#slookup'5] all_from s.current.g.og s.current.g.tick
      -> result.f0 = Ok ())
    /\ ([@stop_split] [@expl:serve_memory_tier_to_gpu ensures #7] [%#slookup'6] forall i: int. Seq.length s.current.g.log
            <= i
          /\ i < Seq.length s.final.g.log -> h2d_or_sync (Seq.get s.final.g.log i) warm_raw)
    /\ ([@stop_split] [@expl:serve_memory_tier_to_gpu ensures #8] [%#slookup'7] result.f0 <> Ok ()
      -> match result.f0 with
        | Err (Io _) -> not result.f1.gpu_ok
        | _ -> false
        end)
    /\ ([@stop_split] [@expl:serve_memory_tier_to_gpu ensures #9] [%#slookup'8] result.f0 = Ok ()
        /\ synchronize /\ UInt64.t'int warm_raw <> 0
      -> Seq.get s.final.g.log (Seq.length s.final.g.log - 1) = Sync warm_raw
