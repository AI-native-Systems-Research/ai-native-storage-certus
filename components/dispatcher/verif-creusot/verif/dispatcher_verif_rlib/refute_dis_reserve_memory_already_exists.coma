let reserve_memory (s: MutBorrow.t t_S) (key: UInt64.t) (size'2: UInt32.t) (deadline: t_Option_Dl)
  (return (x: tup2_Result_u64_DE_Snapshot_RsvG)) = any
  [ return (result: tup2_Result_u64_DE_Snapshot_RsvG) ->
  {[@stop_split] [@expl:reserve_memory ensures] ([@stop_split] [@expl:reserve_memory ensures #0] [%#sevict] s.final.p
      = s.current.p)
    /\ ([@stop_split] [@expl:reserve_memory ensures #1] [%#sevict'0] not s.current.p.init
      -> result.f0 = Err (NotInit (Dispatcher)) /\ s.final.g = s.current.g)
    /\ ([@stop_split] [@expl:reserve_memory ensures #2] [%#sevict'1] s.current.p.init /\ UInt32.t'int size'2 = 0
      -> result.f0 = Err (InvalidParam) /\ s.final.g = s.current.g)
    /\ ([@stop_split] [@expl:reserve_memory ensures #3] [%#sevict'2] rsv_ctr s.current.g.c s.final.g.c)
    /\ ([@stop_split] [@expl:reserve_memory ensures #4] [%#sevict'3] s.current.p.init
        /\ UInt32.t'int size'2 > 0 /\ s.current.p.has_dm /\ s.current.p.has_mt
      -> match result.f0 with
          | Ok ptr'0 -> eai_frame s.current.g s.final.g key ptr'0 size'2
          | Err (Alloc) -> evict_frame s.current.g s.final.g
          | Err (AlreadyExists k) -> k = key /\ evict_frame s.current.g s.final.g /\ mt_has s.final.g key
          | Err _ -> false
          end
      /\ result.f1.attempts >= 1
      /\ s.final.g.c.bp = s.current.g.c.bp + result.f1.attempts - 1
      /\ (deadline = None'3 /\ UInt64.t'int s.current.p.bp_ms = 0
        \/ match deadline with
          | Some'3 d -> d.past
          | None'3 -> false
          end -> result.f1.attempts = 1))
    /\ ([@stop_split] [@expl:reserve_memory ensures #5] [%#sevict'4] match result.f0 with
        | Ok _ -> true
        | Err (Alloc) -> true
        | Err (AlreadyExists _) -> true
        | _ -> s.final.g.c.bp = s.current.g.c.bp
        end)
    /\ ([@stop_split] [@expl:reserve_memory ensures #6] [%#sevict'5] s.current.p.init
        /\ UInt32.t'int size'2 > 0
        /\ s.current.p.has_dm
        /\ s.current.p.has_mt
        /\ deadline = None'3
        /\ UInt64.t'int s.current.p.bp_ms = 0
        /\ all_from s.current.g.ob s.current.g.tick
        /\ s.current.g.used + UInt32.t'int size'2 <= s.current.g.cap /\ not mt_has s.current.g key
      -> match result.f0 with
        | Ok _ -> s.final.g.dm = s.current.g.dm
        | _ -> false
        end)
    /\ ([@stop_split] [@expl:reserve_memory ensures #7] [%#sevict'6] s.current.p.init
      /\ UInt32.t'int size'2 > 0
      /\ s.current.p.has_dm
      /\ s.current.p.has_mt
      /\ deadline = None'3
      /\ UInt64.t'int s.current.p.bp_ms = 0
      /\ UInt64.t'int s.current.p.max_att = 0 /\ s.current.g.used + UInt32.t'int size'2 > s.current.g.cap
    -> result.f0 = Err (Alloc) /\ s.final.g = s.current.g)}
    (! return {result}) ]

