predicate rsv_ctr [#"/home/cornel/repair-j33-rc29/components/dispatcher/verif-creusot/src/evict.rs" 274 0 274 38] (a: t_Ctr) (b: t_Ctr) =
  [%#sevict'7] a.promo_mem = b.promo_mem
  /\ a.promo_gpu = b.promo_gpu
  /\ a.ev_ssd = b.ev_ssd
  /\ a.hit_dram = b.hit_dram
  /\ a.hit_ssd = b.hit_ssd
  /\ a.r_hit = b.r_hit
  /\ a.r_miss = b.r_miss
  /\ a.drop_full = b.drop_full
  /\ a.bp <= b.bp
  /\ a.already <= b.already
  /\ a.ev_mem <= b.ev_mem /\ a.blk_pin <= b.blk_pin /\ a.exhausted <= b.exhausted /\ a.blk_unp <= b.blk_unp

