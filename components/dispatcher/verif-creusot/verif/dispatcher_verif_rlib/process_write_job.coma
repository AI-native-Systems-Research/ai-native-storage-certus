let dm_convert_to_storage (s: MutBorrow.t t_S) (k: UInt64.t) (off: UInt64.t) (return (x: t_Result_unit_DmE)) = any
  [ return (result: t_Result_unit_DmE) ->
  {[@stop_split] [@expl:dm_convert_to_storage ensures] ([@stop_split] [@expl:dm_convert_to_storage ensures #0] [%#sboundary'1] s.final.p
      = s.current.p)
    /\ ([@stop_split] [@expl:dm_convert_to_storage ensures #1] [%#sboundary'2] match result with
      | Ok () -> has s.current.g k
      /\ is_mem (ent s.current.g k).loc
      /\ has s.final.g k
      /\ (ent s.final.g k).loc
        = match (ent s.current.g k).loc with
          | Mem ptr size'2 _ -> Mem ptr size'2 (Some'2 off)
          | l -> l
          end
      /\ (ent s.final.g k).es = (ent s.current.g k).es
      /\ (ent s.final.g k).wr = (ent s.current.g k).wr
      /\ UInt32.t'int (ent s.final.g k).rr
        = (if UInt32.t'int (ent s.current.g k).rr > 0 then UInt32.t'int (ent s.current.g k).rr - 1 else 0)
      /\ others s.current.g s.final.g k /\ only_dm s.current.g s.final.g
      | Err (KeyNotFound) -> not has s.current.g k /\ s.final.g = s.current.g
      | Err (InvalidState) -> has s.current.g k /\ is_blk (ent s.current.g k).loc /\ s.final.g = s.current.g
      | Err _ -> false
      end)}
    (! return {result}) ]

