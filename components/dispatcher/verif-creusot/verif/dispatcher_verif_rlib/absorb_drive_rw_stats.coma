      /\ s.current.g = g0
      /\ UInt64.t'int i <= UInt64.t'int s.current.p.nd /\ UInt64.t'int base = g0.rw_base + rwsum g0.rw (UInt64.t'int i)}
      (! s0)
      [ s0 = [ &_25 <- UInt64.lt i s.current.p.nd ] s1
