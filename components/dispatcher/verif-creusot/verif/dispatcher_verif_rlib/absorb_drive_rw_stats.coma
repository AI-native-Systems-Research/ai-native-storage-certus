                                                                          ob = s.current.g.ob;
                                                                          ob2 = s.current.g.ob2;
                                                                          og = s.current.g.og;
                                                                          os = s.current.g.os;
                                                                          ov = s.current.g.ov;
                                                                          ok = s.current.g.ok;
                                                                          ext = s.current.g.ext;
