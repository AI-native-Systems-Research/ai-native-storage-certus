        | s1 = bd_rw_stats [%#smisc'4] {_29} {i} (fun (_x: UInt64.t) -> [ &v <- _x ] s2)
        | s2 = padd64 [%#smisc'5] {base} {v} (fun (_x: UInt64.t) -> [ &_31 <- _x ] s3)
        | s3 = [ &base <- _31 ] s4
        | s4 = UInt64.add [%#smisc'7] {i} {[%#smisc'6] (1: UInt64.t)} (fun (_x: UInt64.t) -> [ &i <- _x ] s5)
        | s5 = bb4 ] ] ]
  | bb9 = s0
    [ s0 = {[@expl:assertion] [%#smisc'8] rw_total_def g0 (UInt64.t'int s.current.p.nd) = ()} s1
    | s1 = [ &s <- { s with current = { s.current with g = ([%#smisc'9] { dm = s.current.g.dm;
                                                                          mt = s.current.g.mt;
                                                                          used = s.current.g.used;
                                                                          cap = s.current.g.cap;
                                                                          c = s.current.g.c;
