use creusot.prelude.Any

type t_ServedBy = Dram | Ssd | Remote | Miss | SizeMismatch | Error

let served_by_is_hit (sb: t_ServedBy) (return (x: bool)) = any
  [ return (result: bool) -> {[@stop_split] [@expl:served_by_is_hit ensures] [%#smisc] result
    = match sb with
      | Dram -> true
      | Ssd -> true
      | Remote -> true
      | _ -> false
      end}
    (! return {result}) ]

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let verify_dis_servedby_is_hit [#"/home/cornel/repair-j33-rc21/components/dispatcher/verif-creusot/src/drivers.rs" 2182 0 2182 55]
  (sb: t_ServedBy) (return (x: bool)) = (! bb0
  [ bb0 = s0 [ s0 = served_by_is_hit [%#sdrivers] {sb} (fun (_x: bool) -> [ &_ret <- _x ] s1) | s1 = return {_ret} ] ]
  [ & _ret: bool = Any.any_l () | & sb: t_ServedBy = sb ])
  [ return (result: bool) ->
  {[@stop_split] [@expl:verify_dis_servedby_is_hit ensures] ([@stop_split] [@expl:verify_dis_servedby_is_hit ensures #0] [%#sdrivers'0] result
      = (sb = Dram \/ sb = Ssd \/ sb = Remote))
    /\ ([@stop_split] [@expl:verify_dis_servedby_is_hit ensures #1] [%#sdrivers'1] sb = Miss
      \/ sb = SizeMismatch \/ sb = Error -> not result)}
    (! return {result}) ]
