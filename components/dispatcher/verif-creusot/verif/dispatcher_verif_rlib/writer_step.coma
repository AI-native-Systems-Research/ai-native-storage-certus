let process_write_job (s: MutBorrow.t t_S) (job: t_Job) (return (x: t_WjOut)) =
{[@stop_split] [@expl:process_write_job requires] [%#smethods'14] a_us5 s.current.p job.key}
  any
  [ return (result: t_WjOut) ->
  {[@stop_split] [@expl:process_write_job ensures] ([@stop_split] [@expl:process_write_job ensures #0] [%#smethods'15] s.final.p
      = s.current.p)
