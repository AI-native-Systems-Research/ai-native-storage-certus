+// A storage-tier holder is a pull source only when storage is pullable.
+func TestProduce_PullableTiers_Storage(t *testing.T) {
+	ctx := utils.NewTestContext(t)
+	for _, tc := range []struct {
+		name  string
+		tiers []string
+		want  string
+	}{
+		{"default: cpu only", nil, ""},
+		{"storage pullable", []string{"storage"}, "10.0.0.2:8080"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			p := New("test", Config{MinCachedTokenDelta: 1, PullableTiers: tc.tiers})
+			req := &scheduling.InferenceRequest{RequestID: "req-" + tc.name}
+			eps := []scheduling.Endpoint{
+				tierEndpoint(p, "pod-gpu", "10.0.0.1", 10, map[string]int{"gpu": 10}),
+				tierEndpoint(p, "pod-ext", "10.0.0.2", 6, map[string]int{"gpu": 2, "storage": 6}),
+			}
+			require.NoError(t, p.Produce(ctx, req, eps))
+			best, ok := scheduling.ReadRequestAttribute[*bestMatchPeer](req, p.attrKey())
+			if tc.want == "" {
+				assert.False(t, ok, "no pullable source by default")
+				return
+			}
+			require.True(t, ok)
+			assert.Equal(t, tc.want, best.hostPort)
+			assert.Equal(t, 6*testBlockSize, best.cachedTokens)
+		})
+	}
+}
+
+// Two pullable tiers: the longer chain counts; they are not summed.
+func TestProduce_PullableTiers_LongestChainNotSum(t *testing.T) {
+	ctx := utils.NewTestContext(t)
+	p := New("test", Config{MinCachedTokenDelta: 1, PullableTiers: []string{"CPU", "storage"}})
+	req := &scheduling.InferenceRequest{RequestID: "req-two-tiers"}
+	require.NoError(t, p.Produce(ctx, req, []scheduling.Endpoint{
+		tierEndpoint(p, "pod-mixed", "10.0.0.3", 7, map[string]int{"cpu": 3, "storage": 4}),
+	}))
+	best, ok := scheduling.ReadRequestAttribute[*bestMatchPeer](req, p.attrKey())
+	require.True(t, ok)
+	assert.Equal(t, 4*testBlockSize, best.cachedTokens)
+}
+
+func TestPluginFactory_PullableTiers_RejectsUnpullable(t *testing.T) {
+	for _, tier := range []string{"gpu", "GPU", "speculative", ""} {
+		dec := json.NewDecoder(strings.NewReader(`{"pullableTiers": ["` + tier + `"]}`))
+		_, err := PluginFactory("test", dec, nil)
+		assert.Error(t, err, "tier %q", tier)
+	}
+	dec := json.NewDecoder(strings.NewReader(`{"pullableTiers": ["storage"]}`))
+	_, err := PluginFactory("test", dec, nil)
+	assert.NoError(t, err)
+}
