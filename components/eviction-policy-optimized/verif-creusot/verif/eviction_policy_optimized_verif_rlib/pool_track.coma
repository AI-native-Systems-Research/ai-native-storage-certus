use creusot.int.UInt32
use creusot.int.UInt64
use creusot.prelude.MutBorrow
use seq.Seq
use creusot.int.UInt8
use int.ComputerDivision
use creusot.prelude.Any
use int.Int

type t_Vec_Node_Global

type t_Option_u32 = None | Some UInt32.t

type t_Vec_u32_Global

type t_LruList = {
  nodes: t_Vec_Node_Global;
  head: t_Option_u32;
  tail: t_Option_u32;
  free: t_Vec_u32_Global;
  len: UInt64.t }

type t_Vec_u8_Global

type t_Sketch = { counters: t_Vec_u8_Global }

type t_Pool = { lru: t_LruList; sketch: t_Sketch; access_count: UInt64.t; max_len: UInt64.t }

type tup4_usize_usize_usize_usize = { f0: UInt64.t; f1: UInt64.t; f2: UInt64.t; f3: UInt64.t }

constant const_MAX: UInt64.t = (18446744073709551615: UInt64.t)

function view_Vec_u8_Global (self: t_Vec_u8_Global) : Seq.seq UInt8.t

axiom view_Vec_u8_Global_spec:
  forall self: t_Vec_u8_Global [view_Vec_u8_Global self]. [%#svec] Seq.length (view_Vec_u8_Global self)
    <= UInt64.t'int const_MAX

let sketch_increment4 (self_: MutBorrow.t t_Sketch) (key: UInt64.t) (return (x: tup4_usize_usize_usize_usize)) =
{[@stop_split] [@expl:sketch_increment4 requires] [%#slib'25] Seq.length (view_Vec_u8_Global self_.current.counters)
  = 4096}
  any
  [ return (result: tup4_usize_usize_usize_usize) ->
  {[@stop_split] [@expl:sketch_increment4 ensures] ([@stop_split] [@expl:sketch_increment4 ensures #0] [%#slib'26] Seq.length (view_Vec_u8_Global self_.final.counters)
      = 4096)
    /\ ([@stop_split] [@expl:sketch_increment4 ensures #1] [%#slib'27] UInt64.t'int result.f0 < 1024)
    /\ ([@stop_split] [@expl:sketch_increment4 ensures #2] [%#slib'28] 1024 <= UInt64.t'int result.f1
      /\ UInt64.t'int result.f1 < 2048)
    /\ ([@stop_split] [@expl:sketch_increment4 ensures #3] [%#slib'29] 2048 <= UInt64.t'int result.f2
      /\ UInt64.t'int result.f2 < 3072)
    /\ ([@stop_split] [@expl:sketch_increment4 ensures #4] [%#slib'30] 3072 <= UInt64.t'int result.f3
      /\ UInt64.t'int result.f3 < 4096)
    /\ ([@stop_split] [@expl:sketch_increment4 ensures #5] [%#slib'31] UInt8.t'int (Seq.get (view_Vec_u8_Global self_.final.counters) (UInt64.t'int result.f0))
      = (if UInt8.t'int (Seq.get (view_Vec_u8_Global self_.current.counters) (UInt64.t'int result.f0)) = 255 then
        255
      else
        UInt8.t'int (Seq.get (view_Vec_u8_Global self_.current.counters) (UInt64.t'int result.f0)) + 1
      ))
    /\ ([@stop_split] [@expl:sketch_increment4 ensures #6] [%#slib'32] UInt8.t'int (Seq.get (view_Vec_u8_Global self_.final.counters) (UInt64.t'int result.f1))
      = (if UInt8.t'int (Seq.get (view_Vec_u8_Global self_.current.counters) (UInt64.t'int result.f1)) = 255 then
        255
      else
        UInt8.t'int (Seq.get (view_Vec_u8_Global self_.current.counters) (UInt64.t'int result.f1)) + 1
      ))
    /\ ([@stop_split] [@expl:sketch_increment4 ensures #7] [%#slib'33] UInt8.t'int (Seq.get (view_Vec_u8_Global self_.final.counters) (UInt64.t'int result.f2))
      = (if UInt8.t'int (Seq.get (view_Vec_u8_Global self_.current.counters) (UInt64.t'int result.f2)) = 255 then
        255
      else
        UInt8.t'int (Seq.get (view_Vec_u8_Global self_.current.counters) (UInt64.t'int result.f2)) + 1
      ))
    /\ ([@stop_split] [@expl:sketch_increment4 ensures #8] [%#slib'34] UInt8.t'int (Seq.get (view_Vec_u8_Global self_.final.counters) (UInt64.t'int result.f3))
      = (if UInt8.t'int (Seq.get (view_Vec_u8_Global self_.current.counters) (UInt64.t'int result.f3)) = 255 then
        255
      else
        UInt8.t'int (Seq.get (view_Vec_u8_Global self_.current.counters) (UInt64.t'int result.f3)) + 1
      ))
    /\ ([@stop_split] [@expl:sketch_increment4 ensures #9] [%#slib'35] UInt8.t'int (Seq.get (view_Vec_u8_Global self_.final.counters) (UInt64.t'int result.f0))
        >= 1
      /\ UInt8.t'int (Seq.get (view_Vec_u8_Global self_.final.counters) (UInt64.t'int result.f1)) >= 1
      /\ UInt8.t'int (Seq.get (view_Vec_u8_Global self_.final.counters) (UInt64.t'int result.f2)) >= 1
      /\ UInt8.t'int (Seq.get (view_Vec_u8_Global self_.final.counters) (UInt64.t'int result.f3)) >= 1)
    /\ ([@stop_split] [@expl:sketch_increment4 ensures #10] [%#slib'36] forall j: int. 0 <= j
        /\ j < 4096
        /\ j <> UInt64.t'int result.f0
        /\ j <> UInt64.t'int result.f1 /\ j <> UInt64.t'int result.f2 /\ j <> UInt64.t'int result.f3
      -> Seq.get (view_Vec_u8_Global self_.final.counters) j = Seq.get (view_Vec_u8_Global self_.current.counters) j)}
    (! return {result}) ]

predicate resolve_refmut_Sketch [@inline:trivial] (_1: MutBorrow.t t_Sketch) = _1.final = _1.current

meta "rewrite_def" predicate resolve_refmut_Sketch

type t_Node = { key: UInt64.t; prev: t_Option_u32; next: t_Option_u32; active: bool }

function view_Vec_Node_Global (self: t_Vec_Node_Global) : Seq.seq t_Node

axiom view_Vec_Node_Global_spec:
  forall self: t_Vec_Node_Global [view_Vec_Node_Global self]. [%#svec] Seq.length (view_Vec_Node_Global self)
