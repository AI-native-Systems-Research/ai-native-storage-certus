    /\ ([@stop_split] [@expl:arena_pop_front ensures #2] [%#slib'10] Seq.length (view_Vec_Node_Global self_.final.nodes)
      = Seq.length (view_Vec_Node_Global self_.current.nodes))
    /\ ([@stop_split] [@expl:arena_pop_front ensures #3] [%#slib'11] match self_.current.head with
        | Some h -> (Seq.get (view_Vec_Node_Global self_.current.nodes) (UInt32.t'int h)).prev = None
        -> self_.final.head = (Seq.get (view_Vec_Node_Global self_.current.nodes) (UInt32.t'int h)).next
