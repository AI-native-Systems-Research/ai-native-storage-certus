        = None -> result = None'0 /\ self_.final = self_.current)
    /\ ([@stop_split] [@expl:arena_pop_front ensures #1] [%#slib'9] match self_.current.head with
        | Some h -> result = Some'0 ((Seq.get (view_Vec_Node_Global self_.current.nodes) (UInt32.t'int h)).key)
