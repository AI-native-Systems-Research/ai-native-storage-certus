  any
  [ return (result: MutBorrow.t UInt8.t) ->
  {[@stop_split] [@expl:index_mut_Vec_u8_Global ensures] ([@stop_split] [@expl:index_mut ensures #0] [%#svec'1] has_value_usize ix (view_Vec_u8_Global self_.current) result.current)
    /\ ([@stop_split] [@expl:index_mut ensures #1] [%#svec'2] has_value_usize ix (view_Vec_u8_Global self_.final) result.final)
    /\ ([@stop_split] [@expl:index_mut ensures #2] [%#svec'3] resolve_elswhere_usize ix (view_Vec_u8_Global self_.current) (view_Vec_u8_Global self_.final))
    /\ ([@stop_split] [@expl:index_mut ensures #3] [%#svec'4] Seq.length (view_Vec_u8_Global self_.final)
    = Seq.length (view_Vec_u8_Global self_.current))}
    (! return {result}) ]

predicate resolve_refmut_u8 [@inline:trivial] (_1: MutBorrow.t UInt8.t) = _1.final = _1.current

meta "rewrite_def" predicate resolve_refmut_u8

predicate resolve_refmut_Sketch [@inline:trivial] (_1: MutBorrow.t t_Sketch) = _1.final = _1.current

meta "rewrite_def" predicate resolve_refmut_Sketch

