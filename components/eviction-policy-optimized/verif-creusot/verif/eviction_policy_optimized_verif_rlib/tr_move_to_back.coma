  {[@stop_split] [@expl:tr_move_to_back ensures] ([@stop_split] [@expl:tr_move_to_back ensures #0] [%#slib'10] lb self_.final)
    /\ ([@stop_split] [@expl:tr_move_to_back ensures #1] [%#slib'11] not (Seq.get (view_Vec_Node_Global self_.current.nodes) (UInt32.t'int idx)).active
        \/ self_.current.tail = Some idx -> self_.final = self_.current)
    /\ ([@stop_split] [@expl:tr_move_to_back ensures #2] [%#slib'12] (Seq.get (view_Vec_Node_Global self_.current.nodes) (UInt32.t'int idx)).active
      /\ self_.current.tail <> Some idx -> mv_eff2 self_.current self_.final idx)}
    (! return {result}) ]
