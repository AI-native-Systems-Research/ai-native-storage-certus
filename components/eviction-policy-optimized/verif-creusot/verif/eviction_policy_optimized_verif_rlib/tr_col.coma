let wrapping_mul (self_: UInt64BW.t) (rhs: UInt64BW.t) (return (x: UInt64BW.t)) = any
  [ return (result: UInt64BW.t) -> {[@stop_split] [@expl:wrapping_mul ensures] [%#snum] result = UInt64BW.mul self_ rhs}
    (! return {result}) ]

