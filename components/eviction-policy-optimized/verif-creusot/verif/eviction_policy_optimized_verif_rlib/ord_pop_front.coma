let tr_pop_front (self_: MutBorrow.t t_LruList) (return (x: t_Option_u64)) =
{[@stop_split] [@expl:tr_pop_front requires] ([@stop_split] [@expl:tr_pop_front requires #0] [%#slib'5] lb self_.current)
  /\ ([@stop_split] [@expl:tr_pop_front requires #1] [%#slib'6] match self_.current.head with
    | Some h -> (Seq.get (view_Vec_Node_Global self_.current.nodes) (UInt32.t'int h)).active
    -> UInt64.t'int self_.current.len >= 1
    | None -> true
    end)}
  any
  [ return (result: t_Option_u64) ->
  {[@stop_split] [@expl:tr_pop_front ensures] ([@stop_split] [@expl:tr_pop_front ensures #0] [%#slib'7] lb self_.final)
    /\ ([@stop_split] [@expl:tr_pop_front ensures #1] [%#slib'8] self_.current.head = None
      -> result = None'0 /\ self_.final = self_.current)
    /\ ([@stop_split] [@expl:tr_pop_front ensures #2] [%#slib'9] match self_.current.head with
      | Some h -> result = Some'0 ((Seq.get (view_Vec_Node_Global self_.current.nodes) (UInt32.t'int h)).key)
      /\ ((Seq.get (view_Vec_Node_Global self_.current.nodes) (UInt32.t'int h)).active
        -> rm_eff self_.current self_.final h)
      /\ (not (Seq.get (view_Vec_Node_Global self_.current.nodes) (UInt32.t'int h)).active
      -> self_.final = self_.current)
      | None -> true
      end)}
    (! return {result}) ]

predicate resolve_refmut_LruList [@inline:trivial] (_1: MutBorrow.t t_LruList) = _1.final = _1.current

meta "rewrite_def" predicate resolve_refmut_LruList

type tup2_Snapshot_Seq_u32_Snapshot_Seq_Int = { f0: Seq.seq UInt32.t; f1: Seq.seq int }

predicate ord [#"/home/cornel/epo-creusot-correction/components/eviction-policy-optimized/verif-creusot/src/lib.rs" 4187 0 4187 59] (l: t_LruList) (s: Seq.seq UInt32.t) (pos: Seq.seq int) =
  [%#slib'10] lb l
  /\ Seq.length s = UInt64.t'int l.len
