  /\ Seq.length (view_Vec_Node_Global l.nodes) = UInt64.t'int l.len + Seq.length (view_Vec_u32_Global l.free)
  /\ (forall k: int. 0 <= k /\ k < Seq.length s
      -> UInt32.t'int (Seq.get s k) < Seq.length (view_Vec_Node_Global l.nodes)
      /\ (Seq.get (view_Vec_Node_Global l.nodes) (UInt32.t'int (Seq.get s k))).active
      /\ Seq.get pos (UInt32.t'int (Seq.get s k)) = k)
  /\ (forall i: int. 0 <= i
        /\ i < Seq.length (view_Vec_Node_Global l.nodes) /\ (Seq.get (view_Vec_Node_Global l.nodes) i).active
      -> 0 <= Seq.get pos i /\ Seq.get pos i < Seq.length s /\ UInt32.t'int (Seq.get s (Seq.get pos i)) = i)
  /\ (forall i: int. 0 <= i
        /\ i < Seq.length (view_Vec_Node_Global l.nodes) /\ not (Seq.get (view_Vec_Node_Global l.nodes) i).active
      -> (Seq.get (view_Vec_Node_Global l.nodes) i).prev = None
      /\ (Seq.get (view_Vec_Node_Global l.nodes) i).next = None)
  /\ (forall k: int. 0 <= k /\ k < Seq.length s
      -> (Seq.get (view_Vec_Node_Global l.nodes) (UInt32.t'int (Seq.get s k))).prev
        = (if k = 0 then None else Some (Seq.get s (k - 1)))
      /\ (Seq.get (view_Vec_Node_Global l.nodes) (UInt32.t'int (Seq.get s k))).next
      = (if k = Seq.length s - 1 then None else Some (Seq.get s (k + 1))))
  /\ l.head = (if Seq.length s = 0 then None else Some (Seq.get s 0))
  /\ l.tail = (if Seq.length s = 0 then None else Some (Seq.get s (Seq.length s - 1)))
  /\ (forall k: int. 0 <= k /\ k < Seq.length (view_Vec_u32_Global l.free)
      -> not (Seq.get (view_Vec_Node_Global l.nodes) (UInt32.t'int (Seq.get (view_Vec_u32_Global l.free) k))).active)
  /\ (forall j: int, k: int. 0 <= j /\ j < k /\ k < Seq.length (view_Vec_u32_Global l.free)
    -> Seq.get (view_Vec_u32_Global l.free) j <> Seq.get (view_Vec_u32_Global l.free) k)

