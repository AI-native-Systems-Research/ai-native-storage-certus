  any
  [ return (result: ()) ->
  {[@stop_split] [@expl:lock_acquire ensures] ([@stop_split] [@expl:lock_acquire ensures #0] [%#slib'7] UInt64.t'int t.final.held
      = UInt64.t'int t.current.held + 1)
    /\ ([@stop_split] [@expl:lock_acquire ensures #1] [%#slib'8] UInt64.t'int t.final.peak >= UInt64.t'int t.final.held)
    /\ ([@stop_split] [@expl:lock_acquire ensures #2] [%#slib'9] UInt64.t'int t.final.peak
      >= UInt64.t'int t.current.peak)
    /\ ([@stop_split] [@expl:lock_acquire ensures #3] [%#slib'10] UInt64.t'int t.final.peak
    = (if UInt64.t'int t.current.held + 1 > UInt64.t'int t.current.peak then
      UInt64.t'int t.current.held + 1
    else
      UInt64.t'int t.current.peak
    ))}
    (! return {result}) ]

let lock_release (t: MutBorrow.t t_LockTrace) (return (x: ())) =
{[@stop_split] [@expl:lock_release requires] [%#slib'11] UInt64.t'int t.current.held >= 1}
