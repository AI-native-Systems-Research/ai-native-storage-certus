  [ return (result: ()) ->
  {[@stop_split] [@expl:lock_release ensures] ([@stop_split] [@expl:lock_release ensures #0] [%#slib'12] UInt64.t'int t.final.held
      = UInt64.t'int t.current.held - 1)
    /\ ([@stop_split] [@expl:lock_release ensures #1] [%#slib'13] t.final.peak = t.current.peak)}
    (! return {result}) ]

predicate resolve_refmut_LockTrace [@inline:trivial] (_1: MutBorrow.t t_LockTrace) = _1.final = _1.current

