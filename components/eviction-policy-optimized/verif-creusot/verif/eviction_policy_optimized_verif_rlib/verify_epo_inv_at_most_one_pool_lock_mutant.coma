type t_LockTrace = { held: UInt64.t; peak: UInt64.t }

let lock_acquire (t: MutBorrow.t t_LockTrace) (return (x: ())) =
{[@stop_split] [@expl:lock_acquire requires] [%#slib'6] UInt64.t'int t.current.held < 4294967295
