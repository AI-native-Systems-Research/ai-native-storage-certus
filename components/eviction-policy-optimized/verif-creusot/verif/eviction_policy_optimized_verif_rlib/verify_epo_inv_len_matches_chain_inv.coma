let chain_push_back (self_: MutBorrow.t t_LruList) (key'0: UInt64.t) (return (x: UInt32.t)) =
{[@stop_split] [@expl:chain_push_back requires] ([@stop_split] [@expl:chain_push_back requires #0] [%#slib'25] inv self_.current
    /\ wf self_.current)
  /\ ([@stop_split] [@expl:chain_push_back requires #1] [%#slib'26] Seq.length (view_Vec_Node_Global self_.current.nodes)
  < 4294967295)}
