        <= UInt8.t'int c0
      /\ UInt8.t'int result <= UInt8.t'int c1
      /\ UInt8.t'int result <= UInt8.t'int c2 /\ UInt8.t'int result <= UInt8.t'int c3)
    /\ ([@stop_split] [@expl:cms_min4 ensures #1] [%#slib'12] result = c0 \/ result = c1 \/ result = c2 \/ result = c3)}
    (! return {result}) ]

