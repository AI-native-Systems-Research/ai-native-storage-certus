axiom view_Vec_u64_Global_spec:
  forall self: t_Vec_u64_Global [view_Vec_u64_Global self]. [%#svec'0] Seq.length (view_Vec_u64_Global self)
    <= UInt64.t'int const_MAX

let new_u64 (return (x: t_Vec_u64_Global)) = any
  [ return (result: t_Vec_u64_Global) ->
  {[@stop_split] [@expl:new ensures] [%#svec] Seq.length (view_Vec_u64_Global result) = 0}
    (! return {result}) ]

type t_Vec_Node_Global

type t_Option_u32 = None | Some UInt32.t

type t_Vec_u32_Global

type t_LruList = {
  nodes: t_Vec_Node_Global;
  head: t_Option_u32;
  tail: t_Option_u32;
  free: t_Vec_u32_Global;
