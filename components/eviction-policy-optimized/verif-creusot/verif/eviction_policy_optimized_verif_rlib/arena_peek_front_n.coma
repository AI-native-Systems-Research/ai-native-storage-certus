predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
  [%#swell_founded] self >= 0 /\ self > other

meta "rewrite_def" predicate well_founded_relation_Int

type t_Node = { key: UInt64.t; prev: t_Option_u32; next: t_Option_u32; active: bool }

function view_Vec_Node_Global (self: t_Vec_Node_Global) : Seq.seq t_Node

axiom view_Vec_Node_Global_spec:
  forall self: t_Vec_Node_Global [view_Vec_Node_Global self]. [%#svec'0] Seq.length (view_Vec_Node_Global self)
    <= UInt64.t'int const_MAX

let elim_Some (_x: t_Option_u32) (return (f0: UInt32.t)) = any
  [ _k (f0: UInt32.t) -> {Some f0 = _x} (! return {f0})
  | _chk -> (! {[@expl:elim Some] match _x with
      | Some _ -> true
      | _ -> false
      end}
    any) ]

let len_u64 (self_: t_Vec_u64_Global) (return (x: UInt64.t)) = any
  [ return (result: UInt64.t) -> {[@stop_split] [@expl:len ensures] [%#svec'1] UInt64.t'int result
    = Seq.length (view_Vec_u64_Global self_)}
    (! return {result}) ]

predicate in_bounds_usize [@inline:trivial] (self: UInt64.t) (seq: Seq.seq t_Node) =
  [%#sslice] UInt64.t'int self < Seq.length seq

meta "rewrite_def" predicate in_bounds_usize

predicate has_value_usize [@inline:trivial] (self: UInt64.t) (seq: Seq.seq t_Node) (out: t_Node) =
  [%#sslice'0] Seq.get seq (UInt64.t'int self) = out

meta "rewrite_def" predicate has_value_usize

let index_Vec_Node_Global (self_: t_Vec_Node_Global) (ix: UInt64.t) (return (x: t_Node)) =
{[@stop_split] [@expl:index requires] [%#svec'2] in_bounds_usize ix (view_Vec_Node_Global self_)}
  any
  [ return (result: t_Node) ->
  {[@stop_split] [@expl:index ensures] [%#svec'3] has_value_usize ix (view_Vec_Node_Global self_) result}
    (! return {result}) ]

let push_u64 (self_: MutBorrow.t t_Vec_u64_Global) (v: UInt64.t) (return (x: ())) = any
  [ return (result: ()) -> {[@stop_split] [@expl:push ensures] [%#svec'4] view_Vec_u64_Global self_.final
    = Seq.snoc (view_Vec_u64_Global self_.current) v}
