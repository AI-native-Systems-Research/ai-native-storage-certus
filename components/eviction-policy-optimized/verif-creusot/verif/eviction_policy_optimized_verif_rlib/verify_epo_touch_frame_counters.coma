use creusot.int.UInt32
use creusot.int.UInt64
use creusot.prelude.MutBorrow
use seq.Seq
use creusot.prelude.Any
use int.Int

type t_Vec_Node_Global

type t_Option_u32 = None | Some UInt32.t

type t_Vec_u32_Global

type t_LruList = {
  nodes: t_Vec_Node_Global;
  head: t_Option_u32;
  tail: t_Option_u32;
  free: t_Vec_u32_Global;
  len: UInt64.t }

type t_Vec_u8_Global

type t_Sketch = { counters: t_Vec_u8_Global }

type t_Pool = { lru: t_LruList; sketch: t_Sketch; access_count: UInt64.t; max_len: UInt64.t }

type t_Node = { key: UInt64.t; prev: t_Option_u32; next: t_Option_u32; active: bool }

constant const_MAX: UInt64.t = (18446744073709551615: UInt64.t)

function view_Vec_Node_Global (self: t_Vec_Node_Global) : Seq.seq t_Node

axiom view_Vec_Node_Global_spec:
  forall self: t_Vec_Node_Global [view_Vec_Node_Global self]. [%#svec] Seq.length (view_Vec_Node_Global self)
    <= UInt64.t'int const_MAX

function view_Vec_u32_Global (self: t_Vec_u32_Global) : Seq.seq UInt32.t

axiom view_Vec_u32_Global_spec:
  forall self: t_Vec_u32_Global [view_Vec_u32_Global self]. [%#svec] Seq.length (view_Vec_u32_Global self)
    <= UInt64.t'int const_MAX

predicate slots_accounted [#"/home/cornel/epo-proof-branch-20261002/components/eviction-policy-optimized/verif-creusot/src/lib.rs" 125 0 125 43] (l: t_LruList) =
  [%#slib'16] Seq.length (view_Vec_Node_Global l.nodes) = UInt64.t'int l.len + Seq.length (view_Vec_u32_Global l.free)

predicate slots_disjoint [#"/home/cornel/epo-proof-branch-20261002/components/eviction-policy-optimized/verif-creusot/src/lib.rs" 115 0 115 42] (l: t_LruList) =
  [%#slib'17] (forall k: int. 0 <= k /\ k < Seq.length (view_Vec_u32_Global l.free)
      -> not (Seq.get (view_Vec_Node_Global l.nodes) (UInt32.t'int (Seq.get (view_Vec_u32_Global l.free) k))).active)
  /\ (forall j: int, k: int. 0 <= j /\ j < k /\ k < Seq.length (view_Vec_u32_Global l.free)
    -> Seq.get (view_Vec_u32_Global l.free) j <> Seq.get (view_Vec_u32_Global l.free) k)

predicate inv [#"/home/cornel/epo-proof-branch-20261002/components/eviction-policy-optimized/verif-creusot/src/lib.rs" 94 0 94 31] (l: t_LruList) =
  [%#slib'15] UInt64.t'int l.len <= Seq.length (view_Vec_Node_Global l.nodes)
  /\ match l.head with
      | Some h -> UInt32.t'int h < Seq.length (view_Vec_Node_Global l.nodes)
      | None -> true
      end
  /\ match l.tail with
      | Some t -> UInt32.t'int t < Seq.length (view_Vec_Node_Global l.nodes)
      | None -> true
      end
  /\ (forall i: int. 0 <= i /\ i < Seq.length (view_Vec_Node_Global l.nodes)
      -> match (Seq.get (view_Vec_Node_Global l.nodes) i).next with
        | Some n -> UInt32.t'int n < Seq.length (view_Vec_Node_Global l.nodes)
        | None -> true
        end)
  /\ (forall i: int. 0 <= i /\ i < Seq.length (view_Vec_Node_Global l.nodes)
      -> match (Seq.get (view_Vec_Node_Global l.nodes) i).prev with
        | Some p -> UInt32.t'int p < Seq.length (view_Vec_Node_Global l.nodes)
        | None -> true
        end)
  /\ (forall k: int. 0 <= k /\ k < Seq.length (view_Vec_u32_Global l.free)
      -> UInt32.t'int (Seq.get (view_Vec_u32_Global l.free) k) < Seq.length (view_Vec_Node_Global l.nodes))
  /\ slots_accounted l /\ slots_disjoint l /\ Seq.length (view_Vec_Node_Global l.nodes) <= 4294967295

let arena_move_to_back (self_: MutBorrow.t t_LruList) (idx: UInt32.t) (return (x: ())) =
{[@stop_split] [@expl:arena_move_to_back requires] [%#slib'3] inv self_.current}
  any
  [ return (result: ()) ->
  {[@stop_split] [@expl:arena_move_to_back ensures] ([@stop_split] [@expl:arena_move_to_back ensures #0] [%#slib'4] UInt32.t'int idx
        >= Seq.length (view_Vec_Node_Global self_.current.nodes) -> self_.final = self_.current)
    /\ ([@stop_split] [@expl:arena_move_to_back ensures #1] [%#slib'5] not (Seq.get (view_Vec_Node_Global self_.current.nodes) (UInt32.t'int idx)).active
      -> self_.final = self_.current)
    /\ ([@stop_split] [@expl:arena_move_to_back ensures #2] [%#slib'6] self_.current.tail = Some idx
      -> self_.final = self_.current)
    /\ ([@stop_split] [@expl:arena_move_to_back ensures #3] [%#slib'7] UInt64.t'int self_.final.len
      = UInt64.t'int self_.current.len)
    /\ ([@stop_split] [@expl:arena_move_to_back ensures #4] [%#slib'8] Seq.length (view_Vec_Node_Global self_.final.nodes)
      = Seq.length (view_Vec_Node_Global self_.current.nodes))
    /\ ([@stop_split] [@expl:arena_move_to_back ensures #5] [%#slib'9] view_Vec_u32_Global self_.final.free
      = view_Vec_u32_Global self_.current.free)
    /\ ([@stop_split] [@expl:arena_move_to_back ensures #6] [%#slib'10] UInt32.t'int idx
          < Seq.length (view_Vec_Node_Global self_.current.nodes)
        /\ (Seq.get (view_Vec_Node_Global self_.current.nodes) (UInt32.t'int idx)).active
        /\ self_.current.tail <> Some idx -> self_.final.tail = Some idx)
    /\ ([@stop_split] [@expl:arena_move_to_back ensures #7] [%#slib'11] forall i: int. 0 <= i
          /\ i < Seq.length (view_Vec_Node_Global self_.current.nodes)
        -> (Seq.get (view_Vec_Node_Global self_.final.nodes) i).active
          = (Seq.get (view_Vec_Node_Global self_.current.nodes) i).active
        /\ (Seq.get (view_Vec_Node_Global self_.final.nodes) i).key
        = (Seq.get (view_Vec_Node_Global self_.current.nodes) i).key)
    /\ ([@stop_split] [@expl:arena_move_to_back ensures #8] [%#slib'12] UInt32.t'int idx
          < Seq.length (view_Vec_Node_Global self_.current.nodes)
        /\ (Seq.get (view_Vec_Node_Global self_.current.nodes) (UInt32.t'int idx)).active
        /\ self_.current.tail <> Some idx
        /\ (Seq.get (view_Vec_Node_Global self_.current.nodes) (UInt32.t'int idx)).prev = None
      -> self_.final.head = (Seq.get (view_Vec_Node_Global self_.current.nodes) (UInt32.t'int idx)).next)
    /\ ([@stop_split] [@expl:arena_move_to_back ensures #9] [%#slib'13] UInt32.t'int idx
          < Seq.length (view_Vec_Node_Global self_.current.nodes)
        /\ (Seq.get (view_Vec_Node_Global self_.current.nodes) (UInt32.t'int idx)).prev <> None
      -> self_.final.head = self_.current.head)
    /\ ([@stop_split] [@expl:arena_move_to_back ensures #10] [%#slib'14] inv self_.final)}
    (! return {result}) ]

predicate resolve_refmut_LruList [@inline:trivial] (_1: MutBorrow.t t_LruList) = _1.final = _1.current

meta "rewrite_def" predicate resolve_refmut_LruList

predicate resolve_refmut_Pool [@inline:trivial] (_1: MutBorrow.t t_Pool) = _1.final = _1.current

meta "rewrite_def" predicate resolve_refmut_Pool

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

