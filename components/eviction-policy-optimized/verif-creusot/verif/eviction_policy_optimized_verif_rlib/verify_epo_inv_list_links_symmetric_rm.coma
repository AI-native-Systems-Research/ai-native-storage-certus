let wf_remove_a (self_: MutBorrow.t t_LruList) (idx: UInt32.t) (return (x: ())) =
{[@stop_split] [@expl:wf_remove_a requires] ([@stop_split] [@expl:wf_remove_a requires #0] [%#slib'6] inv self_.current
    /\ wf self_.current)
  /\ ([@stop_split] [@expl:wf_remove_a requires #1] [%#slib'7] UInt32.t'int idx
    < Seq.length (view_Vec_Node_Global self_.current.nodes))
  /\ ([@stop_split] [@expl:wf_remove_a requires #2] [%#slib'8] (Seq.get (view_Vec_Node_Global self_.current.nodes) (UInt32.t'int idx)).active
    -> UInt64.t'int self_.current.len >= 1)
  /\ ([@stop_split] [@expl:wf_remove_a requires #3] [%#slib'9] (Seq.get (view_Vec_Node_Global self_.current.nodes) (UInt32.t'int idx)).active
    -> self_.current.tail <> None /\ self_.current.head <> None)
  /\ ([@stop_split] [@expl:wf_remove_a requires #4] [%#slib'10] Seq.length (view_Vec_u32_Global self_.current.free)
  < 4294967295)}
  any
  [ return (result: ()) -> {[@stop_split] [@expl:wf_remove_a ensures] [%#slib'11] links_sym self_.final
    /\ links_active self_.final /\ inactive_unlinked self_.final}
    (! return {result}) ]

