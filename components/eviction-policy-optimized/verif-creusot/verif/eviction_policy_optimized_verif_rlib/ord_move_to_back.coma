      a.head
    )
  /\ (forall j: int. 0 <= j /\ j < Seq.length (view_Vec_Node_Global a.nodes)
    -> (Seq.get (view_Vec_Node_Global b.nodes) j).key = (Seq.get (view_Vec_Node_Global a.nodes) j).key
    /\ (Seq.get (view_Vec_Node_Global b.nodes) j).active = (Seq.get (view_Vec_Node_Global a.nodes) j).active
    /\ (Seq.get (view_Vec_Node_Global b.nodes) j).next
      = (if is_slot a.tail j then
        Some idx
      else
        if j = UInt32.t'int idx then
          None
        else
          if is_slot (Seq.get (view_Vec_Node_Global a.nodes) (UInt32.t'int idx)).prev j then
            (Seq.get (view_Vec_Node_Global a.nodes) (UInt32.t'int idx)).next
          else
            (Seq.get (view_Vec_Node_Global a.nodes) j).next
        
      
      )
    /\ (Seq.get (view_Vec_Node_Global b.nodes) j).prev
    = (if j = UInt32.t'int idx then
      a.tail
    else
      if is_slot (Seq.get (view_Vec_Node_Global a.nodes) (UInt32.t'int idx)).next j then
        (Seq.get (view_Vec_Node_Global a.nodes) (UInt32.t'int idx)).prev
