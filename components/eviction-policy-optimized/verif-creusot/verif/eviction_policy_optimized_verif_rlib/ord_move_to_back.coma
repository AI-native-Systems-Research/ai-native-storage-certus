predicate mv_eff2 [#"/home/cornel/epo-creusot-correction/components/eviction-policy-optimized/verif-creusot/src/lib.rs" 4422 0 4422 58] (a: t_LruList) (b: t_LruList) (idx: UInt32.t) =
