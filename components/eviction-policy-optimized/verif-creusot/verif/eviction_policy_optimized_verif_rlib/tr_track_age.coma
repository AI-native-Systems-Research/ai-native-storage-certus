    /\ ([@stop_split] [@expl:max ensures #3] [%#scmp'2] deep_model_usize self_ <= deep_model_usize o -> result = o)
    /\ ([@stop_split] [@expl:max ensures #4] [%#scmp'3] deep_model_usize o < deep_model_usize self_ -> result = self_)}
    (! return {result}) ]

