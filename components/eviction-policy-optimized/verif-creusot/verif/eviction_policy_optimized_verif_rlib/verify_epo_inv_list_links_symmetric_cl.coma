let wf_clear (self_: MutBorrow.t t_LruList) (return (x: ())) = any
  [ return (result: ()) -> {[@stop_split] [@expl:wf_clear ensures] [%#slib'1] inv self_.final /\ wf self_.final}
    (! return {result}) ]

