let wf_push_back (self_: MutBorrow.t t_LruList) (key'0: UInt64.t) (return (x: UInt32.t)) =
{[@stop_split] [@expl:wf_push_back requires] ([@stop_split] [@expl:wf_push_back requires #0] [%#slib'3] inv self_.current
    /\ wf self_.current)
  /\ ([@stop_split] [@expl:wf_push_back requires #1] [%#slib'4] Seq.length (view_Vec_Node_Global self_.current.nodes)
  < 4294967295)}
  any
  [ return (result: UInt32.t) ->
  {[@stop_split] [@expl:wf_push_back ensures] ([@stop_split] [@expl:wf_push_back ensures #0] [%#slib'5] inv self_.final
      /\ wf self_.final)
    /\ ([@stop_split] [@expl:wf_push_back ensures #1] [%#slib'6] UInt64.t'int self_.final.len
      = UInt64.t'int self_.current.len + 1)
    /\ ([@stop_split] [@expl:wf_push_back ensures #2] [%#slib'7] self_.final.tail = Some result)
    /\ ([@stop_split] [@expl:wf_push_back ensures #3] [%#slib'8] self_.final.head <> None)
    /\ ([@stop_split] [@expl:wf_push_back ensures #4] [%#slib'9] UInt32.t'int result
      < Seq.length (view_Vec_Node_Global self_.final.nodes))
    /\ ([@stop_split] [@expl:wf_push_back ensures #5] [%#slib'10] (Seq.get (view_Vec_Node_Global self_.final.nodes) (UInt32.t'int result)).active)
    /\ ([@stop_split] [@expl:wf_push_back ensures #6] [%#slib'11] Seq.length (view_Vec_Node_Global self_.final.nodes)
      <= Seq.length (view_Vec_Node_Global self_.current.nodes) + 1)
    /\ ([@stop_split] [@expl:wf_push_back ensures #7] [%#slib'12] Seq.length (view_Vec_u32_Global self_.final.free)
    <= Seq.length (view_Vec_u32_Global self_.current.free))}
    (! return {result}) ]

predicate resolve_refmut_LruList [@inline:trivial] (_1: MutBorrow.t t_LruList) = _1.final = _1.current

