function view_Vec_u64_Global (self: t_Vec_u64_Global) : Seq.seq UInt64.t

axiom view_Vec_u64_Global_spec:
  forall self: t_Vec_u64_Global [view_Vec_u64_Global self]. [%#svec] Seq.length (view_Vec_u64_Global self)
    <= UInt64.t'int const_MAX

let state_candidates (self_: t_Pools) (pool: UInt32.t) (n: UInt64.t) (return (x: t_Vec_u64_Global)) =
{[@stop_split] [@expl:state_candidates requires] [%#slib'2] UInt32.t'int pool
    < Seq.length (view_Vec_Pool_Global self_.pools)
  -> inv (Seq.get (view_Vec_Pool_Global self_.pools) (UInt32.t'int pool)).lru}
  any
  [ return (result: t_Vec_u64_Global) ->
  {[@stop_split] [@expl:state_candidates ensures] ([@stop_split] [@expl:state_candidates ensures #0] [%#slib'3] Seq.length (view_Vec_u64_Global result)
      <= UInt64.t'int n)
    /\ ([@stop_split] [@expl:state_candidates ensures #1] [%#slib'4] UInt64.t'int n = 0
      -> Seq.length (view_Vec_u64_Global result) = 0)
    /\ ([@stop_split] [@expl:state_candidates ensures #2] [%#slib'5] UInt32.t'int pool
        >= Seq.length (view_Vec_Pool_Global self_.pools) -> Seq.length (view_Vec_u64_Global result) = 0)
    /\ ([@stop_split] [@expl:state_candidates ensures #3] [%#slib'6] UInt32.t'int pool
        < Seq.length (view_Vec_Pool_Global self_.pools)
      -> match (Seq.get (view_Vec_Pool_Global self_.pools) (UInt32.t'int pool)).lru.head with
        | Some hh -> UInt64.t'int n > 0
        -> Seq.length (view_Vec_u64_Global result) > 0
        /\ Seq.get (view_Vec_u64_Global result) 0
        = (Seq.get (view_Vec_Node_Global (Seq.get (view_Vec_Pool_Global self_.pools) (UInt32.t'int pool)).lru.nodes) (UInt32.t'int hh)).key
        | None -> Seq.length (view_Vec_u64_Global result) = 0
        end)
    /\ ([@stop_split] [@expl:state_candidates ensures #4] [%#slib'7] UInt32.t'int pool
      < Seq.length (view_Vec_Pool_Global self_.pools)
    -> match (Seq.get (view_Vec_Pool_Global self_.pools) (UInt32.t'int pool)).lru.head with
      | Some hh -> match (Seq.get (view_Vec_Node_Global (Seq.get (view_Vec_Pool_Global self_.pools) (UInt32.t'int pool)).lru.nodes) (UInt32.t'int hh)).next with
        | Some nx -> Seq.length (view_Vec_u64_Global result) >= 2
        -> Seq.get (view_Vec_u64_Global result) 1
        = (Seq.get (view_Vec_Node_Global (Seq.get (view_Vec_Pool_Global self_.pools) (UInt32.t'int pool)).lru.nodes) (UInt32.t'int nx)).key
        | None -> Seq.length (view_Vec_u64_Global result) < 2
        end
      | None -> true
      end)}
    (! return {result}) ]

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

