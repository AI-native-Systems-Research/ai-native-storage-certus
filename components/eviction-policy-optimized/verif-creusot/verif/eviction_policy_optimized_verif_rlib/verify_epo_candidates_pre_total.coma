use creusot.int.UInt32
use creusot.int.UInt64
use seq.Seq
use creusot.prelude.Any
use int.Int

type t_Vec_Pool_Global

type t_Pools = { pools: t_Vec_Pool_Global }

type t_Vec_u64_Global

type t_Vec_Node_Global

type t_Option_u32 = None | Some UInt32.t

type t_Vec_u32_Global

type t_LruList = {
  nodes: t_Vec_Node_Global;
  head: t_Option_u32;
  tail: t_Option_u32;
  free: t_Vec_u32_Global;
  len: UInt64.t }

type t_Vec_u8_Global

type t_Sketch = { counters: t_Vec_u8_Global }

type t_Pool = { lru: t_LruList; sketch: t_Sketch; access_count: UInt64.t; max_len: UInt64.t }

constant const_MAX: UInt64.t = (18446744073709551615: UInt64.t)

function view_Vec_Pool_Global (self: t_Vec_Pool_Global) : Seq.seq t_Pool

axiom view_Vec_Pool_Global_spec:
  forall self: t_Vec_Pool_Global [view_Vec_Pool_Global self]. [%#svec] Seq.length (view_Vec_Pool_Global self)
    <= UInt64.t'int const_MAX

type t_Node = { key: UInt64.t; prev: t_Option_u32; next: t_Option_u32; active: bool }

function view_Vec_Node_Global (self: t_Vec_Node_Global) : Seq.seq t_Node

axiom view_Vec_Node_Global_spec:
  forall self: t_Vec_Node_Global [view_Vec_Node_Global self]. [%#svec] Seq.length (view_Vec_Node_Global self)
    <= UInt64.t'int const_MAX

function view_Vec_u32_Global (self: t_Vec_u32_Global) : Seq.seq UInt32.t

axiom view_Vec_u32_Global_spec:
  forall self: t_Vec_u32_Global [view_Vec_u32_Global self]. [%#svec] Seq.length (view_Vec_u32_Global self)
    <= UInt64.t'int const_MAX

predicate slots_accounted [#"/home/cornel/cv-e2e-eviction-policy-optimized-20260925/components/eviction-policy-optimized/verif-creusot/src/lib.rs" 125 0 125 43] (l: t_LruList) =
  [%#slib'9] Seq.length (view_Vec_Node_Global l.nodes) = UInt64.t'int l.len + Seq.length (view_Vec_u32_Global l.free)

