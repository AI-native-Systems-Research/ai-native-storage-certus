        < Seq.length (view_Vec_Pool_Global self_.current.pools)
      -> pool_meta_eq (Seq.get (view_Vec_Pool_Global self_.final.pools) (UInt32.t'int pool)) (Seq.get (view_Vec_Pool_Global self_.current.pools) (UInt32.t'int pool)))
    /\ ([@stop_split] [@expl:state_evict ensures #4] [%#slib'7] UInt32.t'int pool
      < Seq.length (view_Vec_Pool_Global self_.current.pools)
    -> match (Seq.get (view_Vec_Pool_Global self_.current.pools) (UInt32.t'int pool)).lru.head with
      | Some hh -> result
        = Some'0 ((Seq.get (view_Vec_Node_Global (Seq.get (view_Vec_Pool_Global self_.current.pools) (UInt32.t'int pool)).lru.nodes) (UInt32.t'int hh)).key)
      /\ UInt64.t'int (Seq.get (view_Vec_Pool_Global self_.final.pools) (UInt32.t'int pool)).lru.len
        = UInt64.t'int (Seq.get (view_Vec_Pool_Global self_.current.pools) (UInt32.t'int pool)).lru.len - 1
      /\ not (Seq.get (view_Vec_Node_Global (Seq.get (view_Vec_Pool_Global self_.final.pools) (UInt32.t'int pool)).lru.nodes) (UInt32.t'int hh)).active
      | None -> result = None'0
      /\ Seq.get (view_Vec_Pool_Global self_.final.pools) (UInt32.t'int pool)
      = Seq.get (view_Vec_Pool_Global self_.current.pools) (UInt32.t'int pool)
      end)}
    (! return {result}) ]
