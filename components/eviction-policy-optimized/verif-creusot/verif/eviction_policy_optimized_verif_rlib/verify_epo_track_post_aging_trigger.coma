use creusot.prelude.MutBorrow
use creusot.int.UInt32
use creusot.int.UInt64
use seq.Seq
use creusot.int.UInt8
use int.ComputerDivision
use creusot.prelude.Any
use int.Int

type t_Vec_Node_Global

type t_Option_u32 = None | Some UInt32.t

type t_Vec_u32_Global

type t_LruList = {
  nodes: t_Vec_Node_Global;
  head: t_Option_u32;
  tail: t_Option_u32;
  free: t_Vec_u32_Global;
  len: UInt64.t }

type t_Vec_u8_Global

type t_Sketch = { counters: t_Vec_u8_Global }

type t_Pool = { lru: t_LruList; sketch: t_Sketch; access_count: UInt64.t; max_len: UInt64.t }

type t_Node = { key: UInt64.t; prev: t_Option_u32; next: t_Option_u32; active: bool }

constant const_MAX: UInt64.t = (18446744073709551615: UInt64.t)

function view_Vec_Node_Global (self: t_Vec_Node_Global) : Seq.seq t_Node

axiom view_Vec_Node_Global_spec:
  forall self: t_Vec_Node_Global [view_Vec_Node_Global self]. [%#svec] Seq.length (view_Vec_Node_Global self)
    <= UInt64.t'int const_MAX

function view_Vec_u32_Global (self: t_Vec_u32_Global) : Seq.seq UInt32.t

axiom view_Vec_u32_Global_spec:
  forall self: t_Vec_u32_Global [view_Vec_u32_Global self]. [%#svec] Seq.length (view_Vec_u32_Global self)
    <= UInt64.t'int const_MAX

predicate slots_accounted [#"/home/cornel/epo-creusot-correction/components/eviction-policy-optimized/verif-creusot/src/lib.rs" 125 0 125 43] (l: t_LruList) =
  [%#slib'18] Seq.length (view_Vec_Node_Global l.nodes) = UInt64.t'int l.len + Seq.length (view_Vec_u32_Global l.free)

predicate slots_disjoint [#"/home/cornel/epo-creusot-correction/components/eviction-policy-optimized/verif-creusot/src/lib.rs" 115 0 115 42] (l: t_LruList) =
  [%#slib'19] (forall k: int. 0 <= k /\ k < Seq.length (view_Vec_u32_Global l.free)
      -> not (Seq.get (view_Vec_Node_Global l.nodes) (UInt32.t'int (Seq.get (view_Vec_u32_Global l.free) k))).active)
  /\ (forall j: int, k: int. 0 <= j /\ j < k /\ k < Seq.length (view_Vec_u32_Global l.free)
    -> Seq.get (view_Vec_u32_Global l.free) j <> Seq.get (view_Vec_u32_Global l.free) k)

predicate inv [#"/home/cornel/epo-creusot-correction/components/eviction-policy-optimized/verif-creusot/src/lib.rs" 94 0 94 31] (l: t_LruList) =
  [%#slib'17] UInt64.t'int l.len <= Seq.length (view_Vec_Node_Global l.nodes)
  /\ match l.head with
      | Some h -> UInt32.t'int h < Seq.length (view_Vec_Node_Global l.nodes)
      | None -> true
      end
  /\ match l.tail with
      | Some t -> UInt32.t'int t < Seq.length (view_Vec_Node_Global l.nodes)
      | None -> true
      end
  /\ (forall i: int. 0 <= i /\ i < Seq.length (view_Vec_Node_Global l.nodes)
      -> match (Seq.get (view_Vec_Node_Global l.nodes) i).next with
        | Some n -> UInt32.t'int n < Seq.length (view_Vec_Node_Global l.nodes)
        | None -> true
        end)
  /\ (forall i: int. 0 <= i /\ i < Seq.length (view_Vec_Node_Global l.nodes)
      -> match (Seq.get (view_Vec_Node_Global l.nodes) i).prev with
        | Some p -> UInt32.t'int p < Seq.length (view_Vec_Node_Global l.nodes)
        | None -> true
        end)
  /\ (forall k: int. 0 <= k /\ k < Seq.length (view_Vec_u32_Global l.free)
      -> UInt32.t'int (Seq.get (view_Vec_u32_Global l.free) k) < Seq.length (view_Vec_Node_Global l.nodes))
  /\ slots_accounted l /\ slots_disjoint l /\ Seq.length (view_Vec_Node_Global l.nodes) <= 4294967295

function view_Vec_u8_Global (self: t_Vec_u8_Global) : Seq.seq UInt8.t

axiom view_Vec_u8_Global_spec:
  forall self: t_Vec_u8_Global [view_Vec_u8_Global self]. [%#svec] Seq.length (view_Vec_u8_Global self)
    <= UInt64.t'int const_MAX

predicate pool_inv [#"/home/cornel/epo-creusot-correction/components/eviction-policy-optimized/verif-creusot/src/lib.rs" 132 0 132 33] (p: t_Pool) =
  [%#slib'16] inv p.lru
  /\ UInt64.t'int p.max_len <= 4294967295 /\ Seq.length (view_Vec_u8_Global p.sketch.counters) = 4096

let pool_age_step (p: MutBorrow.t t_Pool) (return (x: bool)) =
{[@stop_split] [@expl:pool_age_step requires] ([@stop_split] [@expl:pool_age_step requires #0] [%#slib'5] pool_inv p.current)
  /\ ([@stop_split] [@expl:pool_age_step requires #1] [%#slib'6] UInt64.t'int p.current.access_count
  < 18446744073709551615)}
  any
  [ return (result: bool) ->
  {[@stop_split] [@expl:pool_age_step ensures] ([@stop_split] [@expl:pool_age_step ensures #0] [%#slib'7] UInt64.t'int p.final.max_len
      = (if UInt64.t'int p.current.lru.len > UInt64.t'int p.current.max_len then
        UInt64.t'int p.current.lru.len
      else
        UInt64.t'int p.current.max_len
      ))
    /\ ([@stop_split] [@expl:pool_age_step ensures #1] [%#slib'8] UInt64.t'int p.final.max_len
      >= UInt64.t'int p.current.max_len)
    /\ ([@stop_split] [@expl:pool_age_step ensures #2] [%#slib'9] UInt64.t'int p.final.access_count
      = UInt64.t'int p.current.access_count + 1)
    /\ ([@stop_split] [@expl:pool_age_step ensures #3] [%#slib'10] p.final.lru = p.current.lru)
    /\ ([@stop_split] [@expl:pool_age_step ensures #4] [%#slib'11] result
      = (UInt64.t'int p.final.max_len > 0
      /\ ComputerDivision.mod (UInt64.t'int p.final.access_count) (UInt64.t'int p.final.max_len * 10) = 0))
    /\ ([@stop_split] [@expl:pool_age_step ensures #5] [%#slib'12] not result
      -> view_Vec_u8_Global p.final.sketch.counters = view_Vec_u8_Global p.current.sketch.counters)
    /\ ([@stop_split] [@expl:pool_age_step ensures #6] [%#slib'13] forall j: int. 0 <= j /\ j < 4096
        -> UInt8.t'int (Seq.get (view_Vec_u8_Global p.final.sketch.counters) j)
        <= UInt8.t'int (Seq.get (view_Vec_u8_Global p.current.sketch.counters) j))
    /\ ([@stop_split] [@expl:pool_age_step ensures #7] [%#slib'14] Seq.length (view_Vec_u8_Global p.final.sketch.counters)
      = 4096)
    /\ ([@stop_split] [@expl:pool_age_step ensures #8] [%#slib'15] pool_inv p.final)}
    (! return {result}) ]

predicate resolve_refmut_Pool [@inline:trivial] (_1: MutBorrow.t t_Pool) = _1.final = _1.current

meta "rewrite_def" predicate resolve_refmut_Pool

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let verify_epo_track_post_aging_trigger [#"/home/cornel/epo-creusot-correction/components/eviction-policy-optimized/verif-creusot/src/lib.rs" 1162 0 1162 64]
  (p: MutBorrow.t t_Pool) (return (x: bool)) =
{[@stop_split] [@expl:verify_epo_track_post_aging_trigger requires] ([@stop_split] [@expl:verify_epo_track_post_aging_trigger requires #0] [%#slib'0] pool_inv p.current)
  /\ ([@stop_split] [@expl:verify_epo_track_post_aging_trigger requires #1] [%#slib'1] UInt64.t'int p.current.access_count
  < 18446744073709551615)}
  (! bb0
  [ bb0 = s0
    [ s0 = MutBorrow.borrow_final <t_Pool> {p.current} {MutBorrow.get_id p}
        (fun (_bor: MutBorrow.t t_Pool) -> [ &_12 <- _bor ] [ &p <- { p with current = _bor.final } ] s1)
    | s1 = pool_age_step [%#slib] {_12} (fun (_x: bool) -> [ &_ret <- _x ] s2)
    | s2 = -{resolve_refmut_Pool p}- s3
    | s3 = return {_ret} ] ]
  [ & _ret: bool = Any.any_l () | & p: MutBorrow.t t_Pool = p | & _12: MutBorrow.t t_Pool = Any.any_l () ])
  [ return (result: bool) ->
  {[@stop_split] [@expl:verify_epo_track_post_aging_trigger ensures] ([@stop_split] [@expl:verify_epo_track_post_aging_trigger ensures #0] [%#slib'2] result
      = (UInt64.t'int p.final.max_len > 0
      /\ ComputerDivision.mod (UInt64.t'int p.final.access_count) (UInt64.t'int p.final.max_len * 10) = 0))
    /\ ([@stop_split] [@expl:verify_epo_track_post_aging_trigger ensures #1] [%#slib'3] not result
      -> view_Vec_u8_Global p.final.sketch.counters = view_Vec_u8_Global p.current.sketch.counters)
    /\ ([@stop_split] [@expl:verify_epo_track_post_aging_trigger ensures #2] [%#slib'4] forall j: int. 0 <= j
        /\ j < 4096
      -> UInt8.t'int (Seq.get (view_Vec_u8_Global p.final.sketch.counters) j)
      <= UInt8.t'int (Seq.get (view_Vec_u8_Global p.current.sketch.counters) j))}
    (! return {result}) ]
