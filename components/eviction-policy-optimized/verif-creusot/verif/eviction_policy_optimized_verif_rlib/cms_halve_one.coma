let%span slib = "/home/cornel/epo-proof-branch-20261002/components/eviction-policy-optimized/verif-creusot/src/lib.rs" 514 13 514 14
let%span slib'0 = "/home/cornel/epo-proof-branch-20261002/components/eviction-policy-optimized/verif-creusot/src/lib.rs" 514 4 514 14
let%span slib'1 = "/home/cornel/epo-proof-branch-20261002/components/eviction-policy-optimized/verif-creusot/src/lib.rs" 512 10 512 27

use creusot.int.Int32BW
use creusot.int.UInt8BW
use creusot.prelude.Any
use int.Int

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let cms_halve_one [#"/home/cornel/epo-proof-branch-20261002/components/eviction-policy-optimized/verif-creusot/src/lib.rs" 513 0 513 37]
  (self_: UInt8BW.t) (return (x: UInt8BW.t)) = (! bb0
  [ bb0 = s0
    [ s0 = UInt8BW.shr [%#slib'0] {self_} {Int32BW.to_BV256 ([%#slib] (1: Int32BW.t))}
        (fun (_x: UInt8BW.t) -> [ &_ret <- _x ] s1)
    | s1 = return {_ret} ] ] [ & _ret: UInt8BW.t = Any.any_l () | & self_: UInt8BW.t = self_ ])
  [ return (result: UInt8BW.t) -> {[@stop_split] [@expl:cms_halve_one ensures] [%#slib'1] UInt8BW.t'int result
    <= UInt8BW.t'int self_}
    (! return {result}) ]
