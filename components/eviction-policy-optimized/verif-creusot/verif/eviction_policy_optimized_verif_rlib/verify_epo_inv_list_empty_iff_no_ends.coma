predicate tail_unique [#"/home/cornel/epo-proof-branch-20261002/components/eviction-policy-optimized/verif-creusot/src/lib.rs" 2418 0 2418 39] (l: t_LruList) =
  [%#slib'62] forall i: UInt32.t. UInt32.t'int i < Seq.length (view_Vec_Node_Global l.nodes)
      /\ (Seq.get (view_Vec_Node_Global l.nodes) (UInt32.t'int i)).active
    -> ((Seq.get (view_Vec_Node_Global l.nodes) (UInt32.t'int i)).next = None) = (l.tail = Some i)

predicate head_unique [#"/home/cornel/epo-proof-branch-20261002/components/eviction-policy-optimized/verif-creusot/src/lib.rs" 2427 0 2427 39] (l: t_LruList) =
  [%#slib'63] forall i: UInt32.t. UInt32.t'int i < Seq.length (view_Vec_Node_Global l.nodes)
      /\ (Seq.get (view_Vec_Node_Global l.nodes) (UInt32.t'int i)).active
    -> ((Seq.get (view_Vec_Node_Global l.nodes) (UInt32.t'int i)).prev = None) = (l.head = Some i)

predicate ends_active [#"/home/cornel/epo-proof-branch-20261002/components/eviction-policy-optimized/verif-creusot/src/lib.rs" 2436 0 2436 39] (l: t_LruList) =
  [%#slib'52] match l.head with
      | Some h -> UInt32.t'int h < Seq.length (view_Vec_Node_Global l.nodes)
      /\ (Seq.get (view_Vec_Node_Global l.nodes) (UInt32.t'int h)).active
      | None -> true
      end
  /\ match l.tail with
    | Some t -> UInt32.t'int t < Seq.length (view_Vec_Node_Global l.nodes)
    /\ (Seq.get (view_Vec_Node_Global l.nodes) (UInt32.t'int t)).active
