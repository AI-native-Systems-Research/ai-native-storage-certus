    end

predicate ends_both [#"/home/cornel/epo-proof-branch-20261002/components/eviction-policy-optimized/verif-creusot/src/lib.rs" 2467 0 2467 37] (l: t_LruList) =
  [%#slib'53] (l.head = None) = (l.tail = None)

predicate inactive_unlinked [#"/home/cornel/epo-proof-branch-20261002/components/eviction-policy-optimized/verif-creusot/src/lib.rs" 2445 0 2445 45] (l: t_LruList) =
  [%#slib'64] forall i: UInt32.t. UInt32.t'int i < Seq.length (view_Vec_Node_Global l.nodes)
