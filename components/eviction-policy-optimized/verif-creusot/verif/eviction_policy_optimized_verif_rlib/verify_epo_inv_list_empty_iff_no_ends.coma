let chain_remove (self_: MutBorrow.t t_LruList) (idx: UInt32.t) (return (x: ())) =
{[@stop_split] [@expl:chain_remove requires] ([@stop_split] [@expl:chain_remove requires #0] [%#slib'27] inv self_.current
    /\ wf self_.current)
  /\ ([@stop_split] [@expl:chain_remove requires #1] [%#slib'28] UInt32.t'int idx
    < Seq.length (view_Vec_Node_Global self_.current.nodes))
  /\ ([@stop_split] [@expl:chain_remove requires #2] [%#slib'29] (Seq.get (view_Vec_Node_Global self_.current.nodes) (UInt32.t'int idx)).active
    -> UInt64.t'int self_.current.len >= 1)
  /\ ([@stop_split] [@expl:chain_remove requires #3] [%#slib'30] (Seq.get (view_Vec_Node_Global self_.current.nodes) (UInt32.t'int idx)).active
    -> self_.current.tail <> None /\ self_.current.head <> None)
  /\ ([@stop_split] [@expl:chain_remove requires #4] [%#slib'31] Seq.length (view_Vec_u32_Global self_.current.free)
  < 4294967295)}
  any
  [ return (result: ()) ->
  {[@stop_split] [@expl:chain_remove ensures] ([@stop_split] [@expl:chain_remove ensures #0] [%#slib'32] ends_active self_.final
      /\ ends_both self_.final)
