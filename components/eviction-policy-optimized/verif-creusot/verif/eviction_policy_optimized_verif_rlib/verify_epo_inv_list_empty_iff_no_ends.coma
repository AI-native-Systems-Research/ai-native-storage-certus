  [%#slib'58] Seq.length (view_Vec_Node_Global l.nodes) = UInt64.t'int l.len + Seq.length (view_Vec_u32_Global l.free)

predicate slots_disjoint [#"/home/cornel/epo-proof-branch-20261002/components/eviction-policy-optimized/verif-creusot/src/lib.rs" 115 0 115 42] (l: t_LruList) =
  [%#slib'59] (forall k: int. 0 <= k /\ k < Seq.length (view_Vec_u32_Global l.free)
