  [%#slib'48] UInt64.t'int l.len <= Seq.length (view_Vec_Node_Global l.nodes)
  /\ match l.head with
      | Some h -> UInt32.t'int h < Seq.length (view_Vec_Node_Global l.nodes)
      | None -> true
      end
  /\ match l.tail with
      | Some t -> UInt32.t'int t < Seq.length (view_Vec_Node_Global l.nodes)
      | None -> true
      end
  /\ (forall i: int. 0 <= i /\ i < Seq.length (view_Vec_Node_Global l.nodes)
      -> match (Seq.get (view_Vec_Node_Global l.nodes) i).next with
        | Some n -> UInt32.t'int n < Seq.length (view_Vec_Node_Global l.nodes)
        | None -> true
