        end)
  /\ (forall k: int. 0 <= k /\ k < Seq.length (view_Vec_u32_Global l.free)
      -> UInt32.t'int (Seq.get (view_Vec_u32_Global l.free) k) < Seq.length (view_Vec_Node_Global l.nodes))
  /\ slots_accounted l /\ slots_disjoint l /\ Seq.length (view_Vec_Node_Global l.nodes) <= 4294967295

