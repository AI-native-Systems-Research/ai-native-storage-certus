    /\ ([@stop_split] [@expl:tr_remove ensures #2] [%#slib'16] (Seq.get (view_Vec_Node_Global self_.current.nodes) (UInt32.t'int idx)).active
    -> rm_eff self_.current self_.final idx)}
    (! return {result}) ]
