      = 4096)
    /\ ([@stop_split] [@expl:sketch_halve ensures #1] [%#slib'4] forall i: int. 0 <= i /\ i < 4096
      -> UInt8.t'int (Seq.get (view_Vec_u8_Global self_.final.counters) i)
      <= UInt8.t'int (Seq.get (view_Vec_u8_Global self_.current.counters) i))}
    (! return {result}) ]

predicate resolve_refmut_Sketch [@inline:trivial] (_1: MutBorrow.t t_Sketch) = _1.final = _1.current

meta "rewrite_def" predicate resolve_refmut_Sketch

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

