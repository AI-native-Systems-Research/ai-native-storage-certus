let pool_batch_touch (p: MutBorrow.t t_Pool) (idxs: t_Vec_u32_Global) (return (x: ())) =
{[@stop_split] [@expl:pool_batch_touch requires] ([@stop_split] [@expl:pool_batch_touch requires #0] [%#slib'5] inv p.current.lru)
  /\ ([@stop_split] [@expl:pool_batch_touch requires #1] [%#slib'6] forall k: int. 0 <= k
      /\ k < Seq.length (view_Vec_u32_Global idxs)
    -> UInt32.t'int (Seq.get (view_Vec_u32_Global idxs) k) < Seq.length (view_Vec_Node_Global p.current.lru.nodes))}
  any
  [ return (result: ()) ->
  {[@stop_split] [@expl:pool_batch_touch ensures] ([@stop_split] [@expl:pool_batch_touch ensures #0] [%#slib'7] UInt64.t'int p.final.lru.len
      = UInt64.t'int p.current.lru.len)
    /\ ([@stop_split] [@expl:pool_batch_touch ensures #1] [%#slib'8] Seq.length (view_Vec_Node_Global p.final.lru.nodes)
      = Seq.length (view_Vec_Node_Global p.current.lru.nodes))
    /\ ([@stop_split] [@expl:pool_batch_touch ensures #2] [%#slib'9] pool_meta_eq p.final p.current)
    /\ ([@stop_split] [@expl:pool_batch_touch ensures #3] [%#slib'10] inv p.final.lru)
    /\ ([@stop_split] [@expl:pool_batch_touch ensures #4] [%#slib'11] forall i: int. 0 <= i
        /\ i < Seq.length (view_Vec_Node_Global p.current.lru.nodes)
      -> (Seq.get (view_Vec_Node_Global p.final.lru.nodes) i).active
        = (Seq.get (view_Vec_Node_Global p.current.lru.nodes) i).active
      /\ (Seq.get (view_Vec_Node_Global p.final.lru.nodes) i).key
      = (Seq.get (view_Vec_Node_Global p.current.lru.nodes) i).key)}
    (! return {result}) ]

predicate resolve_refmut_Pool [@inline:trivial] (_1: MutBorrow.t t_Pool) = _1.final = _1.current

meta "rewrite_def" predicate resolve_refmut_Pool

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

