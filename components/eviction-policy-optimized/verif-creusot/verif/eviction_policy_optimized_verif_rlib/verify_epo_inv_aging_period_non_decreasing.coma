    /\ ([@stop_split] [@expl:pool_age_step ensures #1] [%#slib'13] UInt64.t'int p.final.max_len
      >= UInt64.t'int p.current.max_len)
    /\ ([@stop_split] [@expl:pool_age_step ensures #2] [%#slib'14] UInt64.t'int p.final.access_count
      = UInt64.t'int p.current.access_count + 1)
    /\ ([@stop_split] [@expl:pool_age_step ensures #3] [%#slib'15] p.final.lru = p.current.lru)
    /\ ([@stop_split] [@expl:pool_age_step ensures #4] [%#slib'16] result
      = (UInt64.t'int p.final.max_len > 0
      /\ ComputerDivision.mod (UInt64.t'int p.final.access_count) (UInt64.t'int p.final.max_len * 10) = 0))
    /\ ([@stop_split] [@expl:pool_age_step ensures #5] [%#slib'17] not result
      -> view_Vec_u8_Global p.final.sketch.counters = view_Vec_u8_Global p.current.sketch.counters)
    /\ ([@stop_split] [@expl:pool_age_step ensures #6] [%#slib'18] forall j: int. 0 <= j /\ j < 4096
        -> UInt8.t'int (Seq.get (view_Vec_u8_Global p.final.sketch.counters) j)
        <= UInt8.t'int (Seq.get (view_Vec_u8_Global p.current.sketch.counters) j))
    /\ ([@stop_split] [@expl:pool_age_step ensures #7] [%#slib'19] Seq.length (view_Vec_u8_Global p.final.sketch.counters)
