use creusot.prelude.MutBorrow
use creusot.int.UInt64
use creusot.int.UInt8
use seq.Seq
use creusot.prelude.Any
use int.Int

type t_Vec_u8_Global

constant const_MAX: UInt64.t = (18446744073709551615: UInt64.t)

function view_Vec_u8_Global (self: t_Vec_u8_Global) : Seq.seq UInt8.t

axiom view_Vec_u8_Global_spec:
  forall self: t_Vec_u8_Global [view_Vec_u8_Global self]. [%#svec] Seq.length (view_Vec_u8_Global self)
    <= UInt64.t'int const_MAX

type t_Sketch = { counters: t_Vec_u8_Global }

predicate in_bounds_usize [@inline:trivial] (self: UInt64.t) (seq: Seq.seq UInt8.t) =
  [%#sslice] UInt64.t'int self < Seq.length seq

meta "rewrite_def" predicate in_bounds_usize

predicate has_value_usize [@inline:trivial] (self: UInt64.t) (seq: Seq.seq UInt8.t) (out: UInt8.t) =
  [%#sslice'0] Seq.get seq (UInt64.t'int self) = out

meta "rewrite_def" predicate has_value_usize

let index_Vec_u8_Global (self_: t_Vec_u8_Global) (ix: UInt64.t) (return (x: UInt8.t)) =
{[@stop_split] [@expl:index requires] [%#svec'0] in_bounds_usize ix (view_Vec_u8_Global self_)}
  any
  [ return (result: UInt8.t) ->
  {[@stop_split] [@expl:index ensures] [%#svec'1] has_value_usize ix (view_Vec_u8_Global self_) result}
    (! return {result}) ]

let cms_halve_one (self_: UInt8.t) (return (x: UInt8.t)) = any
  [ return (result: UInt8.t) -> {[@stop_split] [@expl:cms_halve_one ensures] [%#slib'13] UInt8.t'int result
    <= UInt8.t'int self_}
    (! return {result}) ]

predicate resolve_elswhere_usize [@inline:trivial] (self: UInt64.t) (old': Seq.seq UInt8.t) (fin: Seq.seq UInt8.t) =
  [%#sslice'1] forall i: int. 0 <= i /\ i <> UInt64.t'int self /\ i < Seq.length old' -> Seq.get old' i = Seq.get fin i

meta "rewrite_def" predicate resolve_elswhere_usize

let index_mut_Vec_u8_Global (self_: MutBorrow.t t_Vec_u8_Global) (ix: UInt64.t) (return (x: MutBorrow.t UInt8.t)) =
{[@stop_split] [@expl:index_mut requires] [%#svec'2] in_bounds_usize ix (view_Vec_u8_Global self_.current)}
  any
  [ return (result: MutBorrow.t UInt8.t) ->
  {[@stop_split] [@expl:index_mut_Vec_u8_Global ensures] ([@stop_split] [@expl:index_mut ensures #0] [%#svec'3] has_value_usize ix (view_Vec_u8_Global self_.current) result.current)
    /\ ([@stop_split] [@expl:index_mut ensures #1] [%#svec'4] has_value_usize ix (view_Vec_u8_Global self_.final) result.final)
    /\ ([@stop_split] [@expl:index_mut ensures #2] [%#svec'5] resolve_elswhere_usize ix (view_Vec_u8_Global self_.current) (view_Vec_u8_Global self_.final))
    /\ ([@stop_split] [@expl:index_mut ensures #3] [%#svec'6] Seq.length (view_Vec_u8_Global self_.final)
    = Seq.length (view_Vec_u8_Global self_.current))}
    (! return {result}) ]

predicate resolve_refmut_u8 [@inline:trivial] (_1: MutBorrow.t UInt8.t) = _1.final = _1.current

meta "rewrite_def" predicate resolve_refmut_u8

predicate resolve_refmut_Sketch [@inline:trivial] (_1: MutBorrow.t t_Sketch) = _1.final = _1.current

meta "rewrite_def" predicate resolve_refmut_Sketch

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

