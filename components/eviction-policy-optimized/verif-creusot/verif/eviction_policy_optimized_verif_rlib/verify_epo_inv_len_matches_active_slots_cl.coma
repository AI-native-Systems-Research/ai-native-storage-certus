let wf_clear (self_: MutBorrow.t t_LruList) (return (x: ())) = any
  [ return (result: ()) -> {[@stop_split] [@expl:wf_clear ensures] [%#slib'1] inv self_.final /\ wf self_.final}
    (! return {result}) ]

predicate resolve_refmut_LruList [@inline:trivial] (_1: MutBorrow.t t_LruList) = _1.final = _1.current

meta "rewrite_def" predicate resolve_refmut_LruList

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let verify_epo_inv_len_matches_active_slots_cl [#"/home/cornel/cv-e2e-eviction-policy-optimized-20260925/components/eviction-policy-optimized/verif-creusot/src/lib.rs" 2817 0 2817 66]
