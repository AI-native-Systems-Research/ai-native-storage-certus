  [ bb0 = s0
    [ s0 = MutBorrow.borrow_final <t_LruList> {l.current} {MutBorrow.get_id l}
        (fun (_bor: MutBorrow.t t_LruList) -> [ &_4 <- _bor ] [ &l <- { l with current = _bor.final } ] s1)
    | s1 = wf_clear [%#slib] {_4} (fun (_x: ()) -> [ &_ret <- _x ] s2)
    | s2 = -{resolve_refmut_LruList l}- s3
    | s3 = return {_ret} ] ]
  [ & _ret: () = Any.any_l () | & l: MutBorrow.t t_LruList = l | & _4: MutBorrow.t t_LruList = Any.any_l () ])
  [ return (result: ()) ->
  {[@stop_split] [@expl:verify_epo_inv_len_matches_active_slots_cl ensures] [%#slib'0] free_covers_inactive l.final
    /\ slots_disjoint l.final /\ slots_accounted l.final}
    (! return {result}) ]
