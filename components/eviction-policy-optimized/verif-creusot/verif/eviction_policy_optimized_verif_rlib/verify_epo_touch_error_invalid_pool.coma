let state_touch (self_: MutBorrow.t t_Pools) (h: t_Handle) (return (x: t_Result_unit_PolicyError)) =
{[@stop_split] [@expl:state_touch requires] [%#slib'3] UInt32.t'int h.pool
    < Seq.length (view_Vec_Pool_Global self_.current.pools)
  -> inv (Seq.get (view_Vec_Pool_Global self_.current.pools) (UInt32.t'int h.pool)).lru}
  any
  [ return (result: t_Result_unit_PolicyError) ->
  {[@stop_split] [@expl:state_touch ensures] ([@stop_split] [@expl:state_touch ensures #0] [%#slib'4] Seq.length (view_Vec_Pool_Global self_.final.pools)
      = Seq.length (view_Vec_Pool_Global self_.current.pools))
    /\ ([@stop_split] [@expl:state_touch ensures #1] [%#slib'5] UInt32.t'int h.pool
        >= Seq.length (view_Vec_Pool_Global self_.current.pools)
      -> self_.final = self_.current /\ result = Err (InvalidPool (h.pool)))
    /\ ([@stop_split] [@expl:state_touch ensures #2] [%#slib'6] UInt32.t'int h.pool
        < Seq.length (view_Vec_Pool_Global self_.current.pools)
      -> pools_frame_except self_.final self_.current (UInt32.t'int h.pool))
    /\ ([@stop_split] [@expl:state_touch ensures #3] [%#slib'7] UInt32.t'int h.pool
      < Seq.length (view_Vec_Pool_Global self_.current.pools)
    -> match result with
      | Ok _ -> UInt64.t'int (Seq.get (view_Vec_Pool_Global self_.final.pools) (UInt32.t'int h.pool)).lru.len
        = UInt64.t'int (Seq.get (view_Vec_Pool_Global self_.current.pools) (UInt32.t'int h.pool)).lru.len
      /\ pool_meta_eq (Seq.get (view_Vec_Pool_Global self_.final.pools) (UInt32.t'int h.pool)) (Seq.get (view_Vec_Pool_Global self_.current.pools) (UInt32.t'int h.pool))
      /\ inv (Seq.get (view_Vec_Pool_Global self_.final.pools) (UInt32.t'int h.pool)).lru
      /\ Seq.length (view_Vec_Node_Global (Seq.get (view_Vec_Pool_Global self_.final.pools) (UInt32.t'int h.pool)).lru.nodes)
        = Seq.length (view_Vec_Node_Global (Seq.get (view_Vec_Pool_Global self_.current.pools) (UInt32.t'int h.pool)).lru.nodes)
      /\ (UInt32.t'int h.index
          >= Seq.length (view_Vec_Node_Global (Seq.get (view_Vec_Pool_Global self_.current.pools) (UInt32.t'int h.pool)).lru.nodes)
        -> Seq.get (view_Vec_Pool_Global self_.final.pools) (UInt32.t'int h.pool)
        = Seq.get (view_Vec_Pool_Global self_.current.pools) (UInt32.t'int h.pool))
      /\ (UInt32.t'int h.index
          < Seq.length (view_Vec_Node_Global (Seq.get (view_Vec_Pool_Global self_.current.pools) (UInt32.t'int h.pool)).lru.nodes)
        /\ (Seq.get (view_Vec_Node_Global (Seq.get (view_Vec_Pool_Global self_.current.pools) (UInt32.t'int h.pool)).lru.nodes) (UInt32.t'int h.index)).active
        /\ (Seq.get (view_Vec_Pool_Global self_.current.pools) (UInt32.t'int h.pool)).lru.tail <> Some (h.index)
      -> (Seq.get (view_Vec_Pool_Global self_.final.pools) (UInt32.t'int h.pool)).lru.tail = Some (h.index))
      | Err _ -> false
      end)}
    (! return {result}) ]

predicate resolve_refmut_Pools [@inline:trivial] (_1: MutBorrow.t t_Pools) = _1.final = _1.current

meta "rewrite_def" predicate resolve_refmut_Pools

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

