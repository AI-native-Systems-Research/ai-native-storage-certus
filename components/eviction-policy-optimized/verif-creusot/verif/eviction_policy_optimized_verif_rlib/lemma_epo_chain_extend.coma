use creusot.int.UInt64
use creusot.int.UInt32
use seq.Seq
use int.Int

type t_Option_u32 = None | Some UInt32.t

type t_Node = { key: UInt64.t; prev: t_Option_u32; next: t_Option_u32; active: bool }

function chain_len [#"/home/cornel/epo-proof-branch-20261002/components/eviction-policy-optimized/verif-creusot/src/lib.rs" 3024 0 3024 70] (nodes: Seq.seq t_Node) (cur: t_Option_u32) (fuel: int) : int

axiom chain_len_def:
  forall nodes: Seq.seq t_Node, cur: t_Option_u32, fuel: int [chain_len nodes cur fuel]. ([%#slib'9] fuel >= 0)
    -> chain_len nodes cur fuel
    = ([%#slib'10] if fuel <= 0 then
      0
    else
      match cur with
        | None -> 0
        | Some c -> if UInt32.t'int c < Seq.length nodes then
          1 + chain_len nodes (Seq.get nodes (UInt32.t'int c)).next (fuel - 1)
        else
          0
        
        end
    )

predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
  [%#swell_founded] self >= 0 /\ self > other

meta "rewrite_def" predicate well_founded_relation_Int

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant a : Seq.seq t_Node

constant b : Seq.seq t_Node

constant cur : t_Option_u32

constant t : UInt32.t

constant new : UInt32.t

constant fuel : int

function lemma_epo_chain_extend [#"/home/cornel/epo-proof-branch-20261002/components/eviction-policy-optimized/verif-creusot/src/lib.rs" 3155 0 3156 40] (a: Seq.seq t_Node) (b: Seq.seq t_Node) (cur: t_Option_u32) (t: UInt32.t) (new: UInt32.t) (fuel: int) : ()

goal vc_lemma_epo_chain_extend: ([%#slib'0] fuel >= 0)
  -> ([%#slib'1] Seq.length a <= Seq.length b)
  -> ([%#slib'2] UInt32.t'int t < Seq.length a
    /\ (Seq.get a (UInt32.t'int t)).next = None /\ (Seq.get b (UInt32.t'int t)).next = Some new)
  -> ([%#slib'3] UInt32.t'int new < Seq.length b /\ (Seq.get b (UInt32.t'int new)).next = None)
  -> ([%#slib'4] forall i: int. 0 <= i /\ i < Seq.length a /\ i <> UInt32.t'int t
      -> (Seq.get a i).next = (Seq.get b i).next)
  -> ([%#slib'5] forall i: UInt32.t. UInt32.t'int i < Seq.length a /\ (Seq.get a (UInt32.t'int i)).active
      -> match (Seq.get a (UInt32.t'int i)).next with
        | Some n -> UInt32.t'int n < Seq.length a /\ (Seq.get a (UInt32.t'int n)).active
        | None -> i = t
        end)
  -> ([%#slib'6] match cur with
      | Some c -> UInt32.t'int c < Seq.length a /\ (Seq.get a (UInt32.t'int c)).active
      | None -> true
      end)
  -> (if fuel <= 0 then
    [@stop_split] [@expl:lemma_epo_chain_extend ensures] [%#slib'7] match cur with
      | Some _ -> chain_len b cur (fuel + 1) = chain_len a cur fuel + 1
      | None -> true
      end
  else
    match cur with
      | None -> [@stop_split] [@expl:lemma_epo_chain_extend ensures] [%#slib'7] match cur with
        | Some _ -> chain_len b cur (fuel + 1) = chain_len a cur fuel + 1
        | None -> true
        end
      | Some c -> if c = t then
        [@stop_split] [@expl:lemma_epo_chain_extend ensures] [%#slib'7] match cur with
          | Some _ -> chain_len b cur (fuel + 1) = chain_len a cur fuel + 1
          | None -> true
          end
      else
        (([@stop_split] [@expl:lemma_epo_chain_extend requires] ([@stop_split] [@expl:lemma_epo_chain_extend requires #0] [%#slib'0] fuel
                - 1
              >= 0)
            /\ ([@stop_split] [@expl:lemma_epo_chain_extend requires #1] [%#slib'1] Seq.length a <= Seq.length b)
            /\ ([@stop_split] [@expl:lemma_epo_chain_extend requires #2] [%#slib'2] UInt32.t'int t < Seq.length a
              /\ (Seq.get a (UInt32.t'int t)).next = None /\ (Seq.get b (UInt32.t'int t)).next = Some new)
            /\ ([@stop_split] [@expl:lemma_epo_chain_extend requires #3] [%#slib'3] UInt32.t'int new < Seq.length b
              /\ (Seq.get b (UInt32.t'int new)).next = None)
            /\ ([@stop_split] [@expl:lemma_epo_chain_extend requires #4] [%#slib'4] forall i: int. 0 <= i
                  /\ i < Seq.length a /\ i <> UInt32.t'int t -> (Seq.get a i).next = (Seq.get b i).next)
            /\ ([@stop_split] [@expl:lemma_epo_chain_extend requires #5] [%#slib'5] forall i: UInt32.t. UInt32.t'int i
                    < Seq.length a
                  /\ (Seq.get a (UInt32.t'int i)).active
                -> match (Seq.get a (UInt32.t'int i)).next with
                  | Some n -> UInt32.t'int n < Seq.length a /\ (Seq.get a (UInt32.t'int n)).active
                  | None -> i = t
                  end)
            /\ ([@stop_split] [@expl:lemma_epo_chain_extend requires #6] [%#slib'6] match (Seq.get a (UInt32.t'int c)).next with
              | Some c'0 -> UInt32.t'int c'0 < Seq.length a /\ (Seq.get a (UInt32.t'int c'0)).active
              | None -> true
              end))
          /\ ([@expl:variant decreases] well_founded_relation_Int ([%#slib] fuel) ([%#slib] fuel - 1)))
        /\ (([@stop_split] [@expl:lemma_epo_chain_extend ensures] [%#slib'7] match (Seq.get a (UInt32.t'int c)).next with
            | Some _ -> chain_len b (Seq.get a (UInt32.t'int c)).next (fuel - 1 + 1)
            = chain_len a (Seq.get a (UInt32.t'int c)).next (fuel - 1) + 1
            | None -> true
            end)
        -> ([@stop_split] [@expl:lemma_epo_chain_extend ensures] [%#slib'7] match cur with
          | Some _ -> chain_len b cur (fuel + 1) = chain_len a cur fuel + 1
          | None -> true
          end))
      
      end
  )
