use creusot.int.UInt32
use creusot.int.UInt64
use seq.Seq
use creusot.prelude.Any
use int.Int

type t_Vec_Pool_Global

type t_Pools = { pools: t_Vec_Pool_Global }

type t_Vec_Node_Global

type t_Option_u32 = None | Some UInt32.t

type t_Vec_u32_Global

type t_LruList = {
  nodes: t_Vec_Node_Global;
  head: t_Option_u32;
  tail: t_Option_u32;
  free: t_Vec_u32_Global;
  len: UInt64.t }

type t_Vec_u8_Global

type t_Sketch = { counters: t_Vec_u8_Global }

type t_Pool = { lru: t_LruList; sketch: t_Sketch; access_count: UInt64.t; max_len: UInt64.t }

constant const_MAX: UInt64.t = (18446744073709551615: UInt64.t)

function view_Vec_Pool_Global (self: t_Vec_Pool_Global) : Seq.seq t_Pool

axiom view_Vec_Pool_Global_spec:
  forall self: t_Vec_Pool_Global [view_Vec_Pool_Global self]. [%#svec] Seq.length (view_Vec_Pool_Global self)
    <= UInt64.t'int const_MAX

let state_len (self_: t_Pools) (pool: UInt32.t) (return (x: UInt64.t)) = any
  [ return (result: UInt64.t) ->
  {[@stop_split] [@expl:state_len ensures] ([@stop_split] [@expl:state_len ensures #0] [%#slib'2] UInt32.t'int pool
        >= Seq.length (view_Vec_Pool_Global self_.pools) -> UInt64.t'int result = 0)
    /\ ([@stop_split] [@expl:state_len ensures #1] [%#slib'3] UInt32.t'int pool
      < Seq.length (view_Vec_Pool_Global self_.pools)
    -> UInt64.t'int result = UInt64.t'int (Seq.get (view_Vec_Pool_Global self_.pools) (UInt32.t'int pool)).lru.len)}
    (! return {result}) ]

