  | & _13: UInt8.t = Any.any_l () ])
  [ return (result: t_Option_LogLevel) ->
  {[@stop_split] [@expl:log_core ensures] ([@stop_split] [@expl:log_core ensures #0] [%#slib'1] rk level > rk threshold
      -> result = None)
    /\ ([@stop_split] [@expl:log_core ensures #1] [%#slib'2] rk level <= rk threshold -> result = Some level)}
