type t_LogLevel = Error | Warn | Info | Debug

function rk [#"/home/cornel/logger-verify-20260921/components/logger/verif-creusot/src/lib.rs" 53 0 53 29] (l: t_LogLevel) : int
 = [%#slib'4] match l with
    | Error -> 0
    | Warn -> 1
    | Info -> 2
    | Debug -> 3
    end

let rank (l: t_LogLevel) (return (x: UInt8.t)) = any
  [ return (result: UInt8.t) -> {[@stop_split] [@expl:rank ensures] [%#slib'3] UInt8.t'int result = rk l}
    (! return {result}) ]

type t_Option_LogLevel = None | Some t_LogLevel

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let log_core [#"/home/cornel/logger-verify-20260921/components/logger/verif-creusot/src/lib.rs" 106 0 106 69]
  (level: t_LogLevel) (threshold: t_LogLevel) (return (x: t_Option_LogLevel)) = (! bb0
