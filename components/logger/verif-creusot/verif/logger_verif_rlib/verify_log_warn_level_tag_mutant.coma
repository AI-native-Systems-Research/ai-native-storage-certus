use creusot.prelude.Any
use int.Int

type t_LogLevel = Error | Warn | Info | Debug

type t_Option_LogLevel = None | Some t_LogLevel

function rk [#"/home/cornel/logger-verify-20260921/components/logger/verif-creusot/src/lib.rs" 53 0 53 29] (l: t_LogLevel) : int
 = [%#slib'4] match l with
    | Error -> 0
    | Warn -> 1
    | Info -> 2
    | Debug -> 3
    end

let log_core (level: t_LogLevel) (threshold: t_LogLevel) (return (x: t_Option_LogLevel)) = any
  [ return (result: t_Option_LogLevel) ->
  {[@stop_split] [@expl:log_core ensures] ([@stop_split] [@expl:log_core ensures #0] [%#slib'2] rk level > rk threshold
      -> result = None)
    /\ ([@stop_split] [@expl:log_core ensures #1] [%#slib'3] rk level <= rk threshold -> result = Some level)}
    (! return {result}) ]

meta "compute_max_steps" 1000000

