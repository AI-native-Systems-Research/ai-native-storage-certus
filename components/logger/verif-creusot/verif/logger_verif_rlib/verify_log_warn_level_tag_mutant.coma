    | s2 = return {_ret} ] ]
  [ & _ret: t_Option_LogLevel = Any.any_l () | & threshold: t_LogLevel = threshold | & _5: t_LogLevel = Any.any_l () ])
  [ return (result: t_Option_LogLevel) ->
  {[@stop_split] [@expl:verify_log_warn_level_tag__mutant ensures] ([@stop_split] [@expl:verify_log_warn_level_tag__mutant ensures #0] [%#slib'0] forall l: t_LogLevel. result
