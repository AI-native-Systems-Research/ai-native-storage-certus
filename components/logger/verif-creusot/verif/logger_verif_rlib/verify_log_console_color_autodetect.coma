use creusot.prelude.Any

type t_LogLevel = Error | Warn | Info | Debug

type t_Option_LogLevel = None | Some t_LogLevel

type t_WriterKind = Stderr | File

type t_StateM = { writer: t_WriterKind; level: t_LogLevel; use_color: bool }

let state_default_m (is_tty: bool) (var': t_Option_LogLevel) (return (x: t_StateM)) = any
  [ return (result: t_StateM) ->
  {[@stop_split] [@expl:state_default_m ensures] ([@stop_split] [@expl:state_default_m ensures #0] [%#slib'1] result.writer
      = Stderr)
    /\ ([@stop_split] [@expl:state_default_m ensures #1] [%#slib'2] result.use_color = is_tty)
    /\ ([@stop_split] [@expl:state_default_m ensures #2] [%#slib'3] var' = None -> result.level = Info)
    /\ ([@stop_split] [@expl:state_default_m ensures #3] [%#slib'4] forall l: t_LogLevel. var' = Some l
      -> result.level = l)}
    (! return {result}) ]

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let verify_log_console_color_autodetect [#"/home/cornel/logger-verify-20260921/components/logger/verif-creusot/src/lib.rs" 280 0 280 87]
  (is_tty: bool) (var': t_Option_LogLevel) (return (x: bool)) = (! bb0
  [ bb0 = s0
    [ s0 = state_default_m [%#slib] {is_tty} {var'} (fun (_x: t_StateM) -> [ &_5 <- _x ] s1)
    | s1 = [ &_ret <- _5.use_color ] s2
    | s2 = return {_ret} ] ]
  [ & _ret: bool = Any.any_l ()
  | & is_tty: bool = is_tty
  | & var': t_Option_LogLevel = var'
  | & _5: t_StateM = Any.any_l () ])
  [ return (result: bool) -> {[@stop_split] [@expl:verify_log_console_color_autodetect ensures] [%#slib'0] result
    = is_tty}
    (! return {result}) ]
