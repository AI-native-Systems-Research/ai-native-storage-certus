# Build context exclusions for certus-shmq-connector/Dockerfile (built from the
# repo root). SPDK is cloned/built inside the image, so exclude any local copy;
# exclude Rust target/ and .git to keep the context small.
.git/
target/
deps/spdk/
deps/spdk-build/
**/__pycache__/
**/*.pyc
**/.pytest_cache/
**/node_modules/
**/*.egg-info/
