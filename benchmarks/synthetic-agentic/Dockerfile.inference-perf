# inference-perf synthetic_agentic client image (WORKLOAD side; backend-agnostic).
#
# A pure HTTP load generator: it drives an OpenAI-compatible endpoint and never
# knows which KV connector the server runs. Point it at any server with
# -e BASE_URL=http://<host>:<port> . The KV backend is chosen on the SERVER
# (serve_vllm.sh), not here.
#
# Build (context = this directory):
#   podman build -f Dockerfile.inference-perf -t synthetic-agentic-client:latest .
#
# Run a workload against an already-running server (host networking so localhost
# reaches a --network host vLLM server):
#   podman run --rm --network host \
#       -e BASE_URL=http://localhost:8000 -e MODEL=NousResearch/Meta-Llama-3-8B \
#       -v $HOME/.cache/huggingface:/root/.cache/huggingface:z \
#       -v $PWD/results:/results:z \
#       synthetic-agentic-client:latest run
#
# Dump the deterministic replay graph for session 0 (offline inspection/audit):
#   podman run --rm -e MODEL=... -e SESSION_INDEX=0 \
#       -v $PWD/results:/results:z synthetic-agentic-client:latest generate

FROM docker.io/library/python:3.12-slim

# envsubst (config templating) + git (pip install from the fork branch).
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends gettext-base git curl ca-certificates; \
    rm -rf /var/lib/apt/lists/*

# The lenadankin fork adds the synthetic_agentic data generator + the
# synthetic_agentic_to_replay_graph offline tool on this branch.
ARG INFERENCE_PERF_REF=synthetic_data_enabled
ARG INFERENCE_PERF_REPO=https://github.com/lenadankin/inference-perf
RUN pip install --no-cache-dir "git+${INFERENCE_PERF_REPO}@${INFERENCE_PERF_REF}"

COPY configs/synthetic_agentic.yaml /config/synthetic_agentic.yaml
COPY docker-entrypoint-inference-perf.sh /usr/local/bin/inference-perf-entrypoint
RUN chmod +x /usr/local/bin/inference-perf-entrypoint

# HF cache for the tokenizer (mount the host cache to avoid a download). Offline
# by default; unset HF_HUB_OFFLINE at run time if the tokenizer isn't cached.
ENV PYTHONUNBUFFERED=1 \
    HF_HUB_OFFLINE=1 \
    CONFIG_TMPL=/config/synthetic_agentic.yaml \
    RESULTS_DIR=/results \
    MODEL=NousResearch/Meta-Llama-3-8B \
    BASE_URL=http://localhost:8000

ENTRYPOINT ["/usr/local/bin/inference-perf-entrypoint"]
CMD ["run"]
