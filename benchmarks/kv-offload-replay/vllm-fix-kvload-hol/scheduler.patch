+    def _certus_front_finished_kv_loads(self) -> None:
+        """certus fix (cputier wedge on vLLM 0.30, 2026-11-20).
+
+        Move WAITING_FOR_REMOTE_KVS requests whose async KV load has finished to
+        the front of skipped_waiting, which FCFS selection reads first, so the
+        waiting loop promotes and schedules them before admitting anything new.
+
+        Without this, a circular wait with 0 running requests is possible:
+          * the queue head is an async-load admission; allocate_slots() is given
+            reserved_blocks = _inflight_prefill_reserved_blocks(), which still
+            counts the remaining blocks of the finished loads;
+          * the head does not fit, allocate_slots() returns None, the loop
+            `break`s before reaching the finished loads queued behind it;
+          * the finished loads are never promoted or run, so their reservation
+            and the KV blocks they hold are never released.
+        """
+        ready = [
+            req
+            for queue in (self.skipped_waiting, self.waiting)
+            for req in queue
+            if req.status == RequestStatus.WAITING_FOR_REMOTE_KVS
+            and req.request_id in self.finished_recving_kv_req_ids
+        ]
+        if not ready:
+            return
+        ready_set = set(ready)
+        order = list(self.skipped_waiting) + list(self.waiting)
+        if all(req in ready_set for req in order[: len(ready)]):
+            return  # already at the front
+        self.skipped_waiting.remove_requests(ready_set)
+        self.waiting.remove_requests(ready_set)
+        for req in reversed(ready):  # keep their relative order
+            self.skipped_waiting.prepend_request(req)
+        self._certus_fronted_total = getattr(self, "_certus_fronted_total", 0) + len(ready)
+        logger.info(
+            "[certus-fix] moved %d finished-KV-load request(s) ahead of %d other "
+            "waiting request(s) (total moved: %d)",
+            len(ready),
+            len(order) - len(ready),
+            self._certus_fronted_total,
+        )
+
