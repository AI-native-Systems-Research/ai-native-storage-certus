# vLLM workload-driver image for the native Tiering CPU+FS KV backend.
#
# This is the in-tree replacement for the SharedStorage (llmd_fs_backend)
# backend, which no longer builds on vLLM 0.26.0 (upstream removed
# vllm.v1.kv_offload.abstract). It uses vLLM 0.26's native multi-tier framework:
# OffloadingConnector -> TieringOffloadingSpec with a CPU (host-RAM) primary
# tier plus an "fs" disk secondary tier (FileSystemTierManager). Like the
# cpu-offload image it is SELF-CONTAINED: a single vLLM process, no separate
# server, no shmq mailbox, no CUDA IPC.
#
# Unlike certus-cpu-offload-bench, the tiering driver config is BAKED IN here
# (DISK_DIR is set), so it runs the CPU+FS path purely from the image with no
# host driver bind-mount. It runs the same 450-conversation / 12-turn ShareGPT
# workload as the other backends, for head-to-head comparison.
#
# Build (context = repo root — needs benchmarks/kv-offload-replay/ + the dataset):
#   podman build -f benchmarks/kv-offload-replay/Dockerfile.cputier \
#       --build-arg VLLM_VERSION=0.26.0 -t certus-cputier-bench .
#
# Run (GPU required; the CPU tier is a /dev/shm mmap so pass --shm-size >=
# CPU_BYTES, and bind a host dir for the fs disk tier so it persists to disk):
#   podman run --rm --device nvidia.com/gpu=all \
#       --shm-size 36g \
#       -v /mnt/certus1/hf-cache:/root/.cache/huggingface:z \
#       -v /mnt/certus1/kv-fs-tier:/workspace/kv-fs-tier:z \
#       certus-cputier-bench
#   # docker equivalent: --gpus all

# Tiering requires vLLM 0.26+ (the tiering.fs framework does not exist earlier).
ARG VLLM_VERSION=0.26.0
FROM docker.io/vllm/vllm-openai:v${VLLM_VERSION}
ENTRYPOINT []

# GPU is REQUIRED at run time (vLLM loads the model on the GPU). WHICH GPU is a
# run-time choice — select it on the run command, not here:
#   docker:  --gpus all   |  --gpus '"device=0"'
#   podman:  --device nvidia.com/gpu=all  |  --device nvidia.com/gpu=0
LABEL org.certus.gpu-required="true" \
      org.certus.host-prereq="nvidia-container-toolkit (docker --gpus / podman CDI); --shm-size >= CPU_BYTES"

WORKDIR /workspace

# The self-contained driver + the shared dataset (paths relative to the
# repo-root build context). The driver's DISK_DIR branch wires the tiering
# CPU+FS config; torch/numpy/vllm come from the base image (no extra pip deps).
COPY benchmarks/kv-offload-replay/run_multiturn_offloading.py /workspace/bench/
COPY data/sharegpt_12turn_450.json /workspace/data/sharegpt_12turn_450.json

COPY benchmarks/kv-offload-replay/docker-entrypoint-cputier.sh /usr/local/bin/cputier-entrypoint
RUN chmod +x /usr/local/bin/cputier-entrypoint

# Defaults match the 450x12 runbook. DISK_DIR is set (this is what makes the
# driver take the Tiering CPU+FS path); bind a host dir onto it at run time so
# the fs tier persists to real disk. CPU_BYTES is the /dev/shm-backed CPU
# primary tier — pass --shm-size >= CPU_BYTES at run time or it EFAULTs.
ENV PYTHONUNBUFFERED=1 \
    PYTHONPATH=/workspace/bench \
    MODEL=NousResearch/Meta-Llama-3-8B \
    DATASET_PATH=/workspace/data/sharegpt_12turn_450.json \
    NUM_CONVS=450 \
    MAX_MODEL_LEN=8192 \
    OUTPUT_TOKENS=150 \
    MAX_NUM_SEQS=64 \
    GPU_MEM_UTIL=0.90 \
    CPU_BYTES=34359738368 \
    DISK_DIR=/workspace/kv-fs-tier \
    DISK_READ_THREADS=16 \
    DISK_WRITE_THREADS=16 \
    TRACE_OFFLOAD=0 \
    HF_HUB_OFFLINE=1 \
    WORKLOAD=/workspace/bench/run_multiturn_offloading.py

ENTRYPOINT ["/usr/local/bin/cputier-entrypoint"]
