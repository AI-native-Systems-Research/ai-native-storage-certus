# vLLM workload-driver image for the NO-OFFLOAD (GPU-only) baseline.
#
# This is the reference point against the Certus / CPU / SharedStorage offload
# backends: a single vLLM process with NO kv_transfer_config at all. Evicted KV
# is recomputed on the GPU rather than fetched from an offload tier. Like the
# CPU-offload image it is SELF-CONTAINED — no separate server, no gRPC, no CUDA
# IPC — but it is even simpler: no offload tier, so no CPU_BYTES and no pinned
# host-RAM buffer. It runs the same 450-conversation / 12-turn ShareGPT workload
# as the other backends, for head-to-head comparison.
#
# Build (context = repo root — needs benchmarks/kv-offload-replay/ + the dataset):
#   podman build -f benchmarks/kv-offload-replay/Dockerfile.nooffload -t certus-nooffload-bench .
#
# Run (GPU required; nothing else — no offload tier to size):
#   podman run --rm --device nvidia.com/gpu=all \
#       -e HF_TOKEN=<token> \
#       -v $HOME/.cache/huggingface:/root/.cache/huggingface \
#       certus-nooffload-bench
#   # docker equivalent: --gpus all

# vLLM version is a build-time choice (default 0.20.0); override with
#   podman build --build-arg VLLM_VERSION=0.26.0 ...
ARG VLLM_VERSION=0.20.0
FROM docker.io/vllm/vllm-openai:v${VLLM_VERSION}
ENTRYPOINT []

# GPU is REQUIRED at run time (vLLM loads the model on the GPU). WHICH GPU is a
# run-time choice — select it on the run command, not here (do NOT bake
# NVIDIA_VISIBLE_DEVICES into the image):
#   docker:  --gpus all   |  --gpus '"device=0"'
#   podman:  --device nvidia.com/gpu=all  |  --device nvidia.com/gpu=0
# Those flags trigger the NVIDIA container runtime to inject the chosen GPU +
# the host's libcuda.so — a HOST prerequisite (nvidia-container-toolkit / CDI).
LABEL org.certus.gpu-required="true" \
      org.certus.host-prereq="nvidia-container-toolkit (docker --gpus / podman CDI)"

WORKDIR /workspace

# The self-contained driver, plus the shared dataset (paths relative to the
# repo-root build context). torch/numpy/vllm come from the base image; this
# baseline needs no extra pip deps and no connector modules.
COPY benchmarks/kv-offload-replay/run_multiturn_nooffload.py /workspace/bench/
COPY certus-connector/sharegpt_12turn_450.json /workspace/certus-connector/sharegpt_12turn_450.json

COPY benchmarks/kv-offload-replay/docker-entrypoint-nooffload.sh /usr/local/bin/nooffload-entrypoint
RUN chmod +x /usr/local/bin/nooffload-entrypoint

# Defaults match the 450x12 runbook (RUNBOOK-cpu-and-sharedstorage.md). DATASET_PATH
# + NUM_CONVS are set explicitly so the container runs the 450x12 workload
# regardless of the driver's baked-in default. There is no offload tier here, so
# no CPU_BYTES.
ENV PYTHONUNBUFFERED=1 \
    MODEL=NousResearch/Meta-Llama-3-8B \
    DATASET_PATH=/workspace/certus-connector/sharegpt_12turn_450.json \
    NUM_CONVS=450 \
    MAX_MODEL_LEN=8192 \
    OUTPUT_TOKENS=150 \
    MAX_NUM_SEQS=64 \
    GPU_MEM_UTIL=0.90 \
    HF_HUB_OFFLINE=1 \
    WORKLOAD=/workspace/bench/run_multiturn_nooffload.py

ENTRYPOINT ["/usr/local/bin/nooffload-entrypoint"]
