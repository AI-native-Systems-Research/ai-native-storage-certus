# The workload image uses the repo root as its build context (it needs
# certus-shmq-connector/ + the shared dataset under certus-connector/). Exclude
# heavy/irrelevant artifacts to keep the context small. NOTE: this file is read
# only when the build context root contains it; for a repo-root context, keep a
# matching .dockerignore at the repo root.
.git/
target/
deps/spdk/
deps/spdk-build/
**/__pycache__/
**/*.pyc
**/.pytest_cache/
**/node_modules/
