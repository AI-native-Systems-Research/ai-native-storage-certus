{[@stop_split] [@expl:blind_evict_with_fallback requires] ([@stop_split] [@expl:blind_evict_with_fallback requires #0] [%#slib'0] slot_state_wf slot)
  /\ ([@stop_split] [@expl:blind_evict_with_fallback requires #1] [%#slib'1] key_in_memory_tier slot)}
  (! bb0
  [ bb0 = s0
    [ s0 = [ &out <- slot ] s1 | s1 = any [ br0 -> {convert_ok = false} (! bb2) | br1 -> {convert_ok} (! bb1) ] ]
  | bb1 = s0 [ s0 = [ &_15 <- BlockDevice ] s1 | s1 = [ &out <- { out with state = _15 } ] s2 | s2 = bb3 ]
  | bb2 = s0 [ s0 = [ &out <- { out with present = ([%#slib] false) } ] s1 | s1 = bb3 ]
  | bb3 = s0 [ s0 = [ &_ret <- out ] s1 | s1 = return {_ret} ] ]
  [ & _ret: t_KeySlot = Any.any_l ()
  | & slot: t_KeySlot = slot
  | & convert_ok: bool = convert_ok
  | & out: t_KeySlot = Any.any_l ()
  | & _15: t_EntryState = Any.any_l () ])
  [ return (result: t_KeySlot) ->
