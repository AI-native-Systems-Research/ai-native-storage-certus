    /\ ([@stop_split] [@expl:blind_evict_with_fallback ensures #1] [%#slib'3] convert_ok -> key_in_block_device result)
    /\ ([@stop_split] [@expl:blind_evict_with_fallback ensures #2] [%#slib'4] not convert_ok -> not result.present)}
    (! return {result}) ]
