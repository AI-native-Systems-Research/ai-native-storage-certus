    | s7 = any [ br0 -> {_26 = false} (! bb8) | br1 -> {_26} (! bb7) ] ]
  | bb7 = s0 [ s0 = [ &_ret <- st ] s1 | s1 = return {_ret} ]
  | bb8 = s0
    [ s0 = [ &out <- st ] s1
    | s1 = bounded_reduce [%#slib'3] {out.used_units} {cfg.batch_size} {out.capacity_units} {cfg.low_watermark_percent}
