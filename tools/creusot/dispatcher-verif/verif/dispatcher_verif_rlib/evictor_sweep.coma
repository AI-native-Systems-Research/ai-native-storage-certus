use creusot.int.UInt8
use creusot.int.UInt64
use creusot.prelude.Any
use int.Int

type t_SsdEvictorCfg = {
  enabled: bool;
  threshold_percent: UInt8.t;
  low_watermark_percent: UInt8.t;
  batch_size: UInt64.t }

type t_SsdEvictorState = { running: bool; used_units: UInt64.t; capacity_units: UInt64.t }

constant const_MIN: UInt64.t = (0: UInt64.t)

constant const_MAX: UInt64.t = (18446744073709551615: UInt64.t)

let saturating_mul (self_: UInt64.t) (rhs: UInt64.t) (return (x: UInt64.t)) = any
  [ return (result: UInt64.t) ->
  {[@stop_split] [@expl:saturating_mul ensures] ([@stop_split] [@expl:saturating_mul ensures #0] [%#snum] UInt64.t'int self_
            * UInt64.t'int rhs
          >= UInt64.t'int const_MIN
        /\ UInt64.t'int self_ * UInt64.t'int rhs <= UInt64.t'int const_MAX
      -> UInt64.t'int result = UInt64.t'int self_ * UInt64.t'int rhs)
    /\ ([@stop_split] [@expl:saturating_mul ensures #1] [%#snum'0] UInt64.t'int self_ * UInt64.t'int rhs
        < UInt64.t'int const_MIN -> UInt64.t'int result = UInt64.t'int const_MIN)
    /\ ([@stop_split] [@expl:saturating_mul ensures #2] [%#snum'1] UInt64.t'int self_ * UInt64.t'int rhs
      > UInt64.t'int const_MAX -> UInt64.t'int result = UInt64.t'int const_MAX)}
    (! return {result}) ]

let bounded_reduce (used: UInt64.t) (batch: UInt64.t) (cap: UInt64.t) (low_pct: UInt8.t) (return (x: UInt64.t)) =
{[@stop_split] [@expl:bounded_reduce requires] ([@stop_split] [@expl:bounded_reduce requires #0] [%#slib'9] UInt64.t'int used
    <= UInt64.t'int cap)
  /\ ([@stop_split] [@expl:bounded_reduce requires #1] [%#slib'10] UInt64.t'int cap > 0)
  /\ ([@stop_split] [@expl:bounded_reduce requires #2] [%#slib'11] UInt8.t'int low_pct <= 100)}
  any
  [ return (result: UInt64.t) -> {[@stop_split] [@expl:bounded_reduce ensures] [%#slib'12] UInt64.t'int result
    <= UInt64.t'int used}
    (! return {result}) ]

predicate wf_ssd_cfg [#"/home/cornel/ai-native-storage-certus/tools/creusot/dispatcher-verif/src/lib.rs" 1154 0 1154 43] (c: t_SsdEvictorCfg) =
  [%#slib'13] UInt8.t'int c.threshold_percent <= 100
