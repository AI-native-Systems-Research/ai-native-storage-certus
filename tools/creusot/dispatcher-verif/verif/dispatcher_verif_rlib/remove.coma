use creusot.int.UInt64
use creusot.prelude.Any
use int.Int

type t_Model = { initialized: bool; used: UInt64.t; capacity: UInt64.t }

type t_EntryState = MemoryTier | BlockDevice | Staging | PendingWrite

type t_KeySlot = { present: bool; state: t_EntryState; size: UInt64.t; ts: UInt64.t }

type t_OpError = NotInitialized | KeyNotFound | AlreadyExists | AllocationFailed | InvalidParameter | InvalidState

type t_Result_unit_OpError = Ok () | Err t_OpError

type tup3_Model_Result_unit_OpError_KeySlot = { f0: t_Model; f1: t_Result_unit_OpError; f2: t_KeySlot }

predicate wf_model [#"/home/cornel/ai-native-storage-certus/tools/creusot/dispatcher-verif/src/lib.rs" 88 0 88 33] (m: t_Model) =
  [%#slib'5] UInt64.t'int m.used <= UInt64.t'int m.capacity

type tup2_EntryState_EntryState = { f0'0: t_EntryState; f1'0: t_EntryState }

predicate state_eq [#"/home/cornel/ai-native-storage-certus/tools/creusot/dispatcher-verif/src/lib.rs" 60 0 60 53] (a: t_EntryState) (b: t_EntryState) =
  [%#slib'7] match { f0'0 = a; f1'0 = b } with
    | {f0'0 = MemoryTier; f1'0 = MemoryTier} -> true
    | {f0'0 = BlockDevice; f1'0 = BlockDevice} -> true
    | {f0'0 = Staging; f1'0 = Staging} -> true
    | {f0'0 = PendingWrite; f1'0 = PendingWrite} -> true
    | _ -> false
    end

predicate same_slot [#"/home/cornel/ai-native-storage-certus/tools/creusot/dispatcher-verif/src/lib.rs" 73 0 73 48] (a: t_KeySlot) (b: t_KeySlot) =
  [%#slib'6] a.present = b.present
  /\ state_eq a.state b.state /\ UInt64.t'int a.size = UInt64.t'int b.size /\ UInt64.t'int a.ts = UInt64.t'int b.ts

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

