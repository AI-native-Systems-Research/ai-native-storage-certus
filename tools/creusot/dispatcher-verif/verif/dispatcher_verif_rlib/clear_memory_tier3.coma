use creusot.int.UInt64
use creusot.prelude.Any
use int.Int

type t_Model = { initialized: bool; used: UInt64.t; capacity: UInt64.t }

type t_EntryState = MemoryTier | BlockDevice | Staging | PendingWrite

type t_KeySlot = { present: bool; state: t_EntryState; size: UInt64.t; ts: UInt64.t }

type t_Cache3 = { k0: t_KeySlot; k1: t_KeySlot; k2: t_KeySlot }

type tup3_Model_usize_Cache3 = { f0: t_Model; f1: UInt64.t; f2: t_Cache3 }

predicate wf_model [#"/home/cornel/ai-native-storage-certus/tools/creusot/dispatcher-verif/src/lib.rs" 88 0 88 33] (m: t_Model) =
  [%#slib'13] UInt64.t'int m.used <= UInt64.t'int m.capacity

predicate key_in_memory_tier [#"/home/cornel/ai-native-storage-certus/tools/creusot/dispatcher-verif/src/lib.rs" 98 0 98 48] (slot: t_KeySlot) =
  [%#slib'15] slot.present
  /\ match slot.state with
    | MemoryTier -> true
    | _ -> false
    end

predicate key_in_block_device [#"/home/cornel/ai-native-storage-certus/tools/creusot/dispatcher-verif/src/lib.rs" 103 0 103 49] (slot: t_KeySlot) =
  [%#slib'18] slot.present
  /\ match slot.state with
    | BlockDevice -> true
    | _ -> false
    end

predicate key_in_pending_write [#"/home/cornel/ai-native-storage-certus/tools/creusot/dispatcher-verif/src/lib.rs" 108 0 108 50] (slot: t_KeySlot) =
  [%#slib'19] slot.present
  /\ match slot.state with
    | PendingWrite -> true
    | _ -> false
    end

predicate slot_state_wf [#"/home/cornel/ai-native-storage-certus/tools/creusot/dispatcher-verif/src/lib.rs" 118 0 118 43] (slot: t_KeySlot) =
  [%#slib'17] not slot.present
  -> not key_in_memory_tier slot /\ not key_in_block_device slot /\ not key_in_pending_write slot

predicate wf_cache3 [#"/home/cornel/ai-native-storage-certus/tools/creusot/dispatcher-verif/src/lib.rs" 137 0 137 35] (c: t_Cache3) =
  [%#slib'14] slot_state_wf c.k0 /\ slot_state_wf c.k1 /\ slot_state_wf c.k2

function memory_tier_count3 [#"/home/cornel/ai-native-storage-certus/tools/creusot/dispatcher-verif/src/lib.rs" 150 0 150 43] (c: t_Cache3) : int
 = [%#slib'16] (if key_in_memory_tier c.k0 then 1 else 0) + (if key_in_memory_tier c.k1 then 1 else 0)
  + (if key_in_memory_tier c.k2 then 1 else 0)

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

