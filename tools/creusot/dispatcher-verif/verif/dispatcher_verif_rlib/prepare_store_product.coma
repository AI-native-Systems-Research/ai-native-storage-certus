type t_Model = { initialized: bool; used: UInt64.t; capacity: UInt64.t }

type t_OpError = NotInitialized | KeyNotFound | AlreadyExists | AllocationFailed | InvalidParameter | InvalidState

type t_Result_unit_OpError = Ok () | Err t_OpError

type t_EntryState = MemoryTier | BlockDevice | Staging | PendingWrite

type t_KeySlot = { present: bool; state: t_EntryState; size: UInt64.t; ts: UInt64.t }

type tup3_Model_Result_unit_OpError_KeySlot = { f0: t_Model; f1: t_Result_unit_OpError; f2: t_KeySlot }

