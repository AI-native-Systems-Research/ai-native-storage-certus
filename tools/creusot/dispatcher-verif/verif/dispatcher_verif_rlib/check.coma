use creusot.int.UInt64
use creusot.prelude.Any
use int.Int

type t_Model = { initialized: bool; used: UInt64.t; capacity: UInt64.t }

type t_EntryState = MemoryTier | BlockDevice | Staging | PendingWrite

type t_KeySlot = { present: bool; state: t_EntryState; size: UInt64.t; ts: UInt64.t }

type t_OpError = NotInitialized | KeyNotFound | AlreadyExists | AllocationFailed | InvalidParameter | InvalidState

type t_Result_bool_OpError = Ok bool | Err t_OpError

predicate wf_model [#"/home/cornel/ai-native-storage-certus/tools/creusot/dispatcher-verif/src/lib.rs" 88 0 88 33] (m: t_Model) =
  [%#slib'3] UInt64.t'int m.used <= UInt64.t'int m.capacity

predicate err_not_initialized [#"/home/cornel/ai-native-storage-certus/tools/creusot/dispatcher-verif/src/lib.rs" 159 0 159 46] (e: t_OpError) =
  [%#slib'4] match e with
    | NotInitialized -> true
    | _ -> false
    end

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let check' [#"/home/cornel/ai-native-storage-certus/tools/creusot/dispatcher-verif/src/lib.rs" 213 0 213 62]
  (m: t_Model) (slot: t_KeySlot) (return (x: t_Result_bool_OpError)) =
{[@stop_split] [@expl:check requires] [%#slib] wf_model m}
