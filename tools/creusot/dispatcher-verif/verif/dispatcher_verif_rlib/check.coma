  | bb2 = s0 [ s0 = [ &_ret <- Ok (slot.present) ] s1 | s1 = return {_ret} ]
  | bb1 = s0 [ s0 = [ &_11 <- NotInitialized ] s1 | s1 = [ &_ret <- Err _11 ] s2 | s2 = return {_ret} ] ]
  [ & _ret: t_Result_bool_OpError = Any.any_l ()
  | & m: t_Model = m
  | & slot: t_KeySlot = slot
  | & _11: t_OpError = Any.any_l () ])
  [ return (result: t_Result_bool_OpError) ->
  {[@stop_split] [@expl:check ensures] ([@stop_split] [@expl:check ensures #0] [%#slib'0] match result with
        | Ok v -> v = slot.present
        | _ -> true
