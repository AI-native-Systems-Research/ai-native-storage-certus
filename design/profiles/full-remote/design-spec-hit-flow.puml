@startuml
skinparam shadowing false
skinparam defaultFontSize 11

title Cache Get / Lookup Flow (full-remote)

participant "Client\n(Python/shmq)" as client
participant "Shmq Mailbox\n(/dev/shm)" as shmq
participant "Dispatcher" as disp
participant "MemoryTier\n(DRAM pool)" as mt
participant "DispatchMap" as dm
participant "PipelineRing" as pr
participant "BlockDevice\n(NVMe SSD)" as ssd
participant "RemoteLookup" as rl
participant "Peer Node" as peer

== Warm Path (MemoryTier -> GPU) ==

client -> shmq: BatchLookupRequest\n(key, IpcHandle)
shmq -> shmq: cudaIpcOpenMemHandle\n-> device_ptr
shmq -> disp: lookup(key, IpcHandle)

disp -> dm: lookup(key) + take_read
dm --> disp: MemoryTier { ptr, size }

disp -> disp: cudaMemcpyAsync H2D\n(mem_ptr -> GPU, warm_stream)
note right of disp: Zero-copy from\npinned memory-tier pool

disp -> dm: release_read(key)
disp -> mt: touch(key)
note right of mt: Refresh LRU timestamp

disp --> shmq: Ok(stream_handle)
shmq -> shmq: cudaIpcCloseMemHandle
shmq --> client: BatchLookupResponse\n(success)

== Cold Path (BlockDevice -> MemoryTier -> GPU) ==

client -> shmq: BatchLookupRequest\n(key, IpcHandle)
shmq -> disp: lookup(key, IpcHandle)

disp -> dm: lookup(key) + take_read
dm --> disp: BlockDevice { offset }
note right of dm: read pin held for the\nwhole SSD->DRAM->GPU pipeline

disp -> mt: evict_lru() if pool full\n(try_evict_to_block)
disp -> mt: insert(key, size)\n-> new_ptr

disp -> pr: ColdReadPool: pipelined_read(offset, size)
note right of pr: StagingPool: CUDA-pinned SPDK-registered\nbuffers + per-device pipe streams
pr -> ssd: NVMe read (chunked at MDTS)
ssd --> pr: data chunks
pr -> mt: copy chunks to new_ptr
pr -> disp: cudaMemcpyAsync H2D\n(overlapped with I/O)

disp -> dm: promote_block_to_memory_tier\n(key, new_ptr, size)
note right of dm: In-place BlockDevice -> MemoryTier\nssd_offset preserved

disp -> dm: release_read(key)

disp --> shmq: Ok(stream_handle)
shmq --> client: BatchLookupResponse\n(success)

== Remote Path (Local Miss -> Peer Node) ==

client -> shmq: BatchLookupRequest\n(key, IpcHandle)
shmq -> disp: lookup(key, IpcHandle)

disp -> dm: lookup(key)
dm --> disp: NotExist
note right of disp: Key not found locally

disp -> rl: batch_lookup([(key, expected_size)])
rl -> rl: reserve landing slot\nmemory_tier.insert(key, size)\n(pool-wide REMOTE_WRITE rkey)
rl -> peer: SHOUT KeyQuery(key) via Zyre
peer --> rl: WHISPER KeyResponse\n(Memory / Disk / None)
note right of rl: Phase 1: memory probe.\nAdvance on quorum (80%) or\nphase1_timeout (20ms).\nPhase 2: disk re-scan of\ncached responses if needed.

alt Peer has the entry (Memory or Disk)
    rl -> peer: WHISPER RdmaRequest\n(endpoint, rkey, slot)
    note right of peer: Disk-holder promotes\ndisk -> memory first
    peer -> rl: RDMA Write (data) INTO slot\n(peer = data-holder, via its Initiator)
    peer --> rl: WHISPER RdmaStatus(Success)
    rl -> dm: create_memory_tier_entry(key, ptr, len)\n+ release_write(key)
    note right of dm: Publish already-written slot\n-> future lookups are warm
    rl --> disp: Ok
    disp --> shmq: Ok
    shmq --> client: BatchLookupResponse\n(success)
else Peer miss (all None)
    peer --> rl: no holder within op_deadline (50ms)
    rl --> disp: NotFound
    disp --> shmq: KeyNotFound
    shmq --> client: BatchLookupResponse\n(key_not_found)
end

== Incoming Remote Request (Peer -> This Node, this node is the data-holder) ==

peer -> rl: SHOUT KeyQuery(key) via Zyre
rl -> rl: handle_key_query\n(key present in MemoryTier?)
peer -> rl: WHISPER RdmaRequest\n(peer endpoint, rkey, slot)
rl -> rl: handle_rdma_request\n-> InitiatorCmd::Serve
rl -> mt: resolve value (ptr, size)\nand pin it (read ref)
rl -> peer: Initiator.push_async:\nsubmit RDMA Write OUT into peer slot
note right of rl: Submission returns at once; a per-peer\nconnection thread posts and reaps.\nThe read ref is held until completion —\nthe NIC reads the source asynchronously.
peer --> rl: completion callback\n(per-key statuses; releases the read refs)
rl -> rl: PushComplete

@enduml
