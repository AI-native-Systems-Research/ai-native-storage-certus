@startuml
skinparam defaultTextAlignment center
skinparam padding 3
skinparam nodesep 25
skinparam ranksep 25

title Certus Server — full-remote Profile Component Deployment

' ============================================================
' CLIENT
' ============================================================
node "Client Host" {
    component "Python Test Client\n<<gRPC client>>" as pyclient
    database "GPU Memory\n(client ctx)" as client_gpu
    pyclient -right[hidden]- client_gpu
}

' ============================================================
' SERVER
' ============================================================
node "Server Host" {

    node "certus-server (Rust / tokio)" {

        component "gRPC Service <<tonic>>\nPopulate | Lookup | Check | Remove | Touch\nClearMemoryTier | FlushToSsd" as grpc

        component "DispatcherComponent <<IDispatcher>>" as dispatcher {
            component "ParallelBackgroundWriter | BackgroundEvictor\nPipelineRing | warm_stream" as disp_bg
            component "DataDrive [0..N]\n(BlockDeviceSpdkNvme + ExtentManager)" as data_drive
        }

        component "DispatchMapComponent\n<<IDispatchMap>>" as dispatch_map
        component "MemoryTierComponent\n<<IMemoryTier>>" as memory_tier
        component "EvictionPolicyLruComponent\n<<IEvictionPolicy>>" as eviction
        component "GpuServicesComponent\n<<IGpuServices>>" as gpu_svc
        component "LoggerComponent\n<<ILogger>>" as logger

        component "SPDKEnvComponent\n<<ISPDKEnv>>" as spdk_env

        component "RemoteLookupComponent\n<<IRemoteLookup>>" as remote_lookup #LightCoral
        component "RemoteRequestHandlerComponent\n<<IRemoteRequestHandler>>" as remote_handler #LightCoral
    }

    database "GPU Memory\n(server ctx)" as server_gpu
    database "NVMe (data) [0..N]" as nvme_data
}

cloud "Peer Certus Nodes\n(full-remote)" as peers

' ============================================================
' CONNECTIONS
' ============================================================

' Client -> Server
pyclient -down-> grpc : "gRPC/TCP (+TLS)"
client_gpu .down.> server_gpu : "CUDA IPC"

' gRPC -> Dispatcher
grpc -down-> dispatcher

' Dispatcher bindings (receptacles)
dispatcher -down-> dispatch_map
dispatcher -down-> memory_tier
dispatcher -down-> gpu_svc
dispatcher -down-> remote_lookup
dispatcher ..> logger
data_drive -down-> spdk_env

' Dispatcher internal
disp_bg -down-> data_drive

' DispatchMap wiring
dispatch_map -down-> eviction

' MemoryTier wiring
memory_tier -down-> eviction

' Remote layer
remote_handler -up-> dispatcher : "dispatcher"
remote_lookup -down-> peers : "RDMA (outgoing)"
peers -down-> remote_handler : "RDMA (incoming)"

' GPU
gpu_svc -right-> server_gpu : "DMA"
gpu_svc .down.> memory_tier : "cudaHostRegister"

' SPDK -> hardware
spdk_env -down-> nvme_data : "VFIO"
data_drive ..> nvme_data : "NVMe I/O"

@enduml
