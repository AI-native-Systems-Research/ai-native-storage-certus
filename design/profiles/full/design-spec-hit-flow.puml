@startuml
skinparam shadowing false
skinparam defaultFontSize 11

title Cache Get / Lookup Flow (full) — batch_lookup

participant "Client\n(vLLM connector)" as client
participant "shmq-dispatcher\n(/dev/shm)" as shmq
participant "Dispatcher" as disp
participant "MemoryTier\n(DRAM pool)" as mt
participant "DispatchMap" as dm
participant "Scatter-gather\nloop" as sg
participant "BlockDevice\n(NVMe SSD 0..N)" as ssd
participant "RemoteLookup\n(uninitialized)" as rl

client -> shmq: Lookup (HandleBatch)
shmq -> shmq: ipc_cache_open\n-> device_ptrs
shmq -> disp: batch_lookup(entries)

== Classify (warm copies queued) ==

disp -> dm: lookup(key) + take_read
alt MemoryTier { ptr, size }
  disp -> disp: cudaMemcpyAsync H2D\n(slot -> GPU regions, warm stream)
  note right of disp: pin kept in warm_pins;\nno sync yet
else BlockDevice { offset }
  disp -> disp: collect cold entry\n(read pin held)
else NotExist
  disp -> disp: collect for remote forward
end
disp -> mt: batch_touch(warm keys)

== Cold: slot prep + multi-drive scatter-gather ==

disp -> mt: evict_and_insert(key, size)\n-> new_ptr (AllocationFailed -> staged)
disp -> sg: scatter_gather_multi_drive_zero_copy\n(one channel per drive, QD 128 split)
sg -> ssd: ReadAsync segments\n(NVMe DMA into slot)
ssd --> sg: completions (any drive)
sg -> sg: last segment of object ->\nfused H2D on pipe stream
sg -> sg: final dual stream sync
disp -> dm: promote_block_to_memory_tier\n(key, new_ptr, size)
note right of dm: In-place, ssd_offset kept;\nServedBy::Ssd

opt tier saturated (staged)
  disp -> disp: serve_cold_staged\nSSD -> staging buf -> GPU (uncached)
end

== Deferred warm sync ==

disp -> disp: stream_synchronize(warm)
disp -> dm: release_read (warm_pins, cold pins)

== Local misses ==

disp -> rl: batch_lookup(not_found)
rl --> disp: NotFound (no actor)
note right of disp: ServedBy::Miss

disp --> shmq: Vec<LookupOutcome>
shmq --> client: [tier byte]*n\n(0 miss/err, 1 DRAM, 2 SSD, 3 remote)

@enduml
