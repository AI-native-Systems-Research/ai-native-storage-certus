@startuml certus-server-deployment
!theme plain
skinparam componentStyle rectangle
skinparam defaultTextAlignment center
skinparam padding 3
skinparam nodesep 30
skinparam ranksep 30

title Certus Server — Component Deployment Diagram

' ============================================================
' CLIENT (top)
' ============================================================
rectangle "Client Host" {
    [Python Test Client\n(PyTorch, cudaIpcGetMemHandle, batch gRPC)] as pyclient
    database "GPU Memory\n(client)" as client_gpu
    pyclient -right[hidden]- client_gpu
}

' ============================================================
' SERVER
' ============================================================
rectangle "certus-server (Rust / tokio)" {

    ' --- Layer 1: gRPC ---
    [gRPC <<tonic>>: Populate | Lookup | Check | Remove | Touch] as grpc

    ' --- Layer 2: Dispatcher ---
    rectangle "DispatcherComponent <<IDispatcher>>" as dispatcher {
        [BackgroundWriter | BackgroundEvictor | PipelineRing | warm_stream] as disp_core
        rectangle "DataDrive [0..N]" {
            [data BlockDeviceSpdkNvme] as data_bd
            [data ExtentManager] as data_em
            data_em -right-> data_bd
        }
        disp_core -down-> data_em
    }

    ' --- Layer 3: Peer components ---
    [DispatchMapComponent\n<<IDispatchMap>>] as dispatch_map
    [MemoryTierComponent\n<<IMemoryTier>>] as memory_tier
    [GpuServicesComponent\n<<IGpuServices>>] as gpu_svc

    ' --- Layer 4: Infrastructure ---
    [meta ExtentManager\n<<IExtentManager>>] as meta_em
    [meta BlockDeviceSpdkNvme\n<<IBlockDevice>>] as meta_bd
    [SPDKEnvComponent\n<<ISPDKEnv>>] as spdk_env
    [LoggerComponent\n<<ILogger>>] as logger

    database "GPU Memory\n(server)" as server_gpu
}

' --- Hardware ---
database "NVMe (metadata)" as nvme_meta
database "NVMe (data) [0..N]" as nvme_data

' ============================================================
' CONNECTIONS
' ============================================================

' Client → Server
pyclient -down-> grpc : gRPC (+TLS)
client_gpu .down.> server_gpu : CUDA IPC

' Vertical flow
grpc -down-> dispatcher
dispatcher -down-> dispatch_map
dispatcher -down-> memory_tier
dispatcher -down-> gpu_svc
dispatcher -down-> spdk_env

' Metadata chain (horizontal)
dispatch_map -down-> meta_em
meta_em -right-> meta_bd
meta_bd -down-> spdk_env

' Data drives to SPDK
data_bd -down-> spdk_env

' GPU
gpu_svc -right-> server_gpu

' Hardware
spdk_env -down-> nvme_meta
spdk_env -down-> nvme_data
data_bd ..> nvme_data
meta_bd ..> nvme_meta

@enduml
